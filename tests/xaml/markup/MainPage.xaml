<Page
    x:Class="XamlMarkup.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XamlMarkup">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20" Background="{ThemeResource PanelBrush}">
            <!-- a local FontSize: the implicit TextBlock style must not override it -->
            <TextBlock x:Name="Title" Text="Hello from markup" FontSize="28"/>
            <Button x:Name="ClickButton" Content="Click me" Click="OnClick" Margin="0,10,0,0"
                    Style="{StaticResource AccentButton}"/>
            <TextBlock x:Name="Styled" Text="Styled by the implicit TextBlock style"/>
            <Button x:Name="TemplatedButton" Content="Templated" Style="{StaticResource TemplatedButton}" Margin="0,10,0,0"/>
        </StackPanel>
        <!-- milestone 4 part 3: toggle controls; each has its own Background (or BorderBrush) to be found by -->
        <StackPanel x:Name="TogglePanel" Margin="20" HorizontalAlignment="Right" Width="200">
            <CheckBox x:Name="Check" Content="Check me" Background="#FF102030" Checked="OnChecked" Unchecked="OnUnchecked"/>
            <CheckBox x:Name="ThreeState" Content="Three states" Background="#FF203040" IsThreeState="True" IsChecked="True"/>
            <RadioButton x:Name="RadioA" Content="A" Background="#FF304050" IsChecked="True"/>
            <RadioButton x:Name="RadioB" Content="B" Background="#FF405060"/>
            <ToggleButton x:Name="Toggle" Content="Toggle" Style="{StaticResource TemplatedToggle}" Margin="0,4,0,0"/>
            <Button x:Name="PlainButton" Content="Plain" BorderBrush="#FF506070" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource AccentBrush}" Margin="20" Padding="10">
            <TextBlock Text="Brush from Application.Resources" Foreground="White" FontSize="20"/>
        </Border>
    </Grid>
</Page>
