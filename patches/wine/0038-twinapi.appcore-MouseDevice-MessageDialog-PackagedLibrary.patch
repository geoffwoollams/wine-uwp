+/* MouseDevice.GetForCurrentView().MouseMoved gives relative mouse motion (games use it for mouse look while the
+ * cursor is hidden). Adding the first handler registers the process for raw mouse input; the CoreWindow's window
+ * procedure passes each WM_INPUT here and the handlers run on the window's thread, as on Windows, while the app
+ * pumps the dispatcher. One device object serves every view. */
+
+struct mouse_args
+{
+    IMouseEventArgs IMouseEventArgs_iface;
+    LONG ref;
+    MouseDelta delta;
+};
+
+static inline struct mouse_args *impl_from_IMouseEventArgs( IMouseEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct mouse_args, IMouseEventArgs_iface );
+}
+
+static HRESULT WINAPI args_QueryInterface( IMouseEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IMouseEventArgs ))
+    {
+        *out = iface;
+        IMouseEventArgs_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI args_AddRef( IMouseEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IMouseEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI args_Release( IMouseEventArgs *iface )
+{
+    struct mouse_args *impl = impl_from_IMouseEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI args_GetIids( IMouseEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
