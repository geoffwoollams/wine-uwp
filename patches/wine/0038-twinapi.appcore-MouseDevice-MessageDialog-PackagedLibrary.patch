diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index 6c6f1f3..63ccea1 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -29,6 +29,7 @@
 #include "winternl.h"
 #include "ddk/ntddk.h"
 #include "kernelbase.h"
+#include "appmodel.h"
 #include "wine/list.h"
 #include "wine/asm.h"
 #include "wine/debug.h"
@@ -589,8 +590,41 @@ HMODULE WINAPI DECLSPEC_HOTPATCH LoadLibraryExW( LPCWSTR name, HANDLE file, DWOR
  */
 HMODULE WINAPI /* DECLSPEC_HOTPATCH */ LoadPackagedLibrary( LPCWSTR name, DWORD reserved )
 {
-    FIXME( "semi-stub, name %s, reserved %#lx.\n", debugstr_w(name), reserved );
-    SetLastError( APPMODEL_ERROR_NO_PACKAGE );
+    WCHAR path[MAX_PATH];
+    UINT32 len = ARRAY_SIZE(path);
+    HMODULE module;
+    WCHAR *p;
+
+    TRACE( "name %s, reserved %#lx.\n", debugstr_w(name), reserved );
+
+    if (reserved || !name || !*name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    /* a path inside the package: relative, without a drive or ".." */
+    if (name[0] == '\\' || name[0] == '/' || (name[0] && name[1] == ':') || wcsstr( name, L".." ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (GetCurrentPackagePath( &len, path ))
+    {
+        SetLastError( APPMODEL_ERROR_NO_PACKAGE );
+        return NULL;
+    }
+    /* only the package itself is searched here, not its dependency packages */
+    if (wcslen( path ) + wcslen( name ) + 2 > ARRAY_SIZE(path))
+    {
+        SetLastError( ERROR_FILENAME_EXCED_RANGE );
+        return NULL;
+    }
+    wcscat( path, L"\\" );
+    wcscat( path, name );
+    for (p = path; *p; p++) if (*p == '/') *p = '\\';
+    if ((module = LoadLibraryExW( path, NULL, LOAD_WITH_ALTERED_SEARCH_PATH ))) return module;
+    /* a bare file name can also come from the process's search path (the package root is its directory) */
+    if (!wcschr( name, '\\' ) && !wcschr( name, '/' )) return LoadLibraryExW( name, NULL, 0 );
     return NULL;
 }
 
