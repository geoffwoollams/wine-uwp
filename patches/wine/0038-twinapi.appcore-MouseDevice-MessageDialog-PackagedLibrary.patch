+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* The async causality tracer reports C++/CX and C# async operations to a debugger's timeline. Nothing listens
+ * here, so every trace is accepted and dropped. The interface isn't in Wine's IDL yet, so its vtable is written
+ * out by hand from Windows.winmd (IAsyncCausalityTracerStatics, 50850b26-267e-451b-a890-ab6a370245ee). The GUID
+ * arguments are by value, which the x64 ABI passes by reference. Xbox Live's chat libraries (Gears of War 4) call
+ * it from their worker threads. */
+
+static const GUID IID_IAsyncCausalityTracerStatics_local =
+    { 0x50850b26, 0x267e, 0x451b, { 0xa8, 0x90, 0xab, 0x6a, 0x37, 0x02, 0x45, 0xee } };
+
+typedef struct tracer_statics tracer_statics;
+struct tracer_statics_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( tracer_statics *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( tracer_statics *iface );
+    ULONG (WINAPI *Release)( tracer_statics *iface );
+    HRESULT (WINAPI *GetIids)( tracer_statics *iface, ULONG *count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( tracer_statics *iface, HSTRING *name );
+    HRESULT (WINAPI *GetTrustLevel)( tracer_statics *iface, TrustLevel *level );
+    HRESULT (WINAPI *TraceOperationCreation)( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                              UINT64 operation, HSTRING name, UINT64 related );
+    HRESULT (WINAPI *TraceOperationCompletion)( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                                UINT64 operation, INT32 status );
+    HRESULT (WINAPI *TraceOperationRelation)( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                              UINT64 operation, INT32 relation );
+    HRESULT (WINAPI *TraceSynchronousWorkStart)( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                                 UINT64 operation, INT32 work );
+    HRESULT (WINAPI *TraceSynchronousWorkCompletion)( tracer_statics *iface, INT32 level, INT32 source, INT32 work );
+    HRESULT (WINAPI *add_TracingStatusChanged)( tracer_statics *iface, IUnknown *handler, EventRegistrationToken *token );
+    HRESULT (WINAPI *remove_TracingStatusChanged)( tracer_statics *iface, EventRegistrationToken token );
+};
+struct tracer_statics { const struct tracer_statics_vtbl *lpVtbl; };
+
+struct tracer_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    tracer_statics statics;
+};
+
+static struct tracer_factory tracer;
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &tracer.IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncCausalityTracerStatics_local ))
+        *out = &tracer.statics;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+static HRESULT WINAPI statics_QueryInterface( tracer_statics *iface, REFIID iid, void **out )
+{
+    return factory_QueryInterface( &tracer.IActivationFactory_iface, iid, out );
+}
+static ULONG WINAPI statics_AddRef( tracer_statics *iface ) { return 2; }
+static ULONG WINAPI statics_Release( tracer_statics *iface ) { return 1; }
+static HRESULT WINAPI statics_GetIids( tracer_statics *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI statics_GetRuntimeClassName( tracer_statics *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI statics_GetTrustLevel( tracer_statics *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI statics_TraceOperationCreation( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                                      UINT64 operation, HSTRING name, UINT64 related )
+{
+    TRACE( "level %d, source %d, operation %#I64x, name %s.\n", level, source, operation, debugstr_hstring(name) );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_TraceOperationCompletion( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                                        UINT64 operation, INT32 status )
+{
+    TRACE( "level %d, source %d, operation %#I64x, status %d.\n", level, source, operation, status );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_TraceOperationRelation( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                                      UINT64 operation, INT32 relation )
+{
+    TRACE( "level %d, source %d, operation %#I64x, relation %d.\n", level, source, operation, relation );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_TraceSynchronousWorkStart( tracer_statics *iface, INT32 level, INT32 source, GUID platform,
+                                                         UINT64 operation, INT32 work )
+{
+    TRACE( "level %d, source %d, operation %#I64x, work %d.\n", level, source, operation, work );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_TraceSynchronousWorkCompletion( tracer_statics *iface, INT32 level, INT32 source, INT32 work )
+{
+    TRACE( "level %d, source %d, work %d.\n", level, source, work );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_add_TracingStatusChanged( tracer_statics *iface, IUnknown *handler, EventRegistrationToken *token )
+{
+    static LONG next_token;
+
+    TRACE( "handler %p (no tracer: the status never changes).\n", handler );
+    if (!handler || !token) return E_INVALIDARG;
+    token->value = InterlockedIncrement( &next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_remove_TracingStatusChanged( tracer_statics *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static const struct tracer_statics_vtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    statics_TraceOperationCreation,
+    statics_TraceOperationCompletion,
+    statics_TraceOperationRelation,
+    statics_TraceSynchronousWorkStart,
+    statics_TraceSynchronousWorkCompletion,
+    statics_add_TracingStatusChanged,
+    statics_remove_TracingStatusChanged,
+};
+
+static struct tracer_factory tracer = { { &factory_vtbl }, { &statics_vtbl } };
+IActivationFactory *async_causality_tracer_factory = &tracer.IActivationFactory_iface;
