+    if (!(args = malloc( sizeof(*args) ))) return;
+    args->IMouseEventArgs_iface.lpVtbl = &args_vtbl;
+    args->ref = 1;
+    args->delta.X = raw.data.mouse.lLastX;
+    args->delta.Y = raw.data.mouse.lLastY;
+
+    /* call the handlers outside the lock: one may remove itself */
+    EnterCriticalSection( &mouse.cs );
+    count = mouse.count;
+    if ((handlers = malloc( count * sizeof(*handlers) )))
+        for (i = 0; i < count; i++)
+        {
+            handlers[i] = mouse.handlers[i].handler;
+            ITypedEventHandler_MouseDevice_MouseEventArgs_AddRef( handlers[i] );
+        }
+    LeaveCriticalSection( &mouse.cs );
