+    struct mouse_args *args;
+    RAWINPUT raw;
+    UINT size = sizeof(raw), count, i;
+
+    if (!mouse.count) return;
+    if (GetRawInputData( input, RID_INPUT, &raw, &size, sizeof(RAWINPUTHEADER) ) == (UINT)-1) return;
