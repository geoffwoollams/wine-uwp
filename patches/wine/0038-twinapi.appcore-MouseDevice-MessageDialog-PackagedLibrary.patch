+static HRESULT WINAPI info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct show_op *impl = impl_from_IAsyncInfo( iface );
+
+    EnterCriticalSection( &impl->cs );
+    *status = impl->status;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )
+{
+    *error = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI info_Cancel( IAsyncInfo *iface )
+{
+    struct show_op *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    /* the dialog thread sees the window go and completes the operation as cancelled */
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started && impl->hwnd) PostMessageW( impl->hwnd, WM_CLOSE, 0, 0 );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI info_Close( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static const struct IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release,
+    info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+/* ---- the dialog window ---- */
+
+#define ID_BUTTON_FIRST 100
+#define WM_DIALOG_DONE (WM_APP + 1)
+
+static const WCHAR dialog_class[] = L"WineUwpMessageDialog";
+
+static LRESULT CALLBACK dialog_wnd_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    switch (msg)
+    {
+    case WM_COMMAND:
+        if (LOWORD(wparam) >= ID_BUTTON_FIRST && LOWORD(wparam) < ID_BUTTON_FIRST + MAX_COMMANDS)
+        {
+            PostMessageW( hwnd, WM_DIALOG_DONE, LOWORD(wparam) - ID_BUTTON_FIRST, 0 );
+            return 0;
+        }
+        if (LOWORD(wparam) == IDCANCEL)   /* Escape, through IsDialogMessage */
+        {
+            struct show_op *op = (struct show_op *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+            if (op->cancel_index < op->count) PostMessageW( hwnd, WM_DIALOG_DONE, op->cancel_index, 0 );
+            return 0;
+        }
+        break;
+    case WM_CTLCOLORSTATIC:
+        return (LRESULT)GetSysColorBrush( COLOR_WINDOW );
+    case WM_CLOSE:   /* only from IAsyncInfo::Cancel: the window has no close box */
+        PostMessageW( hwnd, WM_DIALOG_DONE, ~0u, 0 );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static HFONT dialog_font( UINT dpi, int scale )
+{
+    LOGFONTW font = { 0 };
+
+    /* the message font is 9 points at 96 dpi; scale 2 is that size, 3 is half as big again and semibold */
+    font.lfHeight = -MulDiv( 9 * scale / 2, dpi, 72 );
+    font.lfWeight = scale > 2 ? FW_SEMIBOLD : FW_NORMAL;
+    font.lfCharSet = DEFAULT_CHARSET;
+    font.lfQuality = CLEARTYPE_QUALITY;
+    wcscpy( font.lfFaceName, L"Tahoma" );
+    return CreateFontIndirectW( &font );
+}
+
+/* Runs the dialog on the current thread; returns the index of the chosen command, or ~0u when cancelled. */
+static UINT32 run_dialog( struct show_op *op, const WCHAR **labels, UINT32 count )
+{
+    WNDCLASSW cls = { 0 };
+    HMONITOR monitor;
+    MONITORINFO mi = { sizeof(mi) };
+    HFONT title_font, text_font;
+    HWND hwnd, title_wnd, text_wnd, buttons[MAX_COMMANDS];
+    RECT title_rc, text_rc, rc;
+    HDC hdc;
+    UINT dpi = GetDpiForSystem();
+    int margin = MulDiv( 24, dpi, 96 ), button_w = MulDiv( 120, dpi, 96 ), button_h = MulDiv( 32, dpi, 96 );
+    int gap = MulDiv( 8, dpi, 96 ), width, height, x, y;
+    const WCHAR *title = WindowsGetStringRawBuffer( op->title, NULL );
+    const WCHAR *content = WindowsGetStringRawBuffer( op->content, NULL );
+    UINT32 i, chosen = ~0u;
+    MSG msg;
+
+    cls.lpfnWndProc = dialog_wnd_proc;
+    cls.hInstance = GetModuleHandleW( NULL );
+    cls.hCursor = LoadCursorW( NULL, (const WCHAR *)IDC_ARROW );
+    cls.hbrBackground = GetSysColorBrush( COLOR_WINDOW );
+    cls.lpszClassName = dialog_class;
+    RegisterClassW( &cls );   /* fails harmlessly when a second dialog registers it again */
+
+    monitor = MonitorFromWindow( GetForegroundWindow(), MONITOR_DEFAULTTOPRIMARY );
+    GetMonitorInfoW( monitor, &mi );
+    width = min( MulDiv( 560, dpi, 96 ), mi.rcWork.right - mi.rcWork.left );
+
+    title_font = dialog_font( dpi, 3 );
+    text_font = dialog_font( dpi, 2 );
+    hdc = GetDC( NULL );
+    SetRect( &title_rc, 0, 0, width - 2 * margin, 0 );
+    SetRect( &text_rc, 0, 0, width - 2 * margin, 0 );
+    if (*title)
+    {
+        SelectObject( hdc, title_font );
+        DrawTextW( hdc, title, -1, &title_rc, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX );
+    }
+    SelectObject( hdc, text_font );
+    DrawTextW( hdc, content, -1, &text_rc, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX );
+    ReleaseDC( NULL, hdc );
+    text_rc.bottom = min( text_rc.bottom, (mi.rcWork.bottom - mi.rcWork.top) / 2 );
+
+    height = margin + title_rc.bottom + (*title ? gap * 2 : 0) + text_rc.bottom + margin + button_h + margin;
+    SetRect( &rc, 0, 0, width, height );
+    AdjustWindowRectEx( &rc, WS_POPUP | WS_BORDER, FALSE, WS_EX_TOPMOST | WS_EX_DLGMODALFRAME );
+    x = (mi.rcWork.left + mi.rcWork.right - (rc.right - rc.left)) / 2;
+    y = (mi.rcWork.top + mi.rcWork.bottom - (rc.bottom - rc.top)) / 2;
+
+    hwnd = CreateWindowExW( WS_EX_TOPMOST | WS_EX_DLGMODALFRAME, dialog_class, title, WS_POPUP | WS_BORDER | WS_CAPTION,
+                            x, y, rc.right - rc.left, rc.bottom - rc.top, NULL, NULL, cls.hInstance, NULL );
+    if (!hwnd)
+    {
+        ERR( "could not create the dialog window, error %lu.\n", GetLastError() );
+        DeleteObject( title_font );
+        DeleteObject( text_font );
+        return op->default_index < count ? op->default_index : 0;
+    }
+    SetWindowLongPtrW( hwnd, GWLP_USERDATA, (LONG_PTR)op );
+
+    y = margin;
+    if (*title)
+    {
+        title_wnd = CreateWindowExW( 0, L"STATIC", title, WS_CHILD | WS_VISIBLE | SS_NOPREFIX, margin, y,
+                                     width - 2 * margin, title_rc.bottom, hwnd, NULL, cls.hInstance, NULL );
+        SendMessageW( title_wnd, WM_SETFONT, (WPARAM)title_font, FALSE );
+        y += title_rc.bottom + gap * 2;
+    }
+    text_wnd = CreateWindowExW( 0, L"STATIC", content, WS_CHILD | WS_VISIBLE | SS_NOPREFIX, margin, y,
+                                width - 2 * margin, text_rc.bottom, hwnd, NULL, cls.hInstance, NULL );
+    SendMessageW( text_wnd, WM_SETFONT, (WPARAM)text_font, FALSE );
+    y += text_rc.bottom + margin;
+
+    /* the buttons sit at the bottom right, in command order */
+    x = width - margin - count * button_w - (count - 1) * gap;
+    for (i = 0; i < count; i++)
+    {
+        BOOL is_default = (i == op->default_index);
+        buttons[i] = CreateWindowExW( 0, L"BUTTON", labels[i],
+                                      WS_CHILD | WS_VISIBLE | WS_TABSTOP | (is_default ? BS_DEFPUSHBUTTON : BS_PUSHBUTTON),
+                                      x + i * (button_w + gap), y, button_w, button_h, hwnd,
+                                      (HMENU)(UINT_PTR)(ID_BUTTON_FIRST + i), cls.hInstance, NULL );
+        SendMessageW( buttons[i], WM_SETFONT, (WPARAM)text_font, FALSE );
+    }
+
+    EnterCriticalSection( &op->cs );
+    op->hwnd = hwnd;
+    LeaveCriticalSection( &op->cs );
+
+    ShowWindow( hwnd, SW_SHOW );
+    SetForegroundWindow( hwnd );
+    SetFocus( buttons[op->default_index < count ? op->default_index : 0] );
+
+    while (GetMessageW( &msg, NULL, 0, 0 ) > 0)
+    {
+        if (msg.hwnd == hwnd && msg.message == WM_DIALOG_DONE)
+        {
+            chosen = (UINT32)msg.wParam;
+            break;
+        }
+        /* Enter presses the default button, Escape sends IDCANCEL */
+        if (IsDialogMessageW( hwnd, &msg )) continue;
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+
+    EnterCriticalSection( &op->cs );
+    op->hwnd = NULL;
+    LeaveCriticalSection( &op->cs );
+    DestroyWindow( hwnd );
+    DeleteObject( title_font );
+    DeleteObject( text_font );
+    return chosen;
+}
+
+static DWORD WINAPI dialog_thread( void *arg )
+{
+    struct show_op *op = arg;
+    IAsyncOperationCompletedHandler_IUICommand *handler;
+    const WCHAR *labels[MAX_COMMANDS];
+    IUICommand *command = NULL;
+    IUICommandInvokedHandler *invoked = NULL;
+    AsyncStatus status;
+    HSTRING close = NULL;
+    UINT32 count = op->count, chosen, i;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_uwp_message_dialog" );
+
+    if (!count)
+    {
+        /* no commands: Windows shows a single "Close", and the operation's result is that implicit command */
+        WindowsCreateString( L"Close", 5, &close );
+        if (SUCCEEDED(create_command( close, NULL, NULL, &op->commands[0] ))) count = op->count = 1;
+        WindowsDeleteString( close );
+    }
+    for (i = 0; i < count; i++)
+    {
+        HSTRING label = NULL;
+        IUICommand_get_Label( op->commands[i], &label );
+        labels[i] = wcsdup( WindowsGetStringRawBuffer( label, NULL ) );
+        WindowsDeleteString( label );
+    }
+
+    chosen = run_dialog( op, labels, count );
+    for (i = 0; i < count; i++) free( (void *)labels[i] );
+
+    if (chosen < count)
+    {
+        IUICommand_AddRef( (command = op->commands[chosen]) );
+        IUICommand_get_Invoked( command, &invoked );
+    }
+    TRACE( "dialog closed: command %u of %u, invoked handler %p.\n", chosen, count, invoked );
+
+    /* the command's own handler runs before the operation completes */
+    if (invoked)
+    {
+        IUICommandInvokedHandler_Invoke( invoked, command );
+        IUICommandInvokedHandler_Release( invoked );
+    }
+
+    EnterCriticalSection( &op->cs );
+    op->result = command;
+    op->status = status = command ? Completed : Canceled;
+    handler = op->handler;
+    op->handler = NULL;
+    LeaveCriticalSection( &op->cs );
+
+    if (handler)
+    {
+        IAsyncOperationCompletedHandler_IUICommand_Invoke( handler, &op->IAsyncOperation_IUICommand_iface, status );
+        IAsyncOperationCompletedHandler_IUICommand_Release( handler );
+    }
+    IAsyncOperation_IUICommand_Release( &op->IAsyncOperation_IUICommand_iface );
+    return 0;
+}
+
+static HRESULT show_dialog( struct message_dialog *dialog, IAsyncOperation_IUICommand **value )
+{
+    struct show_op *op;
+    HANDLE thread;
+    UINT32 i;
+
+    *value = NULL;
+    if (dialog->count > MAX_COMMANDS) return E_UNEXPECTED;
+    if (!(op = calloc( 1, sizeof(*op) ))) return E_OUTOFMEMORY;
+    op->IAsyncOperation_IUICommand_iface.lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 2;   /* the caller's and the dialog thread's */
+    op->status = Started;
+    InitializeCriticalSectionEx( &op->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    op->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": show_op.cs");
+    WindowsDuplicateString( dialog->title, &op->title );
+    WindowsDuplicateString( dialog->content, &op->content );
+    for (i = 0; i < dialog->count; i++) IUICommand_AddRef( (op->commands[i] = dialog->commands[i]) );
+    op->count = dialog->count;
+    op->default_index = dialog->default_index;
+    op->cancel_index = dialog->cancel_index;
+
+    FIXME( "showing dialog title %s, content %s, %u commands.\n", debugstr_hstring(op->title),
+           debugstr_hstring(op->content), op->count );
+
+    if (!(thread = CreateThread( NULL, 0, dialog_thread, op, 0, NULL )))
+    {
+        op->ref = 1;
+        IAsyncOperation_IUICommand_Release( &op->IAsyncOperation_IUICommand_iface );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    CloseHandle( thread );
+    *value = &op->IAsyncOperation_IUICommand_iface;
     return S_OK;
 }
