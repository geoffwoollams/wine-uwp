diff --git a/dlls/kernelbase/memory.c b/dlls/kernelbase/memory.c
index 1cce666..0947a97 100644
--- a/dlls/kernelbase/memory.c
+++ b/dlls/kernelbase/memory.c
@@ -1592,6 +1592,40 @@ BOOL WINAPI SetProcessDefaultCpuSets(HANDLE process, const ULONG *cpu_set_ids, U
 }
 
 
+/* The Set functions above keep nothing, so no CPU sets are ever selected: threads and
+ * processes may run on any CPU, and the selection is empty. */
+static BOOL no_cpu_sets( ULONG *cpu_set_ids, ULONG count, ULONG *required )
+{
+    if (!required || (count && !cpu_set_ids))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *required = 0;
+    return TRUE;
+}
+
+
+/***********************************************************************
+ *           GetThreadSelectedCpuSets   (kernelbase.@)
+ */
+BOOL WINAPI GetThreadSelectedCpuSets(HANDLE thread, ULONG *cpu_set_ids, ULONG count, ULONG *required)
+{
+    TRACE( "thread %p, cpu_set_ids %p, count %lu, required %p.\n", thread, cpu_set_ids, count, required );
+    return no_cpu_sets( cpu_set_ids, count, required );
+}
+
+
+/***********************************************************************
+ *           GetProcessDefaultCpuSets   (kernelbase.@)
+ */
+BOOL WINAPI GetProcessDefaultCpuSets(HANDLE process, ULONG *cpu_set_ids, ULONG count, ULONG *required)
+{
+    TRACE( "process %p, cpu_set_ids %p, count %lu, required %p.\n", process, cpu_set_ids, count, required );
+    return no_cpu_sets( cpu_set_ids, count, required );
+}
+
+
