+/* Values made by the builtin JsonValue/JsonArray classes (JsonValue.Parse, JsonValue.CreateStringValue, ...)
+ * are not jnodes; copy them into one. */
+static HRESULT jnode_import(IJsonValue *value, struct jnode **out)
+{
+    IJsonObject *object;
+    JsonValueType type;
+    struct jnode *n, *child;
+    UINT32 i;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!value) return E_POINTER;
+    if (value->lpVtbl == &jvalue_vtbl)
+    {
+        *out = impl_from_jvalue(value);
+        jnode_addref(*out);
+        return S_OK;
+    }
+    if (FAILED(hr = IJsonValue_get_ValueType(value, &type))) return hr;
+    if (type == JsonValueType_Object)
+    {
+        if (FAILED(hr = IJsonValue_GetObject(value, &object))) return hr;
+        if (object->lpVtbl != &jobject_vtbl)
+        {
+            FIXME("foreign JsonObject %p not supported.\n", object);
+            IJsonObject_Release(object);
+            return E_NOTIMPL;
+        }
+        *out = impl_from_jobject(object); /* keeps the reference from GetObject */
+        return S_OK;
+    }
+    if (!(n = jnode_create(type))) return E_OUTOFMEMORY;
+    switch (type)
+    {
+    case JsonValueType_String: hr = IJsonValue_GetString(value, &n->str); break;
+    case JsonValueType_Number: hr = IJsonValue_GetNumber(value, &n->num); break;
+    case JsonValueType_Boolean: hr = IJsonValue_GetBoolean(value, &n->boolean_value); break;
+    case JsonValueType_Array:
+    {
+        IJsonArray *array;
+        IJsonValue *item;
+
+        if (FAILED(hr = IJsonValue_GetArray(value, &array))) break;
+        if (array->lpVtbl == &jarray_vtbl)
+        {
+            jnode_release(n);
+            *out = impl_from_jarray(array); /* keeps the reference from GetArray */
+            return S_OK;
+        }
+        for (i = 0; SUCCEEDED(hr) && (hr = json_array_get_at(array, i, &item)) == S_OK; i++)
+        {
+            if (SUCCEEDED(hr = jnode_import(item, &child)))
+            {
+                hr = jnode_add(n, NULL, child);
+                jnode_release(child);
+            }
+            IJsonValue_Release(item);
+        }
+        if (hr == S_FALSE) hr = S_OK;
+        IJsonArray_Release(array);
+        break;
+    }
+    default: hr = S_OK; break;
+    }
+    if (FAILED(hr)) { jnode_release(n); return hr; }
+    *out = n;
+    return S_OK;
+}
