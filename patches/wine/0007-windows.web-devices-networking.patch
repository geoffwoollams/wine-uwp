+/* ---- stringify ---- */
+struct sbuf { WCHAR *data; size_t len, cap; };
+static void sb_append(struct sbuf *sb, const WCHAR *s, size_t n)
+{
+    if (sb->len + n + 1 > sb->cap)
+    {
+        size_t cap = max(sb->cap * 2, sb->len + n + 64);
+        WCHAR *d = realloc(sb->data, cap * sizeof(WCHAR));
+        if (!d) return;
+        sb->data = d;
+        sb->cap = cap;
+    }
+    memcpy(sb->data + sb->len, s, n * sizeof(WCHAR));
+    sb->len += n;
+    sb->data[sb->len] = 0;
+}
+static void sb_string(struct sbuf *sb, const WCHAR *s)
+{
+    sb_append(sb, L"\"", 1);
+    for (; *s; s++)
+    {
+        switch (*s)
+        {
+        case '"': sb_append(sb, L"\\\"", 2); break;
+        case '\\': sb_append(sb, L"\\\\", 2); break;
+        case '\n': sb_append(sb, L"\\n", 2); break;
+        case '\r': sb_append(sb, L"\\r", 2); break;
+        case '\t': sb_append(sb, L"\\t", 2); break;
+        default: sb_append(sb, s, 1);
+        }
+    }
+    sb_append(sb, L"\"", 1);
+}
+static void jnode_write(struct jnode *n, struct sbuf *sb)
+{
+    WCHAR tmp[64];
+    UINT32 i;
+
+    switch (n->type)
+    {
+    case JsonValueType_Null: sb_append(sb, L"null", 4); break;
+    case JsonValueType_Boolean: if (n->boolean_value) sb_append(sb, L"true", 4); else sb_append(sb, L"false", 5); break;
+    case JsonValueType_Number:
+        swprintf(tmp, ARRAY_SIZE(tmp), L"%.17g", n->num);
+        sb_append(sb, tmp, wcslen(tmp));
+        break;
+    case JsonValueType_String: sb_string(sb, WindowsGetStringRawBuffer(n->str, NULL)); break;
+    case JsonValueType_Array:
+        sb_append(sb, L"[", 1);
+        for (i = 0; i < n->count; i++) { if (i) sb_append(sb, L",", 1); jnode_write(n->items[i], sb); }
+        sb_append(sb, L"]", 1);
+        break;
+    case JsonValueType_Object:
+        sb_append(sb, L"{", 1);
+        for (i = 0; i < n->count; i++)
+        {
+            if (i) sb_append(sb, L",", 1);
+            sb_string(sb, WindowsGetStringRawBuffer(n->keys[i], NULL));
+            sb_append(sb, L":", 1);
+            jnode_write(n->items[i], sb);
+        }
+        sb_append(sb, L"}", 1);
+        break;
+    }
+}
+static HRESULT jnode_stringify(struct jnode *n, HSTRING *out)
+{
+    struct sbuf sb = { 0 };
+    HRESULT hr;
+
+    jnode_write(n, &sb);
+    hr = WindowsCreateString(sb.data ? sb.data : L"", sb.len, out);
+    free(sb.data);
+    return hr;
+}
