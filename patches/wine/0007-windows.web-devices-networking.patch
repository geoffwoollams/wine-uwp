+static int find_key(struct jnode *impl, HSTRING name)
+{
+    UINT32 i;
+    INT32 cmp;
+
+    for (i = 0; i < impl->count; i++)
+        if (SUCCEEDED(WindowsCompareStringOrdinal(impl->keys[i], name, &cmp)) && !cmp) return i;
+    return -1;
+}
+static HRESULT get_named(struct jnode *impl, HSTRING name, JsonValueType type, struct jnode **out)
+{
+    int idx = find_key(impl, name);
+    if (idx < 0) return HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+    if (impl->items[idx]->type != type) return E_ILLEGAL_METHOD_CALL;
+    *out = impl->items[idx];
+    return S_OK;
+}
+static HRESULT get_at(struct jnode *impl, UINT32 index, JsonValueType type, struct jnode **out)
+{
+    if (index >= impl->count) return E_BOUNDS;
+    if (impl->items[index]->type != type) return E_ILLEGAL_METHOD_CALL;
+    *out = impl->items[index];
+    return S_OK;
+}
