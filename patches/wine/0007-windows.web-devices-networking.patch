+struct jnode
+{
+    IJsonValue IJsonValue_iface;
+    IJsonObject IJsonObject_iface;
+    IJsonArray IJsonArray_iface;
+    LONG ref;
+    JsonValueType type;
+    HSTRING str;
+    double num;
+    boolean boolean_value;
+    UINT32 count, capacity;
+    HSTRING *keys;          /* objects only */
+    struct jnode **items;   /* objects and arrays */
+};
+
+static HRESULT jnode_qi(struct jnode *impl, REFIID iid, void **out)
+{
+    TRACE("%p, %s, %p.\n", impl, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IJsonValue))
+        *out = &impl->IJsonValue_iface;
+    else if (impl->type == JsonValueType_Object && IsEqualGUID(iid, &IID_IJsonObject))
+        *out = &impl->IJsonObject_iface;
+    else if (impl->type == JsonValueType_Array && IsEqualGUID(iid, &IID_IJsonArray))
+        *out = &impl->IJsonArray_iface;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&impl->ref);
+    return S_OK;
+}
+static ULONG jnode_addref(struct jnode *impl) { return InterlockedIncrement(&impl->ref); }
+static ULONG jnode_release(struct jnode *impl)
+{
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    UINT32 i;
+
+    if (!ref)
+    {
+        WindowsDeleteString(impl->str);
+        for (i = 0; i < impl->count; i++)
+        {
+            if (impl->keys) WindowsDeleteString(impl->keys[i]);
+            jnode_release(impl->items[i]);
+        }
+        free(impl->keys);
+        free(impl->items);
+        free(impl);
+    }
+    return ref;
+}
