+static struct jnode *parse_value(const WCHAR **pp, int depth);
+
+static BOOL parse_string(const WCHAR **pp, WCHAR **out)
+{
+    const WCHAR *p = *pp + 1;
+    WCHAR *buf = malloc((wcslen(p) + 1) * sizeof(WCHAR)), *w = buf;
+
+    if (!buf) return FALSE;
+    while (*p && *p != '"')
+    {
+        if (*p == '\\')
+        {
+            p++;
+            switch (*p)
+            {
+            case 'n': *w++ = '\n'; break;
+            case 'r': *w++ = '\r'; break;
+            case 't': *w++ = '\t'; break;
+            case 'b': *w++ = '\b'; break;
+            case 'f': *w++ = '\f'; break;
+            case 'u':
+            {
+                WCHAR *end;
+                WCHAR hex[5] = { p[1], p[2], p[3], p[4], 0 };
+                *w++ = (WCHAR)wcstoul(hex, &end, 16);
+                p += 4;
+                break;
+            }
+            case 0: free(buf); return FALSE;
+            default: *w++ = *p;
+            }
+            p++;
+        }
+        else *w++ = *p++;
+    }
+    if (*p != '"') { free(buf); return FALSE; }
+    *w = 0;
+    *pp = p + 1;
+    *out = buf;
+    return TRUE;
+}
+
+static struct jnode *parse_value(const WCHAR **pp, int depth)
+{
+    const WCHAR *p = skip_ws(*pp);
+    struct jnode *n = NULL;
+
+    if (depth > 64) return NULL;
+    if (*p == '{')
+    {
+        n = jnode_create(JsonValueType_Object);
+        p = skip_ws(p + 1);
+        if (*p == '}') { *pp = p + 1; return n; }
+        for (;;)
+        {
+            WCHAR *key;
+            HSTRING hkey;
+            struct jnode *child;
+
+            p = skip_ws(p);
+            if (*p != '"' || !parse_string(&p, &key)) goto fail;
+            WindowsCreateString(key, wcslen(key), &hkey);
+            free(key);
+            p = skip_ws(p);
+            if (*p != ':') { WindowsDeleteString(hkey); goto fail; }
+            p++;
+            if (!(child = parse_value(&p, depth + 1))) { WindowsDeleteString(hkey); goto fail; }
+            jnode_add(n, hkey, child);
+            jnode_release(child);
+            WindowsDeleteString(hkey);
+            p = skip_ws(p);
+            if (*p == ',') { p++; continue; }
+            if (*p == '}') { p++; break; }
+            goto fail;
+        }
+    }
+    else if (*p == '[')
+    {
+        n = jnode_create(JsonValueType_Array);
+        p = skip_ws(p + 1);
+        if (*p == ']') { *pp = p + 1; return n; }
+        for (;;)
+        {
+            struct jnode *child;
+            if (!(child = parse_value(&p, depth + 1))) goto fail;
+            jnode_add(n, NULL, child);
+            jnode_release(child);
+            p = skip_ws(p);
+            if (*p == ',') { p++; continue; }
+            if (*p == ']') { p++; break; }
+            goto fail;
+        }
+    }
+    else if (*p == '"')
+    {
+        WCHAR *s;
+        if (!parse_string(&p, &s)) return NULL;
+        n = jnode_create(JsonValueType_String);
+        WindowsCreateString(s, wcslen(s), &n->str);
+        free(s);
+    }
+    else if (!wcsncmp(p, L"true", 4)) { n = jnode_create(JsonValueType_Boolean); n->boolean_value = TRUE; p += 4; }
+    else if (!wcsncmp(p, L"false", 5)) { n = jnode_create(JsonValueType_Boolean); p += 5; }
+    else if (!wcsncmp(p, L"null", 4)) { n = jnode_create(JsonValueType_Null); p += 4; }
+    else if (*p == '-' || (*p >= '0' && *p <= '9'))
+    {
+        WCHAR *end;
+        double d = wcstod(p, &end);
+        if (end == p) return NULL;
+        n = jnode_create(JsonValueType_Number);
+        n->num = d;
+        p = end;
+    }
+    else return NULL;
+
+    if (!n) return NULL;
+    *pp = p;
+    return n;
+fail:
+    if (n) jnode_release(n);
+    return NULL;
+}
+
+HRESULT json_parse_object(HSTRING input, IJsonObject **out, boolean *ok)
+{
+    const WCHAR *p = WindowsGetStringRawBuffer(input, NULL);
+    struct jnode *n = p ? parse_value(&p, 0) : NULL;
+
+    *out = NULL;
+    if (n && skip_ws(p)[0] == 0 && n->type == JsonValueType_Object)
+    {
+        *out = &n->IJsonObject_iface;
+        if (ok) *ok = TRUE;
+        return S_OK;
+    }
+    if (n) jnode_release(n);
+    if (ok) { *ok = FALSE; return S_OK; }
+    return E_INVALIDARG;
+}
+
+HRESULT json_object_create(IJsonObject **out)
+{
+    struct jnode *n = jnode_create(JsonValueType_Object);
+    if (!n) return E_OUTOFMEMORY;
+    *out = &n->IJsonObject_iface;
+    return S_OK;
+}
