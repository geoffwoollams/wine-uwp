--- /dev/null
+++ b/dlls/windows.networking.connectivity/hostnames.c
@@ -0,0 +1,195 @@
+/* IVectorView<HostName*> of the local host's IPv4 addresses (and its computer name). */
+#include "private.h"
+#include "winsock2.h"
+#include "iphlpapi.h"
+#include "roapi.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(connectivity);
+
+#define MAX_NAMES 32
+
+struct hostnames
+{
+    IVectorView_HostName IVectorView_HostName_iface;
+    IIterable_HostName IIterable_HostName_iface;
+    UINT32 count;
+    IHostName *items[MAX_NAMES];
+};
+static struct hostnames hostnames_obj;
+
+struct names_iter { IIterator_HostName IIterator_HostName_iface; UINT32 pos; };
+
+/* ---- iterator ---- */
+static inline struct names_iter *iter_from( IIterator_HostName *iface ) { return CONTAINING_RECORD( iface, struct names_iter, IIterator_HostName_iface ); }
+static HRESULT WINAPI it_QueryInterface( IIterator_HostName *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_HostName ))
+    { *out = iface; IIterator_HostName_AddRef( iface ); return S_OK; }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI it_AddRef( IIterator_HostName *iface ) { return 2; }
+static ULONG WINAPI it_Release( IIterator_HostName *iface ) { return 1; }
+static HRESULT WINAPI it_GetIids( IIterator_HostName *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI it_GetRuntimeClassName( IIterator_HostName *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI it_GetTrustLevel( IIterator_HostName *iface, TrustLevel *l ) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI it_get_Current( IIterator_HostName *iface, IHostName **v )
+{
+    struct names_iter *it = iter_from( iface );
+    if (it->pos >= hostnames_obj.count) { *v = NULL; return E_BOUNDS; }
+    *v = hostnames_obj.items[it->pos];
+    IHostName_AddRef( *v );
+    return S_OK;
+}
+static HRESULT WINAPI it_get_HasCurrent( IIterator_HostName *iface, boolean *v ) { *v = iter_from( iface )->pos < hostnames_obj.count; return S_OK; }
+static HRESULT WINAPI it_MoveNext( IIterator_HostName *iface, boolean *v )
+{
+    struct names_iter *it = iter_from( iface );
+    if (it->pos < hostnames_obj.count) it->pos++;
+    *v = it->pos < hostnames_obj.count;
+    return S_OK;
+}
+static HRESULT WINAPI it_GetMany( IIterator_HostName *iface, UINT32 size, IHostName **items, UINT32 *actual )
+{
+    struct names_iter *it = iter_from( iface );
+    UINT32 n = 0;
+    while (n < size && it->pos < hostnames_obj.count)
+    {
+        items[n] = hostnames_obj.items[it->pos++];
+        IHostName_AddRef( items[n++] );
+    }
+    *actual = n;
+    return S_OK;
+}
+static const IIterator_HostNameVtbl it_vtbl = { it_QueryInterface, it_AddRef, it_Release, it_GetIids, it_GetRuntimeClassName,
+    it_GetTrustLevel, it_get_Current, it_get_HasCurrent, it_MoveNext, it_GetMany };
+
+/* ---- IIterable ---- */
+static HRESULT WINAPI iter_QueryInterface( IIterable_HostName *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterable_HostName ))
+    { *out = &hostnames_obj.IIterable_HostName_iface; return S_OK; }
+    if (IsEqualGUID( iid, &IID_IVectorView_HostName )) { *out = &hostnames_obj.IVectorView_HostName_iface; return S_OK; }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI iter_AddRef( IIterable_HostName *iface ) { return 2; }
+static ULONG WINAPI iter_Release( IIterable_HostName *iface ) { return 1; }
+static HRESULT WINAPI iter_GetIids( IIterable_HostName *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI iter_GetRuntimeClassName( IIterable_HostName *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI iter_GetTrustLevel( IIterable_HostName *iface, TrustLevel *l ) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI iter_First( IIterable_HostName *iface, IIterator_HostName **value )
+{
+    struct names_iter *it = calloc( 1, sizeof(*it) );
+    if (!it) return E_OUTOFMEMORY;
+    it->IIterator_HostName_iface.lpVtbl = &it_vtbl;
+    *value = &it->IIterator_HostName_iface;
+    return S_OK;
+}
+static const IIterable_HostNameVtbl iter_vtbl = { iter_QueryInterface, iter_AddRef, iter_Release, iter_GetIids,
+    iter_GetRuntimeClassName, iter_GetTrustLevel, iter_First };
+
+/* ---- IVectorView ---- */
+static HRESULT WINAPI vv_QueryInterface( IVectorView_HostName *iface, REFIID iid, void **out )
+{ return iter_QueryInterface( &hostnames_obj.IIterable_HostName_iface, iid, out ); }
+static ULONG WINAPI vv_AddRef( IVectorView_HostName *iface ) { return 2; }
+static ULONG WINAPI vv_Release( IVectorView_HostName *iface ) { return 1; }
+static HRESULT WINAPI vv_GetIids( IVectorView_HostName *iface, ULONG *c, IID **i ) { return E_NOTIMPL; }
+static HRESULT WINAPI vv_GetRuntimeClassName( IVectorView_HostName *iface, HSTRING *n ) { return E_NOTIMPL; }
+static HRESULT WINAPI vv_GetTrustLevel( IVectorView_HostName *iface, TrustLevel *l ) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI vv_GetAt( IVectorView_HostName *iface, UINT32 index, IHostName **value )
+{
+    if (index >= hostnames_obj.count) { *value = NULL; return E_BOUNDS; }
+    *value = hostnames_obj.items[index];
+    IHostName_AddRef( *value );
+    return S_OK;
+}
+static HRESULT WINAPI vv_get_Size( IVectorView_HostName *iface, UINT32 *value ) { *value = hostnames_obj.count; return S_OK; }
+static HRESULT WINAPI vv_IndexOf( IVectorView_HostName *iface, IHostName *element, UINT32 *index, BOOLEAN *found )
+{
+    UINT32 i;
+    *found = FALSE; *index = 0;
+    for (i = 0; i < hostnames_obj.count; i++) if (hostnames_obj.items[i] == element) { *index = i; *found = TRUE; break; }
+    return S_OK;
+}
+static HRESULT WINAPI vv_GetMany( IVectorView_HostName *iface, UINT32 start, UINT32 size, IHostName **items, UINT32 *actual )
+{
+    UINT32 n = 0;
+    while (n < size && start + n < hostnames_obj.count)
+    {
+        items[n] = hostnames_obj.items[start + n];
+        IHostName_AddRef( items[n++] );
+    }
+    *actual = n;
+    return S_OK;
+}
+static const IVectorView_HostNameVtbl vv_vtbl = { vv_QueryInterface, vv_AddRef, vv_Release, vv_GetIids, vv_GetRuntimeClassName,
+    vv_GetTrustLevel, vv_GetAt, vv_get_Size, vv_IndexOf, vv_GetMany };
+
+static void add_name( IHostNameFactory *factory, const WCHAR *name )
+{
+    HSTRING str;
+    IHostName *host;
+
+    if (hostnames_obj.count >= MAX_NAMES) return;
+    if (FAILED(WindowsCreateString( name, wcslen( name ), &str ))) return;
+    if (SUCCEEDED(IHostNameFactory_CreateHostName( factory, str, &host ))) hostnames_obj.items[hostnames_obj.count++] = host;
+    WindowsDeleteString( str );
+}
+
+static INIT_ONCE names_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK init_names( INIT_ONCE *once, void *param, void **ctx )
+{
+    IHostNameFactory *factory;
+    IP_ADAPTER_ADDRESSES *addrs = NULL, *a;
+    IP_ADAPTER_UNICAST_ADDRESS *u;
+    ULONG size = 0;
+    HSTRING cls;
+    WCHAR buf[64];
+    DWORD len;
+
+    /* Reporting real addresses makes some titles start their own network layer, which does not work yet:
+     * keep the list empty unless explicitly requested. */
+    if (!GetEnvironmentVariableW( L"WINE_REPORT_HOSTNAMES", NULL, 0 )) return TRUE;
+
+    WindowsCreateString( L"Windows.Networking.HostName", 27, &cls );
+    if (FAILED(RoGetActivationFactory( cls, &IID_IHostNameFactory, (void **)&factory ))) { WindowsDeleteString( cls ); return TRUE; }
+    WindowsDeleteString( cls );
+
+    if (GetAdaptersAddresses( AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER, NULL, NULL, &size ) == ERROR_BUFFER_OVERFLOW
+        && (addrs = malloc( size )) &&
+        GetAdaptersAddresses( AF_INET, GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER, NULL, addrs, &size ) == NO_ERROR)
+    {
+        for (a = addrs; a; a = a->Next)
+        {
+            if (a->OperStatus != IfOperStatusUp || a->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+            for (u = a->FirstUnicastAddress; u; u = u->Next)
+            {
+                struct sockaddr_in *sin = (struct sockaddr_in *)u->Address.lpSockaddr;
+                if (u->Address.lpSockaddr->sa_family != AF_INET) continue;
+                swprintf( buf, ARRAY_SIZE(buf), L"%u.%u.%u.%u", sin->sin_addr.S_un.S_un_b.s_b1, sin->sin_addr.S_un.S_un_b.s_b2,
+                          sin->sin_addr.S_un.S_un_b.s_b3, sin->sin_addr.S_un.S_un_b.s_b4 );
+                add_name( factory, buf );
+            }
+        }
+    }
+    free( addrs );
+    len = ARRAY_SIZE(buf);
+    if (GetComputerNameW( buf, &len )) add_name( factory, buf );
+    IHostNameFactory_Release( factory );
+    TRACE( "reporting %u host names.\n", hostnames_obj.count );
+    return TRUE;
+}
+
+HRESULT local_hostnames_create( IVectorView_HostName **out )
+{
+    InitOnceExecuteOnce( &names_once, init_names, NULL, NULL );
+    hostnames_obj.IVectorView_HostName_iface.lpVtbl = &vv_vtbl;
+    hostnames_obj.IIterable_HostName_iface.lpVtbl = &iter_vtbl;
+    *out = &hostnames_obj.IVectorView_HostName_iface;
+    return S_OK;
+}
