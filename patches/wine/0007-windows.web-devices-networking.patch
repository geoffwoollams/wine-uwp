+static struct jnode *jnode_create(JsonValueType type)
+{
+    struct jnode *n;
+
+    if (!(n = calloc(1, sizeof(*n)))) return NULL;
+    n->IJsonValue_iface.lpVtbl = &jvalue_vtbl;
+    n->IJsonObject_iface.lpVtbl = &jobject_vtbl;
+    n->IJsonArray_iface.lpVtbl = &jarray_vtbl;
+    n->ref = 1;
+    n->type = type;
+    return n;
+}
+
+static HRESULT jnode_add(struct jnode *parent, HSTRING key, struct jnode *child)
+{
+    if (parent->count == parent->capacity)
+    {
+        UINT32 cap = parent->capacity ? parent->capacity * 2 : 8;
+        struct jnode **items = realloc(parent->items, cap * sizeof(*items));
+        HSTRING *keys = parent->keys;
+
+        if (!items) return E_OUTOFMEMORY;
+        parent->items = items;
+        if (parent->type == JsonValueType_Object)
+        {
+            if (!(keys = realloc(parent->keys, cap * sizeof(*keys)))) return E_OUTOFMEMORY;
+            parent->keys = keys;
+        }
+        parent->capacity = cap;
+    }
+    if (parent->type == JsonValueType_Object)
+    {
+        HRESULT hr = WindowsDuplicateString(key, &parent->keys[parent->count]);
+        if (FAILED(hr)) return hr;
+    }
+    parent->items[parent->count++] = child;
+    jnode_addref(child);
+    return S_OK;
+}
