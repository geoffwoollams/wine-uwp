diff --git a/dlls/msxml3/factory.c b/dlls/msxml3/factory.c
index 5847752..d3ba32b 100644
--- a/dlls/msxml3/factory.c
+++ b/dlls/msxml3/factory.c
@@ -299,6 +299,9 @@ static ClassFactory xmlviewcf = { { &ClassFactoryVtbl }, XMLView_create };
 /******************************************************************
  *		DllGetClassObject (MSXML3.@)
  */
+static const GUID clsid_free_threaded_xmlhttp60 =
+    { 0x88d96a09, 0xf192, 0x11d4, { 0xa6, 0x5f, 0x00, 0x40, 0x96, 0x32, 0x51, 0xe5 } };
