+HRESULT property_set_create_persistent( BOOL missing_is_null, const WCHAR *path, IPropertySet **out );
+
+HRESULT property_set_create( BOOL missing_is_null, IPropertySet **out )
+{
+    struct property_set *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPropertySet_iface.lpVtbl = &property_set_vtbl;
+    impl->IObservableMap_HSTRING_IInspectable_iface.lpVtbl = &observable_map_vtbl;
+    impl->IMap_HSTRING_IInspectable_iface.lpVtbl = &map_vtbl;
+    impl->IIterable_IKeyValuePair_HSTRING_IInspectable_iface.lpVtbl = &iterable_vtbl;
+    impl->ref = 1;
+    impl->missing_is_null = missing_is_null;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": property_set.cs");
+    *out = &impl->IPropertySet_iface;
+    return S_OK;
+}
+
+/* Like property_set_create() but the contents are loaded from / saved to a file. */
+HRESULT property_set_create_persistent( BOOL missing_is_null, const WCHAR *path, IPropertySet **out )
+{
+    struct property_set *impl;
+    HRESULT hr;
+    WCHAR dir[MAX_PATH], *sep;
+
+    if (FAILED(hr = property_set_create( missing_is_null, out ))) return hr;
+    impl = impl_from_IPropertySet( *out );
+    if (!path) return S_OK;
+
+    impl->path = wcsdup( path );
+    lstrcpynW( dir, path, MAX_PATH );
+    if ((sep = wcsrchr( dir, '\\' )))
+    {
+        WCHAR *p;
+        *sep = 0;
+        for (p = dir + 3; *p; p++) if (*p == '\\') { *p = 0; CreateDirectoryW( dir, NULL ); *p = '\\'; }
+        CreateDirectoryW( dir, NULL );
+    }
+    property_set_load( impl );
+    return S_OK;
+}
