+DEFINE_IINSPECTABLE( iterable, IIterable_IKeyValuePair_HSTRING_IInspectable, struct property_set, IPropertySet_iface )
+
+static HRESULT WINAPI iterable_First( IIterable_IKeyValuePair_HSTRING_IInspectable *iface,
+                                      IIterator_IKeyValuePair_HSTRING_IInspectable **value )
+{
+    struct property_set *impl = impl_from_IIterable_IKeyValuePair_HSTRING_IInspectable( iface );
+    struct iterator *it;
+    HRESULT hr = S_OK;
+    UINT32 i;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!(it = calloc( 1, sizeof(*it) ))) return E_OUTOFMEMORY;
+    it->IIterator_IKeyValuePair_HSTRING_IInspectable_iface.lpVtbl = &iter_vtbl;
+    it->ref = 1;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->count && !(it->items = calloc( impl->count, sizeof(*it->items) ))) hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < impl->count; i++)
+    {
+        if (SUCCEEDED(hr = create_kv( impl->entries[i].key, impl->entries[i].value, &it->items[i] ))) it->count++;
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    if (FAILED(hr))
+    {
+        IIterator_IKeyValuePair_HSTRING_IInspectable_Release( &it->IIterator_IKeyValuePair_HSTRING_IInspectable_iface );
+        return hr;
+    }
+    *value = &it->IIterator_IKeyValuePair_HSTRING_IInspectable_iface;
+    return S_OK;
+}
+
+static const IIterable_IKeyValuePair_HSTRING_IInspectableVtbl iterable_vtbl =
+{
+    iterable_QueryInterface, iterable_AddRef, iterable_Release,
+    iterable_GetIids, iterable_GetRuntimeClassName, iterable_GetTrustLevel,
