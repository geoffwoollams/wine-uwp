+static HRESULT storage_folder_qi(struct storage_folder *impl, REFIID iid, void **out)
+{
+    TRACE("%p, %s, %p.\n", impl, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IStorageFolder))
+        *out = &impl->IStorageFolder_iface;
+    else if (IsEqualGUID(iid, &IID_IStorageItem))
+        *out = &impl->IStorageItem_iface;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&impl->ref);
+    return S_OK;
+}
+static ULONG storage_folder_addref(struct storage_folder *impl) { return InterlockedIncrement(&impl->ref); }
+static ULONG storage_folder_release(struct storage_folder *impl)
+{
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref) free(impl);
+    return ref;
+}
