+static HRESULT get_package_folder( const WCHAR *env, const WCHAR *leaf, IStorageFolder **value )
+{
+    WCHAR base[MAX_PATH], path[MAX_PATH], family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1];
+    UINT32 family_len = ARRAY_SIZE(family);
+    DWORD len;
+
+    if (!value) return E_POINTER;
+    if (GetCurrentPackageFamilyName( &family_len, family )) return HRESULT_FROM_WIN32( APPMODEL_ERROR_NO_PACKAGE );
+    len = GetEnvironmentVariableW( env, base, MAX_PATH );
+    if (!len || len >= MAX_PATH)
+    {
+        len = GetEnvironmentVariableW( L"USERPROFILE", base, MAX_PATH );
+        if (!len || len >= MAX_PATH) return E_FAIL;
+        wcscat( base, L"\\AppData\\Local" );
+    }
+    swprintf( path, MAX_PATH, L"%s\\Packages\\%s\\%s", base, family, leaf );
+    return storage_folder_create( path, value );
+}
