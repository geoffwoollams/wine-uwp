+/* Where a settings container is persisted: <env>\Packages\<package family>\Settings\<kind>.dat */
+static BOOL settings_path( ApplicationDataLocality locality, WCHAR *out )
+{
+    WCHAR base[MAX_PATH], family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1];
+    UINT32 len = ARRAY_SIZE(family);
+    DWORD n;
+
+    if (GetCurrentPackageFamilyName( &len, family )) return FALSE;
+    n = GetEnvironmentVariableW( locality == ApplicationDataLocality_Roaming ? L"APPDATA" : L"LOCALAPPDATA", base, MAX_PATH );
+    if (!n || n >= MAX_PATH) return FALSE;
+    swprintf( out, MAX_PATH, L"%s\\Packages\\%s\\Settings\\%s.dat", base, family,
+              locality == ApplicationDataLocality_Roaming ? L"roaming" : L"local" );
+    return TRUE;
+}
+
+static IApplicationDataContainer *settings_containers[2];
+
+static HRESULT get_settings_container( ApplicationDataLocality locality, IApplicationDataContainer **out )
+{
+    IApplicationDataContainer *container, *old;
+    struct app_container *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+
+    if (!(container = settings_containers[locality]))
+    {
+        if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+        impl->IApplicationDataContainer_iface.lpVtbl = &container_vtbl;
+        impl->ref = 1;
+        impl->locality = locality;
+        {
+            WCHAR path[MAX_PATH];
+            if (settings_path( locality, path )) hr = property_set_create_persistent( TRUE, path, &impl->values );
+            else hr = property_set_create( TRUE, &impl->values );
+        }
+        if (FAILED(hr)) { free( impl ); return hr; }
+        container = &impl->IApplicationDataContainer_iface;
+        if ((old = InterlockedCompareExchangePointer( (void **)&settings_containers[locality], container, NULL )))
+        {
+            IApplicationDataContainer_Release( container );
+            container = old;
+        }
+    }
+    IApplicationDataContainer_AddRef( container );
+    *out = container;
+    return S_OK;
+}
