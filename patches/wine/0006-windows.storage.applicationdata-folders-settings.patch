+/* ---- persistence for settings containers: one line per value, "<PropertyType> <hex UTF-16 name> <value>" ---- */
+static void hex_encode( const WCHAR *s, size_t count, char *out )
+{
+    static const char digits[] = "0123456789abcdef";
+    size_t i;
+
+    if (!count) { *out++ = '-'; *out = 0; return; }
+    for (i = 0; i < count; i++)
+    {
+        *out++ = digits[(s[i] >> 12) & 15]; *out++ = digits[(s[i] >> 8) & 15];
+        *out++ = digits[(s[i] >> 4) & 15];  *out++ = digits[s[i] & 15];
+    }
+    *out = 0;
+}
+
+static WCHAR *hex_decode( const char *hex, size_t *count )
+{
+    size_t n = strlen( hex ) / 4, i;
+    WCHAR *out;
+
+    if (hex[0] == '-' && !hex[1]) n = 0;
+    if (!(out = malloc( (n + 1) * sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < n; i++)
+    {
+        char chunk[5] = { hex[i * 4], hex[i * 4 + 1], hex[i * 4 + 2], hex[i * 4 + 3], 0 };
+        out[i] = (WCHAR)strtoul( chunk, NULL, 16 );
+    }
+    out[n] = 0;
+    *count = n;
+    return out;
+}
+
+/* caller holds the lock */
+static void property_set_save( struct property_set *impl )
+{
+    char *buf = NULL;
+    size_t len = 0, cap = 0;
+    WCHAR tmp[MAX_PATH + 8];
+    HANDLE file;
+    DWORD written;
+    UINT32 i;
+
+    if (!impl->path || impl->loading) return;
+
+    for (i = 0; i < impl->count; i++)
+    {
+        IPropertyValue *pv;
+        PropertyType type;
+        const WCHAR *name = WindowsGetStringRawBuffer( impl->entries[i].key, NULL );
+        UINT32 name_len = wcslen( name );
+        char *line, value[64] = "";
+        size_t line_len;
+        HSTRING str = NULL;
+        const WCHAR *str_raw = NULL;
+        UINT32 str_len = 0;
+
+        if (!impl->entries[i].value ||
+            FAILED(IInspectable_QueryInterface( impl->entries[i].value, &IID_IPropertyValue, (void **)&pv ))) continue;
+        if (FAILED(IPropertyValue_get_Type( pv, &type ))) { IPropertyValue_Release( pv ); continue; }
+
+        switch (type)
+        {
+        case PropertyType_UInt8: { BYTE v = 0; IPropertyValue_GetUInt8( pv, &v ); snprintf( value, sizeof(value), "%u", v ); break; }
+        case PropertyType_Int16: { INT16 v = 0; IPropertyValue_GetInt16( pv, &v ); snprintf( value, sizeof(value), "%d", v ); break; }
+        case PropertyType_UInt16: { UINT16 v = 0; IPropertyValue_GetUInt16( pv, &v ); snprintf( value, sizeof(value), "%u", v ); break; }
+        case PropertyType_Int32: { INT32 v = 0; IPropertyValue_GetInt32( pv, &v ); snprintf( value, sizeof(value), "%d", v ); break; }
+        case PropertyType_UInt32: { UINT32 v = 0; IPropertyValue_GetUInt32( pv, &v ); snprintf( value, sizeof(value), "%u", v ); break; }
+        case PropertyType_Int64: { INT64 v = 0; IPropertyValue_GetInt64( pv, &v ); snprintf( value, sizeof(value), "%I64d", v ); break; }
+        case PropertyType_UInt64: { UINT64 v = 0; IPropertyValue_GetUInt64( pv, &v ); snprintf( value, sizeof(value), "%I64u", v ); break; }
+        case PropertyType_Single: { float v = 0; IPropertyValue_GetSingle( pv, &v ); snprintf( value, sizeof(value), "%.9g", v ); break; }
+        case PropertyType_Double: { double v = 0; IPropertyValue_GetDouble( pv, &v ); snprintf( value, sizeof(value), "%.17g", v ); break; }
+        case PropertyType_Boolean: { boolean v = 0; IPropertyValue_GetBoolean( pv, &v ); snprintf( value, sizeof(value), "%d", v ? 1 : 0 ); break; }
+        case PropertyType_String:
+            if (SUCCEEDED(IPropertyValue_GetString( pv, &str ))) { str_raw = WindowsGetStringRawBuffer( str, &str_len ); }
+            break;
+        default:
+            FIXME( "not persisting %s of type %d.\n", debugstr_w( name ), type );
+            IPropertyValue_Release( pv );
+            continue;
+        }
+
+        line_len = 16 + name_len * 4 + 2 + str_len * 4 + sizeof(value);
+        if ((line = malloc( line_len )))
+        {
+            size_t pos = snprintf( line, line_len, "%d ", (int)type );
+            hex_encode( name, name_len, line + pos );
+            pos = strlen( line );
+            line[pos++] = ' ';
+            if (type == PropertyType_String) hex_encode( str_raw ? str_raw : L"", str_len, line + pos );
+            else strcpy( line + pos, value );
+            strcat( line, "\n" );
+            if (len + strlen( line ) + 1 > cap) { cap = max( cap * 2, len + strlen( line ) + 1024 ); buf = realloc( buf, cap ); }
+            memcpy( buf + len, line, strlen( line ) );
+            len += strlen( line );
+            free( line );
+        }
+        WindowsDeleteString( str );
+        IPropertyValue_Release( pv );
+    }
+
+    swprintf( tmp, ARRAY_SIZE(tmp), L"%s.tmp", impl->path );
+    file = CreateFileW( tmp, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        if (len) WriteFile( file, buf, len, &written, NULL );
+        CloseHandle( file );
+        if (!MoveFileExW( tmp, impl->path, MOVEFILE_REPLACE_EXISTING )) WARN( "failed to replace %s: %lu\n", debugstr_w( impl->path ), GetLastError() );
+    }
+    else WARN( "failed to create %s: %lu\n", debugstr_w( tmp ), GetLastError() );
+    free( buf );
+}
+
+static void property_set_load( struct property_set *impl )
+{
+    IMap_HSTRING_IInspectable *map = &impl->IMap_HSTRING_IInspectable_iface;
+    IPropertyValueStatics *statics = NULL;
+    HSTRING cls;
+    char *data, *p, *next;
+    LARGE_INTEGER size;
+    DWORD got;
+    HANDLE file;
+
+    file = CreateFileW( impl->path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return;
+    if (!GetFileSizeEx( file, &size ) || size.QuadPart > 16 * 1024 * 1024 || !(data = malloc( size.QuadPart + 1 ))) { CloseHandle( file ); return; }
+    if (!ReadFile( file, data, size.QuadPart, &got, NULL )) got = 0;
+    CloseHandle( file );
+    data[got] = 0;
+
+    WindowsCreateString( L"Windows.Foundation.PropertyValue", 32, &cls );
+    if (FAILED(RoGetActivationFactory( cls, &IID_IPropertyValueStatics, (void **)&statics ))) { WindowsDeleteString( cls ); free( data ); return; }
+    WindowsDeleteString( cls );
+
+    impl->loading = TRUE;
+    for (p = data; *p; p = next)
+    {
+        char *type_s = p, *name_s, *val_s;
+        int type;
+        size_t count;
+        WCHAR *name, *wstr;
+        HSTRING key, hs;
+        IInspectable *value = NULL;
+        boolean replaced;
+
+        if ((next = strchr( p, '\n' ))) *next++ = 0; else next = p + strlen( p );
+        if (!(name_s = strchr( type_s, ' ' )) || !(val_s = strchr( name_s + 1, ' ' ))) continue;
+        *name_s++ = 0; *val_s++ = 0;
+        type = atoi( type_s );
+        if (!(name = hex_decode( name_s, &count ))) continue;
+        WindowsCreateString( name, count, &key );
+        free( name );
+
+        switch (type)
+        {
+        case PropertyType_UInt8: IPropertyValueStatics_CreateUInt8( statics, (BYTE)strtoul( val_s, NULL, 10 ), &value ); break;
+        case PropertyType_Int16: IPropertyValueStatics_CreateInt16( statics, (INT16)strtol( val_s, NULL, 10 ), &value ); break;
+        case PropertyType_UInt16: IPropertyValueStatics_CreateUInt16( statics, (UINT16)strtoul( val_s, NULL, 10 ), &value ); break;
+        case PropertyType_Int32: IPropertyValueStatics_CreateInt32( statics, (INT32)strtol( val_s, NULL, 10 ), &value ); break;
+        case PropertyType_UInt32: IPropertyValueStatics_CreateUInt32( statics, (UINT32)strtoul( val_s, NULL, 10 ), &value ); break;
+        case PropertyType_Int64: IPropertyValueStatics_CreateInt64( statics, _strtoi64( val_s, NULL, 10 ), &value ); break;
+        case PropertyType_UInt64: IPropertyValueStatics_CreateUInt64( statics, _strtoui64( val_s, NULL, 10 ), &value ); break;
+        case PropertyType_Single: IPropertyValueStatics_CreateSingle( statics, (float)strtod( val_s, NULL ), &value ); break;
+        case PropertyType_Double: IPropertyValueStatics_CreateDouble( statics, strtod( val_s, NULL ), &value ); break;
+        case PropertyType_Boolean: IPropertyValueStatics_CreateBoolean( statics, atoi( val_s ) != 0, &value ); break;
+        case PropertyType_String:
+            if ((wstr = hex_decode( val_s, &count )))
+            {
+                WindowsCreateString( wstr, count, &hs );
+                IPropertyValueStatics_CreateString( statics, hs, &value );
+                WindowsDeleteString( hs );
+                free( wstr );
+            }
+            break;
+        }
+        if (value)
+        {
+            map_Insert( map, key, value, &replaced );
+            IInspectable_Release( value );
+        }
+        WindowsDeleteString( key );
+    }
+    impl->loading = FALSE;
+    IPropertyValueStatics_Release( statics );
+    free( data );
+}
+
+static HRESULT WINAPI map_Insert( IMap_HSTRING_IInspectable *iface, HSTRING key, IInspectable *value, boolean *replaced )
+{
+    struct property_set *impl = impl_from_IMap_HSTRING_IInspectable( iface );
+    HSTRING key_copy;
+    HRESULT hr;
+    int idx;
+
+    TRACE( "iface %p, key %s, value %p, replaced %p.\n", iface, debugstr_hstring( key ), value, replaced );
+
+    EnterCriticalSection( &impl->cs );
+    if ((idx = find_entry( impl, key )) >= 0)
+    {
+        IInspectable *old = impl->entries[idx].value;
+        if ((impl->entries[idx].value = value)) IInspectable_AddRef( value );
+        if (old) IInspectable_Release( old );
+        *replaced = TRUE;
+        property_set_save( impl );
+        LeaveCriticalSection( &impl->cs );
+        return S_OK;
+    }
+
+    if (impl->count == impl->capacity)
+    {
+        UINT32 cap = impl->capacity ? impl->capacity * 2 : 8;
+        struct entry *tmp = realloc( impl->entries, cap * sizeof(*tmp) );
+        if (!tmp) { LeaveCriticalSection( &impl->cs ); return E_OUTOFMEMORY; }
+        impl->entries = tmp;
+        impl->capacity = cap;
+    }
+    if (FAILED(hr = WindowsDuplicateString( key, &key_copy ))) { LeaveCriticalSection( &impl->cs ); return hr; }
+    impl->entries[impl->count].key = key_copy;
+    if ((impl->entries[impl->count].value = value)) IInspectable_AddRef( value );
+    impl->count++;
+    *replaced = FALSE;
+    property_set_save( impl );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Remove( IMap_HSTRING_IInspectable *iface, HSTRING key )
+{
+    struct property_set *impl = impl_from_IMap_HSTRING_IInspectable( iface );
+    int idx;
+
+    TRACE( "iface %p, key %s.\n", iface, debugstr_hstring( key ) );
+
+    EnterCriticalSection( &impl->cs );
+    if ((idx = find_entry( impl, key )) < 0)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_BOUNDS;
+    }
+    WindowsDeleteString( impl->entries[idx].key );
+    if (impl->entries[idx].value) IInspectable_Release( impl->entries[idx].value );
+    memmove( &impl->entries[idx], &impl->entries[idx + 1], (impl->count - idx - 1) * sizeof(*impl->entries) );
+    impl->count--;
+    property_set_save( impl );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Clear( IMap_HSTRING_IInspectable *iface )
+{
+    struct property_set *impl = impl_from_IMap_HSTRING_IInspectable( iface );
+    UINT32 i;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->count; i++)
+    {
+        WindowsDeleteString( impl->entries[i].key );
+        if (impl->entries[i].value) IInspectable_Release( impl->entries[i].value );
+    }
+    impl->count = 0;
+    property_set_save( impl );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
