+/* CheckBox and RadioButton: the glyph in a 32 px row, the content to its right */
+static void render_glyph_control( struct button *impl, struct layout_context *ctx )
+{
+    static const Thickness two = { 2, 2, 2, 2 };
+    const struct layout_rect *b = &impl->element.bounds;
+    COLORREF base_high = ctx->dark ? RGB(255, 255, 255) : RGB(0, 0, 0);
+    COLORREF base_medium_high = ctx->dark ? RGB(204, 204, 204) : RGB(51, 51, 51);
+    COLORREF base_medium = ctx->dark ? RGB(153, 153, 153) : RGB(102, 102, 102);
+    COLORREF base_medium_low = ctx->dark ? RGB(102, 102, 102) : RGB(153, 153, 153);
+    COLORREF accent = RGB(0, 120, 215), white = RGB(255, 255, 255);
+    const WCHAR *state = state_suffix( impl ), *check = check_state_name( impl );
+    struct look background = {0}, fg = { ctx->foreground, TRUE }, stroke = {0}, fill = {0}, glyph = {0};
+    struct layout_rect box, dot;
+    BOOL on = impl->check == CHECK_ON;
+
+    box.x = b->x + impl->border_thickness.Left;
+    box.y = b->y + (min( 32.0f, b->height ) - GLYPH_SIZE) / 2;
+    box.width = box.height = GLYPH_SIZE;
+
+    /* the Windows 10 defaults */
+    if (!impl->enabled) set_look( &fg, base_medium_low );
+    if (impl->check == CHECK_OFF || impl->kind == BUTTON_RADIO)
+    {
