+static void button_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct button *impl = impl_from_element( element );
+    struct xaml_element *root = button_template_root( impl );
+    /* Windows 10 theme colours, as #33/#66 black or white over the page background */
+    COLORREF base_low = ctx->dark ? RGB(51, 51, 51) : RGB(204, 204, 204);
+    COLORREF base_medium_low = ctx->dark ? RGB(102, 102, 102) : RGB(153, 153, 153);
+    struct look background = { base_low, TRUE }, fg = { ctx->foreground, TRUE }, border = {0};
+    const WCHAR *prefix = impl->kind == BUTTON_TOGGLE ? L"ToggleButton" : L"Button";
+    const WCHAR *check = impl->kind == BUTTON_TOGGLE && impl->check != CHECK_OFF ? check_state_name( impl ) : L"";
+    const WCHAR *state = state_suffix( impl );
+    BOOL normal = !*check && !*state;
+
+    if (root)
+    {
+        element_render( root, ctx );   /* the template draws the button */
+        return;
+    }
+    if (has_glyph( impl ))
+    {
+        render_glyph_control( impl, ctx );
+        return;
+    }
+
+    /* the Windows 10 defaults */
+    if (!impl->enabled)
+        set_look( &fg, base_medium_low );
+    else if (impl->pressed)
+        set_look( &background, base_medium_low );
+    else if (*check)
+    {
+        set_look( &background, RGB(0, 120, 215) );   /* the accent colour */
+        set_look( &fg, RGB(255, 255, 255) );
+        if (impl->pointer_over) set_look( &border, base_medium_low );
+    }
+    else if (impl->pointer_over)
+        set_look( &border, base_medium_low );
+    if (impl->enabled && impl->foreground) brush_look( impl->foreground, &fg );
+
+    /* the app's resources; in the Normal state, like the default template's TemplateBindings, the control's own
+     * brushes win over them */
+    if (normal && impl->background) brush_look( impl->background, &background );
+    else resource_look( impl, &background, L"%sBackground%s%s", prefix, check, state );
+    if (normal && impl->border_brush) brush_look( impl->border_brush, &border );
+    else resource_look( impl, &border, L"%sBorderBrush%s%s", prefix, check, state );
+    if (!(normal && impl->foreground)) resource_look( impl, &fg, L"%sForeground%s%s", prefix, check, state );
+
+    if (background.paint) element_fill_color( ctx, &element->bounds, background.color );
+    if (border.paint) element_frame_color( ctx, &element->bounds, &impl->border_thickness, border.color );
+    render_content( impl, ctx, fg.color );
+}
