+        if (impl->enabled && impl->pressed) set_look( &fill, base_medium );
+        if (impl->kind == BUTTON_RADIO && on)
+        {
+            set_look( &stroke, impl->enabled ? accent : base_medium_low );
+            set_look( &glyph, impl->enabled ? base_medium_high : base_medium_low );
+        }
+    }
+    else if (on)
+    {
+        set_look( &fill, !impl->enabled ? base_medium_low : impl->pressed ? base_medium : accent );
+        set_look( &glyph, white );
+    }
+    else
+    {
+        set_look( &stroke, impl->enabled ? accent : base_medium_low );
+        set_look( &glyph, impl->enabled ? base_high : base_medium_low );
+    }
+    if (impl->enabled && !impl->pressed && !impl->pointer_over && impl->background) brush_look( impl->background, &background );
+    if (impl->enabled && impl->foreground) brush_look( impl->foreground, &fg );
+
+    /* the app's resources */
+    if (impl->kind == BUTTON_CHECK)
+    {
+        resource_look( impl, &fg, L"CheckBoxForeground%s%s", check, state );
+        resource_look( impl, &background, L"CheckBoxBackground%s%s", check, state );
+        resource_look( impl, &stroke, L"CheckBoxCheckBackgroundStroke%s%s", check, state );
+        resource_look( impl, &fill, L"CheckBoxCheckBackgroundFill%s%s", check, state );
+        resource_look( impl, &glyph, L"CheckBoxCheckGlyphForeground%s%s", check, state );
+    }
+    else
