+        resource_look( impl, &stroke, on ? L"RadioButtonOuterEllipseCheckedStroke%s" : L"RadioButtonOuterEllipseStroke%s", state );
+        resource_look( impl, &fill, on ? L"RadioButtonOuterEllipseCheckedFill%s" : L"RadioButtonOuterEllipseFill%s", state );
+        resource_look( impl, &glyph, L"RadioButtonCheckGlyphFill%s", state );
+    }
