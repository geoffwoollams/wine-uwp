 }
 
 
@@ -1581,8 +1753,20 @@ LONG WINAPI /* DECLSPEC_HOTPATCH */ GetCurrentPackageFullName( UINT32 *length, W
  */
 LONG WINAPI /* DECLSPEC_HOTPATCH */ GetCurrentPackageId( UINT32 *len, BYTE *buffer )
 {
-    FIXME( "(%p %p): stub\n", len, buffer );
-    return APPMODEL_ERROR_NO_PACKAGE;
+    UINT32 size;
+
+    TRACE( "(%p %p)\n", len, buffer );
+    if (!get_current_package()) return APPMODEL_ERROR_NO_PACKAGE;
+    if (!len) return ERROR_INVALID_PARAMETER;
+    size = package_id_size();
+    if (*len < size || !buffer)
+    {
+        *len = size;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    fill_package_id( (PACKAGE_ID *)buffer );
+    *len = size;
+    return ERROR_SUCCESS;
 }
 
 /***********************************************************************
@@ -1590,8 +1774,38 @@ LONG WINAPI /* DECLSPEC_HOTPATCH */ GetCurrentPackageId( UINT32 *len, BYTE *buff
  */
 LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE *buffer, UINT32 *count )
 {
-    FIXME( "(%#x %p %p %p): stub\n", flags, buffer_size, buffer, count );
-    return APPMODEL_ERROR_NO_PACKAGE;
+    UINT32 size;
+    WINE_PACKAGE_INFO *info;
+    WCHAR *str;
+
+    TRACE( "(%#x %p %p %p)\n", flags, buffer_size, buffer, count );
+    if (!get_current_package()) return APPMODEL_ERROR_NO_PACKAGE;
+    if (!buffer_size) return ERROR_INVALID_PARAMETER;
+
+    size = sizeof(*info) + package_id_size() + (wcslen( current_package.path ) + wcslen( current_package.full ) +
+                                                wcslen( current_package.family ) + 3) * sizeof(WCHAR);
+    if (count) *count = 1;
+    if (*buffer_size < size || !buffer)
+    {
+        *buffer_size = size;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+
+    info = (WINE_PACKAGE_INFO *)buffer;
+    memset( info, 0, sizeof(*info) );
+    info->flags = 0x10; /* PACKAGE_PROPERTY_BUNDLE? kept non-zero but harmless: PACKAGE_FILTER_HEAD-ish */
+    fill_package_id( &info->packageId );
+    str = (WCHAR *)((BYTE *)(info + 1) + package_id_size());
+    info->path = str;
+    wcscpy( str, current_package.path );
+    str += wcslen( str ) + 1;
+    info->packageFullName = str;
+    wcscpy( str, current_package.full );
+    str += wcslen( str ) + 1;
+    info->packageFamilyName = str;
+    wcscpy( str, current_package.family );
+    *buffer_size = size;
+    return ERROR_SUCCESS;
 }
 
 /***********************************************************************
@@ -1599,8 +1813,9 @@ LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE
  */
 LONG WINAPI /* DECLSPEC_HOTPATCH */ GetCurrentPackagePath( UINT32 *length, WCHAR *path )
 {
-    FIXME( "(%p %p): stub\n", length, path );
-    return APPMODEL_ERROR_NO_PACKAGE;
+    TRACE( "(%p %p)\n", length, path );
+    if (!get_current_package()) return APPMODEL_ERROR_NO_PACKAGE;
+    return return_package_string( current_package.path, length, path );
 }
 
 
