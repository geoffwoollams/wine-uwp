         if (c[0] == 1)
@@ -372,6 +515,11 @@ static BOOL CALLBACK pri_load( INIT_ONCE *once, void *param, void **context )
         goto fail;
     if ((file->map = find_section( file, "[mrm_res_map2_]" )) < 0 && (file->map = find_section( file, "[mrm_res_map__]" )) < 0)
         goto fail;
+    /* the map names its decision info section */
+    file->decisions = get16( file->sections[file->map].data + 8 );
+    if (file->sections[file->map].size < 32 || file->decisions >= file->count || !file->sections[file->decisions].data ||
+        memcmp( file->ids[file->decisions], "[mrm_decn_info]", 15 ))
