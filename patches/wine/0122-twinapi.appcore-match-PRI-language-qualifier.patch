     UINT16 env_length, schema_ref_length, types, map_count, group_count;
     UINT32 info_count, candidates, data_length, large_length, pos, i, j, types_pos;
-    UINT32 first_item, group, group_size, first_info, info, string_data;
+    UINT32 first_item, group, group_size, first_info, info, decision, string_data;
     UINT32 maps, groups, infos, large_maps = 0, large_groups = 0, large_infos = 0, total_maps, total_groups;
     const BYTE *large = NULL, *c;
 
@@ -308,10 +440,21 @@ static BOOL map_find( struct pri_file *file, UINT32 item, const BYTE **data, UIN
         }
         if (item < first_item || item >= first_item + group_size) continue;
         j = first_info + (item - first_item);
-        if (j < info_count) info = get16( s->data + infos + j * 4 + 2 );
-        else if (j - info_count < large_infos) info = get32( large + 12 + large_maps * 8 + large_groups * 8 + (j - info_count) * 8 + 4 );
+        if (j < info_count)
+        {
