-/* the first candidate of an item of the resource map, and its value type */
+/* ---- qualifiers: the user's languages against a candidate's Language qualifier ---- */
+
+#define QUALIFIER_LANGUAGE 0
+
+static WCHAR languages[8][LOCALE_NAME_MAX_LENGTH];
+static UINT32 language_count;
+static INIT_ONCE languages_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK languages_init( INIT_ONCE *once, void *param, void **context )
+{
+    WCHAR buffer[512], *p;
+    ULONG count = 0, size = ARRAY_SIZE(buffer);
+
+    if (GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, buffer, &size ))
+        for (p = buffer; *p && language_count < ARRAY_SIZE(languages); p += wcslen( p ) + 1)
+            lstrcpynW( languages[language_count++], p, LOCALE_NAME_MAX_LENGTH );
+    if (language_count < ARRAY_SIZE(languages) &&
+        GetUserDefaultLocaleName( languages[language_count], LOCALE_NAME_MAX_LENGTH ))
+        language_count++;
+    if (!language_count) wcscpy( languages[language_count++], L"en-US" );
+    TRACE( "first language %s, %u in all.\n", debugstr_w(languages[0]), language_count );
+    return TRUE;
+}
+
+/* how well a qualifier value ("EN-US", "zh-Hant-TW") suits one language: the number of leading subtags that
+ * match, if at least the language does */
+static UINT32 language_match( const WCHAR *value, const WCHAR *language )
+{
+    UINT32 n = 0;
+
+    for (;;)
+    {
+        const WCHAR *a = value, *b = language;
+        size_t la, lb;
+
+        while (*a && *a != '-') a++;
+        while (*b && *b != '-') b++;
+        la = a - value;
+        lb = b - language;
+        if (!la || la != lb || _wcsnicmp( value, language, la )) return n;
+        n++;
+        if (!*a && !*b) return n + 8;   /* all of it */
+        if (!*a || !*b) return n;
+        value = a + 1;
+        language = b + 1;
+    }
+}
+
+/* a qualifier value may list several languages, separated by ';' */
+static UINT32 language_score( const WCHAR *value )
+{
+    WCHAR one[LOCALE_NAME_MAX_LENGTH];
+    UINT32 i, best = 0, m;
+    const WCHAR *end;
+
+    InitOnceExecuteOnce( &languages_once, languages_init, NULL, NULL );
+    for (; *value; value = *end ? end + 1 : end)
+    {
+        if (!(end = wcschr( value, ';' ))) end = value + wcslen( value );
+        lstrcpynW( one, value, min( end - value + 1, ARRAY_SIZE(one) ) );
+        for (i = 0; i < language_count; i++)
+            if ((m = language_match( one, languages[i] ))) best = max( best, (ARRAY_SIZE(languages) - i) * 16 + m );
+    }
+    return best;
+}
+
+/* the decision's candidate that best suits the user's languages: its index in the decision */
+static UINT32 choose_candidate( struct pri_file *file, UINT32 decision, UINT32 count )
+{
+    const struct pri_section *s;
+    UINT32 distinct, qualifiers, sets, decisions, index_entries, quals, set_infos, qual_infos, distinct_infos;
+    UINT32 index_table, strings, data_length, first_set, set_count, i, j, best = 0, best_score = 0;
+
+    if (file->decisions < 0 || count <= 1) return 0;
+    s = &file->sections[file->decisions];
+    if (s->size < 12) return 0;
+    distinct = get16( s->data );
+    qualifiers = get16( s->data + 2 );
+    sets = get16( s->data + 4 );
+    decisions = get16( s->data + 6 );
+    index_entries = get16( s->data + 8 );
+    data_length = get16( s->data + 10 ) * 2;
+    quals = 12;
+    set_infos = quals + decisions * 4;
+    qual_infos = set_infos + sets * 4;
+    distinct_infos = qual_infos + qualifiers * 8;
+    index_table = distinct_infos + distinct * 12;
+    strings = index_table + index_entries * 2;
+    if ((UINT64)strings + data_length > s->size || decision >= decisions) return 0;
+    first_set = get16( s->data + quals + decision * 4 );
+    set_count = get16( s->data + quals + decision * 4 + 2 );
+
+    for (i = 0; i < min( count, set_count ); i++)
+    {
+        UINT32 set, first_qual, qual_count, score = 1;   /* no Language qualifier: neutral */
+        if (first_set + i >= index_entries) break;
+        set = get16( s->data + index_table + (first_set + i) * 2 );
+        if (set >= sets) break;
+        first_qual = get16( s->data + set_infos + set * 4 );
+        qual_count = get16( s->data + set_infos + set * 4 + 2 );
+        for (j = 0; j < qual_count; j++)
+        {
+            UINT32 qual, dq, type, fallback, offset, m;
+            const WCHAR *value;
+
+            if (first_qual + j >= index_entries) break;
+            qual = get16( s->data + index_table + (first_qual + j) * 2 );
+            if (qual >= qualifiers) break;
+            dq = get16( s->data + qual_infos + qual * 8 );
+            fallback = get16( s->data + qual_infos + qual * 8 + 4 );
+            if (dq >= distinct) break;
+            type = get16( s->data + distinct_infos + dq * 12 + 2 );
+            offset = get32( s->data + distinct_infos + dq * 12 + 8 ) * 2;
+            if (type != QUALIFIER_LANGUAGE || offset >= data_length) continue;
+            value = (const WCHAR *)(s->data + strings + offset);
+            if (wcsnlen( value, (data_length - offset) / 2 ) == (data_length - offset) / 2) break;
+            /* another language is no match, unless it is the package's default (it has a fallback score) */
+            if ((m = language_score( value ))) score = 1024 + m;
+            else score = fallback ? 2 : 0;
+        }
+        if (score > best_score)
+        {
+            best_score = score;
+            best = i;
+        }
+    }
+    return best;
+}
+
