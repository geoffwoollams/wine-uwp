+/* ---- the button.c side ---- */
+
+HRESULT bar_init( struct button *impl )
+{
+    struct command_bar *bar;
+    HRESULT hr;
+
+    impl->IAppBarButton_iface.lpVtbl = &appbar_button_vtbl;
+    impl->IAppBarToggleButton_iface.lpVtbl = &appbar_toggle_vtbl;
+    impl->IAppBarSeparator_iface.lpVtbl = &appbar_separator_vtbl;
+    impl->ICommandBarElement_iface.lpVtbl = &command_element_vtbl;
+    memset( &impl->border_thickness, 0, sizeof(impl->border_thickness) );
+    memset( &impl->padding, 0, sizeof(impl->padding) );
+    impl->element.vertical_alignment = VerticalAlignment_Top;
+    if (impl->kind == BUTTON_APPBAR_SEPARATOR) impl->element.is_tab_stop = FALSE;
+    if (impl->kind != BUTTON_COMMAND_BAR) return S_OK;
+
+    impl->element.horizontal_alignment = HorizontalAlignment_Stretch;
+    impl->element.is_tab_stop = FALSE;
+    impl->content_horizontal = HorizontalAlignment_Stretch;
+    impl->content_vertical = VerticalAlignment_Stretch;
+    if (!(bar = calloc( 1, sizeof(*bar) ))) return E_OUTOFMEMORY;
+    bar->IAppBar_iface.lpVtbl = &app_bar_vtbl;
+    bar->ICommandBar_iface.lpVtbl = &command_bar_vtbl;
+    bar->button = impl;
+    bar->primary.IObservableVector_iface.lpVtbl = &command_list_vtbl;
+    bar->primary.bar = bar;
+    bar->secondary.IObservableVector_iface.lpVtbl = &command_list_vtbl;
+    bar->secondary.bar = bar;
+    bar->secondary.secondary = TRUE;
+    if (FAILED(hr = vector_create( &command_iids, &command_callbacks, &bar->primary, &bar->primary.vector )) ||
+        FAILED(hr = vector_create( &command_iids, &command_callbacks, &bar->secondary, &bar->secondary.vector )))
+    {
+        if (bar->primary.vector) IInspectable_Release( bar->primary.vector );
+        free( bar );
+        return hr;
+    }
+    impl->bar = bar;
+    return S_OK;
+}
+
+void *bar_default_iface( struct button *impl )
+{
+    switch (impl->kind)
+    {
+    case BUTTON_APPBAR: return &impl->IAppBarButton_iface;
+    case BUTTON_APPBAR_TOGGLE: return &impl->IAppBarToggleButton_iface;
+    case BUTTON_APPBAR_SEPARATOR: return &impl->IAppBarSeparator_iface;
+    default: return &impl->bar->ICommandBar_iface;
+    }
+}
+
+HRESULT bar_query_interface( struct button *impl, REFIID iid, void **out )
+{
+    if (impl->kind == BUTTON_APPBAR && IsEqualGUID( iid, &IID_IAppBarButton )) *out = &impl->IAppBarButton_iface;
+    else if (impl->kind == BUTTON_APPBAR_TOGGLE && IsEqualGUID( iid, &IID_IAppBarToggleButton )) *out = &impl->IAppBarToggleButton_iface;
+    else if (impl->kind == BUTTON_APPBAR_SEPARATOR && IsEqualGUID( iid, &IID_IAppBarSeparator )) *out = &impl->IAppBarSeparator_iface;
+    else if (impl->kind != BUTTON_COMMAND_BAR && IsEqualGUID( iid, &IID_ICommandBarElement )) *out = &impl->ICommandBarElement_iface;
+    else if (impl->kind == BUTTON_COMMAND_BAR && IsEqualGUID( iid, &IID_ICommandBar )) *out = &impl->bar->ICommandBar_iface;
+    else if (impl->kind == BUTTON_COMMAND_BAR && IsEqualGUID( iid, &IID_IAppBar )) *out = &impl->bar->IAppBar_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+void bar_destroy( struct button *impl )
+{
+    struct command_bar *bar = impl->bar;
+    struct xaml_element *icon = icon_element( impl );
+
+    if (icon && icon->parent == &impl->element) element_set_parent( icon, NULL );
+    if (impl->icon) IInspectable_Release( impl->icon );
+    WindowsDeleteString( impl->label );
+    if (!bar) return;
+    if (bar->menu)
+    {
+        window_popup_hide( &bar->menu->element );
+        bar->menu->bar = NULL;
+        IInspectable_Release( bar->menu_object );
+    }
+    vector_detach( bar->primary.vector );
+    vector_detach( bar->secondary.vector );
+    IInspectable_Release( bar->primary.vector );
+    IInspectable_Release( bar->secondary.vector );
+    event_list_clear( &bar->opened );
+    event_list_clear( &bar->closed );
+    free( bar );
+    impl->bar = NULL;
+}
+
+/* AppBarButton's Label / Icon / IsCompact from markup; value is the text, or NULL for number or object */
+BOOL bar_set_markup( IInspectable *object, const WCHAR *name, const WCHAR *value, double number, IInspectable *object_value )
+{
+    struct xaml_element *element = element_from_object( object );
+    IIconElement *icon = NULL;
+    IInspectable *created;
+    struct button *impl;
+    HSTRING str;
+    Symbol symbol;
+
+    if (!element || !bar_button_from_object( object )) return FALSE;
+    impl = CONTAINING_RECORD( element, struct button, element );
+    if (!wcscmp( name, L"Label" ) && value)
+    {
+        if (FAILED(WindowsCreateString( value, wcslen( value ), &str ))) return FALSE;
+        set_label( impl, str );
+        WindowsDeleteString( str );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"Icon" ))
+    {
+        /* Icon="Add" makes a SymbolIcon */
+        if (value && symbol_from_name( value, &symbol ) && (created = symbol_icon_create( symbol )))
+        {
+            IInspectable_QueryInterface( created, &IID_IIconElement, (void **)&icon );
+            IInspectable_Release( created );
+        }
+        else if (object_value) IInspectable_QueryInterface( object_value, &IID_IIconElement, (void **)&icon );
+        if (!icon)
+        {
+            FIXME( "Icon %s is not supported.\n", debugstr_w(value) );
+            return TRUE;
+        }
+        set_icon( impl, icon );
+        IIconElement_Release( icon );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"IsCompact" ))
+    {
+        impl->compact = value ? !wcsicmp( value, L"True" ) : number != 0;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* CommandBar.IsOpen / IsSticky from markup */
+BOOL command_bar_set_markup( IInspectable *object, const WCHAR *name, const WCHAR *value, double number )
+{
+    struct xaml_element *element = element_from_object( object );
+    struct button *impl;
+    BOOL flag = value ? !wcsicmp( value, L"True" ) : number != 0;
+
+    if (!element || !element->class_name || wcscmp( element->class_name, RuntimeClass_Windows_UI_Xaml_Controls_CommandBar ))
+        return FALSE;
+    impl = CONTAINING_RECORD( element, struct button, element );
+    if (!impl->bar) return FALSE;
+    if (!wcscmp( name, L"IsSticky" )) impl->bar->sticky = flag;
+    else if (!wcscmp( name, L"IsOpen" )) bar_set_open( impl->bar, flag );
+    else return FALSE;
+    return TRUE;
+}
