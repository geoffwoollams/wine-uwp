+/* SymbolIcon draws a Symbol, whose value is its character in the Segoe MDL2 Assets font, 20 px in a 20 x 20 box.
+ * Without that font (it comes with Windows, not Wine) a similar Unicode character from the usual fonts stands in,
+ * or a square. FontIcon draws its Glyph in its FontFamily (Segoe MDL2 Assets by default) at its FontSize. Both take
+ * the inherited foreground unless their Foreground is set. */
+
+#define MDL2 L"Segoe MDL2 Assets"
+
+enum icon_kind
+{
+    ICON_SYMBOL,
+    ICON_FONT,
+};
+
+struct icon
+{
+    struct xaml_element element;
+    IIconElement IIconElement_iface;
+    ISymbolIcon ISymbolIcon_iface;
+    IFontIcon IFontIcon_iface;
+    enum icon_kind kind;
+    Symbol symbol;
+    HSTRING glyph;
+    WCHAR family[64];
+    IFontFamily *font_family;
+    double font_size;
+    FontWeight weight;
+    FontStyle style;
+    IBrush *foreground;
+};
+
+static inline struct icon *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct icon, element );
+}
