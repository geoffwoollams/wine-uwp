+/* the CommandBar's collections for markup (PrimaryCommands, the content property, and SecondaryCommands) */
+IInspectable *command_bar_collection( IInspectable *object, const WCHAR *name )
+{
+    struct xaml_element *element = element_from_object( object );
+    struct button *impl;
+
+    if (!element || !element->class_name || wcscmp( element->class_name, RuntimeClass_Windows_UI_Xaml_Controls_CommandBar ))
+        return NULL;
+    impl = CONTAINING_RECORD( element, struct button, element );
+    if (!impl->bar) return NULL;
+    if (!wcscmp( name, L"PrimaryCommands" )) return impl->bar->primary.vector;
+    if (!wcscmp( name, L"SecondaryCommands" )) return impl->bar->secondary.vector;
+    return NULL;
+}
