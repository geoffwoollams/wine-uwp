+static BOOL have_mdl2(void)
+{
+    static int have = -1;
+    if (have < 0) have = dwrite_has_family( MDL2 );
+    return have;
+}
+
+static HRESULT icon_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct icon *impl = impl_from_element( element );
+
+    if (IsEqualGUID( iid, &IID_IIconElement )) *out = &impl->IIconElement_iface;
+    else if (impl->kind == ICON_SYMBOL && IsEqualGUID( iid, &IID_ISymbolIcon )) *out = &impl->ISymbolIcon_iface;
+    else if (impl->kind == ICON_FONT && IsEqualGUID( iid, &IID_IFontIcon )) *out = &impl->IFontIcon_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void icon_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                          float avail_height, float *width, float *height )
+{
+    struct icon *impl = impl_from_element( element );
+    *width = *height = impl->kind == ICON_SYMBOL ? 20.0f : impl->font_size;
+}
+
+static void icon_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct icon *impl = impl_from_element( element );
+    Color color = { ctx->foreground_alpha, GetRValue( ctx->foreground ), GetGValue( ctx->foreground ), GetBValue( ctx->foreground ) };
+    const WCHAR *text, *family;
+    WCHAR ch;
+    UINT32 len;
+
+    if (impl->foreground) brush_get_color( impl->foreground, &color );
+    if (impl->kind == ICON_SYMBOL)
+    {
+        if (have_mdl2())
+        {
+            ch = impl->symbol;
+            d2d_draw_glyphs( ctx, MDL2, 20.0, 400, &ch, 1, &element->bounds, color );
+        }
+        else
+        {
+            ch = symbol_fallback( impl->symbol );
+            d2d_draw_glyphs( ctx, L"Segoe UI", 16.0, 400, &ch, 1, &element->bounds, color );
+        }
+        return;
+    }
+    text = WindowsGetStringRawBuffer( impl->glyph, &len );
+    family = impl->family[0] ? impl->family : MDL2;
+    if (len) d2d_draw_glyphs( ctx, family, impl->font_size, impl->weight.Weight, text, len, &element->bounds, color );
+}
+
+static void icon_destroy( struct xaml_element *element )
+{
+    struct icon *impl = impl_from_element( element );
+
+    WindowsDeleteString( impl->glyph );
+    if (impl->font_family) IFontFamily_Release( impl->font_family );
+    if (impl->foreground) IBrush_Release( impl->foreground );
+    free( impl );
+}
+
+static const struct element_ops icon_ops =
+{
+    .query_interface = icon_query_interface,
+    .measure = icon_measure,
+    .render = icon_render,
+    .destroy = icon_destroy,
+};
