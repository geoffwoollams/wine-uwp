+static HRESULT WINAPI font_icon_put_FontFamily( IFontIcon *iface, IFontFamily *value )
+{
+    struct icon *impl = impl_from_IFontIcon( iface );
+    HSTRING source = NULL;
+
+    if (value) IFontFamily_AddRef( value );
+    if (impl->font_family) IFontFamily_Release( impl->font_family );
+    impl->font_family = value;
+    impl->family[0] = 0;
+    if (value && SUCCEEDED(IFontFamily_get_Source( value, &source )))
+    {
+        lstrcpynW( impl->family, WindowsGetStringRawBuffer( source, NULL ), ARRAY_SIZE(impl->family) );
+        WindowsDeleteString( source );
+    }
+    window_invalidate();
+    return S_OK;
+}
