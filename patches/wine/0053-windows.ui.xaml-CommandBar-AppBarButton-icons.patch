+BOOL symbol_from_name( const WCHAR *name, Symbol *value )
+{
+    int lo = 0, hi = ARRAY_SIZE(symbol_names) - 1, mid, cmp;
+
+    while (lo <= hi)
+    {
+        mid = (lo + hi) / 2;
+        if (!(cmp = wcsicmp( name, symbol_names[mid].name )))
+        {
+            *value = symbol_names[mid].value;
+            return TRUE;
+        }
+        if (cmp < 0) hi = mid - 1;
+        else lo = mid + 1;
+    }
+    return FALSE;
+}
