+/* SymbolIcon.Symbol, FontIcon.Glyph / FontFamily / FontSize from markup; value is the text, or NULL for number */
+BOOL icon_set_markup( IInspectable *object, const WCHAR *name, const WCHAR *value, double number )
+{
+    struct xaml_element *element = element_from_object( object );
+    struct icon *impl;
+    Symbol symbol;
+
+    if (!element || element->ops != &icon_ops) return FALSE;
+    impl = impl_from_element( element );
+    if (impl->kind == ICON_SYMBOL && !wcscmp( name, L"Symbol" ))
+    {
+        if (!value) impl->symbol = number;
+        else if (symbol_from_name( value, &symbol )) impl->symbol = symbol;
+        else FIXME( "unknown Symbol %s.\n", debugstr_w(value) );
+        return TRUE;
+    }
+    if (impl->kind != ICON_FONT) return FALSE;
+    if (!wcscmp( name, L"Glyph" ) && value)
+    {
+        WindowsDeleteString( impl->glyph );
+        WindowsCreateString( value, wcslen( value ), &impl->glyph );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"FontFamily" ) && value)
+    {
+        lstrcpynW( impl->family, value, ARRAY_SIZE(impl->family) );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"FontSize" ) && !value)
+    {
+        impl->font_size = number;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* activation factories: SymbolIcon (and ISymbolIconFactory), FontIcon (composable) */
+
+struct icon_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ISymbolIconFactory ISymbolIconFactory_iface;
+    IFontIconFactory IFontIconFactory_iface;
+    enum icon_kind kind;
+};
+
+static inline struct icon_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct icon_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct icon_statics *impl = impl_from_IActivationFactory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (impl->kind == ICON_SYMBOL && IsEqualGUID( iid, &IID_ISymbolIconFactory ))
+        *out = &impl->ISymbolIconFactory_iface;
+    else if (impl->kind == ICON_FONT && IsEqualGUID( iid, &IID_IFontIconFactory ))
+        *out = &impl->IFontIconFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return icon_create( impl_from_IActivationFactory( iface )->kind, NULL, NULL, (void **)instance );
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( symbol_factory, ISymbolIconFactory, struct icon_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI symbol_factory_CreateInstanceWithSymbol( ISymbolIconFactory *iface, Symbol symbol, ISymbolIcon **value )
+{
+    IInspectable *object;
+    HRESULT hr;
+
+    TRACE( "iface %p, symbol %#x.\n", iface, symbol );
+    if (!(object = symbol_icon_create( symbol ))) return E_OUTOFMEMORY;
+    hr = IInspectable_QueryInterface( object, &IID_ISymbolIcon, (void **)value );
+    IInspectable_Release( object );
+    return hr;
+}
+
+static const struct ISymbolIconFactoryVtbl symbol_factory_vtbl =
+{
+    symbol_factory_QueryInterface,
+    symbol_factory_AddRef,
+    symbol_factory_Release,
+    /* IInspectable methods */
+    symbol_factory_GetIids,
+    symbol_factory_GetRuntimeClassName,
+    symbol_factory_GetTrustLevel,
+    /* ISymbolIconFactory methods */
+    symbol_factory_CreateInstanceWithSymbol,
+};
+
+DEFINE_IINSPECTABLE( font_factory, IFontIconFactory, struct icon_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI font_factory_CreateInstance( IFontIconFactory *iface, IInspectable *outer, IInspectable **inner,
+                                                   IFontIcon **value )
+{
+    return icon_create( ICON_FONT, outer, inner, (void **)value );
+}
+
+static const struct IFontIconFactoryVtbl font_factory_vtbl =
+{
+    font_factory_QueryInterface,
+    font_factory_AddRef,
+    font_factory_Release,
+    /* IInspectable methods */
+    font_factory_GetIids,
+    font_factory_GetRuntimeClassName,
+    font_factory_GetTrustLevel,
+    /* IFontIconFactory methods */
+    font_factory_CreateInstance,
+};
+
+static struct icon_statics symbol_icon_statics = { {&factory_vtbl}, {&symbol_factory_vtbl}, {&font_factory_vtbl}, ICON_SYMBOL };
+static struct icon_statics font_icon_statics = { {&factory_vtbl}, {&symbol_factory_vtbl}, {&font_factory_vtbl}, ICON_FONT };
+IActivationFactory *symbol_icon_factory = &symbol_icon_statics.IActivationFactory_iface;
+IActivationFactory *font_icon_factory = &font_icon_statics.IActivationFactory_iface;
