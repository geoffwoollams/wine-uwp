+ */
+
+#include <math.h>
+
+#include "private.h"
+#include "control.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* All four are kinds of the shared Button object (struct button), drawn with Windows 10's looks.
+ *
+ * An AppBarButton or AppBarToggleButton is 68 px wide: its Icon (an IconElement, 20 px) 14 px from the top, and its
+ * Label in 12 px text below unless it is compact (48 px high then, else 60). A checked AppBarToggleButton is
+ * filled with the accent colour. In a CommandBar's overflow menu they show as a 40 px high row with the Label.
+ * An AppBarSeparator is a 1 px line with 6 px either side.
+ *
+ * A CommandBar is 48 px high: its Content on the left, its PrimaryCommands (compact) on the right, then the "..."
+ * button. Opening it (the "..." button, or IsOpen) shows the labels, growing to 60 px over the page (down, or up
+ * when it is in the lower half of the window), and shows its SecondaryCommands in a menu below (or above) it, in a
+ * popup that closes the bar when the pointer is pressed anywhere else. A command closes the bar unless IsSticky.
+ * There is no ClosedDisplayMode, dynamic overflow, keyboard access or animation. */
+
+#define BAR_HEIGHT 48.0f
+#define BAR_OPEN_HEIGHT 60.0f
+#define BUTTON_WIDTH 68.0f
+#define MORE_WIDTH 48.0f
+#define MENU_ITEM_HEIGHT 40.0f
+#define MENU_MIN_WIDTH 160.0f
+
+struct command_list
+{
+    IObservableVector_ICommandBarElement IObservableVector_iface;
+    struct command_bar *bar;
+    BOOL secondary;
+    IInspectable *vector;                 /* our IVector<ICommandBarElement> */
+};
+
+struct bar_menu
+{
+    struct xaml_element element;
+    struct command_bar *bar;
+    struct layout_rect box;
+};
+
+struct command_bar
+{
+    IAppBar IAppBar_iface;
+    ICommandBar ICommandBar_iface;
+    struct button *button;
+    struct command_list primary, secondary;
+    boolean open, sticky, more_over, more_pressed;
+    struct event_list opened, closed;
+    struct layout_rect area;              /* where the bar is drawn: its bounds, or taller while open */
+    struct layout_rect more;              /* the "..." button */
+    struct bar_menu *menu;                /* while open (referenced through menu_object) */
+    IInspectable *menu_object;
+};
+
+static const struct vector_iids command_iids =
+{
+    &IID___FIVector_1_Windows__CUI__CXaml__CControls__CICommandBarElement,
+    &IID___FIVectorView_1_Windows__CUI__CXaml__CControls__CICommandBarElement,
+    &IID___FIIterable_1_Windows__CUI__CXaml__CControls__CICommandBarElement,
+    &IID___FIIterator_1_Windows__CUI__CXaml__CControls__CICommandBarElement,
+    &IID_ICommandBarElement,
+};
+
+static struct button *bar_button_from_object( IInspectable *object )
+{
+    struct xaml_element *element = object ? element_from_object( object ) : NULL;
+    ICommandBarElement *command;
+    struct button *impl;
+
+    if (!element || !element->ops->query_interface) return NULL;
+    if (FAILED(element->ops->query_interface( element, &IID_ICommandBarElement, (void **)&command ))) return NULL;
+    impl = CONTAINING_RECORD( command, struct button, ICommandBarElement_iface );
+    ICommandBarElement_Release( command );
+    return impl;
+}
+
+static UINT32 command_count( struct command_list *list )
+{
+    return vector_size( list->vector );
+}
+
+static struct button *command_at( struct command_list *list, UINT32 index )
+{
+    return bar_button_from_object( vector_get( list->vector, index ) );
+}
+
+/* ---- the overflow menu, a popup ---- */
+
+static inline struct bar_menu *menu_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct bar_menu, element );
+}
+
+static void menu_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                          float avail_height, float *width, float *height )
+{
+    struct command_bar *bar = menu_from_element( element )->bar;
+    struct button *item;
+    UINT32 i;
+
+    *width = isfinite( avail_width ) ? avail_width : 0;
+    *height = isfinite( avail_height ) ? avail_height : 0;
+    if (!bar) return;
+    for (i = 0; i < command_count( &bar->secondary ); i++)
+        if ((item = command_at( &bar->secondary, i ))) element_measure( &item->element, ctx, INFINITY, INFINITY );
+}
+
+static void menu_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct bar_menu *menu = menu_from_element( element );
+    struct command_bar *bar = menu->bar;
+    const struct layout_rect *window = &element->bounds, *area;
+    float w = MENU_MIN_WIDTH, h = 0, y;
+    struct button *item;
+    UINT32 i, count;
+
+    if (!bar) return;
+    area = &bar->area;
+    count = command_count( &bar->secondary );
+    for (i = 0; i < count; i++)
+    {
+        if (!(item = command_at( &bar->secondary, i ))) continue;
+        w = max( w, item->element.desired_width );
+        h += item->element.desired_height;
+    }
+    if (count) h += 8;
+    menu->box.width = min( w, window->width );
+    menu->box.height = count ? h : 0;
+    menu->box.x = max( window->x, area->x + area->width - menu->box.width );
+    /* below the bar if it fits, else above it */
+    if (area->y + area->height + menu->box.height <= window->y + window->height) menu->box.y = area->y + area->height;
+    else menu->box.y = max( window->y, area->y - menu->box.height );
+    for (i = 0, y = menu->box.y + 4; i < count; i++)
+    {
+        if (!(item = command_at( &bar->secondary, i ))) continue;
+        element_arrange( &item->element, ctx, menu->box.x, y, menu->box.width, item->element.desired_height );
+        y += item->element.desired_height;
+    }
+}
+
+static void menu_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct bar_menu *menu = menu_from_element( element );
+    struct command_bar *bar = menu->bar;
+    static const Thickness one = { 1, 1, 1, 1 };
+    Color background = { 0xff, 0xf2, 0xf2, 0xf2 };
+    struct button *item;
+    UINT32 i;
+
+    if (!bar || !menu->box.height) return;
+    if (ctx->dark) background.R = background.G = background.B = 0x2b;
+    element_fill_argb( ctx, &menu->box, background );
+    element_frame_color( ctx, &menu->box, &one, ctx->dark ? RGB(0x76, 0x76, 0x76) : RGB(0xcc, 0xcc, 0xcc) );
+    for (i = 0; i < command_count( &bar->secondary ); i++)
+        if ((item = command_at( &bar->secondary, i ))) element_render( &item->element, ctx );
+}
+
+static UINT32 menu_child_count( struct xaml_element *element )
+{
+    struct command_bar *bar = menu_from_element( element )->bar;
+    return bar ? command_count( &bar->secondary ) : 0;
+}
+
+static struct xaml_element *menu_child_at( struct xaml_element *element, UINT32 index )
+{
+    struct command_bar *bar = menu_from_element( element )->bar;
+    struct button *item = bar ? command_at( &bar->secondary, index ) : NULL;
+    return item ? &item->element : NULL;
+}
+
+/* everywhere but the bar: a press elsewhere closes it */
+static BOOL menu_hit_self( struct xaml_element *element, float x, float y )
+{
+    struct command_bar *bar = menu_from_element( element )->bar;
+    const struct layout_rect *a;
+
+    if (!bar) return FALSE;
+    a = &bar->area;
+    return !(x >= a->x && y >= a->y && x < a->x + a->width && y < a->y + a->height);
+}
+
+static void bar_set_open( struct command_bar *bar, BOOL open );
+
+static void menu_pointer( struct xaml_element *element, UINT msg, float x, float y )
+{
+    struct bar_menu *menu = menu_from_element( element );
+    const struct layout_rect *b = &menu->box;
+
+    if (msg != WM_LBUTTONDOWN || !menu->bar) return;
+    if (x >= b->x && y >= b->y && x < b->x + b->width && y < b->y + b->height) return;
+    TRACE( "light dismiss.\n" );
+    bar_set_open( menu->bar, FALSE );
+}
+
+static void menu_destroy( struct xaml_element *element )
+{
+    free( menu_from_element( element ) );
+}
+
+static const struct element_ops menu_ops =
+{
+    .measure = menu_measure,
+    .arrange = menu_arrange,
+    .render = menu_render,
+    .child_count = menu_child_count,
+    .child_at = menu_child_at,
+    .hit_self = menu_hit_self,
+    .pointer = menu_pointer,
+    .destroy = menu_destroy,
+};
+
+/* ---- opening and closing ---- */
+
+static void raise_bar_event( struct command_bar *bar, struct event_list *list, const char *name )
+{
+    IUnknown **handlers;
+    UINT32 i, count = list->count;
+    HRESULT hr;
+
+    TRACE( "%p: %s.\n", bar, name );
+    if (!count || !(handlers = calloc( count, sizeof(*handlers) ))) return;
+    for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+    for (i = 0; i < count; i++)
+    {
+        if (!handlers[i]) continue;
+        hr = IEventHandler_IInspectable_Invoke( (IEventHandler_IInspectable *)handlers[i], bar->button->element.outer, NULL );
+        if (FAILED(hr)) WARN( "%s handler %p failed, hr %#lx.\n", name, handlers[i], hr );
+    }
+    for (i = 0; i < count; i++) if (handlers[i]) IUnknown_Release( handlers[i] );
+    free( handlers );
+}
+
+static void set_compact( struct command_bar *bar )
+{
+    struct button *item;
+    UINT32 i;
+
+    for (i = 0; i < command_count( &bar->primary ); i++)
+        if ((item = command_at( &bar->primary, i ))) item->compact = !bar->open;
+}
+
+static void bar_set_open( struct command_bar *bar, BOOL open )
+{
+    struct button *item;
+    struct bar_menu *menu;
+    UINT32 i;
+
+    if (bar->open == !!open) return;
+    bar->open = !!open;
+    set_compact( bar );
+    if (open && (menu = calloc( 1, sizeof(*menu) )))
+    {
+        element_init( &menu->element, &menu_ops, L"Windows.UI.Xaml.Controls.CommandBar (overflow)", NULL );
+        menu->bar = bar;
+        if (SUCCEEDED(element_compose( &menu->element, NULL, NULL, &menu->element.IInspectable_inner, (void **)&bar->menu_object )))
+        {
+            bar->menu = menu;
+            for (i = 0; i < command_count( &bar->secondary ); i++)
+                if ((item = command_at( &bar->secondary, i ))) element_set_parent( &item->element, &menu->element );
+            window_popup_show( &menu->element, FALSE );
+        }
+    }
+    else if (!open && bar->menu)
+    {
+        window_popup_hide( &bar->menu->element );
+        for (i = 0; i < command_count( &bar->secondary ); i++)
+            if ((item = command_at( &bar->secondary, i ))) element_set_parent( &item->element, &bar->button->element );
+        bar->menu->bar = NULL;
+        bar->menu = NULL;
+        IInspectable_Release( bar->menu_object );
+        bar->menu_object = NULL;
+    }
+    element_property_changed( bar->button->element.outer, L"IsOpen" );
+    window_invalidate();
+    raise_bar_event( bar, open ? &bar->opened : &bar->closed, open ? "Opened" : "Closed" );
+}
+
+/* a command was clicked: the bar closes, unless it is sticky */
+void bar_command_clicked( struct button *impl )
+{
+    struct command_bar *bar = impl->owner_bar ? impl->owner_bar->bar : NULL;
+    if (bar && bar->open && !bar->sticky) bar_set_open( bar, FALSE );
+}
+
+/* ---- layout and drawing ---- */
+
+static BOOL is_toggle_checked( struct button *impl )
+{
+    return impl->kind == BUTTON_APPBAR_TOGGLE && impl->check == CHECK_ON;
+}
+
+static struct xaml_element *icon_element( struct button *impl )
+{
+    return impl->icon ? element_from_object( impl->icon ) : NULL;
+}
+
+static void label_format( struct text_format *format, double size, TextAlignment alignment )
+{
+    format->font_size = size;
+    format->weight = 400;
+    format->italic = FALSE;
+    format->wrap = FALSE;
+    format->alignment = alignment;
+}
+
+void bar_measure( struct button *impl, struct layout_context *ctx, float avail_width, float avail_height,
+                  float *width, float *height )
+{
+    struct command_bar *bar = impl->bar;
+    struct xaml_element *icon = icon_element( impl );
+    struct text_format format;
+    float w = 0, h = 0;
+    struct button *item;
+    UINT32 i;
+
+    switch (impl->kind)
+    {
+    case BUTTON_APPBAR_SEPARATOR:
+        *width = impl->in_overflow ? 0 : 13;
+        *height = impl->in_overflow ? 9 : impl->compact ? BAR_HEIGHT : BAR_OPEN_HEIGHT;
+        return;
+    case BUTTON_APPBAR:
+    case BUTTON_APPBAR_TOGGLE:
+        if (icon) element_measure( icon, ctx, 20, 20 );
+        if (impl->in_overflow)
+        {
+            label_format( &format, 14, TextAlignment_Left );
+            if (impl->label) text_measure( ctx, &format, impl->label, INFINITY, &w, &h );
+            *width = w + 24;
+            *height = MENU_ITEM_HEIGHT;
+            return;
+        }
+        *width = BUTTON_WIDTH;
+        *height = impl->compact ? BAR_HEIGHT : BAR_OPEN_HEIGHT;
+        return;
+    default:
+        break;
+    }
+
+    /* the CommandBar */
+    *width = MORE_WIDTH;
+    *height = BAR_HEIGHT;
+    for (i = 0; i < command_count( &bar->primary ); i++)
+    {
+        if (!(item = command_at( &bar->primary, i ))) continue;
+        element_measure( &item->element, ctx, INFINITY, INFINITY );
+        *width += item->element.desired_width;
+    }
+    if (impl->content_element)
+    {
+        element_measure( impl->content_element, ctx, max( 0.0f, avail_width - *width ), BAR_HEIGHT );
+        *width += impl->content_element->desired_width;
+        *height = max( *height, impl->content_element->desired_height );
+    }
+}
+
+void bar_arrange( struct button *impl, struct layout_context *ctx )
+{
+    struct command_bar *bar = impl->bar;
+    const struct layout_rect *b = &impl->element.bounds;
+    struct xaml_element *icon = icon_element( impl ), *root;
+    float x, total = 0;
+    struct button *item;
+    UINT32 i, count;
+
+    if (impl->kind == BUTTON_APPBAR || impl->kind == BUTTON_APPBAR_TOGGLE)
+    {
+        if (icon) element_arrange( icon, ctx, b->x + (b->width - 20) / 2, b->y + 14, 20, 20 );
+        return;
+    }
+    if (impl->kind != BUTTON_COMMAND_BAR) return;
+
+    /* open, the bar grows toward the middle of the window */
+    bar->area = *b;
+    if (bar->open && b->height < BAR_OPEN_HEIGHT)
+    {
+        root = window_content_element();
+        bar->area.height = BAR_OPEN_HEIGHT;
+        if (root && b->y + b->height / 2 > root->bounds.y + root->bounds.height / 2)
+            bar->area.y = b->y + b->height - BAR_OPEN_HEIGHT;
+    }
+    bar->more.x = bar->area.x + bar->area.width - MORE_WIDTH;
+    bar->more.y = bar->area.y;
+    bar->more.width = MORE_WIDTH;
+    bar->more.height = BAR_HEIGHT;
+
+    count = command_count( &bar->primary );
+    for (i = 0; i < count; i++) if ((item = command_at( &bar->primary, i ))) total += item->element.desired_width;
+    x = max( bar->area.x, bar->more.x - total );
+    if (impl->content_element)
+        element_arrange( impl->content_element, ctx, bar->area.x, b->y, max( 0.0f, x - bar->area.x ), b->height );
+    for (i = 0; i < count; i++)
+    {
+        if (!(item = command_at( &bar->primary, i ))) continue;
+        element_arrange( &item->element, ctx, x, bar->area.y, item->element.desired_width, item->element.desired_height );
+        x += item->element.desired_width;
+    }
+}
+
+static Color base_alpha( struct layout_context *ctx, BYTE alpha )
+{
+    Color c = { alpha, 0, 0, 0 };
+    if (ctx->dark) c.R = c.G = c.B = 255;
+    return c;
+}
+
+static void render_bar_button( struct button *impl, struct layout_context *ctx )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+    struct xaml_element *icon = icon_element( impl );
+    Color accent = { 0xff, 0x00, 0x78, 0xd7 }, c;
+    COLORREF fg = ctx->foreground, saved = ctx->foreground;
+    BYTE saved_alpha = ctx->foreground_alpha;
+    struct text_format format;
+    struct layout_rect text;
+
+    if (impl->background && brush_get_color( impl->background, &c )) element_fill_argb( ctx, b, c );
+    if (is_toggle_checked( impl ) && !impl->in_overflow)
+    {
+        element_fill_argb( ctx, b, accent );
+        fg = RGB(255, 255, 255);
+    }
+    if (impl->pressed) element_fill_argb( ctx, b, base_alpha( ctx, 0x33 ) );
+    else if (impl->pointer_over) element_fill_argb( ctx, b, base_alpha( ctx, 0x19 ) );
+    if (impl->foreground && brush_get_color( impl->foreground, &c )) fg = RGB( c.R, c.G, c.B );
+    if (!impl->enabled) fg = ctx->dark ? RGB(102, 102, 102) : RGB(153, 153, 153);
+
+    if (impl->in_overflow)
+    {
+        if (!impl->label) return;
+        label_format( &format, 14, TextAlignment_Left );
+        text.x = b->x + 12 + (impl->kind == BUTTON_APPBAR_TOGGLE ? 0 : 0);
+        text.y = b->y + (b->height - 20) / 2;
+        text.width = max( 0.0f, b->width - 24 );
+        text.height = 20;
+        text_draw( ctx, &format, impl->label, &text, is_toggle_checked( impl ) ? RGB(0, 120, 215) : fg );
+        return;
+    }
+    if (icon)
+    {
+        ctx->foreground = fg;
+        ctx->foreground_alpha = 255;
+        element_render( icon, ctx );
+        ctx->foreground = saved;
+        ctx->foreground_alpha = saved_alpha;
+    }
+    if (!impl->compact && impl->label)
+    {
+        label_format( &format, 12, TextAlignment_Center );
+        text.x = b->x + 2;
+        text.y = b->y + 14 + 20 + 4;
+        text.width = max( 0.0f, b->width - 4 );
+        text.height = 16;
+        text_draw( ctx, &format, impl->label, &text, fg );
+    }
+}
+
+void bar_render( struct button *impl, struct layout_context *ctx )
+{
+    struct command_bar *bar = impl->bar;
+    const struct layout_rect *b = &impl->element.bounds;
+    Color background = { 0xff, 0xe6, 0xe6, 0xe6 }, fg = { 0xff, 0, 0, 0 }, c;
+    struct layout_rect line, dot;
+    struct button *item;
+    UINT32 i;
+
+    switch (impl->kind)
+    {
+    case BUTTON_APPBAR_SEPARATOR:
+        if (impl->in_overflow)
+        {
+            line.x = b->x + 12;
+            line.y = b->y + 4;
+            line.width = max( 0.0f, b->width - 24 );
+            line.height = 1;
+        }
+        else
+        {
+            line.x = b->x + 6;
+            line.y = b->y + 14;
+            line.width = 1;
+            line.height = 20;
+        }
+        element_fill_argb( ctx, &line, base_alpha( ctx, 0x66 ) );
+        return;
+    case BUTTON_APPBAR:
+    case BUTTON_APPBAR_TOGGLE:
+        render_bar_button( impl, ctx );
+        return;
+    default:
+        break;
+    }
+
+    /* the CommandBar: SystemControlBackgroundChromeMediumBrush unless it has a Background */
+    if (ctx->dark) background.R = background.G = background.B = 0x1f;
+    if (impl->background && brush_get_color( impl->background, &c )) background = c;
+    element_fill_argb( ctx, &bar->area, background );
+    if (impl->content_element) element_render( impl->content_element, ctx );
+    for (i = 0; i < command_count( &bar->primary ); i++)
+        if ((item = command_at( &bar->primary, i ))) element_render( &item->element, ctx );
+    /* the "..." button */
+    if (bar->more_pressed) element_fill_argb( ctx, &bar->more, base_alpha( ctx, 0x33 ) );
+    else if (bar->more_over) element_fill_argb( ctx, &bar->more, base_alpha( ctx, 0x19 ) );
+    if (ctx->dark) fg.R = fg.G = fg.B = 255;
+    if (impl->foreground && brush_get_color( impl->foreground, &c )) fg = c;
+    for (i = 0; i < 3; i++)
+    {
+        dot.x = bar->more.x + bar->more.width / 2 - 9 + i * 7;
+        dot.y = bar->more.y + 22;
+        dot.width = dot.height = 3;
+        element_fill_argb( ctx, &dot, fg );
+    }
+    (void)b;
+}
+
+UINT32 bar_child_count( struct button *impl )
+{
+    struct command_bar *bar = impl->bar;
+
+    if (impl->kind == BUTTON_APPBAR || impl->kind == BUTTON_APPBAR_TOGGLE)
+        return icon_element( impl ) && !impl->in_overflow ? 1 : 0;
+    if (impl->kind != BUTTON_COMMAND_BAR) return 0;
+    /* closed, the SecondaryCommands are here too (unarranged), for FindName */
+    return (impl->content_element ? 1 : 0) + command_count( &bar->primary ) + (bar->menu ? 0 : command_count( &bar->secondary ));
+}
+
+struct xaml_element *bar_child_at( struct button *impl, UINT32 index )
+{
+    struct command_bar *bar = impl->bar;
+    struct button *item;
+
+    if (impl->kind == BUTTON_APPBAR || impl->kind == BUTTON_APPBAR_TOGGLE) return icon_element( impl );
+    if (impl->kind != BUTTON_COMMAND_BAR) return NULL;
+    if (impl->content_element)
+    {
+        if (!index) return impl->content_element;
+        index--;
+    }
+    if (index < command_count( &bar->primary )) return (item = command_at( &bar->primary, index )) ? &item->element : NULL;
+    index -= command_count( &bar->primary );
+    return !bar->menu && (item = command_at( &bar->secondary, index )) ? &item->element : NULL;
+}
+
+/* the CommandBar's own pointer input: the "..." button */
+void bar_pointer( struct button *impl, UINT msg, float x, float y )
+{
+    struct command_bar *bar = impl->bar;
+    const struct layout_rect *m;
+    BOOL inside;
+
+    if (!bar) return;
+    m = &bar->more;
+    inside = x >= m->x && y >= m->y && x < m->x + m->width && y < m->y + m->height;
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+        bar->more_over = inside;
+        if (bar->more_pressed && !inside) bar->more_pressed = FALSE;
+        break;
+    case WM_MOUSELEAVE:
+    case WM_CAPTURECHANGED:
+        bar->more_over = bar->more_pressed = FALSE;
+        break;
+    case WM_LBUTTONDOWN:
+        bar->more_pressed = inside;
+        break;
+    case WM_LBUTTONUP:
+        if (bar->more_pressed && inside) bar_set_open( bar, !bar->open );
+        bar->more_pressed = FALSE;
+        break;
+    }
+    window_invalidate();
+}
+
+/* ---- PrimaryCommands and SecondaryCommands ---- */
+
+static HRESULT command_inserted( void *owner, IInspectable *object )
+{
+    struct command_list *list = owner;
+    struct button *item = bar_button_from_object( object );
+
+    TRACE( "%p, %s: %p.\n", list->bar, list->secondary ? "secondary" : "primary", object );
+    if (!item)
+    {
+        WARN( "%p is not an ICommandBarElement of ours.\n", object );
+        return E_INVALIDARG;
+    }
+    item->owner_bar = list->bar->button;
+    item->in_overflow = list->secondary;
+    item->compact = !list->secondary && !list->bar->open;
+    element_set_parent( &item->element, list->secondary && list->bar->menu ? &list->bar->menu->element
+                                                                           : &list->bar->button->element );
+    window_invalidate();
+    return S_OK;
+}
+
+static void command_removed( void *owner, IInspectable *object )
+{
+    struct button *item = bar_button_from_object( object );
+
+    if (!item) return;
+    item->owner_bar = NULL;
+    item->in_overflow = item->compact = FALSE;
+    element_set_parent( &item->element, NULL );
+    window_invalidate();
+}
+
+static const struct vector_callbacks command_callbacks = { command_inserted, command_removed };
