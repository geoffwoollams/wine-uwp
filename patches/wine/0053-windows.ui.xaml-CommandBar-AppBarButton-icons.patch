+static void set_icon( struct button *impl, IIconElement *value )
+{
+    struct xaml_element *old = icon_element( impl ), *icon;
+
+    if (old && old->parent == &impl->element) element_set_parent( old, NULL );
+    if (value) IIconElement_AddRef( value );
+    if (impl->icon) IInspectable_Release( impl->icon );
+    impl->icon = (IInspectable *)value;
+    if ((icon = icon_element( impl ))) element_set_parent( icon, &impl->element );
+    window_invalidate();
+}
+
+static HRESULT set_label( struct button *impl, HSTRING value )
+{
+    WindowsDeleteString( impl->label );
+    impl->label = NULL;
+    window_invalidate();
+    return WindowsDuplicateString( value, &impl->label );
+}
