+/* stand-ins from the common fonts for the symbols apps use most */
+static WCHAR symbol_fallback( Symbol symbol )
+{
+    static const struct { Symbol symbol; WCHAR ch; } map[] =
+    {
+        { Symbol_Add, '+' }, { Symbol_Cancel, 0x2715 }, { Symbol_Accept, 0x2713 }, { Symbol_More, 0x22ef },
+        { Symbol_Back, 0x2190 }, { Symbol_Forward, 0x2192 }, { Symbol_Up, 0x2191 }, { Symbol_Download, 0x2193 },
+        { Symbol_Upload, 0x2191 }, { Symbol_Setting, 0x2699 }, { Symbol_Refresh, 0x27f3 }, { Symbol_Sync, 0x27f2 },
+        { Symbol_Home, 0x2302 }, { Symbol_Favorite, 0x2605 }, { Symbol_Play, 0x25b6 }, { Symbol_Pause, 0x2016 },
+        { Symbol_Stop, 0x25a0 }, { Symbol_Delete, 0x2717 }, { Symbol_Edit, 0x270e }, { Symbol_Find, 0x2315 },
+        { Symbol_Zoom, 0x2315 }, { Symbol_Mail, 0x2709 }, { Symbol_Remove, 0x2212 }, { Symbol_Help, '?' },
+        { Symbol_Previous, 0x25c0 }, { Symbol_Next, 0x25b6 }, { Symbol_Clear, 0x2715 }, { Symbol_List, 0x2630 },
+        { Symbol_Copy, 0x2398 }, { Symbol_Cut, 0x2702 }, { Symbol_Undo, 0x21b6 }, { Symbol_Redo, 0x21b7 },
+        { Symbol_Volume, 0x266a }, { Symbol_Contact, 0x263a }, { Symbol_Flag, 0x2691 }, { Symbol_Important, '!' },
+        { Symbol_Phone, 0x260e }, { Symbol_Send, 0x27a4 }, { Symbol_Print, 0x2399 }, { Symbol_Filter, 0x25bd },
+        { Symbol_Sort, 0x21c5 }, { Symbol_Clock, 0x25f7 }, { Symbol_Calendar, 0x25a6 }, { Symbol_Video, 0x25b6 },
+    };
+    UINT32 i;
+
+    for (i = 0; i < ARRAY_SIZE(map); i++) if (map[i].symbol == symbol) return map[i].ch;
+    return 0x25a1;   /* a square */
+}
