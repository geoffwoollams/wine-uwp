+static HRESULT icon_create( enum icon_kind kind, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct icon *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &icon_ops, kind == ICON_SYMBOL ? RuntimeClass_Windows_UI_Xaml_Controls_SymbolIcon
+                                                                 : RuntimeClass_Windows_UI_Xaml_Controls_FontIcon, outer );
+    impl->IIconElement_iface.lpVtbl = &icon_element_vtbl;
+    impl->ISymbolIcon_iface.lpVtbl = &symbol_icon_vtbl;
+    impl->IFontIcon_iface.lpVtbl = &font_icon_vtbl;
+    impl->kind = kind;
+    impl->font_size = 20.0;
+    impl->weight.Weight = 400;
+    return element_compose( &impl->element, outer, inner, kind == ICON_SYMBOL ? (void *)&impl->ISymbolIcon_iface
+                                                                               : (void *)&impl->IFontIcon_iface, value );
+}
+
+/* a SymbolIcon for markup's Icon="Add" */
+IInspectable *symbol_icon_create( Symbol symbol )
+{
+    IInspectable *object = NULL;
+    struct icon *impl;
+
+    if (FAILED(icon_create( ICON_SYMBOL, NULL, NULL, (void **)&object ))) return NULL;
+    impl = impl_from_element( element_from_object( object ) );
+    impl->symbol = symbol;
+    return object;
+}
