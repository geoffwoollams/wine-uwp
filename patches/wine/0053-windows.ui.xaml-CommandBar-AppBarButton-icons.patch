+/* whether DirectWrite has a font family: icons fall back to other characters without Segoe MDL2 Assets */
+BOOL dwrite_has_family( const WCHAR *family )
+{
+    IDWriteFontCollection *collection;
+    BOOL exists = FALSE;
+    UINT32 index;
+
+    if (!init() || !dwrite || FAILED(IDWriteFactory_GetSystemFontCollection( dwrite, &collection, FALSE ))) return FALSE;
+    if (FAILED(IDWriteFontCollection_FindFamilyName( collection, family, &index, &exists ))) exists = FALSE;
+    IDWriteFontCollection_Release( collection );
+    return exists;
+}
+
+/* a glyph (or short text) of a font family, centred in rect: SymbolIcon and FontIcon */
+BOOL d2d_draw_glyphs( struct layout_context *ctx, const WCHAR *family, double size, UINT16 weight, const WCHAR *text,
+                      UINT32 len, const struct layout_rect *rect, Color color )
+{
+    IDWriteTextFormat *format;
+    IDWriteTextLayout *layout = NULL;
+    D2D1_POINT_2F origin = { rect->x, rect->y };
+    ID2D1Brush *brush;
+
+    if (!ctx->rt || !init() || !dwrite) return FALSE;
+    if (FAILED(IDWriteFactory_CreateTextFormat( dwrite, family, NULL, weight ? weight : 400, DWRITE_FONT_STYLE_NORMAL,
+                                                DWRITE_FONT_STRETCH_NORMAL, size, L"", &format )))
+        return FALSE;
+    IDWriteTextFormat_SetWordWrapping( format, DWRITE_WORD_WRAPPING_NO_WRAP );
+    IDWriteTextFormat_SetTextAlignment( format, DWRITE_TEXT_ALIGNMENT_CENTER );
+    IDWriteTextFormat_SetParagraphAlignment( format, DWRITE_PARAGRAPH_ALIGNMENT_CENTER );
+    IDWriteFactory_CreateTextLayout( dwrite, text, len, format, max( rect->width, 1.0f ), max( rect->height, 1.0f ), &layout );
+    IDWriteTextFormat_Release( format );
+    if (!layout) return FALSE;
+    if ((brush = solid( ctx, color )))
+    {
+        ID2D1RenderTarget_DrawTextLayout( RT(ctx), origin, layout, brush, D2D1_DRAW_TEXT_OPTIONS_NONE );
+        ID2D1Brush_Release( brush );
+    }
+    IDWriteTextLayout_Release( layout );
+    return TRUE;
+}
+
 /* ---- transforms, clips, opacity ---- */
 
 void d2d_set_transform( struct layout_context *ctx, const float *m )
