+/* calls the Completed handler once the action has finished and has one; takes the lock, releases it */
+static void async_action_notify(struct async_action *action)
+{
+    IAsyncActionCompletedHandler *handler = NULL;
+    AsyncStatus status = action->status;
+
+    if (action->handler && !action->handler_called && action->status != Started)
+    {
+        action->handler_called = TRUE;
+        IAsyncActionCompletedHandler_AddRef((handler = action->handler));
+    }
+    ReleaseSRWLockExclusive(&action->lock);
+
+    if (handler)
+    {
+        IAsyncActionCompletedHandler_Invoke(handler, &action->IAsyncAction_iface, status);
+        IAsyncActionCompletedHandler_Release(handler);
+    }
 }
 
 static HRESULT STDMETHODCALLTYPE async_action_put_Completed(IAsyncAction *iface, IAsyncActionCompletedHandler *handler)
 {
-    FIXME("iface %p, handler %p stub!\n", iface, handler);
+    struct async_action *action = impl_from_IAsyncAction(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, handler %p.\n", iface, handler);
+
+    if (!handler) return E_POINTER;
+    AcquireSRWLockExclusive(&action->lock);
+    if (action->handler)
+    {
+        ReleaseSRWLockExclusive(&action->lock);
+        return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    }
+    IAsyncActionCompletedHandler_AddRef((action->handler = handler));
+    async_action_notify(action);   /* at once if it has finished */
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE async_action_get_Completed(IAsyncAction *iface, IAsyncActionCompletedHandler **handler)
 {
-    FIXME("iface %p, handler %p stub!\n", iface, handler);
+    struct async_action *action = impl_from_IAsyncAction(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, handler %p.\n", iface, handler);
+
+    AcquireSRWLockExclusive(&action->lock);
+    if ((*handler = action->handler)) IAsyncActionCompletedHandler_AddRef(*handler);
+    ReleaseSRWLockExclusive(&action->lock);
+    return S_OK;
 }
 
 static HRESULT STDMETHODCALLTYPE async_action_GetResults(IAsyncAction *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct async_action *action = impl_from_IAsyncAction(iface);
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("iface %p.\n", iface);
+
+    AcquireSRWLockExclusive(&action->lock);
+    switch (action->status)
+    {
+    case Completed: hr = S_OK; break;
+    case Error: hr = action->error; break;
+    case Canceled: hr = HRESULT_FROM_WIN32(ERROR_CANCELLED); break;
+    default: hr = E_ILLEGAL_METHOD_CALL; break;
+    }
+    ReleaseSRWLockExclusive(&action->lock);
+    return hr;
 }
 
