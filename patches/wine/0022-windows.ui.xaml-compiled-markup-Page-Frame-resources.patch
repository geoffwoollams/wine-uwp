+    return S_OK;
+}
+
+static HRESULT WINAPI user_control_put_Content( IUserControl *iface, IUIElement *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    content_set( impl_from_IUserControl( iface ), (IInspectable *)value );
+    return S_OK;
+}
