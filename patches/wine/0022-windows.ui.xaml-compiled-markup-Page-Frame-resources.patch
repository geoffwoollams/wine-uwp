+/* IMap<Object, Object> */
+
+DEFINE_IINSPECTABLE_( map, IMap_IInspectable_IInspectable, struct resource_dictionary, impl_from_IMap, IMap_iface, impl->outer )
+
+static HRESULT WINAPI map_Lookup( IMap_IInspectable_IInspectable *iface, IInspectable *key, IInspectable **value )
+{
+    struct resource_dictionary *impl = impl_from_IMap( iface );
+    struct resource_entry *entry;
+    HSTRING str = key_string( key );
+
+    *value = NULL;
+    if (!str) return E_INVALIDARG;
+    entry = find_entry( impl, WindowsGetStringRawBuffer( str, NULL ) );
+    TRACE( "iface %p, key %s -> %p.\n", iface, debugstr_hstring(str), entry ? entry->value : NULL );
+    WindowsDeleteString( str );
+    if (!entry) return E_BOUNDS;
+    if ((*value = entry->value)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_get_Size( IMap_IInspectable_IInspectable *iface, unsigned int *size )
+{
+    *size = impl_from_IMap( iface )->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_HasKey( IMap_IInspectable_IInspectable *iface, IInspectable *key, boolean *found )
+{
+    struct resource_dictionary *impl = impl_from_IMap( iface );
+    HSTRING str = key_string( key );
+
+    *found = str && find_entry( impl, WindowsGetStringRawBuffer( str, NULL ) );
+    WindowsDeleteString( str );
+    return S_OK;
+}
+
+static HRESULT WINAPI map_GetView( IMap_IInspectable_IInspectable *iface, __FIMapView_2_IInspectable_IInspectable **view )
+{
+    FIXME( "iface %p stub!\n", iface );
+    *view = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI map_Insert( IMap_IInspectable_IInspectable *iface, IInspectable *key, IInspectable *value, boolean *replaced )
+{
+    struct resource_dictionary *impl = impl_from_IMap( iface );
+    HSTRING str = key_string( key );
+    HRESULT hr;
+
+    if (!str) return E_INVALIDARG;
+    hr = insert_entry( impl, WindowsGetStringRawBuffer( str, NULL ), value, replaced );
+    WindowsDeleteString( str );
+    return hr;
+}
+
+static HRESULT WINAPI map_Remove( IMap_IInspectable_IInspectable *iface, IInspectable *key )
+{
+    struct resource_dictionary *impl = impl_from_IMap( iface );
+    struct resource_entry *entry;
+    HSTRING str = key_string( key );
+
+    if (!str) return E_INVALIDARG;
+    entry = find_entry( impl, WindowsGetStringRawBuffer( str, NULL ) );
+    WindowsDeleteString( str );
+    if (!entry) return E_BOUNDS;
+    WindowsDeleteString( entry->key );
+    if (entry->value) IInspectable_Release( entry->value );
+    memmove( entry, entry + 1, (impl->entries + impl->count - entry - 1) * sizeof(*entry) );
+    impl->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_Clear( IMap_IInspectable_IInspectable *iface )
+{
+    struct resource_dictionary *impl = impl_from_IMap( iface );
+
+    while (impl->count)
+    {
+        impl->count--;
+        WindowsDeleteString( impl->entries[impl->count].key );
+        if (impl->entries[impl->count].value) IInspectable_Release( impl->entries[impl->count].value );
+    }
+    return S_OK;
+}
+
