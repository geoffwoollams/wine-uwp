+/* A ResourceDictionary is an IMap<Object, Object>; only string keys (x:Key) are supported, which is what markup
+ * uses for everything except implicit styles. Merged and theme dictionaries are not supported yet. */
+
+struct resource_entry
+{
+    HSTRING key;
+    IInspectable *value;
+};
+
+struct resource_dictionary
+{
+    IResourceDictionary IResourceDictionary_iface;
+    IMap_IInspectable_IInspectable IMap_iface;
+    IDependencyObject IDependencyObject_iface;
+    IInspectable IInspectable_inner;
+    IInspectable *outer;
+    LONG ref;
+    struct resource_entry *entries;
+    UINT32 count;
+};
+
+static const struct IResourceDictionaryVtbl resource_dictionary_vtbl;
+
+static inline struct resource_dictionary *impl_from_inner( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct resource_dictionary, IInspectable_inner );
+}
+
+static struct resource_dictionary *dictionary_from_object( IInspectable *object )
+{
+    IResourceDictionary *dict;
+    struct resource_dictionary *impl = NULL;
+
+    if (!object || FAILED(IInspectable_QueryInterface( object, &IID_IResourceDictionary, (void **)&dict ))) return NULL;
+    if (dict->lpVtbl == &resource_dictionary_vtbl)
+        impl = CONTAINING_RECORD( dict, struct resource_dictionary, IResourceDictionary_iface );
+    IResourceDictionary_Release( dict );
+    return impl;
+}
+
+static struct resource_entry *find_entry( struct resource_dictionary *impl, const WCHAR *key )
+{
+    UINT32 i;
+
+    for (i = 0; i < impl->count; i++)
+        if (!wcscmp( WindowsGetStringRawBuffer( impl->entries[i].key, NULL ), key )) return &impl->entries[i];
+    return NULL;
+}
+
+static HRESULT insert_entry( struct resource_dictionary *impl, const WCHAR *key, IInspectable *value, boolean *replaced )
+{
+    struct resource_entry *entry = find_entry( impl, key ), *entries;
+
+    TRACE( "dictionary %p, key %s, value %p.\n", impl, debugstr_w(key), value );
+
+    if (replaced) *replaced = entry != NULL;
+    if (value) IInspectable_AddRef( value );
+    if (entry)
+    {
+        if (entry->value) IInspectable_Release( entry->value );
+        entry->value = value;
+        return S_OK;
+    }
+    if (!(entries = realloc( impl->entries, (impl->count + 1) * sizeof(*entries) )))
+    {
+        if (value) IInspectable_Release( value );
+        return E_OUTOFMEMORY;
+    }
+    impl->entries = entries;
+    WindowsCreateString( key, wcslen( key ), &entries[impl->count].key );
+    entries[impl->count].value = value;
+    impl->count++;
+    return S_OK;
+}
+
+/* string key of an IMap key object (a boxed string) */
+static HSTRING key_string( IInspectable *key )
+{
+    IPropertyValue *value;
+    HSTRING str = NULL;
+
+    if (key && SUCCEEDED(IInspectable_QueryInterface( key, &IID_IPropertyValue, (void **)&value )))
+    {
+        if (FAILED(IPropertyValue_GetString( value, &str ))) str = NULL;
+        IPropertyValue_Release( value );
+    }
+    if (!str) FIXME( "only string keys are supported (key %p).\n", key );
+    return str;
+}
+
+IInspectable *resource_dictionary_lookup( IInspectable *object, const WCHAR *key )
+{
+    struct resource_dictionary *impl = dictionary_from_object( object );
+    struct resource_entry *entry;
+
+    if (!impl || !(entry = find_entry( impl, key )) || !entry->value) return NULL;
+    IInspectable_AddRef( entry->value );
+    return entry->value;
+}
+
+void resource_dictionary_insert( IInspectable *object, const WCHAR *key, IInspectable *value )
+{
+    struct resource_dictionary *impl = dictionary_from_object( object );
+
+    if (impl) insert_entry( impl, key, value, NULL );
+    else FIXME( "%p is not a resource dictionary.\n", object );
+}
+
+/* non-delegating IInspectable */
+
+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct resource_dictionary *impl = impl_from_inner( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ))
+        *out = &impl->IInspectable_inner;
+    else if (IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IResourceDictionary ))
+        *out = &impl->IResourceDictionary_iface;
+    else if (IsEqualGUID( iid, &IID_IMap_IInspectable_IInspectable ))
+        *out = &impl->IMap_iface;
+    else if (IsEqualGUID( iid, &IID_IDependencyObject ))
+        *out = &impl->IDependencyObject_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_inner( iface )->ref );
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct resource_dictionary *impl = impl_from_inner( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++)
+        {
+            WindowsDeleteString( impl->entries[i].key );
+            if (impl->entries[i].value) IInspectable_Release( impl->entries[i].value );
+        }
+        free( impl->entries );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI inner_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI inner_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Xaml_ResourceDictionary;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI inner_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const struct IInspectableVtbl inner_vtbl =
+{
+    inner_QueryInterface,
+    inner_AddRef,
+    inner_Release,
+    /* IInspectable methods */
+    inner_GetIids,
+    inner_GetRuntimeClassName,
+    inner_GetTrustLevel,
+};
