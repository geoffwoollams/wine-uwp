+static inline struct content_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct content_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct content_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (impl->kind == CONTENT_USER_CONTROL && IsEqualGUID( iid, &IID_IUserControlFactory ))
+        *out = &impl->IUserControlFactory_iface;
+    else if (impl->kind == CONTENT_PAGE && IsEqualGUID( iid, &IID_IPageFactory ))
+        *out = &impl->IPageFactory_iface;
+    else if (impl->kind == CONTENT_FRAME && IsEqualGUID( iid, &IID_IFrameFactory ))
+        *out = &impl->IFrameFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
