+    map_GetRuntimeClassName,
+    map_GetTrustLevel,
+    /* IMap<IInspectable *, IInspectable *> methods */
+    map_Lookup,
+    map_get_Size,
+    map_HasKey,
+    map_GetView,
+    map_Insert,
+    map_Remove,
+    map_Clear,
+};
