+static HRESULT content_create( enum content_kind kind, IInspectable *outer, IInspectable **inner, void **value )
+{
+    static const WCHAR *names[] =
+    {
+        RuntimeClass_Windows_UI_Xaml_Controls_UserControl,
+        RuntimeClass_Windows_UI_Xaml_Controls_Page,
+        RuntimeClass_Windows_UI_Xaml_Controls_Frame,
+    };
+    struct content_host *impl;
+    void *iface;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &content_ops, names[kind], outer );
+    impl->IUserControl_iface.lpVtbl = &user_control_vtbl;
+    impl->IPage_iface.lpVtbl = &page_vtbl;
+    impl->IFrame_iface.lpVtbl = &frame_vtbl;
+    impl->INavigate_iface.lpVtbl = &navigate_vtbl;
+    impl->IContentControl_iface.lpVtbl = &content_control_vtbl;
+    impl->IControl_iface.lpVtbl = &control_vtbl;
+    impl->kind = kind;
+    impl->font_size = 14.0;
+    if (kind == CONTENT_FRAME)
+    {
+        /* a Frame's content presenter stretches its page */
+        iface = &impl->IFrame_iface;
+    }
+    else iface = kind == CONTENT_PAGE ? (void *)&impl->IPage_iface : (void *)&impl->IUserControl_iface;
+    TRACE( "created %s %p, outer %p.\n", debugstr_w(names[kind]), impl, outer );
+    return element_compose( &impl->element, outer, inner, iface, value );
+}
