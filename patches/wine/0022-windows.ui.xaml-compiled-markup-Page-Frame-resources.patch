+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* UserControl, Page (a UserControl) and Frame (a ContentControl) all host one content element, so they share one
+ * object type. Apps derive their pages from Page by aggregation; Frame.Navigate creates them through the app's
+ * IXamlMetadataProvider. Navigation history, OnNavigatedTo and transitions are not implemented. */
+
+enum content_kind
+{
+    CONTENT_USER_CONTROL,
+    CONTENT_PAGE,
+    CONTENT_FRAME,
+};
+
+struct content_host
+{
+    struct xaml_element element;
+    IUserControl IUserControl_iface;
+    IPage IPage_iface;
+    IFrame IFrame_iface;
+    INavigate INavigate_iface;
+    IContentControl IContentControl_iface;
+    IControl IControl_iface;
+    enum content_kind kind;
+    IInspectable *content;
+    struct xaml_element *child;   /* content, when it is one of our elements */
+    IBrush *background, *foreground;
+    double font_size;
+    Thickness padding;
+    TypeName page_type;           /* Frame: the current page's type */
+    IFrame *frame;                /* Page: the frame showing it (not referenced) */
+    struct event_list navigated, navigating, navigation_failed, navigation_stopped;
+};
+
+static const struct element_ops content_ops;
+
+static inline struct content_host *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct content_host, element );
+}
+
+static HRESULT content_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct content_host *impl = impl_from_element( element );
+
+    if (IsEqualGUID( iid, &IID_IControl )) *out = &impl->IControl_iface;
+    else if (impl->kind != CONTENT_FRAME && IsEqualGUID( iid, &IID_IUserControl )) *out = &impl->IUserControl_iface;
+    else if (impl->kind == CONTENT_PAGE && IsEqualGUID( iid, &IID_IPage )) *out = &impl->IPage_iface;
+    else if (impl->kind == CONTENT_FRAME && IsEqualGUID( iid, &IID_IFrame )) *out = &impl->IFrame_iface;
+    else if (impl->kind == CONTENT_FRAME && IsEqualGUID( iid, &IID_INavigate )) *out = &impl->INavigate_iface;
+    else if (impl->kind == CONTENT_FRAME && IsEqualGUID( iid, &IID_IContentControl )) *out = &impl->IContentControl_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void content_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                             float avail_height, float *width, float *height )
+{
+    struct content_host *impl = impl_from_element( element );
+    const Thickness *p = &impl->padding;
+    COLORREF saved = ctx->foreground;
+    Color c;
+
+    *width = p->Left + p->Right;
+    *height = p->Top + p->Bottom;
+    if (!impl->child) return;
+    if (impl->foreground && brush_get_color( impl->foreground, &c )) ctx->foreground = RGB( c.R, c.G, c.B );
+    element_measure( impl->child, ctx, max( 0.0f, avail_width - *width ), max( 0.0f, avail_height - *height ) );
+    ctx->foreground = saved;
+    *width += impl->child->desired_width;
+    *height += impl->child->desired_height;
+}
+
+static void content_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct content_host *impl = impl_from_element( element );
+    const Thickness *p = &impl->padding;
+    const struct layout_rect *b = &element->bounds;
+
+    if (impl->child)
+        element_arrange( impl->child, ctx, b->x + p->Left, b->y + p->Top, max( 0.0f, b->width - p->Left - p->Right ),
+                         max( 0.0f, b->height - p->Top - p->Bottom ) );
+}
+
+static void content_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct content_host *impl = impl_from_element( element );
+    COLORREF saved = ctx->foreground;
+    Color c;
+
+    element_fill( ctx, &element->bounds, impl->background );
+    if (!impl->child) return;
+    if (impl->foreground && brush_get_color( impl->foreground, &c )) ctx->foreground = RGB( c.R, c.G, c.B );
+    element_render( impl->child, ctx );
+    ctx->foreground = saved;
+}
+
+static UINT32 content_child_count( struct xaml_element *element )
+{
+    return impl_from_element( element )->child ? 1 : 0;
+}
+
+static struct xaml_element *content_child_at( struct xaml_element *element, UINT32 index )
+{
+    return impl_from_element( element )->child;
+}
+
+static BOOL content_hit_self( struct xaml_element *element, float x, float y )
+{
+    return impl_from_element( element )->background != NULL;
+}
+
+static void content_set( struct content_host *impl, IInspectable *value )
+{
+    struct xaml_element *child = value ? element_from_object( value ) : NULL;
+
+    if (impl->child && impl->child->ops == &content_ops && impl_from_element( impl->child )->frame == &impl->IFrame_iface)
+        impl_from_element( impl->child )->frame = NULL;
+    if (impl->child && impl->child->parent == &impl->element) element_set_parent( impl->child, NULL );
+    if (value) IInspectable_AddRef( value );
+    if (impl->content) IInspectable_Release( impl->content );
+    impl->content = value;
+    impl->child = child;
+    if (child) element_set_parent( child, &impl->element );
+    else if (value) FIXME( "content %p is not a UIElement; it is not shown.\n", value );
+    window_invalidate();
+}
+
+static void content_destroy( struct xaml_element *element )
+{
+    struct content_host *impl = impl_from_element( element );
+
+    content_set( impl, NULL );
+    if (impl->background) IBrush_Release( impl->background );
+    if (impl->foreground) IBrush_Release( impl->foreground );
+    WindowsDeleteString( impl->page_type.Name );
+    event_list_clear( &impl->navigated );
+    event_list_clear( &impl->navigating );
+    event_list_clear( &impl->navigation_failed );
+    event_list_clear( &impl->navigation_stopped );
+    free( impl );
+}
+
+static const struct element_ops content_ops =
+{
+    .query_interface = content_query_interface,
+    .measure = content_measure,
+    .arrange = content_arrange,
+    .render = content_render,
+    .child_count = content_child_count,
+    .child_at = content_child_at,
+    .hit_self = content_hit_self,
+    .destroy = content_destroy,
+};
+
+/* Frame.Navigate: create the page through the app's metadata provider, or a built-in type, and show it */
+static HRESULT frame_navigate( struct content_host *impl, TypeName type, IInspectable *parameter, boolean *success )
+{
+    IInspectable *page = NULL;
+    struct xaml_element *element;
+    struct content_host *host;
+    HRESULT hr;
+
+    TRACE( "frame %p, type %s (kind %d), parameter %p.\n", impl, debugstr_hstring(type.Name), type.Kind, parameter );
+
+    *success = FALSE;
+    if (type.Kind == TypeKind_Custom) hr = app_create_instance_from_type( type, &page );
+    else hr = (page = create_builtin( WindowsGetStringRawBuffer( type.Name, NULL ) )) ? S_OK : E_FAIL;
+    if (FAILED(hr) || !page)
+    {
+        ERR( "could not create page %s, hr %#lx.\n", debugstr_hstring(type.Name), hr );
+        return S_OK;   /* Navigate reports failure through its result (and NavigationFailed) */
+    }
+    if (parameter) FIXME( "the navigation parameter is not passed to OnNavigatedTo.\n" );
+    if ((element = element_from_object( page )) && element->ops == &content_ops)
+    {
+        host = impl_from_element( element );
+        if (host->kind == CONTENT_PAGE) host->frame = &impl->IFrame_iface;
+    }
+    content_set( impl, page );
+    IInspectable_Release( page );
+    WindowsDeleteString( impl->page_type.Name );
+    impl->page_type.Kind = type.Kind;
+    WindowsDuplicateString( type.Name, &impl->page_type.Name );
+    *success = TRUE;
+    return S_OK;
+}
+
+/* IUserControl */
+
+DEFINE_IINSPECTABLE_( user_control, IUserControl, struct content_host, impl_from_IUserControl, IUserControl_iface,
+                      impl->element.outer )
