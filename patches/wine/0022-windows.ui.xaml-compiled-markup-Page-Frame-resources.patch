+IInspectable *application_resources(void)
+{
+    return current_app ? (IInspectable *)current_app->resources : NULL;
+}
+
+static IXamlMetadataProvider *app_metadata_provider(void)
+{
+    IXamlMetadataProvider *provider;
+
+    if (!current_app || FAILED(IInspectable_QueryInterface( current_app->outer, &IID_IXamlMetadataProvider, (void **)&provider )))
+    {
+        WARN( "the application has no IXamlMetadataProvider.\n" );
+        return NULL;
+    }
+    return provider;
+}
+
+static HRESULT activate_xaml_type( IXamlType *type, IInspectable **out )
+{
+    HRESULT hr;
+
+    if (!type) return E_FAIL;
+    hr = IXamlType_ActivateInstance( type, out );
+    IXamlType_Release( type );
+    return hr;
+}
+
+/* create an instance of one of the app's own types (pages, user controls), as markup and Frame.Navigate do */
+HRESULT app_create_instance_from_type( TypeName type, IInspectable **out )
+{
+    IXamlMetadataProvider *provider = app_metadata_provider();
+    IXamlType *xaml_type = NULL;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!provider) return E_FAIL;
+    hr = IXamlMetadataProvider_GetXamlType( provider, type, &xaml_type );
+    IXamlMetadataProvider_Release( provider );
+    if (FAILED(hr)) return hr;
+    return activate_xaml_type( xaml_type, out );
+}
+
+IInspectable *app_create_instance( const WCHAR *full_name )
+{
+    IXamlMetadataProvider *provider = app_metadata_provider();
+    IXamlType *xaml_type = NULL;
+    IInspectable *object = NULL;
+    HSTRING name;
+
+    if (!provider) return NULL;
+    WindowsCreateString( full_name, wcslen( full_name ), &name );
+    if (SUCCEEDED(IXamlMetadataProvider_GetXamlTypeByFullName( provider, name, &xaml_type )))
+        activate_xaml_type( xaml_type, &object );
+    WindowsDeleteString( name );
+    IXamlMetadataProvider_Release( provider );
+    if (!object) ERR( "could not create %s through the app's metadata provider.\n", debugstr_w(full_name) );
+    return object;
+}
