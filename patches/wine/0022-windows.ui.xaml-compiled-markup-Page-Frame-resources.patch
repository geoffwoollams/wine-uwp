+static HRESULT resource_dictionary_create( IInspectable *outer, IInspectable **inner, IResourceDictionary **value )
+{
+    struct resource_dictionary *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IResourceDictionary_iface.lpVtbl = &resource_dictionary_vtbl;
+    impl->IMap_iface.lpVtbl = &map_vtbl;
+    impl->IDependencyObject_iface.lpVtbl = &dictionary_dependency_object_vtbl;
+    impl->IInspectable_inner.lpVtbl = &inner_vtbl;
+    impl->outer = outer ? outer : &impl->IInspectable_inner;
+    impl->ref = 1;
+    if (outer)
+    {
+        if (!inner) { free( impl ); return E_INVALIDARG; }
+        *inner = &impl->IInspectable_inner;
+        *value = &impl->IResourceDictionary_iface;
+        IResourceDictionary_AddRef( *value );
+    }
+    else
+    {
+        if (inner) *inner = NULL;
+        *value = &impl->IResourceDictionary_iface;
+    }
+    return S_OK;
+}
