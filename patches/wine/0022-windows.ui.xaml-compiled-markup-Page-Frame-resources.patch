+IInspectable *theme_resource_lookup( const WCHAR *key )
+{
+    BOOL dark = application_theme() == ApplicationTheme_Dark;
+    ISolidColorBrushFactory *factory;
+    ISolidColorBrush *brush;
+    UINT32 i, argb;
+    Color color;
+
+    for (i = 0; i < ARRAY_SIZE(theme_brushes); i++)
+    {
+        if (wcscmp( key, theme_brushes[i].key )) continue;
+        argb = dark ? theme_brushes[i].dark : theme_brushes[i].light;
+        color.A = argb >> 24;
+        color.R = argb >> 16;
+        color.G = argb >> 8;
+        color.B = argb;
+        if (FAILED(IActivationFactory_QueryInterface( solid_color_brush_factory, &IID_ISolidColorBrushFactory, (void **)&factory )))
+            return NULL;
+        ISolidColorBrushFactory_CreateInstanceWithColor( factory, color, &brush );
+        ISolidColorBrushFactory_Release( factory );
+        return (IInspectable *)brush;
+    }
+    return NULL;
+}
+
+/* activation factory */
+
+struct dictionary_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IResourceDictionaryFactory IResourceDictionaryFactory_iface;
+};
+
+static inline struct dictionary_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct dictionary_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct dictionary_statics *impl = impl_from_IActivationFactory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IResourceDictionaryFactory ))
+        *out = &impl->IResourceDictionaryFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return resource_dictionary_create( NULL, NULL, (IResourceDictionary **)instance );
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( dictionary_factory, IResourceDictionaryFactory, struct dictionary_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI dictionary_factory_CreateInstance( IResourceDictionaryFactory *iface, IInspectable *outer,
+                                                         IInspectable **inner, IResourceDictionary **value )
+{
+    TRACE( "iface %p, outer %p, inner %p, value %p.\n", iface, outer, inner, value );
+    return resource_dictionary_create( outer, inner, value );
+}
+
+static const struct IResourceDictionaryFactoryVtbl dictionary_factory_vtbl =
+{
+    dictionary_factory_QueryInterface,
+    dictionary_factory_AddRef,
+    dictionary_factory_Release,
+    /* IInspectable methods */
+    dictionary_factory_GetIids,
+    dictionary_factory_GetRuntimeClassName,
+    dictionary_factory_GetTrustLevel,
+    /* IResourceDictionaryFactory methods */
+    dictionary_factory_CreateInstance,
+};
+
+static struct dictionary_statics dictionary_statics = { {&factory_vtbl}, {&dictionary_factory_vtbl} };
+IActivationFactory *resource_dictionary_factory = &dictionary_statics.IActivationFactory_iface;
diff --git a/dlls/windows.ui.xaml/xbf.c b/dlls/windows.ui.xaml/xbf.c
new file mode 100644
index 0000000..e2aadb8
--- /dev/null
+++ b/dlls/windows.ui.xaml/xbf.c
@@ -0,0 +1,1755 @@
+/* Compiled XAML (XBF version 2) reader and object writer for Windows.UI.Xaml
+ *
+ * Copyright 2026 wine-uwp contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+
+#include "private.h"
+#include "xbf_stable.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* An XBF file is a metadata section (string, type, property and XML namespace tables) followed by node streams.
+ * A node stream is a serialized list of object-writer instructions (create this type, set that property, add to
+ * the collection on top of the stack, ...), so loading is running a small stack machine. Built-in types and
+ * properties are referred to by "stable" indexes (xbf_stable.h). Resource dictionaries, styles, visual state
+ * groups and x:Load elements keep their content in further node streams, described by "custom runtime data".
+ * The format follows Microsoft's MIT-licensed reader (microsoft-ui-xaml, dxaml/xcp/tools/XbfParser). */
+
+enum node_type
+{
+    NODE_PUSH_SCOPE = 1,
+    NODE_POP_SCOPE = 2,
+    NODE_ADD_NAMESPACE = 3,
+    NODE_PUSH_CONSTANT = 4,
+    NODE_SET_VALUE = 7,
+    NODE_ADD_TO_COLLECTION = 8,
+    NODE_ADD_TO_DICTIONARY = 9,
+    NODE_ADD_TO_DICTIONARY_WITH_KEY = 10,
+    NODE_CHECK_PEER_TYPE = 11,
+    NODE_SET_CONNECTION_ID = 12,
+    NODE_SET_NAME = 13,
+    NODE_GET_RESOURCE_PROPERTY_BAG = 14,
+    NODE_SET_CUSTOM_RUNTIME_DATA = 15,
+    NODE_SET_DEFERRED_PROPERTY = 17,
+    NODE_PUSH_SCOPE_ADD_NAMESPACE = 18,
+    NODE_PUSH_SCOPE_GET_VALUE = 19,
+    NODE_PUSH_SCOPE_CREATE_TYPE = 20,
+    NODE_PUSH_SCOPE_CREATE_TYPE_WITH_CONSTANT = 21,
+    NODE_PUSH_SCOPE_CREATE_TYPE_WITH_CONVERTED_CONSTANT = 22,
+    NODE_CREATE_TYPE = 23,
+    NODE_CREATE_TYPE_WITH_CONSTANT = 24,
+    NODE_CREATE_TYPE_WITH_CONVERTED_CONSTANT = 25,
+    NODE_SET_VALUE_CONSTANT = 26,
+    NODE_SET_VALUE_CONVERTED_CONSTANT = 27,
+    NODE_SET_VALUE_CONVERTED_RESOLVED_PROPERTY = 28,
+    NODE_SET_VALUE_CONVERTED_RESOLVED_TYPE = 29,
+    NODE_SET_VALUE_FROM_STATIC_RESOURCE = 30,
+    NODE_SET_VALUE_FROM_TEMPLATE_BINDING = 31,
+    NODE_SET_VALUE_FROM_MARKUP_EXTENSION = 32,
+    NODE_END_INIT_POP_SCOPE = 33,
+    NODE_PROVIDE_STATIC_RESOURCE_VALUE = 34,
+    NODE_PROVIDE_THEME_RESOURCE_VALUE = 35,
+    NODE_SET_VALUE_FROM_THEME_RESOURCE = 36,
+    NODE_BEGIN_CONDITIONAL_SCOPE = 38,
+    NODE_END_CONDITIONAL_SCOPE = 39,
+    NODE_END_INIT_PROVIDE_VALUE_POP_SCOPE = 40,
+};
+
+enum constant_type
+{
+    CONST_BOOL_FALSE = 1,
+    CONST_BOOL_TRUE,
+    CONST_FLOAT,
+    CONST_SIGNED,
+    CONST_SHARED_STRING,
+    CONST_THICKNESS,
+    CONST_GRID_LENGTH,
+    CONST_COLOR,
+    CONST_UNIQUE_STRING,
+    CONST_NULL_STRING,
+    CONST_ENUM,
+};
+
+struct xbf_type_entry { UINT32 flags, ns, name; };
+struct xbf_property_entry { UINT32 flags, type, name; };
+struct xbf_stream { const BYTE *start, *end; };
+
+struct xbf
+{
+    const BYTE *data;
+    SIZE_T size;
+    UINT32 major, minor;
+    WCHAR **strings;
+    UINT32 string_count;
+    UINT32 *type_namespaces;   /* name string of each type namespace */
+    UINT32 type_namespace_count;
+    struct xbf_type_entry *types;
+    UINT32 type_count;
+    struct xbf_property_entry *properties;
+    UINT32 property_count;
+    UINT32 *xmlns;             /* URI string of each XML namespace */
+    UINT32 xmlns_count;
+    struct xbf_stream *streams;
+    UINT32 stream_count;
+};
+
+struct reader
+{
+    struct xbf *xbf;
+    const BYTE *start, *p, *end;
+    BOOL error;
+};
+
+static BOOL read_bytes( struct reader *r, void *out, SIZE_T size )
+{
+    if (r->error || (SIZE_T)(r->end - r->p) < size)
+    {
+        r->error = TRUE;
+        memset( out, 0, size );
+        return FALSE;
+    }
+    memcpy( out, r->p, size );
+    r->p += size;
+    return TRUE;
+}
+
+static BYTE read_u8( struct reader *r ) { BYTE v; read_bytes( r, &v, 1 ); return v; }
+static UINT16 read_u16( struct reader *r ) { UINT16 v; read_bytes( r, &v, 2 ); return v; }
+static UINT32 read_u32( struct reader *r ) { UINT32 v; read_bytes( r, &v, 4 ); return v; }
+static UINT64 read_u64( struct reader *r ) { UINT64 v; read_bytes( r, &v, 8 ); return v; }
+static float read_float( struct reader *r ) { float v; read_bytes( r, &v, 4 ); return v; }
+
+static UINT32 read_7bit( struct reader *r )
+{
+    UINT32 value = 0, shift = 0;
+    BYTE b;
+
+    do
+    {
+        b = read_u8( r );
+        if (shift < 32) value |= (UINT32)(b & 0x7f) << shift;
+        shift += 7;
+    } while ((b & 0x80) && !r->error);
+    return value;
+}
+
+/* a length-prefixed UTF-16 string in the node stream; the caller frees it */
+static WCHAR *read_string( struct reader *r )
+{
+    UINT32 len = read_u32( r );
+    WCHAR *str;
+
+    if (r->error || len > (SIZE_T)(r->end - r->p) / sizeof(WCHAR))
+    {
+        r->error = TRUE;
+        return NULL;
+    }
+    if (!(str = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    read_bytes( r, str, len * sizeof(WCHAR) );
+    str[len] = 0;
+    return str;
+}
+
+static const WCHAR *xbf_string( struct xbf *xbf, UINT32 index )
+{
+    return index < xbf->string_count ? xbf->strings[index] : L"";
+}
+
+void xbf_free( struct xbf *xbf )
+{
+    UINT32 i;
+
+    if (!xbf) return;
+    for (i = 0; i < xbf->string_count; i++) free( xbf->strings[i] );
+    free( xbf->strings );
+    free( xbf->type_namespaces );
+    free( xbf->types );
+    free( xbf->properties );
+    free( xbf->xmlns );
+    free( xbf->streams );
+    free( (void *)xbf->data );
+    free( xbf );
+}
+
+/* takes ownership of data */
+HRESULT xbf_parse( BYTE *data, SIZE_T size, struct xbf **out )
+{
+    struct reader r = {0};
+    UINT64 offsets[6];
+    struct xbf *xbf;
+    const BYTE *metadata;
+    UINT32 metadata_size, i, count, a, b;
+
+    *out = NULL;
+    if (size < 20 || memcmp( data, "XBF", 4 ))
+    {
+        free( data );
+        return E_INVALIDARG;
+    }
+    if (!(xbf = calloc( 1, sizeof(*xbf) )))
+    {
+        free( data );
+        return E_OUTOFMEMORY;
+    }
+    xbf->data = data;
+    xbf->size = size;
+    r.xbf = xbf;
+    r.start = r.p = data + 4;
+    r.end = data + size;
+
+    metadata_size = read_u32( &r );
+    read_u32( &r );  /* node section size */
+    metadata = r.p;
+    xbf->major = read_u32( &r );
+    xbf->minor = read_u32( &r );
+    TRACE( "XBF %u.%u, metadata %u bytes.\n", xbf->major, xbf->minor, metadata_size );
+    if (xbf->major != 2)
+    {
+        FIXME( "XBF version %u.%u is not supported.\n", xbf->major, xbf->minor );
+        xbf_free( xbf );
+        return E_NOTIMPL;
+    }
+    for (i = 0; i < 6; i++) offsets[i] = read_u64( &r );
+    r.p += 64;  /* hash */
+
+    if (r.p != metadata + offsets[0]) goto bad;
+    count = read_u32( &r );
+    if (r.error || count > size / 4 || !(xbf->strings = calloc( count, sizeof(*xbf->strings) ))) goto bad;
+    xbf->string_count = count;
+    for (i = 0; i < count; i++)
+    {
+        xbf->strings[i] = read_string( &r );
+        if (xbf->minor >= 1) read_u16( &r );  /* XBF 2.1 null-terminates the table's strings */
+        if (r.error) goto bad;
+    }
+
+    if (r.p != metadata + offsets[1]) goto bad;
+    count = read_u32( &r );
+    for (i = 0; i < count && !r.error; i++) { read_u32( &r ); read_u32( &r ); }  /* assemblies */
+
+    if (r.p != metadata + offsets[2]) goto bad;
+    count = read_u32( &r );
+    if (r.error || count > size / 8 || !(xbf->type_namespaces = calloc( max( 1, count ), sizeof(UINT32) ))) goto bad;
+    xbf->type_namespace_count = count;
+    for (i = 0; i < count; i++)
+    {
+        read_u32( &r );  /* assembly */
+        xbf->type_namespaces[i] = read_u32( &r );
+    }
+
+    if (r.p != metadata + offsets[3]) goto bad;
+    count = read_u32( &r );
+    if (r.error || count > size / 12 || !(xbf->types = calloc( max( 1, count ), sizeof(*xbf->types) ))) goto bad;
+    xbf->type_count = count;
+    for (i = 0; i < count; i++)
+    {
+        xbf->types[i].flags = read_u32( &r );
+        xbf->types[i].ns = read_u32( &r );
+        xbf->types[i].name = read_u32( &r );
+    }
+
+    if (r.p != metadata + offsets[4]) goto bad;
+    count = read_u32( &r );
+    if (r.error || count > size / 12 || !(xbf->properties = calloc( max( 1, count ), sizeof(*xbf->properties) ))) goto bad;
+    xbf->property_count = count;
+    for (i = 0; i < count; i++)
+    {
+        xbf->properties[i].flags = read_u32( &r );
+        xbf->properties[i].type = read_u32( &r );
+        xbf->properties[i].name = read_u32( &r );
+    }
+
+    if (r.p != metadata + offsets[5]) goto bad;
+    count = read_u32( &r );
+    if (r.error || count > size / 4 || !(xbf->xmlns = calloc( max( 1, count ), sizeof(UINT32) ))) goto bad;
+    xbf->xmlns_count = count;
+    for (i = 0; i < count; i++) xbf->xmlns[i] = read_u32( &r );
+
+    /* node streams */
+    r.p = metadata + metadata_size;
+    count = read_u32( &r );
+    if (r.error || count > size / 8 || !(xbf->streams = calloc( max( 1, count ), sizeof(*xbf->streams) ))) goto bad;
+    xbf->stream_count = count;
+    {
+        const BYTE *table = r.p, *base = table + count * 8;
+        for (i = 0; i < count; i++)
+        {
+            memcpy( &a, table + i * 8, 4 );       /* node stream offset */
+            memcpy( &b, table + i * 8 + 4, 4 );   /* line stream offset = end of the node stream */
+            if (table + count * 8 > data + size || a > b || base + b > data + size) goto bad;
+            xbf->streams[i].start = base + a;
+            xbf->streams[i].end = base + b;
+        }
+    }
+    TRACE( "%u strings, %u types, %u properties, %u streams.\n", xbf->string_count, xbf->type_count,
+           xbf->property_count, xbf->stream_count );
+    *out = xbf;
+    return S_OK;
+
+bad:
+    WARN( "malformed XBF file.\n" );
+    xbf_free( xbf );
+    return E_FAIL;
+}
+
+/* ---- types, properties and constants as they appear in nodes ---- */
+
+struct xtype
+{
+    WCHAR ns[128];     /* empty for built-in types */
+    WCHAR name[96];
+    BOOL builtin;
+    BOOL directive;    /* x:Null and friends */
+};
+
+struct xprop
+{
+    WCHAR owner[96];   /* declaring type's short name, empty for directives and implicit properties */
+    WCHAR name[96];
+    BOOL directive;
+    BOOL implicit;
+};
+
+static void ascii_to_wide( const char *src, WCHAR *dst, SIZE_T len )
+{
+    SIZE_T i;
+    for (i = 0; src[i] && i + 1 < len; i++) dst[i] = src[i];
+    dst[i] = 0;
+}
+
+static void read_type( struct reader *r, struct xtype *type )
+{
+    UINT16 node = read_u16( r ), index = node & 0x7fff;
+    struct xbf *xbf = r->xbf;
+    const WCHAR *ns;
+
+    memset( type, 0, sizeof(*type) );
+    if (node & 0x8000)
+    {
+        type->builtin = TRUE;
+        if (index < ARRAY_SIZE(xbf_stable_types)) ascii_to_wide( xbf_stable_types[index], type->name, ARRAY_SIZE(type->name) );
+        return;
+    }
+    if (index >= xbf->type_count)
+    {
+        r->error = TRUE;
+        return;
+    }
+    lstrcpynW( type->name, xbf_string( xbf, xbf->types[index].name ), ARRAY_SIZE(type->name) );
+    if (xbf->types[index].flags & 1)
+        type->directive = TRUE;
+    else if (xbf->types[index].flags & 2)
+    {
+        /* unknown to the compiler: the XML namespace is "using:Namespace" */
+        ns = xbf->types[index].ns < xbf->xmlns_count ? xbf_string( xbf, xbf->xmlns[xbf->types[index].ns] ) : L"";
+        if (!wcsncmp( ns, L"using:", 6 )) ns += 6;
+        lstrcpynW( type->ns, ns, ARRAY_SIZE(type->ns) );
+        if (wcschr( type->ns, '?' )) *wcschr( type->ns, '?' ) = 0;  /* conditional namespace */
+    }
+    else if (xbf->types[index].ns < xbf->type_namespace_count)
+        lstrcpynW( type->ns, xbf_string( xbf, xbf->type_namespaces[xbf->types[index].ns] ), ARRAY_SIZE(type->ns) );
+    /* types in the Windows.UI.Xaml namespaces are built in */
+    if (!wcsncmp( type->ns, L"Windows.UI.Xaml", 15 )) type->builtin = TRUE;
+}
+
+static void read_property( struct reader *r, struct xprop *prop )
+{
+    UINT16 node = read_u16( r ), index = node & 0x7fff;
+    struct xbf *xbf = r->xbf;
+    struct reader sub = *r;
+    const char *sep;
+
+    memset( prop, 0, sizeof(*prop) );
+    if (node & 0x8000)
+    {
+        const char *name = index < ARRAY_SIZE(xbf_stable_properties) ? xbf_stable_properties[index] : "";
+        if ((sep = strchr( name, '_' )))
+        {
+            char owner[96];
+            lstrcpynA( owner, name, min( sizeof(owner), sep - name + 1 ) );
+            ascii_to_wide( owner, prop->owner, ARRAY_SIZE(prop->owner) );
+            ascii_to_wide( sep + 1, prop->name, ARRAY_SIZE(prop->name) );
+        }
+        return;
+    }
+    if (index >= xbf->property_count)
+    {
+        r->error = TRUE;
+        return;
+    }
+    lstrcpynW( prop->name, xbf_string( xbf, xbf->properties[index].name ), ARRAY_SIZE(prop->name) );
+    if (xbf->properties[index].flags & 2) prop->directive = TRUE;
+    else if (xbf->properties[index].flags & 4) prop->implicit = TRUE;
+    else if (xbf->properties[index].type < xbf->type_count)
+    {
+        /* the declaring type, from the type table */
+        BYTE buf[2];
+        UINT16 type_node = xbf->properties[index].type;
+        struct xtype type;
+        memcpy( buf, &type_node, 2 );
+        sub.start = sub.p = buf;
+        sub.end = buf + 2;
+        read_type( &sub, &type );
+        lstrcpyW( prop->owner, type.name );
+    }
+}
+
+enum xvalue_kind
+{
+    XV_NONE,
+    XV_NULL,
+    XV_BOOL,
+    XV_FLOAT,
+    XV_SIGNED,
+    XV_STRING,
+    XV_THICKNESS,
+    XV_GRID_LENGTH,
+    XV_COLOR,
+    XV_ENUM,
+    XV_OBJECT,
+};
+
+struct xvalue
+{
+    enum xvalue_kind kind;
+    union
+    {
+        BOOL b;
+        float f;
+        INT32 i;
+        WCHAR *s;           /* owned */
+        Thickness thickness;
+        GridLength grid_length;
+        UINT32 color;       /* ARGB */
+        struct { WCHAR type[64]; UINT32 value; } e;
+        IInspectable *object;  /* owned, may be NULL for things we don't create */
+    };
+};
+
+static void xvalue_clear( struct xvalue *v )
+{
+    if (v->kind == XV_STRING) free( v->s );
+    if (v->kind == XV_OBJECT && v->object) IInspectable_Release( v->object );
+    memset( v, 0, sizeof(*v) );
+}
+
+static void read_constant( struct reader *r, struct xvalue *v )
+{
+    BYTE type = read_u8( r );
+    UINT16 index;
+
+    memset( v, 0, sizeof(*v) );
+    switch (type)
+    {
+    case CONST_BOOL_FALSE: v->kind = XV_BOOL; v->b = FALSE; break;
+    case CONST_BOOL_TRUE: v->kind = XV_BOOL; v->b = TRUE; break;
+    case CONST_FLOAT: v->kind = XV_FLOAT; v->f = read_float( r ); break;
+    case CONST_SIGNED: v->kind = XV_SIGNED; v->i = read_u32( r ); break;
+    case CONST_SHARED_STRING:
+        v->kind = XV_STRING;
+        v->s = wcsdup( xbf_string( r->xbf, read_u16( r ) & 0x7fff ) );
+        break;
+    case CONST_THICKNESS:
+        v->kind = XV_THICKNESS;
+        v->thickness.Left = read_float( r );
+        v->thickness.Top = read_float( r );
+        v->thickness.Right = read_float( r );
+        v->thickness.Bottom = read_float( r );
+        break;
+    case CONST_GRID_LENGTH:
+        v->kind = XV_GRID_LENGTH;
+        v->grid_length.GridUnitType = read_u32( r );
+        v->grid_length.Value = read_float( r );
+        break;
+    case CONST_COLOR: v->kind = XV_COLOR; v->color = read_u32( r ); break;
+    case CONST_UNIQUE_STRING: v->kind = XV_STRING; v->s = read_string( r ); break;
+    case CONST_NULL_STRING: v->kind = XV_NULL; break;
+    case CONST_ENUM:
+        v->kind = XV_ENUM;
+        index = read_u16( r );
+        if (index < ARRAY_SIZE(xbf_stable_types)) ascii_to_wide( xbf_stable_types[index], v->e.type, ARRAY_SIZE(v->e.type) );
+        v->e.value = read_u32( r );
+        break;
+    default:
+        WARN( "unknown constant type %u.\n", type );
+        r->error = TRUE;
+        break;
+    }
+}
+
+/* ---- custom runtime data (resource dictionaries, styles, visual states, x:Load) ---- */
+
+struct resource_entry
+{
+    WCHAR *key;
+    UINT32 offset;   /* into the custom data's node stream */
+    BOOL implicit;   /* keyed by type (implicit styles) */
+};
+
+struct custom_data
+{
+    UINT32 kind;
+    struct resource_entry *resources;
+    UINT32 resource_count;
+};
+
+static void skip_predicates( struct reader *r )
+{
+    UINT32 i, n = read_7bit( r );
+    for (i = 0; i < n && !r->error; i++) { read_u16( r ); read_u16( r ); }
+}
+
+static void skip_conditional_objects( struct reader *r )
+{
+    UINT32 i, n = read_7bit( r );
+    for (i = 0; i < n && !r->error; i++) { read_7bit( r ); skip_predicates( r ); }
+}
+
+static void skip_7bit_vector( struct reader *r )
+{
+    UINT32 i, n = read_7bit( r );
+    for (i = 0; i < n && !r->error; i++) read_7bit( r );
+}
+
+static void skip_u16_vector( struct reader *r )
+{
+    UINT32 i, n = read_7bit( r );
+    for (i = 0; i < n && !r->error; i++) read_u16( r );
+}
+
+static void add_resource( struct custom_data *data, const WCHAR *key, UINT32 offset, BOOL implicit )
+{
+    struct resource_entry *entries;
+
+    if (!(entries = realloc( data->resources, (data->resource_count + 1) * sizeof(*entries) ))) return;
+    data->resources = entries;
+    entries[data->resource_count].key = wcsdup( key );
+    entries[data->resource_count].offset = offset;
+    entries[data->resource_count].implicit = implicit;
+    data->resource_count++;
+}
+
+static void read_key_token_vector( struct reader *r, struct custom_data *data, BOOL implicit )
+{
+    UINT32 i, n = read_7bit( r ), offset;
+    const WCHAR *key;
+
+    for (i = 0; i < n && !r->error; i++)
+    {
+        key = xbf_string( r->xbf, read_u16( r ) & 0x7fff );
+        offset = read_7bit( r );
+        add_resource( data, key, offset, implicit );
+    }
+}
+
+static void free_custom_data( struct custom_data *data )
+{
+    UINT32 i;
+    for (i = 0; i < data->resource_count; i++) free( data->resources[i].key );
+    free( data->resources );
+}
+
+/* Read a custom runtime data block. Only resource dictionaries keep anything; the rest is consumed so that the
+ * node stream can continue. */
+static void read_custom_data( struct reader *r, struct custom_data *data )
+{
+    UINT32 kind = read_7bit( r ), i, n, flags;
+    struct xvalue value;
+
+    memset( data, 0, sizeof(*data) );
+    data->kind = kind;
+    switch (kind)
+    {
+    case 371: case 7: case 10:   /* ResourceDictionary v1, v2, v3 */
+        read_key_token_vector( r, data, FALSE );
+        skip_u16_vector( r );                     /* resources with x:Name */
+        read_key_token_vector( r, data, TRUE );
+        if (kind == 371) { skip_u16_vector( r ); skip_u16_vector( r ); }
+        else if (kind == 7) skip_u16_vector( r );
+        else
+        {
+            for (i = 0, n = read_7bit( r ); i < n && !r->error; i++) { read_u16( r ); skip_7bit_vector( r ); }
+            for (i = 0, n = read_7bit( r ); i < n && !r->error; i++) { read_u16( r ); skip_7bit_vector( r ); }
+            skip_conditional_objects( r );
+        }
+        break;
+    case 12:                      /* ResourceDictionary v4 */
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++)
+        {
+            const WCHAR *key = xbf_string( r->xbf, read_u16( r ) & 0x7fff );
+            UINT64 hash = read_u64( r );
+            add_resource( data, key, read_7bit( r ), hash & 1 );
+        }
+        skip_u16_vector( r );
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++) { read_u16( r ); read_u64( r ); skip_7bit_vector( r ); }
+        skip_conditional_objects( r );
+        break;
+    case 2: case 8: case 11:      /* Style v1, v2, v3 */
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++)
+        {
+            flags = read_7bit( r );
+            if (!(flags & 0x40))
+            {
+                if (flags & 0x10) read_u16( r );            /* resolved property */
+                else { read_u16( r ); read_u16( r ); }      /* property name, declaring type */
+            }
+            if (flags & 0x04) read_u16( r );                /* string value */
+            else if (flags & 0x20) { read_constant( r, &value ); xvalue_clear( &value ); }
+            else if (flags & (0x01 | 0x02 | 0x08 | 0x40)) read_7bit( r );
+        }
+        if (kind == 11) skip_conditional_objects( r );
+        break;
+    case 420: case 1: case 3: case 4: case 5:   /* VisualStateGroupCollection v1..v5 */
+        skip_7bit_vector( r );
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++)
+        {
+            read_u16( r ); read_7bit( r ); read_u8( r );
+            if (kind == 420) continue;
+            skip_7bit_vector( r );
+            {
+                UINT32 j, m = read_7bit( r );
+                for (j = 0; j < m && !r->error; j++) skip_7bit_vector( r );
+            }
+            if (kind == 1) continue;
+            skip_7bit_vector( r );
+            skip_7bit_vector( r );
+            if (kind != 3 && kind != 4) skip_7bit_vector( r );
+        }
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++) { read_u16( r ); read_u8( r ); read_7bit( r ); }
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++) { read_u16( r ); read_u16( r ); read_7bit( r ); }
+        read_u8( r );
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++) { read_7bit( r ); read_7bit( r ); read_7bit( r ); }
+        skip_7bit_vector( r );
+        read_7bit( r );
+        if (kind == 4 || kind == 5) skip_u16_vector( r );
+        break;
+    case 745: case 6: case 9:     /* DeferredElement v1, v2, v3 */
+        read_u16( r );
+        if (kind == 745) break;
+        for (i = 0, n = read_7bit( r ); i < n && !r->error; i++)
+        {
+            read_u16( r );
+            read_constant( r, &value );
+            xvalue_clear( &value );
+        }
+        if (kind == 9) read_u8( r );
+        break;
+    default:
+        WARN( "unknown custom runtime data type %u.\n", kind );
+        r->error = TRUE;
+        break;
+    }
+}
+
+/* ---- the object writer ---- */
+
+#define MAX_STACK 256
+
+enum scope_kind { SCOPE_PLAIN, SCOPE_GET_VALUE };
+
+struct writer
+{
+    struct xbf *xbf;
+    IInspectable *root;              /* LoadComponent's component, used for the root object */
+    BOOL root_used;
+    IComponentConnector *connector;  /* the component's, for x:Name and event handlers */
+    struct xvalue stack[MAX_STACK];
+    int sp;
+    enum scope_kind scopes[MAX_STACK];
+    int scope_count;
+    BOOL failed;
+};
+
+static void push( struct writer *w, struct xvalue *v )
+{
+    if (w->sp >= MAX_STACK)
+    {
+        w->failed = TRUE;
+        xvalue_clear( v );
+        return;
+    }
+    w->stack[w->sp++] = *v;
+    memset( v, 0, sizeof(*v) );
+}
+
+static void pop( struct writer *w, struct xvalue *v )
+{
+    if (!w->sp)
+    {
+        WARN( "stack underflow.\n" );
+        w->failed = TRUE;
+        memset( v, 0, sizeof(*v) );
+        return;
+    }
+    *v = w->stack[--w->sp];
+}
+
+static IInspectable *top_object( struct writer *w )
+{
+    if (!w->sp || w->stack[w->sp - 1].kind != XV_OBJECT) return NULL;
+    return w->stack[w->sp - 1].object;
+}
+
+static void push_object( struct writer *w, IInspectable *object )
+{
+    struct xvalue v = { XV_OBJECT };
+    v.object = object;
+    push( w, &v );
+}
+
+/* ---- values to properties ---- */
+
+/* the value inside a boxed IPropertyValue, as a constant */
+static void unbox_value( struct xvalue *v )
+{
+    IPropertyValue *pv;
+    PropertyType type;
+    struct xvalue out = {0};
+
+    if (v->kind != XV_OBJECT || !v->object) return;
+    if (FAILED(IInspectable_QueryInterface( v->object, &IID_IPropertyValue, (void **)&pv ))) return;
+    if (SUCCEEDED(IPropertyValue_get_Type( pv, &type )))
+    {
+        HSTRING str;
+        DOUBLE d;
+        INT32 i;
+        boolean b;
+
+        switch (type)
+        {
+        case PropertyType_String:
+            if (SUCCEEDED(IPropertyValue_GetString( pv, &str )))
+            {
+                out.kind = XV_STRING;
+                out.s = wcsdup( WindowsGetStringRawBuffer( str, NULL ) );
+                WindowsDeleteString( str );
+            }
+            break;
+        case PropertyType_Double:
+            if (SUCCEEDED(IPropertyValue_GetDouble( pv, &d ))) { out.kind = XV_FLOAT; out.f = d; }
+            break;
+        case PropertyType_Int32:
+            if (SUCCEEDED(IPropertyValue_GetInt32( pv, &i ))) { out.kind = XV_SIGNED; out.i = i; }
+            break;
+        case PropertyType_Boolean:
+            if (SUCCEEDED(IPropertyValue_GetBoolean( pv, &b ))) { out.kind = XV_BOOL; out.b = b; }
+            break;
+        default:
+            break;
+        }
+    }
+    IPropertyValue_Release( pv );
+    if (out.kind)
+    {
+        xvalue_clear( v );
+        *v = out;
+    }
+}
+
+static BOOL to_double( const struct xvalue *v, double *d )
+{
+    WCHAR *end;
+
+    switch (v->kind)
+    {
+    case XV_FLOAT: *d = v->f; return TRUE;
+    case XV_SIGNED: *d = v->i; return TRUE;
+    case XV_STRING:
+        if (!wcsicmp( v->s, L"Auto" ) || !wcsicmp( v->s, L"NaN" )) { *d = NAN; return TRUE; }
+        *d = wcstod( v->s, &end );
+        return end != v->s;
+    default: return FALSE;
+    }
+}
+
+static BOOL to_int( const struct xvalue *v, INT32 *i )
+{
+    double d;
+    if (v->kind == XV_SIGNED) { *i = v->i; return TRUE; }
+    if (!to_double( v, &d )) return FALSE;
+    *i = (INT32)d;
+    return TRUE;
+}
+
+static BOOL to_bool( const struct xvalue *v, boolean *b )
+{
+    if (v->kind == XV_BOOL) { *b = v->b; return TRUE; }
+    if (v->kind == XV_STRING) { *b = !wcsicmp( v->s, L"True" ); return TRUE; }
+    return FALSE;
+}
+
+static BOOL to_thickness( const struct xvalue *v, Thickness *t )
+{
+    double d[4];
+    WCHAR *p, *end;
+    int n = 0;
+
+    if (v->kind == XV_THICKNESS) { *t = v->thickness; return TRUE; }
+    if (v->kind == XV_FLOAT || v->kind == XV_SIGNED)
+    {
+        to_double( v, &d[0] );
+        t->Left = t->Top = t->Right = t->Bottom = d[0];
+        return TRUE;
+    }
+    if (v->kind != XV_STRING) return FALSE;
+    for (p = v->s; *p && n < 4; p = end)
+    {
+        while (*p == ' ' || *p == ',') p++;
+        if (!*p) break;
+        d[n] = wcstod( p, &end );
+        if (end == p) return FALSE;
+        n++;
+    }
+    if (n == 1) { t->Left = t->Top = t->Right = t->Bottom = d[0]; }
+    else if (n == 2) { t->Left = t->Right = d[0]; t->Top = t->Bottom = d[1]; }
+    else if (n == 4) { t->Left = d[0]; t->Top = d[1]; t->Right = d[2]; t->Bottom = d[3]; }
+    else return FALSE;
+    return TRUE;
+}
+
+static BOOL to_grid_length( const struct xvalue *v, GridLength *g )
+{
+    double d;
+    WCHAR *end;
+    SIZE_T len;
+
+    if (v->kind == XV_GRID_LENGTH) { *g = v->grid_length; return TRUE; }
+    if (v->kind == XV_STRING)
+    {
+        len = wcslen( v->s );
+        if (!wcsicmp( v->s, L"Auto" )) { g->GridUnitType = GridUnitType_Auto; g->Value = 1; return TRUE; }
+        if (len && v->s[len - 1] == '*')
+        {
+            g->GridUnitType = GridUnitType_Star;
+            g->Value = len == 1 ? 1.0 : wcstod( v->s, &end );
+            return TRUE;
+        }
+    }
+    if (!to_double( v, &d )) return FALSE;
+    g->GridUnitType = GridUnitType_Pixel;
+    g->Value = d;
+    return TRUE;
+}
+
+static const struct { const WCHAR *name; UINT32 argb; } named_colors[] =
+{
+    { L"Black", 0xff000000 }, { L"Blue", 0xff0000ff }, { L"Brown", 0xffa52a2a }, { L"Cyan", 0xff00ffff },
+    { L"DarkGray", 0xffa9a9a9 }, { L"Gray", 0xff808080 }, { L"Green", 0xff008000 }, { L"LightGray", 0xffd3d3d3 },
+    { L"Lime", 0xff00ff00 }, { L"Magenta", 0xffff00ff }, { L"Navy", 0xff000080 }, { L"Orange", 0xffffa500 },
+    { L"Purple", 0xff800080 }, { L"Red", 0xffff0000 }, { L"Silver", 0xffc0c0c0 }, { L"Transparent", 0x00ffffff },
+    { L"White", 0xffffffff }, { L"Yellow", 0xffffff00 },
+};
+
+static BOOL to_color( const struct xvalue *v, Color *c )
+{
+    UINT32 argb, i;
+    SIZE_T len;
+
+    if (v->kind == XV_COLOR) argb = v->color;
+    else if (v->kind == XV_STRING && v->s[0] == '#')
+    {
+        len = wcslen( v->s + 1 );
+        argb = wcstoul( v->s + 1, NULL, 16 );
+        if (len == 6) argb |= 0xff000000;
+        else if (len == 3 || len == 4)
+        {
+            UINT32 a = len == 4 ? (argb >> 12) & 0xf : 0xf, r = (argb >> 8) & 0xf, g = (argb >> 4) & 0xf, b = argb & 0xf;
+            argb = (a * 0x11) << 24 | (r * 0x11) << 16 | (g * 0x11) << 8 | b * 0x11;
+        }
+        else if (len != 8) return FALSE;
+    }
+    else if (v->kind == XV_STRING)
+    {
+        for (i = 0; i < ARRAY_SIZE(named_colors); i++) if (!wcsicmp( v->s, named_colors[i].name )) break;
+        if (i == ARRAY_SIZE(named_colors)) { FIXME( "unknown color %s.\n", debugstr_w(v->s) ); return FALSE; }
+        argb = named_colors[i].argb;
+    }
+    else return FALSE;
+    c->A = argb >> 24;
+    c->R = argb >> 16;
+    c->G = argb >> 8;
+    c->B = argb;
+    return TRUE;
+}
+
+static IBrush *to_brush( const struct xvalue *v )
+{
+    ISolidColorBrushFactory *factory;
+    ISolidColorBrush *solid;
+    IBrush *brush = NULL;
+    Color c;
+
+    if (v->kind == XV_OBJECT)
+    {
+        if (v->object) IInspectable_QueryInterface( v->object, &IID_IBrush, (void **)&brush );
+        return brush;
+    }
+    if (!to_color( v, &c )) return NULL;
+    if (FAILED(IActivationFactory_QueryInterface( solid_color_brush_factory, &IID_ISolidColorBrushFactory, (void **)&factory )))
+        return NULL;
+    if (SUCCEEDED(ISolidColorBrushFactory_CreateInstanceWithColor( factory, c, &solid )))
+    {
+        ISolidColorBrush_QueryInterface( solid, &IID_IBrush, (void **)&brush );
+        ISolidColorBrush_Release( solid );
+    }
+    ISolidColorBrushFactory_Release( factory );
+    return brush;
+}
+
+/* enum values by name, in WinRT value order (NULL for gaps) */
+static BOOL to_enum( const struct xvalue *v, const WCHAR *const *names, UINT32 count, INT32 *out )
+{
+    UINT32 i;
+
+    if (v->kind == XV_ENUM) { *out = v->e.value; return TRUE; }
+    if (v->kind == XV_SIGNED) { *out = v->i; return TRUE; }
+    if (v->kind != XV_STRING) return FALSE;
+    for (i = 0; i < count; i++)
+        if (names[i] && !wcsicmp( v->s, names[i] )) { *out = i; return TRUE; }
+    return FALSE;
+}
+
+static const WCHAR *const horizontal_names[] = { L"Left", L"Center", L"Right", L"Stretch" };
+static const WCHAR *const vertical_names[] = { L"Top", L"Center", L"Bottom", L"Stretch" };
+static const WCHAR *const orientation_names[] = { L"Vertical", L"Horizontal" };
+static const WCHAR *const visibility_names[] = { L"Visible", L"Collapsed" };
+static const WCHAR *const wrapping_names[] = { NULL, L"NoWrap", L"Wrap", L"WrapWholeWords" };
+static const WCHAR *const alignment_names[] = { L"Center", L"Left", L"Right", L"Justify", L"DetectFromContent" };
+static const WCHAR *const theme_names[] = { L"Light", L"Dark" };
+static const WCHAR *const click_mode_names[] = { L"Release", L"Press", L"Hover" };
+
+static IInspectable *box_string( const WCHAR *str )
+{
+    static const WCHAR name[] = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics;
+    IInspectable *value = NULL;
+    HSTRING_HEADER header, header2;
+    HSTRING class_name, hstr;
+
+    WindowsCreateStringReference( name, wcslen( name ), &header, &class_name );
+    if (FAILED(RoGetActivationFactory( class_name, &IID_IPropertyValueStatics, (void **)&statics ))) return NULL;
+    WindowsCreateStringReference( str, wcslen( str ), &header2, &hstr );
+    IPropertyValueStatics_CreateString( statics, hstr, &value );
+    IPropertyValueStatics_Release( statics );
+    return value;
+}
+
+static IInspectable *to_content( const struct xvalue *v )
+{
+    if (v->kind == XV_OBJECT)
+    {
+        if (v->object) IInspectable_AddRef( v->object );
+        return v->object;
+    }
+    if (v->kind == XV_STRING) return box_string( v->s );
+    return NULL;
+}
+
+/* CreateTypeWith(TypeConverted)Constant: turn the constant into an object of the type where we can */
+static void convert_to_type( const struct xtype *type, struct xvalue *v )
+{
+    IInspectable *object = NULL;
+    IBrush *brush;
+
+    if (!wcscmp( type->name, L"SolidColorBrush" ) || !wcscmp( type->name, L"Brush" ))
+    {
+        if ((brush = to_brush( v ))) object = (IInspectable *)brush;
+    }
+    else if (!wcscmp( type->name, L"String" ) && v->kind == XV_STRING) object = box_string( v->s );
+    else if (v->kind == XV_OBJECT) return;
+    else
+    {
+        TRACE( "%s constant kept as a value.\n", debugstr_w(type->name) );
+        return;
+    }
+    xvalue_clear( v );
+    v->kind = XV_OBJECT;
+    v->object = object;
+}
+
+static BOOL prop_is( const struct xprop *prop, const WCHAR *name )
+{
+    return !wcscmp( prop->name, name );
+}
+
+#define QI( obj, I, out ) SUCCEEDED(IInspectable_QueryInterface( obj, &IID_##I, (void **)out ))
+
+/* Set prop on target from a markup value. Unsupported properties are logged and skipped. */
+static HRESULT set_property( struct writer *w, IInspectable *target, const struct xprop *prop, struct xvalue *value )
+{
+    IFrameworkElement *fe;
+    IUIElement *ui;
+    ITextBlock *tb;
+    IControl *control;
+    IBorder *border;
+    IPanel *panel;
+    IContentControl *cc;
+    IUserControl *uc;
+    IStackPanel *sp;
+    IRowDefinition *row;
+    IColumnDefinition *column;
+    ISolidColorBrush *solid;
+    IApplication *app;
+    IButtonBase *bb;
+    struct xaml_element *element;
+    IInspectable *content;
+    IBrush *brush;
+    HSTRING str;
+    Thickness t;
+    GridLength gl;
+    Color color;
+    double d;
+    INT32 e;
+    boolean b;
+    BOOL done = FALSE;
+
+    if (!target)
+    {
+        TRACE( "no target for %s.%s.\n", debugstr_w(prop->owner), debugstr_w(prop->name) );
+        return S_OK;
+    }
+    unbox_value( value );
+    TRACE( "%p.%s.%s, value kind %d.\n", target, debugstr_w(prop->owner), debugstr_w(prop->name), value->kind );
+
+    /* Grid attached properties */
+    if (!wcscmp( prop->owner, L"Grid" ) && (prop_is( prop, L"Row" ) || prop_is( prop, L"Column" ) ||
+        prop_is( prop, L"RowSpan" ) || prop_is( prop, L"ColumnSpan" )))
+    {
+        if ((element = element_from_object( target )) && to_int( value, &e ))
+        {
+            if (prop_is( prop, L"Row" )) element->row = e;
+            else if (prop_is( prop, L"Column" )) element->column = e;
+            else if (prop_is( prop, L"RowSpan" )) element->row_span = e;
+            else element->column_span = e;
+            window_invalidate();
+        }
+        return S_OK;
+    }
+
+    if (prop_is( prop, L"Name" ))
+    {
+        if (value->kind == XV_STRING && QI( target, IFrameworkElement, &fe ))
+        {
+            WindowsCreateString( value->s, wcslen( value->s ), &str );
+            IFrameworkElement_put_Name( fe, str );
+            WindowsDeleteString( str );
+            IFrameworkElement_Release( fe );
+        }
+        return S_OK;
+    }
+
+    if (prop_is( prop, L"Text" ) && value->kind == XV_STRING && QI( target, ITextBlock, &tb ))
+    {
+        WindowsCreateString( value->s, wcslen( value->s ), &str );
+        ITextBlock_put_Text( tb, str );
+        WindowsDeleteString( str );
+        ITextBlock_Release( tb );
+        return S_OK;
+    }
+    if (prop_is( prop, L"FontSize" ) && to_double( value, &d ))
+    {
+        if (QI( target, ITextBlock, &tb )) { ITextBlock_put_FontSize( tb, d ); ITextBlock_Release( tb ); done = TRUE; }
+        else if (QI( target, IControl, &control )) { IControl_put_FontSize( control, d ); IControl_Release( control ); done = TRUE; }
+    }
+    else if (prop_is( prop, L"Foreground" ) || prop_is( prop, L"Background" ) || prop_is( prop, L"BorderBrush" ))
+    {
+        if (!(brush = to_brush( value ))) goto unsupported;
+        if (prop_is( prop, L"Foreground" ))
+        {
+            if (QI( target, ITextBlock, &tb )) { ITextBlock_put_Foreground( tb, brush ); ITextBlock_Release( tb ); done = TRUE; }
+            else if (QI( target, IControl, &control )) { IControl_put_Foreground( control, brush ); IControl_Release( control ); done = TRUE; }
+        }
+        else if (prop_is( prop, L"Background" ))
+        {
+            if (QI( target, IPanel, &panel )) { IPanel_put_Background( panel, brush ); IPanel_Release( panel ); done = TRUE; }
+            else if (QI( target, IBorder, &border )) { IBorder_put_Background( border, brush ); IBorder_Release( border ); done = TRUE; }
+            else if (QI( target, IControl, &control )) { IControl_put_Background( control, brush ); IControl_Release( control ); done = TRUE; }
+        }
+        else
+        {
+            if (QI( target, IBorder, &border )) { IBorder_put_BorderBrush( border, brush ); IBorder_Release( border ); done = TRUE; }
+            else if (QI( target, IControl, &control )) { IControl_put_BorderBrush( control, brush ); IControl_Release( control ); done = TRUE; }
+        }
+        IBrush_Release( brush );
+    }
+    else if ((prop_is( prop, L"Margin" ) || prop_is( prop, L"Padding" ) || prop_is( prop, L"BorderThickness" )) && to_thickness( value, &t ))
+    {
+        if (prop_is( prop, L"Margin" ))
+        {
+            if (QI( target, IFrameworkElement, &fe )) { IFrameworkElement_put_Margin( fe, t ); IFrameworkElement_Release( fe ); done = TRUE; }
+        }
+        else if (prop_is( prop, L"Padding" ))
+        {
+            if (QI( target, ITextBlock, &tb )) { ITextBlock_put_Padding( tb, t ); ITextBlock_Release( tb ); done = TRUE; }
+            else if (QI( target, IBorder, &border )) { IBorder_put_Padding( border, t ); IBorder_Release( border ); done = TRUE; }
+            else if (QI( target, IControl, &control )) { IControl_put_Padding( control, t ); IControl_Release( control ); done = TRUE; }
+        }
+        else
+        {
+            if (QI( target, IBorder, &border )) { IBorder_put_BorderThickness( border, t ); IBorder_Release( border ); done = TRUE; }
+            else if (QI( target, IControl, &control )) { IControl_put_BorderThickness( control, t ); IControl_Release( control ); done = TRUE; }
+        }
+    }
+    else if (prop_is( prop, L"Height" ) || prop_is( prop, L"Width" ))
+    {
+        if (QI( target, IRowDefinition, &row ))
+        {
+            if (to_grid_length( value, &gl )) { IRowDefinition_put_Height( row, gl ); done = TRUE; }
+            IRowDefinition_Release( row );
+        }
+        else if (QI( target, IColumnDefinition, &column ))
+        {
+            if (to_grid_length( value, &gl )) { IColumnDefinition_put_Width( column, gl ); done = TRUE; }
+            IColumnDefinition_Release( column );
+        }
+        else if (to_double( value, &d ) && QI( target, IFrameworkElement, &fe ))
+        {
+            if (prop_is( prop, L"Height" )) IFrameworkElement_put_Height( fe, d );
+            else IFrameworkElement_put_Width( fe, d );
+            IFrameworkElement_Release( fe );
+            done = TRUE;
+        }
+    }
+    else if (prop_is( prop, L"HorizontalAlignment" ) && to_enum( value, horizontal_names, 4, &e ) && QI( target, IFrameworkElement, &fe ))
+    {
+        IFrameworkElement_put_HorizontalAlignment( fe, e );
+        IFrameworkElement_Release( fe );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"VerticalAlignment" ) && to_enum( value, vertical_names, 4, &e ) && QI( target, IFrameworkElement, &fe ))
+    {
+        IFrameworkElement_put_VerticalAlignment( fe, e );
+        IFrameworkElement_Release( fe );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"HorizontalContentAlignment" ) && to_enum( value, horizontal_names, 4, &e ) && QI( target, IControl, &control ))
+    {
+        IControl_put_HorizontalContentAlignment( control, e );
+        IControl_Release( control );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"VerticalContentAlignment" ) && to_enum( value, vertical_names, 4, &e ) && QI( target, IControl, &control ))
+    {
+        IControl_put_VerticalContentAlignment( control, e );
+        IControl_Release( control );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"Orientation" ) && to_enum( value, orientation_names, 2, &e ) && QI( target, IStackPanel, &sp ))
+    {
+        IStackPanel_put_Orientation( sp, e );
+        IStackPanel_Release( sp );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"Visibility" ) && to_enum( value, visibility_names, 2, &e ) && QI( target, IUIElement, &ui ))
+    {
+        IUIElement_put_Visibility( ui, e );
+        IUIElement_Release( ui );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"Opacity" ) && to_double( value, &d ) && QI( target, IUIElement, &ui ))
+    {
+        IUIElement_put_Opacity( ui, d );
+        IUIElement_Release( ui );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"IsHitTestVisible" ) && to_bool( value, &b ) && QI( target, IUIElement, &ui ))
+    {
+        IUIElement_put_IsHitTestVisible( ui, b );
+        IUIElement_Release( ui );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"TextWrapping" ) && to_enum( value, wrapping_names, 4, &e ) && QI( target, ITextBlock, &tb ))
+    {
+        ITextBlock_put_TextWrapping( tb, e );
+        ITextBlock_Release( tb );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"TextAlignment" ) && to_enum( value, alignment_names, 5, &e ) && QI( target, ITextBlock, &tb ))
+    {
+        ITextBlock_put_TextAlignment( tb, e );
+        ITextBlock_Release( tb );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"IsEnabled" ) && to_bool( value, &b ) && QI( target, IControl, &control ))
+    {
+        IControl_put_IsEnabled( control, b );
+        IControl_Release( control );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"ClickMode" ) && to_enum( value, click_mode_names, 3, &e ) && QI( target, IButtonBase, &bb ))
+    {
+        IButtonBase_put_ClickMode( bb, e );
+        IButtonBase_Release( bb );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"Color" ) && to_color( value, &color ) && QI( target, ISolidColorBrush, &solid ))
+    {
+        ISolidColorBrush_put_Color( solid, color );
+        ISolidColorBrush_Release( solid );
+        done = TRUE;
+    }
+    else if (prop_is( prop, L"Content" ))
+    {
+        content = to_content( value );
+        if (QI( target, IContentControl, &cc )) { IContentControl_put_Content( cc, content ); IContentControl_Release( cc ); done = TRUE; }
+        else if (QI( target, IUserControl, &uc ))
+        {
+            if (content && QI( content, IUIElement, &ui ))
+            {
+                IUserControl_put_Content( uc, ui );
+                IUIElement_Release( ui );
+                done = TRUE;
+            }
+            IUserControl_Release( uc );
+        }
+        if (content) IInspectable_Release( content );
+    }
+    else if (prop_is( prop, L"Child" ) && value->kind == XV_OBJECT && QI( target, IBorder, &border ))
+    {
+        if (value->object && QI( value->object, IUIElement, &ui ))
+        {
+            IBorder_put_Child( border, ui );
+            IUIElement_Release( ui );
+            done = TRUE;
+        }
+        IBorder_Release( border );
+    }
+    else if (prop_is( prop, L"RequestedTheme" ) && to_enum( value, theme_names, 2, &e ))
+    {
+        if (QI( target, IApplication, &app )) { IApplication_put_RequestedTheme( app, e ); IApplication_Release( app ); done = TRUE; }
+        else FIXME( "per-element RequestedTheme is not supported.\n" );
+        return S_OK;
+    }
+    else if (prop_is( prop, L"Resources" ) && value->kind == XV_OBJECT)
+    {
+        IResourceDictionary *dict = NULL;
+        if (value->object) IInspectable_QueryInterface( value->object, &IID_IResourceDictionary, (void **)&dict );
+        if (QI( target, IApplication, &app )) { IApplication_put_Resources( app, dict ); IApplication_Release( app ); done = TRUE; }
+        else if (QI( target, IFrameworkElement, &fe )) { IFrameworkElement_put_Resources( fe, dict ); IFrameworkElement_Release( fe ); done = TRUE; }
+        if (dict) IResourceDictionary_Release( dict );
+    }
+    if (done) return S_OK;
+
+unsupported:
+    FIXME( "setting %s.%s (value kind %d) on %p is not supported.\n", debugstr_w(prop->owner), debugstr_w(prop->name),
+           value->kind, target );
+    return S_OK;
+}
+
+/* PushScopeGetValue: the collection or dictionary a property holds, created on demand */
+static IInspectable *get_property( IInspectable *target, const struct xprop *prop )
+{
+    IInspectable *result = NULL;
+    IPanel *panel;
+    IGrid *grid;
+    IApplication *app;
+    IFrameworkElement *fe;
+    IResourceDictionary *dict = NULL;
+
+    if (!target) return NULL;
+    if (prop_is( prop, L"Children" ) && QI( target, IPanel, &panel ))
+    {
+        IPanel_get_Children( panel, (__FIVector_1_Windows__CUI__CXaml__CUIElement **)&result );
+        IPanel_Release( panel );
+    }
+    else if ((prop_is( prop, L"RowDefinitions" ) || prop_is( prop, L"ColumnDefinitions" )) && QI( target, IGrid, &grid ))
+    {
+        if (prop_is( prop, L"RowDefinitions" ))
+            IGrid_get_RowDefinitions( grid, (__FIVector_1_Windows__CUI__CXaml__CControls__CRowDefinition **)&result );
+        else
+            IGrid_get_ColumnDefinitions( grid, (__FIVector_1_Windows__CUI__CXaml__CControls__CColumnDefinition **)&result );
+        IGrid_Release( grid );
+    }
+    else if (prop_is( prop, L"Resources" ))
+    {
+        if (QI( target, IApplication, &app ))
+        {
+            IApplication_get_Resources( app, &dict );
+            IApplication_Release( app );
+        }
+        else if (QI( target, IFrameworkElement, &fe ))
+        {
+            IFrameworkElement_get_Resources( fe, &dict );
+            IFrameworkElement_Release( fe );
+        }
+        result = (IInspectable *)dict;
+    }
+    else FIXME( "getting %s.%s from %p is not supported.\n", debugstr_w(prop->owner), debugstr_w(prop->name), target );
+    return result;
+}
+
+/* find a resource: in dictionaries on the stack (innermost first), then the application's, then the theme's */
+static IInspectable *lookup_resource( struct writer *w, const WCHAR *key, BOOL theme )
+{
+    IInspectable *value = NULL, *dict;
+    int i;
+
+    for (i = w->sp - 1; i >= 0 && !value; i--)
+    {
+        if (w->stack[i].kind != XV_OBJECT || !w->stack[i].object) continue;
+        if ((dict = element_resources( w->stack[i].object ))) value = resource_dictionary_lookup( dict, key );
+        else value = resource_dictionary_lookup( w->stack[i].object, key );
+    }
+    if (!value && (dict = application_resources())) value = resource_dictionary_lookup( dict, key );
+    if (!value) value = theme_resource_lookup( key );
+    if (!value) WARN( "%s resource %s not found.\n", theme ? "theme" : "static", debugstr_w(key) );
+    return value;
+}
+
+IInspectable *create_builtin( const WCHAR *name )
+{
+    static const struct { const WCHAR *name; IActivationFactory **factory; } classes[] =
+    {
+        { L"Border", &border_factory },
+        { L"Button", &button_factory },
+        { L"ColumnDefinition", &column_definition_factory },
+        { L"Frame", &frame_factory },
+        { L"Grid", &grid_factory },
+        { L"Page", &page_factory },
+        { L"ResourceDictionary", &resource_dictionary_factory },
+        { L"RowDefinition", &row_definition_factory },
+        { L"SolidColorBrush", &solid_color_brush_factory },
+        { L"StackPanel", &stack_panel_factory },
+        { L"TextBlock", &text_block_factory },
+        { L"UserControl", &user_control_factory },
+    };
+    IInspectable *object;
+    UINT32 i;
+
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+    {
+        if (wcscmp( name, classes[i].name )) continue;
+        if (SUCCEEDED(IActivationFactory_ActivateInstance( *classes[i].factory, &object ))) return object;
+        break;
+    }
+    FIXME( "built-in type %s is not implemented.\n", debugstr_w(name) );
+    return NULL;
+}
+
+static IInspectable *create_type( struct writer *w, const struct xtype *type )
+{
+    WCHAR full[256];
+
+    if (!w->root_used && w->root)
+    {
+        /* the root element of LoadComponent's markup is the component itself */
+        w->root_used = TRUE;
+        IInspectable_AddRef( w->root );
+        TRACE( "root %s is the component %p.\n", debugstr_w(type->name), w->root );
+        return w->root;
+    }
+    w->root_used = TRUE;
+    if (type->directive) return NULL;   /* x:Null */
+    if (type->builtin) return create_builtin( type->name );
+    swprintf( full, ARRAY_SIZE(full), L"%s.%s", type->ns, type->name );
+    return app_create_instance( full );
+}
+
+static void run_stream( struct writer *w, UINT32 stream, UINT32 offset, BOOL single );
+
+static void add_to_collection( IInspectable *collection, struct xvalue *value )
+{
+    IVector_IInspectable *vector;
+
+    if (!collection || value->kind != XV_OBJECT || !value->object) return;
+    if (vector_is_ours( collection ))
+    {
+        vector = (IVector_IInspectable *)collection;
+        if (FAILED(IVector_IInspectable_Append( vector, value->object ))) WARN( "Append failed.\n" );
+        return;
+    }
+    FIXME( "adding to collection %p is not supported.\n", collection );
+}
+
+static void run_custom_data( struct writer *w, UINT32 stream, struct custom_data *data )
+{
+    IInspectable *target = top_object( w );
+    struct xvalue value;
+    struct writer *sub;
+    UINT32 i;
+
+    if (!(sub = calloc( 1, sizeof(*sub) ))) { w->failed = TRUE; return; }
+    switch (data->kind)
+    {
+    case 371: case 7: case 10: case 12:
+        TRACE( "resource dictionary with %u resources in stream %u.\n", data->resource_count, stream );
+        for (i = 0; i < data->resource_count; i++)
+        {
+            if (data->resources[i].implicit)
+            {
+                FIXME( "implicit (type-keyed) resource %s is not supported.\n", debugstr_w(data->resources[i].key) );
+                continue;
+            }
+            memset( sub, 0, sizeof(*sub) );
+            sub->xbf = w->xbf;
+            sub->root_used = TRUE;
+            sub->connector = w->connector;
+            /* resources may refer to earlier ones: the sub-writer sees this writer's stack, without owning it */
+            memcpy( sub->stack, w->stack, w->sp * sizeof(*w->stack) );
+            sub->sp = w->sp;
+            run_stream( sub, stream, data->resources[i].offset, TRUE );
+            if (sub->sp > w->sp)
+            {
+                pop( sub, &value );
+                if (value.kind == XV_OBJECT && value.object && target)
+                    resource_dictionary_insert( target, data->resources[i].key, value.object );
+                else if (value.kind != XV_OBJECT)
+                    FIXME( "resource %s isn't an object.\n", debugstr_w(data->resources[i].key) );
+                xvalue_clear( &value );
+            }
+            while (sub->sp > w->sp) { pop( sub, &value ); xvalue_clear( &value ); }
+        }
+        break;
+    case 745: case 6: case 9:
+        FIXME( "x:Load deferred elements are created immediately.\n" );
+        pop( w, &value );
+        xvalue_clear( &value );
+        sub->xbf = w->xbf;
+        sub->root_used = TRUE;
+        sub->connector = w->connector;
+        run_stream( sub, stream, 0, TRUE );
+        if (sub->sp) { pop( sub, &value ); push( w, &value ); }
+        while (sub->sp) { pop( sub, &value ); xvalue_clear( &value ); }
+        break;
+    default:
+        FIXME( "custom runtime data type %u (styles, visual states) is ignored.\n", data->kind );
+        break;
+    }
+    free( sub );
+}
+
+static void scope_push( struct writer *w, enum scope_kind kind )
+{
+    if (w->scope_count < MAX_STACK) w->scopes[w->scope_count++] = kind;
+    else w->failed = TRUE;
+}
+
+static BOOL scope_pop( struct writer *w )
+{
+    struct xvalue v;
+
+    if (!w->scope_count) return FALSE;
+    if (w->scopes[--w->scope_count] == SCOPE_GET_VALUE)
+    {
+        pop( w, &v );
+        xvalue_clear( &v );
+    }
+    return TRUE;
+}
+
+/* Run a node stream from offset. With single, stop after one complete object (a resource, a deferred element). */
+static void run_stream( struct writer *w, UINT32 stream, UINT32 offset, BOOL single )
+{
+    struct reader r = {0};
+    struct xvalue value, key;
+    struct xprop prop, prop2;
+    struct xtype type;
+    struct custom_data data;
+    IInspectable *object;
+    WCHAR *str;
+    BYTE node;
+    UINT32 sub, i, n;
+    int start_scopes = w->scope_count, start_sp = w->sp;
+
+    if (stream >= w->xbf->stream_count) { w->failed = TRUE; return; }
+    r.xbf = w->xbf;
+    r.start = w->xbf->streams[stream].start;
+    r.p = r.start + offset;
+    r.end = w->xbf->streams[stream].end;
+    if (r.p > r.end) { w->failed = TRUE; return; }
+
+    while (r.p < r.end && !r.error && !w->failed)
+    {
+        node = read_u8( &r );
+        switch (node)
+        {
+        case NODE_PUSH_SCOPE:
+            scope_push( w, SCOPE_PLAIN );
+            break;
+        case NODE_POP_SCOPE:
+        case NODE_END_INIT_POP_SCOPE:
+        case NODE_END_INIT_PROVIDE_VALUE_POP_SCOPE:
+            scope_pop( w );
+            break;
+        case NODE_ADD_NAMESPACE:
+        case NODE_PUSH_SCOPE_ADD_NAMESPACE:
+            read_u16( &r );
+            free( read_string( &r ) );
+            if (node == NODE_PUSH_SCOPE_ADD_NAMESPACE) scope_push( w, SCOPE_PLAIN );
+            break;
+        case NODE_PUSH_CONSTANT:
+            read_constant( &r, &value );
+            push( w, &value );
+            break;
+        case NODE_SET_VALUE:
+        case NODE_SET_VALUE_FROM_MARKUP_EXTENSION:
+            read_property( &r, &prop );
+            pop( w, &value );
+            if (node == NODE_SET_VALUE_FROM_MARKUP_EXTENSION && value.kind == XV_OBJECT && !value.object)
+                FIXME( "markup extension for %s.%s (Binding?) is not supported.\n", debugstr_w(prop.owner), debugstr_w(prop.name) );
+            else set_property( w, top_object( w ), &prop, &value );
+            xvalue_clear( &value );
+            break;
+        case NODE_ADD_TO_COLLECTION:
+            pop( w, &value );
+            add_to_collection( top_object( w ), &value );
+            xvalue_clear( &value );
+            break;
+        case NODE_ADD_TO_DICTIONARY:
+            pop( w, &value );
+            FIXME( "adding to a dictionary without a key (implicit styles) is not supported.\n" );
+            xvalue_clear( &value );
+            break;
+        case NODE_ADD_TO_DICTIONARY_WITH_KEY:
+            read_constant( &r, &key );
+            pop( w, &value );
+            if (key.kind == XV_STRING && value.kind == XV_OBJECT && value.object && top_object( w ))
+                resource_dictionary_insert( top_object( w ), key.s, value.object );
+            xvalue_clear( &key );
+            xvalue_clear( &value );
+            break;
+        case NODE_CHECK_PEER_TYPE:
+            str = read_string( &r );
+            TRACE( "x:Class %s.\n", debugstr_w(str) );
+            free( str );
+            break;
+        case NODE_SET_CONNECTION_ID:
+            read_constant( &r, &value );
+            if (w->connector && (object = top_object( w )))
+            {
+                INT32 id = value.kind == XV_SIGNED ? value.i : value.kind == XV_STRING ? wcstol( value.s, NULL, 10 ) : 0;
+                HRESULT hr;
+                TRACE( "connecting id %d to %p.\n", id, object );
+                if (FAILED(hr = IComponentConnector_Connect( w->connector, id, object )))
+                    WARN( "Connect(%d) failed, hr %#lx.\n", id, hr );
+            }
+            xvalue_clear( &value );
+            break;
+        case NODE_SET_NAME:
+            read_constant( &r, &value );
+            if (value.kind == XV_STRING && (object = top_object( w )))
+            {
+                prop.directive = FALSE;
+                lstrcpyW( prop.owner, L"FrameworkElement" );
+                lstrcpyW( prop.name, L"Name" );
+                set_property( w, object, &prop, &value );
+            }
+            xvalue_clear( &value );
+            break;
+        case NODE_GET_RESOURCE_PROPERTY_BAG:
+            read_constant( &r, &value );
+            FIXME( "x:Uid %s: localized resources (resources.pri) are not supported.\n",
+                   value.kind == XV_STRING ? debugstr_w(value.s) : "" );
+            xvalue_clear( &value );
+            break;
+        case NODE_SET_CUSTOM_RUNTIME_DATA:
+            sub = read_7bit( &r );
+            n = read_7bit( &r ) + read_7bit( &r );
+            for (i = 0; i < n; i++) read_u16( &r );
+            read_custom_data( &r, &data );
+            if (!r.error) run_custom_data( w, sub, &data );
+            free_custom_data( &data );
+            break;
+        case NODE_SET_DEFERRED_PROPERTY:
+            read_property( &r, &prop );
+            sub = read_7bit( &r );
+            n = read_7bit( &r ) + read_7bit( &r );
+            for (i = 0; i < n; i++) read_u16( &r );
+            FIXME( "deferred property %s.%s (templates) is not supported.\n", debugstr_w(prop.owner), debugstr_w(prop.name) );
+            break;
+        case NODE_PUSH_SCOPE_GET_VALUE:
+            read_property( &r, &prop );
+            scope_push( w, SCOPE_GET_VALUE );
+            push_object( w, get_property( top_object( w ), &prop ) );
+            break;
+        case NODE_PUSH_SCOPE_CREATE_TYPE:
+        case NODE_CREATE_TYPE:
+            read_type( &r, &type );
+            if (node == NODE_PUSH_SCOPE_CREATE_TYPE) scope_push( w, SCOPE_PLAIN );
+            TRACE( "create %s%s%s.\n", debugstr_w(type.ns), type.ns[0] ? "." : "", debugstr_w(type.name) );
+            push_object( w, create_type( w, &type ) );
+            break;
+        case NODE_PUSH_SCOPE_CREATE_TYPE_WITH_CONSTANT:
+        case NODE_CREATE_TYPE_WITH_CONSTANT:
+        case NODE_PUSH_SCOPE_CREATE_TYPE_WITH_CONVERTED_CONSTANT:
+        case NODE_CREATE_TYPE_WITH_CONVERTED_CONSTANT:
+            read_type( &r, &type );
+            read_constant( &r, &value );
+            if (node == NODE_PUSH_SCOPE_CREATE_TYPE_WITH_CONSTANT || node == NODE_PUSH_SCOPE_CREATE_TYPE_WITH_CONVERTED_CONSTANT)
+                scope_push( w, SCOPE_PLAIN );
+            w->root_used = TRUE;
+            convert_to_type( &type, &value );
+            push( w, &value );
+            break;
+        case NODE_SET_VALUE_CONSTANT:
+        case NODE_SET_VALUE_CONVERTED_CONSTANT:
+            read_property( &r, &prop );
+            read_constant( &r, &value );
+            set_property( w, top_object( w ), &prop, &value );
+            xvalue_clear( &value );
+            break;
+        case NODE_SET_VALUE_CONVERTED_RESOLVED_PROPERTY:
+        case NODE_SET_VALUE_FROM_TEMPLATE_BINDING:
+            read_property( &r, &prop );
+            read_property( &r, &prop2 );
+            FIXME( "%s.%s = property %s.%s (setters, template bindings) is not supported.\n", debugstr_w(prop.owner),
+                   debugstr_w(prop.name), debugstr_w(prop2.owner), debugstr_w(prop2.name) );
+            break;
+        case NODE_SET_VALUE_CONVERTED_RESOLVED_TYPE:
+            read_property( &r, &prop );
+            read_type( &r, &type );
+            FIXME( "%s.%s = type %s is not supported.\n", debugstr_w(prop.owner), debugstr_w(prop.name), debugstr_w(type.name) );
+            break;
+        case NODE_SET_VALUE_FROM_STATIC_RESOURCE:
+        case NODE_SET_VALUE_FROM_THEME_RESOURCE:
+            read_property( &r, &prop );
+            read_constant( &r, &key );
+            if (key.kind == XV_STRING && (object = lookup_resource( w, key.s, node == NODE_SET_VALUE_FROM_THEME_RESOURCE )))
+            {
+                value.kind = XV_OBJECT;
+                value.object = object;
+                set_property( w, top_object( w ), &prop, &value );
+                xvalue_clear( &value );
+            }
+            xvalue_clear( &key );
+            break;
+        case NODE_PROVIDE_STATIC_RESOURCE_VALUE:
+        case NODE_PROVIDE_THEME_RESOURCE_VALUE:
+            read_constant( &r, &key );
+            value.kind = XV_OBJECT;
+            value.object = key.kind == XV_STRING ? lookup_resource( w, key.s, node == NODE_PROVIDE_THEME_RESOURCE_VALUE ) : NULL;
+            push( w, &value );
+            xvalue_clear( &key );
+            break;
+        case NODE_BEGIN_CONDITIONAL_SCOPE:
+            read_u16( &r );
+            read_u16( &r );
+            FIXME( "conditional XAML is treated as unconditional.\n" );
+            break;
+        case NODE_END_CONDITIONAL_SCOPE:
+            break;
+        default:
+            WARN( "unknown node type %u at offset %Iu.\n", node, (SIZE_T)(r.p - r.start - 1) );
+            r.error = TRUE;
+            break;
+        }
+        /* one complete object: back at the starting scope depth with something new on the stack */
+        if (single && w->scope_count == start_scopes && w->sp > start_sp) return;
+    }
+    if (r.error)
+    {
+        WARN( "malformed node stream %u.\n", stream );
+        w->failed = TRUE;
+    }
+}
+
+/* Build the objects of an XBF file's main node stream. With root, the markup's root element is root itself
+ * (Application.LoadComponent); otherwise *out receives the root object. */
+HRESULT xbf_load( struct xbf *xbf, IInspectable *root, IInspectable **out )
+{
+    struct writer *w;
+    struct xvalue value;
+    HRESULT hr = S_OK;
+
+    if (out) *out = NULL;
+    if (!xbf->stream_count) return E_FAIL;
+    if (!(w = calloc( 1, sizeof(*w) ))) return E_OUTOFMEMORY;
+    w->xbf = xbf;
+    w->root = root;
+    if (root && FAILED(IInspectable_QueryInterface( root, &IID_IComponentConnector, (void **)&w->connector )))
+        w->connector = NULL;
+
+    run_stream( w, 0, 0, FALSE );
+    if (w->failed) hr = E_FAIL;
+    if (w->sp)
+    {
+        pop( w, &value );
+        if (out && value.kind == XV_OBJECT && value.object)
+        {
+            *out = value.object;
+            value.object = NULL;
+        }
+        xvalue_clear( &value );
+    }
+    while (w->sp) { pop( w, &value ); xvalue_clear( &value ); }
+    if (w->connector) IComponentConnector_Release( w->connector );
+    free( w );
+    return hr;
+}
+
+/* Application.LoadComponent: ms-appx:///Folder/Page.xaml is compiled to Folder\Page.xbf in the package folder,
+ * which for wine-uwp is the folder of the app's executable. */
+HRESULT load_component( IInspectable *component, HSTRING uri )
+{
+    const WCHAR *path = WindowsGetStringRawBuffer( uri, NULL ), *ext;
+    WCHAR file[MAX_PATH], *p;
+    struct xbf *xbf;
+    LARGE_INTEGER size;
+    HANDLE handle;
+    DWORD read;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!wcsnicmp( path, L"ms-appx://", 10 ))
+    {
+        path += 10;
+        if (*path != '/') path = wcschr( path, '/' );   /* ms-appx://package-name/... */
+        if (!path) return E_INVALIDARG;
+        while (*path == '/') path++;
+    }
+    else if (!wcsnicmp( path, L"ms-appx-web:", 12 ) || wcschr( path, ':' ))
+    {
+        FIXME( "unsupported component URI %s.\n", debugstr_w(path) );
+        return E_INVALIDARG;
+    }
+
+    GetModuleFileNameW( NULL, file, ARRAY_SIZE(file) );
+    if ((p = wcsrchr( file, '\\' ))) p[1] = 0;
+    if (wcslen( file ) + wcslen( path ) + 5 >= ARRAY_SIZE(file)) return E_INVALIDARG;
+    p = file + wcslen( file );
+    lstrcpyW( p, path );
+    for (; *p; p++) if (*p == '/') *p = '\\';
+    if ((ext = wcsrchr( file, '.' )) && !wcsicmp( ext, L".xaml" )) lstrcpyW( (WCHAR *)ext, L".xbf" );
+
+    handle = CreateFileW( file, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (handle == INVALID_HANDLE_VALUE)
+    {
+        ERR( "cannot open %s for %s: text XAML is not supported, only compiled .xbf.\n", debugstr_w(file), debugstr_hstring(uri) );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    if (!GetFileSizeEx( handle, &size ) || size.QuadPart > 64 * 1024 * 1024 || !(data = malloc( size.QuadPart )))
+    {
+        CloseHandle( handle );
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile( handle, data, size.QuadPart, &read, NULL ) || read != size.QuadPart)
+    {
+        CloseHandle( handle );
+        free( data );
+        return E_FAIL;
+    }
+    CloseHandle( handle );
+    TRACE( "loading %s (%Iu bytes) into %p.\n", debugstr_w(file), (SIZE_T)size.QuadPart, component );
+
+    if (FAILED(hr = xbf_parse( data, size.QuadPart, &xbf ))) return hr;
+    hr = xbf_load( xbf, component, NULL );
+    xbf_free( xbf );
+    if (FAILED(hr)) ERR( "loading %s failed, hr %#lx.\n", debugstr_w(file), hr );
+    return hr;
+}
