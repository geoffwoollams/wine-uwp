+/* TypedEventHandler<ContentDialog, args>: the same Invoke for each */
+static BOOL raise_dialog_event( struct dialog_state *dialog, struct event_list *list, struct dialog_args *args,
+                                IInspectable *args_iface, const char *name )
+{
+    IUnknown **handlers;
+    UINT32 i, count = list->count;
+    HRESULT hr;
+
+    TRACE( "%p: %s, %u handler slots.\n", dialog, name, count );
+    if (!count || !(handlers = calloc( count, sizeof(*handlers) ))) return args && args->cancel;
+    for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+    for (i = 0; i < count; i++)
+    {
+        if (!handlers[i]) continue;
+        hr = ITypedEventHandler_IInspectable_IInspectable_Invoke( (ITypedEventHandler_IInspectable_IInspectable *)handlers[i],
+                                                                  dialog->button->element.outer, args_iface );
+        if (FAILED(hr)) WARN( "%s handler %p failed, hr %#lx.\n", name, handlers[i], hr );
+    }
+    for (i = 0; i < count; i++) if (handlers[i]) IUnknown_Release( handlers[i] );
+    free( handlers );
+    return args && args->cancel;
+}
