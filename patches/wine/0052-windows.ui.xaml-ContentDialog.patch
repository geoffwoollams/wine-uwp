+HRESULT dialog_init( struct button *impl )
+{
+    struct dialog_state *dialog;
+
+    if (!(dialog = calloc( 1, sizeof(*dialog) ))) return E_OUTOFMEMORY;
+    dialog->IContentDialog_iface.lpVtbl = &dialog_vtbl;
+    dialog->IContentDialog2_iface.lpVtbl = &dialog2_vtbl;
+    dialog->IContentDialog3_iface.lpVtbl = &dialog3_vtbl;
+    dialog->button = impl;
+    dialog->enabled[PART_PRIMARY] = dialog->enabled[PART_SECONDARY] = dialog->enabled[PART_CLOSE] = TRUE;
+    impl->dialog = dialog;
+    impl->element.is_tab_stop = FALSE;
+    return S_OK;
+}
+
+void *dialog_default_iface( struct button *impl )
+{
+    return &impl->dialog->IContentDialog_iface;
+}
+
+HRESULT dialog_query_interface( struct button *impl, REFIID iid, void **out )
+{
+    struct dialog_state *dialog = impl->dialog;
+
+    if (IsEqualGUID( iid, &IID_IContentDialog )) *out = &dialog->IContentDialog_iface;
+    else if (IsEqualGUID( iid, &IID_IContentDialog2 )) *out = &dialog->IContentDialog2_iface;
+    else if (IsEqualGUID( iid, &IID_IContentDialog3 )) *out = &dialog->IContentDialog3_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+void dialog_destroy( struct button *impl )
+{
+    struct dialog_state *dialog = impl->dialog;
+    int i;
+
+    if (!dialog) return;
+    if (shown_dialog == dialog) shown_dialog = NULL;
+    free_layer( dialog );
+    if (dialog->previous_focus) IUIElement_Release( &dialog->previous_focus->IUIElement_iface );
+    if (dialog->title) IInspectable_Release( dialog->title );
+    if (dialog->title_template) IDataTemplate_Release( dialog->title_template );
+    for (i = 0; i < 3; i++)
+    {
+        WindowsDeleteString( dialog->texts[i] );
+        if (dialog->commands[i]) IInspectable_Release( dialog->commands[i] );
+        if (dialog->parameters[i]) IInspectable_Release( dialog->parameters[i] );
+        if (dialog->styles[i]) IInspectable_Release( dialog->styles[i] );
+        event_list_clear( &dialog->clicks[i] );
+    }
+    event_list_clear( &dialog->closing );
+    event_list_clear( &dialog->closed );
+    event_list_clear( &dialog->opened );
+    free( dialog );
+    impl->dialog = NULL;
+}
+
+/* ContentDialog properties set from markup; value is the text, or NULL for number */
+BOOL dialog_set_markup( IInspectable *object, const WCHAR *name, const WCHAR *value, double number )
+{
+    struct xaml_element *element = element_from_object( object );
+    struct dialog_state *dialog;
+    struct button *impl;
+    HSTRING str;
+    int part = -1;
+
+    if (!element || !element->class_name || wcscmp( element->class_name, RuntimeClass_Windows_UI_Xaml_Controls_ContentDialog ))
+        return FALSE;
+    impl = CONTAINING_RECORD( element, struct button, element );
+    if (!(dialog = impl->dialog)) return FALSE;
+    if (!wcscmp( name, L"PrimaryButtonText" )) part = PART_PRIMARY;
+    else if (!wcscmp( name, L"SecondaryButtonText" )) part = PART_SECONDARY;
+    else if (!wcscmp( name, L"CloseButtonText" )) part = PART_CLOSE;
+    if (part >= 0)
+    {
+        if (!value || FAILED(WindowsCreateString( value, wcslen( value ), &str ))) return FALSE;
+        WindowsDeleteString( dialog->texts[part] );
+        dialog->texts[part] = str;
+        return TRUE;
+    }
+    if (!wcscmp( name, L"DefaultButton" ))
+    {
+        if (!value) dialog->default_button = number;
+        else if (!wcsicmp( value, L"Primary" )) dialog->default_button = ContentDialogButton_Primary;
+        else if (!wcsicmp( value, L"Secondary" )) dialog->default_button = ContentDialogButton_Secondary;
+        else if (!wcsicmp( value, L"Close" )) dialog->default_button = ContentDialogButton_Close;
+        else dialog->default_button = ContentDialogButton_None;
+        return TRUE;
+    }
+    if (!wcscmp( name, L"IsPrimaryButtonEnabled" ) || !wcscmp( name, L"IsSecondaryButtonEnabled" ))
+    {
+        dialog->enabled[name[2] == 'P' ? PART_PRIMARY : PART_SECONDARY] = value ? !wcsicmp( value, L"True" ) : number != 0;
+        return TRUE;
+    }
+    if (!wcscmp( name, L"FullSizeDesired" ))
+    {
+        dialog->full_size = value ? !wcsicmp( value, L"True" ) : number != 0;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* ContentDialog.Title from markup: text or an object */
+BOOL dialog_set_title( IInspectable *object, IInspectable *title )
+{
+    struct xaml_element *element = element_from_object( object );
+    struct button *impl;
+
+    if (!element || !element->class_name || wcscmp( element->class_name, RuntimeClass_Windows_UI_Xaml_Controls_ContentDialog ))
+        return FALSE;
+    impl = CONTAINING_RECORD( element, struct button, element );
+    if (!impl->dialog) return FALSE;
+    set_object( &impl->dialog->title, title );
+    return TRUE;
+}
