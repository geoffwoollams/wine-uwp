+
+#include <math.h>
+
+#include "private.h"
+#include "control.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A ContentDialog is a ContentControl (struct button, kind BUTTON_DIALOG) that shows nothing where it is. ShowAsync
+ * puts a layer over the window (window_popup_show): a translucent smoke over the page, and in the middle Windows
+ * 10's dialog box, 320 to 548 px wide with 24 px padding, the Title (20 px text) above the Content and a row of up
+ * to three equal buttons (Primary, Secondary, Close) below. The layer is modal: the page gets no pointer or
+ * keyboard input while it shows. Escape is the Close button, Enter the DefaultButton (drawn in the accent colour).
+ * A button raises its Click event (which may Cancel), then Closing (which may Cancel), then the dialog hides,
+ * raises Closed and completes ShowAsync's operation with the result. Hide closes with None. Deferrals complete at
+ * once; commands, FullSizeDesired, placement and button styles are not supported, and the content doesn't scroll. */
+
+#define DIALOG_MIN_WIDTH 320.0f
+#define DIALOG_MAX_WIDTH 548.0f
+#define DIALOG_PADDING 24.0f
+#define DIALOG_BUTTON_HEIGHT 32.0f
+#define DIALOG_BUTTON_GAP 8.0f
+
+enum dialog_part { PART_PRIMARY, PART_SECONDARY, PART_CLOSE };
+
+struct dialog_click_handler
+{
+    IRoutedEventHandler IRoutedEventHandler_iface;
+    struct dialog_state *dialog;
+    enum dialog_part part;
+};
+
+struct dialog_layer
+{
+    struct xaml_element element;
+    struct dialog_state *dialog;
+    struct layout_rect box;
+};
+
+struct dialog_state
+{
+    IContentDialog IContentDialog_iface;
+    IContentDialog2 IContentDialog2_iface;
+    IContentDialog3 IContentDialog3_iface;
+    struct button *button;
+
+    IInspectable *title;
+    IDataTemplate *title_template;
+    HSTRING texts[3];                     /* PrimaryButtonText, SecondaryButtonText, CloseButtonText */
+    boolean enabled[3];                   /* IsPrimaryButtonEnabled, IsSecondaryButtonEnabled; Close always */
+    IInspectable *commands[3], *parameters[3], *styles[3];
+    ContentDialogButton default_button;
+    boolean full_size;
+    struct event_list closing, closed, opened, clicks[3];
+
+    /* while shown */
+    BOOL open;
+    struct dialog_layer *layer;           /* referenced through layer_object */
+    IInspectable *layer_object;
+    IInspectable *title_object, *text_object;   /* TextBlocks we made for a text Title or Content */
+    struct xaml_element *title_element, *content_element, *buttons[3];
+    IInspectable *button_objects[3];
+    struct dialog_click_handler handlers[3];
+    struct xaml_element *previous_focus;  /* referenced */
+    struct dialog_async *async;
+};
+
+/* ---- ShowAsync's operation ---- */
+
+struct dialog_async
+{
+    IAsyncOperation_ContentDialogResult IAsyncOperation_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    AsyncStatus status;
+    ContentDialogResult result;
+    IAsyncOperationCompletedHandler_ContentDialogResult *handler;
+    BOOL handler_called;
+};
+
+static inline struct dialog_async *async_from_IAsyncOperation( IAsyncOperation_ContentDialogResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct dialog_async, IAsyncOperation_iface );
+}
+
+static HRESULT WINAPI async_QueryInterface( IAsyncOperation_ContentDialogResult *iface, REFIID iid, void **out )
+{
+    struct dialog_async *impl = async_from_IAsyncOperation( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperation_ContentDialogResult ))
+        *out = &impl->IAsyncOperation_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI async_AddRef( IAsyncOperation_ContentDialogResult *iface )
+{
+    return InterlockedIncrement( &async_from_IAsyncOperation( iface )->ref );
+}
+
+static ULONG WINAPI async_Release( IAsyncOperation_ContentDialogResult *iface )
+{
+    struct dialog_async *impl = async_from_IAsyncOperation( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncOperationCompletedHandler_ContentDialogResult_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI async_GetIids( IAsyncOperation_ContentDialogResult *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI async_GetRuntimeClassName( IAsyncOperation_ContentDialogResult *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.IAsyncOperation`1<Windows.UI.Xaml.Controls.ContentDialogResult>";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI async_GetTrustLevel( IAsyncOperation_ContentDialogResult *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static void async_call_handler( struct dialog_async *impl )
+{
+    IAsyncOperationCompletedHandler_ContentDialogResult *handler = impl->handler;
+    HRESULT hr;
+
+    if (!handler || impl->handler_called || impl->status == Started) return;
+    impl->handler_called = TRUE;
+    IAsyncOperationCompletedHandler_ContentDialogResult_AddRef( handler );
+    hr = IAsyncOperationCompletedHandler_ContentDialogResult_Invoke( handler, &impl->IAsyncOperation_iface, impl->status );
+    if (FAILED(hr)) WARN( "Completed handler %p failed, hr %#lx.\n", handler, hr );
+    IAsyncOperationCompletedHandler_ContentDialogResult_Release( handler );
+}
+
+static HRESULT WINAPI async_put_Completed( IAsyncOperation_ContentDialogResult *iface,
+                                           IAsyncOperationCompletedHandler_ContentDialogResult *handler )
+{
+    struct dialog_async *impl = async_from_IAsyncOperation( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return E_POINTER;
+    IAsyncOperationCompletedHandler_ContentDialogResult_AddRef( (impl->handler = handler) );
+    async_call_handler( impl );   /* at once if it has finished */
+    return S_OK;
+}
+
+static HRESULT WINAPI async_get_Completed( IAsyncOperation_ContentDialogResult *iface,
+                                           IAsyncOperationCompletedHandler_ContentDialogResult **handler )
+{
+    struct dialog_async *impl = async_from_IAsyncOperation( iface );
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_ContentDialogResult_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_GetResults( IAsyncOperation_ContentDialogResult *iface, ContentDialogResult *result )
+{
+    struct dialog_async *impl = async_from_IAsyncOperation( iface );
+
+    if (impl->status != Completed) return E_ILLEGAL_METHOD_CALL;
+    *result = impl->result;
+    return S_OK;
+}
+
+static const struct IAsyncOperation_ContentDialogResultVtbl async_vtbl =
+{
+    async_QueryInterface,
+    async_AddRef,
+    async_Release,
+    /* IInspectable methods */
+    async_GetIids,
+    async_GetRuntimeClassName,
+    async_GetTrustLevel,
+    /* IAsyncOperation<ContentDialogResult> methods */
+    async_put_Completed,
+    async_get_Completed,
+    async_GetResults,
+};
+
+DEFINE_IINSPECTABLE( async_info, IAsyncInfo, struct dialog_async, IAsyncOperation_iface )
+
+static HRESULT WINAPI async_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    *status = impl_from_IAsyncInfo( iface )->status;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )
+{
+    *error = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Cancel( IAsyncInfo *iface )
+{
+    FIXME( "iface %p: a shown ContentDialog can't be cancelled; Hide it.\n", iface );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Close( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static const struct IAsyncInfoVtbl async_info_vtbl =
+{
+    async_info_QueryInterface,
+    async_info_AddRef,
+    async_info_Release,
+    /* IInspectable methods */
+    async_info_GetIids,
+    async_info_GetRuntimeClassName,
+    async_info_GetTrustLevel,
+    /* IAsyncInfo methods */
+    async_info_get_Id,
+    async_info_get_Status,
+    async_info_get_ErrorCode,
+    async_info_Cancel,
+    async_info_Close,
+};
+
+static struct dialog_async *async_create(void)
+{
+    struct dialog_async *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IAsyncOperation_iface.lpVtbl = &async_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &async_info_vtbl;
+    impl->ref = 1;
+    impl->status = Started;
+    return impl;
+}
+
+/* ---- event arguments and deferrals ---- */
+
+struct dialog_args
+{
+    IContentDialogButtonClickEventArgs IButtonClick_iface;
+    IContentDialogClosingEventArgs IClosing_iface;
+    IContentDialogClosedEventArgs IClosed_iface;
+    IContentDialogOpenedEventArgs IOpened_iface;
+    IContentDialogButtonClickDeferral IClickDeferral_iface;
+    IContentDialogClosingDeferral IClosingDeferral_iface;
+    LONG ref;
+    const IID *iid;                       /* which arguments these are */
+    ContentDialogResult result;
+    boolean cancel;
+};
+
+static HRESULT args_query( struct dialog_args *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, impl->iid ))
+    {
+        if (impl->iid == &IID_IContentDialogButtonClickEventArgs) *out = &impl->IButtonClick_iface;
+        else if (impl->iid == &IID_IContentDialogClosingEventArgs) *out = &impl->IClosing_iface;
+        else if (impl->iid == &IID_IContentDialogClosedEventArgs) *out = &impl->IClosed_iface;
+        else if (impl->iid == &IID_IContentDialogOpenedEventArgs) *out = &impl->IOpened_iface;
+        else if (impl->iid == &IID_IContentDialogButtonClickDeferral) *out = &impl->IClickDeferral_iface;
+        else *out = &impl->IClosingDeferral_iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG args_release( struct dialog_args *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static struct dialog_args *args_create( const IID *iid, ContentDialogResult result );
+
+#define ARGS_IUNKNOWN( pfx, Iface, field ) \
+static inline struct dialog_args *pfx##_impl( Iface *iface ) { return CONTAINING_RECORD( iface, struct dialog_args, field ); } \
+static HRESULT WINAPI pfx##_QueryInterface( Iface *iface, REFIID iid, void **out ) { return args_query( pfx##_impl( iface ), iid, out ); } \
+static ULONG WINAPI pfx##_AddRef( Iface *iface ) { return InterlockedIncrement( &pfx##_impl( iface )->ref ); } \
