+/* ---- the layer over the window ---- */
+
+static inline struct dialog_layer *layer_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct dialog_layer, element );
+}
+
+static UINT32 layer_parts( struct dialog_state *dialog, struct xaml_element **parts )
+{
+    UINT32 n = 0, i;
+
+    if (dialog->title_element) parts[n++] = dialog->title_element;
+    if (dialog->content_element) parts[n++] = dialog->content_element;
+    for (i = 0; i < 3; i++) if (dialog->buttons[i]) parts[n++] = dialog->buttons[i];
+    return n;
+}
+
+static UINT32 button_count( struct dialog_state *dialog )
+{
+    UINT32 i, n = 0;
+    for (i = 0; i < 3; i++) if (dialog->buttons[i]) n++;
+    return n;
+}
+
+static void layer_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                           float avail_height, float *width, float *height )
+{
+    struct dialog_state *dialog = layer_from_element( element )->dialog;
+    float inner = DIALOG_MAX_WIDTH - 2 * DIALOG_PADDING;
+    UINT32 i;
+
+    *width = isfinite( avail_width ) ? avail_width : 0;
+    *height = isfinite( avail_height ) ? avail_height : 0;
+    if (!dialog) return;
+    if (dialog->title_element) element_measure( dialog->title_element, ctx, inner, INFINITY );
+    if (dialog->content_element) element_measure( dialog->content_element, ctx, inner, INFINITY );
+    for (i = 0; i < 3; i++) if (dialog->buttons[i]) element_measure( dialog->buttons[i], ctx, inner, DIALOG_BUTTON_HEIGHT );
+}
+
+static void layer_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct dialog_layer *layer = layer_from_element( element );
+    struct dialog_state *dialog = layer->dialog;
+    const struct layout_rect *b = &element->bounds;
+    float inner_w = 0, title_h = 0, content_h = 0, h, y, x, w;
+    UINT32 i, n;
+
+    if (!dialog) return;
+    n = button_count( dialog );
+    if (dialog->title_element) inner_w = max( inner_w, dialog->title_element->desired_width );
+    if (dialog->content_element) inner_w = max( inner_w, dialog->content_element->desired_width );
+    for (i = 0, w = 0; i < 3; i++) if (dialog->buttons[i]) w += dialog->buttons[i]->desired_width;
+    inner_w = max( inner_w, w + (n ? (n - 1) * DIALOG_BUTTON_GAP : 0) );
+    inner_w = min( max( inner_w, DIALOG_MIN_WIDTH - 2 * DIALOG_PADDING ), DIALOG_MAX_WIDTH - 2 * DIALOG_PADDING );
+    inner_w = min( inner_w, max( 0.0f, b->width - 2 * DIALOG_PADDING ) );
+    if (dialog->title_element) title_h = dialog->title_element->desired_height;
+    if (dialog->content_element) content_h = dialog->content_element->desired_height;
+
+    h = 2 * DIALOG_PADDING + title_h + (title_h && content_h ? 12 : 0) + content_h + (n ? DIALOG_PADDING + DIALOG_BUTTON_HEIGHT : 0);
+    layer->box.width = inner_w + 2 * DIALOG_PADDING;
+    layer->box.height = min( h, b->height );
+    layer->box.x = b->x + (b->width - layer->box.width) / 2;
+    layer->box.y = b->y + (b->height - layer->box.height) / 2;
+
+    x = layer->box.x + DIALOG_PADDING;
+    y = layer->box.y + DIALOG_PADDING;
+    if (dialog->title_element)
+    {
+        element_arrange( dialog->title_element, ctx, x, y, inner_w, title_h );
+        y += title_h + (content_h ? 12 : 0);
+    }
+    if (dialog->content_element)
+    {
+        /* what doesn't fit above the buttons is cut off */
+        float room = layer->box.y + layer->box.height - DIALOG_PADDING - (n ? DIALOG_PADDING + DIALOG_BUTTON_HEIGHT : 0) - y;
+        element_arrange( dialog->content_element, ctx, x, y, inner_w, max( 0.0f, min( content_h, room ) ) );
+    }
+    if (n)
+    {
+        w = (inner_w - (n - 1) * DIALOG_BUTTON_GAP) / n;
+        y = layer->box.y + layer->box.height - DIALOG_PADDING - DIALOG_BUTTON_HEIGHT;
+        for (i = 0; i < 3; i++)
+        {
+            if (!dialog->buttons[i]) continue;
+            element_arrange( dialog->buttons[i], ctx, x, y, w, DIALOG_BUTTON_HEIGHT );
+            x += w + DIALOG_BUTTON_GAP;
+        }
+    }
+}
+
+static void layer_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct dialog_layer *layer = layer_from_element( element );
+    struct xaml_element *parts[5];
+    Color smoke = { 0x99, 0xff, 0xff, 0xff }, background = { 0xff, 0xff, 0xff, 0xff }, accent = { 0xff, 0x00, 0x78, 0xd7 };
+    static const Thickness one = { 1, 1, 1, 1 };
+    COLORREF saved = ctx->foreground;
+    UINT32 i, n;
+
+    if (!layer->dialog) return;
+    if (ctx->dark)
+    {
+        smoke.R = smoke.G = smoke.B = 0;
+        background.R = background.G = background.B = 0x2b;
+    }
+    /* SystemControlPageBackgroundMediumAltMediumBrush over the page, then the box with its accent border */
+    element_fill_argb( ctx, &element->bounds, smoke );
+    element_fill_argb( ctx, &layer->box, background );
+    element_frame_color( ctx, &layer->box, &one, RGB( accent.R, accent.G, accent.B ) );
+    ctx->foreground = ctx->dark ? RGB(255, 255, 255) : RGB(0, 0, 0);
+    ctx->foreground_alpha = 255;
+    if (ctx->rt) d2d_push_clip( ctx, &layer->box );
+    n = layer_parts( layer->dialog, parts );
+    for (i = 0; i < n; i++) element_render( parts[i], ctx );
+    if (ctx->rt) d2d_pop_clip( ctx );
+    ctx->foreground = saved;
+}
+
+static UINT32 layer_child_count( struct xaml_element *element )
+{
+    struct xaml_element *parts[5];
+    struct dialog_layer *layer = layer_from_element( element );
+    return layer->dialog ? layer_parts( layer->dialog, parts ) : 0;
+}
+
+static struct xaml_element *layer_child_at( struct xaml_element *element, UINT32 index )
+{
+    struct xaml_element *parts[5];
+    struct dialog_layer *layer = layer_from_element( element );
+    UINT32 n = layer->dialog ? layer_parts( layer->dialog, parts ) : 0;
+    return index < n ? parts[index] : NULL;
+}
+
+/* the whole window: the page underneath gets no input */
+static BOOL layer_hit_self( struct xaml_element *element, float x, float y )
+{
+    return TRUE;
+}
+
+static void dialog_part_clicked( struct dialog_state *dialog, enum dialog_part part );
+
+static BOOL layer_key( struct xaml_element *element, BOOL down, WPARAM vk )
+{
+    struct dialog_state *dialog = layer_from_element( element )->dialog;
+
+    if (!dialog || !down) return FALSE;
+    if (vk == VK_ESCAPE)
+    {
+        dialog_part_clicked( dialog, PART_CLOSE );
+        return TRUE;
+    }
+    if (vk == VK_RETURN && dialog->default_button != ContentDialogButton_None)
+    {
+        enum dialog_part part = dialog->default_button - ContentDialogButton_Primary;
+        if (dialog->buttons[part] && dialog->enabled[part]) dialog_part_clicked( dialog, part );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void layer_destroy( struct xaml_element *element )
+{
+    free( layer_from_element( element ) );
+}
+
+static const struct element_ops layer_ops =
+{
+    .measure = layer_measure,
+    .arrange = layer_arrange,
+    .render = layer_render,
+    .child_count = layer_child_count,
+    .child_at = layer_child_at,
+    .hit_self = layer_hit_self,
+    .key = layer_key,
+    .destroy = layer_destroy,
+};
+
+/* ---- showing and closing ---- */
+
+static inline struct dialog_click_handler *handler_from_iface( IRoutedEventHandler *iface )
+{
+    return CONTAINING_RECORD( iface, struct dialog_click_handler, IRoutedEventHandler_iface );
+}
+
+static HRESULT WINAPI part_click_QueryInterface( IRoutedEventHandler *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IRoutedEventHandler ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI part_click_AddRef( IRoutedEventHandler *iface ) { return 2; }
+static ULONG WINAPI part_click_Release( IRoutedEventHandler *iface ) { return 1; }
+
+static HRESULT WINAPI part_click_Invoke( IRoutedEventHandler *iface, IInspectable *sender, IRoutedEventArgs *args )
+{
+    struct dialog_click_handler *handler = handler_from_iface( iface );
+    if (handler->dialog && handler->dialog->open) dialog_part_clicked( handler->dialog, handler->part );
+    return S_OK;
+}
+
+static const struct IRoutedEventHandlerVtbl part_click_vtbl =
+{
+    part_click_QueryInterface,
+    part_click_AddRef,
+    part_click_Release,
+    part_click_Invoke,
+};
+
+static IInspectable *make_text_block( const WCHAR *text, UINT32 len, double size, BOOL wrap )
+{
+    IInspectable *object;
+    ITextBlock *tb;
+    HSTRING str;
+
+    if (FAILED(IActivationFactory_ActivateInstance( text_block_factory, &object ))) return NULL;
+    if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_ITextBlock, (void **)&tb )))
+    {
+        if (SUCCEEDED(WindowsCreateString( text, len, &str )))
+        {
+            ITextBlock_put_Text( tb, str );
+            WindowsDeleteString( str );
+        }
+        if (size) ITextBlock_put_FontSize( tb, size );
+        if (wrap) ITextBlock_put_TextWrapping( tb, TextWrapping_Wrap );
+        ITextBlock_Release( tb );
+    }
+    return object;
+}
+
+static IBrush *solid_brush( Color color )
+{
+    ISolidColorBrushFactory *factory;
+    ISolidColorBrush *brush = NULL;
+    IBrush *out = NULL;
+
+    if (FAILED(IActivationFactory_QueryInterface( solid_color_brush_factory, &IID_ISolidColorBrushFactory, (void **)&factory )))
+        return NULL;
+    ISolidColorBrushFactory_CreateInstanceWithColor( factory, color, &brush );
+    ISolidColorBrushFactory_Release( factory );
+    if (brush)
+    {
+        ISolidColorBrush_QueryInterface( brush, &IID_IBrush, (void **)&out );
+        ISolidColorBrush_Release( brush );
+    }
+    return out;
+}
+
+static void create_button( struct dialog_state *dialog, enum dialog_part part )
+{
+    IInspectable *object, *text;
+    IContentControl *cc;
+    IButtonBase *base;
+    IFrameworkElement *fe;
+    IControl *control;
+    struct xaml_element *element;
+    EventRegistrationToken token;
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( dialog->texts[part], &len );
+
+    if (!len || FAILED(IActivationFactory_ActivateInstance( button_factory, &object ))) return;
+    if ((text = make_text_block( str, len, 0, FALSE )))
+    {
+        if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IContentControl, (void **)&cc )))
+        {
+            IContentControl_put_Content( cc, text );
+            IContentControl_Release( cc );
+        }
+        IInspectable_Release( text );
+    }
+    if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IFrameworkElement, (void **)&fe )))
+    {
+        IFrameworkElement_put_HorizontalAlignment( fe, HorizontalAlignment_Stretch );
+        IFrameworkElement_put_VerticalAlignment( fe, VerticalAlignment_Stretch );
+        IFrameworkElement_Release( fe );
+    }
+    /* set like local values, so that the default Button style doesn't replace them */
+    if ((element = element_from_object( object )))
+    {
+        element_mark_local( element, L"HorizontalAlignment" );
+        element_mark_local( element, L"VerticalAlignment" );
+        if (dialog->default_button == part + ContentDialogButton_Primary)
+        {
+            element_mark_local( element, L"Background" );
+            element_mark_local( element, L"Foreground" );
+        }
+    }
+    if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IControl, (void **)&control )))
+    {
+        if (part != PART_CLOSE) IControl_put_IsEnabled( control, dialog->enabled[part] );
+        if (dialog->default_button == part + ContentDialogButton_Primary)
+        {
+            /* AccentButtonStyle */
+            Color accent = { 0xff, 0x00, 0x78, 0xd7 }, white = { 0xff, 0xff, 0xff, 0xff };
+            IBrush *brush;
+            if ((brush = solid_brush( accent )))
+            {
+                IControl_put_Background( control, brush );
+                IBrush_Release( brush );
+            }
+            if ((brush = solid_brush( white )))
+            {
+                IControl_put_Foreground( control, brush );
+                IBrush_Release( brush );
+            }
+        }
+        IControl_Release( control );
+    }
+    dialog->handlers[part].IRoutedEventHandler_iface.lpVtbl = &part_click_vtbl;
+    dialog->handlers[part].dialog = dialog;
+    dialog->handlers[part].part = part;
+    if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IButtonBase, (void **)&base )))
+    {
+        IButtonBase_add_Click( base, &dialog->handlers[part].IRoutedEventHandler_iface, &token );
+        IButtonBase_Release( base );
+    }
+    dialog->button_objects[part] = object;
+    if ((dialog->buttons[part] = element_from_object( object ))) element_set_parent( dialog->buttons[part], &dialog->layer->element );
+}
+
+/* the parts of the dialog box go in the layer */
+static BOOL build_layer( struct dialog_state *dialog )
+{
+    struct button *button = dialog->button;
+    struct dialog_layer *layer;
+    struct xaml_element *element;
+    HSTRING text;
+    UINT32 len;
+    int i;
+
+    if (!(layer = calloc( 1, sizeof(*layer) ))) return FALSE;
+    element_init( &layer->element, &layer_ops, L"Windows.UI.Xaml.Controls.ContentDialog (layer)", NULL );
+    layer->dialog = dialog;
+    if (FAILED(element_compose( &layer->element, NULL, NULL, &layer->element.IInspectable_inner, (void **)&dialog->layer_object )))
+        return FALSE;
+    dialog->layer = layer;
+
+    /* the Title: a UIElement, or text */
+    if (dialog->title && (element = element_from_object( dialog->title )) && !element->parent)
+        dialog->title_element = element;
+    else if (dialog->title && (text = object_to_text( dialog->title )))
+    {
+        const WCHAR *str = WindowsGetStringRawBuffer( text, &len );
+        if ((dialog->title_object = make_text_block( str, len, 20.0, TRUE )))
+            dialog->title_element = element_from_object( dialog->title_object );
+        WindowsDeleteString( text );
+    }
+    /* the Content: the ContentControl's element, or its text */
+    if (button->content_element) dialog->content_element = button->content_element;
+    else if (button->content_text)
+    {
+        const WCHAR *str = WindowsGetStringRawBuffer( button->content_text, &len );
+        if ((dialog->text_object = make_text_block( str, len, 0, TRUE )))
+            dialog->content_element = element_from_object( dialog->text_object );
+    }
+    if (dialog->title_element) element_set_parent( dialog->title_element, &layer->element );
+    if (dialog->content_element) element_set_parent( dialog->content_element, &layer->element );
+    for (i = 0; i < 3; i++) create_button( dialog, i );
+    return TRUE;
+}
+
+static void free_layer( struct dialog_state *dialog )
+{
+    struct button *button = dialog->button;
+    int i;
+
+    for (i = 0; i < 3; i++)
+    {
+        dialog->handlers[i].dialog = NULL;
+        if (dialog->buttons[i]) element_set_parent( dialog->buttons[i], NULL );
+        if (dialog->button_objects[i]) IInspectable_Release( dialog->button_objects[i] );
+        dialog->buttons[i] = NULL;
+        dialog->button_objects[i] = NULL;
+    }
+    /* the app's elements go back */
+    if (dialog->title_element && !dialog->title_object) element_set_parent( dialog->title_element, NULL );
+    if (dialog->content_element && dialog->content_element == button->content_element)
+        element_set_parent( dialog->content_element, &button->element );
+    else if (dialog->content_element) element_set_parent( dialog->content_element, NULL );
+    dialog->title_element = dialog->content_element = NULL;
+    if (dialog->title_object) IInspectable_Release( dialog->title_object );
+    if (dialog->text_object) IInspectable_Release( dialog->text_object );
+    dialog->title_object = dialog->text_object = NULL;
+    if (dialog->layer)
+    {
+        dialog->layer->dialog = NULL;
+        dialog->layer = NULL;
+    }
+    if (dialog->layer_object) IInspectable_Release( dialog->layer_object );
+    dialog->layer_object = NULL;
+}
+
+static struct dialog_state *shown_dialog;   /* one at a time, as on Windows */
+
+static HRESULT dialog_show( struct dialog_state *dialog, IAsyncOperation_ContentDialogResult **value )
+{
+    struct dialog_args *args;
+    struct xaml_element *focus;
+    int i;
+
+    TRACE( "%p.\n", dialog );
+    if (shown_dialog)
+    {
+        WARN( "another ContentDialog is open.\n" );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (!(dialog->async = async_create())) return E_OUTOFMEMORY;
+    if (!build_layer( dialog ) || !window_popup_show( &dialog->layer->element ))
+    {
+        free_layer( dialog );
+        IAsyncOperation_ContentDialogResult_Release( &dialog->async->IAsyncOperation_iface );
+        dialog->async = NULL;
+        return E_FAIL;
+    }
+    dialog->open = TRUE;
+    shown_dialog = dialog;
+    IInspectable_AddRef( dialog->button->element.outer );   /* kept while it shows */
+
+    /* the focus goes to the default button, or the first one */
+    if ((focus = focus_get())) IUIElement_AddRef( &focus->IUIElement_iface );
+    dialog->previous_focus = focus;
+    focus = NULL;
+    if (dialog->default_button != ContentDialogButton_None)
+        focus = dialog->buttons[dialog->default_button - ContentDialogButton_Primary];
+    for (i = 0; !focus && i < 3; i++) focus = dialog->buttons[i];
+    if (focus) focus_set( focus, FocusState_Programmatic );
+    else focus_clear();
+
+    *value = &dialog->async->IAsyncOperation_iface;
+    IAsyncOperation_ContentDialogResult_AddRef( *value );
+    if ((args = args_create( &IID_IContentDialogOpenedEventArgs, 0 )))
+    {
+        raise_dialog_event( dialog, &dialog->opened, args, (IInspectable *)&args->IOpened_iface, "Opened" );
+        args_release( args );
+    }
+    return S_OK;
+}
+
+static void dialog_close( struct dialog_state *dialog, ContentDialogResult result )
+{
+    struct dialog_async *async = dialog->async;
+    struct dialog_args *args;
+    IInspectable *outer = dialog->button->element.outer;
+
+    if (!dialog->open) return;
+    TRACE( "%p, result %d.\n", dialog, result );
+    if ((args = args_create( &IID_IContentDialogClosingEventArgs, result )))
+    {
+        BOOL cancel = raise_dialog_event( dialog, &dialog->closing, args, (IInspectable *)&args->IClosing_iface, "Closing" );
+        args_release( args );
+        if (cancel || !dialog->open) return;
+    }
+    dialog->open = FALSE;
+    shown_dialog = NULL;
+    window_popup_hide( &dialog->layer->element );
+    free_layer( dialog );
+    if (dialog->previous_focus)
+    {
+        if (!focus_set( dialog->previous_focus, FocusState_Programmatic )) focus_clear();
+        IUIElement_Release( &dialog->previous_focus->IUIElement_iface );
+        dialog->previous_focus = NULL;
+    }
+    else focus_clear();
+    window_invalidate();
+
+    if ((args = args_create( &IID_IContentDialogClosedEventArgs, result )))
+    {
+        raise_dialog_event( dialog, &dialog->closed, args, (IInspectable *)&args->IClosed_iface, "Closed" );
+        args_release( args );
+    }
+    /* last: the app's await continues, and may show a dialog again */
+    dialog->async = NULL;
+    if (async)
+    {
+        async->result = result;
+        async->status = Completed;
+        async_call_handler( async );
+        IAsyncOperation_ContentDialogResult_Release( &async->IAsyncOperation_iface );
+    }
+    IInspectable_Release( outer );
+}
+
+static void dialog_part_clicked( struct dialog_state *dialog, enum dialog_part part )
+{
+    static const ContentDialogResult results[] = { ContentDialogResult_Primary, ContentDialogResult_Secondary,
+                                                   ContentDialogResult_None };
+    static const char *names[] = { "PrimaryButtonClick", "SecondaryButtonClick", "CloseButtonClick" };
+    IInspectable *outer = dialog->button->element.outer;
+    struct dialog_args *args;
+    BOOL cancel = FALSE;
+
+    IInspectable_AddRef( outer );
+    if ((args = args_create( &IID_IContentDialogButtonClickEventArgs, 0 )))
+    {
+        cancel = raise_dialog_event( dialog, &dialog->clicks[part], args, (IInspectable *)&args->IButtonClick_iface, names[part] );
+        args_release( args );
+    }
+    if (dialog->commands[part]) FIXME( "%p: the button's Command isn't run.\n", dialog );
+    if (!cancel) dialog_close( dialog, results[part] );
+    IInspectable_Release( outer );
+}
