+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* An Xbox Live device address is an opaque snapshot that a game puts into its multiplayer session document so
+ * that other consoles and PCs can open a secure connection to it. Games create a session even for local play
+ * (Gears of War 4's campaign), so GetLocal must work. There is no Xbox Live network here: the local address is
+ * a made-up snapshot ("WXBL", a version and a per-process random id) that only ever compares equal to itself,
+ * and addresses made from other snapshots are kept as they are. */
+
+#define SNAPSHOT_MAX 1024
+
+struct device_address
+{
+    IXboxLiveDeviceAddress IXboxLiveDeviceAddress_iface;
+    LONG ref;
+    UINT32 size;
+    BYTE data[SNAPSHOT_MAX];
+};
+
+static BYTE local_snapshot[24];
+static INIT_ONCE local_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL WINAPI init_local_snapshot( INIT_ONCE *once, void *param, void **context )
+{
+    GUID id;
+
+    memcpy( local_snapshot, "WXBL", 4 );
+    local_snapshot[4] = 1;
+    CoCreateGuid( &id );
+    memcpy( local_snapshot + 8, &id, sizeof(id) );
+    return TRUE;
+}
+
+static inline struct device_address *impl_from_IXboxLiveDeviceAddress( IXboxLiveDeviceAddress *iface )
+{
+    return CONTAINING_RECORD( iface, struct device_address, IXboxLiveDeviceAddress_iface );
+}
+
+static HRESULT WINAPI address_QueryInterface( IXboxLiveDeviceAddress *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IXboxLiveDeviceAddress ))
+    {
+        *out = iface;
+        IXboxLiveDeviceAddress_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI address_AddRef( IXboxLiveDeviceAddress *iface )
+{
+    return InterlockedIncrement( &impl_from_IXboxLiveDeviceAddress( iface )->ref );
+}
+
+static ULONG WINAPI address_Release( IXboxLiveDeviceAddress *iface )
+{
+    struct device_address *impl = impl_from_IXboxLiveDeviceAddress( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI address_GetIids( IXboxLiveDeviceAddress *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI address_GetRuntimeClassName( IXboxLiveDeviceAddress *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Networking_XboxLive_XboxLiveDeviceAddress,
+                                wcslen( RuntimeClass_Windows_Networking_XboxLive_XboxLiveDeviceAddress ), name );
+}
+
+static HRESULT WINAPI address_GetTrustLevel( IXboxLiveDeviceAddress *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI address_add_SnapshotChanged( IXboxLiveDeviceAddress *iface,
+                                                   ITypedEventHandler_XboxLiveDeviceAddress_IInspectable *handler,
+                                                   EventRegistrationToken *token )
+{
+    static LONG next_token;
+
+    /* the snapshot never changes */
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    token->value = InterlockedIncrement( &next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI address_remove_SnapshotChanged( IXboxLiveDeviceAddress *iface, EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return S_OK;
+}
+
+static const char base64_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static HRESULT WINAPI address_GetSnapshotAsBase64( IXboxLiveDeviceAddress *iface, HSTRING *value )
+{
+    struct device_address *impl = impl_from_IXboxLiveDeviceAddress( iface );
+    WCHAR out[(SNAPSHOT_MAX + 2) / 3 * 4 + 1], *p = out;
+    UINT32 i;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    for (i = 0; i < impl->size; i += 3)
+    {
+        UINT32 n = impl->data[i] << 16, left = impl->size - i;
+        if (left > 1) n |= impl->data[i + 1] << 8;
+        if (left > 2) n |= impl->data[i + 2];
+        *p++ = base64_chars[(n >> 18) & 63];
+        *p++ = base64_chars[(n >> 12) & 63];
+        *p++ = left > 1 ? base64_chars[(n >> 6) & 63] : '=';
+        *p++ = left > 2 ? base64_chars[n & 63] : '=';
+    }
+    return WindowsCreateString( out, p - out, value );
+}
+
+static HRESULT WINAPI address_GetSnapshotAsBuffer( IXboxLiveDeviceAddress *iface, __x_ABI_CWindows_CStorage_CStreams_CIBuffer **value )
+{
+    FIXME( "iface %p, value %p: not implemented.\n", iface, value );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI address_GetSnapshotAsBytes( IXboxLiveDeviceAddress *iface, UINT32 size, BYTE *buffer, UINT32 *written )
+{
+    struct device_address *impl = impl_from_IXboxLiveDeviceAddress( iface );
+
+    TRACE( "iface %p, size %u, buffer %p, written %p.\n", iface, size, buffer, written );
+
+    *written = 0;
+    if (size < impl->size) return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+    memcpy( buffer, impl->data, impl->size );
+    *written = impl->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_Compare( IXboxLiveDeviceAddress *iface, IXboxLiveDeviceAddress *other, INT32 *value )
+{
+    struct device_address *impl = impl_from_IXboxLiveDeviceAddress( iface ), *impl2;
+    int cmp;
+
+    TRACE( "iface %p, other %p, value %p.\n", iface, other, value );
+
+    if (!other) return E_INVALIDARG;
+    impl2 = impl_from_IXboxLiveDeviceAddress( other );
+    cmp = memcmp( impl->data, impl2->data, min( impl->size, impl2->size ) );
+    if (!cmp) cmp = (int)impl->size - (int)impl2->size;
+    *value = cmp < 0 ? -1 : cmp > 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_get_IsValid( IXboxLiveDeviceAddress *iface, boolean *value )
+{
+    *value = impl_from_IXboxLiveDeviceAddress( iface )->size != 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI address_get_IsLocal( IXboxLiveDeviceAddress *iface, boolean *value )
+{
+    struct device_address *impl = impl_from_IXboxLiveDeviceAddress( iface );
+
+    *value = impl->size == sizeof(local_snapshot) && !memcmp( impl->data, local_snapshot, sizeof(local_snapshot) );
+    return S_OK;
+}
+
+static HRESULT WINAPI address_get_NetworkAccessKind( IXboxLiveDeviceAddress *iface, XboxLiveNetworkAccessKind *value )
+{
+    *value = XboxLiveNetworkAccessKind_Open;
+    return S_OK;
+}
+
+static const struct IXboxLiveDeviceAddressVtbl address_vtbl =
+{
+    address_QueryInterface, address_AddRef, address_Release,
+    address_GetIids, address_GetRuntimeClassName, address_GetTrustLevel,
+    address_add_SnapshotChanged, address_remove_SnapshotChanged,
+    address_GetSnapshotAsBase64, address_GetSnapshotAsBuffer, address_GetSnapshotAsBytes,
+    address_Compare, address_get_IsValid, address_get_IsLocal, address_get_NetworkAccessKind,
+};
+
+static HRESULT create_address( const BYTE *data, UINT32 size, IXboxLiveDeviceAddress **out )
+{
+    struct device_address *impl;
+
+    *out = NULL;
+    if (!size || size > SNAPSHOT_MAX) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IXboxLiveDeviceAddress_iface.lpVtbl = &address_vtbl;
+    impl->ref = 1;
+    impl->size = size;
+    memcpy( impl->data, data, size );
+    *out = &impl->IXboxLiveDeviceAddress_iface;
+    return S_OK;
+}
+
+static int base64_value( WCHAR c )
+{
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+/* ---- statics ---- */
+
+struct address_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IXboxLiveDeviceAddressStatics IXboxLiveDeviceAddressStatics_iface;
+};
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out );
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IXboxLiveDeviceAddressStatics, struct address_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_CreateFromSnapshotBase64( IXboxLiveDeviceAddressStatics *iface, HSTRING base64,
+                                                        IXboxLiveDeviceAddress **value )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( base64, NULL );
+    BYTE data[SNAPSHOT_MAX];
+    UINT32 size = 0, bits = 0, n = 0;
+    int v;
+
+    TRACE( "iface %p, base64 %s, value %p.\n", iface, debugstr_hstring(base64), value );
+
+    for (; *str && *str != '='; str++)
+    {
+        if ((v = base64_value( *str )) < 0) return E_INVALIDARG;
+        n = (n << 6) | v;
+        if ((bits += 6) >= 8)
+        {
+            if (size == SNAPSHOT_MAX) return E_INVALIDARG;
+            data[size++] = n >> (bits -= 8);
+        }
+    }
+    return create_address( data, size, value );
+}
+
+static HRESULT WINAPI statics_CreateFromSnapshotBuffer( IXboxLiveDeviceAddressStatics *iface, __x_ABI_CWindows_CStorage_CStreams_CIBuffer *buffer,
+                                                        IXboxLiveDeviceAddress **value )
+{
+    FIXME( "iface %p, buffer %p, value %p: not implemented.\n", iface, buffer, value );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI statics_CreateFromSnapshotBytes( IXboxLiveDeviceAddressStatics *iface, UINT32 size, BYTE *buffer,
+                                                       IXboxLiveDeviceAddress **value )
+{
+    TRACE( "iface %p, size %u, buffer %p, value %p.\n", iface, size, buffer, value );
+    return create_address( buffer, size, value );
+}
+
+static HRESULT WINAPI statics_GetLocal( IXboxLiveDeviceAddressStatics *iface, IXboxLiveDeviceAddress **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    InitOnceExecuteOnce( &local_once, init_local_snapshot, NULL, NULL );
+    return create_address( local_snapshot, sizeof(local_snapshot), value );
+}
+
+static HRESULT WINAPI statics_get_MaxSnapshotBytesSize( IXboxLiveDeviceAddressStatics *iface, UINT32 *value )
+{
+    *value = SNAPSHOT_MAX;
+    return S_OK;
+}
+
+static const struct IXboxLiveDeviceAddressStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_CreateFromSnapshotBase64, statics_CreateFromSnapshotBuffer, statics_CreateFromSnapshotBytes,
+    statics_GetLocal, statics_get_MaxSnapshotBytesSize,
+};
+
+static struct address_statics address_statics =
+{
+    { &factory_vtbl },
+    { &statics_vtbl },
+};
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &address_statics.IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IXboxLiveDeviceAddressStatics ))
+        *out = &address_statics.IXboxLiveDeviceAddressStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+IActivationFactory *xboxlive_device_address_factory = &address_statics.IActivationFactory_iface;
