+/* ---- PointerDevice: the mouse ---- */
+
+/* Every pointer here comes from the mouse (pointer id 1), so one PointerDevice describes it; PointerPoint's
+ * PointerDevice returns it and games check its PointerDeviceType to tell mouse input from touch. */
+
+struct pointer_device
+{
+    IActivationFactory IActivationFactory_iface;
+    IPointerDeviceStatics IPointerDeviceStatics_iface;
+    IPointerDevice IPointerDevice_iface;
