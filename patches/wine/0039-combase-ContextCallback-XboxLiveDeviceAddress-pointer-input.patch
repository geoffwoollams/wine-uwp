+
+/* FreeThreadedXMLHTTP60 is declared outside the type library in msxml6.idl, so the type library's registration
+ * leaves it out; it is registered here. Xbox Live services create it with CoCreateInstance for their web
+ * requests (IXMLHTTPRequest2). */
+
+#pragma makedep register
+
+import "unknwn.idl";
+
+[
+    helpstring("Free Threaded XML HTTP Request class 6.0"),
+    progid("Msxml2.FreeThreadedXMLHTTP60.6.0"),
+    threading(both),
+    uuid(88d96a09-f192-11d4-a65f-0040963251e5)
+]
+coclass FreeThreadedXMLHTTP60 { interface IUnknown; }
