+
+static struct dependency_property *dp_new( const WCHAR *owner, const WCHAR *name, const WCHAR *type,
+                                           IPropertyMetadata *metadata, BOOL attached, BOOL builtin )
+{
+    struct dependency_property *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IDependencyProperty_iface.lpVtbl = &dp_vtbl;
+    impl->name = wcsdup( name );
+    impl->owner = wcsdup( owner );
+    impl->type = wcsdup( type ? type : L"" );
+    if ((impl->metadata = metadata)) IPropertyMetadata_AddRef( metadata );
+    impl->attached = attached;
+    impl->builtin = builtin;
+    EnterCriticalSection( &dp_cs );
+    impl->next = properties;
+    properties = impl;
+    LeaveCriticalSection( &dp_cs );
+    return impl;
+}
+
+/* a built-in property, the same object each time; not referenced (it is never freed) */
+IDependencyProperty *dp_builtin( const WCHAR *owner, const WCHAR *name )
+{
+    struct dependency_property *impl;
+
+    EnterCriticalSection( &dp_cs );
+    for (impl = properties; impl; impl = impl->next)
+        if (impl->builtin && !wcscmp( impl->owner, owner ) && !wcscmp( impl->name, name )) break;
+    LeaveCriticalSection( &dp_cs );
+    if (!impl && !(impl = dp_new( owner, name, NULL, NULL, FALSE, TRUE ))) return NULL;
+    return &impl->IDependencyProperty_iface;
+}
