+    else if (IsEqualGUID( iid, &IID_IDependencyObjectFactory ))
+        *out = &impl->IDependencyObjectFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
