+    do_composable_GetIids,
+    do_composable_GetRuntimeClassName,
+    do_composable_GetTrustLevel,
+    /* IDependencyObjectFactory methods */
+    do_composable_CreateInstance,
+};
+
+static struct do_statics do_statics =
+{
+    {&do_factory_vtbl},
+    {&do_composable_vtbl},
+};
+
+IActivationFactory *dependency_object_factory = &do_statics.IActivationFactory_iface;
