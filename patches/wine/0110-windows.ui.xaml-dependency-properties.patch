+/* ---- the value store ---- */
+
+struct dp_value
+{
+    IDependencyProperty *dp;
+    IInspectable *value;
+    BOOL local;           /* FALSE: a cached default from a CreateDefaultValueCallback */
+};
+
+struct dp_callback
+{
+    IDependencyProperty *dp;
+    IDependencyPropertyChangedCallback *callback;
+    INT64 token;
+};
+
+struct dp_object
+{
+    struct rb_entry entry;
+    IDependencyObject *key;
+    struct dp_value *values;
+    UINT32 value_count;
+    struct dp_callback *callbacks;
+    UINT32 callback_count;
+};
+
+static int dp_object_compare( const void *key, const struct rb_entry *entry )
+{
+    const struct dp_object *obj = RB_ENTRY_VALUE( entry, const struct dp_object, entry );
+    const char *a = key, *b = (const char *)obj->key;
+    return a < b ? -1 : a > b ? 1 : 0;
+}
+
+static struct rb_tree dp_objects = { dp_object_compare };
+static INT64 next_token = 1;
+
+static struct dp_object *dp_object_get( IDependencyObject *key, BOOL create )
+{
+    struct rb_entry *entry;
+    struct dp_object *obj;
+
+    if ((entry = rb_get( &dp_objects, key ))) return RB_ENTRY_VALUE( entry, struct dp_object, entry );
+    if (!create || !(obj = calloc( 1, sizeof(*obj) ))) return NULL;
+    obj->key = key;
+    rb_put( &dp_objects, key, &obj->entry );
+    return obj;
+}
+
+static struct dp_value *dp_object_find( struct dp_object *obj, IDependencyProperty *dp )
+{
+    UINT32 i;
+    if (!obj) return NULL;
+    for (i = 0; i < obj->value_count; i++) if (obj->values[i].dp == dp) return &obj->values[i];
+    return NULL;
+}
+
+/* the object is going away: drop its values and callbacks */
+void dp_store_free( IDependencyObject *key )
+{
+    struct dp_object *obj;
+    UINT32 i;
+
+    EnterCriticalSection( &dp_cs );
+    if (!(obj = dp_object_get( key, FALSE )))
+    {
+        LeaveCriticalSection( &dp_cs );
+        return;
+    }
+    rb_remove( &dp_objects, &obj->entry );
+    LeaveCriticalSection( &dp_cs );
+    for (i = 0; i < obj->value_count; i++) if (obj->values[i].value) IInspectable_Release( obj->values[i].value );
+    for (i = 0; i < obj->callback_count; i++) IDependencyPropertyChangedCallback_Release( obj->callbacks[i].callback );
+    free( obj->values );
+    free( obj->callbacks );
+    free( obj );
+}
+
+static BOOL values_equal( IInspectable *a, IInspectable *b )
+{
+    IPropertyValue *pa, *pb;
+    PropertyType ta, tb;
+    BOOL ret = FALSE;
+
+    if (a == b) return TRUE;
+    if (!a || !b) return FALSE;
+    if (FAILED(IInspectable_QueryInterface( a, &IID_IPropertyValue, (void **)&pa ))) return FALSE;
+    if (FAILED(IInspectable_QueryInterface( b, &IID_IPropertyValue, (void **)&pb )))
+    {
+        IPropertyValue_Release( pa );
+        return FALSE;
+    }
+    IPropertyValue_get_Type( pa, &ta );
+    IPropertyValue_get_Type( pb, &tb );
+    if (ta == tb)
+    {
+        switch (ta)
+        {
+        case PropertyType_Boolean:
+        {
+            boolean x, y;
+            ret = SUCCEEDED(IPropertyValue_GetBoolean( pa, &x )) && SUCCEEDED(IPropertyValue_GetBoolean( pb, &y )) && x == y;
+            break;
+        }
+        case PropertyType_Int32:
+        case PropertyType_UInt32:
+        case PropertyType_Int64:
+        case PropertyType_UInt8:
+        case PropertyType_Int16:
+        case PropertyType_UInt16:
+        {
+            INT64 x, y;
+            ret = SUCCEEDED(IPropertyValue_GetInt64( pa, &x )) && SUCCEEDED(IPropertyValue_GetInt64( pb, &y )) && x == y;
+            break;
+        }
+        case PropertyType_Double:
+        case PropertyType_Single:
+        {
+            DOUBLE x, y;
+            ret = SUCCEEDED(IPropertyValue_GetDouble( pa, &x )) && SUCCEEDED(IPropertyValue_GetDouble( pb, &y )) && x == y;
+            break;
+        }
+        case PropertyType_String:
+        {
+            HSTRING x = NULL, y = NULL;
+            INT32 cmp = 1;
+            if (SUCCEEDED(IPropertyValue_GetString( pa, &x )) && SUCCEEDED(IPropertyValue_GetString( pb, &y )))
+                WindowsCompareStringOrdinal( x, y, &cmp );
+            WindowsDeleteString( x );
+            WindowsDeleteString( y );
+            ret = !cmp;
+            break;
+        }
+        default:
+            break;
+        }
+    }
+    IPropertyValue_Release( pa );
+    IPropertyValue_Release( pb );
+    return ret;
+}
+
+/* a registered property's default for the object: from the metadata, or its factory (cached per object) */
+static HRESULT dp_default_value( IDependencyObject *key, struct dependency_property *impl, IInspectable **out )
+{
+    struct property_metadata *metadata = metadata_from_iface( impl->metadata );
+    struct dp_object *obj;
+    struct dp_value *v;
+    IInspectable *value = NULL;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!metadata)
+    {
+        if (impl->metadata) return IPropertyMetadata_get_DefaultValue( impl->metadata, out );
+        return S_OK;
+    }
+    if (!metadata->create_default)
+    {
+        if ((*out = metadata->default_value)) IInspectable_AddRef( *out );
+        return S_OK;
+    }
+    EnterCriticalSection( &dp_cs );
+    if ((v = dp_object_find( dp_object_get( key, FALSE ), &impl->IDependencyProperty_iface )))
+    {
+        if ((*out = v->value)) IInspectable_AddRef( *out );
+        LeaveCriticalSection( &dp_cs );
+        return S_OK;
+    }
+    LeaveCriticalSection( &dp_cs );
+    if (FAILED(hr = ICreateDefaultValueCallback_Invoke( metadata->create_default, &value ))) return hr;
+    EnterCriticalSection( &dp_cs );
+    if ((obj = dp_object_get( key, TRUE )) && !dp_object_find( obj, &impl->IDependencyProperty_iface ))
+    {
+        struct dp_value *values = realloc( obj->values, (obj->value_count + 1) * sizeof(*values) );
+        if (values)
+        {
+            obj->values = values;
+            values[obj->value_count].dp = &impl->IDependencyProperty_iface;
+            values[obj->value_count].value = value;
+            values[obj->value_count++].local = FALSE;
+            if (value) IInspectable_AddRef( value );
+        }
+    }
+    LeaveCriticalSection( &dp_cs );
+    *out = value;
+    return S_OK;
+}
+
+static void raise_changed( IDependencyObject *key, struct dependency_property *impl, IInspectable *old_value,
+                           IInspectable *new_value )
+{
+    struct property_metadata *metadata = metadata_from_iface( impl->metadata );
+    IDependencyPropertyChangedCallback **callbacks = NULL;
+    struct dp_object *obj;
+    UINT32 i, count = 0;
+
+    TRACE( "%p %s: %p -> %p.\n", key, debugstr_w(impl->name), old_value, new_value );
+    if (metadata && metadata->changed)
+    {
+        struct changed_args *args;
+        if ((args = calloc( 1, sizeof(*args) )))
+        {
+            HRESULT hr;
+            args->IDependencyPropertyChangedEventArgs_iface.lpVtbl = &changed_args_vtbl;
+            args->ref = 1;
+            args->dp = &impl->IDependencyProperty_iface;
+            if ((args->old_value = old_value)) IInspectable_AddRef( old_value );
+            if ((args->new_value = new_value)) IInspectable_AddRef( new_value );
+            hr = IPropertyChangedCallback_Invoke( metadata->changed, key, &args->IDependencyPropertyChangedEventArgs_iface );
+            if (FAILED(hr)) WARN( "%s changed callback failed, hr %#lx.\n", debugstr_w(impl->name), hr );
+            IDependencyPropertyChangedEventArgs_Release( &args->IDependencyPropertyChangedEventArgs_iface );
+        }
+    }
+
+    /* RegisterPropertyChangedCallback handlers: copied, since they may unregister themselves */
+    EnterCriticalSection( &dp_cs );
+    if ((obj = dp_object_get( key, FALSE )) && obj->callback_count &&
+        (callbacks = malloc( obj->callback_count * sizeof(*callbacks) )))
+    {
+        for (i = 0; i < obj->callback_count; i++)
+        {
+            if (obj->callbacks[i].dp != &impl->IDependencyProperty_iface) continue;
+            IDependencyPropertyChangedCallback_AddRef( (callbacks[count++] = obj->callbacks[i].callback) );
+        }
+    }
+    LeaveCriticalSection( &dp_cs );
+    for (i = 0; i < count; i++)
+    {
+        IDependencyPropertyChangedCallback_Invoke( callbacks[i], key, &impl->IDependencyProperty_iface );
+        IDependencyPropertyChangedCallback_Release( callbacks[i] );
+    }
+    free( callbacks );
+}
+
+/* built-in properties changed through SetValue also notify RegisterPropertyChangedCallback handlers */
+void dp_notify_builtin( IDependencyObject *key, const WCHAR *owner, const WCHAR *name )
+{
+    IDependencyPropertyChangedCallback **callbacks = NULL;
+    struct dependency_property *impl;
+    struct dp_object *obj;
+    UINT32 i, count = 0;
+
+    EnterCriticalSection( &dp_cs );
+    if ((obj = dp_object_get( key, FALSE )) && obj->callback_count &&
+        (callbacks = malloc( obj->callback_count * 2 * sizeof(*callbacks) )))
+    {
+        for (i = 0; i < obj->callback_count; i++)
+        {
+            impl = impl_from_IDependencyProperty( obj->callbacks[i].dp );
+            if (!impl->builtin || wcscmp( impl->name, name ) || (owner && wcscmp( impl->owner, owner ))) continue;
+            callbacks[count++] = obj->callbacks[i].callback;
+            callbacks[count++] = (IDependencyPropertyChangedCallback *)obj->callbacks[i].dp;
+            IDependencyPropertyChangedCallback_AddRef( obj->callbacks[i].callback );
+        }
+    }
+    LeaveCriticalSection( &dp_cs );
+    for (i = 0; i < count; i += 2)
+    {
+        IDependencyPropertyChangedCallback_Invoke( callbacks[i], key, (IDependencyProperty *)callbacks[i + 1] );
+        IDependencyPropertyChangedCallback_Release( callbacks[i] );
+    }
+    free( callbacks );
+}
+
+HRESULT dp_get_value( IDependencyObject *key, IDependencyProperty *dp, IInspectable **result )
+{
+    struct dependency_property *impl = dp_from_iface( dp );
+    struct dp_value *v;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!impl)
+    {
+        FIXME( "%p is not one of our properties.\n", dp );
+        return E_INVALIDARG;
+    }
+    if (impl->builtin)
+    {
+        *result = markup_get_value_owned( (IInspectable *)key, impl->owner, impl->name );
+        TRACE( "%p built-in %s.%s -> %p.\n", key, debugstr_w(impl->owner), debugstr_w(impl->name), *result );
+        return S_OK;
+    }
+    EnterCriticalSection( &dp_cs );
+    if ((v = dp_object_find( dp_object_get( key, FALSE ), dp )) && v->local)
+    {
+        if ((*result = v->value)) IInspectable_AddRef( *result );
+        LeaveCriticalSection( &dp_cs );
+        return S_OK;
+    }
+    LeaveCriticalSection( &dp_cs );
+    return dp_default_value( key, impl, result );
+}
+
+HRESULT dp_read_local_value( IDependencyObject *key, IDependencyProperty *dp, IInspectable **result )
+{
+    struct dependency_property *impl = dp_from_iface( dp );
+    struct dp_value *v;
+
+    if (!result) return E_POINTER;
+    *result = &unset_value;
+    if (!impl) return E_INVALIDARG;
+    if (impl->builtin)
+    {
+        if (element_is_local_property( (IInspectable *)key, impl->name ))
+            *result = markup_get_value_owned( (IInspectable *)key, impl->owner, impl->name );
+        return S_OK;
+    }
+    EnterCriticalSection( &dp_cs );
+    if ((v = dp_object_find( dp_object_get( key, FALSE ), dp )) && v->local)
+    {
+        if ((*result = v->value)) IInspectable_AddRef( *result );
+    }
+    LeaveCriticalSection( &dp_cs );
+    return S_OK;
+}
+
+HRESULT dp_set_value( IDependencyObject *key, IDependencyProperty *dp, IInspectable *value )
+{
+    struct dependency_property *impl = dp_from_iface( dp );
+    IInspectable *old_value = NULL;
+    struct dp_object *obj;
+    struct dp_value *v;
+    BOOL had_local;
+
+    if (!impl)
+    {
+        FIXME( "%p is not one of our properties.\n", dp );
+        return E_INVALIDARG;
+    }
+    if (value == &unset_value) return dp_clear_value( key, dp );
+    if (impl->builtin)
+    {
+        TRACE( "%p built-in %s.%s = %p.\n", key, debugstr_w(impl->owner), debugstr_w(impl->name), value );
+        markup_set_value_owned( (IInspectable *)key, impl->owner, impl->name, value );
+        dp_notify_builtin( key, impl->owner, impl->name );
+        return S_OK;
+    }
+
+    dp_get_value( key, dp, &old_value );
+    EnterCriticalSection( &dp_cs );
+    if (!(obj = dp_object_get( key, TRUE )))
+    {
+        LeaveCriticalSection( &dp_cs );
+        if (old_value) IInspectable_Release( old_value );
+        return E_OUTOFMEMORY;
+    }
+    if (!(v = dp_object_find( obj, dp )))
+    {
+        struct dp_value *values = realloc( obj->values, (obj->value_count + 1) * sizeof(*values) );
+        if (!values)
+        {
+            LeaveCriticalSection( &dp_cs );
+            if (old_value) IInspectable_Release( old_value );
+            return E_OUTOFMEMORY;
+        }
+        obj->values = values;
+        v = &values[obj->value_count++];
+        v->dp = dp;
+        v->value = NULL;
+    }
+    had_local = v->local;
+    if (v->value) IInspectable_Release( v->value );
+    if ((v->value = value)) IInspectable_AddRef( value );
+    v->local = TRUE;
+    LeaveCriticalSection( &dp_cs );
+
+    TRACE( "%p %s.%s = %p.\n", key, debugstr_w(impl->owner), debugstr_w(impl->name), value );
+    if (!values_equal( old_value, value ) || (!had_local && old_value != value))
+    {
+        raise_changed( key, impl, old_value, value );
+        element_property_changed( (IInspectable *)key, impl->name );
+    }
+    if (old_value) IInspectable_Release( old_value );
+    return S_OK;
+}
+
+HRESULT dp_clear_value( IDependencyObject *key, IDependencyProperty *dp )
+{
+    struct dependency_property *impl = dp_from_iface( dp );
+    IInspectable *old_value = NULL, *new_value = NULL;
+    struct dp_object *obj;
+    struct dp_value *v;
+    BOOL had_local = FALSE;
+
+    if (!impl) return E_INVALIDARG;
+    if (impl->builtin)
+    {
+        FIXME( "%p clearing built-in %s.%s isn't supported.\n", key, debugstr_w(impl->owner), debugstr_w(impl->name) );
+        return S_OK;
+    }
+    EnterCriticalSection( &dp_cs );
+    if ((obj = dp_object_get( key, FALSE )) && (v = dp_object_find( obj, dp )) && v->local)
+    {
+        had_local = TRUE;
+        old_value = v->value;
+        *v = obj->values[--obj->value_count];
+    }
+    LeaveCriticalSection( &dp_cs );
+    if (!had_local) return S_OK;
+    dp_get_value( key, dp, &new_value );
+    if (!values_equal( old_value, new_value )) raise_changed( key, impl, old_value, new_value );
+    if (old_value) IInspectable_Release( old_value );
+    if (new_value) IInspectable_Release( new_value );
+    return S_OK;
+}
+
+HRESULT dp_register_callback( IDependencyObject *key, IDependencyProperty *dp, IDependencyPropertyChangedCallback *callback,
+                              INT64 *token )
+{
+    struct dp_object *obj;
+    struct dp_callback *callbacks;
+
+    if (!dp_from_iface( dp ) || !callback || !token) return E_INVALIDARG;
+    EnterCriticalSection( &dp_cs );
+    if (!(obj = dp_object_get( key, TRUE )) ||
+        !(callbacks = realloc( obj->callbacks, (obj->callback_count + 1) * sizeof(*callbacks) )))
+    {
+        LeaveCriticalSection( &dp_cs );
+        return E_OUTOFMEMORY;
+    }
+    obj->callbacks = callbacks;
+    callbacks[obj->callback_count].dp = dp;
+    IDependencyPropertyChangedCallback_AddRef( (callbacks[obj->callback_count].callback = callback) );
+    *token = callbacks[obj->callback_count++].token = next_token++;
+    LeaveCriticalSection( &dp_cs );
+    return S_OK;
+}
+
+HRESULT dp_unregister_callback( IDependencyObject *key, IDependencyProperty *dp, INT64 token )
+{
+    IDependencyPropertyChangedCallback *callback = NULL;
+    struct dp_object *obj;
+    UINT32 i;
+
+    EnterCriticalSection( &dp_cs );
+    if ((obj = dp_object_get( key, FALSE )))
+    {
+        for (i = 0; i < obj->callback_count; i++)
+        {
+            if (obj->callbacks[i].token != token) continue;
+            callback = obj->callbacks[i].callback;
+            obj->callbacks[i] = obj->callbacks[--obj->callback_count];
+            break;
+        }
+    }
+    LeaveCriticalSection( &dp_cs );
+    if (callback) IDependencyPropertyChangedCallback_Release( callback );
+    return S_OK;
+}
+
+/* ---- DependencyObject: the composable base for app classes and WinUI's own ---- */
+
+struct dependency_object
+{
+    IDependencyObject IDependencyObject_iface;
+    IDependencyObject2 IDependencyObject2_iface;
+    IInspectable IInspectable_inner;
+    IInspectable *outer;
+    LONG ref;
+};
+
+static inline struct dependency_object *impl_from_do_inner( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct dependency_object, IInspectable_inner );
+}
+
+static HRESULT WINAPI do_inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct dependency_object *impl = impl_from_do_inner( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ))
+        *out = &impl->IInspectable_inner;
+    else if (IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDependencyObject ))
+        *out = &impl->IDependencyObject_iface;
+    else if (IsEqualGUID( iid, &IID_IDependencyObject2 ))
+        *out = &impl->IDependencyObject2_iface;
+    else
+    {
+        TRACE( "%s not implemented.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI do_inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_do_inner( iface )->ref );
+}
+
+static ULONG WINAPI do_inner_Release( IInspectable *iface )
+{
+    struct dependency_object *impl = impl_from_do_inner( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        dp_store_free( &impl->IDependencyObject_iface );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI do_inner_GetIids( IInspectable *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI do_inner_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.UI.Xaml.DependencyObject";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI do_inner_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const struct IInspectableVtbl do_inner_vtbl =
+{
+    do_inner_QueryInterface, do_inner_AddRef, do_inner_Release,
+    do_inner_GetIids, do_inner_GetRuntimeClassName, do_inner_GetTrustLevel,
+};
