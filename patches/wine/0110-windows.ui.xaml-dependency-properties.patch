+/* DependencyProperty.GetValue/SetValue for built-in properties: owner is the declaring type's short name */
+IInspectable *markup_get_value_owned( IInspectable *target, const WCHAR *owner, const WCHAR *name )
+{
+    struct xaml_element *element = element_from_object( target );
+
+    if (element && owner && !wcscmp( owner, L"Canvas" ) && (!wcscmp( name, L"Left" ) || !wcscmp( name, L"Top" )))
+    {
+        struct xvalue value = { XV_FLOAT };
+        value.f = !wcscmp( name, L"Left" ) ? element->canvas_left : element->canvas_top;
+        box_value( &value );
+        return value.object;
+    }
+    if (element && owner && !wcscmp( owner, L"Canvas" ) && !wcscmp( name, L"ZIndex" ))
+    {
+        struct xvalue value = { XV_SIGNED };
+        value.i = element->z_index;
+        box_value( &value );
+        return value.object;
+    }
+    if (element && owner && !wcscmp( owner, L"Grid" ))
+    {
+        INT32 v = -1;
+        if (!wcscmp( name, L"Row" )) v = element->row;
+        else if (!wcscmp( name, L"Column" )) v = element->column;
+        else if (!wcscmp( name, L"RowSpan" )) v = element->row_span;
+        else if (!wcscmp( name, L"ColumnSpan" )) v = element->column_span;
+        if (v != -1)
+        {
+            struct xvalue value = { XV_SIGNED };
+            value.i = v;
+            box_value( &value );
+            return value.object;
+        }
+    }
+    return markup_get_value( target, name );
+}
+
+void markup_set_value_owned( IInspectable *target, const WCHAR *owner, const WCHAR *name, IInspectable *object )
+{
+    struct xvalue value = {0};
+    struct xprop prop = {0};
+
+    if (owner) lstrcpynW( prop.owner, owner, ARRAY_SIZE(prop.owner) );
+    lstrcpynW( prop.name, name, ARRAY_SIZE(prop.name) );
+    if (object)
+    {
+        value.kind = XV_OBJECT;
+        IInspectable_AddRef( (value.object = object) );
+    }
+    else value.kind = XV_NULL;
+    set_property( NULL, target, &prop, &value, SET_LOCAL );
+    xvalue_clear( &value );
+}
+
+BOOL element_is_local_property( IInspectable *target, const WCHAR *name )
+{
+    struct xaml_element *element = element_from_object( target );
+    return element && element_is_local( element, name );
+}
