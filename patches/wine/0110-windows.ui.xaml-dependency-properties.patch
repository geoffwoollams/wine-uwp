+/* the property's name and, for built-ins, its owner's short name; NULL if it isn't ours */
+const WCHAR *dp_name( IDependencyProperty *iface, const WCHAR **owner, BOOL *builtin )
+{
+    struct dependency_property *impl = dp_from_iface( iface );
+    if (!impl) return NULL;
+    if (owner) *owner = impl->owner;
+    if (builtin) *builtin = impl->builtin;
+    return impl->name;
