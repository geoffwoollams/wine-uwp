+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* Two kinds of DependencyProperty: the ones apps register (DependencyProperty.Register/RegisterAttached), whose
+ * values live in a per-object store here, and built-in ones handed out by our classes' statics, which name a
+ * property our elements keep in typed fields and reach through the markup setters (markup_get_value and
+ * markup_set_value). Store values are keyed by the object's own IDependencyObject pointer: our objects have
+ * exactly one, and an aggregating app object forwards to it. */
+
+struct dependency_property
+{
+    IDependencyProperty IDependencyProperty_iface;
+    struct dependency_property *next;
+    WCHAR *name;
+    WCHAR *owner;          /* the owner type's full name (built-ins: short name) */
+    WCHAR *type;           /* the property type's name */
+    IPropertyMetadata *metadata;
+    BOOL attached;
+    BOOL builtin;
+};
+
+static struct dependency_property *properties;
+static CRITICAL_SECTION dp_cs;
+static CRITICAL_SECTION_DEBUG dp_cs_debug =
+{
+    0, 0, &dp_cs,
+    { &dp_cs_debug.ProcessLocksList, &dp_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": dp_cs") }
+};
+static CRITICAL_SECTION dp_cs = { &dp_cs_debug, -1, 0, 0, 0, 0 };
+
+/* ---- the UnsetValue sentinel ---- */
+
+static HRESULT WINAPI unset_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI unset_AddRef( IInspectable *iface ) { return 2; }
+static ULONG WINAPI unset_Release( IInspectable *iface ) { return 1; }
+static HRESULT WINAPI unset_GetIids( IInspectable *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI unset_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.UI.Xaml.UnsetValue";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+static HRESULT WINAPI unset_GetTrustLevel( IInspectable *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static const struct IInspectableVtbl unset_vtbl =
+{
+    unset_QueryInterface, unset_AddRef, unset_Release,
+    unset_GetIids, unset_GetRuntimeClassName, unset_GetTrustLevel,
+};
+static IInspectable unset_value = { &unset_vtbl };
+
+IInspectable *dp_unset_value(void)
+{
+    return &unset_value;
+}
+
+/* ---- PropertyMetadata ---- */
+
+struct property_metadata
+{
+    IPropertyMetadata IPropertyMetadata_iface;
+    LONG ref;
+    IInspectable *default_value;
+    ICreateDefaultValueCallback *create_default;
+    IPropertyChangedCallback *changed;
+};
+
+static inline struct property_metadata *impl_from_IPropertyMetadata( IPropertyMetadata *iface )
+{
+    return CONTAINING_RECORD( iface, struct property_metadata, IPropertyMetadata_iface );
+}
+
+static HRESULT WINAPI metadata_QueryInterface( IPropertyMetadata *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IPropertyMetadata ))
+    {
+        IPropertyMetadata_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    TRACE( "%s not implemented.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI metadata_AddRef( IPropertyMetadata *iface )
+{
+    return InterlockedIncrement( &impl_from_IPropertyMetadata( iface )->ref );
+}
+
+static ULONG WINAPI metadata_Release( IPropertyMetadata *iface )
+{
+    struct property_metadata *impl = impl_from_IPropertyMetadata( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->default_value) IInspectable_Release( impl->default_value );
+        if (impl->create_default) ICreateDefaultValueCallback_Release( impl->create_default );
+        if (impl->changed) IPropertyChangedCallback_Release( impl->changed );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI metadata_GetIids( IPropertyMetadata *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI metadata_GetRuntimeClassName( IPropertyMetadata *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.UI.Xaml.PropertyMetadata";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI metadata_GetTrustLevel( IPropertyMetadata *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI metadata_get_DefaultValue( IPropertyMetadata *iface, IInspectable **value )
+{
+    struct property_metadata *impl = impl_from_IPropertyMetadata( iface );
+    if ((*value = impl->default_value)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI metadata_get_CreateDefaultValueCallback( IPropertyMetadata *iface, ICreateDefaultValueCallback **value )
+{
+    struct property_metadata *impl = impl_from_IPropertyMetadata( iface );
+    if ((*value = impl->create_default)) ICreateDefaultValueCallback_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IPropertyMetadataVtbl metadata_vtbl =
+{
+    metadata_QueryInterface,
+    metadata_AddRef,
+    metadata_Release,
+    /* IInspectable methods */
+    metadata_GetIids,
+    metadata_GetRuntimeClassName,
+    metadata_GetTrustLevel,
+    /* IPropertyMetadata methods */
+    metadata_get_DefaultValue,
+    metadata_get_CreateDefaultValueCallback,
+};
+
+static HRESULT metadata_create( IInspectable *default_value, ICreateDefaultValueCallback *create_default,
+                                IPropertyChangedCallback *changed, IPropertyMetadata **out )
+{
+    struct property_metadata *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPropertyMetadata_iface.lpVtbl = &metadata_vtbl;
+    impl->ref = 1;
+    if ((impl->default_value = default_value)) IInspectable_AddRef( default_value );
+    if ((impl->create_default = create_default)) ICreateDefaultValueCallback_AddRef( create_default );
+    if ((impl->changed = changed)) IPropertyChangedCallback_AddRef( changed );
+    *out = &impl->IPropertyMetadata_iface;
+    return S_OK;
+}
+
+static struct property_metadata *metadata_from_iface( IPropertyMetadata *iface )
+{
+    if (!iface || iface->lpVtbl != &metadata_vtbl) return NULL;
+    return impl_from_IPropertyMetadata( iface );
+}
+
+struct metadata_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IPropertyMetadataFactory IPropertyMetadataFactory_iface;
+    IPropertyMetadataStatics IPropertyMetadataStatics_iface;
+};
+
+static inline struct metadata_statics *impl_from_metadata_factory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct metadata_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI metadata_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct metadata_statics *impl = impl_from_metadata_factory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IPropertyMetadataFactory ))
+        *out = &impl->IPropertyMetadataFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IPropertyMetadataStatics ))
+        *out = &impl->IPropertyMetadataStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI metadata_factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI metadata_factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI metadata_factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI metadata_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI metadata_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI metadata_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl metadata_factory_vtbl =
+{
+    metadata_factory_QueryInterface,
+    metadata_factory_AddRef,
+    metadata_factory_Release,
+    /* IInspectable methods */
+    metadata_factory_GetIids,
+    metadata_factory_GetRuntimeClassName,
+    metadata_factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    metadata_factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( metadata_composable, IPropertyMetadataFactory, struct metadata_statics, IActivationFactory_iface )
+
+/* aggregation isn't supported: nothing overrides PropertyMetadata, so the object is its own inner */
+static HRESULT composed_metadata( IInspectable *default_value, IPropertyChangedCallback *changed, IInspectable *outer,
+                                  IInspectable **inner, IPropertyMetadata **value )
+{
+    HRESULT hr;
+
+    if (outer) FIXME( "aggregating PropertyMetadata isn't supported.\n" );
+    if (FAILED(hr = metadata_create( default_value, NULL, changed, value ))) return hr;
+    if (inner)
+    {
+        *inner = (IInspectable *)*value;
+        IInspectable_AddRef( *inner );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI metadata_composable_CreateInstanceWithDefaultValue( IPropertyMetadataFactory *iface, IInspectable *default_value,
+                                                                           IInspectable *outer, IInspectable **inner,
+                                                                           IPropertyMetadata **value )
+{
+    TRACE( "default %p, outer %p.\n", default_value, outer );
+    return composed_metadata( default_value, NULL, outer, inner, value );
+}
+
+static HRESULT WINAPI metadata_composable_CreateInstanceWithDefaultValueAndCallback( IPropertyMetadataFactory *iface,
+                                                                                      IInspectable *default_value,
+                                                                                      IPropertyChangedCallback *changed,
+                                                                                      IInspectable *outer, IInspectable **inner,
+                                                                                      IPropertyMetadata **value )
+{
+    TRACE( "default %p, callback %p, outer %p.\n", default_value, changed, outer );
+    return composed_metadata( default_value, changed, outer, inner, value );
+}
+
+static const struct IPropertyMetadataFactoryVtbl metadata_composable_vtbl =
+{
+    metadata_composable_QueryInterface,
+    metadata_composable_AddRef,
+    metadata_composable_Release,
+    /* IInspectable methods */
+    metadata_composable_GetIids,
+    metadata_composable_GetRuntimeClassName,
+    metadata_composable_GetTrustLevel,
+    /* IPropertyMetadataFactory methods */
+    metadata_composable_CreateInstanceWithDefaultValue,
+    metadata_composable_CreateInstanceWithDefaultValueAndCallback,
+};
+
+DEFINE_IINSPECTABLE( metadata_statics, IPropertyMetadataStatics, struct metadata_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI metadata_statics_CreateWithDefaultValue( IPropertyMetadataStatics *iface, IInspectable *default_value,
+                                                               IPropertyMetadata **result )
+{
+    return metadata_create( default_value, NULL, NULL, result );
+}
+
+static HRESULT WINAPI metadata_statics_CreateWithDefaultValueAndCallback( IPropertyMetadataStatics *iface, IInspectable *default_value,
+                                                                          IPropertyChangedCallback *changed, IPropertyMetadata **result )
+{
+    return metadata_create( default_value, NULL, changed, result );
+}
+
+static HRESULT WINAPI metadata_statics_CreateWithFactory( IPropertyMetadataStatics *iface, ICreateDefaultValueCallback *create,
+                                                          IPropertyMetadata **result )
+{
+    return metadata_create( NULL, create, NULL, result );
