+DEFINE_IINSPECTABLE( do_composable, IDependencyObjectFactory, struct do_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI do_composable_CreateInstance( IDependencyObjectFactory *iface, IInspectable *outer, IInspectable **inner,
+                                                    IDependencyObject **value )
+{
+    struct dependency_object *impl;
+
+    TRACE( "outer %p, inner %p, value %p.\n", outer, inner, value );
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IDependencyObject_iface.lpVtbl = &do_dependency_object_vtbl;
+    impl->IDependencyObject2_iface.lpVtbl = &do_dependency_object2_vtbl;
+    impl->IInspectable_inner.lpVtbl = &do_inner_vtbl;
+    impl->outer = outer ? outer : &impl->IInspectable_inner;
+    impl->ref = 1;
+    if (outer)
+    {
+        /* the outer object holds the inner reference; the returned interface is the outer's */
+        *inner = &impl->IInspectable_inner;
+        *value = &impl->IDependencyObject_iface;
+        IInspectable_AddRef( outer );
+    }
+    else
+    {
+        if (inner) *inner = NULL;
+        *value = &impl->IDependencyObject_iface;
+    }
+    return S_OK;
+}
+
+static const struct IDependencyObjectFactoryVtbl do_composable_vtbl =
+{
