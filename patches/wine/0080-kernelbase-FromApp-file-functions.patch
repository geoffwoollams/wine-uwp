Subject: kernelbase: the *FromApp file functions (CreateFileFromAppW and the rest of api-ms-win-core-file-fromapp)

diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 7b0f0a6..8a69135 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -4736,3 +4736,101 @@ HRESULT WINAPI QueryIoRingCapabilities(IORING_CAPABILITIES *caps)
 
     return E_NOTIMPL;
 }
+
+
+/***********************************************************************
+ * The *FromApp file functions: the usual file functions with the checks Windows makes for
+ * app-container processes, which don't apply here (apps run with the user's own access).
+ */
+
+/***********************************************************************
+ *           CopyFileFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI CopyFileFromAppW( const WCHAR *source, const WCHAR *dest, BOOL fail_if_exists )
+{
+    return CopyFileExW( source, dest, NULL, NULL, NULL, fail_if_exists ? COPY_FILE_FAIL_IF_EXISTS : 0 );
+}
+
+/***********************************************************************
+ *           CreateDirectoryFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI CreateDirectoryFromAppW( const WCHAR *path, SECURITY_ATTRIBUTES *sa )
+{
+    return CreateDirectoryW( path, sa );
+}
+
+/***********************************************************************
+ *           CreateFileFromAppW   (kernelbase.@)
+ */
+HANDLE WINAPI CreateFileFromAppW( const WCHAR *name, DWORD access, DWORD sharing, SECURITY_ATTRIBUTES *sa,
+                                  DWORD creation, DWORD attributes, HANDLE template )
+{
+    return CreateFileW( name, access, sharing, sa, creation, attributes, template );
+}
+
+/***********************************************************************
+ *           CreateFile2FromAppW   (kernelbase.@)
+ */
+HANDLE WINAPI CreateFile2FromAppW( const WCHAR *name, DWORD access, DWORD sharing, DWORD creation,
+                                   CREATEFILE2_EXTENDED_PARAMETERS *params )
+{
+    return CreateFile2( name, access, sharing, creation, params );
+}
+
+/***********************************************************************
+ *           DeleteFileFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI DeleteFileFromAppW( const WCHAR *path )
+{
+    return DeleteFileW( path );
+}
+
+/***********************************************************************
+ *           FindFirstFileExFromAppW   (kernelbase.@)
+ */
+HANDLE WINAPI FindFirstFileExFromAppW( const WCHAR *filename, FINDEX_INFO_LEVELS level, void *data,
+                                       FINDEX_SEARCH_OPS search_op, void *filter, DWORD flags )
+{
+    return FindFirstFileExW( filename, level, data, search_op, filter, flags );
+}
+
+/***********************************************************************
+ *           GetFileAttributesExFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI GetFileAttributesExFromAppW( const WCHAR *name, GET_FILEEX_INFO_LEVELS level, void *ptr )
+{
+    return GetFileAttributesExW( name, level, ptr );
+}
+
+/***********************************************************************
+ *           MoveFileFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI MoveFileFromAppW( const WCHAR *source, const WCHAR *dest )
+{
+    return MoveFileExW( source, dest, MOVEFILE_COPY_ALLOWED );
+}
+
+/***********************************************************************
+ *           RemoveDirectoryFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI RemoveDirectoryFromAppW( const WCHAR *path )
+{
+    return RemoveDirectoryW( path );
+}
+
+/***********************************************************************
+ *           ReplaceFileFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI ReplaceFileFromAppW( const WCHAR *replaced, const WCHAR *replacement, const WCHAR *backup,
+                                 DWORD flags, void *exclude, void *reserved )
+{
+    return ReplaceFileW( replaced, replacement, backup, flags, exclude, reserved );
+}
+
+/***********************************************************************
+ *           SetFileAttributesFromAppW   (kernelbase.@)
+ */
+BOOL WINAPI SetFileAttributesFromAppW( const WCHAR *name, DWORD attributes )
+{
+    return SetFileAttributesW( name, attributes );
+}
