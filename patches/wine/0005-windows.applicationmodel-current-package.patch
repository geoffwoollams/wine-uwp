+/* Text of <Properties><element> in the package's AppxManifest.xml, as a new HSTRING ("" if missing). */
+static HRESULT manifest_property( const char *element, HSTRING *value )
+{
+    WCHAR path[MAX_PATH], buffer[512] = L"";
+    char *data = NULL, open_tag[64], close_tag[64], *props, *p, *e;
+    UINT32 len = MAX_PATH - 20;
+    LARGE_INTEGER size;
+    DWORD read = 0;
+    HANDLE file;
+
+    if (!GetCurrentPackagePath( &len, path ))
+    {
+        wcscat( path, L"\\AppxManifest.xml" );
+        file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            if (GetFileSizeEx( file, &size ) && size.QuadPart < 4 * 1024 * 1024 && (data = malloc( size.QuadPart + 1 )))
+            {
+                if (!ReadFile( file, data, size.QuadPart, &read, NULL )) read = 0;
+                data[read] = 0;
+            }
+            CloseHandle( file );
+        }
+    }
+    snprintf( open_tag, sizeof(open_tag), "<%s>", element );
+    snprintf( close_tag, sizeof(close_tag), "</%s>", element );
+    if (data && (props = strstr( data, "<Properties" )) && (p = strstr( props, open_tag )) && (e = strstr( p, close_tag )))
+    {
+        p += strlen( open_tag );
+        *e = 0;
+        /* TODO: XML entities and ms-resource: references (resources.pri) */
+        if (strncmp( p, "ms-resource:", 12 )) MultiByteToWideChar( CP_UTF8, 0, p, -1, buffer, ARRAY_SIZE(buffer) );
+    }
+    free( data );
+    return WindowsCreateString( buffer, wcslen( buffer ), value );
+}
+
