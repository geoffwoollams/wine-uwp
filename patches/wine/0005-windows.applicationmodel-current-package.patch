diff --git a/dlls/windows.applicationmodel/packageid_gen.c b/dlls/windows.applicationmodel/packageid_gen.c
new file mode 100644
index 0000000..20e1858
--- /dev/null
+++ b/dlls/windows.applicationmodel/packageid_gen.c
@@ -0,0 +1,158 @@
+/* Windows.ApplicationModel.PackageId for the current package. */
+#include "private.h"
+#include "appmodel.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(model);
+
+/* The identity is the one kernelbase reads from the app's AppxManifest.xml (GetCurrentPackageId and friends). */
+static const PACKAGE_ID *current_id(void)
+{
+    static UINT64 buffer[256];
+    static const PACKAGE_ID *id;
+    UINT32 len = sizeof(buffer);
+
+    if (!id && !GetCurrentPackageId(&len, (BYTE *)buffer)) id = (const PACKAGE_ID *)buffer;
+    return id;
+}
+
+static HRESULT id_string(const WCHAR *str, HSTRING *value)
+{
+    if (!str) str = L"";
+    return WindowsCreateString(str, wcslen(str), value);
+}
+
+struct package_id
+{
+    IPackageId IPackageId_iface;
+    LONG ref;
+};
+
+static HRESULT package_id_qi(struct package_id *impl, REFIID iid, void **out)
+{
+    TRACE("%p, %s, %p.\n", impl, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IPackageId))
+    {
+        *out = &impl->IPackageId_iface;
+        InterlockedIncrement(&impl->ref);
+        return S_OK;
+    }
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG package_id_addref(struct package_id *impl) { return InterlockedIncrement(&impl->ref); }
+static ULONG package_id_release(struct package_id *impl)
+{
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref) free(impl);
+    return ref;
+}
+
+
+/* ---- IPackageId on package_id ---- */
+static inline struct package_id *impl_from_package_id(IPackageId *iface)
+{ return CONTAINING_RECORD(iface, struct package_id, IPackageId_iface); }
+
+static HRESULT WINAPI package_id_QueryInterface(IPackageId *iface, REFIID iid, void **out)
+{ return package_id_qi(impl_from_package_id(iface), iid, out); }
+static ULONG WINAPI package_id_AddRef(IPackageId *iface)
+{ return package_id_addref(impl_from_package_id(iface)); }
+static ULONG WINAPI package_id_Release(IPackageId *iface)
+{ return package_id_release(impl_from_package_id(iface)); }
+static HRESULT WINAPI package_id_GetIids(IPackageId *iface, ULONG *count, IID **iids)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI package_id_GetRuntimeClassName(IPackageId *iface, HSTRING *name)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI package_id_GetTrustLevel(IPackageId *iface, TrustLevel *level)
+{ *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI package_id_get_Name(IPackageId *iface, HSTRING *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    return id_string(current_id() ? current_id()->name : NULL, value);
+}
+
+static HRESULT WINAPI package_id_get_Version(IPackageId *iface, __x_ABI_CWindows_CApplicationModel_CPackageVersion *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    const PACKAGE_ID *id = current_id();
+    if (!id) { memset(value, 0, sizeof(*value)); return S_OK; }
+    value->Major = id->version.Major; value->Minor = id->version.Minor;
+    value->Build = id->version.Build; value->Revision = id->version.Revision;
+    return S_OK;
+}
+
+static HRESULT WINAPI package_id_get_Architecture(IPackageId *iface, __x_ABI_CWindows_CSystem_CProcessorArchitecture *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    *value = current_id() ? current_id()->processorArchitecture : ProcessorArchitecture_X64; /* same values as PROCESSOR_ARCHITECTURE_* */
+    return S_OK;
+}
+
+static HRESULT WINAPI package_id_get_ResourceId(IPackageId *iface, HSTRING *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    return WindowsCreateString(L"", 0, value);
+}
+
+static HRESULT WINAPI package_id_get_Publisher(IPackageId *iface, HSTRING *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    return id_string(current_id() ? current_id()->publisher : NULL, value);
+}
+
+static HRESULT WINAPI package_id_get_PublisherId(IPackageId *iface, HSTRING *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    return id_string(current_id() ? current_id()->publisherId : NULL, value);
+}
+
+static HRESULT WINAPI package_id_get_FullName(IPackageId *iface, HSTRING *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    WCHAR name[PACKAGE_FULL_NAME_MAX_LENGTH + 1] = L"";
+    UINT32 len = ARRAY_SIZE(name);
+    GetCurrentPackageFullName(&len, name);
+    return id_string(name, value);
+}
+
+static HRESULT WINAPI package_id_get_FamilyName(IPackageId *iface, HSTRING *value)
+{
+    struct package_id *impl __attribute__((unused)) = impl_from_package_id(iface);
+    WCHAR name[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1] = L"";
+    UINT32 len = ARRAY_SIZE(name);
+    GetCurrentPackageFamilyName(&len, name);
+    return id_string(name, value);
+}
+
+static const IPackageIdVtbl package_id_vtbl =
+{
+    package_id_QueryInterface,
+    package_id_AddRef,
+    package_id_Release,
+    package_id_GetIids,
+    package_id_GetRuntimeClassName,
+    package_id_GetTrustLevel,
+    package_id_get_Name,
+    package_id_get_Version,
+    package_id_get_Architecture,
+    package_id_get_ResourceId,
+    package_id_get_Publisher,
+    package_id_get_PublisherId,
+    package_id_get_FullName,
+    package_id_get_FamilyName,
+};
+
+
+HRESULT package_id_create( IPackageId **out )
+{
+    struct package_id *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPackageId_iface.lpVtbl = &package_id_vtbl;
+    impl->ref = 1;
+    *out = &impl->IPackageId_iface;
+    return S_OK;
+}
