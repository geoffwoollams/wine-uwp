+/* ---- ICoreApplicationView3 on core_view ---- */
+/* Gears of War 4 reads these in its Activated handler. The view is never a hosted component, and its title bar
+ * is the window's own; it has no system overlay and keeps the size it had. */
+static inline struct core_view *impl_from_core_view3(ICoreApplicationView3 *iface)
+{ return CONTAINING_RECORD(iface, struct core_view, ICoreApplicationView3_iface); }
+
+static HRESULT WINAPI core_view3_QueryInterface(ICoreApplicationView3 *iface, REFIID iid, void **out)
+{ return core_view_qi(impl_from_core_view3(iface), iid, out); }
+static ULONG WINAPI core_view3_AddRef(ICoreApplicationView3 *iface)
+{ return core_view_addref(impl_from_core_view3(iface)); }
+static ULONG WINAPI core_view3_Release(ICoreApplicationView3 *iface)
+{ return core_view_release(impl_from_core_view3(iface)); }
+static HRESULT WINAPI core_view3_GetIids(ICoreApplicationView3 *iface, ULONG *count, IID **iids)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI core_view3_GetRuntimeClassName(ICoreApplicationView3 *iface, HSTRING *name)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI core_view3_GetTrustLevel(ICoreApplicationView3 *iface, TrustLevel *level)
+{ *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI core_view3_get_IsComponent(ICoreApplicationView3 *iface, boolean *value)
+{
+    TRACE("iface %p, value %p.\n", iface, value);
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI core_view3_get_TitleBar(ICoreApplicationView3 *iface, ICoreApplicationViewTitleBar **value)
+{
+    struct core_view *impl = impl_from_core_view3(iface);
+    TRACE("iface %p, value %p.\n", iface, value);
+    *value = &impl->ICoreApplicationViewTitleBar_iface;
+    ICoreApplicationViewTitleBar_AddRef(*value);
+    return S_OK;
+}
+
+static HRESULT WINAPI core_view3_add_HostedViewClosing(ICoreApplicationView3 *iface,
+        __FITypedEventHandler_2_Windows__CApplicationModel__CCore__CCoreApplicationView_Windows__CApplicationModel__CCore__CHostedViewClosingEventArgs *handler,
+        EventRegistrationToken *token)
+{
+    TRACE("iface %p, handler %p (a view that isn't hosted never closes as one).\n", iface, handler);
+    token->value = InterlockedIncrement(&event_token_counter);
+    return S_OK;
+}
+
+static HRESULT WINAPI core_view3_remove_HostedViewClosing(ICoreApplicationView3 *iface, EventRegistrationToken token)
+{ return S_OK; }
+
+static const ICoreApplicationView3Vtbl core_view3_vtbl =
+{
+    core_view3_QueryInterface,
+    core_view3_AddRef,
+    core_view3_Release,
+    core_view3_GetIids,
+    core_view3_GetRuntimeClassName,
+    core_view3_GetTrustLevel,
+    core_view3_get_IsComponent,
+    core_view3_get_TitleBar,
+    core_view3_add_HostedViewClosing,
+    core_view3_remove_HostedViewClosing,
+};
+
+/* ---- CoreApplicationViewTitleBar, part of core_view ---- */
+static inline struct core_view *impl_from_title_bar(ICoreApplicationViewTitleBar *iface)
+{ return CONTAINING_RECORD(iface, struct core_view, ICoreApplicationViewTitleBar_iface); }
+
+static HRESULT WINAPI title_bar_QueryInterface(ICoreApplicationViewTitleBar *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_ICoreApplicationViewTitleBar))
+    {
+        *out = iface;
+        ICoreApplicationViewTitleBar_AddRef(iface);
+        return S_OK;
+    }
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI title_bar_AddRef(ICoreApplicationViewTitleBar *iface)
+{ return core_view_addref(impl_from_title_bar(iface)); }
+static ULONG WINAPI title_bar_Release(ICoreApplicationViewTitleBar *iface)
+{ return core_view_release(impl_from_title_bar(iface)); }
+static HRESULT WINAPI title_bar_GetIids(ICoreApplicationViewTitleBar *iface, ULONG *count, IID **iids)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI title_bar_GetRuntimeClassName(ICoreApplicationViewTitleBar *iface, HSTRING *name)
+{
+    static const WCHAR class_name[] = L"Windows.ApplicationModel.Core.CoreApplicationViewTitleBar";
+    return WindowsCreateString(class_name, wcslen(class_name), name);
+}
+static HRESULT WINAPI title_bar_GetTrustLevel(ICoreApplicationViewTitleBar *iface, TrustLevel *level)
+{ *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI title_bar_put_ExtendViewIntoTitleBar(ICoreApplicationViewTitleBar *iface, boolean value)
+{
+    TRACE("iface %p, value %d (the window keeps its frame).\n", iface, value);
+    impl_from_title_bar(iface)->extend_into_title_bar = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_get_ExtendViewIntoTitleBar(ICoreApplicationViewTitleBar *iface, boolean *value)
+{
+    *value = impl_from_title_bar(iface)->extend_into_title_bar;
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_get_SystemOverlayLeftInset(ICoreApplicationViewTitleBar *iface, DOUBLE *value)
+{ *value = 0; return S_OK; }
+static HRESULT WINAPI title_bar_get_SystemOverlayRightInset(ICoreApplicationViewTitleBar *iface, DOUBLE *value)
+{ *value = 0; return S_OK; }
+static HRESULT WINAPI title_bar_get_Height(ICoreApplicationViewTitleBar *iface, DOUBLE *value)
+{ *value = 0; return S_OK; }
+
+static HRESULT WINAPI title_bar_add_LayoutMetricsChanged(ICoreApplicationViewTitleBar *iface,
+        __FITypedEventHandler_2_Windows__CApplicationModel__CCore__CCoreApplicationViewTitleBar_IInspectable *handler,
+        EventRegistrationToken *token)
