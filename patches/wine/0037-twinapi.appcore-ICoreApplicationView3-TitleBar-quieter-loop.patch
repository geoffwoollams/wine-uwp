+    TRACE("iface %p, handler %p (event never raised).\n", iface, handler);
+    token->value = InterlockedIncrement(&event_token_counter);
+    return S_OK;
+}
+
+static HRESULT WINAPI title_bar_remove_IsVisibleChanged(ICoreApplicationViewTitleBar *iface, EventRegistrationToken token)
