+    title_bar_GetRuntimeClassName,
+    title_bar_GetTrustLevel,
+    title_bar_put_ExtendViewIntoTitleBar,
+    title_bar_get_ExtendViewIntoTitleBar,
+    title_bar_get_SystemOverlayLeftInset,
+    title_bar_get_SystemOverlayRightInset,
