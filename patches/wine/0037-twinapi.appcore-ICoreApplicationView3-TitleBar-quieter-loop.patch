     len = GetModuleFileNameW( NULL, manifest_path, MAX_PATH );
     if (!len || len >= MAX_PATH) return TRUE;
-    if (!(p = wcsrchr( manifest_path, '\\' ))) return TRUE;
-    p[1] = 0;
-    wcscpy( current_package.path, manifest_path );
-    p[0] = 0; /* path without trailing separator */
-    wcscpy( current_package.path, manifest_path );
-    p[0] = '\\';
-    wcscat( manifest_path, L"AppxManifest.xml" );
-
-    file = CreateFileW( manifest_path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    /* the package root is the nearest directory above the executable with the manifest: the executable can be in
+     * a subfolder (Gears of War 4's GearGame\Binaries\UWP64\GearGame.exe) */
+    file = INVALID_HANDLE_VALUE;
+    for (i = 0; i < 8 && file == INVALID_HANDLE_VALUE && (p = wcsrchr( manifest_path, '\\' )); i++)
+    {
+        p[0] = 0; /* the directory, without its trailing separator */
+        if (wcslen( manifest_path ) + 18 >= MAX_PATH) break;
+        wcscpy( current_package.path, manifest_path );
+        wcscat( manifest_path, L"\\AppxManifest.xml" );
+        file = CreateFileW( manifest_path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+        if ((p = wcsrchr( manifest_path, '\\' ))) p[0] = 0;   /* back to the directory */
+        if (file == INVALID_HANDLE_VALUE) continue;
+        TRACE( "package manifest in %s.\n", debugstr_w(current_package.path) );
+    }
     if (file == INVALID_HANDLE_VALUE) return TRUE;
     if (!GetFileSizeEx( file, &size ) || size.QuadPart > 1024 * 1024 || !(data = HeapAlloc( GetProcessHeap(), 0, size.QuadPart + 1 )))
     {
