+/* ---- DateTimeFormatter ---- */
+
+struct formatter
+{
+    IDateTimeFormatter IDateTimeFormatter_iface;
+    IDateTimeFormatter2 IDateTimeFormatter2_iface;
+    LONG ref;
+    WCHAR *template;    /* as given, or made from the parts below */
+    BOOL pattern;       /* the template is a {pattern} */
+    YearFormat year;
+    MonthFormat month;
+    DayFormat day;
+    DayOfWeekFormat day_of_week;
+    HourFormat hour;
+    MinuteFormat minute;
+    SecondFormat second;
+    WCHAR locale[LOCALE_NAME_MAX_LENGTH];
+};
+
+static inline struct formatter *impl_from_IDateTimeFormatter( IDateTimeFormatter *iface )
+{
+    return CONTAINING_RECORD( iface, struct formatter, IDateTimeFormatter_iface );
+}
+
+static HRESULT WINAPI formatter_QueryInterface( IDateTimeFormatter *iface, REFIID iid, void **out )
+{
+    struct formatter *impl = impl_from_IDateTimeFormatter( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDateTimeFormatter ))
+        *out = &impl->IDateTimeFormatter_iface;
+    else if (IsEqualGUID( iid, &IID_IDateTimeFormatter2 ))
+        *out = &impl->IDateTimeFormatter2_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI formatter_AddRef( IDateTimeFormatter *iface )
+{
+    return InterlockedIncrement( &impl_from_IDateTimeFormatter( iface )->ref );
+}
+
+static ULONG WINAPI formatter_Release( IDateTimeFormatter *iface )
+{
+    struct formatter *impl = impl_from_IDateTimeFormatter( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        free( impl->template );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI formatter_GetIids( IDateTimeFormatter *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI formatter_GetRuntimeClassName( IDateTimeFormatter *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Globalization_DateTimeFormatting_DateTimeFormatter,
+                                wcslen( RuntimeClass_Windows_Globalization_DateTimeFormatting_DateTimeFormatter ), name );
+}
+
+static HRESULT WINAPI formatter_GetTrustLevel( IDateTimeFormatter *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI formatter_get_Languages( IDateTimeFormatter *iface, IVectorView_HSTRING **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return string_view_create( impl_from_IDateTimeFormatter( iface )->locale, value );
+}
+
+static HRESULT region( struct formatter *impl, HSTRING *value )
+{
+    WCHAR name[16];
+    if (!GetLocaleInfoEx( impl->locale, LOCALE_SISO3166CTRYNAME, name, ARRAY_SIZE(name) )) lstrcpyW( name, L"US" );
+    return WindowsCreateString( name, wcslen( name ), value );
+}
+
+static HRESULT WINAPI formatter_get_GeographicRegion( IDateTimeFormatter *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return region( impl_from_IDateTimeFormatter( iface ), value );
+}
+
+static HRESULT WINAPI formatter_get_Calendar( IDateTimeFormatter *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return WindowsCreateString( L"GregorianCalendar", 17, value );
+}
+
+static HRESULT WINAPI formatter_get_Clock( IDateTimeFormatter *iface, HSTRING *value )
+{
+    struct formatter *impl = impl_from_IDateTimeFormatter( iface );
+    WCHAR format[80];
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    /* a time format with H (not h) is a 24-hour clock */
+    if (GetLocaleInfoEx( impl->locale, LOCALE_STIMEFORMAT, format, ARRAY_SIZE(format) ) && wcschr( format, 'H' ))
+        return WindowsCreateString( L"24HourClock", 11, value );
+    return WindowsCreateString( L"12HourClock", 11, value );
+}
+
+static HRESULT WINAPI formatter_get_NumeralSystem( IDateTimeFormatter *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return WindowsCreateString( L"Latn", 4, value );
+}
+
+static HRESULT WINAPI formatter_put_NumeralSystem( IDateTimeFormatter *iface, HSTRING value )
+{
+    FIXME( "iface %p, value %s: only Latn digits.\n", iface, debugstr_hstring(value) );
+    return S_OK;
+}
+
+static HRESULT WINAPI formatter_get_Patterns( IDateTimeFormatter *iface, IVectorView_HSTRING **value )
+{
+    struct formatter *impl = impl_from_IDateTimeFormatter( iface );
+    FIXME( "iface %p, value %p: the template %s.\n", iface, value, debugstr_w(impl->template) );
+    return string_view_create( impl->template, value );
+}
+
+static HRESULT WINAPI formatter_get_Template( IDateTimeFormatter *iface, HSTRING *value )
+{
+    struct formatter *impl = impl_from_IDateTimeFormatter( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    return WindowsCreateString( impl->template, wcslen( impl->template ), value );
+}
+
+/* appends the formatted date (date format picture) or time (time picture) to buf */
+static void append( WCHAR *buf, SIZE_T size, const WCHAR *locale, const SYSTEMTIME *st, BOOL time, DWORD flags,
+                    const WCHAR *picture )
+{
+    SIZE_T len = wcslen( buf );
+    if (len + 1 >= size) return;
+    if (time) GetTimeFormatEx( locale, flags, st, picture, buf + len, size - len );
+    else GetDateFormatEx( locale, flags, st, picture, buf + len, size - len, NULL );
+}
+
+static void append_text( WCHAR *buf, SIZE_T size, const WCHAR *text, SIZE_T count )
+{
+    SIZE_T len = wcslen( buf );
+    if (len + count + 1 > size) count = size - len - 1;
+    memcpy( buf + len, text, count * sizeof(WCHAR) );
+    buf[len + count] = 0;
+}
+
+/* one {part} of a pattern: "month.full", "day.integer(2)", "hour", "period.abbreviated", ... */
+static void format_part( WCHAR *buf, SIZE_T size, const WCHAR *locale, const SYSTEMTIME *st, const WCHAR *part, SIZE_T len )
+{
+    static const struct { const WCHAR *name; BOOL time; const WCHAR *picture; } parts[] =
+    {
+        { L"year.full", FALSE, L"yyyy" }, { L"year.abbreviated", FALSE, L"yy" }, { L"year", FALSE, L"yyyy" },
+        { L"month.full", FALSE, L"MMMM" }, { L"month.abbreviated", FALSE, L"MMM" }, { L"month.solo.full", FALSE, L"MMMM" },
+        { L"month.solo.abbreviated", FALSE, L"MMM" }, { L"month.integer(2)", FALSE, L"MM" },
+        { L"month.integer", FALSE, L"M" }, { L"month", FALSE, L"MMMM" },
+        { L"day.integer(2)", FALSE, L"dd" }, { L"day.integer", FALSE, L"d" }, { L"day", FALSE, L"d" },
+        { L"dayofweek.full", FALSE, L"dddd" }, { L"dayofweek.abbreviated", FALSE, L"ddd" },
+        { L"dayofweek.solo.full", FALSE, L"dddd" }, { L"dayofweek.solo.abbreviated", FALSE, L"ddd" },
+        { L"dayofweek", FALSE, L"dddd" },
+        { L"hour.integer(2)", TRUE, L"hh" }, { L"hour.integer", TRUE, L"h" }, { L"hour", TRUE, L"h" },
+        { L"minute.integer(2)", TRUE, L"mm" }, { L"minute.integer", TRUE, L"m" }, { L"minute", TRUE, L"mm" },
+        { L"second.integer(2)", TRUE, L"ss" }, { L"second.integer", TRUE, L"s" }, { L"second", TRUE, L"ss" },
+        { L"period.abbreviated", TRUE, L"tt" }, { L"period", TRUE, L"tt" },
+    };
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(parts); i++)
+    {
+        if (wcslen( parts[i].name ) != len || wcsnicmp( parts[i].name, part, len )) continue;
+        append( buf, size, locale, st, parts[i].time, 0, parts[i].picture );
+        return;
+    }
+    FIXME( "unknown pattern part %s.\n", debugstr_wn(part, len) );
+}
+
+static void format_pattern( struct formatter *impl, const SYSTEMTIME *st, WCHAR *buf, SIZE_T size )
+{
+    const WCHAR *p = impl->template, *end;
+
+    while (*p)
+    {
+        if (*p == '{' && (end = wcschr( p, '}' )))
+        {
+            format_part( buf, size, impl->locale, st, p + 1, end - p - 1 );
+            p = end + 1;
+        }
+        else
+        {
+            SIZE_T n = wcscspn( p, L"{" );
+            if (!n) n = 1;
+            append_text( buf, size, p, n );
+            p += n;
+        }
+    }
+}
+
+/* the locale's own formats for the parts asked for */
+static void format_parts( struct formatter *impl, const SYSTEMTIME *st, WCHAR *buf, SIZE_T size )
+{
+    BOOL year = impl->year != YearFormat_None, month = impl->month != MonthFormat_None;
+    BOOL day = impl->day != DayFormat_None, dow = impl->day_of_week != DayOfWeekFormat_None;
+    BOOL date = year || month || day || dow;
+
+    if (year && month && day)
+    {
+        if (dow || impl->month == MonthFormat_Full || impl->month == MonthFormat_Abbreviated)
+            append( buf, size, impl->locale, st, FALSE, DATE_LONGDATE, NULL );
+        else append( buf, size, impl->locale, st, FALSE, DATE_SHORTDATE, NULL );
+    }
+    else if (year && month) append( buf, size, impl->locale, st, FALSE, DATE_YEARMONTH, NULL );
+    else if (month && day)
+    {
+        append( buf, size, impl->locale, st, FALSE, 0,
+                impl->month == MonthFormat_Numeric ? L"M/d" : impl->month == MonthFormat_Abbreviated ? L"MMM d" : L"MMMM d" );
+    }
+    else
+    {
+        if (dow) append( buf, size, impl->locale, st, FALSE, 0, impl->day_of_week == DayOfWeekFormat_Abbreviated ? L"ddd" : L"dddd" );
+        if (month)
+        {
+            if (dow) append_text( buf, size, L" ", 1 );
+            append( buf, size, impl->locale, st, FALSE, 0, impl->month == MonthFormat_Numeric ? L"M" :
+                    impl->month == MonthFormat_Abbreviated ? L"MMM" : L"MMMM" );
+        }
+        if (day)
+        {
+            if (dow || month) append_text( buf, size, L" ", 1 );
+            append( buf, size, impl->locale, st, FALSE, 0, L"d" );
+        }
+        if (year)
+        {
+            if (dow || month || day) append_text( buf, size, L" ", 1 );
+            append( buf, size, impl->locale, st, FALSE, 0, impl->year == YearFormat_Abbreviated ? L"yy" : L"yyyy" );
+        }
+    }
+
+    if (impl->hour != HourFormat_None || impl->minute != MinuteFormat_None || impl->second != SecondFormat_None)
+    {
+        if (date) append_text( buf, size, L" ", 1 );
+        if (impl->hour != HourFormat_None && impl->minute != MinuteFormat_None)
+            append( buf, size, impl->locale, st, TRUE, impl->second != SecondFormat_None ? 0 : TIME_NOSECONDS, NULL );
+        else if (impl->hour != HourFormat_None) append( buf, size, impl->locale, st, TRUE, TIME_NOMINUTESORSECONDS, NULL );
+        else
+        {
+            if (impl->minute != MinuteFormat_None) append( buf, size, impl->locale, st, TRUE, 0, L"mm" );
+            if (impl->second != SecondFormat_None) append( buf, size, impl->locale, st, TRUE, 0, L"ss" );
+        }
+    }
+}
+
+static HRESULT format( struct formatter *impl, DateTime value, HSTRING *result )
+{
+    SYSTEMTIME utc, local;
+    FILETIME ft;
+    WCHAR buf[256] = {0};
+
+    ft.dwLowDateTime = value.UniversalTime;
+    ft.dwHighDateTime = value.UniversalTime >> 32;
+    if (!FileTimeToSystemTime( &ft, &utc ) || !SystemTimeToTzSpecificLocalTime( NULL, &utc, &local ))
+        return E_INVALIDARG;
+    if (impl->pattern) format_pattern( impl, &local, buf, ARRAY_SIZE(buf) );
+    else format_parts( impl, &local, buf, ARRAY_SIZE(buf) );
+    TRACE( "%s: %s.\n", debugstr_w(impl->template), debugstr_w(buf) );
+    return WindowsCreateString( buf, wcslen( buf ), result );
+}
+
+static HRESULT WINAPI formatter_Format( IDateTimeFormatter *iface, DateTime value, HSTRING *result )
+{
+    TRACE( "iface %p, value %I64d, result %p.\n", iface, value.UniversalTime, result );
+    return format( impl_from_IDateTimeFormatter( iface ), value, result );
+}
