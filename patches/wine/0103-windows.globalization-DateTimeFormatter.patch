+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "initguid.h"
+#define WIDL_using_Windows_Globalization_DateTimeFormatting
+#include "windows.globalization.datetimeformatting.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(locale);
+
+/* ---- IVectorView<String> of one string: Languages and Patterns ---- */
+
+struct string_view
+{
+    IVectorView_HSTRING IVectorView_HSTRING_iface;
+    LONG ref;
+    HSTRING str;
+};
+
+static inline struct string_view *impl_from_IVectorView_HSTRING( IVectorView_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_view, IVectorView_HSTRING_iface );
+}
+
+static HRESULT WINAPI view_QueryInterface( IVectorView_HSTRING *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVectorView_HSTRING ))
+    {
+        IVectorView_HSTRING_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI view_AddRef( IVectorView_HSTRING *iface )
+{
+    return InterlockedIncrement( &impl_from_IVectorView_HSTRING( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( IVectorView_HSTRING *iface )
+{
+    struct string_view *impl = impl_from_IVectorView_HSTRING( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->str );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_GetIids( IVectorView_HSTRING *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI view_GetRuntimeClassName( IVectorView_HSTRING *iface, HSTRING *name ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI view_GetTrustLevel( IVectorView_HSTRING *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetAt( IVectorView_HSTRING *iface, UINT32 index, HSTRING *value )
+{
+    *value = NULL;
+    if (index) return E_BOUNDS;
+    return WindowsDuplicateString( impl_from_IVectorView_HSTRING( iface )->str, value );
+}
+
+static HRESULT WINAPI view_get_Size( IVectorView_HSTRING *iface, UINT32 *value )
+{
+    *value = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_IndexOf( IVectorView_HSTRING *iface, HSTRING element, UINT32 *index, boolean *found )
+{
+    INT32 order = 1;
+    WindowsCompareStringOrdinal( element, impl_from_IVectorView_HSTRING( iface )->str, &order );
+    *index = 0;
+    *found = !order;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetMany( IVectorView_HSTRING *iface, UINT32 start, UINT32 size, HSTRING *items, UINT32 *count )
+{
+    *count = 0;
+    if (start || !size) return S_OK;
+    *count = 1;
+    return WindowsDuplicateString( impl_from_IVectorView_HSTRING( iface )->str, items );
+}
+
+static const struct IVectorView_HSTRINGVtbl view_vtbl =
+{
+    view_QueryInterface,
+    view_AddRef,
+    view_Release,
+    view_GetIids,
+    view_GetRuntimeClassName,
+    view_GetTrustLevel,
+    view_GetAt,
+    view_get_Size,
+    view_IndexOf,
+    view_GetMany,
+};
+
+static HRESULT string_view_create( const WCHAR *str, IVectorView_HSTRING **out )
+{
+    struct string_view *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVectorView_HSTRING_iface.lpVtbl = &view_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = WindowsCreateString( str, wcslen( str ), &impl->str )))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = &impl->IVectorView_HSTRING_iface;
+    return S_OK;
+}
