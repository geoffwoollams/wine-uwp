+static struct formatter *formatter_alloc(void)
+{
+    struct formatter *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IDateTimeFormatter_iface.lpVtbl = &formatter_vtbl;
+    impl->IDateTimeFormatter2_iface.lpVtbl = &formatter2_vtbl;
+    impl->ref = 1;
+    if (!GetUserDefaultLocaleName( impl->locale, ARRAY_SIZE(impl->locale) )) lstrcpyW( impl->locale, L"en-US" );
+    return impl;
+}
+
+/* "shortdate shorttime", "month day", "dayofweek.abbreviated", "year.full month.full", ... */
+static BOOL parse_keywords( struct formatter *impl, const WCHAR *template )
+{
+    const WCHAR *p = template;
+    WCHAR word[64];
+    SIZE_T len;
+
+    while (*p)
+    {
+        while (*p == ' ') p++;
+        if (!*p) break;
+        len = wcscspn( p, L" " );
+        if (len >= ARRAY_SIZE(word)) return FALSE;
+        memcpy( word, p, len * sizeof(WCHAR) );
+        word[len] = 0;
+        p += len;
+
+        if (!wcsicmp( word, L"shortdate" )) impl->year = impl->month = impl->day = 1;
+        else if (!wcsicmp( word, L"longdate" ))
+        {
+            impl->year = YearFormat_Full;
+            impl->month = MonthFormat_Full;
+            impl->day = DayFormat_Default;
+            impl->day_of_week = DayOfWeekFormat_Full;
+        }
+        else if (!wcsicmp( word, L"shorttime" )) impl->hour = impl->minute = 1;
+        else if (!wcsicmp( word, L"longtime" )) impl->hour = impl->minute = impl->second = 1;
+        else if (!wcsicmp( word, L"year" ) || !wcsicmp( word, L"year.full" )) impl->year = YearFormat_Full;
+        else if (!wcsicmp( word, L"year.abbreviated" )) impl->year = YearFormat_Abbreviated;
+        else if (!wcsicmp( word, L"month" ) || !wcsicmp( word, L"month.full" )) impl->month = MonthFormat_Full;
+        else if (!wcsicmp( word, L"month.abbreviated" )) impl->month = MonthFormat_Abbreviated;
+        else if (!wcsicmp( word, L"month.numeric" )) impl->month = MonthFormat_Numeric;
+        else if (!wcsicmp( word, L"day" )) impl->day = DayFormat_Default;
+        else if (!wcsicmp( word, L"dayofweek" ) || !wcsicmp( word, L"dayofweek.full" )) impl->day_of_week = DayOfWeekFormat_Full;
+        else if (!wcsicmp( word, L"dayofweek.abbreviated" )) impl->day_of_week = DayOfWeekFormat_Abbreviated;
+        else if (!wcsicmp( word, L"hour" )) impl->hour = HourFormat_Default;
+        else if (!wcsicmp( word, L"minute" )) impl->minute = MinuteFormat_Default;
+        else if (!wcsicmp( word, L"second" )) impl->second = SecondFormat_Default;
+        else
+        {
+            FIXME( "unknown template keyword %s.\n", debugstr_w(word) );
+            return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+static HRESULT formatter_create_template( const WCHAR *template, IDateTimeFormatter **out )
+{
+    struct formatter *impl;
+
+    *out = NULL;
+    if (!template || !*template) return E_INVALIDARG;
+    if (!(impl = formatter_alloc())) return E_OUTOFMEMORY;
+    if (!(impl->template = wcsdup( template )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    if (wcschr( template, '{' )) impl->pattern = TRUE;
+    else if (!parse_keywords( impl, template ))
+    {
+        IDateTimeFormatter_Release( &impl->IDateTimeFormatter_iface );
+        return E_INVALIDARG;
+    }
+    TRACE( "template %s -> %p.\n", debugstr_w(template), impl );
+    *out = &impl->IDateTimeFormatter_iface;
+    return S_OK;
+}
+
+static HRESULT formatter_create_parts( YearFormat year, MonthFormat month, DayFormat day, DayOfWeekFormat dow,
+                                       HourFormat hour, MinuteFormat minute, SecondFormat second, IDateTimeFormatter **out )
+{
+    WCHAR template[128] = {0};
+    struct formatter *impl;
+
+    *out = NULL;
+    if (!(impl = formatter_alloc())) return E_OUTOFMEMORY;
+    impl->year = year;
+    impl->month = month;
+    impl->day = day;
+    impl->day_of_week = dow;
+    impl->hour = hour;
+    impl->minute = minute;
+    impl->second = second;
+    /* the template these parts would have been asked for with */
+    if (dow) lstrcatW( template, dow == DayOfWeekFormat_Abbreviated ? L"dayofweek.abbreviated " : L"dayofweek " );
+    if (month) lstrcatW( template, month == MonthFormat_Abbreviated ? L"month.abbreviated " :
+                                    month == MonthFormat_Numeric ? L"month.numeric " : L"month " );
+    if (day) lstrcatW( template, L"day " );
+    if (year) lstrcatW( template, year == YearFormat_Abbreviated ? L"year.abbreviated " : L"year " );
+    if (hour) lstrcatW( template, L"hour " );
+    if (minute) lstrcatW( template, L"minute " );
+    if (second) lstrcatW( template, L"second " );
+    if (template[0]) template[wcslen( template ) - 1] = 0;
+    if (!(impl->template = wcsdup( template )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    *out = &impl->IDateTimeFormatter_iface;
+    return S_OK;
+}
