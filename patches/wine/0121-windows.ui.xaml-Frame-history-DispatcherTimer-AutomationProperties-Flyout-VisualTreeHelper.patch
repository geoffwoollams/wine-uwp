+static HRESULT flyout_create( IInspectable *outer, IInspectable **inner, IFlyout **value )
+{
+    struct flyout *impl;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (inner) *inner = NULL;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_inner.lpVtbl = &inner_vtbl;
+    impl->IFlyout_iface.lpVtbl = &flyout_iface_vtbl;
+    impl->IFlyoutBase_iface.lpVtbl = &flyout_base_vtbl;
+    impl->IDependencyObject_iface.lpVtbl = &flyout_do_vtbl;
+    impl->ref = 1;
+    impl->placement = FlyoutPlacementMode_Top;
+    impl->outer = outer ? outer : &impl->IInspectable_inner;
+    *value = &impl->IFlyout_iface;
+    if (outer)
+    {
+        *inner = &impl->IInspectable_inner;
+        IInspectable_AddRef( outer );
+    }
+    TRACE( "created %p, outer %p.\n", impl, outer );
