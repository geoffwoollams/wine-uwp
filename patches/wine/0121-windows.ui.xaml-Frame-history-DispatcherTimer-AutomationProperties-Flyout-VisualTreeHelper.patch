+/* AutomationProperties are attached properties kept in the property store, so that what an app sets it reads
+ * back. There is no UI Automation provider yet: nothing outside the app sees them. */
+
+static const WCHAR owner_name[] = L"Windows.UI.Xaml.Automation.AutomationProperties";
+
+static const struct vector_iids dependency_object_vector_iids =
+{
+    &IID___FIVector_1_Windows__CUI__CXaml__CDependencyObject,
+    &IID___FIVectorView_1_Windows__CUI__CXaml__CDependencyObject,
+    &IID___FIIterable_1_Windows__CUI__CXaml__CDependencyObject,
+    &IID___FIIterator_1_Windows__CUI__CXaml__CDependencyObject,
+    &IID_IDependencyObject,
+};
+
+static const struct vector_iids annotation_vector_iids =
+{
+    &IID___FIVector_1_Windows__CUI__CXaml__CAutomation__CAutomationAnnotation,
+    &IID___FIVectorView_1_Windows__CUI__CXaml__CAutomation__CAutomationAnnotation,
+    &IID___FIIterable_1_Windows__CUI__CXaml__CAutomation__CAutomationAnnotation,
+    &IID___FIIterator_1_Windows__CUI__CXaml__CAutomation__CAutomationAnnotation,
+    &IID_IAutomationAnnotation,
+};
