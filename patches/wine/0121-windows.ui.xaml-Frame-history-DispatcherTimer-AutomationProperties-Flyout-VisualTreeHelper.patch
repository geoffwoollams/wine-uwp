+/* markup: <Flyout> content and Placement */
+BOOL flyout_set_markup( IInspectable *target, const WCHAR *name, IInspectable *object, const WCHAR *str, INT32 number )
+{
+    IFlyout *flyout;
+    IFlyoutBase *base;
+    IUIElement *element;
+    BOOL done = FALSE;
+
+    if (!target || FAILED(IInspectable_QueryInterface( target, &IID_IFlyout, (void **)&flyout ))) return FALSE;
+    if (!wcscmp( name, L"Content" ) && object &&
+        SUCCEEDED(IInspectable_QueryInterface( object, &IID_IUIElement, (void **)&element )))
+    {
+        IFlyout_put_Content( flyout, element );
+        IUIElement_Release( element );
+        done = TRUE;
+    }
+    else if (!wcscmp( name, L"Placement" ) && (str || number >= 0) &&
+             SUCCEEDED(IFlyout_QueryInterface( flyout, &IID_IFlyoutBase, (void **)&base )))
+    {
+        static const WCHAR *const names[] =
+        {
+            L"Top", L"Bottom", L"Left", L"Right", L"Full", L"TopEdgeAlignedLeft", L"TopEdgeAlignedRight",
+            L"BottomEdgeAlignedLeft", L"BottomEdgeAlignedRight", L"LeftEdgeAlignedTop", L"LeftEdgeAlignedBottom",
+            L"RightEdgeAlignedTop", L"RightEdgeAlignedBottom", L"Auto",
+        };
+        UINT32 i;
+        if (str) for (i = 0; i < ARRAY_SIZE(names); i++) { if (!wcscmp( str, names[i] )) break; }
+        else i = number;
+        if (i < ARRAY_SIZE(names))
+        {
+            IFlyoutBase_put_Placement( base, i );
+            done = TRUE;
+        }
+        IFlyoutBase_Release( base );
+    }
+    IFlyout_Release( flyout );
+    return done;
+}
