+    navigating_args_get_NavigationMode,
+    navigating_args_get_SourcePageType,
+};
+
+HRESULT navigating_args_create( const TypeName *type, NavigationMode mode, INavigatingCancelEventArgs **out )
+{
+    struct navigating_args *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->INavigatingCancelEventArgs_iface.lpVtbl = &navigating_args_vtbl;
+    impl->ref = 1;
+    type_name_copy( &impl->type, type );
