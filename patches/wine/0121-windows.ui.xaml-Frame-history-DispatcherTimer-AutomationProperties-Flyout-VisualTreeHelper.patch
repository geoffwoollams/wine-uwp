+/* VisualTreeHelper walks our element tree: a template's parts are children of their control, as in WinUI.
+ * Hit tests use the arranged bounds (render transforms are not applied). There is no Popup class yet, so
+ * GetOpenPopups lists none: ContentDialogs and flyouts show in window layers of their own. */
+
+static IDependencyObject *dependency_object_of( struct xaml_element *element )
+{
+    IDependencyObject *object;
+
+    if (!element || FAILED(IInspectable_QueryInterface( element->outer, &IID_IDependencyObject, (void **)&object )))
+        return NULL;
+    return object;
+}
+
+static BOOL rect_hit( const struct layout_rect *b, const Rect *r )
+{
+    return r->X < b->x + b->width && r->Y < b->y + b->height && r->X + r->Width >= b->x && r->Y + r->Height >= b->y;
+}
+
+/* the elements at r, topmost first: children before their parent, later children before earlier ones */
+static void collect_hits( struct xaml_element *element, const Rect *r, BOOL all, IVector_UIElement *list )
+{
+    UINT32 i;
+
+    if (element->visibility != Visibility_Visible) return;
+    if (!all && !element->hit_test_visible) return;
+    if (element->ops->child_count)
+    {
+        for (i = element->ops->child_count( element ); i > 0; i--)
+        {
+            struct xaml_element *child = element->ops->child_at( element, i - 1 );
+            if (child) collect_hits( child, r, all, list );
+        }
+    }
+    if (rect_hit( &element->bounds, r )) IVector_UIElement_Append( list, &element->IUIElement_iface );
+}
+
+static HRESULT find_elements( Rect r, IUIElement *subtree, BOOL all, IIterable_UIElement **value )
+{
+    static const struct vector_callbacks callbacks;
+    struct xaml_element *root;
+    IInspectable *vector;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = vector_create( &uielement_collection_iids, &callbacks, NULL, &vector ))) return hr;
+    if (subtree && (root = element_from_iinspectable( (IInspectable *)subtree )))
+        collect_hits( root, &r, all, (IVector_UIElement *)vector );
+    hr = IInspectable_QueryInterface( vector, &IID___FIIterable_1_Windows__CUI__CXaml__CUIElement, (void **)value );
+    IInspectable_Release( vector );
+    return hr;
+}
