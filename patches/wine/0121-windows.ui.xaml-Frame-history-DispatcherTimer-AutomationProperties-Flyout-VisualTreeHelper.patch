diff --git a/dlls/windows.ui.xaml/timer.c b/dlls/windows.ui.xaml/timer.c
new file mode 100644
index 0000000..74f5793
--- /dev/null
+++ b/dlls/windows.ui.xaml/timer.c
@@ -0,0 +1,438 @@
+/* WinRT Windows.UI.Xaml.DispatcherTimer implementation
+ *
+ * Copyright 2026 wine-uwp contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+#undef Duration   /* Windows.UI.Xaml.Duration, not the TimeSpan field */
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A DispatcherTimer raises Tick on the thread that started it (the UI thread), from a thread timer that the message
+ * loop dispatches. A running timer keeps itself alive, as in WinUI, until it is stopped. */
+
+struct dispatcher_timer
+{
+    IInspectable IInspectable_inner;
+    IDispatcherTimer IDispatcherTimer_iface;
+    IInspectable *outer;
+    LONG ref;
+    TimeSpan interval;
+    UINT_PTR id;               /* the thread timer while running, or 0 */
+    struct event_list tick;
+    struct dispatcher_timer *next;
+};
+
+static CRITICAL_SECTION timers_cs;
+static CRITICAL_SECTION_DEBUG timers_cs_debug =
+{
+    0, 0, &timers_cs,
+    { &timers_cs_debug.ProcessLocksList, &timers_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": timers_cs") }
+};
+static CRITICAL_SECTION timers_cs = { &timers_cs_debug, -1, 0, 0, 0, 0 };
+static struct dispatcher_timer *running;
+
+static inline struct dispatcher_timer *impl_from_IInspectable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct dispatcher_timer, IInspectable_inner );
+}
+
+static inline struct dispatcher_timer *impl_from_IDispatcherTimer( IDispatcherTimer *iface )
+{
+    return CONTAINING_RECORD( iface, struct dispatcher_timer, IDispatcherTimer_iface );
+}
+
+static UINT timer_ms( const TimeSpan *interval )
+{
+    /* TimeSpan is in 100 ns units; Tick comes no sooner than the next message loop pass */
+    INT64 ms = interval->Duration / 10000;
+    if (ms < USER_TIMER_MINIMUM) ms = USER_TIMER_MINIMUM;
+    if (ms > USER_TIMER_MAXIMUM) ms = USER_TIMER_MAXIMUM;
+    return ms;
+}
+
+static void raise_tick( struct dispatcher_timer *impl )
+{
+    IUnknown **handlers;
+    UINT32 i, count;
+    HRESULT hr;
+
+    EnterCriticalSection( &timers_cs );
+    count = impl->tick.count;
+    if (!count || !(handlers = calloc( count, sizeof(*handlers) )))
+    {
+        LeaveCriticalSection( &timers_cs );
+        return;
+    }
+    for (i = 0; i < count; i++) if ((handlers[i] = impl->tick.handlers[i])) IUnknown_AddRef( handlers[i] );
+    LeaveCriticalSection( &timers_cs );
+
+    for (i = 0; i < count; i++)
+    {
+        if (!handlers[i]) continue;
+        hr = IEventHandler_IInspectable_Invoke( (IEventHandler_IInspectable *)handlers[i], impl->outer, NULL );
+        if (FAILED(hr)) WARN( "Tick handler %p failed, hr %#lx.\n", handlers[i], hr );
+    }
+    for (i = 0; i < count; i++) if (handlers[i]) IUnknown_Release( handlers[i] );
+    free( handlers );
+}
+
+static void CALLBACK timer_proc( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    struct dispatcher_timer *impl;
+
+    EnterCriticalSection( &timers_cs );
+    for (impl = running; impl; impl = impl->next) if (impl->id == id) break;
+    if (impl) IInspectable_AddRef( impl->outer );
+    LeaveCriticalSection( &timers_cs );
+    if (!impl)
+    {
+        KillTimer( NULL, id );
+        return;
+    }
+    raise_tick( impl );
+    IInspectable_Release( impl->outer );
+}
+
+/* takes timers_cs */
+static void timer_stop( struct dispatcher_timer *impl )
+{
+    struct dispatcher_timer **p;
+
+    if (!impl->id) return;
+    KillTimer( NULL, impl->id );
+    impl->id = 0;
+    for (p = &running; *p; p = &(*p)->next) if (*p == impl) { *p = impl->next; break; }
+    impl->next = NULL;
+}
+
+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct dispatcher_timer *impl = impl_from_IInspectable( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = &impl->IInspectable_inner;
+    else if (IsEqualGUID( iid, &IID_IDispatcherTimer ))
+        *out = &impl->IDispatcherTimer_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IInspectable( iface )->ref );
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct dispatcher_timer *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        EnterCriticalSection( &timers_cs );
+        timer_stop( impl );
+        LeaveCriticalSection( &timers_cs );
+        event_list_clear( &impl->tick );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI inner_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI inner_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Xaml_DispatcherTimer;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI inner_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const struct IInspectableVtbl inner_vtbl =
+{
+    inner_QueryInterface,
+    inner_AddRef,
+    inner_Release,
+    /* IInspectable methods */
+    inner_GetIids,
+    inner_GetRuntimeClassName,
+    inner_GetTrustLevel,
+};
+
+DEFINE_IINSPECTABLE_( timer, IDispatcherTimer, struct dispatcher_timer, impl_from_IDispatcherTimer_, IDispatcherTimer_iface,
+                      impl->outer )
+
+static HRESULT WINAPI timer_get_Interval( IDispatcherTimer *iface, TimeSpan *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IDispatcherTimer( iface )->interval;
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_put_Interval( IDispatcherTimer *iface, TimeSpan value )
+{
+    struct dispatcher_timer *impl = impl_from_IDispatcherTimer( iface );
+
+    TRACE( "iface %p, value %I64d.\n", iface, value.Duration );
+    if (value.Duration < 0) return E_INVALIDARG;
+    EnterCriticalSection( &timers_cs );
+    impl->interval = value;
+    /* a running timer goes on at the new interval */
+    if (impl->id) SetTimer( NULL, impl->id, timer_ms( &value ), timer_proc );
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_get_IsEnabled( IDispatcherTimer *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IDispatcherTimer( iface )->id != 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_add_Tick( IDispatcherTimer *iface, IEventHandler_IInspectable *handler,
+                                      EventRegistrationToken *token )
+{
+    struct dispatcher_timer *impl = impl_from_IDispatcherTimer( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    if (!handler || !token) return E_POINTER;
+    EnterCriticalSection( &timers_cs );
+    hr = event_list_add( &impl->tick, (IUnknown *)handler, token );
+    LeaveCriticalSection( &timers_cs );
+    return hr;
+}
+
+static HRESULT WINAPI timer_remove_Tick( IDispatcherTimer *iface, EventRegistrationToken token )
+{
+    struct dispatcher_timer *impl = impl_from_IDispatcherTimer( iface );
+    HRESULT hr;
+
+    EnterCriticalSection( &timers_cs );
+    hr = event_list_remove( &impl->tick, token );
+    LeaveCriticalSection( &timers_cs );
+    return hr;
+}
+
+static HRESULT WINAPI timer_Start( IDispatcherTimer *iface )
+{
+    struct dispatcher_timer *impl = impl_from_IDispatcherTimer( iface );
+    UINT_PTR id;
+
+    TRACE( "iface %p, interval %I64d.\n", iface, impl->interval.Duration );
+
+    EnterCriticalSection( &timers_cs );
+    if (impl->id)
+    {
+        /* Start on a running timer restarts the interval */
+        SetTimer( NULL, impl->id, timer_ms( &impl->interval ), timer_proc );
+        LeaveCriticalSection( &timers_cs );
+        return S_OK;
+    }
+    if (!(id = SetTimer( NULL, 0, timer_ms( &impl->interval ), timer_proc )))
+    {
+        LeaveCriticalSection( &timers_cs );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    impl->id = id;
+    impl->next = running;
+    running = impl;
+    LeaveCriticalSection( &timers_cs );
+    IInspectable_AddRef( impl->outer );   /* kept alive while running */
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_Stop( IDispatcherTimer *iface )
+{
+    struct dispatcher_timer *impl = impl_from_IDispatcherTimer( iface );
+    BOOL was_running;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &timers_cs );
+    was_running = impl->id != 0;
+    timer_stop( impl );
+    LeaveCriticalSection( &timers_cs );
+    if (was_running) IInspectable_Release( impl->outer );
+    return S_OK;
+}
+
+static const struct IDispatcherTimerVtbl timer_vtbl =
+{
+    timer_QueryInterface,
+    timer_AddRef,
+    timer_Release,
+    /* IInspectable methods */
+    timer_GetIids,
+    timer_GetRuntimeClassName,
+    timer_GetTrustLevel,
+    /* IDispatcherTimer methods */
+    timer_get_Interval,
+    timer_put_Interval,
+    timer_get_IsEnabled,
+    timer_add_Tick,
+    timer_remove_Tick,
+    timer_Start,
+    timer_Stop,
+};
+
+static HRESULT timer_create( IInspectable *outer, IInspectable **inner, IDispatcherTimer **value )
+{
+    struct dispatcher_timer *impl;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (inner) *inner = NULL;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_inner.lpVtbl = &inner_vtbl;
+    impl->IDispatcherTimer_iface.lpVtbl = &timer_vtbl;
+    impl->ref = 1;
+    impl->outer = outer ? outer : &impl->IInspectable_inner;
+    if (outer)
+    {
+        /* the outer object holds the inner one; our default interface refers to the outer */
+        *inner = &impl->IInspectable_inner;
+        *value = &impl->IDispatcherTimer_iface;
+        IInspectable_AddRef( outer );
+    }
+    else *value = &impl->IDispatcherTimer_iface;
+    TRACE( "created %p, outer %p.\n", impl, outer );
+    return S_OK;
+}
+
+/* the factory: IActivationFactory and the composable IDispatcherTimerFactory */
+
+struct timer_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IDispatcherTimerFactory IDispatcherTimerFactory_iface;
+};
+
+static inline struct timer_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct timer_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct timer_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IDispatcherTimerFactory ))
+        *out = &impl->IDispatcherTimerFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return timer_create( NULL, NULL, (IDispatcherTimer **)instance );
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( timer_factory, IDispatcherTimerFactory, struct timer_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI timer_factory_CreateInstance( IDispatcherTimerFactory *iface, IInspectable *outer,
+                                                    IInspectable **inner, IDispatcherTimer **value )
+{
+    TRACE( "iface %p, outer %p, inner %p, value %p.\n", iface, outer, inner, value );
+    return timer_create( outer, inner, value );
+}
+
+static const struct IDispatcherTimerFactoryVtbl timer_factory_vtbl =
+{
+    timer_factory_QueryInterface,
+    timer_factory_AddRef,
+    timer_factory_Release,
+    /* IInspectable methods */
+    timer_factory_GetIids,
+    timer_factory_GetRuntimeClassName,
+    timer_factory_GetTrustLevel,
+    /* IDispatcherTimerFactory methods */
+    timer_factory_CreateInstance,
+};
+
+static struct timer_statics timer_statics = { {&factory_vtbl}, {&timer_factory_vtbl} };
+
+IActivationFactory *dispatcher_timer_factory = &timer_statics.IActivationFactory_iface;
