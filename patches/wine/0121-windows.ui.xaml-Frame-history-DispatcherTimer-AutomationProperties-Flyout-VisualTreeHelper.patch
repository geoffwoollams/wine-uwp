+static void type_name_copy( TypeName *dst, const TypeName *src )
+{
+    dst->Kind = src->Kind;
+    WindowsDuplicateString( src->Name, &dst->Name );
+}
+
+static HRESULT type_name_get( const TypeName *src, TypeName *value )
+{
+    if (!value) return E_POINTER;
+    value->Kind = src->Kind;
+    return WindowsDuplicateString( src->Name, &value->Name );
+}
