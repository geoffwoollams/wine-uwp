+/* an attached property of a built-in class whose values live in the property store (AutomationProperties), the
+ * same object each time; not referenced (it is never freed) */
+IDependencyProperty *dp_attached( const WCHAR *owner, const WCHAR *name, const WCHAR *type )
+{
+    struct dependency_property *impl;
+
+    EnterCriticalSection( &dp_cs );
+    for (impl = properties; impl; impl = impl->next)
+        if (!impl->builtin && impl->attached && !wcscmp( impl->owner, owner ) && !wcscmp( impl->name, name )) break;
+    LeaveCriticalSection( &dp_cs );
+    if (!impl && !(impl = dp_new( owner, name, type, NULL, TRUE, FALSE ))) return NULL;
+    return &impl->IDependencyProperty_iface;
+}
