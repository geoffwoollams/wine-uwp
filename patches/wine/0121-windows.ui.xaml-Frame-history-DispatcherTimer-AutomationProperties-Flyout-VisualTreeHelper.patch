+DEFINE_IINSPECTABLE_( flyout_iface, IFlyout, struct flyout, impl_from_IFlyout, IFlyout_iface, impl->outer )
+
+static HRESULT WINAPI flyout_iface_get_Content( IFlyout *iface, IUIElement **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = impl_from_IFlyout( iface )->content)) IUIElement_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI flyout_iface_put_Content( IFlyout *iface, IUIElement *value )
+{
+    struct flyout *impl = impl_from_IFlyout( iface );
+    struct xaml_element *old = flyout_content( impl ), *content;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (old && impl->layer && old->parent == &impl->layer->element) element_set_parent( old, NULL );
+    if (value) IUIElement_AddRef( value );
+    if (impl->content) IUIElement_Release( impl->content );
+    impl->content = value;
+    if (impl->layer && (content = flyout_content( impl ))) element_set_parent( content, &impl->layer->element );
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI flyout_iface_get_FlyoutPresenterStyle( IFlyout *iface, IStyle **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = impl_from_IFlyout( iface )->presenter_style)) IStyle_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI flyout_iface_put_FlyoutPresenterStyle( IFlyout *iface, IStyle *value )
+{
+    struct flyout *impl = impl_from_IFlyout( iface );
+
+    FIXME( "iface %p, value %p: kept, not applied.\n", iface, value );
+    if (value) IStyle_AddRef( value );
+    if (impl->presenter_style) IStyle_Release( impl->presenter_style );
+    impl->presenter_style = value;
+    return S_OK;
+}
