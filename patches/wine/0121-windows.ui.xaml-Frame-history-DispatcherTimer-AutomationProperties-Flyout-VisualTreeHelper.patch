+static const struct IPageStackEntryVtbl entry_vtbl =
+{
+    entry_QueryInterface,
+    entry_AddRef,
+    entry_Release,
+    /* IInspectable methods */
+    entry_GetIids,
+    entry_GetRuntimeClassName,
+    entry_GetTrustLevel,
+    /* IPageStackEntry methods */
+    entry_get_SourcePageType,
+    entry_get_Parameter,
+    entry_get_NavigationTransitionInfo,
+};
+
+HRESULT page_entry_create( const TypeName *type, IInspectable *parameter, INavigationTransitionInfo *transition,
+                           IInspectable *page, IPageStackEntry **out )
+{
+    struct page_entry *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPageStackEntry_iface.lpVtbl = &entry_vtbl;
+    impl->ref = 1;
+    type_name_copy( &impl->type, type );
+    if ((impl->parameter = parameter)) IInspectable_AddRef( parameter );
+    if ((impl->transition = transition)) INavigationTransitionInfo_AddRef( transition );
+    if ((impl->page = page)) IInspectable_AddRef( page );
+    *out = &impl->IPageStackEntry_iface;
+    return S_OK;
+}
