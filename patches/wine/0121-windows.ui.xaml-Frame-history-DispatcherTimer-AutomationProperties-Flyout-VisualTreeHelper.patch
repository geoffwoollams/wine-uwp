+/* PageStackEntry: one page in a Frame's back or forward stack. The frame may keep the page itself (its
+ * NavigationCacheMode is not Disabled), so that going back shows the same instance. */
+
+struct page_entry
+{
+    IPageStackEntry IPageStackEntry_iface;
+    LONG ref;
+    TypeName type;
+    IInspectable *parameter;
+    INavigationTransitionInfo *transition;
+    IInspectable *page;
+};
+
+static inline struct page_entry *impl_from_IPageStackEntry( IPageStackEntry *iface )
+{
+    return CONTAINING_RECORD( iface, struct page_entry, IPageStackEntry_iface );
+}
+
+static HRESULT WINAPI entry_QueryInterface( IPageStackEntry *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IPageStackEntry ))
+    {
+        *out = iface;
+        IPageStackEntry_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI entry_AddRef( IPageStackEntry *iface )
+{
+    return InterlockedIncrement( &impl_from_IPageStackEntry( iface )->ref );
+}
+
+static ULONG WINAPI entry_Release( IPageStackEntry *iface )
+{
+    struct page_entry *impl = impl_from_IPageStackEntry( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->type.Name );
+        if (impl->parameter) IInspectable_Release( impl->parameter );
+        if (impl->transition) INavigationTransitionInfo_Release( impl->transition );
+        if (impl->page) IInspectable_Release( impl->page );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI entry_GetIids( IPageStackEntry *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
