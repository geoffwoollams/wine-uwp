+    TRACE( "iface %p, reference %p.\n", iface, reference );
+    if (!value) return E_POINTER;
+    if (!reference) return E_INVALIDARG;
+    *value = element ? dependency_object_of( element->parent ) : NULL;
+    return S_OK;
