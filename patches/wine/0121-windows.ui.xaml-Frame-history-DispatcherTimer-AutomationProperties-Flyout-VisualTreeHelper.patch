+/* NavigationFailedEventArgs: NavigationFailed, when the page can't be created */
+
+struct failed_args
+{
+    INavigationFailedEventArgs INavigationFailedEventArgs_iface;
+    LONG ref;
+    HRESULT error;
+    boolean handled;
+    TypeName type;
+};
+
+static inline struct failed_args *impl_from_INavigationFailedEventArgs( INavigationFailedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct failed_args, INavigationFailedEventArgs_iface );
+}
+
+static HRESULT WINAPI failed_args_QueryInterface( INavigationFailedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_INavigationFailedEventArgs ))
+    {
+        *out = iface;
+        INavigationFailedEventArgs_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI failed_args_AddRef( INavigationFailedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_INavigationFailedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI failed_args_Release( INavigationFailedEventArgs *iface )
+{
+    struct failed_args *impl = impl_from_INavigationFailedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->type.Name );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI failed_args_GetIids( INavigationFailedEventArgs *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI failed_args_GetRuntimeClassName( INavigationFailedEventArgs *iface, HSTRING *value )
+{
+    return class_name( RuntimeClass_Windows_UI_Xaml_Navigation_NavigationFailedEventArgs, value );
+}
+
+static HRESULT WINAPI failed_args_GetTrustLevel( INavigationFailedEventArgs *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI failed_args_get_Exception( INavigationFailedEventArgs *iface, HRESULT *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_INavigationFailedEventArgs( iface )->error;
+    return S_OK;
+}
+
+static HRESULT WINAPI failed_args_get_Handled( INavigationFailedEventArgs *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_INavigationFailedEventArgs( iface )->handled;
+    return S_OK;
+}
+
+static HRESULT WINAPI failed_args_put_Handled( INavigationFailedEventArgs *iface, boolean value )
+{
+    impl_from_INavigationFailedEventArgs( iface )->handled = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI failed_args_get_SourcePageType( INavigationFailedEventArgs *iface, TypeName *value )
+{
+    return type_name_get( &impl_from_INavigationFailedEventArgs( iface )->type, value );
+}
+
+static const struct INavigationFailedEventArgsVtbl failed_args_vtbl =
+{
+    failed_args_QueryInterface,
+    failed_args_AddRef,
+    failed_args_Release,
+    /* IInspectable methods */
+    failed_args_GetIids,
+    failed_args_GetRuntimeClassName,
+    failed_args_GetTrustLevel,
+    /* INavigationFailedEventArgs methods */
+    failed_args_get_Exception,
+    failed_args_get_Handled,
+    failed_args_put_Handled,
+    failed_args_get_SourcePageType,
+};
+
+HRESULT navigation_failed_args_create( const TypeName *type, HRESULT error, INavigationFailedEventArgs **out )
+{
+    struct failed_args *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->INavigationFailedEventArgs_iface.lpVtbl = &failed_args_vtbl;
+    impl->ref = 1;
+    impl->error = error;
+    type_name_copy( &impl->type, type );
+    *out = &impl->INavigationFailedEventArgs_iface;
+    return S_OK;
+}
+
+BOOL navigation_failed_args_handled( INavigationFailedEventArgs *args )
+{
+    return impl_from_INavigationFailedEventArgs( args )->handled;
+}
