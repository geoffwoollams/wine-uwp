+static inline struct automation_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct automation_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct automation_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics )) *out = &impl->IAutomationPropertiesStatics_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics2 )) *out = &impl->IAutomationPropertiesStatics2_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics3 )) *out = &impl->IAutomationPropertiesStatics3_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics4 )) *out = &impl->IAutomationPropertiesStatics4_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics5 )) *out = &impl->IAutomationPropertiesStatics5_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics6 )) *out = &impl->IAutomationPropertiesStatics6_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics7 )) *out = &impl->IAutomationPropertiesStatics7_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics8 )) *out = &impl->IAutomationPropertiesStatics8_iface;
+    else if (IsEqualGUID( iid, &IID_IAutomationPropertiesStatics9 )) *out = &impl->IAutomationPropertiesStatics9_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
