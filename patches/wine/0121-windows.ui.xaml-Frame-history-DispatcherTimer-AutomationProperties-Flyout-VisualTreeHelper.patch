+
+    if (!value) return E_POINTER;
+    if (!reference) return E_INVALIDARG;
+    *value = element && element->ops->child_count ? element->ops->child_count( element ) : 0;
+    TRACE( "iface %p, reference %p -> %d.\n", iface, reference, *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_GetParent( IVisualTreeHelperStatics *iface, IDependencyObject *reference,
+                                         IDependencyObject **value )
+{
+    struct xaml_element *element = reference ? element_from_object( (IInspectable *)reference ) : NULL;
