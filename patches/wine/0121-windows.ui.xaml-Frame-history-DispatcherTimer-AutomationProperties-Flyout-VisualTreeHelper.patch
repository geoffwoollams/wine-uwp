+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A Flyout (a FlyoutBase, which is a DependencyObject, not a UIElement) shows its Content in a light-dismiss popup
+ * next to the element ShowAt is given: a box like WinUI's FlyoutPresenter (transient background, 1 px border,
+ * 12 px padding, at most 456 x 758 px), placed by Placement (Top by default) and moved inside the window. A press
+ * outside the box closes it; Opening, Opened and Closed are raised. FlyoutPresenterStyle is kept
+ * but not applied, and there are no transitions. */
+
+#define FLYOUT_PADDING 12.0f
+#define FLYOUT_MAX_WIDTH 456.0f
+#define FLYOUT_MAX_HEIGHT 758.0f
+#define FLYOUT_GAP 4.0f
+
+struct flyout_layer
+{
+    struct xaml_element element;
+    struct flyout *flyout;           /* while open, not referenced */
+    struct layout_rect box;
+};
+
+struct flyout
+{
+    IInspectable IInspectable_inner;
+    IFlyout IFlyout_iface;
+    IFlyoutBase IFlyoutBase_iface;
+    IDependencyObject IDependencyObject_iface;
+    IInspectable *outer;
+    LONG ref;
+    IUIElement *content;
+    IStyle *presenter_style;
+    FlyoutPlacementMode placement;
+    struct event_list opening, opened, closed;
+    struct flyout_layer *layer;      /* while open (referenced through layer_object) */
+    IInspectable *layer_object;
+    IInspectable *target;            /* the placement target while open, referenced */
+    BOOL held;                       /* the open flyout holds a reference to itself */
+};
+
+static inline struct flyout *impl_from_IInspectable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct flyout, IInspectable_inner );
+}
+
+static struct xaml_element *flyout_content( struct flyout *impl )
+{
+    return impl->content ? element_from_object( (IInspectable *)impl->content ) : NULL;
+}
+
+static void raise_flyout_event( struct flyout *impl, struct event_list *list, const char *name )
+{
+    IUnknown **handlers;
+    UINT32 i, count = list->count;
+    HRESULT hr;
+
+    TRACE( "%p: %s.\n", impl, name );
+    if (!count || !(handlers = calloc( count, sizeof(*handlers) ))) return;
+    for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+    for (i = 0; i < count; i++)
+    {
+        if (!handlers[i]) continue;
+        hr = IEventHandler_IInspectable_Invoke( (IEventHandler_IInspectable *)handlers[i], impl->outer, NULL );
+        if (FAILED(hr)) WARN( "%s handler %p failed, hr %#lx.\n", name, handlers[i], hr );
+    }
+    for (i = 0; i < count; i++) if (handlers[i]) IUnknown_Release( handlers[i] );
+    free( handlers );
+}
+
+/* ---- the popup layer ---- */
+
+static inline struct flyout_layer *layer_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct flyout_layer, element );
+}
+
+static void layer_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                           float avail_height, float *width, float *height )
+{
+    struct flyout_layer *layer = layer_from_element( element );
+    struct xaml_element *content = layer->flyout ? flyout_content( layer->flyout ) : NULL;
+    float w = isfinite( avail_width ) ? avail_width : FLYOUT_MAX_WIDTH;
+    float h = isfinite( avail_height ) ? avail_height : FLYOUT_MAX_HEIGHT;
+
+    *width = isfinite( avail_width ) ? avail_width : 0;
+    *height = isfinite( avail_height ) ? avail_height : 0;
+    if (!content) return;
+    element_measure( content, ctx, max( 0.0f, min( w, FLYOUT_MAX_WIDTH ) - 2 * FLYOUT_PADDING ),
+                     max( 0.0f, min( h, FLYOUT_MAX_HEIGHT ) - 2 * FLYOUT_PADDING ) );
+}
+
+static void layer_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct flyout_layer *layer = layer_from_element( element );
+    const struct layout_rect *window = &element->bounds;
+    struct xaml_element *content, *target;
+    struct layout_rect anchor, *box = &layer->box;
+    struct flyout *flyout = layer->flyout;
+
+    if (!flyout) return;
+    content = flyout_content( flyout );
+    box->width = min( (content ? content->desired_width : 0) + 2 * FLYOUT_PADDING, min( window->width, FLYOUT_MAX_WIDTH ) );
+    box->height = min( (content ? content->desired_height : 0) + 2 * FLYOUT_PADDING, min( window->height, FLYOUT_MAX_HEIGHT ) );
+    if (flyout->target && (target = element_from_object( flyout->target ))) anchor = target->bounds;
+    else
+    {
+        anchor.x = window->x + window->width / 2;
+        anchor.y = window->y + window->height / 2;
+        anchor.width = anchor.height = 0;
+    }
+
+    switch (flyout->placement)
+    {
+    case FlyoutPlacementMode_Full:
+        box->width = min( window->width, FLYOUT_MAX_WIDTH );
+        box->height = min( window->height, FLYOUT_MAX_HEIGHT );
+        box->x = window->x + (window->width - box->width) / 2;
+        box->y = window->y + (window->height - box->height) / 2;
+        break;
+    case FlyoutPlacementMode_Bottom:
+        box->x = anchor.x + (anchor.width - box->width) / 2;
+        box->y = anchor.y + anchor.height + FLYOUT_GAP;
+        /* where there is no room below, above */
+        if (box->y + box->height > window->y + window->height) box->y = anchor.y - FLYOUT_GAP - box->height;
+        break;
+    case FlyoutPlacementMode_Left:
+        box->x = anchor.x - FLYOUT_GAP - box->width;
+        box->y = anchor.y + (anchor.height - box->height) / 2;
+        if (box->x < window->x) box->x = anchor.x + anchor.width + FLYOUT_GAP;
+        break;
+    case FlyoutPlacementMode_Right:
+        box->x = anchor.x + anchor.width + FLYOUT_GAP;
+        box->y = anchor.y + (anchor.height - box->height) / 2;
+        if (box->x + box->width > window->x + window->width) box->x = anchor.x - FLYOUT_GAP - box->width;
+        break;
+    default:   /* Top, and the edge-aligned modes, which are near enough */
+        box->x = anchor.x + (anchor.width - box->width) / 2;
+        box->y = anchor.y - FLYOUT_GAP - box->height;
+        if (box->y < window->y) box->y = anchor.y + anchor.height + FLYOUT_GAP;
+        break;
+    }
+    /* inside the window */
+    box->x = max( window->x, min( box->x, window->x + window->width - box->width ) );
+    box->y = max( window->y, min( box->y, window->y + window->height - box->height ) );
+    if (content)
+        element_arrange( content, ctx, box->x + FLYOUT_PADDING, box->y + FLYOUT_PADDING,
+                         max( 0.0f, box->width - 2 * FLYOUT_PADDING ), max( 0.0f, box->height - 2 * FLYOUT_PADDING ) );
+}
+
+static void layer_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct flyout_layer *layer = layer_from_element( element );
+    static const Thickness one = { 1, 1, 1, 1 };
+    Color background = { 0xff, 0xf2, 0xf2, 0xf2 };
+    struct xaml_element *content;
+
+    if (!layer->flyout) return;
+    if (ctx->dark) background.R = background.G = background.B = 0x2b;
+    element_fill_argb( ctx, &layer->box, background );
+    element_frame_color( ctx, &layer->box, &one, ctx->dark ? RGB(0x76, 0x76, 0x76) : RGB(0xcc, 0xcc, 0xcc) );
+    if ((content = flyout_content( layer->flyout ))) element_render( content, ctx );
+}
+
+static UINT32 layer_child_count( struct xaml_element *element )
+{
+    struct flyout_layer *layer = layer_from_element( element );
+    return layer->flyout && flyout_content( layer->flyout ) ? 1 : 0;
+}
+
+static struct xaml_element *layer_child_at( struct xaml_element *element, UINT32 index )
+{
+    struct flyout_layer *layer = layer_from_element( element );
+    return !index && layer->flyout ? flyout_content( layer->flyout ) : NULL;
+}
+
+/* the whole window, so that a press outside the box dismisses it */
+static BOOL layer_hit_self( struct xaml_element *element, float x, float y )
+{
+    return layer_from_element( element )->flyout != NULL;
+}
+
+static void flyout_hide( struct flyout *impl );
+
+static void layer_pointer( struct xaml_element *element, UINT msg, float x, float y )
+{
+    struct flyout_layer *layer = layer_from_element( element );
+    const struct layout_rect *b = &layer->box;
+
+    if (msg != WM_LBUTTONDOWN || !layer->flyout) return;
+    if (x >= b->x && y >= b->y && x < b->x + b->width && y < b->y + b->height) return;
+    TRACE( "light dismiss.\n" );
+    flyout_hide( layer->flyout );
+}
+
+static BOOL layer_key( struct xaml_element *element, BOOL down, WPARAM vk )
+{
+    struct flyout_layer *layer = layer_from_element( element );
+
+    if (!down || vk != VK_ESCAPE || !layer->flyout) return FALSE;
+    flyout_hide( layer->flyout );
+    return TRUE;
+}
+
+static void layer_destroy( struct xaml_element *element )
+{
+    free( layer_from_element( element ) );
+}
+
+static const struct element_ops layer_ops =
+{
+    .measure = layer_measure,
+    .arrange = layer_arrange,
+    .render = layer_render,
+    .child_count = layer_child_count,
+    .child_at = layer_child_at,
+    .hit_self = layer_hit_self,
+    .pointer = layer_pointer,
+    .key = layer_key,
+    .destroy = layer_destroy,
+};
+
+/* ---- opening and closing ---- */
+
+static HRESULT flyout_show( struct flyout *impl, IInspectable *target )
+{
+    struct xaml_element *content;
+    struct flyout_layer *layer;
+    HRESULT hr;
+
+    if (impl->layer)
+    {
+        /* ShowAt on an open flyout moves it */
+        if (target) IInspectable_AddRef( target );
+        if (impl->target) IInspectable_Release( impl->target );
+        impl->target = target;
+        window_invalidate();
+        return S_OK;
+    }
+    raise_flyout_event( impl, &impl->opening, "Opening" );
+    if (!(layer = calloc( 1, sizeof(*layer) ))) return E_OUTOFMEMORY;
+    element_init( &layer->element, &layer_ops, L"Windows.UI.Xaml.Controls.FlyoutPresenter", NULL );
+    if (FAILED(hr = element_compose( &layer->element, NULL, NULL, &layer->element.IInspectable_inner,
+                                     (void **)&impl->layer_object )))
+    {
+        free( layer );
+        return hr;
+    }
+    layer->flyout = impl;
+    impl->layer = layer;
+    if (target) IInspectable_AddRef( target );
+    impl->target = target;
+    if ((content = flyout_content( impl ))) element_set_parent( content, &layer->element );
+    if (!window_popup_show( &layer->element, FALSE ))
+    {
+        WARN( "no room for another popup.\n" );
+        flyout_hide( impl );
+        return E_FAIL;
+    }
+    IInspectable_AddRef( impl->outer );   /* an open flyout stays alive until it closes */
+    impl->held = TRUE;
+    window_invalidate();
+    raise_flyout_event( impl, &impl->opened, "Opened" );
+    return S_OK;
+}
+
+static void flyout_hide( struct flyout *impl )
+{
+    struct flyout_layer *layer = impl->layer;
+    struct xaml_element *content;
+    BOOL held = impl->held;
+
+    if (!layer) return;
+    impl->held = FALSE;
+    window_popup_hide( &layer->element );
+    if ((content = flyout_content( impl )) && content->parent == &layer->element) element_set_parent( content, NULL );
+    layer->flyout = NULL;
+    impl->layer = NULL;
+    IInspectable_Release( impl->layer_object );
+    impl->layer_object = NULL;
+    if (impl->target) IInspectable_Release( impl->target );
+    impl->target = NULL;
+    window_invalidate();
+    raise_flyout_event( impl, &impl->closed, "Closed" );
+    if (held) IInspectable_Release( impl->outer );
+}
+
+/* ---- IInspectable (the inner, non-delegating one) ---- */
+
+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct flyout *impl = impl_from_IInspectable( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = &impl->IInspectable_inner;
+    else if (IsEqualGUID( iid, &IID_IFlyout ))
+        *out = &impl->IFlyout_iface;
+    else if (IsEqualGUID( iid, &IID_IFlyoutBase ))
+        *out = &impl->IFlyoutBase_iface;
+    else if (IsEqualGUID( iid, &IID_IDependencyObject ))
+        *out = &impl->IDependencyObject_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IInspectable( iface )->ref );
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct flyout *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        dp_store_free( &impl->IDependencyObject_iface );
+        if (impl->content) IUIElement_Release( impl->content );
+        if (impl->presenter_style) IStyle_Release( impl->presenter_style );
+        event_list_clear( &impl->opening );
+        event_list_clear( &impl->opened );
+        event_list_clear( &impl->closed );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI inner_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI inner_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Xaml_Controls_Flyout;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI inner_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const struct IInspectableVtbl inner_vtbl =
+{
+    inner_QueryInterface,
+    inner_AddRef,
+    inner_Release,
+    /* IInspectable methods */
+    inner_GetIids,
+    inner_GetRuntimeClassName,
+    inner_GetTrustLevel,
+};
