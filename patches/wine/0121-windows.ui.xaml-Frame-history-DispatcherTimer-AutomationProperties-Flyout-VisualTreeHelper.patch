+static HRESULT get_property( const WCHAR *name, const WCHAR *type, IDependencyProperty **value )
+{
+    if (!value) return E_POINTER;
+    if (!(*value = dp_attached( owner_name, name, type ))) return E_OUTOFMEMORY;
+    IDependencyProperty_AddRef( *value );
+    return S_OK;
+}
+
+static IDependencyObject *key_of( IInspectable *element )
+{
+    IDependencyObject *key;
+    if (!element || FAILED(IInspectable_QueryInterface( element, &IID_IDependencyObject, (void **)&key ))) return NULL;
+    return key;
+}
+
+static HRESULT get_value( IInspectable *element, const WCHAR *name, IInspectable **value )
+{
+    IDependencyProperty *dp = dp_attached( owner_name, name, NULL );
+    IDependencyObject *key;
+    HRESULT hr;
+
+    *value = NULL;
+    if (!dp) return E_OUTOFMEMORY;
+    if (!(key = key_of( element ))) return E_INVALIDARG;
+    hr = dp_get_value( key, dp, value );
+    IDependencyObject_Release( key );
+    return hr;
+}
+
+static HRESULT set_value( IInspectable *element, const WCHAR *name, IInspectable *value )
+{
+    IDependencyProperty *dp = dp_attached( owner_name, name, NULL );
+    IDependencyObject *key;
+    HRESULT hr;
+
+    TRACE( "element %p, %s = %p.\n", element, debugstr_w(name), value );
+    if (!dp) return E_OUTOFMEMORY;
+    if (!(key = key_of( element ))) return E_INVALIDARG;
+    hr = dp_set_value( key, dp, value );
+    IDependencyObject_Release( key );
+    return hr;
+}
+
+static IPropertyValueStatics *property_value_statics(void)
+{
+    static const WCHAR name[] = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics;
+    HSTRING_HEADER header;
+    HSTRING class_name;
+
+    WindowsCreateStringReference( name, wcslen( name ), &header, &class_name );
+    if (FAILED(RoGetActivationFactory( class_name, &IID_IPropertyValueStatics, (void **)&statics ))) return NULL;
+    return statics;
+}
+
+static IPropertyValue *get_property_value( IInspectable *element, const WCHAR *name, HRESULT *hr )
+{
+    IInspectable *value;
+    IPropertyValue *pv = NULL;
+
+    if (FAILED(*hr = get_value( element, name, &value )) || !value) return NULL;
+    if (FAILED(IInspectable_QueryInterface( value, &IID_IPropertyValue, (void **)&pv ))) pv = NULL;
+    IInspectable_Release( value );
+    return pv;
+}
+
+static HRESULT get_string( IInspectable *element, const WCHAR *name, HSTRING *value )
+{
+    IPropertyValue *pv;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(pv = get_property_value( element, name, &hr ))) return hr;
+    if (FAILED(IPropertyValue_GetString( pv, value ))) *value = NULL;
+    IPropertyValue_Release( pv );
+    return S_OK;
+}
+
+static HRESULT set_string( IInspectable *element, const WCHAR *name, HSTRING value )
+{
+    IPropertyValueStatics *statics = property_value_statics();
+    IInspectable *boxed = NULL;
+    HRESULT hr;
+
+    if (!statics) return E_FAIL;
+    hr = IPropertyValueStatics_CreateString( statics, value, &boxed );
+    IPropertyValueStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+    hr = set_value( element, name, boxed );
+    IInspectable_Release( boxed );
+    return hr;
+}
+
+static HRESULT get_bool( IInspectable *element, const WCHAR *name, boolean *value )
+{
+    IPropertyValue *pv;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    if (!(pv = get_property_value( element, name, &hr ))) return hr;
+    if (FAILED(IPropertyValue_GetBoolean( pv, value ))) *value = FALSE;
+    IPropertyValue_Release( pv );
+    return S_OK;
+}
+
+static HRESULT set_bool( IInspectable *element, const WCHAR *name, boolean value )
+{
+    IPropertyValueStatics *statics = property_value_statics();
+    IInspectable *boxed = NULL;
+    HRESULT hr;
+
+    if (!statics) return E_FAIL;
+    hr = IPropertyValueStatics_CreateBoolean( statics, value, &boxed );
+    IPropertyValueStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+    hr = set_value( element, name, boxed );
+    IInspectable_Release( boxed );
+    return hr;
+}
+
+static HRESULT get_int( IInspectable *element, const WCHAR *name, INT32 def, INT32 *value )
+{
+    IPropertyValue *pv;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = def;
+    if (!(pv = get_property_value( element, name, &hr ))) return hr;
+    if (FAILED(IPropertyValue_GetInt32( pv, value ))) *value = def;
+    IPropertyValue_Release( pv );
+    return S_OK;
+}
+
+static HRESULT set_int( IInspectable *element, const WCHAR *name, INT32 value )
+{
+    IPropertyValueStatics *statics = property_value_statics();
+    IInspectable *boxed = NULL;
+    HRESULT hr;
+
+    if (!statics) return E_FAIL;
+    hr = IPropertyValueStatics_CreateInt32( statics, value, &boxed );
+    IPropertyValueStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+    hr = set_value( element, name, boxed );
+    IInspectable_Release( boxed );
+    return hr;
+}
+
+static HRESULT get_object( IInspectable *element, const WCHAR *name, const IID *iid, void **value )
+{
+    IInspectable *object;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = get_value( element, name, &object )) || !object) return hr;
+    hr = IInspectable_QueryInterface( object, iid, value );
+    IInspectable_Release( object );
+    return hr;
+}
+
+static HRESULT set_object( IInspectable *element, const WCHAR *name, IInspectable *value )
+{
+    return set_value( element, name, value );
+}
+
+/* the read-only collections: an empty one on first use, kept on the element */
+static HRESULT get_vector( IInspectable *element, const WCHAR *name, const struct vector_iids *iids, void **value )
+{
+    static const struct vector_callbacks callbacks;
+    IInspectable *vector;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = get_value( element, name, &vector ))) return hr;
+    if (!vector)
+    {
+        if (FAILED(hr = vector_create( iids, &callbacks, NULL, &vector ))) return hr;
+        if (FAILED(hr = set_value( element, name, vector )))
+        {
+            IInspectable_Release( vector );
+            return hr;
+        }
+    }
+    hr = IInspectable_QueryInterface( vector, iids->vector, value );
+    IInspectable_Release( vector );
+    return hr;
+}
