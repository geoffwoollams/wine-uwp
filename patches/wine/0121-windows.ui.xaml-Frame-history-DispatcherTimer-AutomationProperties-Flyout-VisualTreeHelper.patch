+/* the page an entry kept (a reference), or NULL; entries the app made itself keep none */
+IInspectable *page_entry_cached_page( IPageStackEntry *entry )
+{
+    struct page_entry *impl;
+
+    if (entry->lpVtbl != &entry_vtbl) return NULL;
+    impl = impl_from_IPageStackEntry( entry );
+    if (impl->page) IInspectable_AddRef( impl->page );
+    return impl->page;
