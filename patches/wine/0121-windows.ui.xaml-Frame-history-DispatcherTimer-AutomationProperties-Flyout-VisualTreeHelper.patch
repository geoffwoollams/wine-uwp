+static HRESULT WINAPI statics_GetChild( IVisualTreeHelperStatics *iface, IDependencyObject *reference, INT32 index,
+                                        IDependencyObject **value )
+{
+    struct xaml_element *element = reference ? element_from_object( (IInspectable *)reference ) : NULL;
+    UINT32 count = element && element->ops->child_count ? element->ops->child_count( element ) : 0;
+
+    TRACE( "iface %p, reference %p, index %d.\n", iface, reference, index );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!reference) return E_INVALIDARG;
+    if (index < 0 || index >= count) return E_INVALIDARG;   /* WinUI: ArgumentOutOfRange */
+    *value = dependency_object_of( element->ops->child_at( element, index ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_GetChildrenCount( IVisualTreeHelperStatics *iface, IDependencyObject *reference, INT32 *value )
