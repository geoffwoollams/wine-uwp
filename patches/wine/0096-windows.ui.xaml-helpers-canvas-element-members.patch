+}
+
+static HRESULT WINAPI size_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct size_helper *impl = size_from_factory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ISizeHelperStatics ))
+        *out = &impl->ISizeHelperStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+static ULONG WINAPI helper_factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI helper_factory_Release( IActivationFactory *iface ) { return 1; }
