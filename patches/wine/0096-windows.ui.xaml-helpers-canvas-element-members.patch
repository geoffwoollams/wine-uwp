+/* Canvas: each child gets its own desired size, at its Left/Top; the Canvas itself wants no room */
+static void canvas_measure( struct panel *impl, struct layout_context *ctx, float *width, float *height )
+{
+    UINT32 i, count = vector_size( impl->children );
+    struct xaml_element *child;
+
+    for (i = 0; i < count; i++)
+        if ((child = panel_child( impl, i ))) element_measure( child, ctx, INFINITY, INFINITY );
+    *width = *height = 0;
+}
+
+static void canvas_arrange( struct panel *impl, struct layout_context *ctx )
+{
+    UINT32 i, count = vector_size( impl->children );
+    const struct layout_rect *b = &impl->element.bounds;
+    struct xaml_element *child;
+
+    for (i = 0; i < count; i++)
+    {
+        if (!(child = panel_child( impl, i ))) continue;
+        element_arrange( child, ctx, b->x + (isnan( child->canvas_left ) ? 0 : child->canvas_left),
+                         b->y + (isnan( child->canvas_top ) ? 0 : child->canvas_top), child->desired_width, child->desired_height );
+    }
+}
