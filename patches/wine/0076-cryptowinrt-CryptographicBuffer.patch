+/* the bytes of a buffer the app passed in; an empty buffer gives no bytes */
+static HRESULT buffer_bytes( IBuffer *buffer, BYTE **data, UINT32 *length )
+{
+    IBufferByteAccess *access;
+    HRESULT hr;
+
+    *data = NULL;
+    *length = 0;
+    if (!buffer) return E_INVALIDARG;
+    if (FAILED(hr = IBuffer_get_Length( buffer, length ))) return hr;
+    if (!*length) return S_OK;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+    hr = IBufferByteAccess_Buffer( access, data );
+    IBufferByteAccess_Release( access );
+    return hr;
+}
+
+/* a new Windows.Storage.Streams.Buffer holding a copy of the given bytes */
+static HRESULT create_buffer( const void *data, UINT32 length, IBuffer **out )
+{
+    static const WCHAR class_name[] = L"Windows.Storage.Streams.Buffer";
+    IBufferFactory *factory;
+    IBuffer *buffer;
+    HSTRING str;
+    BYTE *bytes;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, &str ))) return hr;
+    hr = RoGetActivationFactory( str, &IID_IBufferFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return hr;
+    hr = IBufferFactory_Create( factory, length, &buffer );
+    IBufferFactory_Release( factory );
+    if (FAILED(hr)) return hr;
+
+    if (length)
+    {
+        UINT32 got;
+        if (SUCCEEDED(hr = IBuffer_put_Length( buffer, length )) && SUCCEEDED(hr = buffer_bytes( buffer, &bytes, &got )))
+            memcpy( bytes, data, length );
+        if (FAILED(hr))
+        {
+            IBuffer_Release( buffer );
+            return hr;
+        }
+    }
+    *out = buffer;
+    return S_OK;
+}
+
+static int hex_digit( WCHAR c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
