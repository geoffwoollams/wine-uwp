+/* Down from the high bit, Locked (toggle keys such as Caps Lock) from the low bit of the
+ * window thread's key state */
+static __x_ABI_CWindows_CUI_CCore_CCoreVirtualKeyStates key_states(SHORT value)
+{
+    __x_ABI_CWindows_CUI_CCore_CCoreVirtualKeyStates state = CoreVirtualKeyStates_None;
+    if (value & 0x8000) state |= CoreVirtualKeyStates_Down;
+    if (value & 1) state |= CoreVirtualKeyStates_Locked;
+    return state;
+}
+
 static HRESULT WINAPI core_window_GetAsyncKeyState(ICoreWindow *iface, __x_ABI_CWindows_CSystem_CVirtualKey key, __x_ABI_CWindows_CUI_CCore_CCoreVirtualKeyStates *state)
 {
-    struct core_window *impl __attribute__((unused)) = impl_from_core_window(iface);
+    if (!state) return E_POINTER;
     *state = (GetAsyncKeyState(key) & 0x8000) ? CoreVirtualKeyStates_Down : CoreVirtualKeyStates_None;
+    TRACE("iface %p, key %#x -> %#x.\n", iface, key, *state);
     return S_OK;
 }
 
 static HRESULT WINAPI core_window_GetKeyState(ICoreWindow *iface, __x_ABI_CWindows_CSystem_CVirtualKey key, __x_ABI_CWindows_CUI_CCore_CCoreVirtualKeyStates *state)
 {
-    struct core_window *impl __attribute__((unused)) = impl_from_core_window(iface);
-    *state = (GetKeyState(key) & 0x8000) ? CoreVirtualKeyStates_Down : CoreVirtualKeyStates_None;
+    struct core_window *impl = impl_from_core_window(iface);
+
+    if (!state) return E_POINTER;
+    /* Win32 key state belongs to each thread's input queue, but CoreWindow's is the window's,
+     * read from any thread: games poll it from their own threads (Unreal Engine's game thread,
+     * for a held mouse button). Elsewhere than the window's thread, the live state stands in
+     * for it, with the toggles from the window's thread. */
+    if (impl->dispatcher && GetCurrentThreadId() != impl->dispatcher->thread_id)
+        *state = key_states((GetAsyncKeyState(key) & 0x8000) | (GetKeyState(key) & 1));
+    else
+        *state = key_states(GetKeyState(key));
+    TRACE("iface %p, key %#x -> %#x.\n", iface, key, *state);
     return S_OK;
 }
 
