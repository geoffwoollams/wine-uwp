+/* ---- AcceleratorKeyEventArgs: CoreDispatcher.AcceleratorKeyActivated, raised for every key and
+ * character message before the CoreWindow's own key events (Unreal Engine takes game keys from it) ---- */
+struct accel_args
+{
+    IAcceleratorKeyEventArgs IAcceleratorKeyEventArgs_iface;
+    ICoreWindowEventArgs ICoreWindowEventArgs_iface;
+    LONG ref;
+    boolean handled;
+    CoreAcceleratorKeyEventType type;
+    __x_ABI_CWindows_CSystem_CVirtualKey vkey;
+    CorePhysicalKeyStatus status;
+};
+static inline struct accel_args *impl_from_accel(IAcceleratorKeyEventArgs *iface)
+{ return CONTAINING_RECORD(iface, struct accel_args, IAcceleratorKeyEventArgs_iface); }
+static inline struct accel_args *impl_from_accel_cw(ICoreWindowEventArgs *iface)
+{ return CONTAINING_RECORD(iface, struct accel_args, ICoreWindowEventArgs_iface); }
+
+static HRESULT accel_args_qi(struct accel_args *impl, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IAcceleratorKeyEventArgs))
+        *out = &impl->IAcceleratorKeyEventArgs_iface;
+    else if (IsEqualGUID(iid, &IID_ICoreWindowEventArgs))
+        *out = &impl->ICoreWindowEventArgs_iface;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&impl->ref);
+    return S_OK;
+}
+static ULONG accel_args_release(struct accel_args *impl)
+{ ULONG r = InterlockedDecrement(&impl->ref); if (!r) free(impl); return r; }
+
+static HRESULT WINAPI accel_QueryInterface(IAcceleratorKeyEventArgs *iface, REFIID iid, void **out)
+{ return accel_args_qi(impl_from_accel(iface), iid, out); }
+static ULONG WINAPI accel_AddRef(IAcceleratorKeyEventArgs *iface) { return InterlockedIncrement(&impl_from_accel(iface)->ref); }
+static ULONG WINAPI accel_Release(IAcceleratorKeyEventArgs *iface) { return accel_args_release(impl_from_accel(iface)); }
+static HRESULT WINAPI accel_GetIids(IAcceleratorKeyEventArgs *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI accel_GetRuntimeClassName(IAcceleratorKeyEventArgs *iface, HSTRING *name)
+{ return WindowsCreateString(L"Windows.UI.Core.AcceleratorKeyEventArgs", 39, name); }
+static HRESULT WINAPI accel_GetTrustLevel(IAcceleratorKeyEventArgs *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI accel_get_EventType(IAcceleratorKeyEventArgs *iface, CoreAcceleratorKeyEventType *value)
+{ *value = impl_from_accel(iface)->type; return S_OK; }
+static HRESULT WINAPI accel_get_VirtualKey(IAcceleratorKeyEventArgs *iface, __x_ABI_CWindows_CSystem_CVirtualKey *value)
+{ *value = impl_from_accel(iface)->vkey; return S_OK; }
+static HRESULT WINAPI accel_get_KeyStatus(IAcceleratorKeyEventArgs *iface, CorePhysicalKeyStatus *value)
+{ *value = impl_from_accel(iface)->status; return S_OK; }
+static const IAcceleratorKeyEventArgsVtbl accel_vtbl =
+{
+    accel_QueryInterface, accel_AddRef, accel_Release,
+    accel_GetIids, accel_GetRuntimeClassName, accel_GetTrustLevel,
+    accel_get_EventType, accel_get_VirtualKey, accel_get_KeyStatus,
+};
+
+static HRESULT WINAPI accel_cw_QueryInterface(ICoreWindowEventArgs *iface, REFIID iid, void **out)
+{ return accel_args_qi(impl_from_accel_cw(iface), iid, out); }
+static ULONG WINAPI accel_cw_AddRef(ICoreWindowEventArgs *iface) { return InterlockedIncrement(&impl_from_accel_cw(iface)->ref); }
+static ULONG WINAPI accel_cw_Release(ICoreWindowEventArgs *iface) { return accel_args_release(impl_from_accel_cw(iface)); }
+static HRESULT WINAPI accel_cw_GetIids(ICoreWindowEventArgs *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI accel_cw_GetRuntimeClassName(ICoreWindowEventArgs *iface, HSTRING *name)
+{ return accel_GetRuntimeClassName(&impl_from_accel_cw(iface)->IAcceleratorKeyEventArgs_iface, name); }
+static HRESULT WINAPI accel_cw_GetTrustLevel(ICoreWindowEventArgs *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI accel_cw_get_Handled(ICoreWindowEventArgs *iface, boolean *value)
+{ *value = impl_from_accel_cw(iface)->handled; return S_OK; }
+static HRESULT WINAPI accel_cw_put_Handled(ICoreWindowEventArgs *iface, boolean value)
+{ impl_from_accel_cw(iface)->handled = value; return S_OK; }
+static const ICoreWindowEventArgsVtbl accel_cw_vtbl =
+{
+    accel_cw_QueryInterface, accel_cw_AddRef, accel_cw_Release,
+    accel_cw_GetIids, accel_cw_GetRuntimeClassName, accel_cw_GetTrustLevel,
+    accel_cw_get_Handled, accel_cw_put_Handled,
+};
+
+static CorePhysicalKeyStatus key_status(LPARAM lparam);
+
+/* raises AcceleratorKeyActivated on the window's dispatcher; TRUE when a handler marked it handled */
+static BOOL raise_accelerator(ICoreWindow *sender, CoreAcceleratorKeyEventType type, WPARAM wparam, LPARAM lparam)
+{
+    ICoreDispatcher *dispatcher;
+    BOOL handled = FALSE;
+    UINT32 i;
+
+    if (!handlers[EV_ACCELERATOR].n || FAILED(ICoreWindow_get_Dispatcher(sender, &dispatcher))) return FALSE;
+    for (i = 0; i < handlers[EV_ACCELERATOR].n && !handled; i++)
+    {
+        struct accel_args *args = calloc(1, sizeof(*args));
+        if (!args) break;
+        args->IAcceleratorKeyEventArgs_iface.lpVtbl = &accel_vtbl;
+        args->ICoreWindowEventArgs_iface.lpVtbl = &accel_cw_vtbl;
+        args->ref = 1;
+        args->type = type;
+        args->vkey = wparam;
+        args->status = key_status(lparam);
+        ITypedEventHandler_CoreDispatcher_AcceleratorKeyEventArgs_Invoke(
+                (ITypedEventHandler_CoreDispatcher_AcceleratorKeyEventArgs *)handlers[EV_ACCELERATOR].h[i], dispatcher,
+                &args->IAcceleratorKeyEventArgs_iface);
+        handled = args->handled;
+        IAcceleratorKeyEventArgs_Release(&args->IAcceleratorKeyEventArgs_iface);
+    }
+    ICoreDispatcher_Release(dispatcher);
+    TRACE("type %d, vkey %#Ix, handled %d.\n", type, wparam, handled);
+    return handled;
+}
+
 static CorePhysicalKeyStatus key_status(LPARAM lparam)
