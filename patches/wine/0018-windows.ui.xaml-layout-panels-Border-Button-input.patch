+struct xaml_element *element_hit_test( struct xaml_element *element, float x, float y )
+{
+    const struct layout_rect *b = &element->bounds;
+    struct xaml_element *hit;
+    UINT32 i;
+
+    if (element->visibility != Visibility_Visible || !element->hit_test_visible) return NULL;
+    if (element->ops->child_count)
+    {
+        for (i = element->ops->child_count( element ); i > 0; i--)
+        {
+            struct xaml_element *child = element->ops->child_at( element, i - 1 );
+            if (child && (hit = element_hit_test( child, x, y ))) return hit;
+        }
+    }
+    if (x >= b->x && y >= b->y && x < b->x + b->width && y < b->y + b->height &&
+        element->ops->hit_self && element->ops->hit_self( element, x, y ))
+        return element;
+    return NULL;
+}
