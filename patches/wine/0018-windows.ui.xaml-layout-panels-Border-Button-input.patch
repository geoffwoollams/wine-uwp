+/* text for non-UIElement content: strings, IStringable, or the runtime class name like Windows does */
+static HSTRING content_to_text( IInspectable *content )
+{
+    IPropertyValue *value;
+    IStringable *stringable;
+    PropertyType type;
+    HSTRING text = NULL;
+
+    if (SUCCEEDED(IInspectable_QueryInterface( content, &IID_IPropertyValue, (void **)&value )))
+    {
+        if (SUCCEEDED(IPropertyValue_get_Type( value, &type )) && type == PropertyType_String)
+            IPropertyValue_GetString( value, &text );
+        else FIXME( "property value of type %d shown as nothing.\n", type );
+        IPropertyValue_Release( value );
+    }
+    else if (SUCCEEDED(IInspectable_QueryInterface( content, &IID_IStringable, (void **)&stringable )))
+    {
+        IStringable_ToString( stringable, &text );
+        IStringable_Release( stringable );
+    }
+    else IInspectable_GetRuntimeClassName( content, &text );
+    return text;
+}
