+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* IVector<T *> for any interface T has the same layout as IVector<IInspectable *>, so one implementation serves
+ * all of them; only the IIDs differ. Views and iterators work on a snapshot of the items. */
+
+struct items
+{
+    IInspectable **items;
+    UINT32 count;
+};
+
+static void items_release( struct items *items )
+{
+    UINT32 i;
+    for (i = 0; i < items->count; i++) IInspectable_Release( items->items[i] );
+    free( items->items );
+}
+
+static HRESULT items_index_of( const struct items *items, IInspectable *element, UINT32 *index, BOOLEAN *found )
+{
+    UINT32 i;
+
+    for (i = 0; i < items->count; i++)
+    {
+        if (items->items[i] == element)
+        {
+            *index = i;
+            *found = TRUE;
+            return S_OK;
+        }
+    }
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+
+static HRESULT items_get_many( const struct items *items, UINT32 start, UINT32 size, IInspectable **out, UINT32 *count )
+{
+    UINT32 i;
+
+    *count = 0;
+    if (start > items->count) return E_BOUNDS;
+    for (i = start; i < items->count && *count < size; i++)
+    {
+        out[(*count)++] = items->items[i];
+        IInspectable_AddRef( items->items[i] );
+    }
+    return S_OK;
+}
+
+/* iterator */
+
+struct iterator
+{
+    IIterator_IInspectable IIterator_IInspectable_iface;
+    LONG ref;
+    const struct vector_iids *iids;
+    struct items items;
+    UINT32 index;
+};
+
+static inline struct iterator *impl_from_IIterator_IInspectable( IIterator_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct iterator, IIterator_IInspectable_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_IInspectable *iface, REFIID iid, void **out )
+{
+    struct iterator *impl = impl_from_IIterator_IInspectable( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->iids->iterator ))
+    {
+        *out = iface;
+        IIterator_IInspectable_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator_IInspectable( iface )->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_IInspectable *iface )
+{
+    struct iterator *impl = impl_from_IIterator_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        items_release( &impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_IInspectable *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_IInspectable *iface, IInspectable **value )
+{
+    struct iterator *impl = impl_from_IIterator_IInspectable( iface );
+
+    if (impl->index >= impl->items.count) return E_BOUNDS;
+    *value = impl->items.items[impl->index];
+    IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_IInspectable *iface, boolean *value )
+{
+    struct iterator *impl = impl_from_IIterator_IInspectable( iface );
+    *value = impl->index < impl->items.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_IInspectable *iface, boolean *value )
+{
+    struct iterator *impl = impl_from_IIterator_IInspectable( iface );
+
+    if (impl->index < impl->items.count) impl->index++;
+    *value = impl->index < impl->items.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_IInspectable *iface, UINT32 size, IInspectable **items, UINT32 *count )
+{
+    struct iterator *impl = impl_from_IIterator_IInspectable( iface );
+    HRESULT hr = items_get_many( &impl->items, impl->index, size, items, count );
+    if (SUCCEEDED(hr)) impl->index += *count;
+    return hr;
+}
+
+static const struct IIterator_IInspectableVtbl iterator_vtbl =
+{
+    iterator_QueryInterface,
+    iterator_AddRef,
+    iterator_Release,
+    /* IInspectable methods */
+    iterator_GetIids,
+    iterator_GetRuntimeClassName,
+    iterator_GetTrustLevel,
+    /* IIterator<T> methods */
+    iterator_get_Current,
+    iterator_get_HasCurrent,
+    iterator_MoveNext,
+    iterator_GetMany,
+};
+
+static HRESULT items_copy( const struct items *src, struct items *dst )
+{
+    UINT32 i;
+
+    dst->count = 0;
+    if (!(dst->items = calloc( max( 1, src->count ), sizeof(*dst->items) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < src->count; i++)
+    {
+        dst->items[i] = src->items[i];
+        IInspectable_AddRef( dst->items[i] );
+    }
+    dst->count = src->count;
+    return S_OK;
+}
+
+static HRESULT iterator_create( const struct vector_iids *iids, const struct items *items, IIterator_IInspectable **out )
+{
+    struct iterator *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IIterator_IInspectable_iface.lpVtbl = &iterator_vtbl;
+    impl->ref = 1;
+    impl->iids = iids;
+    if (FAILED(items_copy( items, &impl->items )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    *out = &impl->IIterator_IInspectable_iface;
+    return S_OK;
+}
+
+/* view */
+
+struct view
+{
+    IVectorView_IInspectable IVectorView_IInspectable_iface;
+    IIterable_IInspectable IIterable_IInspectable_iface;
+    LONG ref;
+    const struct vector_iids *iids;
+    struct items items;
+};
+
+static inline struct view *impl_from_IVectorView_IInspectable( IVectorView_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct view, IVectorView_IInspectable_iface );
+}
+
+static HRESULT WINAPI view_QueryInterface( IVectorView_IInspectable *iface, REFIID iid, void **out )
+{
+    struct view *impl = impl_from_IVectorView_IInspectable( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->iids->view ))
+        *out = &impl->IVectorView_IInspectable_iface;
+    else if (IsEqualGUID( iid, impl->iids->iterable ))
+        *out = &impl->IIterable_IInspectable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI view_AddRef( IVectorView_IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IVectorView_IInspectable( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( IVectorView_IInspectable *iface )
+{
+    struct view *impl = impl_from_IVectorView_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        items_release( &impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_GetIids( IVectorView_IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI view_GetRuntimeClassName( IVectorView_IInspectable *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI view_GetTrustLevel( IVectorView_IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_GetAt( IVectorView_IInspectable *iface, UINT32 index, IInspectable **value )
+{
+    struct view *impl = impl_from_IVectorView_IInspectable( iface );
+
+    if (index >= impl->items.count) return E_BOUNDS;
+    *value = impl->items.items[index];
+    IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI view_get_Size( IVectorView_IInspectable *iface, UINT32 *value )
+{
+    *value = impl_from_IVectorView_IInspectable( iface )->items.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_IndexOf( IVectorView_IInspectable *iface, IInspectable *element, UINT32 *index, BOOLEAN *found )
+{
+    return items_index_of( &impl_from_IVectorView_IInspectable( iface )->items, element, index, found );
+}
+
+static HRESULT WINAPI view_GetMany( IVectorView_IInspectable *iface, UINT32 start, UINT32 size, IInspectable **items,
+                                    UINT32 *count )
+{
+    return items_get_many( &impl_from_IVectorView_IInspectable( iface )->items, start, size, items, count );
+}
+
+static const struct IVectorView_IInspectableVtbl view_vtbl =
+{
+    view_QueryInterface,
+    view_AddRef,
+    view_Release,
+    /* IInspectable methods */
+    view_GetIids,
+    view_GetRuntimeClassName,
+    view_GetTrustLevel,
+    /* IVectorView<T> methods */
+    view_GetAt,
+    view_get_Size,
+    view_IndexOf,
+    view_GetMany,
+};
+
+DEFINE_IINSPECTABLE_( view_iterable, IIterable_IInspectable, struct view, view_from_IIterable, IIterable_IInspectable_iface,
+                      &impl->IVectorView_IInspectable_iface )
+
+static HRESULT WINAPI view_iterable_First( IIterable_IInspectable *iface, IIterator_IInspectable **value )
+{
+    struct view *impl = view_from_IIterable( iface );
+    return iterator_create( impl->iids, &impl->items, value );
+}
+
+static const struct IIterable_IInspectableVtbl view_iterable_vtbl =
+{
+    view_iterable_QueryInterface,
+    view_iterable_AddRef,
+    view_iterable_Release,
+    /* IInspectable methods */
+    view_iterable_GetIids,
+    view_iterable_GetRuntimeClassName,
+    view_iterable_GetTrustLevel,
+    /* IIterable<T> methods */
+    view_iterable_First,
+};
+
+/* vector */
+
+struct vector
+{
+    IVector_IInspectable IVector_IInspectable_iface;
+    IIterable_IInspectable IIterable_IInspectable_iface;
+    LONG ref;
+    const struct vector_iids *iids;
+    const struct vector_callbacks *callbacks;
+    void *owner;
+    struct items items;
+    UINT32 capacity;
+};
+
+static const struct IVector_IInspectableVtbl vector_vtbl;
+
+static inline struct vector *impl_from_IVector_IInspectable( IVector_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct vector, IVector_IInspectable_iface );
+}
+
+static struct vector *vector_from_iinspectable( IInspectable *object )
+{
+    IVector_IInspectable *iface = (IVector_IInspectable *)object;
+    return iface->lpVtbl == &vector_vtbl ? impl_from_IVector_IInspectable( iface ) : NULL;
+}
+
+static HRESULT WINAPI vector_QueryInterface( IVector_IInspectable *iface, REFIID iid, void **out )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->iids->vector ))
+        *out = &impl->IVector_IInspectable_iface;
+    else if (IsEqualGUID( iid, impl->iids->iterable ))
+        *out = &impl->IIterable_IInspectable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI vector_AddRef( IVector_IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IVector_IInspectable( iface )->ref );
+}
+
+static ULONG WINAPI vector_Release( IVector_IInspectable *iface )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        vector_detach( (IInspectable *)iface );
+        items_release( &impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI vector_GetIids( IVector_IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI vector_GetRuntimeClassName( IVector_IInspectable *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI vector_GetTrustLevel( IVector_IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_GetAt( IVector_IInspectable *iface, UINT32 index, IInspectable **value )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+
+    if (index >= impl->items.count) return E_BOUNDS;
+    *value = impl->items.items[index];
+    IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_get_Size( IVector_IInspectable *iface, UINT32 *value )
+{
+    *value = impl_from_IVector_IInspectable( iface )->items.count;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_GetView( IVector_IInspectable *iface, IVectorView_IInspectable **value )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+    struct view *view;
+
+    if (!(view = calloc( 1, sizeof(*view) ))) return E_OUTOFMEMORY;
+    view->IVectorView_IInspectable_iface.lpVtbl = &view_vtbl;
+    view->IIterable_IInspectable_iface.lpVtbl = &view_iterable_vtbl;
+    view->ref = 1;
+    view->iids = impl->iids;
+    if (FAILED(items_copy( &impl->items, &view->items )))
+    {
+        free( view );
+        return E_OUTOFMEMORY;
+    }
+    *value = &view->IVectorView_IInspectable_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_IndexOf( IVector_IInspectable *iface, IInspectable *element, UINT32 *index, BOOLEAN *found )
+{
+    return items_index_of( &impl_from_IVector_IInspectable( iface )->items, element, index, found );
+}
+
+static HRESULT WINAPI vector_InsertAt( IVector_IInspectable *iface, UINT32 index, IInspectable *value )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+    IInspectable **items;
+    HRESULT hr;
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    if (!value) return E_INVALIDARG;
+    if (index > impl->items.count) return E_BOUNDS;
+    if (impl->owner && impl->callbacks->inserted && FAILED(hr = impl->callbacks->inserted( impl->owner, value ))) return hr;
+    if (impl->items.count == impl->capacity)
+    {
+        UINT32 capacity = max( 4, impl->capacity * 2 );
+        if (!(items = realloc( impl->items.items, capacity * sizeof(*items) ))) return E_OUTOFMEMORY;
+        impl->items.items = items;
+        impl->capacity = capacity;
+    }
+    memmove( impl->items.items + index + 1, impl->items.items + index, (impl->items.count - index) * sizeof(*items) );
+    impl->items.items[index] = value;
+    IInspectable_AddRef( value );
+    impl->items.count++;
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_RemoveAt( IVector_IInspectable *iface, UINT32 index )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+    IInspectable *item;
+
+    TRACE( "iface %p, index %u.\n", iface, index );
+
+    if (index >= impl->items.count) return E_BOUNDS;
+    item = impl->items.items[index];
+    impl->items.count--;
+    memmove( impl->items.items + index, impl->items.items + index + 1, (impl->items.count - index) * sizeof(item) );
+    if (impl->owner && impl->callbacks->removed) impl->callbacks->removed( impl->owner, item );
+    IInspectable_Release( item );
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_SetAt( IVector_IInspectable *iface, UINT32 index, IInspectable *value )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+    HRESULT hr;
+
+    if (index >= impl->items.count) return E_BOUNDS;
+    if (FAILED(hr = vector_RemoveAt( iface, index ))) return hr;
+    return vector_InsertAt( iface, index, value );
+}
+
+static HRESULT WINAPI vector_Append( IVector_IInspectable *iface, IInspectable *value )
+{
+    return vector_InsertAt( iface, impl_from_IVector_IInspectable( iface )->items.count, value );
+}
+
+static HRESULT WINAPI vector_RemoveAtEnd( IVector_IInspectable *iface )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+
+    if (!impl->items.count) return E_BOUNDS;
+    return vector_RemoveAt( iface, impl->items.count - 1 );
+}
+
+static HRESULT WINAPI vector_Clear( IVector_IInspectable *iface )
+{
+    struct vector *impl = impl_from_IVector_IInspectable( iface );
+
+    while (impl->items.count) vector_RemoveAt( iface, impl->items.count - 1 );
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_GetMany( IVector_IInspectable *iface, UINT32 start, UINT32 size, IInspectable **items,
+                                      UINT32 *count )
+{
+    return items_get_many( &impl_from_IVector_IInspectable( iface )->items, start, size, items, count );
+}
+
+static HRESULT WINAPI vector_ReplaceAll( IVector_IInspectable *iface, UINT32 count, IInspectable **items )
+{
+    HRESULT hr = S_OK;
+    UINT32 i;
+
+    vector_Clear( iface );
+    for (i = 0; i < count && SUCCEEDED(hr); i++) hr = vector_Append( iface, items[i] );
+    return hr;
+}
+
+static const struct IVector_IInspectableVtbl vector_vtbl =
+{
+    vector_QueryInterface,
+    vector_AddRef,
+    vector_Release,
+    /* IInspectable methods */
+    vector_GetIids,
+    vector_GetRuntimeClassName,
+    vector_GetTrustLevel,
+    /* IVector<T> methods */
+    vector_GetAt,
+    vector_get_Size,
+    vector_GetView,
+    vector_IndexOf,
+    vector_SetAt,
+    vector_InsertAt,
+    vector_RemoveAt,
+    vector_Append,
+    vector_RemoveAtEnd,
+    vector_Clear,
+    vector_GetMany,
+    vector_ReplaceAll,
+};
+
+DEFINE_IINSPECTABLE_( vector_iterable, IIterable_IInspectable, struct vector, vector_from_IIterable, IIterable_IInspectable_iface,
+                      &impl->IVector_IInspectable_iface )
+
+static HRESULT WINAPI vector_iterable_First( IIterable_IInspectable *iface, IIterator_IInspectable **value )
+{
+    struct vector *impl = vector_from_IIterable( iface );
+    return iterator_create( impl->iids, &impl->items, value );
+}
+
+static const struct IIterable_IInspectableVtbl vector_iterable_vtbl =
+{
+    vector_iterable_QueryInterface,
+    vector_iterable_AddRef,
+    vector_iterable_Release,
+    /* IInspectable methods */
+    vector_iterable_GetIids,
+    vector_iterable_GetRuntimeClassName,
+    vector_iterable_GetTrustLevel,
+    /* IIterable<T> methods */
+    vector_iterable_First,
+};
+
+HRESULT vector_create( const struct vector_iids *iids, const struct vector_callbacks *callbacks, void *owner,
+                       IInspectable **out )
+{
+    struct vector *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVector_IInspectable_iface.lpVtbl = &vector_vtbl;
+    impl->IIterable_IInspectable_iface.lpVtbl = &vector_iterable_vtbl;
+    impl->ref = 1;
+    impl->iids = iids;
+    impl->callbacks = callbacks;
+    impl->owner = owner;
+    *out = (IInspectable *)&impl->IVector_IInspectable_iface;
+    return S_OK;
+}
+
+UINT32 vector_size( IInspectable *object )
+{
+    struct vector *impl = vector_from_iinspectable( object );
+    return impl ? impl->items.count : 0;
+}
+
+IInspectable *vector_get( IInspectable *object, UINT32 index )
+{
+    struct vector *impl = vector_from_iinspectable( object );
+    return impl && index < impl->items.count ? impl->items.items[index] : NULL;
+}
+
+void vector_detach( IInspectable *object )
+{
+    struct vector *impl = vector_from_iinspectable( object );
+    UINT32 i;
+
+    if (!impl || !impl->owner) return;
+    if (impl->callbacks->removed)
+        for (i = 0; i < impl->items.count; i++) impl->callbacks->removed( impl->owner, impl->items.items[i] );
+    impl->owner = NULL;
+}
