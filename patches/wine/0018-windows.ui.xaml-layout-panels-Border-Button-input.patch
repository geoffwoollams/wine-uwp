+++ b/dlls/windows.ui.xaml/border.c
@@ -0,0 +1,341 @@
+/* WinRT Windows.UI.Xaml.Controls.Border implementation
+ *
+ * Copyright 2026 wine-uwp contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+struct border
+{
+    struct xaml_element element;
+    IBorder IBorder_iface;
+    IBrush *background, *border_brush;
+    Thickness border_thickness, padding;
+    CornerRadius corner_radius;
+    IUIElement *child;
+};
+
+static inline struct border *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct border, element );
+}
+
+static struct xaml_element *border_child( struct border *impl )
+{
+    return impl->child ? element_from_iinspectable( (IInspectable *)impl->child ) : NULL;
+}
+
+static HRESULT border_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct border *impl = impl_from_element( element );
+
+    if (!IsEqualGUID( iid, &IID_IBorder )) return E_NOINTERFACE;
+    *out = &impl->IBorder_iface;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void border_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                            float avail_height, float *width, float *height )
+{
+    struct border *impl = impl_from_element( element );
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    float extra_width = b->Left + b->Right + p->Left + p->Right, extra_height = b->Top + b->Bottom + p->Top + p->Bottom;
+    struct xaml_element *child = border_child( impl );
+
+    *width = extra_width;
+    *height = extra_height;
+    if (!child) return;
+    element_measure( child, ctx, max( 0.0f, avail_width - extra_width ), max( 0.0f, avail_height - extra_height ) );
+    *width += child->desired_width;
+    *height += child->desired_height;
+}
+
+static void border_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct border *impl = impl_from_element( element );
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    const struct layout_rect *r = &element->bounds;
+    struct xaml_element *child = border_child( impl );
+
+    if (!child) return;
+    element_arrange( child, ctx, r->x + b->Left + p->Left, r->y + b->Top + p->Top,
+                     max( 0.0f, r->width - b->Left - b->Right - p->Left - p->Right ),
+                     max( 0.0f, r->height - b->Top - b->Bottom - p->Top - p->Bottom ) );
+}
+
+static void border_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct border *impl = impl_from_element( element );
+    struct xaml_element *child = border_child( impl );
+
+    element_fill( ctx, &element->bounds, impl->background );
+    element_frame( ctx, &element->bounds, &impl->border_thickness, impl->border_brush );
+    if (child) element_render( child, ctx );
+}
+
+static UINT32 border_child_count( struct xaml_element *element )
+{
+    return border_child( impl_from_element( element ) ) ? 1 : 0;
+}
+
+static struct xaml_element *border_child_at( struct xaml_element *element, UINT32 index )
+{
+    return border_child( impl_from_element( element ) );
+}
+
+static BOOL border_hit_self( struct xaml_element *element, float x, float y )
+{
+    struct border *impl = impl_from_element( element );
+    return impl->background || impl->border_brush;
+}
+
+static void border_destroy( struct xaml_element *element )
+{
+    struct border *impl = impl_from_element( element );
+    struct xaml_element *child = border_child( impl );
+
+    if (child && child->parent == element) element_set_parent( child, NULL );
+    if (impl->child) IUIElement_Release( impl->child );
+    if (impl->background) IBrush_Release( impl->background );
+    if (impl->border_brush) IBrush_Release( impl->border_brush );
+    free( impl );
+}
+
+static const struct element_ops border_ops =
+{
+    .query_interface = border_query_interface,
+    .measure = border_measure,
+    .arrange = border_arrange,
+    .render = border_render,
+    .child_count = border_child_count,
+    .child_at = border_child_at,
+    .hit_self = border_hit_self,
+    .destroy = border_destroy,
+};
+
+static void set_brush( IBrush **slot, IBrush *value )
+{
+    if (value) IBrush_AddRef( value );
+    if (*slot) IBrush_Release( *slot );
+    *slot = value;
+    window_invalidate();
+}
+
+DEFINE_IINSPECTABLE_( border_iface, IBorder, struct border, impl_from_IBorder, IBorder_iface, impl->element.outer )
+
+static HRESULT WINAPI border_iface_get_BorderBrush( IBorder *iface, IBrush **value )
+{
+    if ((*value = impl_from_IBorder( iface )->border_brush)) IBrush_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_put_BorderBrush( IBorder *iface, IBrush *value )
+{
+    set_brush( &impl_from_IBorder( iface )->border_brush, value );
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_get_BorderThickness( IBorder *iface, Thickness *value )
+{
+    *value = impl_from_IBorder( iface )->border_thickness;
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_put_BorderThickness( IBorder *iface, Thickness value )
+{
+    impl_from_IBorder( iface )->border_thickness = value;
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_get_Background( IBorder *iface, IBrush **value )
+{
+    if ((*value = impl_from_IBorder( iface )->background)) IBrush_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_put_Background( IBorder *iface, IBrush *value )
+{
+    set_brush( &impl_from_IBorder( iface )->background, value );
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_get_CornerRadius( IBorder *iface, CornerRadius *value )
+{
+    *value = impl_from_IBorder( iface )->corner_radius;
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_put_CornerRadius( IBorder *iface, CornerRadius value )
+{
+    FIXME( "iface %p: corners are drawn square.\n", iface );
+    impl_from_IBorder( iface )->corner_radius = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_get_Padding( IBorder *iface, Thickness *value )
+{
+    *value = impl_from_IBorder( iface )->padding;
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_put_Padding( IBorder *iface, Thickness value )
+{
+    impl_from_IBorder( iface )->padding = value;
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_get_Child( IBorder *iface, IUIElement **value )
+{
+    if ((*value = impl_from_IBorder( iface )->child)) IUIElement_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_put_Child( IBorder *iface, IUIElement *value )
+{
+    struct border *impl = impl_from_IBorder( iface );
+    struct xaml_element *old = border_child( impl ), *child = NULL;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (value && !(child = element_from_iinspectable( (IInspectable *)value ))) return E_INVALIDARG;
+    if (child && child->parent && child->parent != &impl->element) return E_INVALIDARG;
+    if (value) IUIElement_AddRef( value );
+    if (old && old->parent == &impl->element) element_set_parent( old, NULL );
+    if (impl->child) IUIElement_Release( impl->child );
+    impl->child = value;
+    if (child) element_set_parent( child, &impl->element );
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI border_iface_get_ChildTransitions(IBorder *iface, __FIVector_1_Windows__CUI__CXaml__CMedia__CAnimation__CTransition **value)
+{
+    FIXME("iface %p stub!\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI border_iface_put_ChildTransitions(IBorder *iface, __FIVector_1_Windows__CUI__CXaml__CMedia__CAnimation__CTransition *value)
+{
+    FIXME("iface %p stub!\n", iface);
+    return E_NOTIMPL;
+}
+
+static const struct IBorderVtbl border_iface_vtbl =
+{
+    border_iface_QueryInterface,
+    border_iface_AddRef,
+    border_iface_Release,
+    /* IInspectable methods */
+    border_iface_GetIids,
+    border_iface_GetRuntimeClassName,
+    border_iface_GetTrustLevel,
+    /* IBorder methods */
+    border_iface_get_BorderBrush,
+    border_iface_put_BorderBrush,
+    border_iface_get_BorderThickness,
+    border_iface_put_BorderThickness,
+    border_iface_get_Background,
+    border_iface_put_Background,
+    border_iface_get_CornerRadius,
+    border_iface_put_CornerRadius,
+    border_iface_get_Padding,
+    border_iface_put_Padding,
+    border_iface_get_Child,
+    border_iface_put_Child,
+    border_iface_get_ChildTransitions,
+    border_iface_put_ChildTransitions
+};
+
+static HRESULT border_create( IInspectable **out )
+{
+    struct border *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &border_ops, RuntimeClass_Windows_UI_Xaml_Controls_Border, NULL );
+    impl->IBorder_iface.lpVtbl = &border_iface_vtbl;
+    *out = (IInspectable *)&impl->IBorder_iface;
+    TRACE( "created %p.\n", *out );
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    return border_create( instance );
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+static IActivationFactory border_statics = { &factory_vtbl };
+IActivationFactory *border_factory = &border_statics;
diff --git a/dlls/windows.ui.xaml/button.c b/dlls/windows.ui.xaml/button.c
new file mode 100644
index 0000000..5d515de
--- /dev/null
+++ b/dlls/windows.ui.xaml/button.c
@@ -0,0 +1,980 @@
+/* WinRT Windows.UI.Xaml.Controls.Button implementation
+ *
+ * Copyright 2026 wine-uwp contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* There are no control templates yet (milestone 4), so Button draws the Windows 10 default look itself: a filled
+ * rectangle with a 2 px border and its content centred, with the Normal / PointerOver / Pressed / Disabled colours
+ * of the light and dark themes. Content is a UIElement, or anything else shown as text (strings, IStringable). */
+
+struct button
+{
+    struct xaml_element element;
+    IButton IButton_iface;
+    IButtonBase IButtonBase_iface;
+    IContentControl IContentControl_iface;
+    IControl IControl_iface;
+
+    IInspectable *content;
+    struct xaml_element *content_element;   /* content, when it is a UIElement */
+    HSTRING content_text;         /* when the content isn't a UIElement */
+    IBrush *background, *foreground, *border_brush;
+    Thickness border_thickness, padding;
+    double font_size;
+    FontWeight font_weight;
+    FontStyle font_style;
+    HorizontalAlignment content_horizontal;
+    VerticalAlignment content_vertical;
+    boolean enabled, pointer_over, pressed, captured;
+    ClickMode click_mode;
+    struct event_list click;
+};
+
+static inline struct button *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct button, element );
+}
+
+static struct xaml_element *button_content_element( struct button *impl )
+{
+    return impl->content_element;
+}
+
+static void button_text_format( struct button *impl, struct text_format *format )
+{
+    format->font_size = impl->font_size;
+    format->weight = impl->font_weight.Weight;
+    format->italic = impl->font_style != FontStyle_Normal;
+    format->wrap = FALSE;
+    format->alignment = TextAlignment_Center;
+}
+
+static HRESULT button_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct button *impl = impl_from_element( element );
+
+    if (IsEqualGUID( iid, &IID_IButton )) *out = &impl->IButton_iface;
+    else if (IsEqualGUID( iid, &IID_IButtonBase )) *out = &impl->IButtonBase_iface;
+    else if (IsEqualGUID( iid, &IID_IContentControl )) *out = &impl->IContentControl_iface;
+    else if (IsEqualGUID( iid, &IID_IControl )) *out = &impl->IControl_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void button_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                            float avail_height, float *width, float *height )
+{
+    struct button *impl = impl_from_element( element );
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    float extra_width = b->Left + b->Right + p->Left + p->Right, extra_height = b->Top + b->Bottom + p->Top + p->Bottom;
+    struct xaml_element *child = button_content_element( impl );
+    struct text_format format;
+
+    *width = *height = 0;
+    if (child)
+    {
+        element_measure( child, ctx, max( 0.0f, avail_width - extra_width ), max( 0.0f, avail_height - extra_height ) );
+        *width = child->desired_width;
+        *height = child->desired_height;
+    }
+    else if (impl->content_text)
+    {
+        button_text_format( impl, &format );
+        text_measure( ctx, &format, impl->content_text, INFINITY, width, height );
+    }
+    *width += extra_width;
+    *height += extra_height;
+}
+
+static void button_inner_rect( struct button *impl, struct layout_rect *rect )
+{
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    const struct layout_rect *r = &impl->element.bounds;
+
+    rect->x = r->x + b->Left + p->Left;
+    rect->y = r->y + b->Top + p->Top;
+    rect->width = max( 0.0f, r->width - b->Left - b->Right - p->Left - p->Right );
+    rect->height = max( 0.0f, r->height - b->Top - b->Bottom - p->Top - p->Bottom );
+}
+
+static void button_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct button *impl = impl_from_element( element );
+    struct xaml_element *child = button_content_element( impl );
+    struct layout_rect inner;
+    float x, y, w, h;
+
+    if (!child) return;
+    button_inner_rect( impl, &inner );
+    /* the content presenter: Stretch fills, otherwise the content's desired size placed by the content alignment */
+    w = impl->content_horizontal == HorizontalAlignment_Stretch ? inner.width : min( inner.width, child->desired_width );
+    h = impl->content_vertical == VerticalAlignment_Stretch ? inner.height : min( inner.height, child->desired_height );
+    switch (impl->content_horizontal)
+    {
+    case HorizontalAlignment_Left: x = inner.x; break;
+    case HorizontalAlignment_Right: x = inner.x + inner.width - w; break;
+    default: x = inner.x + (inner.width - w) / 2; break;
+    }
+    switch (impl->content_vertical)
+    {
+    case VerticalAlignment_Top: y = inner.y; break;
+    case VerticalAlignment_Bottom: y = inner.y + inner.height - h; break;
+    default: y = inner.y + (inner.height - h) / 2; break;
+    }
+    element_arrange( child, ctx, x, y, w, h );
+}
+
+static BOOL brush_colorref( IBrush *brush, COLORREF *color )
+{
+    Color c;
+
+    if (!brush || !brush_get_color( brush, &c ) || !c.A) return FALSE;
+    *color = RGB( c.R, c.G, c.B );
+    return TRUE;
+}
+
+static void button_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct button *impl = impl_from_element( element );
+    struct xaml_element *child = button_content_element( impl );
+    /* Windows 10 theme colours, as #33/#66 black or white over the page background */
+    COLORREF base_low = ctx->dark ? RGB(51, 51, 51) : RGB(204, 204, 204);
+    COLORREF base_medium_low = ctx->dark ? RGB(102, 102, 102) : RGB(153, 153, 153);
+    COLORREF text = ctx->foreground, background = base_low, border = 0;
+    BOOL has_background = TRUE, has_border = FALSE;
+    struct text_format format;
+    struct layout_rect inner;
+    COLORREF saved;
+
+    if (!impl->enabled)
+        text = base_medium_low;
+    else if (impl->pressed)
+        background = base_medium_low;
+    else if (impl->pointer_over)
+    {
+        border = base_medium_low;
+        has_border = TRUE;
+    }
+    else
+    {
+        /* Normal state: the app's own brushes, if set */
+        if (impl->background) has_background = brush_colorref( impl->background, &background );
+        if (impl->border_brush) has_border = brush_colorref( impl->border_brush, &border );
+    }
+    if (impl->enabled && impl->foreground) brush_colorref( impl->foreground, &text );
+
+    if (has_background) element_fill_color( ctx, &element->bounds, background );
+    if (has_border) element_frame_color( ctx, &element->bounds, &impl->border_thickness, border );
+
+    if (child)
+    {
+        saved = ctx->foreground;
+        ctx->foreground = text;   /* inherited by a TextBlock content */
+        element_render( child, ctx );
+        ctx->foreground = saved;
+    }
+    else if (impl->content_text)
+    {
+        button_inner_rect( impl, &inner );
+        button_text_format( impl, &format );
+        text_draw( ctx, &format, impl->content_text, &inner, text );
+    }
+}
+
+static UINT32 button_child_count( struct xaml_element *element )
+{
+    return button_content_element( impl_from_element( element ) ) ? 1 : 0;
+}
+
+static struct xaml_element *button_child_at( struct xaml_element *element, UINT32 index )
+{
+    return button_content_element( impl_from_element( element ) );
+}
+
+static BOOL button_hit_self( struct xaml_element *element, float x, float y )
+{
+    return TRUE;
+}
+
+static void button_raise_click( struct button *impl )
+{
+    IRoutedEventArgs *args;
+    IUnknown **handlers;
+    UINT32 i, count = impl->click.count;
+
+    TRACE( "button %p clicked, %u handler slots.\n", impl, count );
+
+    if (!count || !(handlers = calloc( count, sizeof(*handlers) ))) return;
+    for (i = 0; i < count; i++) if ((handlers[i] = impl->click.handlers[i])) IUnknown_AddRef( handlers[i] );
+    if (SUCCEEDED(routed_event_args_create( impl->element.outer, &args )))
+    {
+        for (i = 0; i < count; i++)
+        {
+            HRESULT hr;
+            if (!handlers[i]) continue;
+            hr = IRoutedEventHandler_Invoke( (IRoutedEventHandler *)handlers[i], impl->element.outer, args );
+            if (FAILED(hr)) WARN( "Click handler %p failed, hr %#lx.\n", handlers[i], hr );
+        }
+        IRoutedEventArgs_Release( args );
+    }
+    for (i = 0; i < count; i++) if (handlers[i]) IUnknown_Release( handlers[i] );
+    free( handlers );
+}
+
+static void button_pointer( struct xaml_element *element, UINT msg, float x, float y )
+{
+    struct button *impl = impl_from_element( element );
+    const struct layout_rect *b = &element->bounds;
+    BOOL inside = x >= b->x && y >= b->y && x < b->x + b->width && y < b->y + b->height;
+
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+        if (!impl->pointer_over && inside) impl->pointer_over = TRUE;
+        if (impl->captured) impl->pressed = inside;
+        break;
+    case WM_MOUSELEAVE:
+        impl->pointer_over = FALSE;
+        if (impl->captured) impl->pressed = FALSE;
+        break;
+    case WM_LBUTTONDOWN:
+        if (!impl->enabled) return;
+        impl->captured = impl->pressed = TRUE;
+        if (impl->click_mode == ClickMode_Press) button_raise_click( impl );
+        break;
+    case WM_LBUTTONUP:
+        if (!impl->captured) return;
+        impl->captured = impl->pressed = FALSE;
+        impl->pointer_over = inside;
+        window_invalidate();
+        if (inside && impl->enabled && impl->click_mode == ClickMode_Release) button_raise_click( impl );
+        break;
+    case WM_CAPTURECHANGED:
+        impl->captured = impl->pressed = FALSE;
+        break;
+    }
+    window_invalidate();
+}
+
+static void button_destroy( struct xaml_element *element )
+{
+    struct button *impl = impl_from_element( element );
+    struct xaml_element *child = button_content_element( impl );
+
+    if (child && child->parent == element) element_set_parent( child, NULL );
+    if (impl->content) IInspectable_Release( impl->content );
+    WindowsDeleteString( impl->content_text );
+    if (impl->background) IBrush_Release( impl->background );
+    if (impl->foreground) IBrush_Release( impl->foreground );
+    if (impl->border_brush) IBrush_Release( impl->border_brush );
+    event_list_clear( &impl->click );
+    free( impl );
+}
