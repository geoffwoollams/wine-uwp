+/* the element that should get pointer input at x,y: the deepest hit element or its nearest ancestor that takes it */
+static struct xaml_element *pointer_target( struct xaml_window *window, float x, float y )
+{
+    struct xaml_element *element;
+
+    if (!window->content || !(element = element_from_iinspectable( (IInspectable *)window->content ))) return NULL;
+    for (element = element_hit_test( element, x, y ); element; element = element->parent)
+        if (element->ops->pointer) return element;
+    return NULL;
+}
