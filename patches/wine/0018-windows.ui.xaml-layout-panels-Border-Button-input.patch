+    struct routed_event_args *impl = impl_from_IRoutedEventArgs( iface );
+    if ((*value = impl->source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IRoutedEventArgsVtbl args_vtbl =
+{
+    args_QueryInterface,
+    args_AddRef,
+    args_Release,
+    /* IInspectable methods */
+    args_GetIids,
+    args_GetRuntimeClassName,
+    args_GetTrustLevel,
+    /* IRoutedEventArgs methods */
+    args_get_OriginalSource,
+};
+
+HRESULT routed_event_args_create( IInspectable *source, IRoutedEventArgs **out )
+{
+    struct routed_event_args *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IRoutedEventArgs_iface.lpVtbl = &args_vtbl;
+    impl->ref = 1;
+    if ((impl->source = source)) IInspectable_AddRef( source );
+    *out = &impl->IRoutedEventArgs_iface;
+    return S_OK;
 }
