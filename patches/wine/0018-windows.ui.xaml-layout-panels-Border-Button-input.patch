+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* StackPanel and Grid share one object type; kind says which. Children live in a UIElementCollection. */
+
+enum panel_kind
+{
+    PANEL_STACK,
+    PANEL_GRID,
+};
+
+struct panel
+{
+    struct xaml_element element;
+    IPanel IPanel_iface;
+    IStackPanel IStackPanel_iface;
+    IGrid IGrid_iface;
+    enum panel_kind kind;
+    IInspectable *children;   /* IVector<UIElement *> */
+    IBrush *background;
+    Orientation orientation;
+    IInspectable *rows, *columns;   /* IVector<RowDefinition *>, IVector<ColumnDefinition *> (Grid) */
+    float *track_content[2];        /* Grid: content size of each column [0] and row [1], from measure */
+    UINT32 track_count[2];
+};
+
+const struct vector_iids uielement_collection_iids =
+{
+    &IID___FIVector_1_Windows__CUI__CXaml__CUIElement,
+    &IID___FIVectorView_1_Windows__CUI__CXaml__CUIElement,
+    &IID___FIIterable_1_Windows__CUI__CXaml__CUIElement,
+    &IID___FIIterator_1_Windows__CUI__CXaml__CUIElement,
+    &IID_IUIElement,
+};
+
+static const struct vector_iids row_collection_iids =
+{
+    &IID___FIVector_1_Windows__CUI__CXaml__CControls__CRowDefinition,
+    &IID___FIVectorView_1_Windows__CUI__CXaml__CControls__CRowDefinition,
+    &IID___FIIterable_1_Windows__CUI__CXaml__CControls__CRowDefinition,
+    &IID___FIIterator_1_Windows__CUI__CXaml__CControls__CRowDefinition,
+    &IID_IRowDefinition,
+};
+
+static const struct vector_iids column_collection_iids =
+{
+    &IID___FIVector_1_Windows__CUI__CXaml__CControls__CColumnDefinition,
+    &IID___FIVectorView_1_Windows__CUI__CXaml__CControls__CColumnDefinition,
+    &IID___FIIterable_1_Windows__CUI__CXaml__CControls__CColumnDefinition,
+    &IID___FIIterator_1_Windows__CUI__CXaml__CControls__CColumnDefinition,
+    &IID_IColumnDefinition,
+};
+
+static inline struct panel *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct panel, element );
+}
+
+/* children collection callbacks */
+
+static HRESULT children_inserted( void *owner, IInspectable *item )
+{
+    struct xaml_element *child = element_from_iinspectable( item );
+
+    if (!child) return E_INVALIDARG;
+    if (child->parent)
+    {
+        WARN( "element %p already has a parent.\n", item );
+        return E_INVALIDARG;
+    }
+    element_set_parent( child, owner );
+    return S_OK;
+}
+
+static void children_removed( void *owner, IInspectable *item )
+{
+    struct xaml_element *child = element_from_iinspectable( item );
+    if (child && child->parent == owner) element_set_parent( child, NULL );
+}
+
+static const struct vector_callbacks children_callbacks = { children_inserted, children_removed };
+
+static HRESULT definitions_inserted( void *owner, IInspectable *item )
+{
+    GridLength length;
+    double min, max;
+    return definition_get( item, &length, &min, &max ) ? S_OK : E_INVALIDARG;
+}
+
+static void definitions_removed( void *owner, IInspectable *item )
+{
+}
+
+static const struct vector_callbacks definitions_callbacks = { definitions_inserted, definitions_removed };
+
+static struct xaml_element *panel_child( struct panel *impl, UINT32 index )
+{
+    return element_from_iinspectable( vector_get( impl->children, index ) );
+}
+
+/* StackPanel layout */
+
+static void stack_measure( struct panel *impl, struct layout_context *ctx, float avail_width, float avail_height,
+                           float *width, float *height )
+{
+    BOOL vertical = impl->orientation == Orientation_Vertical;
+    UINT32 i, count = vector_size( impl->children );
+    struct xaml_element *child;
+
+    *width = *height = 0;
+    for (i = 0; i < count; i++)
+    {
+        if (!(child = panel_child( impl, i ))) continue;
+        if (vertical)
+        {
+            element_measure( child, ctx, avail_width, INFINITY );
+            *width = max( *width, child->desired_width );
+            *height += child->desired_height;
+        }
+        else
+        {
+            element_measure( child, ctx, INFINITY, avail_height );
+            *width += child->desired_width;
+            *height = max( *height, child->desired_height );
+        }
+    }
+}
+
+static void stack_arrange( struct panel *impl, struct layout_context *ctx )
+{
+    BOOL vertical = impl->orientation == Orientation_Vertical;
+    UINT32 i, count = vector_size( impl->children );
+    const struct layout_rect *b = &impl->element.bounds;
+    float offset = 0;
+    struct xaml_element *child;
+
+    for (i = 0; i < count; i++)
+    {
+        if (!(child = panel_child( impl, i ))) continue;
+        if (vertical)
+        {
+            element_arrange( child, ctx, b->x, b->y + offset, b->width, child->desired_height );
+            offset += child->desired_height;
+        }
+        else
+        {
+            element_arrange( child, ctx, b->x + offset, b->y, child->desired_width, b->height );
+            offset += child->desired_width;
+        }
+    }
+}
+
+/* Grid layout. Tracks (columns, then rows) are Pixel, Auto or Star. Measure: Pixel tracks take their size, Auto
+ * tracks the largest child that sits only in Auto/Pixel tracks, Star tracks share what is left of the available
+ * size by weight. The Grid's desired size uses the Star tracks' content, so a non-stretched Grid sizes to its
+ * content. Arrange shares the final size the same way. Columns are resolved first so that children know their
+ * width when the rows are measured. */
+
+struct track
+{
+    GridUnitType type;
+    double value;     /* pixels or star weight */
+    double min, max;
+    float size;
+    float content;    /* largest content (Auto), or content per star unit times weight (Star) */
+    float offset;
+};
+
+static void child_cell( struct xaml_element *child, BOOL rows, UINT32 count, UINT32 *start, UINT32 *span )
+{
+    INT32 index = rows ? child->row : child->column, n = rows ? child->row_span : child->column_span;
+
+    *start = min( (UINT32)max( 0, index ), count - 1 );
+    *span = min( (UINT32)max( 1, n ), count - *start );
+}
+
+static struct track *grid_tracks( struct panel *impl, BOOL rows, UINT32 *count )
+{
+    IInspectable *defs = rows ? impl->rows : impl->columns;
+    UINT32 i, n = vector_size( defs );
+    struct track *tracks;
+    GridLength length;
+
+    *count = max( 1, n );
+    if (!(tracks = calloc( *count, sizeof(*tracks) ))) return NULL;
+    tracks[0].type = GridUnitType_Star;
+    tracks[0].value = 1.0;
+    tracks[0].max = INFINITY;
+    for (i = 0; i < n; i++)
+    {
+        definition_get( vector_get( defs, i ), &length, &tracks[i].min, &tracks[i].max );
+        tracks[i].type = length.GridUnitType;
+        tracks[i].value = length.GridUnitType == GridUnitType_Auto ? 0 : max( 0.0, length.Value );
+        if (tracks[i].type == GridUnitType_Pixel) tracks[i].size = tracks[i].content = tracks[i].value;
+    }
+    return tracks;
+}
+
+static float tracks_span_size( const struct track *tracks, UINT32 start, UINT32 span, BOOL *has_star, BOOL *has_auto )
+{
+    float size = 0;
+    UINT32 i;
+
+    if (has_star) *has_star = FALSE;
+    if (has_auto) *has_auto = FALSE;
+    for (i = start; i < start + span; i++)
+    {
+        size += tracks[i].size;
+        if (tracks[i].type == GridUnitType_Star && has_star) *has_star = TRUE;
+        if (tracks[i].type == GridUnitType_Auto && has_auto) *has_auto = TRUE;
+    }
+    return size;
+}
+
+/* share avail between the star tracks by weight; with avail INFINITY, use their content */
+static void tracks_resolve_stars( struct track *tracks, UINT32 count, float avail )
+{
+    float fixed = 0, weights = 0, unit = 0;
+    UINT32 i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (tracks[i].type == GridUnitType_Star) weights += tracks[i].value;
+        else fixed += tracks[i].size;
+    }
+    if (weights <= 0) return;
+    if (isinf( avail ))
+    {
+        for (i = 0; i < count; i++)
+            if (tracks[i].type == GridUnitType_Star && tracks[i].value > 0)
+                unit = max( unit, tracks[i].content / tracks[i].value );
+    }
+    else unit = max( 0.0f, avail - fixed ) / weights;
+    for (i = 0; i < count; i++)
+        if (tracks[i].type == GridUnitType_Star)
+            tracks[i].size = min( tracks[i].max, max( tracks[i].min, unit * tracks[i].value ) );
+}
+
+static float tracks_total( const struct track *tracks, UINT32 count, BOOL content )
+{
+    float total = 0, unit = 0, weights = 0;
+    UINT32 i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (tracks[i].type == GridUnitType_Star && content)
+        {
+            weights += tracks[i].value;
+            if (tracks[i].value > 0) unit = max( unit, tracks[i].content / tracks[i].value );
+        }
+        else total += tracks[i].size;
+    }
+    return total + unit * weights;
+}
+
+/* measure the children for one dimension and size its Auto tracks; cross holds the other dimension's sizes */
+static void grid_size_tracks( struct panel *impl, struct layout_context *ctx, BOOL rows, struct track *tracks, UINT32 count,
+                              struct track *cross, UINT32 cross_count, float avail )
+{
+    UINT32 i, n = vector_size( impl->children ), start, span, cstart, cspan, j;
+    struct xaml_element *child;
+    BOOL star, autos;
+    float cross_size, size, desired;
+
+    /* Auto tracks: children that sit in no Star track of this dimension */
+    for (i = 0; i < n; i++)
+    {
+        if (!(child = panel_child( impl, i ))) continue;
+        child_cell( child, rows, count, &start, &span );
+        tracks_span_size( tracks, start, span, &star, &autos );
+        if (star) continue;
+        child_cell( child, !rows, cross_count, &cstart, &cspan );
+        cross_size = cross ? tracks_span_size( cross, cstart, cspan, NULL, NULL ) : INFINITY;
+        size = autos ? INFINITY : tracks_span_size( tracks, start, span, NULL, NULL );
+        if (rows) element_measure( child, ctx, cross_size, size );
+        else element_measure( child, ctx, size, INFINITY );
+        desired = rows ? child->desired_height : child->desired_width;
+        /* grow the last Auto track of the span by what the child needs beyond the span's current size */
+        size = tracks_span_size( tracks, start, span, NULL, NULL );
+        for (j = start + span; j > start; j--)
+        {
+            if (tracks[j - 1].type != GridUnitType_Auto) continue;
+            if (desired > size) tracks[j - 1].size += desired - size;
+            tracks[j - 1].content = tracks[j - 1].size;
+            break;
+        }
+    }
+
+    /* Star tracks: content per star unit, from children that sit in a single Star track */
+    for (i = 0; i < n; i++)
+    {
+        if (!(child = panel_child( impl, i ))) continue;
+        child_cell( child, rows, count, &start, &span );
+        if (span != 1 || tracks[start].type != GridUnitType_Star) continue;
+        child_cell( child, !rows, cross_count, &cstart, &cspan );
+        cross_size = cross ? tracks_span_size( cross, cstart, cspan, NULL, NULL ) : INFINITY;
+        if (rows) element_measure( child, ctx, cross_size, INFINITY );
+        else element_measure( child, ctx, INFINITY, INFINITY );
+        desired = rows ? child->desired_height : child->desired_width;
+        tracks[start].content = max( tracks[start].content, desired );
+    }
+    tracks_resolve_stars( tracks, count, avail );
+}
+
+static void grid_measure( struct panel *impl, struct layout_context *ctx, float avail_width, float avail_height,
+                          float *width, float *height )
+{
+    UINT32 ncols, nrows, i, n = vector_size( impl->children ), cs, cn, rs, rn;
+    struct track *cols = grid_tracks( impl, FALSE, &ncols ), *rows = grid_tracks( impl, TRUE, &nrows );
+    struct xaml_element *child;
+
+    *width = *height = 0;
+    if (!cols || !rows) goto done;
+
+    grid_size_tracks( impl, ctx, FALSE, cols, ncols, NULL, nrows, avail_width );
+    grid_size_tracks( impl, ctx, TRUE, rows, nrows, cols, ncols, avail_height );
+
+    /* final measure of every child in its cell */
+    for (i = 0; i < n; i++)
+    {
+        if (!(child = panel_child( impl, i ))) continue;
+        child_cell( child, FALSE, ncols, &cs, &cn );
+        child_cell( child, TRUE, nrows, &rs, &rn );
+        element_measure( child, ctx, tracks_span_size( cols, cs, cn, NULL, NULL ), tracks_span_size( rows, rs, rn, NULL, NULL ) );
+    }
+
+    *width = tracks_total( cols, ncols, TRUE );
+    *height = tracks_total( rows, nrows, TRUE );
+
+    /* keep the content sizes for arrange */
+    for (i = 0; i < 2; i++) free( impl->track_content[i] );
+    impl->track_content[0] = calloc( ncols, sizeof(float) );
+    impl->track_content[1] = calloc( nrows, sizeof(float) );
+    impl->track_count[0] = ncols;
+    impl->track_count[1] = nrows;
+    for (i = 0; i < ncols && impl->track_content[0]; i++) impl->track_content[0][i] = cols[i].size;
+    for (i = 0; i < nrows && impl->track_content[1]; i++) impl->track_content[1][i] = rows[i].size;
+
+done:
+    free( cols );
+    free( rows );
+}
+
+static void grid_arrange( struct panel *impl, struct layout_context *ctx )
+{
+    UINT32 ncols, nrows, i, n = vector_size( impl->children ), cs, cn, rs, rn;
+    struct track *cols = grid_tracks( impl, FALSE, &ncols ), *rows = grid_tracks( impl, TRUE, &nrows );
+    const struct layout_rect *b = &impl->element.bounds;
+    struct xaml_element *child;
+    float offset;
+
+    if (!cols || !rows) goto done;
+    for (i = 0; i < ncols; i++)
+        if (cols[i].type == GridUnitType_Auto && impl->track_content[0] && ncols == impl->track_count[0])
+            cols[i].size = impl->track_content[0][i];
+    for (i = 0; i < nrows; i++)
+        if (rows[i].type == GridUnitType_Auto && impl->track_content[1] && nrows == impl->track_count[1])
+            rows[i].size = impl->track_content[1][i];
+    tracks_resolve_stars( cols, ncols, b->width );
+    tracks_resolve_stars( rows, nrows, b->height );
+
+    for (i = 0, offset = 0; i < ncols; offset += cols[i++].size)
+    {
+        cols[i].offset = offset;
+        if (impl->columns && i < vector_size( impl->columns ))
+            definition_set_actual( vector_get( impl->columns, i ), cols[i].size );
+    }
+    for (i = 0, offset = 0; i < nrows; offset += rows[i++].size)
+    {
+        rows[i].offset = offset;
+        if (impl->rows && i < vector_size( impl->rows ))
+            definition_set_actual( vector_get( impl->rows, i ), rows[i].size );
+    }
+
+    for (i = 0; i < n; i++)
+    {
+        if (!(child = panel_child( impl, i ))) continue;
+        child_cell( child, FALSE, ncols, &cs, &cn );
+        child_cell( child, TRUE, nrows, &rs, &rn );
+        element_arrange( child, ctx, b->x + cols[cs].offset, b->y + rows[rs].offset,
+                         tracks_span_size( cols, cs, cn, NULL, NULL ), tracks_span_size( rows, rs, rn, NULL, NULL ) );
+    }
+
+done:
+    free( cols );
+    free( rows );
+}
+
+/* element ops */
+
+static HRESULT panel_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct panel *impl = impl_from_element( element );
+
+    if (IsEqualGUID( iid, &IID_IPanel )) *out = &impl->IPanel_iface;
+    else if (impl->kind == PANEL_STACK && IsEqualGUID( iid, &IID_IStackPanel )) *out = &impl->IStackPanel_iface;
+    else if (impl->kind == PANEL_GRID && IsEqualGUID( iid, &IID_IGrid )) *out = &impl->IGrid_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void panel_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                           float avail_height, float *width, float *height )
+{
+    struct panel *impl = impl_from_element( element );
+
+    if (impl->kind == PANEL_STACK) stack_measure( impl, ctx, avail_width, avail_height, width, height );
+    else grid_measure( impl, ctx, avail_width, avail_height, width, height );
+}
+
+static void panel_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct panel *impl = impl_from_element( element );
+
+    if (impl->kind == PANEL_STACK) stack_arrange( impl, ctx );
+    else grid_arrange( impl, ctx );
+}
+
+static void panel_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct panel *impl = impl_from_element( element );
+    UINT32 i, count = vector_size( impl->children );
+    struct xaml_element *child;
+
+    element_fill( ctx, &element->bounds, impl->background );
+    for (i = 0; i < count; i++) if ((child = panel_child( impl, i ))) element_render( child, ctx );
+}
+
+static UINT32 panel_child_count( struct xaml_element *element )
+{
+    return vector_size( impl_from_element( element )->children );
+}
+
+static struct xaml_element *panel_child_at( struct xaml_element *element, UINT32 index )
+{
+    return panel_child( impl_from_element( element ), index );
+}
+
+static BOOL panel_hit_self( struct xaml_element *element, float x, float y )
+{
+    /* a panel takes the pointer only where it has a background, even a transparent one */
+    return impl_from_element( element )->background != NULL;
+}
+
+static void panel_destroy( struct xaml_element *element )
+{
+    struct panel *impl = impl_from_element( element );
+
+    vector_detach( impl->children );
+    IInspectable_Release( impl->children );
+    if (impl->rows) IInspectable_Release( impl->rows );
+    if (impl->columns) IInspectable_Release( impl->columns );
+    if (impl->background) IBrush_Release( impl->background );
+    free( impl->track_content[0] );
+    free( impl->track_content[1] );
+    free( impl );
+}
+
+static const struct element_ops panel_ops =
+{
+    .query_interface = panel_query_interface,
+    .measure = panel_measure,
+    .arrange = panel_arrange,
+    .render = panel_render,
+    .child_count = panel_child_count,
+    .child_at = panel_child_at,
+    .hit_self = panel_hit_self,
+    .destroy = panel_destroy,
+};
+
+/* IPanel */
+
+DEFINE_IINSPECTABLE_( panel_iface, IPanel, struct panel, impl_from_IPanel, IPanel_iface, impl->element.outer )
+
+static HRESULT WINAPI panel_iface_get_Children( IPanel *iface, __FIVector_1_Windows__CUI__CXaml__CUIElement **value )
+{
+    struct panel *impl = impl_from_IPanel( iface );
+    *value = (__FIVector_1_Windows__CUI__CXaml__CUIElement *)impl->children;
+    IInspectable_AddRef( impl->children );
+    return S_OK;
+}
+
+static HRESULT WINAPI panel_iface_get_Background( IPanel *iface, IBrush **value )
+{
+    struct panel *impl = impl_from_IPanel( iface );
+    if ((*value = impl->background)) IBrush_AddRef( *value );
+    return S_OK;
