+static HRESULT button_create( IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct button *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &button_ops, RuntimeClass_Windows_UI_Xaml_Controls_Button, outer );
+    impl->IButton_iface.lpVtbl = &button_iface_vtbl;
+    impl->IButtonBase_iface.lpVtbl = &button_base_vtbl;
+    impl->IContentControl_iface.lpVtbl = &content_control_vtbl;
+    impl->IControl_iface.lpVtbl = &control_vtbl;
+    /* the default Button style */
+    impl->element.horizontal_alignment = HorizontalAlignment_Left;
+    impl->element.vertical_alignment = VerticalAlignment_Center;
+    impl->border_thickness.Left = impl->border_thickness.Top = impl->border_thickness.Right = impl->border_thickness.Bottom = 2;
+    impl->padding.Left = 8;
+    impl->padding.Top = 4;
+    impl->padding.Right = 8;
+    impl->padding.Bottom = 5;
+    impl->font_size = 14.0;
+    impl->font_weight.Weight = 400;
+    impl->content_horizontal = HorizontalAlignment_Center;
+    impl->content_vertical = VerticalAlignment_Center;
+    impl->enabled = TRUE;
+    impl->click_mode = ClickMode_Release;
+    TRACE( "created %p, outer %p.\n", impl, outer );
+    return element_compose( &impl->element, outer, inner, &impl->IButton_iface, value );
+}
