+};
+
+/* activation factories */
+
+struct definition_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    BOOL column;
+};
+
+static inline struct definition_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct definition_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct definition_factory *impl = impl_from_IActivationFactory( iface );
+    struct definition *def;
+
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+
+    if (!(def = calloc( 1, sizeof(*def) ))) return E_OUTOFMEMORY;
+    def->IRowDefinition_iface.lpVtbl = &row_vtbl;
+    def->IColumnDefinition_iface.lpVtbl = &column_vtbl;
+    def->IDependencyObject_iface.lpVtbl = &definition_dependency_object_vtbl;
+    def->ref = 1;
+    def->column = impl->column;
+    def->length.Value = 1.0;
+    def->length.GridUnitType = GridUnitType_Star;
+    def->max = INFINITY;
+    *instance = definition_iinspectable( def );
+    return S_OK;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+static struct definition_factory row_factory = { {&factory_vtbl}, FALSE };
+static struct definition_factory column_factory = { {&factory_vtbl}, TRUE };
+
+IActivationFactory *row_definition_factory = &row_factory.IActivationFactory_iface;
+IActivationFactory *column_definition_factory = &column_factory.IActivationFactory_iface;
+
+/* for Grid layout: the length of a definition from a RowDefinitionCollection or ColumnDefinitionCollection item */
+BOOL definition_get( IInspectable *object, GridLength *length, double *min, double *max )
+{
+    struct definition *def = definition_from_iinspectable( object );
+
+    if (!def) return FALSE;
+    *length = def->length;
+    *min = def->min;
+    *max = def->max;
+    return TRUE;
+}
+
+void definition_set_actual( IInspectable *object, double actual )
+{
+    struct definition *def = definition_from_iinspectable( object );
+    if (def) def->actual = actual;
+}
