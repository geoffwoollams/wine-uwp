+static HRESULT panel_create( enum panel_kind kind, IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct panel *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &panel_ops, kind == PANEL_STACK ? RuntimeClass_Windows_UI_Xaml_Controls_StackPanel
+                                                                   : RuntimeClass_Windows_UI_Xaml_Controls_Grid, outer );
+    impl->IPanel_iface.lpVtbl = &panel_iface_vtbl;
+    impl->IStackPanel_iface.lpVtbl = &stack_panel_iface_vtbl;
+    impl->IGrid_iface.lpVtbl = &grid_iface_vtbl;
+    impl->kind = kind;
+    impl->orientation = Orientation_Vertical;
+    if (FAILED(hr = vector_create( &uielement_collection_iids, &children_callbacks, &impl->element, &impl->children )))
+        goto failed;
+    if (kind == PANEL_GRID)
+    {
+        if (FAILED(hr = vector_create( &row_collection_iids, &definitions_callbacks, impl, &impl->rows ))) goto failed;
+        if (FAILED(hr = vector_create( &column_collection_iids, &definitions_callbacks, impl, &impl->columns ))) goto failed;
+    }
+    TRACE( "created %s %p, outer %p.\n", debugstr_w(impl->element.class_name), impl, outer );
+    return element_compose( &impl->element, outer, inner,
+                            kind == PANEL_STACK ? (void *)&impl->IStackPanel_iface : (void *)&impl->IGrid_iface, value );
+
+failed:
+    if (impl->children) IInspectable_Release( impl->children );
+    if (impl->rows) IInspectable_Release( impl->rows );
+    free( impl );
+    return hr;
