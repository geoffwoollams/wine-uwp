+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* What input the machine has: a keyboard and a mouse (its buttons from the system metrics), and no touch screen,
+ * which Wine doesn't pass on as touch. Each class's instances are one static object. */
+
+#define CAPS_IUNKNOWN( pfx, Iface, class_name ) \
+static HRESULT WINAPI pfx##_QueryInterface( Iface *iface, REFIID iid, void **out ) \
+{ \
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) || \
+        IsEqualGUID( iid, &IID_##Iface )) \
+    { \
+        *out = iface; \
+        return S_OK; \
+    } \
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) ); \
+    *out = NULL; \
+    return E_NOINTERFACE; \
+} \
+static ULONG WINAPI pfx##_AddRef( Iface *iface ) { return 2; } \
+static ULONG WINAPI pfx##_Release( Iface *iface ) { return 1; } \
+static HRESULT WINAPI pfx##_GetIids( Iface *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+static HRESULT WINAPI pfx##_GetRuntimeClassName( Iface *iface, HSTRING *name ) \
+{ \
+    return WindowsCreateString( class_name, wcslen( class_name ), name ); \
+} \
+static HRESULT WINAPI pfx##_GetTrustLevel( Iface *iface, TrustLevel *level ) \
+{ \
+    *level = BaseTrust; \
+    return S_OK; \
+}
+
+CAPS_IUNKNOWN( keyboard, IKeyboardCapabilities, L"Windows.Devices.Input.KeyboardCapabilities" )
+
+static HRESULT WINAPI keyboard_get_KeyboardPresent( IKeyboardCapabilities *iface, INT32 *value )
+{
+    *value = 1;
+    return S_OK;
+}
+
+static const struct IKeyboardCapabilitiesVtbl keyboard_vtbl =
+{
+    keyboard_QueryInterface, keyboard_AddRef, keyboard_Release,
+    keyboard_GetIids, keyboard_GetRuntimeClassName, keyboard_GetTrustLevel,
+    keyboard_get_KeyboardPresent,
+};
+
+static IKeyboardCapabilities keyboard_caps = { &keyboard_vtbl };
+
+CAPS_IUNKNOWN( mouse_caps, IMouseCapabilities, L"Windows.Devices.Input.MouseCapabilities" )
+
+static HRESULT WINAPI mouse_caps_get_MousePresent( IMouseCapabilities *iface, INT32 *value )
+{
+    *value = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI mouse_caps_get_VerticalWheelPresent( IMouseCapabilities *iface, INT32 *value )
+{
+    *value = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI mouse_caps_get_HorizontalWheelPresent( IMouseCapabilities *iface, INT32 *value )
+{
+    *value = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI mouse_caps_get_SwapButtons( IMouseCapabilities *iface, INT32 *value )
+{
+    *value = GetSystemMetrics( SM_SWAPBUTTON ) ? 1 : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI mouse_caps_get_NumberOfButtons( IMouseCapabilities *iface, UINT32 *value )
+{
+    *value = max( 3, GetSystemMetrics( SM_CMOUSEBUTTONS ) );
+    return S_OK;
+}
+
+static const struct IMouseCapabilitiesVtbl mouse_caps_vtbl =
+{
+    mouse_caps_QueryInterface, mouse_caps_AddRef, mouse_caps_Release,
+    mouse_caps_GetIids, mouse_caps_GetRuntimeClassName, mouse_caps_GetTrustLevel,
+    mouse_caps_get_MousePresent,
+    mouse_caps_get_VerticalWheelPresent,
+    mouse_caps_get_HorizontalWheelPresent,
+    mouse_caps_get_SwapButtons,
+    mouse_caps_get_NumberOfButtons,
+};
+
+static IMouseCapabilities mouse_caps = { &mouse_caps_vtbl };
+
+CAPS_IUNKNOWN( touch_caps, ITouchCapabilities, L"Windows.Devices.Input.TouchCapabilities" )
+
+static HRESULT WINAPI touch_caps_get_TouchPresent( ITouchCapabilities *iface, INT32 *value )
+{
+    *value = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI touch_caps_get_Contacts( ITouchCapabilities *iface, UINT32 *value )
+{
+    *value = 0;
+    return S_OK;
+}
+
+static const struct ITouchCapabilitiesVtbl touch_caps_vtbl =
+{
+    touch_caps_QueryInterface, touch_caps_AddRef, touch_caps_Release,
+    touch_caps_GetIids, touch_caps_GetRuntimeClassName, touch_caps_GetTrustLevel,
+    touch_caps_get_TouchPresent,
+    touch_caps_get_Contacts,
+};
+
+static ITouchCapabilities touch_caps = { &touch_caps_vtbl };
+
+/* the factories: ActivateInstance gives the object */
+
+struct caps_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IInspectable *instance;
+};
+
+static inline struct caps_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct caps_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    *instance = impl_from_IActivationFactory( iface )->instance;
+    return S_OK;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+static struct caps_factory keyboard_factory = { {&factory_vtbl}, (IInspectable *)&keyboard_caps };
+static struct caps_factory mouse_factory = { {&factory_vtbl}, (IInspectable *)&mouse_caps };
+static struct caps_factory touch_factory = { {&factory_vtbl}, (IInspectable *)&touch_caps };
+
+IActivationFactory *keyboard_capabilities_factory = &keyboard_factory.IActivationFactory_iface;
+IActivationFactory *mouse_capabilities_factory = &mouse_factory.IActivationFactory_iface;
+IActivationFactory *touch_capabilities_factory = &touch_factory.IActivationFactory_iface;
