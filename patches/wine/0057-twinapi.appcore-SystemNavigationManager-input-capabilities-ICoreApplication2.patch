+/* ---- ICoreApplication2 on core_app: there is no prelaunch or background activation, so its events never fire ---- */
+static inline struct core_app *impl_from_core_app2(ICoreApplication2 *iface)
+{ return CONTAINING_RECORD(iface, struct core_app, ICoreApplication2_iface); }
+static HRESULT WINAPI core_app2_QueryInterface(ICoreApplication2 *iface, REFIID iid, void **out)
+{ return core_app_qi(impl_from_core_app2(iface), iid, out); }
+static ULONG WINAPI core_app2_AddRef(ICoreApplication2 *iface) { return core_app_addref(impl_from_core_app2(iface)); }
+static ULONG WINAPI core_app2_Release(ICoreApplication2 *iface) { return core_app_release(impl_from_core_app2(iface)); }
+static HRESULT WINAPI core_app2_GetIids(ICoreApplication2 *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI core_app2_GetRuntimeClassName(ICoreApplication2 *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI core_app2_GetTrustLevel(ICoreApplication2 *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI core_app2_add_event(ICoreApplication2 *iface, void *handler, EventRegistrationToken *token)
+{
+    TRACE("iface %p, handler %p (never raised).\n", iface, handler);
+    token->value = InterlockedIncrement(&event_token_counter);
+    return S_OK;
+}
+static HRESULT WINAPI core_app2_remove_event(ICoreApplication2 *iface, EventRegistrationToken token) { return S_OK; }
+
+static HRESULT WINAPI core_app2_EnablePrelaunch(ICoreApplication2 *iface, boolean value)
+{
+    TRACE("iface %p, value %d: apps aren't prelaunched.\n", iface, value);
+    return S_OK;
+}
+
+static const ICoreApplication2Vtbl core_app2_vtbl =
+{
+    core_app2_QueryInterface,
+    core_app2_AddRef,
+    core_app2_Release,
+    core_app2_GetIids,
+    core_app2_GetRuntimeClassName,
+    core_app2_GetTrustLevel,
+    (void *)core_app2_add_event,   /* BackgroundActivated */
+    core_app2_remove_event,
+    (void *)core_app2_add_event,   /* LeavingBackground */
+    core_app2_remove_event,
+    (void *)core_app2_add_event,   /* EnteredBackground */
+    core_app2_remove_event,
+    core_app2_EnablePrelaunch,
+};
+
 /* ---- ICoreApplicationUnhandledError on core_app ---- */
 /* Gears of War 4 subscribes to UnhandledErrorDetected in Initialize and stops if it can't. The event is never
  * raised: errors that would raise it end the process here instead. */
@@ -2225,6 +2270,7 @@ void core_application_init(void)
     core_app_instance.IActivationFactory_iface.lpVtbl = &factory_vtbl;
     core_app_instance.ICoreApplication_iface.lpVtbl = &core_app_vtbl;
     core_app_instance.ICoreApplicationExit_iface.lpVtbl = &core_app_exit_vtbl;
+    core_app_instance.ICoreApplication2_iface.lpVtbl = &core_app2_vtbl;
     core_app_instance.ICoreApplicationUnhandledError_iface.lpVtbl = &core_app_unhandled_vtbl;
     core_app_instance.ICoreImmersiveApplication_iface.lpVtbl = &core_immersive_vtbl;
     core_app_instance.ref = 1;
