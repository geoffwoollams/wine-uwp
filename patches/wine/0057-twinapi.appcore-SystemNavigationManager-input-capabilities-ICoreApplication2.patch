+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* SystemNavigationManager.GetForCurrentView(): the title bar's back button and the system's back request (the
+ * phone's back key, Win+Backspace). The window has no back button and nothing sends back requests, so the
+ * visibility is kept and BackRequested handlers are kept but never called. */
+
+#define MAX_HANDLERS 16
+
+struct navigation
+{
+    ISystemNavigationManager ISystemNavigationManager_iface;
+    ISystemNavigationManager2 ISystemNavigationManager2_iface;
+    AppViewBackButtonVisibility visibility;
+    IEventHandler_BackRequestedEventArgs *handlers[MAX_HANDLERS];
+};
+
+static inline struct navigation *impl_from_ISystemNavigationManager( ISystemNavigationManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct navigation, ISystemNavigationManager_iface );
+}
+
+static HRESULT WINAPI navigation_QueryInterface( ISystemNavigationManager *iface, REFIID iid, void **out )
+{
+    struct navigation *impl = impl_from_ISystemNavigationManager( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ISystemNavigationManager ))
+        *out = &impl->ISystemNavigationManager_iface;
+    else if (IsEqualGUID( iid, &IID_ISystemNavigationManager2 ))
+        *out = &impl->ISystemNavigationManager2_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI navigation_AddRef( ISystemNavigationManager *iface ) { return 2; }
+static ULONG WINAPI navigation_Release( ISystemNavigationManager *iface ) { return 1; }
+static HRESULT WINAPI navigation_GetIids( ISystemNavigationManager *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI navigation_GetRuntimeClassName( ISystemNavigationManager *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.UI.Core.SystemNavigationManager";
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI navigation_GetTrustLevel( ISystemNavigationManager *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI navigation_add_BackRequested( ISystemNavigationManager *iface, IEventHandler_BackRequestedEventArgs *handler,
+                                                    EventRegistrationToken *token )
+{
+    struct navigation *impl = impl_from_ISystemNavigationManager( iface );
+    UINT32 i;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    for (i = 0; i < MAX_HANDLERS; i++)
+    {
+        if (impl->handlers[i]) continue;
+        IEventHandler_BackRequestedEventArgs_AddRef( (impl->handlers[i] = handler) );
+        token->value = i + 1;
+        return S_OK;
+    }
+    token->value = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI navigation_remove_BackRequested( ISystemNavigationManager *iface, EventRegistrationToken token )
+{
+    struct navigation *impl = impl_from_ISystemNavigationManager( iface );
+
+    if (token.value < 1 || token.value > MAX_HANDLERS || !impl->handlers[token.value - 1]) return S_OK;
+    IEventHandler_BackRequestedEventArgs_Release( impl->handlers[token.value - 1] );
+    impl->handlers[token.value - 1] = NULL;
+    return S_OK;
+}
+
+static const struct ISystemNavigationManagerVtbl navigation_vtbl =
+{
+    navigation_QueryInterface,
+    navigation_AddRef,
+    navigation_Release,
+    /* IInspectable methods */
+    navigation_GetIids,
+    navigation_GetRuntimeClassName,
+    navigation_GetTrustLevel,
+    /* ISystemNavigationManager methods */
+    navigation_add_BackRequested,
+    navigation_remove_BackRequested,
+};
+
+DEFINE_IINSPECTABLE( navigation2, ISystemNavigationManager2, struct navigation, ISystemNavigationManager_iface )
+
+static HRESULT WINAPI navigation2_get_AppViewBackButtonVisibility( ISystemNavigationManager2 *iface, AppViewBackButtonVisibility *value )
+{
+    *value = impl_from_ISystemNavigationManager2( iface )->visibility;
+    return S_OK;
+}
+
+static HRESULT WINAPI navigation2_put_AppViewBackButtonVisibility( ISystemNavigationManager2 *iface, AppViewBackButtonVisibility value )
+{
+    TRACE( "iface %p, value %d: the window has no back button.\n", iface, value );
+    impl_from_ISystemNavigationManager2( iface )->visibility = value;
+    return S_OK;
+}
+
+static const struct ISystemNavigationManager2Vtbl navigation2_vtbl =
+{
+    navigation2_QueryInterface,
+    navigation2_AddRef,
+    navigation2_Release,
+    /* IInspectable methods */
+    navigation2_GetIids,
+    navigation2_GetRuntimeClassName,
+    navigation2_GetTrustLevel,
+    /* ISystemNavigationManager2 methods */
+    navigation2_get_AppViewBackButtonVisibility,
+    navigation2_put_AppViewBackButtonVisibility,
+};
+
+/* one view, so one manager */
+static struct navigation navigation = { {&navigation_vtbl}, {&navigation2_vtbl}, AppViewBackButtonVisibility_Collapsed };
+
+struct statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ISystemNavigationManagerStatics ISystemNavigationManagerStatics_iface;
+};
+
+static inline struct statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct statics *impl = impl_from_IActivationFactory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ISystemNavigationManagerStatics ))
+        *out = &impl->ISystemNavigationManagerStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
