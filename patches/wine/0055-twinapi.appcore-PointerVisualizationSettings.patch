+/* PointerVisualizationSettings.GetForCurrentView(): whether touch and pen contacts show feedback. Games turn it off;
+ * Wine draws no such feedback, so the settings are only kept. */
+
+struct settings
+{
+    IPointerVisualizationSettings IPointerVisualizationSettings_iface;
+    boolean contact, barrel;
+};
+
+static inline struct settings *impl_from_IPointerVisualizationSettings( IPointerVisualizationSettings *iface )
+{
+    return CONTAINING_RECORD( iface, struct settings, IPointerVisualizationSettings_iface );
+}
+
+static HRESULT WINAPI settings_QueryInterface( IPointerVisualizationSettings *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IPointerVisualizationSettings ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI settings_AddRef( IPointerVisualizationSettings *iface ) { return 2; }
+static ULONG WINAPI settings_Release( IPointerVisualizationSettings *iface ) { return 1; }
+static HRESULT WINAPI settings_GetIids( IPointerVisualizationSettings *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI settings_GetRuntimeClassName( IPointerVisualizationSettings *iface, HSTRING *name )
+{
+    return WindowsCreateString( L"Windows.UI.Input.PointerVisualizationSettings", 46, name );
+}
+
+static HRESULT WINAPI settings_GetTrustLevel( IPointerVisualizationSettings *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI settings_put_IsContactFeedbackEnabled( IPointerVisualizationSettings *iface, boolean value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_IPointerVisualizationSettings( iface )->contact = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI settings_get_IsContactFeedbackEnabled( IPointerVisualizationSettings *iface, boolean *value )
+{
+    *value = impl_from_IPointerVisualizationSettings( iface )->contact;
+    return S_OK;
+}
+
+static HRESULT WINAPI settings_put_IsBarrelButtonFeedbackEnabled( IPointerVisualizationSettings *iface, boolean value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_IPointerVisualizationSettings( iface )->barrel = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI settings_get_IsBarrelButtonFeedbackEnabled( IPointerVisualizationSettings *iface, boolean *value )
+{
+    *value = impl_from_IPointerVisualizationSettings( iface )->barrel;
+    return S_OK;
+}
+
+static const struct IPointerVisualizationSettingsVtbl settings_vtbl =
+{
+    settings_QueryInterface,
+    settings_AddRef,
+    settings_Release,
+    /* IInspectable methods */
+    settings_GetIids,
+    settings_GetRuntimeClassName,
+    settings_GetTrustLevel,
+    /* IPointerVisualizationSettings methods */
+    settings_put_IsContactFeedbackEnabled,
+    settings_get_IsContactFeedbackEnabled,
+    settings_put_IsBarrelButtonFeedbackEnabled,
+    settings_get_IsBarrelButtonFeedbackEnabled,
+};
+
+/* one view, so one settings object */
+static struct settings settings = { {&settings_vtbl}, TRUE, TRUE };
+
+struct statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IPointerVisualizationSettingsStatics IPointerVisualizationSettingsStatics_iface;
+};
