+static HRESULT folder_op_create(HRESULT hr, IStorageFolder *result, IAsyncOperation_StorageFolder **out)
+{
+    struct folder_op *impl;
+
+    if (!(impl = calloc(1, sizeof(*impl))))
+    {
+        if (result) IStorageFolder_Release(result);
+        return E_OUTOFMEMORY;
+    }
+    impl->IAsyncOperation_StorageFolder_iface.lpVtbl = &folder_op_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &folder_info_vtbl;
+    impl->ref = 1;
+    impl->hr = hr;
+    impl->result = result;
+    *out = &impl->IAsyncOperation_StorageFolder_iface;
+    return S_OK;
+}
+
+/* the subfolder name of this folder, as a host path, or an error */
+static HRESULT child_path(struct storage_folder *impl, HSTRING name, WCHAR *path)
+{
+    const WCHAR *str = WindowsGetStringRawBuffer(name, NULL);
+
+    if (!str || !*str || wcschr(str, '\\') || wcschr(str, '/') || !wcscmp(str, L"..") || !wcscmp(str, L"."))
+        return E_INVALIDARG;
+    if (wcslen(impl->path) + wcslen(str) + 2 >= MAX_PATH) return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    swprintf(path, MAX_PATH, L"%s\\%s", impl->path, str);
+    return S_OK;
+}
+
+static HRESULT WINAPI storage_folder_CreateFolderAsync(IStorageFolder *iface, HSTRING name, CreationCollisionOption options, IAsyncOperation_StorageFolder **operation)
+{
+    struct storage_folder *impl = impl_from_storage_folder(iface);
+    IStorageFolder *folder = NULL;
+    WCHAR path[MAX_PATH];
+    DWORD attrs;
+    HRESULT hr;
+    int i;
+
+    TRACE("iface %p, name %s, options %d.\n", iface, debugstr_hstring(name), options);
+    if (FAILED(hr = child_path(impl, name, path))) return folder_op_create(hr, NULL, operation);
+    attrs = GetFileAttributesW(path);
+    if (attrs != INVALID_FILE_ATTRIBUTES)
+    {
+        switch (options)
+        {
+        case CreationCollisionOption_FailIfExists:
+            return folder_op_create(HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS), NULL, operation);
+        case CreationCollisionOption_GenerateUniqueName:
+            /* "name (2)", "name (3)" ... */
+            for (i = 2; i < 1000 && GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES; i++)
+                swprintf(path, MAX_PATH, L"%s\\%s (%d)", impl->path, WindowsGetStringRawBuffer(name, NULL), i);
+            break;
+        case CreationCollisionOption_ReplaceExisting:
+            FIXME("replacing %s keeps its contents.\n", debugstr_w(path));
+            break;
+        default:   /* OpenIfExists */
+            break;
+        }
+    }
+    if (!CreateDirectoryW(path, NULL) && GetLastError() != ERROR_ALREADY_EXISTS)
+        return folder_op_create(HRESULT_FROM_WIN32(GetLastError()), NULL, operation);
+    hr = storage_folder_create(path, &folder);
+    return folder_op_create(hr, folder, operation);
+}
+
+static HRESULT WINAPI storage_folder_CreateFolderAsyncOverloadDefaultOptions(IStorageFolder *iface, HSTRING name, IAsyncOperation_StorageFolder **operation)
+{
+    return storage_folder_CreateFolderAsync(iface, name, CreationCollisionOption_FailIfExists, operation);
 }
 
