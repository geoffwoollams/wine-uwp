+/* ---- IAsyncOperation<StorageFolder>: done by the time it is returned (the folder work is synchronous) ---- */
+
+struct folder_op
 {
-    FIXME("iface %p stub!\n", iface);
-    return E_NOTIMPL;
+    IAsyncOperation_StorageFolder IAsyncOperation_StorageFolder_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    HRESULT hr;
+    IStorageFolder *result;
+    IAsyncOperationCompletedHandler_StorageFolder *handler;
+};
+
+static inline struct folder_op *impl_from_folder_op(IAsyncOperation_StorageFolder *iface)
+{ return CONTAINING_RECORD(iface, struct folder_op, IAsyncOperation_StorageFolder_iface); }
+
+static HRESULT WINAPI folder_op_QueryInterface(IAsyncOperation_StorageFolder *iface, REFIID iid, void **out)
+{
+    struct folder_op *impl = impl_from_folder_op(iface);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject) ||
+        IsEqualGUID(iid, &IID_IAsyncOperation_StorageFolder))
+        *out = &impl->IAsyncOperation_StorageFolder_iface;
+    else if (IsEqualGUID(iid, &IID_IAsyncInfo))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&impl->ref);
+    return S_OK;
+}
+static ULONG WINAPI folder_op_AddRef(IAsyncOperation_StorageFolder *iface)
+{ return InterlockedIncrement(&impl_from_folder_op(iface)->ref); }
+static ULONG WINAPI folder_op_Release(IAsyncOperation_StorageFolder *iface)
+{
+    struct folder_op *impl = impl_from_folder_op(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        if (impl->result) IStorageFolder_Release(impl->result);
+        if (impl->handler) IAsyncOperationCompletedHandler_StorageFolder_Release(impl->handler);
+        free(impl);
+    }
+    return ref;
+}
+static HRESULT WINAPI folder_op_GetIids(IAsyncOperation_StorageFolder *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI folder_op_GetRuntimeClassName(IAsyncOperation_StorageFolder *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI folder_op_GetTrustLevel(IAsyncOperation_StorageFolder *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI folder_op_put_Completed(IAsyncOperation_StorageFolder *iface, IAsyncOperationCompletedHandler_StorageFolder *handler)
+{
+    struct folder_op *impl = impl_from_folder_op(iface);
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return E_POINTER;
+    IAsyncOperationCompletedHandler_StorageFolder_AddRef((impl->handler = handler));
+    IAsyncOperationCompletedHandler_StorageFolder_Invoke(handler, iface, SUCCEEDED(impl->hr) ? Completed : Error);
+    return S_OK;
+}
+static HRESULT WINAPI folder_op_get_Completed(IAsyncOperation_StorageFolder *iface, IAsyncOperationCompletedHandler_StorageFolder **handler)
+{
+    struct folder_op *impl = impl_from_folder_op(iface);
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_StorageFolder_AddRef(*handler);
+    return S_OK;
+}
+static HRESULT WINAPI folder_op_GetResults(IAsyncOperation_StorageFolder *iface, IStorageFolder **results)
+{
+    struct folder_op *impl = impl_from_folder_op(iface);
+    *results = NULL;
+    if (FAILED(impl->hr)) return impl->hr;
+    IStorageFolder_AddRef((*results = impl->result));
+    return S_OK;
 }
+static const IAsyncOperation_StorageFolderVtbl folder_op_vtbl =
+{
+    folder_op_QueryInterface, folder_op_AddRef, folder_op_Release,
+    folder_op_GetIids, folder_op_GetRuntimeClassName, folder_op_GetTrustLevel,
+    folder_op_put_Completed, folder_op_get_Completed, folder_op_GetResults,
+};
 
