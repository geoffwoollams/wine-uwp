@@ -21,12 +21,49 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winstring.h"
 #include "gamingtcui.h"
 
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(gamingtcui);
 
+/* The offline Xbox user has every privilege (multiplayer, content and so on): what needs a
+ * connection then fails as offline, the way it does for a signed-in player without one. */
+HRESULT WINAPI CheckGamingPrivilegeSilently(UINT32 privilege_id, HSTRING scope, HSTRING policy, BOOL *has_privilege)
+{
+    FIXME("privilege_id %u, scope %s, policy %s, has_privilege %p: granted.\n", privilege_id,
+            debugstr_hstring(scope), debugstr_hstring(policy), has_privilege);
+
+    if (!has_privilege) return E_POINTER;
+    *has_privilege = TRUE;
+    return S_OK;
+}
+
+HRESULT WINAPI CheckGamingPrivilegeSilentlyForUser(IInspectable *user, UINT32 privilege_id, HSTRING scope, HSTRING policy,
+        BOOL *has_privilege)
+{
+    return CheckGamingPrivilegeSilently(privilege_id, scope, policy, has_privilege);
+}
+
+HRESULT WINAPI CheckGamingPrivilegeWithUI(UINT32 privilege_id, HSTRING scope, HSTRING policy, HSTRING friendly_message,
+        GameUICompletionRoutine completion_routine, void *context)
+{
+    FIXME("privilege_id %u, scope %s, policy %s, friendly_message %s, completion_routine %p, context %p: granted.\n",
+            privilege_id, debugstr_hstring(scope), debugstr_hstring(policy), debugstr_hstring(friendly_message),
+            completion_routine, context);
+
+    if (completion_routine)
+        completion_routine(S_OK, context);
+    return S_OK;
+}
+
+HRESULT WINAPI CheckGamingPrivilegeWithUIForUser(IInspectable *user, UINT32 privilege_id, HSTRING scope, HSTRING policy,
+        HSTRING friendly_message, GameUICompletionRoutine completion_routine, void *context)
+{
+    return CheckGamingPrivilegeWithUI(privilege_id, scope, policy, friendly_message, completion_routine, context);
+}
+
 HRESULT WINAPI ProcessPendingGameUI(BOOL wait_for_completion)
 {
     FIXME("wait_for_completion %#x stub.\n", wait_for_completion);
