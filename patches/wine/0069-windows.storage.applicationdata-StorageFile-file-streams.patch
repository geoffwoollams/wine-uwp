+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "robuffer.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(data);
+
+static const GUID iid_buffer_byte_access = {0x905a0fef,0xbc53,0x11df,{0x8c,0x49,0x00,0x1e,0x4f,0xc6,0x86,0xda}};
+
+/* ===== a completed async operation, for every result type used here =====
+ *
+ * IAsyncOperation<T>, IAsyncOperationWithProgress<T, P> and IAsyncAction have the same
+ * shape apart from where put_Completed sits, so one object serves all of them: results are
+ * either an interface (AddRef'd out) or a plain value copied out. */
+
+enum done_kind { DONE_ACTION, DONE_OPERATION, DONE_PROGRESS };
+
+struct done_op
+{
+    const void *const *lpVtbl;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    const GUID *iid;
+    HRESULT hr;
+    IUnknown *object;     /* interface result, or NULL */
+    UINT64 value;         /* value result */
+    UINT32 value_size;
+    IUnknown *handler;
+    IUnknown *progress;
+};
+
+/* every completion handler is IUnknown + Invoke(handler, operation, status) */
+struct handler_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)(IUnknown *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(IUnknown *);
+    ULONG (WINAPI *Release)(IUnknown *);
+    HRESULT (WINAPI *Invoke)(IUnknown *, void *, AsyncStatus);
+};
+
+static HRESULT WINAPI done_QueryInterface(struct done_op *op, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, op->iid))
+        *out = op;
+    else if (IsEqualGUID(iid, &IID_IAsyncInfo))
+        *out = &op->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&op->ref);
+    return S_OK;
+}
+static ULONG WINAPI done_AddRef(struct done_op *op) { return InterlockedIncrement(&op->ref); }
+static ULONG WINAPI done_Release(struct done_op *op)
+{
+    ULONG ref = InterlockedDecrement(&op->ref);
+    if (!ref)
+    {
+        if (op->object) IUnknown_Release(op->object);
+        if (op->handler) IUnknown_Release(op->handler);
+        if (op->progress) IUnknown_Release(op->progress);
+        free(op);
+    }
+    return ref;
+}
+static HRESULT WINAPI done_GetIids(struct done_op *op, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI done_GetRuntimeClassName(struct done_op *op, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI done_GetTrustLevel(struct done_op *op, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI done_put_Completed(struct done_op *op, IUnknown *handler)
+{
+    if (!handler) return E_POINTER;
+    if (op->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    op->handler = handler;
+    IUnknown_AddRef(handler);
+    ((const struct handler_vtbl *)handler->lpVtbl)->Invoke(handler, op, SUCCEEDED(op->hr) ? Completed : Error);
+    return S_OK;
+}
+static HRESULT WINAPI done_get_Completed(struct done_op *op, IUnknown **handler)
+{
+    if ((*handler = op->handler)) IUnknown_AddRef(*handler);
+    return S_OK;
+}
+static HRESULT WINAPI done_put_Progress(struct done_op *op, IUnknown *handler)
+{
+    /* finished before any progress could be reported */
+    if (op->progress) IUnknown_Release(op->progress);
+    if ((op->progress = handler)) IUnknown_AddRef(handler);
+    return S_OK;
+}
+static HRESULT WINAPI done_get_Progress(struct done_op *op, IUnknown **handler)
+{
+    if ((*handler = op->progress)) IUnknown_AddRef(*handler);
+    return S_OK;
+}
+static HRESULT WINAPI done_GetResults(struct done_op *op, void *results)
+{
+    if (FAILED(op->hr)) return op->hr;
+    if (!results) return S_OK;
+    if (op->object)
+    {
+        *(IUnknown **)results = op->object;
+        IUnknown_AddRef(op->object);
+    }
+    else memcpy(results, &op->value, op->value_size);
+    return S_OK;
+}
+static HRESULT WINAPI done_action_GetResults(struct done_op *op) { return op->hr; }
+
+static const void *const done_action_vtbl[] =
+{
+    done_QueryInterface, done_AddRef, done_Release, done_GetIids, done_GetRuntimeClassName, done_GetTrustLevel,
+    done_put_Completed, done_get_Completed, done_action_GetResults,
+};
+static const void *const done_operation_vtbl[] =
+{
+    done_QueryInterface, done_AddRef, done_Release, done_GetIids, done_GetRuntimeClassName, done_GetTrustLevel,
+    done_put_Completed, done_get_Completed, done_GetResults,
+};
+static const void *const done_progress_vtbl[] =
+{
+    done_QueryInterface, done_AddRef, done_Release, done_GetIids, done_GetRuntimeClassName, done_GetTrustLevel,
+    done_put_Progress, done_get_Progress, done_put_Completed, done_get_Completed, done_GetResults,
+};
+
+static inline struct done_op *impl_from_done_info(IAsyncInfo *iface)
+{ return CONTAINING_RECORD(iface, struct done_op, IAsyncInfo_iface); }
+static HRESULT WINAPI done_info_QueryInterface(IAsyncInfo *iface, REFIID iid, void **out)
+{ return done_QueryInterface(impl_from_done_info(iface), iid, out); }
+static ULONG WINAPI done_info_AddRef(IAsyncInfo *iface) { return done_AddRef(impl_from_done_info(iface)); }
+static ULONG WINAPI done_info_Release(IAsyncInfo *iface) { return done_Release(impl_from_done_info(iface)); }
+static HRESULT WINAPI done_info_GetIids(IAsyncInfo *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI done_info_GetRuntimeClassName(IAsyncInfo *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI done_info_GetTrustLevel(IAsyncInfo *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI done_info_get_Id(IAsyncInfo *iface, UINT32 *id) { *id = 1; return S_OK; }
+static HRESULT WINAPI done_info_get_Status(IAsyncInfo *iface, AsyncStatus *status)
+{ *status = SUCCEEDED(impl_from_done_info(iface)->hr) ? Completed : Error; return S_OK; }
+static HRESULT WINAPI done_info_get_ErrorCode(IAsyncInfo *iface, HRESULT *error)
+{ *error = impl_from_done_info(iface)->hr; return S_OK; }
+static HRESULT WINAPI done_info_Cancel(IAsyncInfo *iface) { return S_OK; }
+static HRESULT WINAPI done_info_Close(IAsyncInfo *iface) { return S_OK; }
+static const IAsyncInfoVtbl done_info_vtbl =
+{
+    done_info_QueryInterface, done_info_AddRef, done_info_Release,
+    done_info_GetIids, done_info_GetRuntimeClassName, done_info_GetTrustLevel,
+    done_info_get_Id, done_info_get_Status, done_info_get_ErrorCode, done_info_Cancel, done_info_Close,
+};
+
+/* object (if any) is taken over by the operation */
+static HRESULT done_create(enum done_kind kind, const GUID *iid, HRESULT hr, IUnknown *object,
+                           const void *value, UINT32 value_size, void **out)
+{
+    struct done_op *op;
+
+    *out = NULL;
+    if (!(op = calloc(1, sizeof(*op))))
+    {
+        if (object) IUnknown_Release(object);
+        return E_OUTOFMEMORY;
+    }
+    op->lpVtbl = kind == DONE_ACTION ? done_action_vtbl : kind == DONE_PROGRESS ? done_progress_vtbl : done_operation_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &done_info_vtbl;
+    op->ref = 1;
+    op->iid = iid;
+    op->hr = hr;
+    op->object = object;
+    if (value_size > sizeof(op->value)) value_size = sizeof(op->value);
+    if (value) memcpy(&op->value, value, value_size);
+    op->value_size = value_size;
+    *out = op;
+    return S_OK;
+}
+
+static HRESULT done_action(HRESULT hr, IAsyncAction **out)
+{
+    return done_create(DONE_ACTION, &IID_IAsyncAction, hr, NULL, NULL, 0, (void **)out);
+}
+
+static HRESULT last_error(void)
+{
+    DWORD error = GetLastError();
+    return error ? HRESULT_FROM_WIN32(error) : E_FAIL;
+}
+
+static BYTE *buffer_bytes(IBuffer *buffer)
+{
+    IBufferByteAccess *access;
+    BYTE *bytes = NULL;
+
+    if (FAILED(IBuffer_QueryInterface(buffer, &iid_buffer_byte_access, (void **)&access))) return NULL;
+    if (FAILED(IBufferByteAccess_Buffer(access, &bytes))) bytes = NULL;
+    IBufferByteAccess_Release(access);
+    return bytes;
+}
+
+/* ===== the file stream: IRandomAccessStream, IInputStream, IOutputStream, IClosable ===== */
+
+struct file_stream
+{
+    IRandomAccessStream IRandomAccessStream_iface;
+    IInputStream IInputStream_iface;
+    IOutputStream IOutputStream_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    HANDLE file;      /* each stream object has its own handle (and position) */
+    UINT64 position;
+    BOOL can_write;
+};
+
+static HRESULT file_stream_create(HANDLE file, UINT64 position, BOOL can_write, struct file_stream **out);
+
+static inline struct file_stream *impl_from_IRandomAccessStream(IRandomAccessStream *iface)
+{ return CONTAINING_RECORD(iface, struct file_stream, IRandomAccessStream_iface); }
+
+static HRESULT WINAPI file_stream_QueryInterface(IRandomAccessStream *iface, REFIID iid, void **out)
+{
+    struct file_stream *impl = impl_from_IRandomAccessStream(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IRandomAccessStream))
+        *out = &impl->IRandomAccessStream_iface;
+    else if (IsEqualGUID(iid, &IID_IInputStream))
+        *out = &impl->IInputStream_iface;
+    else if (IsEqualGUID(iid, &IID_IOutputStream))
+        *out = &impl->IOutputStream_iface;
+    else if (IsEqualGUID(iid, &IID_IClosable))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef((IInspectable *)*out);
+    return S_OK;
+}
+
+static ULONG WINAPI file_stream_AddRef(IRandomAccessStream *iface)
+{
+    return InterlockedIncrement(&impl_from_IRandomAccessStream(iface)->ref);
+}
+
+static ULONG WINAPI file_stream_Release(IRandomAccessStream *iface)
+{
+    struct file_stream *impl = impl_from_IRandomAccessStream(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+
+    if (!ref)
+    {
+        if (impl->file != INVALID_HANDLE_VALUE) CloseHandle(impl->file);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI file_stream_GetIids(IRandomAccessStream *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI file_stream_GetRuntimeClassName(IRandomAccessStream *iface, HSTRING *name)
+{
+    return WindowsCreateString(L"Windows.Storage.Streams.FileRandomAccessStream", 46, name);
+}
+static HRESULT WINAPI file_stream_GetTrustLevel(IRandomAccessStream *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI file_stream_get_Size(IRandomAccessStream *iface, UINT64 *value)
+{
+    struct file_stream *impl = impl_from_IRandomAccessStream(iface);
+    LARGE_INTEGER size;
+
+    if (impl->file == INVALID_HANDLE_VALUE) return RO_E_CLOSED;
+    if (!GetFileSizeEx(impl->file, &size)) return last_error();
+    *value = size.QuadPart;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_put_Size(IRandomAccessStream *iface, UINT64 value)
+{
+    struct file_stream *impl = impl_from_IRandomAccessStream(iface);
+    FILE_END_OF_FILE_INFO info;
+
+    TRACE("iface %p, value %I64u.\n", iface, value);
+    if (impl->file == INVALID_HANDLE_VALUE) return RO_E_CLOSED;
+    if (!impl->can_write) return E_ACCESSDENIED;
+    info.EndOfFile.QuadPart = value;
+    if (!SetFileInformationByHandle(impl->file, FileEndOfFileInfo, &info, sizeof(info))) return last_error();
+    return S_OK;
+}
+
+static HRESULT clone_at(struct file_stream *impl, UINT64 position, struct file_stream **out)
+{
+    HANDLE file;
+
+    if (impl->file == INVALID_HANDLE_VALUE) return RO_E_CLOSED;
+    if (!DuplicateHandle(GetCurrentProcess(), impl->file, GetCurrentProcess(), &file, 0, FALSE, DUPLICATE_SAME_ACCESS))
+        return last_error();
+    return file_stream_create(file, position, impl->can_write, out);
+}
+
+static HRESULT WINAPI file_stream_GetInputStreamAt(IRandomAccessStream *iface, UINT64 position, IInputStream **stream)
+{
+    struct file_stream *clone;
+    HRESULT hr;
+
+    TRACE("iface %p, position %I64u, stream %p.\n", iface, position, stream);
+    if (FAILED(hr = clone_at(impl_from_IRandomAccessStream(iface), position, &clone))) return hr;
+    *stream = &clone->IInputStream_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_GetOutputStreamAt(IRandomAccessStream *iface, UINT64 position, IOutputStream **stream)
+{
+    struct file_stream *impl = impl_from_IRandomAccessStream(iface), *clone;
+    HRESULT hr;
+
+    TRACE("iface %p, position %I64u, stream %p.\n", iface, position, stream);
+    if (!impl->can_write) return E_ACCESSDENIED;
+    if (FAILED(hr = clone_at(impl, position, &clone))) return hr;
+    *stream = &clone->IOutputStream_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_get_Position(IRandomAccessStream *iface, UINT64 *value)
+{
+    *value = impl_from_IRandomAccessStream(iface)->position;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_Seek(IRandomAccessStream *iface, UINT64 position)
+{
+    TRACE("iface %p, position %I64u.\n", iface, position);
+    impl_from_IRandomAccessStream(iface)->position = position;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_CloneStream(IRandomAccessStream *iface, IRandomAccessStream **stream)
+{
+    struct file_stream *clone;
+    HRESULT hr;
+
+    TRACE("iface %p, stream %p.\n", iface, stream);
+    if (FAILED(hr = clone_at(impl_from_IRandomAccessStream(iface), 0, &clone))) return hr;
+    *stream = &clone->IRandomAccessStream_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_get_CanRead(IRandomAccessStream *iface, boolean *value)
+{
+    *value = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI file_stream_get_CanWrite(IRandomAccessStream *iface, boolean *value)
+{
+    *value = impl_from_IRandomAccessStream(iface)->can_write;
+    return S_OK;
+}
+
+static const IRandomAccessStreamVtbl file_stream_vtbl =
+{
+    file_stream_QueryInterface,
+    file_stream_AddRef,
+    file_stream_Release,
+    file_stream_GetIids,
+    file_stream_GetRuntimeClassName,
+    file_stream_GetTrustLevel,
+    file_stream_get_Size,
+    file_stream_put_Size,
+    file_stream_GetInputStreamAt,
+    file_stream_GetOutputStreamAt,
+    file_stream_get_Position,
+    file_stream_Seek,
+    file_stream_CloneStream,
+    file_stream_get_CanRead,
+    file_stream_get_CanWrite,
+};
+
+/* ---- IInputStream ---- */
+static inline struct file_stream *impl_from_IInputStream(IInputStream *iface)
+{ return CONTAINING_RECORD(iface, struct file_stream, IInputStream_iface); }
+
+static HRESULT WINAPI input_QueryInterface(IInputStream *iface, REFIID iid, void **out)
+{ return file_stream_QueryInterface(&impl_from_IInputStream(iface)->IRandomAccessStream_iface, iid, out); }
+static ULONG WINAPI input_AddRef(IInputStream *iface)
+{ return file_stream_AddRef(&impl_from_IInputStream(iface)->IRandomAccessStream_iface); }
+static ULONG WINAPI input_Release(IInputStream *iface)
+{ return file_stream_Release(&impl_from_IInputStream(iface)->IRandomAccessStream_iface); }
+static HRESULT WINAPI input_GetIids(IInputStream *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI input_GetRuntimeClassName(IInputStream *iface, HSTRING *name)
+{ return file_stream_GetRuntimeClassName(&impl_from_IInputStream(iface)->IRandomAccessStream_iface, name); }
+static HRESULT WINAPI input_GetTrustLevel(IInputStream *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI input_ReadAsync(IInputStream *iface, IBuffer *buffer, UINT32 count, InputStreamOptions options,
+                                      IAsyncOperationWithProgress_IBuffer_UINT32 **operation)
+{
+    struct file_stream *impl = impl_from_IInputStream(iface);
+    UINT32 capacity;
+    OVERLAPPED ovl = {0};
+    DWORD done = 0;
+    HRESULT hr = S_OK;
+    BYTE *bytes;
+
+    TRACE("iface %p, buffer %p, count %u, options %#x, operation %p.\n", iface, buffer, count, options, operation);
+
+    if (!buffer || !operation) return E_POINTER;
+    if (impl->file == INVALID_HANDLE_VALUE) return RO_E_CLOSED;
+    if (FAILED(IBuffer_get_Capacity(buffer, &capacity))) capacity = 0;
+    if (count > capacity) return E_INVALIDARG;
+    if (!(bytes = buffer_bytes(buffer))) return E_INVALIDARG;
+
+    ovl.Offset = (DWORD)impl->position;
+    ovl.OffsetHigh = (DWORD)(impl->position >> 32);
+    if (!ReadFile(impl->file, bytes, count, &done, &ovl) && GetLastError() != ERROR_HANDLE_EOF)
+        hr = last_error();
+    if (SUCCEEDED(hr))
+    {
+        impl->position += done;
+        IBuffer_put_Length(buffer, done);
+        IBuffer_AddRef(buffer);
+    }
+    return done_create(DONE_PROGRESS, &IID_IAsyncOperationWithProgress_IBuffer_UINT32, hr,
+                       SUCCEEDED(hr) ? (IUnknown *)buffer : NULL, NULL, 0, (void **)operation);
+}
+
+static const IInputStreamVtbl input_vtbl =
+{
+    input_QueryInterface,
+    input_AddRef,
+    input_Release,
+    input_GetIids,
+    input_GetRuntimeClassName,
+    input_GetTrustLevel,
+    input_ReadAsync,
+};
+
+/* ---- IOutputStream ---- */
+static inline struct file_stream *impl_from_IOutputStream(IOutputStream *iface)
+{ return CONTAINING_RECORD(iface, struct file_stream, IOutputStream_iface); }
+
+static HRESULT WINAPI output_QueryInterface(IOutputStream *iface, REFIID iid, void **out)
+{ return file_stream_QueryInterface(&impl_from_IOutputStream(iface)->IRandomAccessStream_iface, iid, out); }
+static ULONG WINAPI output_AddRef(IOutputStream *iface)
+{ return file_stream_AddRef(&impl_from_IOutputStream(iface)->IRandomAccessStream_iface); }
+static ULONG WINAPI output_Release(IOutputStream *iface)
+{ return file_stream_Release(&impl_from_IOutputStream(iface)->IRandomAccessStream_iface); }
+static HRESULT WINAPI output_GetIids(IOutputStream *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI output_GetRuntimeClassName(IOutputStream *iface, HSTRING *name)
+{ return file_stream_GetRuntimeClassName(&impl_from_IOutputStream(iface)->IRandomAccessStream_iface, name); }
+static HRESULT WINAPI output_GetTrustLevel(IOutputStream *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI output_WriteAsync(IOutputStream *iface, IBuffer *buffer, IAsyncOperationWithProgress_UINT32_UINT32 **operation)
+{
+    struct file_stream *impl = impl_from_IOutputStream(iface);
+    OVERLAPPED ovl = {0};
+    UINT32 length = 0;
+    DWORD done = 0;
+    HRESULT hr = S_OK;
+    BYTE *bytes;
+
+    TRACE("iface %p, buffer %p, operation %p.\n", iface, buffer, operation);
+
+    if (!buffer || !operation) return E_POINTER;
+    if (impl->file == INVALID_HANDLE_VALUE) return RO_E_CLOSED;
+    if (!impl->can_write) return E_ACCESSDENIED;
+    IBuffer_get_Length(buffer, &length);
+    if (length && !(bytes = buffer_bytes(buffer))) return E_INVALIDARG;
+
+    ovl.Offset = (DWORD)impl->position;
+    ovl.OffsetHigh = (DWORD)(impl->position >> 32);
+    if (length && !WriteFile(impl->file, bytes, length, &done, &ovl)) hr = last_error();
+    if (SUCCEEDED(hr)) impl->position += done;
+    return done_create(DONE_PROGRESS, &IID_IAsyncOperationWithProgress_UINT32_UINT32, hr, NULL,
+                       &done, sizeof(UINT32), (void **)operation);
+}
+
+static HRESULT WINAPI output_FlushAsync(IOutputStream *iface, IAsyncOperation_boolean **operation)
+{
+    struct file_stream *impl = impl_from_IOutputStream(iface);
+    boolean flushed;
+
+    TRACE("iface %p, operation %p.\n", iface, operation);
+
