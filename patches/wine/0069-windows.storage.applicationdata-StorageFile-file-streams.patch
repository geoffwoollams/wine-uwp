+static HRESULT WINAPI file_item_get_DateCreated(IStorageItem *iface, DateTime *value)
+{
+    struct storage_file *impl = impl_from_IStorageItem(iface);
+    WIN32_FILE_ATTRIBUTE_DATA data;
+
+    if (!GetFileAttributesExW(impl->path, GetFileExInfoStandard, &data)) return last_error();
+    /* DateTime counts 100ns ticks from 1601, like FILETIME */
+    value->UniversalTime = ((INT64)data.ftCreationTime.dwHighDateTime << 32) | data.ftCreationTime.dwLowDateTime;
+    return S_OK;
+}
