+HRESULT storage_file_create(const WCHAR *path, IStorageFile **out)
+{
+    struct storage_file *impl;
+
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IStorageFile_iface.lpVtbl = &storage_file_vtbl;
+    impl->IStorageItem_iface.lpVtbl = &file_item_vtbl;
+    impl->IRandomAccessStreamReference_iface.lpVtbl = &stream_ref_vtbl;
+    impl->IInputStreamReference_iface.lpVtbl = &input_ref_vtbl;
+    impl->ref = 1;
+    lstrcpynW(impl->path, path, MAX_PATH);
+    *out = &impl->IStorageFile_iface;
+    return S_OK;
+}
+
+/* the async result of a folder's file operation: file is taken over */
+HRESULT storage_file_operation(HRESULT hr, IStorageFile *file, IAsyncOperation_StorageFile **operation)
+{
+    return done_create(DONE_OPERATION, &IID_IAsyncOperation_StorageFile, hr, (IUnknown *)file, NULL, 0, (void **)operation);
+}
