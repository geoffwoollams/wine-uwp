+static HRESULT folder_path(IStorageFolder *folder, HSTRING name, const WCHAR *fallback, WCHAR *path)
+{
+    IStorageItem *item;
+    HSTRING dir;
+    HRESULT hr;
+    const WCHAR *file;
+
+    if (!folder) return E_POINTER;
+    if (FAILED(hr = IStorageFolder_QueryInterface(folder, &IID_IStorageItem, (void **)&item))) return hr;
+    hr = IStorageItem_get_Path(item, &dir);
+    IStorageItem_Release(item);
+    if (FAILED(hr)) return hr;
+    file = name ? WindowsGetStringRawBuffer(name, NULL) : fallback;
+    if (wcschr(file, '\\') || wcschr(file, '/')) hr = E_INVALIDARG;
+    else swprintf(path, MAX_PATH, L"%s\\%s", WindowsGetStringRawBuffer(dir, NULL), file);
+    WindowsDeleteString(dir);
+    return hr;
+}
