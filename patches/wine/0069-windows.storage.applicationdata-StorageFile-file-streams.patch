+static HRESULT WINAPI storage_file_CopyOverload(IStorageFile *iface, IStorageFolder *folder, HSTRING name,
+                                                NameCollisionOption option, IAsyncOperation_StorageFile **operation)
+{
+    struct storage_file *impl = impl_from_IStorageFile(iface);
+    IStorageFile *copy = NULL;
+    WCHAR path[MAX_PATH];
+    HRESULT hr;
+
+    TRACE("iface %p, folder %p, name %s, option %d, operation %p.\n", iface, folder, debugstr_hstring(name), option, operation);
+
+    if (SUCCEEDED(hr = folder_path(folder, name, file_name(impl), path)))
+    {
+        if (option == NameCollisionOption_GenerateUniqueName) FIXME("unique names are not generated.\n");
+        if (!CopyFileW(impl->path, path, option == NameCollisionOption_FailIfExists)) hr = last_error();
+        else hr = storage_file_create(path, &copy);
+    }
+    return done_create(DONE_OPERATION, &IID_IAsyncOperation_StorageFile, hr, (IUnknown *)copy, NULL, 0, (void **)operation);
+}
