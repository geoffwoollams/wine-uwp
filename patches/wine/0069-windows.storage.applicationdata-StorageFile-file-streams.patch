+static HRESULT WINAPI file_item_RenameAsync(IStorageItem *iface, HSTRING name, NameCollisionOption option, IAsyncAction **operation)
+{
+    struct storage_file *impl = impl_from_IStorageItem(iface);
+    const WCHAR *str = WindowsGetStringRawBuffer(name, NULL);
+    WCHAR path[MAX_PATH], *p;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, name %s, option %d, operation %p.\n", iface, debugstr_hstring(name), option, operation);
+
+    if (!str || !*str || wcschr(str, '\\') || wcschr(str, '/')) hr = E_INVALIDARG;
+    else
+    {
+        lstrcpynW(path, impl->path, MAX_PATH);
+        if ((p = wcsrchr(path, '\\'))) p[1] = 0; else path[0] = 0;
+        if (wcslen(path) + wcslen(str) >= MAX_PATH) hr = HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+        else
+        {
+            wcscat(path, str);
+            if (!MoveFileExW(impl->path, path, option == NameCollisionOption_ReplaceExisting ? MOVEFILE_REPLACE_EXISTING : 0))
+                hr = last_error();
+            else lstrcpynW(impl->path, path, MAX_PATH);
+        }
+    }
+    return done_action(hr, operation);
+}
