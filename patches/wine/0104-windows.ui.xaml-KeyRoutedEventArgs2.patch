+
+struct key_args;
+struct key_args2 { const struct key_args2_vtbl *lpVtbl; };
+struct key_args2_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( struct key_args2 *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( struct key_args2 *iface );
