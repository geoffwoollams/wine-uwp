+/* IKeyRoutedEventArgs2 (OriginalKey) and IKeyRoutedEventArgs3 (DeviceId), which Wine's headers don't have yet */
+static const GUID IID_IKeyRoutedEventArgs2_local = {0x1b02d57a, 0x9634, 0x4f14, {0x91, 0xb2, 0x13, 0x3e, 0x42, 0xfd, 0xb3, 0xcd}};
