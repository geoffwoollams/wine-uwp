+#define KEY_ARGS_IINSPECTABLE( pfx, member ) \
+    static inline struct key_args *pfx##_impl( struct key_args2 *iface ) \
+    { return CONTAINING_RECORD( iface, struct key_args, member ); } \
+    static HRESULT WINAPI pfx##_QueryInterface( struct key_args2 *iface, REFIID iid, void **out ) \
+    { return key_args_QueryInterface( &pfx##_impl( iface )->IKeyRoutedEventArgs_iface, iid, out ); } \
+    static ULONG WINAPI pfx##_AddRef( struct key_args2 *iface ) \
+    { return key_args_AddRef( &pfx##_impl( iface )->IKeyRoutedEventArgs_iface ); } \
+    static ULONG WINAPI pfx##_Release( struct key_args2 *iface ) \
+    { return key_args_Release( &pfx##_impl( iface )->IKeyRoutedEventArgs_iface ); } \
+    static HRESULT WINAPI pfx##_GetIids( struct key_args2 *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( struct key_args2 *iface, HSTRING *name ) \
+    { return key_args_GetRuntimeClassName( &pfx##_impl( iface )->IKeyRoutedEventArgs_iface, name ); } \
+    static HRESULT WINAPI pfx##_GetTrustLevel( struct key_args2 *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+KEY_ARGS_IINSPECTABLE( key_args2, key_args2_iface )
+
+/* the key before any translation: the same key, as no input method or gamepad navigation changes it here */
+static HRESULT WINAPI key_args2_get_OriginalKey( struct key_args2 *iface, void *value )
+{
+    *(__x_ABI_CWindows_CSystem_CVirtualKey *)value = key_args2_impl( iface )->key;
+    return S_OK;
+}
+
+static const struct key_args2_vtbl key_args2_vtbl =
+{
+    key_args2_QueryInterface, key_args2_AddRef, key_args2_Release,
+    key_args2_GetIids, key_args2_GetRuntimeClassName, key_args2_GetTrustLevel,
+    key_args2_get_OriginalKey,
+};
+
+KEY_ARGS_IINSPECTABLE( key_args3, key_args3_iface )
+
+/* which keyboard: there is only the one */
+static HRESULT WINAPI key_args3_get_DeviceId( struct key_args2 *iface, void *value )
+{
+    return WindowsCreateString( NULL, 0, (HSTRING *)value );
+}
+
+static const struct key_args2_vtbl key_args3_vtbl =
+{
+    key_args3_QueryInterface, key_args3_AddRef, key_args3_Release,
+    key_args3_GetIids, key_args3_GetRuntimeClassName, key_args3_GetTrustLevel,
+    key_args3_get_DeviceId,
+};
