+    HRESULT (WINAPI *GetTrustLevel)( struct key_args2 *iface, TrustLevel *level );
+    HRESULT (WINAPI *get_Value)( struct key_args2 *iface, void *value );   /* OriginalKey or DeviceId */
+};
+
 struct key_args
 {
     IKeyRoutedEventArgs IKeyRoutedEventArgs_iface;
     IRoutedEventArgs IRoutedEventArgs_iface;
+    struct key_args2 key_args2_iface;
