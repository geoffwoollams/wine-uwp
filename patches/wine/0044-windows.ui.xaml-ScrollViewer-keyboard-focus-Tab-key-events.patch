+/* KeyDown or KeyUp from the element up the tree; TRUE if a handler set Handled */
+static BOOL raise_key_event( struct xaml_element *start, BOOL down, WPARAM vk, LPARAM lparam )
+{
+    struct key_args *args;
+    struct xaml_element *element;
+    IUnknown **handlers;
+    BOOL handled;
+    UINT32 i, count;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return FALSE;
+    args->IKeyRoutedEventArgs_iface.lpVtbl = &key_args_vtbl;
+    args->IRoutedEventArgs_iface.lpVtbl = &key_routed_vtbl;
+    args->ref = 1;
+    args->key = vk;
+    args->status.RepeatCount = LOWORD( lparam );
+    args->status.ScanCode = (lparam >> 16) & 0xff;
+    args->status.IsExtendedKey = (lparam >> 24) & 1;
+    args->status.IsMenuKeyDown = (lparam >> 29) & 1;
+    args->status.WasKeyDown = (lparam >> 30) & 1;
+    args->status.IsKeyReleased = !down;
+    if ((args->source = start->outer)) IInspectable_AddRef( args->source );
+
+    for (element = start; element && !args->handled; element = element->parent)
+    {
+        struct event_list *list = down ? &element->key_down : &element->key_up;
+
+        if (!(count = list->count) || !(handlers = calloc( count, sizeof(*handlers) ))) continue;
+        for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            if (!args->handled)
+                IKeyEventHandler_Invoke( (IKeyEventHandler *)handlers[i], element->outer, &args->IKeyRoutedEventArgs_iface );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+    handled = args->handled;
+    IKeyRoutedEventArgs_Release( &args->IKeyRoutedEventArgs_iface );
+    return handled;
+}
+
+/* WM_KEYDOWN / WM_KEYUP for the XAML window; TRUE if XAML used the key */
+BOOL focus_key( BOOL down, WPARAM vk, LPARAM lparam )
+{
+    struct xaml_element *start = focused ? focused : window_content_element(), *element;
+    BOOL handled;
+
+    if (!start) return FALSE;
+    IUIElement_AddRef( &start->IUIElement_iface );
+    handled = raise_key_event( start, down, vk, lparam );
+    if (!handled && down && vk == VK_TAB)
+        handled = focus_move( GetKeyState( VK_SHIFT ) < 0, FocusState_Keyboard );
+    for (element = start; !handled && element; element = element->parent)
+        if (element->ops->key) handled = element->ops->key( element, down, vk );
+    IUIElement_Release( &start->IUIElement_iface );
+    return handled;
+}
