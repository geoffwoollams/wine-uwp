+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* One element has the keyboard focus (referenced while it does). Elements whose ops have focusable() can take it:
+ * Control.Focus, a pointer press on them, or Tab / Shift+Tab, which go through the focusable elements of the tree
+ * in TabIndex order, then tree order, wrapping round. Keys go to the focused element first as routed KeyDown /
+ * KeyUp events, bubbling to its ancestors until one sets Handled; then, unhandled, to the element's own key()
+ * (Space and Enter press buttons, the arrow keys scroll a ScrollViewer, ...) and its ancestors'. With nothing
+ * focused, keys start at the window's content. A keyboard-focused element is drawn with Windows 10's focus visual. */
+
+static struct xaml_element *focused;
+static FocusState focused_state = FocusState_Unfocused;
+static struct event_list manager_got_focus, manager_lost_focus;
+
+struct xaml_element *focus_get(void)
+{
+    return focused;
+}
+
+FocusState element_focus_state( struct xaml_element *element )
+{
+    return element && element == focused ? focused_state : FocusState_Unfocused;
+}
+
+/* visible all the way up, and in the window */
+static BOOL element_shown( struct xaml_element *element )
+{
+    struct xaml_element *root = window_content_element();
+
+    for (; element; element = element->parent)
+    {
+        if (element->visibility != Visibility_Visible) return FALSE;
+        if (element == root) return TRUE;
+    }
+    return FALSE;
+}
+
+BOOL element_can_focus( struct xaml_element *element )
+{
+    return element && element->ops->focusable && element->ops->focusable( element ) && element_shown( element );
+}
+
+static void raise_routed( struct xaml_element *element, BOOL got, struct xaml_element *source )
+{
+    IRoutedEventArgs *args;
+    IUnknown **handlers;
+    UINT32 i, count;
+
+    if (FAILED(routed_event_args_create( source->outer, &args ))) return;
+    for (; element; element = element->parent)
+    {
+        struct event_list *list = got ? &element->got_focus : &element->lost_focus;
+
+        if (!(count = list->count) || !(handlers = calloc( count, sizeof(*handlers) ))) continue;
+        IUIElement_AddRef( &element->IUIElement_iface );
+        for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            IRoutedEventHandler_Invoke( (IRoutedEventHandler *)handlers[i], element->outer, args );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+        IUIElement_Release( &element->IUIElement_iface );
+    }
+    IRoutedEventArgs_Release( args );
+}
+
+static void raise_manager_event( struct event_list *list )
+{
+    UINT32 i;
+
+    /* FocusManager.GotFocus / LostFocus: the args aren't implemented, so handlers get NULL */
+    for (i = 0; i < list->count; i++)
+        if (list->handlers[i])
+            IEventHandler_IInspectable_Invoke( (IEventHandler_IInspectable *)list->handlers[i], NULL, NULL );
+}
+
+BOOL focus_set( struct xaml_element *element, FocusState state )
+{
+    struct xaml_element *old = focused;
+
+    if (state == FocusState_Unfocused) return FALSE;
+    if (!element_can_focus( element ))
+    {
+        TRACE( "%s can't take the focus.\n", element ? debugstr_w(element->class_name) : "NULL" );
+        return FALSE;
+    }
+    if (element == focused)
+    {
+        if (focused_state != state) { focused_state = state; window_invalidate(); }
+        return TRUE;
+    }
+    TRACE( "focus to %s (%p), state %d.\n", debugstr_w(element->class_name), element, state );
+    IUIElement_AddRef( &element->IUIElement_iface );
+    focused = element;
+    focused_state = state;
+    if (old)
+    {
+        if (old->ops->focus_changed) old->ops->focus_changed( old );
+        raise_routed( old, FALSE, old );
+        raise_manager_event( &manager_lost_focus );
+        IUIElement_Release( &old->IUIElement_iface );
+    }
+    if (focused == element)
+    {
+        if (element->ops->focus_changed) element->ops->focus_changed( element );
+        raise_routed( element, TRUE, element );
+        raise_manager_event( &manager_got_focus );
+    }
+    window_invalidate();
+    return TRUE;
+}
+
+void focus_clear(void)
+{
+    struct xaml_element *old = focused;
+
+    if (!old) return;
+    focused = NULL;
+    focused_state = FocusState_Unfocused;
+    IUIElement_Release( &old->IUIElement_iface );
+}
+
+/* the element is going away or leaving the tree: nothing may stay focused inside it */
+void focus_element_removed( struct xaml_element *element )
+{
+    struct xaml_element *e;
+
+    for (e = focused; e; e = e->parent) if (e == element) { focus_clear(); return; }
+}
+
+/* ---- Tab order ---- */
+
+struct tab_list
+{
+    struct xaml_element **items;
+    UINT32 count, capacity;
+};
+
+static void collect_focusable( struct xaml_element *element, struct tab_list *list )
+{
+    UINT32 i, count;
+
+    if (element->visibility != Visibility_Visible) return;
+    if (element->ops->focusable && element->ops->focusable( element ) && element->is_tab_stop)
+    {
+        if (list->count == list->capacity)
+        {
+            UINT32 capacity = max( 16, list->capacity * 2 );
+            struct xaml_element **items = realloc( list->items, capacity * sizeof(*items) );
+            if (!items) return;
+            list->items = items;
+            list->capacity = capacity;
+        }
+        list->items[list->count++] = element;
+    }
+    if (!element->ops->child_count) return;
+    count = element->ops->child_count( element );
+    for (i = 0; i < count; i++)
+    {
+        struct xaml_element *child = element->ops->child_at( element, i );
+        if (child) collect_focusable( child, list );
+    }
+}
+
+/* TabIndex first, then tree order: an insertion sort keeps equal indices in tree order */
+static void sort_tab_order( struct tab_list *list )
+{
+    UINT32 i, j;
+
+    for (i = 1; i < list->count; i++)
+    {
+        struct xaml_element *item = list->items[i];
+        for (j = i; j > 0 && list->items[j - 1]->tab_index > item->tab_index; j--) list->items[j] = list->items[j - 1];
+        list->items[j] = item;
+    }
+}
+
+/* the next (or previous) focusable element after the focused one, in a scope; NULL if there are none */
+static struct xaml_element *find_tab_target( struct xaml_element *scope, BOOL backwards )
+{
+    struct tab_list list = {0};
+    struct xaml_element *found = NULL;
+    UINT32 i;
+
+    if (!scope) return NULL;
+    collect_focusable( scope, &list );
+    sort_tab_order( &list );
+    if (list.count)
+    {
+        for (i = 0; i < list.count; i++) if (list.items[i] == focused) break;
+        if (i == list.count) found = list.items[backwards ? list.count - 1 : 0];
+        else found = list.items[(i + (backwards ? list.count - 1 : 1)) % list.count];
+    }
+    free( list.items );
+    return found;
+}
+
+BOOL focus_move( BOOL backwards, FocusState state )
+{
+    struct xaml_element *target = find_tab_target( window_content_element(), backwards );
+
+    return target && focus_set( target, state );
+}
+
+static struct xaml_element *find_edge( struct xaml_element *scope, BOOL last )
+{
+    struct tab_list list = {0};
+    struct xaml_element *found = NULL;
+
+    if (!scope) return NULL;
+    collect_focusable( scope, &list );
+    sort_tab_order( &list );
+    if (list.count) found = list.items[last ? list.count - 1 : 0];
+    free( list.items );
+    return found;
+}
