+static BOOL button_focusable( struct xaml_element *element )
+{
+    struct button *impl = impl_from_element( element );
+    return impl->enabled && impl->kind != BUTTON_PROGRESS;
+}
+
+/* Space presses and releases a button (Click on release), Enter clicks a Button at once */
+static BOOL button_key( struct xaml_element *element, BOOL down, WPARAM vk )
+{
+    struct button *impl = impl_from_element( element );
+
+    if (impl->kind == BUTTON_SCROLL) return scroll_key( impl, down, vk );
+    if (is_range_kind( impl )) return range_key( impl, down, vk );
+    if (!impl->enabled || element_focus_state( element ) == FocusState_Unfocused) return FALSE;
+    if (vk == VK_SPACE)
+    {
+        if (down) impl->pressed = TRUE;
+        else if (impl->pressed)
+        {
+            impl->pressed = FALSE;
+            button_update_state( impl );
+            window_invalidate();
+            button_raise_click( impl );
+            return TRUE;
+        }
+        button_update_state( impl );
+        window_invalidate();
+        return TRUE;
+    }
+    if (vk == VK_RETURN && down && impl->kind == BUTTON_PLAIN)
+    {
+        button_raise_click( impl );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL button_wheel( struct xaml_element *element, INT32 delta, BOOL horizontal )
+{
+    struct button *impl = impl_from_element( element );
+    return impl->kind == BUTTON_SCROLL && scroll_wheel( impl, delta, horizontal );
+}
+
+static BOOL button_child_clip( struct xaml_element *element, struct layout_rect *rect )
+{
+    struct button *impl = impl_from_element( element );
+    if (impl->kind != BUTTON_SCROLL) return FALSE;
+    *rect = element->bounds;
+    return TRUE;
+}
