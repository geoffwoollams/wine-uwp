@@ -874,3 +874,30 @@ static const struct IToggleSwitchVtbl toggle_switch_vtbl =
     toggle_switch_add_Toggled,
     toggle_switch_remove_Toggled
 };
+
+/* keyboard: Space toggles a ToggleSwitch; the arrow keys move a Slider by SmallChange (or StepFrequency), Page Up
+ * and Page Down by LargeChange, Home and End to its ends */
+BOOL range_key( struct button *impl, BOOL down, WPARAM vk )
+{
+    double step;
+
+    if (!impl->enabled || element_focus_state( &impl->element ) == FocusState_Unfocused) return FALSE;
+    if (impl->kind == BUTTON_TOGGLE_SWITCH)
+    {
+        if (vk != VK_SPACE) return FALSE;
+        if (!down) toggle( impl );
+        return TRUE;
+    }
+    if (impl->kind != BUTTON_SLIDER || !down) return FALSE;
+    step = impl->step > 0 ? impl->step : impl->small_change;
+    switch (vk)
+    {
+    case VK_RIGHT: case VK_UP: set_value( impl, impl->value + step ); return TRUE;
+    case VK_LEFT: case VK_DOWN: set_value( impl, impl->value - step ); return TRUE;
+    case VK_PRIOR: set_value( impl, impl->value + impl->large_change ); return TRUE;
+    case VK_NEXT: set_value( impl, impl->value - impl->large_change ); return TRUE;
+    case VK_HOME: set_value( impl, impl->minimum ); return TRUE;
+    case VK_END: set_value( impl, impl->maximum ); return TRUE;
+    }
+    return FALSE;
+}
