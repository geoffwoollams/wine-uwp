+ */
+
+#include <math.h>
+
+#include "private.h"
+#include "control.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A ScrollViewer is a ContentControl (struct button, kind BUTTON_SCROLL) whose content is measured without a limit
+ * along each axis that scrolls, arranged at minus the scroll offset and drawn clipped to the viewport. Along an
+ * axis whose ScrollBarVisibility is Disabled the content gets the viewport's size instead, like Windows' default
+ * horizontal axis. The mouse wheel scrolls 48 px a notch (Shift or a horizontal wheel scroll sideways); the arrow
+ * keys 16 px, Page Up / Down a viewport, Home / End to the ends. The scroll bars are Windows 10's: a thin panning
+ * indicator, widened to a draggable 12 px bar while the pointer is over the ScrollViewer; a press on the track
+ * pages. ChangeView and ScrollToHorizontal/VerticalOffset scroll at once (no animation), and ViewChanged follows
+ * every change. Zooming isn't supported (ZoomFactor stays 1). */
+
+#define WHEEL_STEP 48.0
+#define LINE_STEP 16.0
+#define BAR_WIDE 12.0f
+#define BAR_THIN 3.0f
+#define THUMB_MIN 20.0f
+
+struct scroll_state
+{
+    IScrollViewer IScrollViewer_iface;
+    IScrollViewer2 IScrollViewer2_iface;
+    IScrollViewer3 IScrollViewer3_iface;
+    IScrollViewer4 IScrollViewer4_iface;
+    struct button *button;
+
+    ScrollBarVisibility h_bar, v_bar;
+    ScrollMode h_mode, v_mode;
+    ZoomMode zoom_mode;
+    boolean h_rail, v_rail, h_chain, v_chain, zoom_chain, scroll_inertia, zoom_inertia, deferred, bring_into_view;
+    boolean reduce_for_occlusions, render_outside;
+    SnapPointsAlignment h_snap_align, v_snap_align;
+    SnapPointsType h_snap, v_snap, zoom_snap;
+    float min_zoom, max_zoom;
+    double anchor_h, anchor_v;
+    IUIElement *top_left_header, *left_header, *top_header;
+
+    double h_offset, v_offset;
+    double extent_w, extent_h, viewport_w, viewport_h;
+    struct event_list view_changed, view_changing, manipulation_started, manipulation_completed, anchor_requested;
+
+    BOOL pointer_over;
+    int dragging;             /* 0, or 1 / 2 while the horizontal / vertical thumb is dragged */
+    float drag_start, drag_offset;
+};
+
+static inline struct scroll_state *scroll_of( struct button *impl )
+{
+    return impl->scroll;
+}
+
+static double scrollable_w( struct scroll_state *s ) { return max( 0.0, s->extent_w - s->viewport_w ); }
+static double scrollable_h( struct scroll_state *s ) { return max( 0.0, s->extent_h - s->viewport_h ); }
+
+static BOOL scrolls_h( struct scroll_state *s )
+{
+    return s->h_bar != ScrollBarVisibility_Disabled && s->h_mode != ScrollMode_Disabled;
+}
+
+static BOOL scrolls_v( struct scroll_state *s )
+{
+    return s->v_bar != ScrollBarVisibility_Disabled && s->v_mode != ScrollMode_Disabled;
+}
+
+static BOOL bar_shown( ScrollBarVisibility visibility, double scrollable )
+{
+    return visibility == ScrollBarVisibility_Visible || (visibility == ScrollBarVisibility_Auto && scrollable > 0);
+}
+
+/* ViewChanged: the args only have IsIntermediate, always FALSE here (every change is final) */
+struct view_args
+{
+    IScrollViewerViewChangedEventArgs IScrollViewerViewChangedEventArgs_iface;
+    LONG ref;
+};
+
+static inline struct view_args *impl_from_view_args( IScrollViewerViewChangedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct view_args, IScrollViewerViewChangedEventArgs_iface );
+}
+
+static HRESULT WINAPI view_args_QueryInterface( IScrollViewerViewChangedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IScrollViewerViewChangedEventArgs ))
+    {
+        *out = iface;
+        IScrollViewerViewChangedEventArgs_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI view_args_AddRef( IScrollViewerViewChangedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_view_args( iface )->ref );
+}
+
+static ULONG WINAPI view_args_Release( IScrollViewerViewChangedEventArgs *iface )
+{
+    struct view_args *impl = impl_from_view_args( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI view_args_GetIids( IScrollViewerViewChangedEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI view_args_GetRuntimeClassName( IScrollViewerViewChangedEventArgs *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI view_args_GetTrustLevel( IScrollViewerViewChangedEventArgs *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI view_args_get_IsIntermediate( IScrollViewerViewChangedEventArgs *iface, boolean *value )
+{
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct IScrollViewerViewChangedEventArgsVtbl view_args_vtbl =
+{
+    view_args_QueryInterface, view_args_AddRef, view_args_Release,
+    view_args_GetIids, view_args_GetRuntimeClassName, view_args_GetTrustLevel,
+    view_args_get_IsIntermediate,
+};
+
+static void raise_view_changed( struct scroll_state *s )
+{
+    struct view_args *args;
+    IUnknown **handlers;
+    UINT32 i, count = s->view_changed.count;
+
+    if (!count || !(args = calloc( 1, sizeof(*args) ))) return;
+    args->IScrollViewerViewChangedEventArgs_iface.lpVtbl = &view_args_vtbl;
+    args->ref = 1;
+    if ((handlers = calloc( count, sizeof(*handlers) )))
+    {
+        for (i = 0; i < count; i++) if ((handlers[i] = s->view_changed.handlers[i])) IUnknown_AddRef( handlers[i] );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            IEventHandler_ScrollViewerViewChangedEventArgs_Invoke( (IEventHandler_ScrollViewerViewChangedEventArgs *)handlers[i],
+                    s->button->element.outer, &args->IScrollViewerViewChangedEventArgs_iface );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+    IScrollViewerViewChangedEventArgs_Release( &args->IScrollViewerViewChangedEventArgs_iface );
+}
+
+/* scroll to an offset, kept inside the scrollable range; TRUE if the view moved */
+static BOOL scroll_to( struct scroll_state *s, double h, double v )
+{
+    h = min( max( h, 0.0 ), scrollable_w( s ) );
+    v = min( max( v, 0.0 ), scrollable_h( s ) );
+    if (!scrolls_h( s )) h = 0;
+    if (!scrolls_v( s )) v = 0;
+    if (h == s->h_offset && v == s->v_offset) return FALSE;
+    TRACE( "%p: offset %.1f,%.1f.\n", s, h, v );
+    s->h_offset = h;
+    s->v_offset = v;
+    window_invalidate();
+    element_property_changed( s->button->element.outer, L"VerticalOffset" );
+    element_property_changed( s->button->element.outer, L"HorizontalOffset" );
+    raise_view_changed( s );
+    return TRUE;
+}
+
+/* ---- layout and drawing ---- */
+
+void scroll_measure( struct button *impl, struct layout_context *ctx, float avail_width, float avail_height,
+                     float *width, float *height )
+{
+    struct scroll_state *s = scroll_of( impl );
+    struct xaml_element *child = impl->content_element;
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    float extra_w = b->Left + b->Right + p->Left + p->Right, extra_h = b->Top + b->Bottom + p->Top + p->Bottom;
+
+    *width = *height = 0;
+    if (!child) return;
+    /* along the axes that scroll the content may be as big as it likes */
+    element_measure( child, ctx, scrolls_h( s ) ? INFINITY : max( 0.0f, avail_width - extra_w ),
+                     scrolls_v( s ) ? INFINITY : max( 0.0f, avail_height - extra_h ) );
+    *width = min( child->desired_width + extra_w, avail_width );
+    *height = min( child->desired_height + extra_h, avail_height );
+}
+
+static void viewport_rect( struct button *impl, struct layout_rect *rect )
+{
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    const struct layout_rect *r = &impl->element.bounds;
+
+    rect->x = r->x + b->Left + p->Left;
+    rect->y = r->y + b->Top + p->Top;
+    rect->width = max( 0.0f, r->width - b->Left - b->Right - p->Left - p->Right );
+    rect->height = max( 0.0f, r->height - b->Top - b->Bottom - p->Top - p->Bottom );
+}
+
+void scroll_arrange( struct button *impl, struct layout_context *ctx )
+{
+    struct scroll_state *s = scroll_of( impl );
+    struct xaml_element *child = impl->content_element;
+    struct layout_rect view;
+    double old_h = s->h_offset, old_v = s->v_offset;
+    float w, h;
+
+    viewport_rect( impl, &view );
+    s->viewport_w = view.width;
+    s->viewport_h = view.height;
+    if (!child)
+    {
+        s->extent_w = s->extent_h = 0;
+        s->h_offset = s->v_offset = 0;
+        return;
+    }
+    /* the content's own size, filling the viewport when it is smaller; an axis that doesn't scroll gets the viewport */
+    w = scrolls_h( s ) ? max( child->desired_width, view.width ) : view.width;
+    h = scrolls_v( s ) ? max( child->desired_height, view.height ) : view.height;
+    s->extent_w = scrolls_h( s ) ? child->desired_width : view.width;
+    s->extent_h = scrolls_v( s ) ? child->desired_height : view.height;
+    /* the content may have shrunk */
+    s->h_offset = min( s->h_offset, scrollable_w( s ) );
+    s->v_offset = min( s->v_offset, scrollable_h( s ) );
+    element_arrange( child, ctx, view.x - s->h_offset, view.y - s->v_offset, w, h );
+    if (s->h_offset != old_h || s->v_offset != old_v) raise_view_changed( s );
+}
+
+/* the vertical (or horizontal) scroll bar's track and thumb */
+static BOOL bar_rects( struct button *impl, BOOL vertical, struct layout_rect *track, struct layout_rect *thumb )
+{
+    struct scroll_state *s = scroll_of( impl );
+    double scrollable = vertical ? scrollable_h( s ) : scrollable_w( s ), extent = vertical ? s->extent_h : s->extent_w;
+    double viewport = vertical ? s->viewport_h : s->viewport_w, offset = vertical ? s->v_offset : s->h_offset;
+    float size = s->pointer_over || s->dragging ? BAR_WIDE : BAR_THIN, length, thumb_length;
+    struct layout_rect view;
+
+    if (!bar_shown( vertical ? s->v_bar : s->h_bar, scrollable ) || scrollable <= 0 || extent <= 0) return FALSE;
+    viewport_rect( impl, &view );
+    if (vertical)
+    {
+        track->x = view.x + view.width - size;
+        track->y = view.y;
+        track->width = size;
+        track->height = view.height;
+        length = track->height;
+    }
+    else
+    {
+        track->x = view.x;
+        track->y = view.y + view.height - size;
+        track->width = view.width;
+        track->height = size;
+        length = track->width;
+    }
+    thumb_length = max( THUMB_MIN, length * viewport / extent );
+    thumb_length = min( thumb_length, length );
+    *thumb = *track;
+    if (vertical)
+    {
+        thumb->y = track->y + (length - thumb_length) * offset / scrollable;
+        thumb->height = thumb_length;
+    }
+    else
+    {
+        thumb->x = track->x + (length - thumb_length) * offset / scrollable;
+        thumb->width = thumb_length;
+    }
+    return TRUE;
+}
+
+void scroll_render( struct button *impl, struct layout_context *ctx )
+{
+    struct scroll_state *s = scroll_of( impl );
+    struct xaml_element *child = impl->content_element;
+    struct layout_rect view, track, thumb;
+    struct look background = {0};
+    /* Windows 10's scroll bar colours: base medium low for the thumb, chrome low (alpha 0x99) for the track */
+    COLORREF thumb_color = ctx->dark ? RGB(102, 102, 102) : RGB(153, 153, 153);
+    COLORREF track_color = ctx->dark ? RGB(23, 23, 23) : RGB(242, 242, 242);
+    BOOL vertical;
+
+    if (impl->background) brush_look( impl->background, &background );
+    if (background.paint) element_fill_color( ctx, &impl->element.bounds, background.color );
+    if (impl->border_brush) element_frame( ctx, &impl->element.bounds, &impl->border_thickness, impl->border_brush );
+    viewport_rect( impl, &view );
+    if (child)
+    {
+        if (ctx->rt) d2d_push_clip( ctx, &view );
+        element_render( child, ctx );
+        if (ctx->rt) d2d_pop_clip( ctx );
+    }
+    for (vertical = FALSE; vertical <= TRUE; vertical++)
+    {
+        if (!bar_rects( impl, vertical, &track, &thumb )) continue;
+        if (s->pointer_over || s->dragging) element_fill_color( ctx, &track, track_color );
+        element_fill_color( ctx, &thumb, thumb_color );
+    }
+}
+
+/* ---- input ---- */
+
+static BOOL inside( const struct layout_rect *r, float x, float y )
+{
+    return x >= r->x && y >= r->y && x < r->x + r->width && y < r->y + r->height;
+}
+
+void scroll_pointer( struct button *impl, UINT msg, float x, float y )
+{
+    struct scroll_state *s = scroll_of( impl );
+    struct layout_rect track, thumb;
+    BOOL vertical;
+
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+        if (!s->pointer_over) { s->pointer_over = TRUE; window_invalidate(); }
+        if (s->dragging && bar_rects( impl, s->dragging == 2, &track, &thumb ))
+        {
+            BOOL v = s->dragging == 2;
+            float length = v ? track.height - thumb.height : track.width - thumb.width;
+            float moved = (v ? y : x) - s->drag_start;
+            double scrollable = v ? scrollable_h( s ) : scrollable_w( s ), offset;
+            if (length <= 0) break;
+            offset = s->drag_offset + moved * scrollable / length;
+            if (v) scroll_to( s, s->h_offset, offset );
+            else scroll_to( s, offset, s->v_offset );
+        }
+        break;
+    case WM_MOUSELEAVE:
+        if (s->pointer_over && !s->dragging) { s->pointer_over = FALSE; window_invalidate(); }
+        break;
+    case WM_LBUTTONDOWN:
+        for (vertical = FALSE; vertical <= TRUE; vertical++)
+        {
+            if (!bar_rects( impl, vertical, &track, &thumb ) || !inside( &track, x, y )) continue;
+            if (inside( &thumb, x, y ))
+            {
+                s->dragging = vertical ? 2 : 1;
+                s->drag_start = vertical ? y : x;
+                s->drag_offset = vertical ? s->v_offset : s->h_offset;
+            }
+            /* a press on the track pages towards it */
+            else if (vertical) scroll_to( s, s->h_offset, s->v_offset + (y < thumb.y ? -s->viewport_h : s->viewport_h) );
+            else scroll_to( s, s->h_offset + (x < thumb.x ? -s->viewport_w : s->viewport_w), s->v_offset );
+            break;
+        }
+        break;
+    case WM_LBUTTONUP:
+    case WM_CAPTURECHANGED:
+        if (s->dragging) { s->dragging = 0; window_invalidate(); }
+        break;
+    }
+}
+
+BOOL scroll_wheel( struct button *impl, INT32 delta, BOOL horizontal )
+{
+    struct scroll_state *s = scroll_of( impl );
+    double step = WHEEL_STEP * delta / WHEEL_DELTA;
+
+    /* Windows' wheel scrolls down for a negative delta; a horizontal wheel's positive delta scrolls right */
+    if (horizontal ? !scrolls_h( s ) || scrollable_w( s ) <= 0 : !scrolls_v( s ) || scrollable_h( s ) <= 0) return FALSE;
+    if (horizontal) return scroll_to( s, s->h_offset + step, s->v_offset ) || TRUE;
+    return scroll_to( s, s->h_offset, s->v_offset - step ) || TRUE;
+}
+
+BOOL scroll_key( struct button *impl, BOOL down, WPARAM vk )
+{
+    struct scroll_state *s = scroll_of( impl );
+
+    if (!down) return FALSE;
+    switch (vk)
+    {
+    case VK_UP: return scroll_to( s, s->h_offset, s->v_offset - LINE_STEP );
+    case VK_DOWN: return scroll_to( s, s->h_offset, s->v_offset + LINE_STEP );
+    case VK_LEFT: return scroll_to( s, s->h_offset - LINE_STEP, s->v_offset );
+    case VK_RIGHT: return scroll_to( s, s->h_offset + LINE_STEP, s->v_offset );
+    case VK_PRIOR: return scroll_to( s, s->h_offset, s->v_offset - s->viewport_h );
+    case VK_NEXT: return scroll_to( s, s->h_offset, s->v_offset + s->viewport_h );
+    case VK_HOME: return scroll_to( s, s->h_offset, 0 );
+    case VK_END: return scroll_to( s, s->h_offset, scrollable_h( s ) );
+    }
+    return FALSE;
+}
+
+/* ---- markup: ScrollViewer's properties, and its attached properties on other elements ---- */
+
+/* the value is text (from XAML text) or, with value NULL, a number (an enum or boolean from compiled XAML) */
+static BOOL parse_enum( const WCHAR *value, INT32 number, const WCHAR *const *names, UINT32 count, INT32 *out )
+{
+    UINT32 i;
+    if (!value) { *out = number; return number >= 0 && number < count; }
+    for (i = 0; i < count; i++) if (!wcsicmp( value, names[i] )) { *out = i; return TRUE; }
+    return FALSE;
+}
+
+static boolean parse_bool( const WCHAR *value, INT32 number )
+{
+    return value ? parse_bool( value, number ) : number != 0;
+}
+
+BOOL scroll_set_markup( IInspectable *target, const WCHAR *owner, const WCHAR *name, const WCHAR *value, INT32 number )
+{
+    static const WCHAR *const bar_names[] = { L"Disabled", L"Auto", L"Hidden", L"Visible" };
+    static const WCHAR *const mode_names[] = { L"Disabled", L"Enabled", L"Auto" };
+    static const WCHAR *const zoom_names[] = { L"Disabled", L"Enabled" };
+    struct xaml_element *element = element_from_object( target );
+    struct scroll_state *s = NULL;
+    INT32 e;
+
+    if (element && element->class_name && !wcscmp( element->class_name, RuntimeClass_Windows_UI_Xaml_Controls_ScrollViewer ))
+        s = scroll_of( impl_from_element( element ) );
+    if (!s && wcscmp( owner, L"ScrollViewer" )) return FALSE;
+    if (!s)
+    {
+        /* ScrollViewer.* attached to another element: only the ScrollViewers in templates read them */
+        TRACE( "ScrollViewer.%s=%s (%d) on a %s is ignored.\n", debugstr_w(name), debugstr_w(value), number,
+               element ? debugstr_w(element->class_name) : "non-element" );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"HorizontalScrollBarVisibility" ) && parse_enum( value, number, bar_names, 4, &e )) s->h_bar = e;
+    else if (!wcscmp( name, L"VerticalScrollBarVisibility" ) && parse_enum( value, number, bar_names, 4, &e )) s->v_bar = e;
+    else if (!wcscmp( name, L"HorizontalScrollMode" ) && parse_enum( value, number, mode_names, 3, &e )) s->h_mode = e;
+    else if (!wcscmp( name, L"VerticalScrollMode" ) && parse_enum( value, number, mode_names, 3, &e )) s->v_mode = e;
+    else if (!wcscmp( name, L"ZoomMode" ) && parse_enum( value, number, zoom_names, 2, &e )) s->zoom_mode = e;
+    else if (!wcscmp( name, L"IsHorizontalRailEnabled" )) s->h_rail = parse_bool( value, number );
+    else if (!wcscmp( name, L"IsVerticalRailEnabled" )) s->v_rail = parse_bool( value, number );
+    else if (!wcscmp( name, L"IsDeferredScrollingEnabled" )) s->deferred = parse_bool( value, number );
+    else if (!wcscmp( name, L"BringIntoViewOnFocusChange" )) s->bring_into_view = parse_bool( value, number );
+    else return FALSE;
+    TRACE( "ScrollViewer %p: %s=%s (%d).\n", s, debugstr_w(name), debugstr_w(value), number );
+    window_invalidate();
+    return TRUE;
+}
