+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IKeyRoutedEventArgs ))
+        *out = &impl->IKeyRoutedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IRoutedEventArgs ))
