+/* ---- the control ---- */
+
+HRESULT scroll_init( struct button *impl )
+{
+    struct scroll_state *s;
+
+    if (!(s = calloc( 1, sizeof(*s) ))) return E_OUTOFMEMORY;
+    s->IScrollViewer_iface.lpVtbl = &sv_vtbl;
+    s->IScrollViewer2_iface.lpVtbl = &sv2_vtbl;
+    s->IScrollViewer3_iface.lpVtbl = &sv3_vtbl;
+    s->IScrollViewer4_iface.lpVtbl = &sv4_vtbl;
+    s->button = impl;
+    /* the defaults of Windows' ScrollViewer: vertical scrolling with a visible bar, horizontal disabled */
+    s->h_bar = ScrollBarVisibility_Disabled;
+    s->v_bar = ScrollBarVisibility_Visible;
+    s->h_mode = s->v_mode = ScrollMode_Enabled;
+    s->zoom_mode = ZoomMode_Disabled;
+    s->h_rail = s->v_rail = s->h_chain = s->v_chain = s->zoom_chain = TRUE;
+    s->scroll_inertia = s->zoom_inertia = s->bring_into_view = TRUE;
+    s->min_zoom = 0.1f;
+    s->max_zoom = 10.0f;
+    impl->scroll = s;
+    /* a ScrollViewer stretches to fill its slot and shows its content from the top left */
+    impl->element.horizontal_alignment = HorizontalAlignment_Stretch;
+    impl->element.vertical_alignment = VerticalAlignment_Stretch;
+    impl->content_horizontal = HorizontalAlignment_Left;
+    impl->content_vertical = VerticalAlignment_Top;
+    impl->border_thickness.Left = impl->border_thickness.Top = impl->border_thickness.Right = impl->border_thickness.Bottom = 0;
+    impl->padding.Left = impl->padding.Top = impl->padding.Right = impl->padding.Bottom = 0;
+    return S_OK;
+}
+
+void *scroll_default_iface( struct button *impl )
+{
+    return &impl->scroll->IScrollViewer_iface;
+}
+
+HRESULT scroll_query_interface( struct button *impl, REFIID iid, void **out )
+{
+    struct scroll_state *s = impl->scroll;
+
+    if (IsEqualGUID( iid, &IID_IScrollViewer )) *out = &s->IScrollViewer_iface;
+    else if (IsEqualGUID( iid, &IID_IScrollViewer2 )) *out = &s->IScrollViewer2_iface;
+    else if (IsEqualGUID( iid, &IID_IScrollViewer3 )) *out = &s->IScrollViewer3_iface;
+    else if (IsEqualGUID( iid, &IID_IScrollViewer4 )) *out = &s->IScrollViewer4_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+void scroll_destroy( struct button *impl )
+{
+    struct scroll_state *s = impl->scroll;
+
+    if (!s) return;
+    event_list_clear( &s->view_changed );
+    event_list_clear( &s->view_changing );
+    event_list_clear( &s->manipulation_started );
+    event_list_clear( &s->manipulation_completed );
+    event_list_clear( &s->anchor_requested );
+    if (s->top_left_header) IUIElement_Release( s->top_left_header );
+    if (s->left_header) IUIElement_Release( s->left_header );
+    if (s->top_header) IUIElement_Release( s->top_header );
+    free( s );
+    impl->scroll = NULL;
+}
