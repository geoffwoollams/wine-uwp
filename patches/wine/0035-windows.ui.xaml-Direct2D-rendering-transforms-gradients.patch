+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+
+/* before private.h: d2d1.h brings urlmon's IBinding, which Windows.UI.Xaml.Data's IBinding macro would rename */
+#define COBJMACROS
+#include "d2d1.h"
+#include "dwrite.h"
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A frame is drawn with one Direct2D DC render target bound to the window's back buffer (a memory DC), in view
+ * pixels (its DPI is 96 x the view scale): anti-aliased shapes, real curves, transforms, clips, gradients, and
+ * DirectWrite text. Where Wine's Direct2D lacks something (layers, geometry combining), the code works around it:
+ * opacity draws into an offscreen target then blends it, and strokes are two-figure alternate-fill geometries.
+ * If Direct2D can't start, element.c draws with GDI as before. */
+
+/* no import library has it */
+static const GUID iid_dwrite_factory = { 0xb859ee5a, 0xd838, 0x4b5b, { 0xa2, 0xe8, 0x1a, 0xdc, 0x7d, 0x93, 0xdb, 0x48 } };
+
+static ID2D1Factory *factory;
+static IDWriteFactory *dwrite;
+static ID2D1DCRenderTarget *dc_target;
+static BOOL disabled;
+
+#define RT(ctx) ((ID2D1RenderTarget *)(ctx)->rt)
+
+static BOOL init(void)
+{
+    if (factory || disabled) return factory != NULL;
+    if (FAILED(D2D1CreateFactory( D2D1_FACTORY_TYPE_SINGLE_THREADED, &IID_ID2D1Factory, NULL, (void **)&factory )))
+    {
+        ERR( "no Direct2D: drawing with GDI.\n" );
+        disabled = TRUE;
+        return FALSE;
+    }
+    if (FAILED(DWriteCreateFactory( DWRITE_FACTORY_TYPE_SHARED, &iid_dwrite_factory, (IUnknown **)&dwrite ))) dwrite = NULL;
+    return TRUE;
+}
+
+BOOL render_begin( struct layout_context *ctx, HDC hdc, const RECT *rect )
+{
+    D2D1_RENDER_TARGET_PROPERTIES props = { D2D1_RENDER_TARGET_TYPE_DEFAULT,
+                                            { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_IGNORE }, 0, 0,
+                                            D2D1_RENDER_TARGET_USAGE_NONE, D2D1_FEATURE_LEVEL_DEFAULT };
+    D2D1_MATRIX_3X2_F identity = {{{ 1, 0, 0, 1, 0, 0 }}};
+
+    ctx->rt = NULL;
+    if (!init()) return FALSE;
+    if (!dc_target && FAILED(ID2D1Factory_CreateDCRenderTarget( factory, &props, &dc_target )))
+    {
+        ERR( "no Direct2D DC render target: drawing with GDI.\n" );
+        disabled = TRUE;
+        return FALSE;
+    }
+    if (FAILED(ID2D1DCRenderTarget_BindDC( dc_target, hdc, rect ))) return FALSE;
+    ID2D1DCRenderTarget_SetDpi( dc_target, 96 * ctx->scale, 96 * ctx->scale );
+    ID2D1DCRenderTarget_BeginDraw( dc_target );
+    ID2D1DCRenderTarget_SetTransform( dc_target, &identity );
+    ctx->rt = dc_target;
+    memcpy( ctx->transform, &identity, sizeof(ctx->transform) );
+    return TRUE;
+}
+
+void render_end( struct layout_context *ctx )
+{
+    HRESULT hr;
+
+    if (!ctx->rt) return;
+    if ((hr = ID2D1DCRenderTarget_EndDraw( dc_target, NULL, NULL )) == D2DERR_RECREATE_TARGET)
+    {
+        ID2D1DCRenderTarget_Release( dc_target );
+        dc_target = NULL;
+    }
+    else if (FAILED(hr)) WARN( "EndDraw failed, hr %#lx.\n", hr );
+    ctx->rt = NULL;
+}
+
+static D2D1_COLOR_F color_f( Color c )
+{
+    D2D1_COLOR_F f = { c.R / 255.0f, c.G / 255.0f, c.B / 255.0f, c.A / 255.0f };
+    return f;
+}
+
+static D2D1_RECT_F rect_f( const struct layout_rect *r )
+{
+    D2D1_RECT_F f = { r->x, r->y, r->x + r->width, r->y + r->height };
+    return f;
+}
+
+static ID2D1Brush *solid( struct layout_context *ctx, Color c )
+{
+    D2D1_COLOR_F f = color_f( c );
+    ID2D1SolidColorBrush *brush = NULL;
+    ID2D1RenderTarget_CreateSolidColorBrush( RT(ctx), &f, NULL, &brush );
+    return (ID2D1Brush *)brush;
+}
+
+/* our Brush as a Direct2D one for drawing over bounds (a gradient's relative points are mapped to them) */
+static ID2D1Brush *d2d_brush( struct layout_context *ctx, IBrush *brush, const struct layout_rect *bounds )
+{
+    struct gradient_info info;
+    D2D1_GRADIENT_STOP stops[16];
+    D2D1_LINEAR_GRADIENT_BRUSH_PROPERTIES props;
+    D2D1_BRUSH_PROPERTIES brush_props = { 1.0f, {{{ 1, 0, 0, 1, 0, 0 }}} };
+    ID2D1GradientStopCollection *collection;
+    ID2D1LinearGradientBrush *linear = NULL;
+    UINT32 i;
+    Color c;
+
+    if (!brush) return NULL;
+    if (brush_get_gradient( brush, &info ))
+    {
+        for (i = 0; i < info.count && i < ARRAY_SIZE(stops); i++)
+        {
+            stops[i].position = info.stops[i].offset;
+            stops[i].color = color_f( info.stops[i].color );
+        }
+        if (FAILED(ID2D1RenderTarget_CreateGradientStopCollection( RT(ctx), stops, i, D2D1_GAMMA_2_2,
+                                                                   info.spread, &collection ))) return NULL;
+        props.startPoint.x = info.relative ? bounds->x + info.start.X * bounds->width : info.start.X;
+        props.startPoint.y = info.relative ? bounds->y + info.start.Y * bounds->height : info.start.Y;
+        props.endPoint.x = info.relative ? bounds->x + info.end.X * bounds->width : info.end.X;
+        props.endPoint.y = info.relative ? bounds->y + info.end.Y * bounds->height : info.end.Y;
+        brush_props.opacity = info.opacity;
+        ID2D1RenderTarget_CreateLinearGradientBrush( RT(ctx), &props, &brush_props, collection, &linear );
+        ID2D1GradientStopCollection_Release( collection );
+        return (ID2D1Brush *)linear;
+    }
+    if (!brush_get_color( brush, &c ) || !c.A) return NULL;
+    return solid( ctx, c );
+}
+
+void d2d_fill_color( struct layout_context *ctx, const struct layout_rect *rect, Color c )
+{
+    ID2D1Brush *brush = solid( ctx, c );
+    D2D1_RECT_F r = rect_f( rect );
+
+    if (!brush) return;
+    ID2D1RenderTarget_FillRectangle( RT(ctx), &r, brush );
+    ID2D1Brush_Release( brush );
+}
+
+/* a quarter ellipse from p0 to p1 whose tangents meet at corner, as a cubic Bezier (Wine's AddArc is a stub) */
+static void add_quarter( ID2D1GeometrySink *sink, float x0, float y0, float cx, float cy, float x1, float y1 )
+{
+    static const float k = 0.5522847f;
+    D2D1_BEZIER_SEGMENT bezier;
+
+    bezier.point1.x = x0 + k * (cx - x0);
+    bezier.point1.y = y0 + k * (cy - y0);
+    bezier.point2.x = x1 + k * (cx - x1);
+    bezier.point2.y = y1 + k * (cy - y1);
+    bezier.point3.x = x1;
+    bezier.point3.y = y1;
+    ID2D1GeometrySink_AddBezier( sink, &bezier );
+}
+
+static void add_line( ID2D1GeometrySink *sink, float x, float y )
+{
+    D2D1_POINT_2F p = { x, y };
+    ID2D1GeometrySink_AddLine( sink, p );
+}
+
+/* a rectangle with per-corner radii, or an ellipse, as one figure of sink; reverse winds it the other way */
+static void add_shape_figure( ID2D1GeometrySink *sink, float l, float t, float r, float b, const CornerRadius *radius,
+                              BOOL ellipse, BOOL reverse )
+{
+    float w = r - l, h = b - t, lim = min( w, h ) / 2, tl = 0, tr = 0, br = 0, bl = 0;
+    float tlx, tly, trx, try_, brx, bry, blx, bly;
+    D2D1_POINT_2F p;
+
+    if (w <= 0 || h <= 0) return;
+    if (ellipse)
+    {
+        /* the corner radii of an ellipse are its half axes */
+        tlx = trx = brx = blx = w / 2;
+        tly = try_ = bry = bly = h / 2;
+    }
+    else
+    {
+        if (radius)
+        {
+            tl = min( max( 0.0, radius->TopLeft ), lim );
+            tr = min( max( 0.0, radius->TopRight ), lim );
+            br = min( max( 0.0, radius->BottomRight ), lim );
+            bl = min( max( 0.0, radius->BottomLeft ), lim );
+        }
+        tlx = tly = tl; trx = try_ = tr; brx = bry = br; blx = bly = bl;
+    }
+    p.x = l + tlx;
+    p.y = t;
+    ID2D1GeometrySink_BeginFigure( sink, p, D2D1_FIGURE_BEGIN_FILLED );
+    if (!reverse)
+    {
+        add_line( sink, r - trx, t );
+        if (trx) add_quarter( sink, r - trx, t, r, t, r, t + try_ );
+        add_line( sink, r, b - bry );
+        if (brx) add_quarter( sink, r, b - bry, r, b, r - brx, b );
+        add_line( sink, l + blx, b );
+        if (blx) add_quarter( sink, l + blx, b, l, b, l, b - bly );
+        add_line( sink, l, t + tly );
+        if (tlx) add_quarter( sink, l, t + tly, l, t, l + tlx, t );
+    }
+    else
+    {
+        if (tlx) add_quarter( sink, l + tlx, t, l, t, l, t + tly );
+        add_line( sink, l, b - bly );
+        if (blx) add_quarter( sink, l, b - bly, l, b, l + blx, b );
+        add_line( sink, r - brx, b );
+        if (brx) add_quarter( sink, r - brx, b, r, b, r, b - bry );
+        add_line( sink, r, t + try_ );
+        if (trx) add_quarter( sink, r, t + try_, r, t, r - trx, t );
+        add_line( sink, l + tlx, t );
+    }
+    ID2D1GeometrySink_EndFigure( sink, D2D1_FIGURE_END_CLOSED );
+}
+
+static ID2D1PathGeometry *shape_geometry( const struct layout_rect *rect, const CornerRadius *radius, BOOL ellipse,
+                                          const Thickness *ring )
+{
+    float l = rect->x, t = rect->y, r = rect->x + rect->width, b = rect->y + rect->height;
+    ID2D1PathGeometry *geometry;
+    ID2D1GeometrySink *sink;
+    CornerRadius inner;
+
+    if (FAILED(ID2D1Factory_CreatePathGeometry( factory, &geometry ))) return NULL;
+    if (FAILED(ID2D1PathGeometry_Open( geometry, &sink )))
+    {
+        ID2D1PathGeometry_Release( geometry );
+        return NULL;
+    }
+    ID2D1GeometrySink_SetFillMode( sink, D2D1_FILL_MODE_ALTERNATE );
+    add_shape_figure( sink, l, t, r, b, radius, ellipse, FALSE );
+    if (ring)
+    {
+        /* the stroke inside the edge: the outer shape minus the inner one */
+        if (radius)
+        {
+            inner.TopLeft = max( 0.0, radius->TopLeft - max( ring->Left, ring->Top ) / 2 );
+            inner.TopRight = max( 0.0, radius->TopRight - max( ring->Right, ring->Top ) / 2 );
+            inner.BottomRight = max( 0.0, radius->BottomRight - max( ring->Right, ring->Bottom ) / 2 );
+            inner.BottomLeft = max( 0.0, radius->BottomLeft - max( ring->Left, ring->Bottom ) / 2 );
+        }
+        add_shape_figure( sink, l + ring->Left, t + ring->Top, r - ring->Right, b - ring->Bottom,
+                          radius ? &inner : NULL, ellipse, TRUE );
+    }
+    ID2D1GeometrySink_Close( sink );
+    ID2D1GeometrySink_Release( sink );
+    return geometry;
+}
+
+void d2d_draw_shape( struct layout_context *ctx, const struct layout_rect *rect, const CornerRadius *radius,
+                     BOOL ellipse, IBrush *fill, IBrush *stroke, const Thickness *thickness )
+{
+    ID2D1PathGeometry *geometry;
+    ID2D1Brush *brush;
+
+    if ((brush = d2d_brush( ctx, fill, rect )))
+    {
+        if ((geometry = shape_geometry( rect, radius, ellipse, NULL )))
+        {
+            ID2D1RenderTarget_FillGeometry( RT(ctx), (ID2D1Geometry *)geometry, brush, NULL );
+            ID2D1PathGeometry_Release( geometry );
+        }
+        ID2D1Brush_Release( brush );
+    }
+    if (thickness && (thickness->Left > 0 || thickness->Top > 0 || thickness->Right > 0 || thickness->Bottom > 0) &&
+        (brush = d2d_brush( ctx, stroke, rect )))
+    {
+        if ((geometry = shape_geometry( rect, radius, ellipse, thickness )))
+        {
+            ID2D1RenderTarget_FillGeometry( RT(ctx), (ID2D1Geometry *)geometry, brush, NULL );
+            ID2D1PathGeometry_Release( geometry );
+        }
+        ID2D1Brush_Release( brush );
+    }
+}
+
+void d2d_draw_lines( struct layout_context *ctx, float x, float y, const struct shape_point *points, UINT32 count,
+                     BOOL closed, IBrush *fill, IBrush *stroke, double thickness )
+{
+    struct layout_rect bounds = { x, y, 0, 0 };
+    ID2D1PathGeometry *geometry;
+    ID2D1GeometrySink *sink;
+    ID2D1Brush *brush;
+    D2D1_POINT_2F p;
+    float max_x = 0, max_y = 0;
+    UINT32 i;
+
+    if (count < 2 || FAILED(ID2D1Factory_CreatePathGeometry( factory, &geometry ))) return;
+    if (FAILED(ID2D1PathGeometry_Open( geometry, &sink ))) { ID2D1PathGeometry_Release( geometry ); return; }
+    p.x = x + points[0].x;
+    p.y = y + points[0].y;
+    ID2D1GeometrySink_BeginFigure( sink, p, closed ? D2D1_FIGURE_BEGIN_FILLED : D2D1_FIGURE_BEGIN_HOLLOW );
+    for (i = 1; i < count; i++)
+    {
+        p.x = x + points[i].x;
+        p.y = y + points[i].y;
+        ID2D1GeometrySink_AddLine( sink, p );
+        max_x = max( max_x, points[i].x );
+        max_y = max( max_y, points[i].y );
+    }
+    ID2D1GeometrySink_EndFigure( sink, closed ? D2D1_FIGURE_END_CLOSED : D2D1_FIGURE_END_OPEN );
+    ID2D1GeometrySink_Close( sink );
+    ID2D1GeometrySink_Release( sink );
+    bounds.width = max_x;
+    bounds.height = max_y;
+    if (closed && (brush = d2d_brush( ctx, fill, &bounds )))
+    {
+        ID2D1RenderTarget_FillGeometry( RT(ctx), (ID2D1Geometry *)geometry, brush, NULL );
+        ID2D1Brush_Release( brush );
+    }
+    if (thickness > 0 && (brush = d2d_brush( ctx, stroke, &bounds )))
+    {
+        ID2D1RenderTarget_DrawGeometry( RT(ctx), (ID2D1Geometry *)geometry, brush, thickness, NULL );
+        ID2D1Brush_Release( brush );
+    }
+    ID2D1PathGeometry_Release( geometry );
+}
+
+/* ---- text ---- */
+
+static IDWriteTextLayout *text_layout( const struct text_format *format, HSTRING text, float width, float height )
+{
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( text, &len );
+    IDWriteTextFormat *text_format;
+    IDWriteTextLayout *layout = NULL;
+    DWRITE_TEXT_ALIGNMENT alignment;
+
+    if (!init() || !dwrite) return NULL;
+    if (FAILED(IDWriteFactory_CreateTextFormat( dwrite, L"Segoe UI", NULL, format->weight ? format->weight : 400,
+                                                format->italic ? DWRITE_FONT_STYLE_ITALIC : DWRITE_FONT_STYLE_NORMAL,
+                                                DWRITE_FONT_STRETCH_NORMAL, format->font_size, L"", &text_format )))
+        return NULL;
+    IDWriteTextFormat_SetWordWrapping( text_format, format->wrap ? DWRITE_WORD_WRAPPING_WRAP : DWRITE_WORD_WRAPPING_NO_WRAP );
+    switch (format->alignment)
+    {
+    case TextAlignment_Center: alignment = DWRITE_TEXT_ALIGNMENT_CENTER; break;
+    case TextAlignment_Right: alignment = DWRITE_TEXT_ALIGNMENT_TRAILING; break;
+    default: alignment = DWRITE_TEXT_ALIGNMENT_LEADING; break;
+    }
+    IDWriteTextFormat_SetTextAlignment( text_format, alignment );
+    IDWriteFactory_CreateTextLayout( dwrite, len ? str : L"", len, text_format, width, height, &layout );
+    IDWriteTextFormat_Release( text_format );
+    return layout;
+}
+
+BOOL dwrite_measure( const struct text_format *format, HSTRING text, float avail_width, float *width, float *height )
+{
+    IDWriteTextLayout *layout = text_layout( format, text, min( avail_width, 1e6f ), 1e6f );
+    DWRITE_TEXT_METRICS metrics;
+
+    if (!layout) return FALSE;
+    if (FAILED(IDWriteTextLayout_GetMetrics( layout, &metrics )))
+    {
+        IDWriteTextLayout_Release( layout );
+        return FALSE;
+    }
+    *width = ceilf( metrics.widthIncludingTrailingWhitespace );
+    *height = ceilf( metrics.height );
+    IDWriteTextLayout_Release( layout );
+    return TRUE;
+}
+
+BOOL d2d_draw_text( struct layout_context *ctx, const struct text_format *format, HSTRING text,
+                    const struct layout_rect *rect, Color color )
+{
+    IDWriteTextLayout *layout;
+    ID2D1Brush *brush;
+    D2D1_POINT_2F origin = { rect->x, rect->y };
+
+    if (!WindowsGetStringLen( text )) return TRUE;
+    if (!(layout = text_layout( format, text, max( rect->width, 1.0f ), max( rect->height, 1.0f ) ))) return FALSE;
+    if ((brush = solid( ctx, color )))
+    {
+        ID2D1RenderTarget_DrawTextLayout( RT(ctx), origin, layout, brush, D2D1_DRAW_TEXT_OPTIONS_NONE );
+        ID2D1Brush_Release( brush );
+    }
+    IDWriteTextLayout_Release( layout );
+    return TRUE;
+}
+
+/* ---- transforms, clips, opacity ---- */
+
+void d2d_set_transform( struct layout_context *ctx, const float *m )
+{
+    memcpy( ctx->transform, m, sizeof(ctx->transform) );
+    ID2D1RenderTarget_SetTransform( RT(ctx), (const D2D1_MATRIX_3X2_F *)m );
+}
+
+void d2d_push_clip( struct layout_context *ctx, const struct layout_rect *rect )
+{
+    D2D1_RECT_F r = rect_f( rect );
+    ID2D1RenderTarget_PushAxisAlignedClip( RT(ctx), &r, D2D1_ANTIALIAS_MODE_ALIASED );
+}
+
+void d2d_pop_clip( struct layout_context *ctx )
+{
+    ID2D1RenderTarget_PopAxisAlignedClip( RT(ctx) );
+}
+
+/* Opacity: draw into an offscreen target of the same size and transform, then blend that in.
+ * (Wine's Direct2D has no layers yet.) */
+void *d2d_begin_opacity( struct layout_context *ctx )
+{
+    ID2D1BitmapRenderTarget *target;
+    D2D1_SIZE_F size;
+    D2D1_COLOR_F clear = { 0, 0, 0, 0 };
+    D2D1_PIXEL_FORMAT format = { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED };
+    void *saved = ctx->rt;
+
+    size = ID2D1RenderTarget_GetSize( RT(ctx) );
+    if (FAILED(ID2D1RenderTarget_CreateCompatibleRenderTarget( RT(ctx), &size, NULL, &format,
+                                                               D2D1_COMPATIBLE_RENDER_TARGET_OPTIONS_NONE, &target )))
+        return NULL;
+    ID2D1BitmapRenderTarget_BeginDraw( target );
+    ID2D1BitmapRenderTarget_Clear( target, &clear );
+    ID2D1BitmapRenderTarget_SetTransform( target, (const D2D1_MATRIX_3X2_F *)ctx->transform );
+    ctx->rt = target;
+    return saved;
+}
+
+void d2d_end_opacity( struct layout_context *ctx, void *saved, float opacity )
+{
+    ID2D1BitmapRenderTarget *target = ctx->rt;
+    D2D1_MATRIX_3X2_F identity = {{{ 1, 0, 0, 1, 0, 0 }}};
+    ID2D1Bitmap *bitmap;
+    D2D1_SIZE_F size;
+    D2D1_RECT_F all;
+
+    ID2D1BitmapRenderTarget_EndDraw( target, NULL, NULL );
+    ctx->rt = saved;
+    if (SUCCEEDED(ID2D1BitmapRenderTarget_GetBitmap( target, &bitmap )))
+    {
+        size = ID2D1Bitmap_GetSize( bitmap );
+        all.left = all.top = 0;
+        all.right = size.width;
+        all.bottom = size.height;
+        ID2D1RenderTarget_SetTransform( RT(ctx), &identity );
+        ID2D1RenderTarget_DrawBitmap( RT(ctx), bitmap, &all, opacity, D2D1_BITMAP_INTERPOLATION_MODE_NEAREST_NEIGHBOR, &all );
+        ID2D1RenderTarget_SetTransform( RT(ctx), (const D2D1_MATRIX_3X2_F *)ctx->transform );
+        ID2D1Bitmap_Release( bitmap );
+    }
+    ID2D1BitmapRenderTarget_Release( target );
+}
+
+void d2d_clear( struct layout_context *ctx, COLORREF color )
+{
+    D2D1_COLOR_F f = { GetRValue( color ) / 255.0f, GetGValue( color ) / 255.0f, GetBValue( color ) / 255.0f, 1 };
+    ID2D1RenderTarget_Clear( RT(ctx), &f );
+}
