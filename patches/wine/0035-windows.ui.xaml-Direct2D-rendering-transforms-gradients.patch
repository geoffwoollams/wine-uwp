+/* TranslateTransform, ScaleTransform, RotateTransform, CompositeTransform, MatrixTransform, LinearGradientBrush
+ * and GradientStop: one object with a kind. Transforms give a 3x2 matrix for UIElement.RenderTransform (element.c
+ * draws and hit-tests with it); gradients are drawn by render.c. Markup and animations reach their properties by
+ * name through media_set_property / media_get_property. TransformGroup, brush transforms and
+ * ColorInterpolationMode aren't supported. */
+
+enum media_kind
+{
+    MEDIA_TRANSLATE,
+    MEDIA_SCALE,
+    MEDIA_ROTATE,
+    MEDIA_COMPOSITE,
+    MEDIA_MATRIX,
+    MEDIA_LINEAR_GRADIENT,
+    MEDIA_GRADIENT_STOP,
+};
+
+struct media
+{
+    IInspectable IInspectable_inner;
+    IGeneralTransform IGeneralTransform_iface;
+    ITransform ITransform_iface;
+    ITranslateTransform ITranslateTransform_iface;
+    IScaleTransform IScaleTransform_iface;
+    IRotateTransform IRotateTransform_iface;
+    ICompositeTransform ICompositeTransform_iface;
+    IMatrixTransform IMatrixTransform_iface;
+    IBrush IBrush_iface;
+    IGradientBrush IGradientBrush_iface;
+    ILinearGradientBrush ILinearGradientBrush_iface;
+    IGradientStop IGradientStop_iface;
+    LONG ref;
+    enum media_kind kind;
+
+    double x, y, center_x, center_y, scale_x, scale_y, skew_x, skew_y, angle;
+    Matrix matrix;
+    double opacity, offset;
+    Point start, end;
+    BrushMappingMode mapping;
+    GradientSpreadMethod spread;
+    IInspectable *stops;     /* GradientStopCollection */
+    Color color;
+};
+
+static const IInspectableVtbl inner_vtbl;
+
+static struct media *media_from_object( IInspectable *object )
+{
+    IInspectable *inner;
+    struct media *impl = NULL;
+
+    /* every interface of ours answers IInspectable with the shared inner one */
+    if (!object || FAILED(IInspectable_QueryInterface( object, &IID_IInspectable, (void **)&inner ))) return NULL;
+    if (inner->lpVtbl == &inner_vtbl) impl = CONTAINING_RECORD( inner, struct media, IInspectable_inner );
+    IInspectable_Release( inner );
+    return impl;
+}
+
+BOOL is_media_object( IInspectable *object )
+{
+    return media_from_object( object ) != NULL;
+}
+
+/* ---- matrices: D2D's row-vector 3x2 { m11, m12, m21, m22, dx, dy } ---- */
+
+static void mat_identity( float *m )
+{
+    m[0] = m[3] = 1;
+    m[1] = m[2] = m[4] = m[5] = 0;
+}
+
+/* a then b */
+void matrix_multiply( const float *a, const float *b, float *out )
+{
+    float r[6];
+    r[0] = a[0] * b[0] + a[1] * b[2];
+    r[1] = a[0] * b[1] + a[1] * b[3];
+    r[2] = a[2] * b[0] + a[3] * b[2];
+    r[3] = a[2] * b[1] + a[3] * b[3];
+    r[4] = a[4] * b[0] + a[5] * b[2] + b[4];
+    r[5] = a[4] * b[1] + a[5] * b[3] + b[5];
+    memcpy( out, r, sizeof(r) );
+}
+
+BOOL matrix_invert( const float *m, float *out )
+{
+    float det = m[0] * m[3] - m[1] * m[2], r[6];
+
+    if (fabsf( det ) < 1e-12f) return FALSE;
+    r[0] = m[3] / det;
+    r[1] = -m[1] / det;
+    r[2] = -m[2] / det;
+    r[3] = m[0] / det;
+    r[4] = (m[2] * m[5] - m[3] * m[4]) / det;
+    r[5] = (m[1] * m[4] - m[0] * m[5]) / det;
+    memcpy( out, r, sizeof(r) );
+    return TRUE;
+}
+
+static void mat_translate( float *m, float x, float y )
+{
+    float t[6] = { 1, 0, 0, 1, x, y };
+    matrix_multiply( m, t, m );
+}
+
+static void mat_scale( float *m, float sx, float sy )
+{
+    float s[6] = { sx, 0, 0, sy, 0, 0 };
+    matrix_multiply( m, s, m );
+}
+
+static void mat_rotate( float *m, double degrees )
+{
+    double a = degrees * 3.14159265358979323846 / 180;
+    float r[6] = { cos( a ), sin( a ), -sin( a ), cos( a ), 0, 0 };
+    matrix_multiply( m, r, m );
+}
+
+/* the transform's matrix; FALSE if object isn't one of ours */
+BOOL transform_matrix( IInspectable *object, float *m )
+{
+    struct media *impl = media_from_object( object );
+    float skew[6];
+
+    mat_identity( m );
+    if (!impl || impl->kind > MEDIA_MATRIX) return FALSE;
+    switch (impl->kind)
+    {
+    case MEDIA_TRANSLATE:
+        mat_translate( m, impl->x, impl->y );
+        break;
+    case MEDIA_SCALE:
+        mat_translate( m, -impl->center_x, -impl->center_y );
+        mat_scale( m, impl->scale_x, impl->scale_y );
+        mat_translate( m, impl->center_x, impl->center_y );
+        break;
+    case MEDIA_ROTATE:
+        mat_translate( m, -impl->center_x, -impl->center_y );
+        mat_rotate( m, impl->angle );
+        mat_translate( m, impl->center_x, impl->center_y );
+        break;
+    case MEDIA_COMPOSITE:
+        /* scale, skew, rotate about the centre, then translate */
+        mat_translate( m, -impl->center_x, -impl->center_y );
+        mat_scale( m, impl->scale_x, impl->scale_y );
+        skew[0] = 1; skew[1] = tan( impl->skew_y * 3.14159265358979323846 / 180 );
+        skew[2] = tan( impl->skew_x * 3.14159265358979323846 / 180 ); skew[3] = 1; skew[4] = skew[5] = 0;
+        matrix_multiply( m, skew, m );
+        mat_rotate( m, impl->angle );
+        mat_translate( m, impl->center_x + impl->x, impl->center_y + impl->y );
+        break;
+    case MEDIA_MATRIX:
+        m[0] = impl->matrix.M11; m[1] = impl->matrix.M12; m[2] = impl->matrix.M21; m[3] = impl->matrix.M22;
+        m[4] = impl->matrix.OffsetX; m[5] = impl->matrix.OffsetY;
+        break;
+    default:
+        break;
+    }
+    return TRUE;
+}
+
+/* ---- gradients ---- */
+
+BOOL brush_get_gradient( IBrush *brush, struct gradient_info *info )
+{
+    struct media *impl = media_from_object( (IInspectable *)brush ), *stop;
+    UINT32 i, count;
+
+    if (!impl || impl->kind != MEDIA_LINEAR_GRADIENT) return FALSE;
+    memset( info, 0, sizeof(*info) );
+    count = impl->stops ? vector_size( impl->stops ) : 0;
+    for (i = 0; i < count && info->count < ARRAY_SIZE(info->stops); i++)
+    {
+        if (!(stop = media_from_object( vector_get( impl->stops, i ) ))) continue;
+        info->stops[info->count].offset = stop->offset;
+        info->stops[info->count].color = stop->color;
+        info->count++;
+    }
+    info->start = impl->start;
+    info->end = impl->end;
+    info->relative = impl->mapping == BrushMappingMode_RelativeToBoundingBox;
+    info->spread = impl->spread == GradientSpreadMethod_Reflect ? 2 : impl->spread == GradientSpreadMethod_Repeat ? 1 : 0;
+    info->opacity = max( 0.0, min( 1.0, impl->opacity ) );
+    return info->count > 0;
+}
+
+/* ---- properties by name, for markup and animations ---- */
+
+static BOOL parse_numbers( const WCHAR *str, double *v, int count )
+{
+    WCHAR *end;
+    int n = 0;
+
+    while (str && *str && n < count)
+    {
+        while (*str == ' ' || *str == ',') str++;
+        v[n] = wcstod( str, &end );
+        if (end == str) return FALSE;
+        str = end;
+        n++;
+    }
+    return n == count;
+}
+
+static double *double_field( struct media *impl, const WCHAR *name )
+{
+    if (!wcscmp( name, L"CenterX" ) && (impl->kind == MEDIA_SCALE || impl->kind == MEDIA_ROTATE || impl->kind == MEDIA_COMPOSITE)) return &impl->center_x;
+    if (!wcscmp( name, L"CenterY" ) && (impl->kind == MEDIA_SCALE || impl->kind == MEDIA_ROTATE || impl->kind == MEDIA_COMPOSITE)) return &impl->center_y;
+    if (!wcscmp( name, L"ScaleX" ) && (impl->kind == MEDIA_SCALE || impl->kind == MEDIA_COMPOSITE)) return &impl->scale_x;
+    if (!wcscmp( name, L"ScaleY" ) && (impl->kind == MEDIA_SCALE || impl->kind == MEDIA_COMPOSITE)) return &impl->scale_y;
+    if ((!wcscmp( name, L"Angle" ) && impl->kind == MEDIA_ROTATE) || (!wcscmp( name, L"Rotation" ) && impl->kind == MEDIA_COMPOSITE)) return &impl->angle;
+    if (impl->kind == MEDIA_COMPOSITE && !wcscmp( name, L"SkewX" )) return &impl->skew_x;
+    if (impl->kind == MEDIA_COMPOSITE && !wcscmp( name, L"SkewY" )) return &impl->skew_y;
+    if ((impl->kind == MEDIA_TRANSLATE && !wcscmp( name, L"X" )) || (impl->kind == MEDIA_COMPOSITE && !wcscmp( name, L"TranslateX" ))) return &impl->x;
+    if ((impl->kind == MEDIA_TRANSLATE && !wcscmp( name, L"Y" )) || (impl->kind == MEDIA_COMPOSITE && !wcscmp( name, L"TranslateY" ))) return &impl->y;
+    if (impl->kind == MEDIA_GRADIENT_STOP && !wcscmp( name, L"Offset" )) return &impl->offset;
+    if (impl->kind == MEDIA_LINEAR_GRADIENT && !wcscmp( name, L"Opacity" )) return &impl->opacity;
+    return NULL;
+}
+
+BOOL media_set_property( IInspectable *object, const WCHAR *name, const WCHAR *str, const double *number, const Color *color )
+{
+    struct media *impl = media_from_object( object );
+    double v[6], *field;
+
+    if (!impl) return FALSE;
+    if ((field = double_field( impl, name )))
+    {
+        if (number) *field = *number;
+        else if (str && parse_numbers( str, v, 1 )) *field = v[0];
+        else return FALSE;
+    }
+    else if (impl->kind == MEDIA_GRADIENT_STOP && !wcscmp( name, L"Color" ) && color) impl->color = *color;
+    else if (impl->kind == MEDIA_LINEAR_GRADIENT && (!wcscmp( name, L"StartPoint" ) || !wcscmp( name, L"EndPoint" )) &&
+             str && parse_numbers( str, v, 2 ))
+    {
+        Point *p = name[0] == 'S' ? &impl->start : &impl->end;
+        p->X = v[0];
+        p->Y = v[1];
+    }
+    else if (impl->kind == MEDIA_LINEAR_GRADIENT && !wcscmp( name, L"MappingMode" ) && str)
+        impl->mapping = !wcscmp( str, L"Absolute" ) ? BrushMappingMode_Absolute : BrushMappingMode_RelativeToBoundingBox;
+    else if (impl->kind == MEDIA_LINEAR_GRADIENT && !wcscmp( name, L"SpreadMethod" ) && str)
+        impl->spread = !wcscmp( str, L"Reflect" ) ? GradientSpreadMethod_Reflect : !wcscmp( str, L"Repeat" ) ? GradientSpreadMethod_Repeat : GradientSpreadMethod_Pad;
+    else if (impl->kind == MEDIA_MATRIX && !wcscmp( name, L"Matrix" ) && str && parse_numbers( str, v, 6 ))
+    {
+        impl->matrix.M11 = v[0]; impl->matrix.M12 = v[1]; impl->matrix.M21 = v[2];
+        impl->matrix.M22 = v[3]; impl->matrix.OffsetX = v[4]; impl->matrix.OffsetY = v[5];
+    }
+    else return FALSE;
+    window_invalidate();
+    return TRUE;
+}
+
+/* 1 for a number, 2 for a colour, 0 if not ours */
+int media_get_property( IInspectable *object, const WCHAR *name, double *number, Color *color )
+{
+    struct media *impl = media_from_object( object );
+    double *field;
+
+    if (!impl) return 0;
+    if ((field = double_field( impl, name ))) { *number = *field; return 1; }
+    if (impl->kind == MEDIA_GRADIENT_STOP && !wcscmp( name, L"Color" )) { *color = impl->color; return 2; }
+    return 0;
+}
+
+IInspectable *media_collection( IInspectable *object, const WCHAR *name )
+{
+    struct media *impl = media_from_object( object );
+    return impl && impl->kind == MEDIA_LINEAR_GRADIENT && !wcscmp( name, L"GradientStops" ) ? impl->stops : NULL;
+}
+
+/* ---- the non-delegating IInspectable ---- */
+
+static inline struct media *impl_from_inner( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct media, IInspectable_inner );
+}
+
+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct media *impl = impl_from_inner( iface );
+    BOOL transform = impl->kind <= MEDIA_MATRIX;
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = &impl->IInspectable_inner;
+    else if (transform && IsEqualGUID( iid, &IID_IGeneralTransform )) *out = &impl->IGeneralTransform_iface;
+    else if (transform && IsEqualGUID( iid, &IID_ITransform )) *out = &impl->ITransform_iface;
+    else if (impl->kind == MEDIA_TRANSLATE && IsEqualGUID( iid, &IID_ITranslateTransform )) *out = &impl->ITranslateTransform_iface;
+    else if (impl->kind == MEDIA_SCALE && IsEqualGUID( iid, &IID_IScaleTransform )) *out = &impl->IScaleTransform_iface;
+    else if (impl->kind == MEDIA_ROTATE && IsEqualGUID( iid, &IID_IRotateTransform )) *out = &impl->IRotateTransform_iface;
+    else if (impl->kind == MEDIA_COMPOSITE && IsEqualGUID( iid, &IID_ICompositeTransform )) *out = &impl->ICompositeTransform_iface;
+    else if (impl->kind == MEDIA_MATRIX && IsEqualGUID( iid, &IID_IMatrixTransform )) *out = &impl->IMatrixTransform_iface;
+    else if (impl->kind == MEDIA_LINEAR_GRADIENT && IsEqualGUID( iid, &IID_IBrush )) *out = &impl->IBrush_iface;
+    else if (impl->kind == MEDIA_LINEAR_GRADIENT && IsEqualGUID( iid, &IID_IGradientBrush )) *out = &impl->IGradientBrush_iface;
+    else if (impl->kind == MEDIA_LINEAR_GRADIENT && IsEqualGUID( iid, &IID_ILinearGradientBrush )) *out = &impl->ILinearGradientBrush_iface;
+    else if (impl->kind == MEDIA_GRADIENT_STOP && IsEqualGUID( iid, &IID_IGradientStop )) *out = &impl->IGradientStop_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_inner( iface )->ref );
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct media *impl = impl_from_inner( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->stops)
+        {
+            vector_detach( impl->stops );
+            IInspectable_Release( impl->stops );
+        }
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI inner_GetIids( IInspectable *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI inner_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    static const WCHAR *names[] =
+    {
+        RuntimeClass_Windows_UI_Xaml_Media_TranslateTransform,
+        RuntimeClass_Windows_UI_Xaml_Media_ScaleTransform,
+        RuntimeClass_Windows_UI_Xaml_Media_RotateTransform,
+        RuntimeClass_Windows_UI_Xaml_Media_CompositeTransform,
+        RuntimeClass_Windows_UI_Xaml_Media_MatrixTransform,
+        RuntimeClass_Windows_UI_Xaml_Media_LinearGradientBrush,
+        RuntimeClass_Windows_UI_Xaml_Media_GradientStop,
+    };
+    const WCHAR *str = names[impl_from_inner( iface )->kind];
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI inner_GetTrustLevel( IInspectable *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static const IInspectableVtbl inner_vtbl =
+{
+    inner_QueryInterface,
+    inner_AddRef,
+    inner_Release,
+    inner_GetIids,
+    inner_GetRuntimeClassName,
+    inner_GetTrustLevel,
+};
+
+#define PROPERTY( prefix, Iface, name, field, type ) \
+static HRESULT WINAPI prefix##_get_##name( Iface *iface, type *value ) \
+{ \
+    *value = impl_from_##Iface( iface )->field; \
+    return S_OK; \
+} \
+static HRESULT WINAPI prefix##_put_##name( Iface *iface, type value ) \
+{ \
+    impl_from_##Iface( iface )->field = value; \
+    window_invalidate(); \
+    return S_OK; \
+}
+
+/* IGeneralTransform */
+
+DEFINE_IINSPECTABLE( general_transform, IGeneralTransform, struct media, IInspectable_inner )
+
+static HRESULT WINAPI general_transform_get_Inverse( IGeneralTransform *iface, IGeneralTransform **value )
+{
+    struct media *impl = impl_from_IGeneralTransform( iface ), *inverse;
+    float m[6];
+
+    *value = NULL;
+    transform_matrix( (IInspectable *)iface, m );
+    if (!matrix_invert( m, m )) return E_FAIL;
+    if (!(inverse = calloc( 1, sizeof(*inverse) ))) return E_OUTOFMEMORY;
+    *inverse = *impl;
+    inverse->ref = 1;
+    inverse->kind = MEDIA_MATRIX;
+    inverse->stops = NULL;
+    inverse->matrix.M11 = m[0]; inverse->matrix.M12 = m[1]; inverse->matrix.M21 = m[2]; inverse->matrix.M22 = m[3];
+    inverse->matrix.OffsetX = m[4]; inverse->matrix.OffsetY = m[5];
+    *value = &inverse->IGeneralTransform_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI general_transform_TransformPoint( IGeneralTransform *iface, Point point, Point *value )
+{
+    float m[6];
+    transform_matrix( (IInspectable *)iface, m );
+    value->X = point.X * m[0] + point.Y * m[2] + m[4];
+    value->Y = point.X * m[1] + point.Y * m[3] + m[5];
+    return S_OK;
+}
+
+static HRESULT WINAPI general_transform_TryTransform( IGeneralTransform *iface, Point in, Point *out, boolean *value )
+{
+    *value = TRUE;
+    return general_transform_TransformPoint( iface, in, out );
+}
+
+static HRESULT WINAPI general_transform_TransformBounds( IGeneralTransform *iface, Rect rect, Rect *value )
+{
+    Point corners[4] = { { rect.X, rect.Y }, { rect.X + rect.Width, rect.Y }, { rect.X, rect.Y + rect.Height },
+                         { rect.X + rect.Width, rect.Y + rect.Height } }, p;
+    float l = INFINITY, t = INFINITY, r = -INFINITY, b = -INFINITY;
+    int i;
+
+    for (i = 0; i < 4; i++)
+    {
+        general_transform_TransformPoint( iface, corners[i], &p );
+        l = min( l, p.X ); t = min( t, p.Y ); r = max( r, p.X ); b = max( b, p.Y );
+    }
+    value->X = l; value->Y = t; value->Width = r - l; value->Height = b - t;
+    return S_OK;
+}
+
+static const struct IGeneralTransformVtbl general_transform_vtbl =
+{
+    general_transform_QueryInterface, general_transform_AddRef, general_transform_Release,
+    general_transform_GetIids, general_transform_GetRuntimeClassName, general_transform_GetTrustLevel,
+    general_transform_get_Inverse, general_transform_TransformPoint, general_transform_TryTransform,
+    general_transform_TransformBounds,
+};
