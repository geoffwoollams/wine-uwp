+/* the element's RenderTransform about its RenderTransformOrigin, in window coordinates; FALSE for none */
+static BOOL element_matrix( struct xaml_element *element, float *m )
+{
+    float ox = element->bounds.x + element->render_transform_origin.X * element->bounds.width;
+    float oy = element->bounds.y + element->render_transform_origin.Y * element->bounds.height;
+    float t[6] = { 1, 0, 0, 1, -ox, -oy }, back[6] = { 1, 0, 0, 1, ox, oy }, r[6];
+
+    if (!element->render_transform || !transform_matrix( element->render_transform, r )) return FALSE;
+    matrix_multiply( t, r, m );
+    matrix_multiply( m, back, m );
+    return TRUE;
+}
