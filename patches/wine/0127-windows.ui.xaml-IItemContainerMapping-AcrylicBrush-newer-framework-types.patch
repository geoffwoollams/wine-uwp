--- a/dlls/windows.ui.xaml/brush.c
+++ b/dlls/windows.ui.xaml/brush.c
@@ -265,6 +265,7 @@ BOOL brush_get_color( IBrush *brush, Color *color )
         color->A = (BYTE)(color->A * gradient.opacity);
