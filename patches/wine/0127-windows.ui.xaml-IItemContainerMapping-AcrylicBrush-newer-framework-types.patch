+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct acrylic_brush *impl = impl_from_IInspectable( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = &impl->IInspectable_inner;
+    else if (IsEqualGUID( iid, &IID_IAcrylicBrush ))
+        *out = &impl->IAcrylicBrush_iface;
+    else if (IsEqualGUID( iid, &IID_IAcrylicBrush2 ))
+        *out = &impl->IAcrylicBrush2_iface;
+    else if (IsEqualGUID( iid, &IID_IXamlCompositionBrushBase ))
+        *out = &impl->IXamlCompositionBrushBase_iface;
+    else if (IsEqualGUID( iid, &IID_IBrush ))
+        *out = &impl->IBrush_iface;
+    else if (IsEqualGUID( iid, &IID_IDependencyObject ))
+        *out = &impl->IDependencyObject_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IInspectable( iface )->ref );
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct acrylic_brush *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        dp_store_free( &impl->IDependencyObject_iface );
+        if (impl->luminosity) IReference_DOUBLE_Release( impl->luminosity );
+        free( impl );
+    }
+    return ref;
+}
