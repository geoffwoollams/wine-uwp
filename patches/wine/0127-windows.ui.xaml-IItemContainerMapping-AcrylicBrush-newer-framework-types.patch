+/* markup: the brush's colours and numbers */
+BOOL acrylic_set_markup( IInspectable *target, const WCHAR *name, const Color *color, const double *number,
+                         const boolean *flag )
+{
+    IXamlCompositionBrushBase *base;
+    struct acrylic_brush *impl;
+    BOOL done = TRUE;
+
+    if (!target || FAILED(IInspectable_QueryInterface( target, &IID_IXamlCompositionBrushBase, (void **)&base )))
+        return FALSE;
+    if (base->lpVtbl != &composition_base_vtbl)
+    {
+        IXamlCompositionBrushBase_Release( base );
+        return FALSE;
+    }
+    impl = CONTAINING_RECORD( base, struct acrylic_brush, IXamlCompositionBrushBase_iface );
+    if (!wcscmp( name, L"FallbackColor" ) && color) impl->fallback = *color;
+    else if (!wcscmp( name, L"TintColor" ) && color) impl->tint = *color;
+    else if (!wcscmp( name, L"TintOpacity" ) && number) impl->tint_opacity = *number;
+    else if (!wcscmp( name, L"Opacity" ) && number) impl->opacity = *number;
+    else if (!wcscmp( name, L"AlwaysUseFallback" ) && flag) impl->always_fallback = *flag;
+    else if (!wcscmp( name, L"BackgroundSource" ) && number) impl->source = *number;
+    else done = FALSE;
+    IXamlCompositionBrushBase_Release( base );
+    if (done) window_invalidate();
+    return done;
+}
