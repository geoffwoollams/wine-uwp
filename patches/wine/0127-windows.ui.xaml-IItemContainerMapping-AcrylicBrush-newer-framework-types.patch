+static HRESULT acrylic_create( IInspectable *outer, IInspectable **inner, IAcrylicBrush **value )
+{
+    struct acrylic_brush *impl;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (inner) *inner = NULL;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_inner.lpVtbl = &inner_vtbl;
+    impl->IAcrylicBrush_iface.lpVtbl = &acrylic_vtbl;
+    impl->IAcrylicBrush2_iface.lpVtbl = &acrylic2_vtbl;
+    impl->IXamlCompositionBrushBase_iface.lpVtbl = &composition_base_vtbl;
+    impl->IBrush_iface.lpVtbl = &acrylic_brush_vtbl;
+    impl->IDependencyObject_iface.lpVtbl = &acrylic_do_vtbl;
+    impl->ref = 1;
+    impl->opacity = 1.0;
+    impl->source = AcrylicBackgroundSource_Backdrop;
+    impl->outer = outer ? outer : &impl->IInspectable_inner;
+    *value = &impl->IAcrylicBrush_iface;
+    if (outer)
+    {
+        *inner = &impl->IInspectable_inner;
+        IInspectable_AddRef( outer );
+    }
+    TRACE( "created %p, outer %p.\n", impl, outer );
+    return S_OK;
+}
