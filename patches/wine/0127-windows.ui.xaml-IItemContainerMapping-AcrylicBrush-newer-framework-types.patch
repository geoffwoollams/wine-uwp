+/* An AcrylicBrush (a XamlCompositionBrushBase) is drawn the way Windows draws it with transparency effects off or
+ * AlwaysUseFallback set: as its FallbackColor, at the brush's Opacity. Its acrylic properties (tint, tint opacity,
+ * luminosity, background source) are kept for the app but not drawn: there is no blur of what lies behind. */
+
+struct acrylic_brush
+{
+    IInspectable IInspectable_inner;
+    IAcrylicBrush IAcrylicBrush_iface;
+    IAcrylicBrush2 IAcrylicBrush2_iface;
+    IXamlCompositionBrushBase IXamlCompositionBrushBase_iface;
+    IBrush IBrush_iface;
+    IDependencyObject IDependencyObject_iface;
+    IInspectable *outer;
+    LONG ref;
+    Color fallback, tint;
+    double tint_opacity, opacity;
+    IReference_DOUBLE *luminosity;
+    AcrylicBackgroundSource source;
+    TimeSpan tint_transition;
+    boolean always_fallback;
+};
+
+static const struct IXamlCompositionBrushBaseVtbl composition_base_vtbl;
+
+static inline struct acrylic_brush *impl_from_IInspectable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct acrylic_brush, IInspectable_inner );
+}
+
+/* the colour an AcrylicBrush draws with, for brush_get_color */
+BOOL acrylic_get_color( IBrush *brush, Color *color )
+{
+    IXamlCompositionBrushBase *base;
+    struct acrylic_brush *impl;
+
+    if (FAILED(IBrush_QueryInterface( brush, &IID_IXamlCompositionBrushBase, (void **)&base ))) return FALSE;
+    if (base->lpVtbl != &composition_base_vtbl)
+    {
+        IXamlCompositionBrushBase_Release( base );
+        return FALSE;
+    }
+    impl = CONTAINING_RECORD( base, struct acrylic_brush, IXamlCompositionBrushBase_iface );
+    *color = impl->fallback;
+    color->A = (BYTE)(color->A * max( 0.0, min( 1.0, impl->opacity ) ));
+    IXamlCompositionBrushBase_Release( base );
+    return TRUE;
+}
