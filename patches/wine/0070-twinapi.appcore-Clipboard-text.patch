+/* ===== Clipboard statics ===== */
+
+struct clipboard_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IClipboardStatics IClipboardStatics_iface;
+    LONG ref;
+};
+
+static inline struct clipboard_statics *impl_from_IActivationFactory(IActivationFactory *iface)
+{ return CONTAINING_RECORD(iface, struct clipboard_statics, IActivationFactory_iface); }
+
+static HRESULT WINAPI factory_QueryInterface(IActivationFactory *iface, REFIID iid, void **out)
+{
+    struct clipboard_statics *impl = impl_from_IActivationFactory(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID(iid, &IID_IClipboardStatics))
+        *out = &impl->IClipboardStatics_iface;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef((IInspectable *)*out);
+    return S_OK;
+}
+static ULONG WINAPI factory_AddRef(IActivationFactory *iface) { return InterlockedIncrement(&impl_from_IActivationFactory(iface)->ref); }
+static ULONG WINAPI factory_Release(IActivationFactory *iface) { return InterlockedDecrement(&impl_from_IActivationFactory(iface)->ref); }
+static HRESULT WINAPI factory_GetIids(IActivationFactory *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName(IActivationFactory *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel(IActivationFactory *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance(IActivationFactory *iface, IInspectable **instance) { return E_NOTIMPL; }
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IClipboardStatics, struct clipboard_statics, IActivationFactory_iface );
+
+static HRESULT WINAPI statics_GetContent(IClipboardStatics *iface, IDataPackageView **result)
+{
+    struct package_view *view;
+
+    TRACE("iface %p, result %p.\n", iface, result);
+    if (!result) return E_POINTER;
+    if (!(view = calloc(1, sizeof(*view)))) return E_OUTOFMEMORY;
+    view->IDataPackageView_iface.lpVtbl = &view_vtbl;
+    view->ref = 1;
+    *result = &view->IDataPackageView_iface;
+    return S_OK;
+}
+static HRESULT WINAPI statics_SetContent(IClipboardStatics *iface, IDataPackage *content)
+{
+    FIXME("iface %p, content %p stub!\n", iface, content);
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI statics_Flush(IClipboardStatics *iface) { return S_OK; }
+static HRESULT WINAPI statics_Clear(IClipboardStatics *iface)
+{
+    TRACE("iface %p.\n", iface);
+    if (!OpenClipboard(NULL)) return HRESULT_FROM_WIN32(GetLastError());
+    EmptyClipboard();
+    CloseClipboard();
+    return S_OK;
+}
+static HRESULT WINAPI statics_add_ContentChanged(IClipboardStatics *iface, IEventHandler_IInspectable *handler, EventRegistrationToken *token)
+{
+    FIXME("iface %p, handler %p, token %p: handler is kept but never raised.\n", iface, handler, token);
+    if (!handler || !token) return E_POINTER;
+    token->value = 0x636c;
+    return S_OK;
+}
+static HRESULT WINAPI statics_remove_ContentChanged(IClipboardStatics *iface, EventRegistrationToken token)
+{
+    TRACE("iface %p, token %#I64x.\n", iface, token.value);
+    return S_OK;
+}
+static const IClipboardStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_GetContent, statics_SetContent, statics_Flush, statics_Clear,
+    statics_add_ContentChanged, statics_remove_ContentChanged,
+};
+
+static struct clipboard_statics clipboard_statics = { {&factory_vtbl}, {&statics_vtbl}, 1 };
+
+IActivationFactory *clipboard_factory = &clipboard_statics.IActivationFactory_iface;
diff --git a/dlls/twinapi.appcore/main.c b/dlls/twinapi.appcore/main.c
