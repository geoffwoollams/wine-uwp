+{
+    TRACE("iface %p, operation %p.\n", iface, operation);
+    return text_op_create(operation);
+}
+static HRESULT WINAPI view_GetCustomTextAsync(IDataPackageView *iface, HSTRING format_id, IAsyncOperation_HSTRING **operation)
+{
+    if (!wcscmp(WindowsGetStringRawBuffer(format_id, NULL), text_format)) return text_op_create(operation);
+    FIXME("iface %p, format_id %s, operation %p stub!\n", iface, debugstr_hstring(format_id), operation);
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI view_GetUriAsync(IDataPackageView *iface, IAsyncOperation_Uri **operation)
