+static const IDataPackageViewVtbl view_vtbl =
+{
+    view_QueryInterface, view_AddRef, view_Release,
+    view_GetIids, view_GetRuntimeClassName, view_GetTrustLevel,
+    view_get_Properties, view_get_RequestedOperation, view_ReportOperationCompleted,
+    view_get_AvailableFormats, view_Contains, view_GetDataAsync, view_GetTextAsync, view_GetCustomTextAsync,
