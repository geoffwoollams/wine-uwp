+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* The XAML Window wraps the view's CoreWindow. Content is drawn with GDI into the CoreWindow's HWND, which is
+ * subclassed for WM_PAINT; everything else goes on to twinapi.appcore's window procedure. */
+
+struct xaml_window
+{
+    IWindow IWindow_iface;
+    LONG ref;
+    ICoreWindow *core_window;
+    HWND hwnd;
+    WNDPROC old_proc;
+    IUIElement *content;
+    struct event_list activated, closed, size_changed, visibility_changed;
+};
+
+static struct xaml_window *current_window;
+
+static inline struct xaml_window *impl_from_IWindow( IWindow *iface )
+{
+    return CONTAINING_RECORD( iface, struct xaml_window, IWindow_iface );
+}
+
+/* View pixels to physical pixels, like twinapi.appcore's WINE_CORE_SCALE. */
+static float view_scale(void)
+{
+    WCHAR buf[32];
+    double scale;
+
+    if (GetEnvironmentVariableW( L"WINE_CORE_SCALE", buf, ARRAY_SIZE(buf) ) && (scale = wcstod( buf, NULL )) >= 1.0)
+        return scale;
+    return 1.0f;
+}
+
+void window_invalidate(void)
+{
+    if (current_window && current_window->hwnd) InvalidateRect( current_window->hwnd, NULL, FALSE );
+}
+
+static void window_paint( struct xaml_window *window )
+{
+    BOOL dark = application_theme() == ApplicationTheme_Dark;
+    struct xaml_element *element;
+    struct layout_context ctx;
+    PAINTSTRUCT ps;
+    HBITMAP bitmap, old;
+    HBRUSH background;
+    RECT client;
+    HDC hdc, mem;
+
+    hdc = BeginPaint( window->hwnd, &ps );
+    GetClientRect( window->hwnd, &client );
+    mem = CreateCompatibleDC( hdc );
+    bitmap = CreateCompatibleBitmap( hdc, max( 1, client.right ), max( 1, client.bottom ) );
+    old = SelectObject( mem, bitmap );
+
+    background = CreateSolidBrush( dark ? RGB(0, 0, 0) : RGB(255, 255, 255) );
+    FillRect( mem, &client, background );
+    DeleteObject( background );
+
+    if (window->content && (element = element_from_iinspectable( (IInspectable *)window->content )))
+    {
+        ctx.hdc = mem;
+        ctx.scale = view_scale();
+        ctx.foreground = dark ? RGB(255, 255, 255) : RGB(0, 0, 0);
+        element_layout_and_render( element, &ctx, &client );
+    }
+
+    BitBlt( hdc, 0, 0, client.right, client.bottom, mem, 0, 0, SRCCOPY );
+    SelectObject( mem, old );
+    DeleteObject( bitmap );
+    DeleteDC( mem );
+    EndPaint( window->hwnd, &ps );
+}
+
+static LRESULT CALLBACK window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct xaml_window *window = current_window;
+
+    if (!window || window->hwnd != hwnd) return DefWindowProcW( hwnd, msg, wparam, lparam );
+
+    switch (msg)
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+        window_paint( window );
+        return 0;
+    case WM_SIZE:
+        InvalidateRect( hwnd, NULL, FALSE );
+        break;
+    }
+    return CallWindowProcW( window->old_proc, hwnd, msg, wparam, lparam );
+}
+
+static BOOL CALLBACK find_core_hwnd( HWND hwnd, LPARAM lparam )
+{
+    WCHAR name[32];
+
+    if (GetClassNameW( hwnd, name, ARRAY_SIZE(name) ) && !wcscmp( name, L"WineCoreWindow" ))
+    {
+        *(HWND *)lparam = hwnd;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static HRESULT WINAPI window_QueryInterface( IWindow *iface, REFIID iid, void **out )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IWindow ))
+    {
+        *out = &impl->IWindow_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI window_AddRef( IWindow *iface )
+{
+    return InterlockedIncrement( &impl_from_IWindow( iface )->ref );
+}
+
+static ULONG WINAPI window_Release( IWindow *iface )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->hwnd && impl->old_proc && IsWindow( impl->hwnd ))
+            SetWindowLongPtrW( impl->hwnd, GWLP_WNDPROC, (LONG_PTR)impl->old_proc );
+        if (impl->content) IUIElement_Release( impl->content );
+        event_list_clear( &impl->activated );
+        event_list_clear( &impl->closed );
+        event_list_clear( &impl->size_changed );
+        event_list_clear( &impl->visibility_changed );
+        ICoreWindow_Release( impl->core_window );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI window_GetIids( IWindow *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI window_GetRuntimeClassName( IWindow *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Xaml_Window;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI window_GetTrustLevel( IWindow *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_Bounds( IWindow *iface, Rect *value )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+    float scale = view_scale();
+    RECT client = {0};
+
+    if (impl->hwnd) GetClientRect( impl->hwnd, &client );
+    value->X = 0;
+    value->Y = 0;
+    value->Width = client.right / scale;
+    value->Height = client.bottom / scale;
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_Visible( IWindow *iface, boolean *value )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+    *value = impl->hwnd && IsWindowVisible( impl->hwnd );
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_Content( IWindow *iface, IUIElement **value )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+    if ((*value = impl->content)) IUIElement_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI window_put_Content( IWindow *iface, IUIElement *value )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (value) IUIElement_AddRef( value );
+    if (impl->content) IUIElement_Release( impl->content );
+    impl->content = value;
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_CoreWindow( IWindow *iface, ICoreWindow **value )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+    *value = impl->core_window;
+    ICoreWindow_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI window_get_Dispatcher( IWindow *iface, ICoreDispatcher **value )
+{
+    return ICoreWindow_get_Dispatcher( impl_from_IWindow( iface )->core_window, value );
+}
+
+static HRESULT WINAPI window_add_Activated( IWindow *iface, IWindowActivatedEventHandler *handler, EventRegistrationToken *token )
+{
+    FIXME( "iface %p, handler %p: handler is kept but never raised.\n", iface, handler );
+    return event_list_add( &impl_from_IWindow( iface )->activated, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI window_remove_Activated( IWindow *iface, EventRegistrationToken token )
+{
+    return event_list_remove( &impl_from_IWindow( iface )->activated, token );
+}
+
+static HRESULT WINAPI window_add_Closed( IWindow *iface, IWindowClosedEventHandler *handler, EventRegistrationToken *token )
+{
+    FIXME( "iface %p, handler %p: handler is kept but never raised.\n", iface, handler );
+    return event_list_add( &impl_from_IWindow( iface )->closed, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI window_remove_Closed( IWindow *iface, EventRegistrationToken token )
+{
+    return event_list_remove( &impl_from_IWindow( iface )->closed, token );
+}
+
+static HRESULT WINAPI window_add_SizeChanged( IWindow *iface, IWindowSizeChangedEventHandler *handler, EventRegistrationToken *token )
+{
+    FIXME( "iface %p, handler %p: handler is kept but never raised.\n", iface, handler );
+    return event_list_add( &impl_from_IWindow( iface )->size_changed, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI window_remove_SizeChanged( IWindow *iface, EventRegistrationToken token )
+{
+    return event_list_remove( &impl_from_IWindow( iface )->size_changed, token );
+}
+
+static HRESULT WINAPI window_add_VisibilityChanged( IWindow *iface, IWindowVisibilityChangedEventHandler *handler, EventRegistrationToken *token )
+{
+    FIXME( "iface %p, handler %p: handler is kept but never raised.\n", iface, handler );
+    return event_list_add( &impl_from_IWindow( iface )->visibility_changed, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI window_remove_VisibilityChanged( IWindow *iface, EventRegistrationToken token )
+{
+    return event_list_remove( &impl_from_IWindow( iface )->visibility_changed, token );
+}
+
+static HRESULT WINAPI window_Activate( IWindow *iface )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p.\n", iface );
+
+    hr = ICoreWindow_Activate( impl->core_window );
+    if (impl->hwnd)
+    {
+        InvalidateRect( impl->hwnd, NULL, FALSE );
+        UpdateWindow( impl->hwnd );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI window_Close( IWindow *iface )
+{
+    struct xaml_window *impl = impl_from_IWindow( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    if (impl->hwnd) PostMessageW( impl->hwnd, WM_CLOSE, 0, 0 );
+    return S_OK;
+}
+
+
+static const struct IWindowVtbl window_vtbl =
+{
+    window_QueryInterface,
+    window_AddRef,
+    window_Release,
+    /* IInspectable methods */
+    window_GetIids,
+    window_GetRuntimeClassName,
+    window_GetTrustLevel,
+    /* IWindow methods */
+    window_get_Bounds,
+    window_get_Visible,
+    window_get_Content,
+    window_put_Content,
+    window_get_CoreWindow,
+    window_get_Dispatcher,
+    window_add_Activated,
+    window_remove_Activated,
+    window_add_Closed,
+    window_remove_Closed,
+    window_add_SizeChanged,
+    window_remove_SizeChanged,
+    window_add_VisibilityChanged,
+    window_remove_VisibilityChanged,
+    window_Activate,
+    window_Close
+};
+
+
+HRESULT window_create_for_core_window( ICoreWindow *core_window )
+{
+    struct xaml_window *impl;
+
+    if (current_window) return S_OK;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IWindow_iface.lpVtbl = &window_vtbl;
+    impl->ref = 1;
+    impl->core_window = core_window;
+    ICoreWindow_AddRef( core_window );
+
+    EnumThreadWindows( GetCurrentThreadId(), find_core_hwnd, (LPARAM)&impl->hwnd );
+    if (impl->hwnd)
+        impl->old_proc = (WNDPROC)SetWindowLongPtrW( impl->hwnd, GWLP_WNDPROC, (LONG_PTR)window_proc );
+    else
+        ERR( "CoreWindow %p has no HWND on this thread; nothing will be drawn.\n", core_window );
+
+    TRACE( "window %p, hwnd %p.\n", impl, impl->hwnd );
+    current_window = impl;
+    return S_OK;
+}
+
+void window_destroy_current(void)
+{
+    struct xaml_window *window = current_window;
+
+    if (!window) return;
+    current_window = NULL;
+    IWindow_Release( &window->IWindow_iface );
+}
+
+/* activation factory and Window.Current */
+
+struct window_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IWindowStatics IWindowStatics_iface;
+    LONG ref;
+};
+
+static inline struct window_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct window_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct window_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IWindowStatics ))
+        *out = &impl->IWindowStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    FIXME( "iface %p, instance %p: Window is not activatable.\n", iface, instance );
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( window_statics, IWindowStatics, struct window_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI window_statics_get_Current( IWindowStatics *iface, IWindow **value )
+{
+    TRACE( "iface %p, value %p -> %p.\n", iface, value, current_window );
+
+    if ((*value = current_window ? &current_window->IWindow_iface : NULL)) IWindow_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IWindowStaticsVtbl window_statics_vtbl =
+{
+    window_statics_QueryInterface,
+    window_statics_AddRef,
+    window_statics_Release,
+    /* IInspectable methods */
+    window_statics_GetIids,
+    window_statics_GetRuntimeClassName,
+    window_statics_GetTrustLevel,
+    /* IWindowStatics methods */
+    window_statics_get_Current,
+};
+
+static struct window_statics window_statics =
+{
+    {&factory_vtbl},
+    {&window_statics_vtbl},
+    1,
+};
+
+IActivationFactory *window_factory = &window_statics.IActivationFactory_iface;
