+static HRESULT application_create( IInspectable *outer, IInspectable **inner, IApplication **value )
+{
+    struct application *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IApplication_iface.lpVtbl = &application_vtbl;
+    impl->IApplicationOverrides_iface.lpVtbl = &overrides_vtbl;
+    impl->IInspectable_inner.lpVtbl = &inner_vtbl;
+    impl->outer = outer ? outer : &impl->IInspectable_inner;
+    impl->ref = 1;
+    impl->theme = ApplicationTheme_Light;
+
+    if (current_app) FIXME( "an Application already exists, replacing %p.\n", current_app );
+    current_app = impl;
+    if (current_app_ref) IInspectable_Release( current_app_ref );
+    current_app_ref = impl->outer;
+    IInspectable_AddRef( current_app_ref );
+
+    if (outer)
+    {
+        *inner = &impl->IInspectable_inner;  /* owns our reference */
+        *value = &impl->IApplication_iface;
+        IApplication_AddRef( *value );       /* counted on the outer object */
+    }
+    else
+    {
+        if (inner) *inner = NULL;
+        *value = &impl->IApplication_iface;  /* owns our reference */
+    }
+    TRACE( "created %p, outer %p.\n", impl, outer );
+    return S_OK;
+}
