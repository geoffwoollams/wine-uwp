+/* Colour of a brush for drawing; only solid colour brushes are supported. Opacity scales alpha. */
+BOOL brush_get_color( IBrush *brush, Color *color )
+{
+    ISolidColorBrush *solid;
+    DOUBLE opacity = 1.0;
+
+    if (FAILED(IBrush_QueryInterface( brush, &IID_ISolidColorBrush, (void **)&solid )))
+    {
+        FIXME( "brush %p is not a SolidColorBrush.\n", brush );
+        return FALSE;
+    }
+    ISolidColorBrush_get_Color( solid, color );
+    ISolidColorBrush_Release( solid );
+    IBrush_get_Opacity( brush, &opacity );
+    color->A = (BYTE)(color->A * max( 0.0, min( 1.0, opacity ) ));
+    return TRUE;
+}
