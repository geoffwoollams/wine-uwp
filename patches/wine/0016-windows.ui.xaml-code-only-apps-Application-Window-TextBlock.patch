+
+/* the FrameworkView given to CoreApplication.Run */
+
+struct framework_view
+{
+    IFrameworkView IFrameworkView_iface;
+    LONG ref;
+    IApplicationInitializationCallback *callback;
+    ICoreApplicationView *view;
+    EventRegistrationToken activated_token;
+    ICoreWindow *core_window;
+};
+
+static inline struct framework_view *impl_from_IFrameworkView( IFrameworkView *iface )
+{
+    return CONTAINING_RECORD( iface, struct framework_view, IFrameworkView_iface );
+}
+
+static HRESULT WINAPI view_QueryInterface( IFrameworkView *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IFrameworkView ))
+    {
+        *out = iface;
+        IFrameworkView_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI view_AddRef( IFrameworkView *iface )
+{
+    return InterlockedIncrement( &impl_from_IFrameworkView( iface )->ref );
+}
+
+static ULONG WINAPI view_Release( IFrameworkView *iface )
+{
+    struct framework_view *impl = impl_from_IFrameworkView( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->callback) IApplicationInitializationCallback_Release( impl->callback );
+        if (impl->view) ICoreApplicationView_Release( impl->view );
+        if (impl->core_window) ICoreWindow_Release( impl->core_window );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI view_GetIids( IFrameworkView *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI view_GetRuntimeClassName( IFrameworkView *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI view_GetTrustLevel( IFrameworkView *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI view_Initialize( IFrameworkView *iface, ICoreApplicationView *view )
+{
+    struct framework_view *impl = impl_from_IFrameworkView( iface );
+    struct activated_handler *handler;
+    struct init_params *params;
+    HRESULT hr;
+
+    TRACE( "iface %p, view %p.\n", iface, view );
+
+    impl->view = view;
+    ICoreApplicationView_AddRef( view );
+
+    if (!(handler = calloc( 1, sizeof(*handler) ))) return E_OUTOFMEMORY;
+    handler->iface.lpVtbl = &activated_vtbl;
+    handler->ref = 1;
+    hr = ICoreApplicationView_add_Activated( view, &handler->iface, &impl->activated_token );
+    ITypedEventHandler_CoreApplicationView_IActivatedEventArgs_Release( &handler->iface );
+    if (FAILED(hr)) return hr;
+
+    /* the app creates its Application object in this callback */
+    if (!(params = calloc( 1, sizeof(*params) ))) return E_OUTOFMEMORY;
+    params->iface.lpVtbl = &params_vtbl;
+    params->ref = 1;
+    TRACE( "calling the ApplicationInitializationCallback.\n" );
+    hr = IApplicationInitializationCallback_Invoke( impl->callback, &params->iface );
+    IApplicationInitializationCallbackParams_Release( &params->iface );
+    if (FAILED(hr)) ERR( "ApplicationInitializationCallback failed, hr %#lx.\n", hr );
+    if (!current_app) ERR( "the callback did not create an Application.\n" );
+    return hr;
+}
+
+static HRESULT WINAPI view_SetWindow( IFrameworkView *iface, ICoreWindow *window )
+{
+    struct framework_view *impl = impl_from_IFrameworkView( iface );
+
+    TRACE( "iface %p, window %p.\n", iface, window );
+
+    impl->core_window = window;
+    ICoreWindow_AddRef( window );
+    return window_create_for_core_window( window );
+}
+
+static HRESULT WINAPI view_Load( IFrameworkView *iface, HSTRING entry_point )
+{
+    TRACE( "iface %p, entry_point %s.\n", iface, debugstr_hstring(entry_point) );
+    return S_OK;
+}
+
+static HRESULT WINAPI view_Run( IFrameworkView *iface )
+{
+    struct framework_view *impl = impl_from_IFrameworkView( iface );
+    ICoreDispatcher *dispatcher;
+    HRESULT hr;
+
+    TRACE( "iface %p.\n", iface );
+
+    if (FAILED(hr = ICoreWindow_get_Dispatcher( impl->core_window, &dispatcher ))) return hr;
+    hr = ICoreDispatcher_ProcessEvents( dispatcher, CoreProcessEventsOption_ProcessUntilQuit );
+    ICoreDispatcher_Release( dispatcher );
+    TRACE( "message loop ended, hr %#lx.\n", hr );
+    return hr;
+}
+
+static HRESULT WINAPI view_Uninitialize( IFrameworkView *iface )
+{
+    struct framework_view *impl = impl_from_IFrameworkView( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    if (impl->view) ICoreApplicationView_remove_Activated( impl->view, impl->activated_token );
+    window_destroy_current();
+    if (current_app_ref)
+    {
+        IInspectable *app = current_app_ref;
