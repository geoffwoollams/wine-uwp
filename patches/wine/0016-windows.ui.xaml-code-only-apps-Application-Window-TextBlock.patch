+HRESULT event_list_add( struct event_list *list, IUnknown *handler, EventRegistrationToken *token )
+{
+    IUnknown **handlers;
+    UINT32 i;
+
+    if (!handler || !token) return E_INVALIDARG;
+    for (i = 0; i < list->count; i++) if (!list->handlers[i]) break;
+    if (i == list->count)
+    {
+        if (!(handlers = realloc( list->handlers, (list->count + 1) * sizeof(*handlers) ))) return E_OUTOFMEMORY;
+        list->handlers = handlers;
+        list->count++;
+    }
+    list->handlers[i] = handler;
+    IUnknown_AddRef( handler );
+    token->value = i + 1;
+    return S_OK;
+}
+
+HRESULT event_list_remove( struct event_list *list, EventRegistrationToken token )
+{
+    UINT64 i = token.value - 1;
+
+    if (token.value < 1 || i >= list->count || !list->handlers[i]) return S_OK;
+    IUnknown_Release( list->handlers[i] );
+    list->handlers[i] = NULL;
+    return S_OK;
+}
+
+void event_list_clear( struct event_list *list )
+{
+    UINT32 i;
+
+    for (i = 0; i < list->count; i++) if (list->handlers[i]) IUnknown_Release( list->handlers[i] );
+    free( list->handlers );
+    list->handlers = NULL;
+    list->count = 0;
+}
