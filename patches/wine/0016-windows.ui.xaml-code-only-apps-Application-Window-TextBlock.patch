+    return E_NOTIMPL;
+}
+
+static const struct ITextBlockVtbl text_block_iface_vtbl =
+{
+    text_block_iface_QueryInterface,
+    text_block_iface_AddRef,
+    text_block_iface_Release,
+    /* IInspectable methods */
+    text_block_iface_GetIids,
+    text_block_iface_GetRuntimeClassName,
+    text_block_iface_GetTrustLevel,
+    /* ITextBlock methods */
+    text_block_iface_get_FontSize,
+    text_block_iface_put_FontSize,
+    text_block_iface_get_FontFamily,
+    text_block_iface_put_FontFamily,
+    text_block_iface_get_FontWeight,
+    text_block_iface_put_FontWeight,
+    text_block_iface_get_FontStyle,
+    text_block_iface_put_FontStyle,
+    text_block_iface_get_FontStretch,
+    text_block_iface_put_FontStretch,
+    text_block_iface_get_CharacterSpacing,
+    text_block_iface_put_CharacterSpacing,
+    text_block_iface_get_Foreground,
+    text_block_iface_put_Foreground,
+    text_block_iface_get_TextWrapping,
+    text_block_iface_put_TextWrapping,
+    text_block_iface_get_TextTrimming,
+    text_block_iface_put_TextTrimming,
+    text_block_iface_get_TextAlignment,
+    text_block_iface_put_TextAlignment,
+    text_block_iface_get_Text,
+    text_block_iface_put_Text,
+    text_block_iface_get_Inlines,
+    text_block_iface_get_Padding,
+    text_block_iface_put_Padding,
+    text_block_iface_get_LineHeight,
+    text_block_iface_put_LineHeight,
