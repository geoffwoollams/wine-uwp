+/* the CoreApplicationView Activated handler: raises OnLaunched / OnActivated on the app */
+
+struct activated_handler
+{
+    ITypedEventHandler_CoreApplicationView_IActivatedEventArgs iface;
+    LONG ref;
+};
+
+static HRESULT WINAPI activated_QueryInterface( ITypedEventHandler_CoreApplicationView_IActivatedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITypedEventHandler_CoreApplicationView_IActivatedEventArgs ))
+    {
+        *out = iface;
+        ITypedEventHandler_CoreApplicationView_IActivatedEventArgs_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI activated_AddRef( ITypedEventHandler_CoreApplicationView_IActivatedEventArgs *iface )
+{
+    return InterlockedIncrement( &CONTAINING_RECORD( iface, struct activated_handler, iface )->ref );
+}
+
+static ULONG WINAPI activated_Release( ITypedEventHandler_CoreApplicationView_IActivatedEventArgs *iface )
+{
+    struct activated_handler *impl = CONTAINING_RECORD( iface, struct activated_handler, iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI activated_Invoke( ITypedEventHandler_CoreApplicationView_IActivatedEventArgs *iface,
+                                        ICoreApplicationView *sender, IActivatedEventArgs *args )
+{
+    IApplicationOverrides *overrides = application_get_overrides();
+    ILaunchActivatedEventArgs *launch;
+    HRESULT hr;
+
+    TRACE( "iface %p, sender %p, args %p.\n", iface, sender, args );
+
+    if (!overrides)
+    {
+        WARN( "no Application object, ignoring activation.\n" );
+        return S_OK;
+    }
+    if (SUCCEEDED(IActivatedEventArgs_QueryInterface( args, &IID_ILaunchActivatedEventArgs, (void **)&launch )))
+    {
+        TRACE( "OnLaunched\n" );
+        hr = IApplicationOverrides_OnLaunched( overrides, launch );
+        ILaunchActivatedEventArgs_Release( launch );
+    }
+    else
+    {
+        TRACE( "OnActivated\n" );
+        hr = IApplicationOverrides_OnActivated( overrides, args );
+    }
+    IApplicationOverrides_Release( overrides );
+    if (FAILED(hr)) ERR( "activation handler failed, hr %#lx.\n", hr );
+    return S_OK;
+}
+
+static const struct ITypedEventHandler_CoreApplicationView_IActivatedEventArgsVtbl activated_vtbl =
+{
+    activated_QueryInterface,
+    activated_AddRef,
+    activated_Release,
+    activated_Invoke,
+};
