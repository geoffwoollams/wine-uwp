+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+static struct text_block_statics text_block_statics =
+{
+    {&factory_vtbl},
+    1,
+};
+
+IActivationFactory *text_block_factory = &text_block_statics.IActivationFactory_iface;
