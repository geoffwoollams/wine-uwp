+void element_init( struct xaml_element *element, const struct element_ops *ops, const WCHAR *class_name )
+{
+    element->IUIElement_iface.lpVtbl = &uielement_vtbl;
+    element->IFrameworkElement_iface.lpVtbl = &framework_element_vtbl;
+    element->IDependencyObject_iface.lpVtbl = &element_dependency_object_vtbl;
+    element->ref = 1;
+    element->ops = ops;
+    element->class_name = class_name;
+    element->width = element->height = NAN;
+    element->horizontal_alignment = HorizontalAlignment_Stretch;
+    element->vertical_alignment = VerticalAlignment_Stretch;
+    element->visibility = Visibility_Visible;
+    element->opacity = 1.0;
+}
+
+/* Measure the element, then place it inside bounds (physical pixels) by its margin, size and alignment. */
+void element_layout_and_render( struct xaml_element *element, struct layout_context *ctx, const RECT *bounds )
+{
+    float scale = ctx->scale, avail_w, avail_h, w, h, x, y;
+    const Thickness *m = &element->margin;
+    RECT rect;
+
+    if (element->visibility != Visibility_Visible) return;
+
+    avail_w = max( 0.0f, (bounds->right - bounds->left) / scale - m->Left - m->Right );
+    avail_h = max( 0.0f, (bounds->bottom - bounds->top) / scale - m->Top - m->Bottom );
+    if (!isnan( element->width )) avail_w = min( avail_w, element->width );
+    if (!isnan( element->height )) avail_h = min( avail_h, element->height );
+    element->ops->measure( element, ctx, avail_w, avail_h, &w, &h );
+    if (!isnan( element->width )) w = element->width;
+    else if (element->horizontal_alignment == HorizontalAlignment_Stretch) w = avail_w;
+    if (!isnan( element->height )) h = element->height;
+    else if (element->vertical_alignment == VerticalAlignment_Stretch) h = avail_h;
+    w = min( w, avail_w );
+    h = min( h, avail_h );
+
+    switch (element->horizontal_alignment)
+    {
+    case HorizontalAlignment_Center: x = m->Left + (avail_w - w) / 2; break;
+    case HorizontalAlignment_Right: x = m->Left + avail_w - w; break;
+    default: x = m->Left; break;
+    }
+    switch (element->vertical_alignment)
+    {
+    case VerticalAlignment_Center: y = m->Top + (avail_h - h) / 2; break;
+    case VerticalAlignment_Bottom: y = m->Top + avail_h - h; break;
+    default: y = m->Top; break;
+    }
+
+    rect.left = bounds->left + lroundf( x * scale );
+    rect.top = bounds->top + lroundf( y * scale );
+    rect.right = rect.left + lroundf( w * scale );
+    rect.bottom = rect.top + lroundf( h * scale );
+    TRACE( "%s at %s.\n", debugstr_w(element->class_name), wine_dbgstr_rect(&rect) );
+    element->ops->render( element, ctx, &rect );
+}
