+static HRESULT text_block_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct text_block *impl = impl_from_element( element );
+
+    if (IsEqualGUID( iid, &IID_ITextBlock ))
+    {
+        *out = &impl->ITextBlock_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static HFONT text_block_create_font( struct text_block *impl, float scale )
+{
+    LOGFONTW lf = {0};
+
+    lf.lfHeight = -lround( impl->font_size * scale );
+    lf.lfWeight = impl->font_weight.Weight ? impl->font_weight.Weight : FW_NORMAL;
+    lf.lfItalic = impl->font_style != FontStyle_Normal;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    lf.lfQuality = ANTIALIASED_QUALITY;
+    wcscpy( lf.lfFaceName, L"Segoe UI" );  /* XAML's default; GDI substitutes when it isn't installed */
+    return CreateFontIndirectW( &lf );
+}
+
+static UINT text_block_draw_flags( struct text_block *impl )
+{
+    UINT flags = DT_NOPREFIX;
+
+    if (impl->wrapping != TextWrapping_NoWrap) flags |= DT_WORDBREAK;
+    else flags |= DT_SINGLELINE;
+    switch (impl->alignment)
+    {
+    case TextAlignment_Center: flags |= DT_CENTER; break;
+    case TextAlignment_Right: flags |= DT_RIGHT; break;
+    default: flags |= DT_LEFT; break;
+    }
+    return flags;
+}
+
+static void text_block_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                                float avail_height, float *width, float *height )
+{
+    struct text_block *impl = impl_from_element( element );
+    const Thickness *p = &impl->padding;
+    UINT32 len;
+    const WCHAR *text = WindowsGetStringRawBuffer( impl->text, &len );
+    RECT rect = { 0, 0, lroundf( max( 0.0f, avail_width - p->Left - p->Right ) * ctx->scale ), 0 };
+    HFONT font = text_block_create_font( impl, ctx->scale ), old;
+
+    old = SelectObject( ctx->hdc, font );
+    if (len) DrawTextW( ctx->hdc, text, len, &rect, text_block_draw_flags( impl ) | DT_CALCRECT );
+    else
+    {
+        TEXTMETRICW tm;
+        GetTextMetricsW( ctx->hdc, &tm );
+        rect.right = 0;
+        rect.bottom = tm.tmHeight;
+    }
+    SelectObject( ctx->hdc, old );
+    DeleteObject( font );
+
+    *width = rect.right / ctx->scale + p->Left + p->Right;
+    *height = rect.bottom / ctx->scale + p->Top + p->Bottom;
+}
+
+static void text_block_render( struct xaml_element *element, struct layout_context *ctx, const RECT *bounds )
+{
+    struct text_block *impl = impl_from_element( element );
+    const Thickness *p = &impl->padding;
+    COLORREF color = ctx->foreground;
+    UINT32 len;
+    const WCHAR *text = WindowsGetStringRawBuffer( impl->text, &len );
+    RECT rect = *bounds;
+    HFONT font, old;
+    Color c;
+
+    if (!len) return;
+    if (impl->foreground)
+    {
+        if (!brush_get_color( impl->foreground, &c ) || !c.A) return;
+        color = RGB( c.R, c.G, c.B );
+    }
+    rect.left += lround( p->Left * ctx->scale );
+    rect.top += lround( p->Top * ctx->scale );
+    rect.right -= lround( p->Right * ctx->scale );
+    rect.bottom -= lround( p->Bottom * ctx->scale );
+
+    font = text_block_create_font( impl, ctx->scale );
+    old = SelectObject( ctx->hdc, font );
+    SetTextColor( ctx->hdc, color );
+    SetBkMode( ctx->hdc, TRANSPARENT );
+    DrawTextW( ctx->hdc, text, len, &rect, text_block_draw_flags( impl ) | DT_NOCLIP );
+    SelectObject( ctx->hdc, old );
+    DeleteObject( font );
+}
+
+static void text_block_destroy( struct xaml_element *element )
+{
+    struct text_block *impl = impl_from_element( element );
+
+    WindowsDeleteString( impl->text );
+    if (impl->foreground) IBrush_Release( impl->foreground );
+    free( impl );
+}
+
+static const struct element_ops text_block_ops =
+{
+    text_block_query_interface,
+    text_block_measure,
+    text_block_render,
+    text_block_destroy,
+};
+
+static HRESULT text_block_create( IInspectable **out )
+{
+    struct text_block *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &text_block_ops, RuntimeClass_Windows_UI_Xaml_Controls_TextBlock );
+    impl->ITextBlock_iface.lpVtbl = &text_block_iface_vtbl;
+    impl->font_size = 14.0;
+    impl->font_weight.Weight = 400;
+    impl->font_style = FontStyle_Normal;
+    impl->wrapping = TextWrapping_NoWrap;
+    impl->alignment = TextAlignment_Left;
+
+    *out = (IInspectable *)&impl->ITextBlock_iface;
+    TRACE( "created %p.\n", *out );
+    return S_OK;
+}
+
+/* activation factory */
+
+struct text_block_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    LONG ref;
+};
+
+static inline struct text_block_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct text_block_statics, IActivationFactory_iface );
+}
