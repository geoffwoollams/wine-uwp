+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* Every element shares this IUIElement/IFrameworkElement/IDependencyObject implementation; the class adds its own
+ * interfaces through ops->query_interface. Milestone 1 only has a single content element per window, so layout is
+ * "measure, then align inside the window". */
+
+static inline struct xaml_element *impl_from_IUIElement( IUIElement *iface )
+{
+    return CONTAINING_RECORD( iface, struct xaml_element, IUIElement_iface );
+}
+
+static const IUIElementVtbl uielement_vtbl;
+
+struct xaml_element *element_from_iinspectable( IInspectable *object )
+{
+    IUIElement *uielement;
+    struct xaml_element *element;
+
+    if (!object || FAILED(IInspectable_QueryInterface( object, &IID_IUIElement, (void **)&uielement ))) return NULL;
+    element = uielement->lpVtbl == &uielement_vtbl ? impl_from_IUIElement( uielement ) : NULL;
+    IUIElement_Release( uielement );
+    if (!element) FIXME( "element %p is not one of ours.\n", object );
+    return element;
+}
+
+static HRESULT WINAPI uielement_QueryInterface( IUIElement *iface, REFIID iid, void **out )
+{
+    struct xaml_element *impl = impl_from_IUIElement( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IUIElement ))
+        *out = &impl->IUIElement_iface;
+    else if (IsEqualGUID( iid, &IID_IFrameworkElement ))
+        *out = &impl->IFrameworkElement_iface;
+    else if (IsEqualGUID( iid, &IID_IDependencyObject ))
+        *out = &impl->IDependencyObject_iface;
+    else if (impl->ops->query_interface && SUCCEEDED(impl->ops->query_interface( impl, iid, out )))
+        return S_OK;
+    else
+    {
+        FIXME( "%s %s not implemented, returning E_NOINTERFACE.\n", debugstr_w(impl->class_name), debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI uielement_AddRef( IUIElement *iface )
+{
+    struct xaml_element *impl = impl_from_IUIElement( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI uielement_Release( IUIElement *iface )
+{
+    struct xaml_element *impl = impl_from_IUIElement( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->name );
+        impl->ops->destroy( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI uielement_GetIids( IUIElement *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI uielement_GetRuntimeClassName( IUIElement *iface, HSTRING *class_name )
+{
+    struct xaml_element *impl = impl_from_IUIElement( iface );
+    return WindowsCreateString( impl->class_name, wcslen( impl->class_name ), class_name );
+}
