+/* Application.Start runs CoreApplication.Run with the view below. The app's own App class derives from
+ * Application, so it is created by aggregation (IApplicationFactory::CreateInstance with an outer object), and
+ * its overrides (OnLaunched, ...) are found by querying the outer object for IApplicationOverrides. */
+
+struct application
+{
+    IApplication IApplication_iface;
+    IApplicationOverrides IApplicationOverrides_iface;
+    IInspectable IInspectable_inner;  /* non-delegating */
+    IInspectable *outer;              /* the app's object, or our own inner interface */
+    LONG ref;
+    ApplicationTheme theme;
+    struct event_list suspending, resuming, unhandled_exception;
+};
+
+static struct application *current_app;
+static IInspectable *current_app_ref;   /* keeps the app object alive while it runs, like Windows does */
+
+ApplicationTheme application_theme(void)
+{
+    return current_app ? current_app->theme : ApplicationTheme_Light;
+}
+
+IApplicationOverrides *application_get_overrides(void)
+{
+    IApplicationOverrides *overrides;
+
+    if (!current_app) return NULL;
+    if (FAILED(IInspectable_QueryInterface( current_app->outer, &IID_IApplicationOverrides, (void **)&overrides )))
+        return NULL;
+    return overrides;
+}
+
+/* non-delegating IInspectable */
+
+static inline struct application *impl_from_inner( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct application, IInspectable_inner );
+}
+
+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct application *impl = impl_from_inner( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ))
+        *out = &impl->IInspectable_inner;
+    else if (IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IApplication ))
+        *out = &impl->IApplication_iface;
+    else if (IsEqualGUID( iid, &IID_IApplicationOverrides ))
+        *out = &impl->IApplicationOverrides_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    struct application *impl = impl_from_inner( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct application *impl = impl_from_inner( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (current_app == impl) current_app = NULL;
+        event_list_clear( &impl->suspending );
+        event_list_clear( &impl->resuming );
+        event_list_clear( &impl->unhandled_exception );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI inner_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI inner_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Xaml_Application;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI inner_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const struct IInspectableVtbl inner_vtbl =
+{
+    inner_QueryInterface,
+    inner_AddRef,
+    inner_Release,
+    /* IInspectable methods */
+    inner_GetIids,
+    inner_GetRuntimeClassName,
+    inner_GetTrustLevel,
+};
