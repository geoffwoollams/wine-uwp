+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI pnp_CreateWatcherAqsFilter( IPnpObjectStatics *iface, PnpObjectType type, IIterable_HSTRING *properties,
+                                                  HSTRING filter, IPnpObjectWatcher **value )
+{
+    FIXME( "iface %p, type %d, properties %p, filter %s stub!\n", iface, type, properties, debugstr_hstring(filter) );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IPnpObjectStaticsVtbl pnp_vtbl =
+{
