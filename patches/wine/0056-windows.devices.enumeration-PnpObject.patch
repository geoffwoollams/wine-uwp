+    pnp_GetTrustLevel,
+    /* IPnpObjectStatics methods */
+    pnp_CreateFromIdAsync,
+    pnp_FindAllAsync,
+    pnp_FindAllAsyncAqsFilter,
+    pnp_CreateWatcher,
+    pnp_CreateWatcherAqsFilter,
+};
+
+static struct pnp_statics pnp_statics = { {&factory_vtbl}, {&pnp_vtbl} };
+IActivationFactory *pnp_object_factory = &pnp_statics.IActivationFactory_iface;
