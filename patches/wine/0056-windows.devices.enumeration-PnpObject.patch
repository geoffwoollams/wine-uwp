+/* PnpObject's statics. Unity asks for monitors and other device objects through FindAllAsync; Wine's device
+ * properties don't map to PnpObject's property names yet, so the searches find nothing (an empty collection), and
+ * CreateFromIdAsync and watchers aren't supported. */
+
+struct pnp_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IPnpObjectStatics IPnpObjectStatics_iface;
+};
+
+static inline struct pnp_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct pnp_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct pnp_statics *impl = impl_from_IActivationFactory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IPnpObjectStatics ))
+        *out = &impl->IPnpObjectStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( pnp, IPnpObjectStatics, struct pnp_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI pnp_CreateFromIdAsync( IPnpObjectStatics *iface, PnpObjectType type, HSTRING id,
+                                             IIterable_HSTRING *properties, IAsyncOperation_PnpObject **value )
+{
+    FIXME( "iface %p, type %d, id %s, properties %p stub!\n", iface, type, debugstr_hstring(id), properties );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+/* an empty PnpObjectCollection */
+static HRESULT find_all_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    static const struct vector_iids iids =
+    {
+        .vector = &IID_IVector_IInspectable,
+        .view = &IID_IVectorView_PnpObject,
+        .iterable = &IID_IIterable_PnpObject,
+        .iterator = &IID_IIterator_PnpObject,
+    };
+    IVector_IInspectable *vector;
+    IInspectable *view;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+    if (FAILED(hr = vector_create( &iids, (void **)&vector ))) return hr;
+    hr = IVector_IInspectable_GetView( vector, (void *)&view );
+    IVector_IInspectable_Release( vector );
+    if (FAILED(hr)) return hr;
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)view;
+    return S_OK;
+}
+
+static HRESULT WINAPI pnp_FindAllAsyncAqsFilter( IPnpObjectStatics *iface, PnpObjectType type, IIterable_HSTRING *properties,
+                                                 HSTRING filter, IAsyncOperation_PnpObjectCollection **value )
+{
+    FIXME( "iface %p, type %d, properties %p, filter %s: no objects are found.\n", iface, type, properties, debugstr_hstring(filter) );
+    return async_operation_inspectable_create( &IID_IAsyncOperation_PnpObjectCollection, (IUnknown *)iface, NULL,
+                                               find_all_async, (IAsyncOperation_IInspectable **)value );
+}
+
+static HRESULT WINAPI pnp_FindAllAsync( IPnpObjectStatics *iface, PnpObjectType type, IIterable_HSTRING *properties,
+                                        IAsyncOperation_PnpObjectCollection **value )
+{
+    return pnp_FindAllAsyncAqsFilter( iface, type, properties, NULL, value );
+}
+
+static HRESULT WINAPI pnp_CreateWatcher( IPnpObjectStatics *iface, PnpObjectType type, IIterable_HSTRING *properties,
+                                         IPnpObjectWatcher **value )
+{
+    FIXME( "iface %p, type %d, properties %p stub!\n", iface, type, properties );
