+#include "private.h"
+#include "psapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* MemoryManager tells an app how much memory it uses and may use. On a PC nothing caps a UWP app below what the
+ * machine has, so the limit is the physical memory; usage is the process's private commit (PagefileUsage, which
+ * Windows also reports as PrivateUsage), as on Windows. The
+ * usage-change events are accepted and never raised, and the limit can't be changed. Forza Motorsport 7's hardware
+ * check reads it. */
+
+static UINT64 usage_limit(void)
+{
+    MEMORYSTATUSEX status = { sizeof(status) };
+
+    if (!GlobalMemoryStatusEx( &status )) return 0;
+    return status.ullTotalPhys;
+}
+
+static void process_counters( PROCESS_MEMORY_COUNTERS *counters )
+{
+    memset( counters, 0, sizeof(*counters) );
+    counters->cb = sizeof(*counters);
+    if (!K32GetProcessMemoryInfo( GetCurrentProcess(), counters, sizeof(*counters) ))
+        WARN( "K32GetProcessMemoryInfo failed, error %lu.\n", GetLastError() );
+}
+
+/* ---- AppMemoryReport and ProcessMemoryReport (snapshots) ---- */
+
+struct memory_report
+{
+    IAppMemoryReport IAppMemoryReport_iface;
+    IProcessMemoryReport IProcessMemoryReport_iface;
+    LONG ref;
+    PROCESS_MEMORY_COUNTERS counters;
+    UINT64 limit;
+};
+
+static struct memory_report *create_report(void)
+{
+    struct memory_report *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->ref = 1;
+    process_counters( &impl->counters );
+    impl->limit = usage_limit();
+    return impl;
+}
+
+static inline struct memory_report *impl_from_IAppMemoryReport( IAppMemoryReport *iface )
+{
+    return CONTAINING_RECORD( iface, struct memory_report, IAppMemoryReport_iface );
+}
+
+static HRESULT WINAPI app_report_QueryInterface( IAppMemoryReport *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAppMemoryReport ))
+    {
+        *out = iface;
+        IAppMemoryReport_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI app_report_AddRef( IAppMemoryReport *iface )
+{
+    return InterlockedIncrement( &impl_from_IAppMemoryReport( iface )->ref );
+}
+
+static ULONG WINAPI app_report_Release( IAppMemoryReport *iface )
+{
+    struct memory_report *impl = impl_from_IAppMemoryReport( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI app_report_GetIids( IAppMemoryReport *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI app_report_GetRuntimeClassName( IAppMemoryReport *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_System_AppMemoryReport,
+                                wcslen( RuntimeClass_Windows_System_AppMemoryReport ), name );
+}
+
+static HRESULT WINAPI app_report_GetTrustLevel( IAppMemoryReport *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI app_report_get_PrivateCommitUsage( IAppMemoryReport *iface, UINT64 *value )
+{
+    *value = impl_from_IAppMemoryReport( iface )->counters.PagefileUsage;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_report_get_PeakPrivateCommitUsage( IAppMemoryReport *iface, UINT64 *value )
+{
+    *value = impl_from_IAppMemoryReport( iface )->counters.PeakPagefileUsage;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_report_get_TotalCommitUsage( IAppMemoryReport *iface, UINT64 *value )
+{
+    *value = impl_from_IAppMemoryReport( iface )->counters.PagefileUsage;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_report_get_TotalCommitLimit( IAppMemoryReport *iface, UINT64 *value )
+{
+    *value = impl_from_IAppMemoryReport( iface )->limit;
+    return S_OK;
+}
+
+static const struct IAppMemoryReportVtbl app_report_vtbl =
+{
+    app_report_QueryInterface, app_report_AddRef, app_report_Release,
+    app_report_GetIids, app_report_GetRuntimeClassName, app_report_GetTrustLevel,
+    app_report_get_PrivateCommitUsage, app_report_get_PeakPrivateCommitUsage,
+    app_report_get_TotalCommitUsage, app_report_get_TotalCommitLimit,
+};
+
+static inline struct memory_report *impl_from_IProcessMemoryReport( IProcessMemoryReport *iface )
+{
+    return CONTAINING_RECORD( iface, struct memory_report, IProcessMemoryReport_iface );
+}
+
+static HRESULT WINAPI process_report_QueryInterface( IProcessMemoryReport *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IProcessMemoryReport ))
+    {
+        *out = iface;
+        IProcessMemoryReport_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI process_report_AddRef( IProcessMemoryReport *iface )
+{
+    return InterlockedIncrement( &impl_from_IProcessMemoryReport( iface )->ref );
+}
+
+static ULONG WINAPI process_report_Release( IProcessMemoryReport *iface )
+{
+    struct memory_report *impl = impl_from_IProcessMemoryReport( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI process_report_GetIids( IProcessMemoryReport *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI process_report_GetRuntimeClassName( IProcessMemoryReport *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_System_ProcessMemoryReport,
+                                wcslen( RuntimeClass_Windows_System_ProcessMemoryReport ), name );
+}
+
+static HRESULT WINAPI process_report_GetTrustLevel( IProcessMemoryReport *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI process_report_get_PrivateWorkingSetUsage( IProcessMemoryReport *iface, UINT64 *value )
+{
+    /* Wine doesn't split the working set into private and shared pages */
+    *value = impl_from_IProcessMemoryReport( iface )->counters.WorkingSetSize;
+    return S_OK;
+}
+
+static HRESULT WINAPI process_report_get_TotalWorkingSetUsage( IProcessMemoryReport *iface, UINT64 *value )
+{
+    *value = impl_from_IProcessMemoryReport( iface )->counters.WorkingSetSize;
+    return S_OK;
+}
+
+static const struct IProcessMemoryReportVtbl process_report_vtbl =
+{
+    process_report_QueryInterface, process_report_AddRef, process_report_Release,
+    process_report_GetIids, process_report_GetRuntimeClassName, process_report_GetTrustLevel,
+    process_report_get_PrivateWorkingSetUsage, process_report_get_TotalWorkingSetUsage,
+};
+
+/* ---- MemoryManager statics ---- */
+
+struct memory_manager
+{
+    IActivationFactory IActivationFactory_iface;
+    IMemoryManagerStatics IMemoryManagerStatics_iface;
+    IMemoryManagerStatics2 IMemoryManagerStatics2_iface;
+    IMemoryManagerStatics3 IMemoryManagerStatics3_iface;
+    IMemoryManagerStatics4 IMemoryManagerStatics4_iface;
+};
+
+static struct memory_manager memory_manager;
+static LONG next_token;
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &memory_manager.IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IMemoryManagerStatics ))
+        *out = &memory_manager.IMemoryManagerStatics_iface;
+    else if (IsEqualGUID( iid, &IID_IMemoryManagerStatics2 ))
+        *out = &memory_manager.IMemoryManagerStatics2_iface;
+    else if (IsEqualGUID( iid, &IID_IMemoryManagerStatics3 ))
+        *out = &memory_manager.IMemoryManagerStatics3_iface;
+    else if (IsEqualGUID( iid, &IID_IMemoryManagerStatics4 ))
+        *out = &memory_manager.IMemoryManagerStatics4_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IMemoryManagerStatics, struct memory_manager, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_get_AppMemoryUsage( IMemoryManagerStatics *iface, UINT64 *value )
+{
+    PROCESS_MEMORY_COUNTERS counters;
+
+    process_counters( &counters );
+    *value = counters.PagefileUsage;
+    TRACE( "iface %p -> %I64u.\n", iface, *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_get_AppMemoryUsageLimit( IMemoryManagerStatics *iface, UINT64 *value )
+{
+    *value = usage_limit();
+    TRACE( "iface %p -> %I64u.\n", iface, *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_get_AppMemoryUsageLevel( IMemoryManagerStatics *iface, AppMemoryUsageLevel *value )
+{
+    PROCESS_MEMORY_COUNTERS counters;
+    UINT64 limit = usage_limit();
+
+    process_counters( &counters );
+    if (!limit) *value = AppMemoryUsageLevel_Low;
+    else if (counters.PagefileUsage > limit) *value = AppMemoryUsageLevel_OverLimit;
+    else if (counters.PagefileUsage > limit / 10 * 8) *value = AppMemoryUsageLevel_High;
+    else if (counters.PagefileUsage > limit / 10 * 6) *value = AppMemoryUsageLevel_Medium;
+    else *value = AppMemoryUsageLevel_Low;
+    TRACE( "iface %p -> %d.\n", iface, *value );
+    return S_OK;
+}
+
+static HRESULT add_event( EventRegistrationToken *token )
+{
+    token->value = InterlockedIncrement( &next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_add_AppMemoryUsageIncreased( IMemoryManagerStatics *iface, IEventHandler_IInspectable *handler,
+                                                           EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p (never raised).\n", iface, handler );
+    return add_event( token );
+}
+
+static HRESULT WINAPI statics_remove_AppMemoryUsageIncreased( IMemoryManagerStatics *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_add_AppMemoryUsageDecreased( IMemoryManagerStatics *iface, IEventHandler_IInspectable *handler,
+                                                           EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p (never raised).\n", iface, handler );
+    return add_event( token );
+}
+
+static HRESULT WINAPI statics_remove_AppMemoryUsageDecreased( IMemoryManagerStatics *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_add_AppMemoryUsageLimitChanging( IMemoryManagerStatics *iface,
+                                                               IEventHandler_AppMemoryUsageLimitChangingEventArgs *handler,
+                                                               EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p (never raised).\n", iface, handler );
+    return add_event( token );
+}
+
+static HRESULT WINAPI statics_remove_AppMemoryUsageLimitChanging( IMemoryManagerStatics *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static const struct IMemoryManagerStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_get_AppMemoryUsage, statics_get_AppMemoryUsageLimit, statics_get_AppMemoryUsageLevel,
+    statics_add_AppMemoryUsageIncreased, statics_remove_AppMemoryUsageIncreased,
+    statics_add_AppMemoryUsageDecreased, statics_remove_AppMemoryUsageDecreased,
+    statics_add_AppMemoryUsageLimitChanging, statics_remove_AppMemoryUsageLimitChanging,
+};
+
+DEFINE_IINSPECTABLE( statics2, IMemoryManagerStatics2, struct memory_manager, IActivationFactory_iface )
+
+static HRESULT WINAPI statics2_GetAppMemoryReport( IMemoryManagerStatics2 *iface, IAppMemoryReport **value )
+{
+    struct memory_report *report;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!(report = create_report())) return E_OUTOFMEMORY;
+    report->IAppMemoryReport_iface.lpVtbl = &app_report_vtbl;
+    *value = &report->IAppMemoryReport_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics2_GetProcessMemoryReport( IMemoryManagerStatics2 *iface, IProcessMemoryReport **value )
+{
+    struct memory_report *report;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!(report = create_report())) return E_OUTOFMEMORY;
+    report->IProcessMemoryReport_iface.lpVtbl = &process_report_vtbl;
+    *value = &report->IProcessMemoryReport_iface;
+    return S_OK;
+}
+
+static const struct IMemoryManagerStatics2Vtbl statics2_vtbl =
+{
+    statics2_QueryInterface, statics2_AddRef, statics2_Release,
+    statics2_GetIids, statics2_GetRuntimeClassName, statics2_GetTrustLevel,
+    statics2_GetAppMemoryReport, statics2_GetProcessMemoryReport,
+};
+
+DEFINE_IINSPECTABLE( statics3, IMemoryManagerStatics3, struct memory_manager, IActivationFactory_iface )
+
+static HRESULT WINAPI statics3_TrySetAppMemoryUsageLimit( IMemoryManagerStatics3 *iface, UINT64 value, boolean *result )
+{
+    TRACE( "iface %p, value %I64u: the limit is fixed.\n", iface, value );
+    *result = FALSE;
+    return S_OK;
+}
+
+static const struct IMemoryManagerStatics3Vtbl statics3_vtbl =
+{
+    statics3_QueryInterface, statics3_AddRef, statics3_Release,
+    statics3_GetIids, statics3_GetRuntimeClassName, statics3_GetTrustLevel,
+    statics3_TrySetAppMemoryUsageLimit,
+};
+
+DEFINE_IINSPECTABLE( statics4, IMemoryManagerStatics4, struct memory_manager, IActivationFactory_iface )
+
+static HRESULT WINAPI statics4_get_ExpectedAppMemoryUsageLimit( IMemoryManagerStatics4 *iface, UINT64 *value )
+{
+    *value = usage_limit();
+    return S_OK;
+}
+
+static const struct IMemoryManagerStatics4Vtbl statics4_vtbl =
+{
+    statics4_QueryInterface, statics4_AddRef, statics4_Release,
+    statics4_GetIids, statics4_GetRuntimeClassName, statics4_GetTrustLevel,
+    statics4_get_ExpectedAppMemoryUsageLimit,
