+
+/* Game Mode's expanded resources (expandedresources.h, api-ms-win-gaming-expandedresources-l1-1-0; gamemode.dll on
+ * Windows): on Xbox and in Windows' Game Mode a game can be given CPU cores of its own. Wine reserves none, which is
+ * what Windows reports when Game Mode hasn't granted any. Forza Motorsport 7 imports these. */
+
+HRESULT WINAPI HasExpandedResources( BOOL *has_expanded_resources );
+HRESULT WINAPI GetExpandedResourceExclusiveCpuCount( ULONG *count );
+HRESULT WINAPI ReleaseExclusiveCpuSets( void );
+
+HRESULT WINAPI HasExpandedResources( BOOL *has_expanded_resources )
+{
+    TRACE( "%p.\n", has_expanded_resources );
+    if (!has_expanded_resources) return E_INVALIDARG;
+    *has_expanded_resources = FALSE;
+    return S_OK;
+}
+
+HRESULT WINAPI GetExpandedResourceExclusiveCpuCount( ULONG *count )
+{
+    TRACE( "%p.\n", count );
+    if (!count) return E_INVALIDARG;
+    *count = 0;
+    return S_OK;
+}
+
+HRESULT WINAPI ReleaseExclusiveCpuSets( void )
+{
+    TRACE( "\n" );
+    return S_OK;
+}
