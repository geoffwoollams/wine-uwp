+/* wine-uwp: a player without playback. It keeps its settings and event handlers, and once it has a source, Play
+ * reports the media as opened, playing and then ended at once (on a thread-pool thread, as Windows raises the events
+ * on threads of its own), so a game playing an intro video or a music track carries on instead of failing on
+ * E_NOTIMPL. Forza Motorsport 7 waits on MediaEnded. Nothing is decoded or shown. */
+
+enum player_event { EV_OPENED, EV_ENDED, EV_STATE, EV_COUNT };
+
+static HRESULT add_handler( struct media_player *impl, enum player_event ev, ITypedEventHandler_MediaPlayer_IInspectable *handler,
+                            EventRegistrationToken *token )
+{
+    UINT i;
+
+    if (!handler) return E_INVALIDARG;
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < ARRAY_SIZE(impl->handlers[ev]); i++)
+    {
+        if (impl->handlers[ev][i].handler) continue;
+        ITypedEventHandler_MediaPlayer_IInspectable_AddRef( (impl->handlers[ev][i].handler = handler) );
+        impl->handlers[ev][i].token = token->value = ++impl->next_token;
+        LeaveCriticalSection( &impl->cs );
+        return S_OK;
+    }
+    LeaveCriticalSection( &impl->cs );
+    FIXME( "too many handlers for event %d.\n", ev );
+    token->value = 0;
+    return S_OK;
+}
+
+static HRESULT remove_handler( struct media_player *impl, enum player_event ev, EventRegistrationToken token )
+{
+    ITypedEventHandler_MediaPlayer_IInspectable *handler = NULL;
+    UINT i;
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < ARRAY_SIZE(impl->handlers[ev]); i++)
+    {
+        if (!impl->handlers[ev][i].handler || impl->handlers[ev][i].token != token.value) continue;
+        handler = impl->handlers[ev][i].handler;
+        impl->handlers[ev][i].handler = NULL;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (handler) ITypedEventHandler_MediaPlayer_IInspectable_Release( handler );
+    return S_OK;
+}
+
+static void raise_event( struct media_player *impl, enum player_event ev )
+{
+    ITypedEventHandler_MediaPlayer_IInspectable *handlers[ARRAY_SIZE(impl->handlers[0])];
+    UINT i, count = 0;
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < ARRAY_SIZE(impl->handlers[ev]); i++)
+        if ((handlers[count] = impl->handlers[ev][i].handler))
+            ITypedEventHandler_MediaPlayer_IInspectable_AddRef( handlers[count++] );
+    LeaveCriticalSection( &impl->cs );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_MediaPlayer_IInspectable_Invoke( handlers[i], &impl->IMediaPlayer_iface, NULL );
+        ITypedEventHandler_MediaPlayer_IInspectable_Release( handlers[i] );
+    }
+}
+
+static void set_state( struct media_player *impl, MediaPlayerState state )
+{
+    impl->state = state;
+    raise_event( impl, EV_STATE );
+}
+
+static void CALLBACK play_callback( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct media_player *impl = context;
+
+    TRACE( "player %p: reporting the media as played.\n", impl );
+    if (impl->state == MediaPlayerState_Closed || impl->state == MediaPlayerState_Opening)
+    {
+        set_state( impl, MediaPlayerState_Opening );
+        raise_event( impl, EV_OPENED );
+    }
+    set_state( impl, MediaPlayerState_Playing );
+    /* looping media never ends */
+    if (!impl->looping)
+    {
+        raise_event( impl, EV_ENDED );
+        set_state( impl, MediaPlayerState_Paused );
+    }
+    IMediaPlayer_Release( &impl->IMediaPlayer_iface );
+}
+
+static void start_playing( struct media_player *impl )
+{
+    IMediaPlayer_AddRef( &impl->IMediaPlayer_iface );
+    if (!TrySubmitThreadpoolCallback( play_callback, impl, NULL ))
+        IMediaPlayer_Release( &impl->IMediaPlayer_iface );
+}
