+/* the file or folder at path as an IStorageItem, or NULL if there is none */
+static HRESULT item_from_path(const WCHAR *path, IStorageItem **item)
+{
+    DWORD attrs = GetFileAttributesW(path);
+    IStorageFolder *folder;
+    IStorageFile *file;
+    HRESULT hr;
+
+    *item = NULL;
+    if (attrs == INVALID_FILE_ATTRIBUTES) return S_OK;
+    if (attrs & FILE_ATTRIBUTE_DIRECTORY)
+    {
+        if (FAILED(hr = storage_folder_create(path, &folder))) return hr;
+        hr = IStorageFolder_QueryInterface(folder, &IID_IStorageItem, (void **)item);
+        IStorageFolder_Release(folder);
+    }
+    else
+    {
+        if (FAILED(hr = storage_file_create(path, &file))) return hr;
+        hr = IStorageFile_QueryInterface(file, &IID_IStorageItem, (void **)item);
+        IStorageFile_Release(file);
+    }
+    return hr;
+}
+
+/* GetItemAsync fails for a missing name, TryGetItemAsync gives a null item */
+static HRESULT get_item(struct storage_folder *impl, HSTRING name, BOOL try, void **operation)
+{
+    const GUID *iid = &IID___FIAsyncOperation_1_Windows__CStorage__CIStorageItem;
+    IStorageItem *item = NULL;
+    WCHAR path[MAX_PATH];
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    if (SUCCEEDED(hr = child_path(impl, name, path)) && SUCCEEDED(hr = item_from_path(path, &item)) && !item && !try)
+        hr = HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND);
+    if (FAILED(hr) && item)
+    {
+        IStorageItem_Release(item);
+        item = NULL;
+    }
+    return storage_operation_create(iid, hr, (IUnknown *)item, operation);
+}
+
