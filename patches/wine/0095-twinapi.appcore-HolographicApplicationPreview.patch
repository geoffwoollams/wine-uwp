diff --git a/dlls/twinapi.appcore/holographic.c b/dlls/twinapi.appcore/holographic.c
new file mode 100644
index 0000000..1173dc8
--- /dev/null
+++ b/dlls/twinapi.appcore/holographic.c
@@ -0,0 +1,98 @@
+/* WinRT Windows.ApplicationModel.Preview.Holographic.HolographicApplicationPreview (hand-declared)
+ *
+ * There is no Mixed Reality headset: the app is never shown on one, nor activated for one.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+static const GUID IID_IHolographicApplicationPreviewStatics_local =
+    { 0xfe038691, 0x2a3a, 0x45a9, { 0xa2, 0x08, 0x7b, 0xed, 0x69, 0x19, 0x19, 0xf3 } };
+
+struct holographic
+{
+    IActivationFactory IActivationFactory_iface;
+    struct { const void *const *lpVtbl; } statics;
+};
+
+static struct holographic holographic;
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s.\n", iface, debugstr_guid( iid ) );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &holographic.IActivationFactory_iface;
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IHolographicApplicationPreviewStatics_local ))
+    {
+        *out = &holographic.statics;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+static HRESULT WINAPI statics_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    return factory_QueryInterface( &holographic.IActivationFactory_iface, iid, out );
+}
+static ULONG WINAPI statics_AddRef( void *iface ) { return 2; }
+static ULONG WINAPI statics_Release( void *iface ) { return 1; }
+static HRESULT WINAPI statics_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI statics_GetRuntimeClassName( void *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI statics_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI statics_IsCurrentViewPresentedOnHolographicDisplay( void *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI statics_IsHolographicActivation( void *iface, IInspectable *args, boolean *value )
+{
+    TRACE( "iface %p, args %p, value %p.\n", iface, args, value );
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+static const void *const statics_vtbl[] =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_IsCurrentViewPresentedOnHolographicDisplay, statics_IsHolographicActivation,
+};
+
+static struct holographic holographic = { {&factory_vtbl}, {statics_vtbl} };
+
+IActivationFactory *holographic_factory = &holographic.IActivationFactory_iface;
