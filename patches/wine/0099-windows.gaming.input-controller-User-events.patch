+/* Windows.System.IUserStatics, which Wine's headers declare but don't define */
+static const GUID IID_IUserStatics = {0x155eb23b, 0x242a, 0x45e0, {0xa2, 0xe9, 0x31, 0x71, 0xfc, 0x6a, 0x7f, 0xdd}};
+typedef struct user_statics user_statics;
+struct user_statics_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( user_statics *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( user_statics *iface );
+    ULONG (WINAPI *Release)( user_statics *iface );
+    HRESULT (WINAPI *GetIids)( user_statics *iface, ULONG *count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( user_statics *iface, HSTRING *name );
+    HRESULT (WINAPI *GetTrustLevel)( user_statics *iface, TrustLevel *level );
+    HRESULT (WINAPI *CreateWatcher)( user_statics *iface, IInspectable **watcher );
+    HRESULT (WINAPI *FindAllAsync)( user_statics *iface, IInspectable **operation );
+    HRESULT (WINAPI *FindAllAsyncByType)( user_statics *iface, INT32 type, IInspectable **operation );
+    HRESULT (WINAPI *FindAllAsyncByTypeAndStatus)( user_statics *iface, INT32 type, INT32 status, IInspectable **operation );
+    HRESULT (WINAPI *GetFromId)( user_statics *iface, HSTRING id, __x_ABI_CWindows_CSystem_CIUser **user );
+};
+struct user_statics { const struct user_statics_vtbl *lpVtbl; };
+
+/* Every controller belongs to the one user signed in: the session's user, which Windows.System.User reports. Games
+ * take a controller's user for whose input it is, and C++/WinRT ones stop at once if there is none. */
 static HRESULT WINAPI controller_get_User( IGameController *iface, __x_ABI_CWindows_CSystem_CIUser **value )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    static const WCHAR name[] = L"Windows.System.User";
+    user_statics *statics;
+    HSTRING_HEADER header;
+    HSTRING str;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = WindowsCreateStringReference( name, wcslen( name ), &header, &str ))) return hr;
+    if (FAILED(hr = RoGetActivationFactory( str, &IID_IUserStatics, (void **)&statics ))) return hr;
+    hr = statics->lpVtbl->GetFromId( statics, NULL, value );
+    statics->lpVtbl->Release( statics );
+    return hr;
 }
 
