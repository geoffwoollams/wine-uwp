diff --git a/dlls/windows.ui.xaml/pri.c b/dlls/windows.ui.xaml/pri.c
new file mode 100644
index 0000000..2c12d0e
--- /dev/null
+++ b/dlls/windows.ui.xaml/pri.c
@@ -0,0 +1,380 @@
+/* Package resource index (resources.pri) reading
+ *
+ * Copyright 2026 wine-uwp contributors
+ *
