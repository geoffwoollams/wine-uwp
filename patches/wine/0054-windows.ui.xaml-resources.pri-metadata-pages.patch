diff --git a/dlls/windows.ui.xaml/xbf.c b/dlls/windows.ui.xaml/xbf.c
index 80115e5..3a069ca 100644
--- a/dlls/windows.ui.xaml/xbf.c
+++ b/dlls/windows.ui.xaml/xbf.c
@@ -5365,6 +5365,21 @@ HRESULT load_component( IInspectable *component, HSTRING uri )
         lstrcpyW( (WCHAR *)ext, L".xbf" );
         if (GetFileAttributesW( file ) == INVALID_FILE_ATTRIBUTES)
         {
+            /* compiled into resources.pri as Files/<path>.xbf */
+            WCHAR name[MAX_PATH];
+            SIZE_T pri_size;
+
+            swprintf( name, ARRAY_SIZE(name), L"Files/%s", path );
+            if ((p = wcsrchr( name, '.' ))) lstrcpyW( p, L".xbf" );
+            if ((data = pri_load_file( name, &pri_size )))
+            {
+                TRACE( "loading %s from resources.pri (%Iu bytes) into %p.\n", debugstr_w(name), pri_size, component );
+                if (FAILED(hr = xbf_parse( data, pri_size, &xbf ))) return hr;
+                hr = xbf_load( xbf, component, NULL );
+                xbf_free( xbf );
+                if (FAILED(hr)) ERR( "loading %s failed, hr %#lx.\n", debugstr_w(name), hr );
+                return hr;
+            }
             /* no compiled markup: the loose .xaml file */
             lstrcpyW( (WCHAR *)ext, L".xaml" );
             return load_text_component( component, file );
