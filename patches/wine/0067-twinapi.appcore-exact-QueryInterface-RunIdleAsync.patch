Subject: twinapi.appcore: shims answer only their own interfaces; CoreDispatcher.RunIdleAsync; trace newlines

diff --git a/dlls/twinapi.appcore/core_gen.c b/dlls/twinapi.appcore/core_gen.c
index cd1b928..11d03d6 100644
--- a/dlls/twinapi.appcore/core_gen.c
+++ b/dlls/twinapi.appcore/core_gen.c
@@ -196,9 +196,41 @@ struct dispatch_item
 {
     struct dispatch_item *next;
     IDispatchedHandler *callback;
+    IIdleDispatchedHandler *idle;    /* RunIdleAsync, instead of callback */
     struct core_action *action;
 };
 
+/* IdleDispatchedHandlerArgs: idle work runs once the queue is drained, so the dispatcher is idle */
+static HRESULT WINAPI idle_args_QueryInterface(IIdleDispatchedHandlerArgs *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IIdleDispatchedHandlerArgs))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI idle_args_AddRef(IIdleDispatchedHandlerArgs *iface) { return 2; }
+static ULONG WINAPI idle_args_Release(IIdleDispatchedHandlerArgs *iface) { return 1; }
+static HRESULT WINAPI idle_args_GetIids(IIdleDispatchedHandlerArgs *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI idle_args_GetRuntimeClassName(IIdleDispatchedHandlerArgs *iface, HSTRING *name)
+{ return WindowsCreateString(L"Windows.UI.Core.IdleDispatchedHandlerArgs", 41, name); }
+static HRESULT WINAPI idle_args_GetTrustLevel(IIdleDispatchedHandlerArgs *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI idle_args_get_IsDispatcherIdle(IIdleDispatchedHandlerArgs *iface, boolean *value)
+{
+    *value = TRUE;
+    return S_OK;
+}
+static const IIdleDispatchedHandlerArgsVtbl idle_args_vtbl =
+{
+    idle_args_QueryInterface, idle_args_AddRef, idle_args_Release,
+    idle_args_GetIids, idle_args_GetRuntimeClassName, idle_args_GetTrustLevel,
+    idle_args_get_IsDispatcherIdle,
+};
+static IIdleDispatchedHandlerArgs idle_args = { &idle_args_vtbl };
+
 static inline struct core_action *impl_from_action(IAsyncAction *iface)
 { return CONTAINING_RECORD(iface, struct core_action, IAsyncAction_iface); }
 static inline struct core_action *impl_from_actioninfo(IAsyncInfo *iface)
@@ -320,8 +352,16 @@ static void dispatcher_drain_queue(struct core_dispatcher *impl)
         if ((item = impl->queue_head) && !(impl->queue_head = item->next)) impl->queue_tail = NULL;
         LeaveCriticalSection(&impl->cs);
         if (!item) break;
-        IDispatchedHandler_Invoke(item->callback);
-        IDispatchedHandler_Release(item->callback);
+        if (item->idle)
+        {
+            IIdleDispatchedHandler_Invoke(item->idle, &idle_args);
+            IIdleDispatchedHandler_Release(item->idle);
+        }
+        else
+        {
+            IDispatchedHandler_Invoke(item->callback);
+            IDispatchedHandler_Release(item->callback);
+        }
         complete_core_action(item->action);
         IAsyncAction_Release(&item->action->IAsyncAction_iface);
         free(item);
@@ -329,6 +369,8 @@ static void dispatcher_drain_queue(struct core_dispatcher *impl)
 }
 
