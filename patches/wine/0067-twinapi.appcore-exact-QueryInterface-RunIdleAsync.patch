-    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    /* IL2CPP and .NET Native probe objects for interfaces they handle themselves; not worth a FIXME */
+    if (!IsEqualGUID(iid, &IID_probe_d4bbc1c8))
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
     *out = NULL;
     return E_NOINTERFACE;
 }
@@ -597,7 +641,7 @@ static HRESULT WINAPI core_dispatcher_RunAsync(ICoreDispatcher *iface, __x_ABI_C
     struct core_dispatcher *impl __attribute__((unused)) = impl_from_core_dispatcher(iface);
     struct dispatch_item *item;
     struct core_action *a;
-    TRACE("iface %p, priority %d, callback %p, action %p.\\n", iface, priority, callback, action);
+    TRACE("iface %p, priority %d, callback %p, action %p.\n", iface, priority, callback, action);
     if (!callback || !action) return E_POINTER;
     if (!(a = create_core_action())) return E_OUTOFMEMORY;
     if (!(item = calloc(1, sizeof(*item)))) { IAsyncAction_Release(&a->IAsyncAction_iface); return E_OUTOFMEMORY; }
@@ -616,8 +660,26 @@ static HRESULT WINAPI core_dispatcher_RunAsync(ICoreDispatcher *iface, __x_ABI_C
 
 static HRESULT WINAPI core_dispatcher_RunIdleAsync(ICoreDispatcher *iface, __x_ABI_CWindows_CUI_CCore_CIIdleDispatchedHandler *callback, __x_ABI_CWindows_CFoundation_CIAsyncAction **action)
 {
-    FIXME("iface %p stub!\n", iface);
-    return E_NOTIMPL;
+    struct core_dispatcher *impl = impl_from_core_dispatcher(iface);
+    struct dispatch_item *item;
+    struct core_action *a;
+
+    TRACE("iface %p, callback %p, action %p.\n", iface, callback, action);
+    if (!callback || !action) return E_POINTER;
+    if (!(a = create_core_action())) return E_OUTOFMEMORY;
+    if (!(item = calloc(1, sizeof(*item)))) { IAsyncAction_Release(&a->IAsyncAction_iface); return E_OUTOFMEMORY; }
+    /* queued behind normal work: it runs when the dispatcher next drains its queue */
+    item->idle = callback;
+    IIdleDispatchedHandler_AddRef(callback);
+    item->action = a;
+    IAsyncAction_AddRef(&a->IAsyncAction_iface);
+    EnterCriticalSection(&impl->cs);
+    if (impl->queue_tail) impl->queue_tail->next = item; else impl->queue_head = item;
+    impl->queue_tail = item;
+    LeaveCriticalSection(&impl->cs);
+    PostThreadMessageW(impl->thread_id, WM_NULL, 0, 0);
+    *action = &a->IAsyncAction_iface;
+    return S_OK;
 }
 
