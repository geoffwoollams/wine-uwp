+#include "private.h"
+#define WIDL_using_Windows_UI_Text
+#define WIDL_using_Windows_Globalization_Fonts
+#include "initguid.h"
+#include "windows.globalization.fonts.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(locale);
+
+/* The Western defaults of Windows 10: what apps get for Latin-script languages. Other scripts get the same
+ * families; DirectWrite's fallback picks glyphs for them. */
+struct font_info
+{
+    const WCHAR *family;
+    UINT16 weight;
+    double scale;
+};
+
+enum font_kind
+{
+    FONT_UI_TEXT, FONT_UI_HEADING, FONT_UI_TITLE, FONT_UI_CAPTION, FONT_UI_NOTIFICATION_HEADING,
+    FONT_TRADITIONAL_DOCUMENT, FONT_MODERN_DOCUMENT, FONT_DOCUMENT_HEADING, FONT_FIXED_WIDTH,
+    FONT_DOCUMENT_ALTERNATE1, FONT_DOCUMENT_ALTERNATE2, FONT_COUNT
+};
+
+static const struct font_info fonts[FONT_COUNT] =
+{
+    { L"Segoe UI", 400, 100.0 },
+    { L"Segoe UI Light", 300, 100.0 },
+    { L"Segoe UI Light", 300, 100.0 },
+    { L"Segoe UI", 400, 100.0 },
+    { L"Segoe UI", 600, 100.0 },
+    { L"Sylfaen", 400, 100.0 },
+    { L"Calibri", 400, 100.0 },
+    { L"Cambria", 400, 100.0 },
+    { L"Consolas", 400, 100.0 },
+    { L"Cambria", 400, 100.0 },
+    { L"Calibri", 400, 100.0 },
+};
+
+struct language_font
+{
+    ILanguageFont ILanguageFont_iface;
+    LONG ref;
+    const struct font_info *info;
+};
+
+static inline struct language_font *impl_from_ILanguageFont( ILanguageFont *iface )
+{
+    return CONTAINING_RECORD( iface, struct language_font, ILanguageFont_iface );
+}
+
+static HRESULT WINAPI font_QueryInterface( ILanguageFont *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ILanguageFont ))
+    {
+        ILanguageFont_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI font_AddRef( ILanguageFont *iface )
+{
+    return InterlockedIncrement( &impl_from_ILanguageFont( iface )->ref );
+}
+
+static ULONG WINAPI font_Release( ILanguageFont *iface )
+{
+    struct language_font *impl = impl_from_ILanguageFont( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI font_GetIids( ILanguageFont *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI font_GetRuntimeClassName( ILanguageFont *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Globalization.Fonts.LanguageFont";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI font_GetTrustLevel( ILanguageFont *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI font_get_FontFamily( ILanguageFont *iface, HSTRING *value )
+{
+    const struct font_info *info = impl_from_ILanguageFont( iface )->info;
+    return WindowsCreateString( info->family, wcslen( info->family ), value );
+}
+
+static HRESULT WINAPI font_get_FontWeight( ILanguageFont *iface, FontWeight *value )
+{
+    value->Weight = impl_from_ILanguageFont( iface )->info->weight;
+    return S_OK;
+}
+
+static HRESULT WINAPI font_get_FontStretch( ILanguageFont *iface, FontStretch *value )
+{
+    *value = FontStretch_Normal;
+    return S_OK;
+}
+
+static HRESULT WINAPI font_get_FontStyle( ILanguageFont *iface, FontStyle *value )
+{
+    *value = FontStyle_Normal;
+    return S_OK;
+}
+
+static HRESULT WINAPI font_get_ScaleFactor( ILanguageFont *iface, DOUBLE *value )
+{
+    *value = impl_from_ILanguageFont( iface )->info->scale;
+    return S_OK;
+}
+
+static const struct ILanguageFontVtbl font_vtbl =
+{
+    font_QueryInterface,
+    font_AddRef,
+    font_Release,
+    /* IInspectable methods */
+    font_GetIids,
+    font_GetRuntimeClassName,
+    font_GetTrustLevel,
+    /* ILanguageFont methods */
+    font_get_FontFamily,
+    font_get_FontWeight,
+    font_get_FontStretch,
+    font_get_FontStyle,
+    font_get_ScaleFactor,
+};
+
+static HRESULT font_create( enum font_kind kind, ILanguageFont **out )
+{
+    struct language_font *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ILanguageFont_iface.lpVtbl = &font_vtbl;
+    impl->ref = 1;
+    impl->info = &fonts[kind];
+    *out = &impl->ILanguageFont_iface;
+    return S_OK;
+}
+
+struct font_group
+{
+    ILanguageFontGroup ILanguageFontGroup_iface;
+    LONG ref;
+};
+
+static inline struct font_group *impl_from_ILanguageFontGroup( ILanguageFontGroup *iface )
+{
+    return CONTAINING_RECORD( iface, struct font_group, ILanguageFontGroup_iface );
+}
+
+static HRESULT WINAPI group_QueryInterface( ILanguageFontGroup *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ILanguageFontGroup ))
+    {
+        ILanguageFontGroup_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI group_AddRef( ILanguageFontGroup *iface )
+{
+    return InterlockedIncrement( &impl_from_ILanguageFontGroup( iface )->ref );
+}
+
+static ULONG WINAPI group_Release( ILanguageFontGroup *iface )
+{
+    struct font_group *impl = impl_from_ILanguageFontGroup( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI group_GetIids( ILanguageFontGroup *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI group_GetRuntimeClassName( ILanguageFontGroup *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Globalization.Fonts.LanguageFontGroup";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+
+static HRESULT WINAPI group_GetTrustLevel( ILanguageFontGroup *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+#define GROUP_FONT( name, kind ) \
+static HRESULT WINAPI group_get_##name( ILanguageFontGroup *iface, ILanguageFont **value ) \
+{ \
+    return font_create( kind, value ); \
+}
+GROUP_FONT( UITextFont, FONT_UI_TEXT )
+GROUP_FONT( UIHeadingFont, FONT_UI_HEADING )
+GROUP_FONT( UITitleFont, FONT_UI_TITLE )
+GROUP_FONT( UICaptionFont, FONT_UI_CAPTION )
+GROUP_FONT( UINotificationHeadingFont, FONT_UI_NOTIFICATION_HEADING )
+GROUP_FONT( TraditionalDocumentFont, FONT_TRADITIONAL_DOCUMENT )
+GROUP_FONT( ModernDocumentFont, FONT_MODERN_DOCUMENT )
+GROUP_FONT( DocumentHeadingFont, FONT_DOCUMENT_HEADING )
+GROUP_FONT( FixedWidthTextFont, FONT_FIXED_WIDTH )
+GROUP_FONT( DocumentAlternate1Font, FONT_DOCUMENT_ALTERNATE1 )
+GROUP_FONT( DocumentAlternate2Font, FONT_DOCUMENT_ALTERNATE2 )
+
+static const struct ILanguageFontGroupVtbl group_vtbl =
+{
+    group_QueryInterface,
+    group_AddRef,
+    group_Release,
+    /* IInspectable methods */
+    group_GetIids,
+    group_GetRuntimeClassName,
+    group_GetTrustLevel,
+    /* ILanguageFontGroup methods */
+    group_get_UITextFont,
+    group_get_UIHeadingFont,
+    group_get_UITitleFont,
+    group_get_UICaptionFont,
+    group_get_UINotificationHeadingFont,
+    group_get_TraditionalDocumentFont,
+    group_get_ModernDocumentFont,
+    group_get_DocumentHeadingFont,
+    group_get_FixedWidthTextFont,
+    group_get_DocumentAlternate1Font,
+    group_get_DocumentAlternate2Font,
+};
+
+struct font_group_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    ILanguageFontGroupFactory ILanguageFontGroupFactory_iface;
+};
+
+static inline struct font_group_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct font_group_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct font_group_factory *impl = impl_from_IActivationFactory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ILanguageFontGroupFactory ))
+        *out = &impl->ILanguageFontGroupFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( group_factory, ILanguageFontGroupFactory, struct font_group_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI group_factory_CreateLanguageFontGroup( ILanguageFontGroupFactory *iface, HSTRING tag,
+                                                             ILanguageFontGroup **value )
+{
+    struct font_group *impl;
+
+    TRACE( "tag %s.\n", debugstr_hstring(tag) );
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->ILanguageFontGroup_iface.lpVtbl = &group_vtbl;
+    impl->ref = 1;
+    *value = &impl->ILanguageFontGroup_iface;
+    return S_OK;
+}
+
+static const struct ILanguageFontGroupFactoryVtbl group_factory_vtbl =
+{
+    group_factory_QueryInterface,
+    group_factory_AddRef,
+    group_factory_Release,
+    /* IInspectable methods */
+    group_factory_GetIids,
+    group_factory_GetRuntimeClassName,
+    group_factory_GetTrustLevel,
+    /* ILanguageFontGroupFactory methods */
+    group_factory_CreateLanguageFontGroup,
+};
+
+static struct font_group_factory font_group_factory =
+{
+    {&factory_vtbl},
+    {&group_factory_vtbl},
+};
+
+IActivationFactory *language_font_group_factory = &font_group_factory.IActivationFactory_iface;
