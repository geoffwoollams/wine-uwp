+static HRESULT WINAPI selector_get_SelectedIndex( ISelector *iface, INT32 *value )
+{
+    struct items_control *impl = impl_from_ISelector( iface );
+
+    ensure_items( impl );
+    *value = first_selected( impl );
+    if (*value < 0 && impl->pending_index >= 0) *value = impl->pending_index;
+    return S_OK;
+}
+
+static HRESULT WINAPI selector_put_SelectedIndex( ISelector *iface, INT32 value )
+{
+    struct items_control *impl = impl_from_ISelector( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+    if (value < -1) return E_INVALIDARG;
+    ensure_items( impl );
+    impl->pending_index = -1;
+    if (value >= (INT32)impl->count)
+    {
+        /* markup sets SelectedIndex before it adds the items */
+        impl->pending_index = value;
+        return S_OK;
+    }
+    if (impl->selection_mode == ListViewSelectionMode_None && value >= 0) return S_OK;
+    select_items( impl, SELECT_ONLY, value );
+    if (value >= 0) impl->anchor = value;
+    return S_OK;
+}
