+static BOOL same_object( IInspectable *a, IInspectable *b )
+{
+    IUnknown *ua, *ub;
+    BOOL same;
+
+    if (a == b) return TRUE;
+    if (!a || !b) return FALSE;
+    if (FAILED(IInspectable_QueryInterface( a, &IID_IUnknown, (void **)&ua ))) return FALSE;
+    if (FAILED(IInspectable_QueryInterface( b, &IID_IUnknown, (void **)&ub )))
+    {
+        IUnknown_Release( ua );
+        return FALSE;
+    }
+    same = ua == ub;
+    IUnknown_Release( ua );
+    IUnknown_Release( ub );
+    return same;
+}
+
+static INT32 index_of_item( struct items_control *impl, IInspectable *item )
+{
+    UINT32 i;
+    for (i = 0; i < impl->count; i++) if (same_object( impl->data[i], item )) return i;
+    return -1;
+}
+
+static INT32 index_of_container( struct items_control *impl, struct xaml_element *container )
+{
+    UINT32 i;
+    for (i = 0; i < impl->count; i++) if (impl->containers[i] == container) return i;
+    return -1;
+}
+
+static INT32 selected_position( struct items_control *impl, IInspectable *item )
+{
+    UINT32 i, count = vector_size( impl->selected );
+    for (i = 0; i < count; i++) if (same_object( vector_get( impl->selected, i ), item )) return i;
+    return -1;
+}
+
+static IVector_IInspectable *vector_iface( IInspectable *vector )
+{
+    IVector_IInspectable *out = NULL;
+    IInspectable_QueryInterface( vector, &IID_IVector_IInspectable, (void **)&out );
+    return out;
+}
+
+static void list_free_data( struct items_control *impl )
+{
+    UINT32 i;
+
+    for (i = 0; i < impl->count; i++)
+    {
+        if (impl->containers[i]) selector_item_attach( impl->containers[i], NULL );
+        if (impl->data[i]) IInspectable_Release( impl->data[i] );
+    }
+    impl->count = 0;
+}
+
+static void list_add_item( struct items_control *impl, IVector_UIElement *children, IInspectable *item )
+{
+    struct xaml_element *container = impl->item_template ? NULL : selector_item_from_object( item );
+    IInspectable *object = NULL;
+    IContentControl *cc;
+    IUIElement *ui = NULL, *content;
+    void *grow;
+
+    if (container && container->parent) container = NULL;   /* shown elsewhere */
+    if (container) IInspectable_QueryInterface( item, &IID_IUIElement, (void **)&ui );
+    else
+    {
+        IActivationFactory *factory = impl->kind == ITEMS_GRID_VIEW ? grid_view_item_factory : list_view_item_factory;
+        if (FAILED(IActivationFactory_ActivateInstance( factory, &object ))) return;
+        if ((content = container_for( impl, item )))
+        {
+            if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IContentControl, (void **)&cc )))
+            {
+                IContentControl_put_Content( cc, (IInspectable *)content );
+                IContentControl_Release( cc );
+            }
+            IUIElement_Release( content );
+        }
+        container = element_from_object( object );
+        IInspectable_QueryInterface( object, &IID_IUIElement, (void **)&ui );
+        IInspectable_Release( object );
+    }
+    if (!ui || !container) goto done;
+
+    if (impl->count == impl->capacity)
+    {
+        UINT32 capacity = max( 16, impl->capacity * 2 );
+        if (!(grow = realloc( impl->data, capacity * sizeof(*impl->data) ))) goto done;
+        impl->data = grow;
+        if (!(grow = realloc( impl->containers, capacity * sizeof(*impl->containers) ))) goto done;
+        impl->containers = grow;
+        impl->capacity = capacity;
+    }
+    if ((impl->data[impl->count] = item)) IInspectable_AddRef( item );
+    impl->containers[impl->count++] = container;
+    selector_item_attach( container, &impl->element );
+    if (selector_item_is_selected( container ) && selected_position( impl, item ) < 0)
+    {
+        /* <ListViewItem IsSelected="True"> */
+        IVector_IInspectable *vector = vector_iface( impl->selected );
+        impl->updating = TRUE;
+        if (vector) IVector_IInspectable_Append( vector, item );
+        impl->updating = FALSE;
+        if (vector) IVector_IInspectable_Release( vector );
+    }
+    else selector_item_set_selected( container, selected_position( impl, item ) >= 0 );
+    selector_item_set_current( container, FALSE );
+    IVector_UIElement_Append( children, ui );
+done:
+    if (ui) IUIElement_Release( ui );
+}
