+static void set_current( struct items_control *impl, INT32 index )
+{
+    if (impl->current >= 0 && impl->current < impl->count) selector_item_set_current( impl->containers[impl->current], FALSE );
+    impl->current = index;
+    if (index >= 0 && index < impl->count) selector_item_set_current( impl->containers[index], TRUE );
+}
