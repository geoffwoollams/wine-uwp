+/* ListView / GridView properties set from markup: value is the text, or NULL for number (an enum, bool or number) */
+BOOL list_view_set_markup( IInspectable *object, const WCHAR *name, const WCHAR *value, double number )
+{
+#define FLAG() (value ? !wcsicmp( value, L"True" ) : number != 0)
+    struct xaml_element *element = element_from_object( object );
+    struct items_control *impl;
+
+    if (!element || element->ops != &items_control_ops) return FALSE;
+    impl = impl_from_element( element );
+    if (impl->kind == ITEMS_CONTROL) return FALSE;
+    if (!wcscmp( name, L"SelectionMode" ))
+    {
+        ListViewSelectionMode mode = value ? ListViewSelectionMode_Single : (ListViewSelectionMode)number;
+        if (!value) ;
+        else if (!wcsicmp( value, L"None" )) mode = ListViewSelectionMode_None;
