+/* after generating the containers: drop selected items that are gone, apply a pending SelectedIndex */
+static void list_generated( struct items_control *impl )
+{
+    IVector_IInspectable *selected = vector_iface( impl->selected );
+    IInspectable *added = NULL, *removed = NULL;
+    IVector_IInspectable *removed_vec;
+    UINT32 i;
+
+    if (selected && SUCCEEDED(vector_create( &items_iids, &no_callbacks, NULL, &removed )))
+    {
+        removed_vec = vector_iface( removed );
+        impl->updating = TRUE;
+        for (i = vector_size( impl->selected ); i > 0; i--)
+        {
+            IInspectable *item = vector_get( impl->selected, i - 1 );
+            if (index_of_item( impl, item ) >= 0) continue;
+            IVector_IInspectable_Append( removed_vec, item );
+            IVector_IInspectable_RemoveAt( selected, i - 1 );
+        }
+        impl->updating = FALSE;
+        if (vector_size( removed ) && SUCCEEDED(vector_create( &items_iids, &no_callbacks, NULL, &added )))
+        {
+            raise_selection_changed( impl, added, removed );
+            IInspectable_Release( added );
+        }
+        IVector_IInspectable_Release( removed_vec );
+        IInspectable_Release( removed );
+    }
+    if (selected) IVector_IInspectable_Release( selected );
+    if (impl->current >= (INT32)impl->count) impl->current = impl->count - 1;
+    set_current( impl, impl->current );
+    if (impl->pending_index >= 0 && impl->pending_index < impl->count)
+    {
+        INT32 index = impl->pending_index;
+        impl->pending_index = -1;
+        if (impl->selection_mode != ListViewSelectionMode_None)
+        {
+            select_items( impl, SELECT_ONLY, index );
+            impl->anchor = index;
+        }
+    }
+}
+
+/* scroll the ScrollViewer so that the item shows */
+static void scroll_into_view( struct items_control *impl, INT32 index, BOOL leading )
+{
+    const struct layout_rect *c, *view;
+    IScrollViewer *scroll;
+    DOUBLE offset, target;
+
+    if (index < 0 || index >= impl->count || !impl->scroll_object || !impl->scroll) return;
+    if (FAILED(IInspectable_QueryInterface( impl->scroll_object, &IID_IScrollViewer, (void **)&scroll ))) return;
+    c = &impl->containers[index]->bounds;
+    view = &impl->scroll->bounds;
+    IScrollViewer_get_VerticalOffset( scroll, &offset );
+    target = offset;
+    if (leading || c->y < view->y) target = offset + (c->y - view->y);
+    else if (c->y + c->height > view->y + view->height) target = offset + (c->y + c->height - view->y - view->height);
+    if (target != offset)
+    {
+        TRACE( "%p: item %d, offset %.1f -> %.1f.\n", impl, index, offset, target );
+        IScrollViewer_ScrollToVerticalOffset( scroll, target );
+    }
+    IScrollViewer_Release( scroll );
+}
+
+/* a click on a container (listview.c) */
+void list_view_item_clicked( struct xaml_element *owner, struct xaml_element *container )
+{
+    struct items_control *impl = impl_from_element( owner );
+    BOOL ctrl = GetKeyState( VK_CONTROL ) < 0, shift = GetKeyState( VK_SHIFT ) < 0;
+    INT32 index = index_of_container( impl, container );
+
+    TRACE( "%p: item %d clicked, mode %d.\n", impl, index, impl->selection_mode );
+    if (index < 0) return;
+    IInspectable_AddRef( impl->element.outer );
+    set_current( impl, index );
+    focus_set( &impl->element, FocusState_Pointer );
+    if (impl->item_click_enabled)
+    {
+        raise_item_click( impl, impl->data[index] );
+        /* clicking doesn't select then, except for Multiple's check boxes */
+        if (impl->selection_mode != ListViewSelectionMode_Multiple || index >= impl->count) goto done;
+    }
+    switch (impl->selection_mode)
+    {
+    case ListViewSelectionMode_None:
+        break;
+    case ListViewSelectionMode_Single:
+        if (ctrl && selector_item_is_selected( container )) select_items( impl, SELECT_ONLY, -1 );
+        else select_items( impl, SELECT_ONLY, index );
+        break;
+    case ListViewSelectionMode_Multiple:
+        select_items( impl, SELECT_TOGGLE, index );
+        break;
+    case ListViewSelectionMode_Extended:
+        if (shift) select_items( impl, SELECT_RANGE, index );
+        else if (ctrl) select_items( impl, SELECT_TOGGLE, index );
+        else select_items( impl, SELECT_ONLY, index );
+        break;
+    }
+    if (!shift) impl->anchor = index;
+done:
+    IInspectable_Release( impl->element.outer );
+}
+
+/* ListViewItem.IsSelected set by the app (listview.c) */
+void list_view_item_selected( struct xaml_element *owner, struct xaml_element *container, BOOL selected )
+{
+    struct items_control *impl = impl_from_element( owner );
+    INT32 index = index_of_container( impl, container );
+
+    if (index < 0 || impl->selection_mode == ListViewSelectionMode_None) return;
+    if (selected && impl->selection_mode == ListViewSelectionMode_Single) select_items( impl, SELECT_ONLY, index );
+    else if (!!selected != !!selector_item_is_selected( container )) select_items( impl, SELECT_TOGGLE, index );
+}
+
+/* SelectedItems changed by the app */
+static HRESULT selected_inserted( void *owner, IInspectable *item )
+{
+    struct items_control *impl = owner;
+    IInspectable *added, *removed;
+    IVector_IInspectable *vec;
+    INT32 index;
+
+    if (impl->updating) return S_OK;
+    if ((index = index_of_item( impl, item )) >= 0) selector_item_set_selected( impl->containers[index], TRUE );
+    if (SUCCEEDED(vector_create( &items_iids, &no_callbacks, NULL, &added )))
+    {
+        if (SUCCEEDED(vector_create( &items_iids, &no_callbacks, NULL, &removed )))
+        {
+            if ((vec = vector_iface( added )))
+            {
+                IVector_IInspectable_Append( vec, item );
+                IVector_IInspectable_Release( vec );
+            }
+            raise_selection_changed( impl, added, removed );
+            IInspectable_Release( removed );
+        }
+        IInspectable_Release( added );
+    }
+    return S_OK;
+}
+
+static void selected_removed( void *owner, IInspectable *item )
+{
+    struct items_control *impl = owner;
+    IInspectable *added, *removed;
+    IVector_IInspectable *vec;
+    INT32 index;
+
+    if (impl->updating) return;
+    if ((index = index_of_item( impl, item )) >= 0) selector_item_set_selected( impl->containers[index], FALSE );
+    if (SUCCEEDED(vector_create( &items_iids, &no_callbacks, NULL, &added )))
+    {
+        if (SUCCEEDED(vector_create( &items_iids, &no_callbacks, NULL, &removed )))
+        {
+            if ((vec = vector_iface( removed )))
+            {
+                IVector_IInspectable_Append( vec, item );
+                IVector_IInspectable_Release( vec );
+            }
+            raise_selection_changed( impl, added, removed );
+            IInspectable_Release( removed );
+        }
+        IInspectable_Release( added );
+    }
+}
+
+static const struct vector_callbacks selected_callbacks = { selected_inserted, selected_removed };
+
+/* ---- keyboard ---- */
+
+static BOOL list_focusable( struct xaml_element *element )
+{
+    struct items_control *impl = impl_from_element( element );
+    return impl->kind != ITEMS_CONTROL;
+}
+
+static void list_focus_changed( struct xaml_element *element )
+{
+    struct items_control *impl = impl_from_element( element );
+
+    if (impl->kind == ITEMS_CONTROL) return;
+    ensure_items( impl );
+    if (impl->current < 0 && impl->count)
+    {
+        INT32 index = first_selected( impl );
+        set_current( impl, index >= 0 ? index : 0 );
+    }
+    window_invalidate();
+}
+
+/* items per row of a GridView's wrap grid, from the arranged containers */
+static INT32 items_per_row( struct items_control *impl )
+{
+    UINT32 i;
+
+    if (impl->kind != ITEMS_GRID_VIEW) return 1;
+    for (i = 1; i < impl->count; i++)
+        if (impl->containers[i]->bounds.y != impl->containers[0]->bounds.y) break;
+    return max( 1, i );
+}
+
+static BOOL list_key( struct xaml_element *element, BOOL down, WPARAM vk )
+{
+    struct items_control *impl = impl_from_element( element );
+    BOOL ctrl = GetKeyState( VK_CONTROL ) < 0, shift = GetKeyState( VK_SHIFT ) < 0;
+    INT32 index, step = items_per_row( impl );
+
+    if (impl->kind == ITEMS_CONTROL || !down) return FALSE;
+    ensure_items( impl );
+    if (!impl->count) return FALSE;
+    index = impl->current >= 0 ? impl->current : 0;
+    switch (vk)
+    {
+    case VK_UP: index -= step; break;
+    case VK_DOWN: index += step; break;
+    case VK_LEFT: if (impl->kind != ITEMS_GRID_VIEW) return FALSE; index--; break;
+    case VK_RIGHT: if (impl->kind != ITEMS_GRID_VIEW) return FALSE; index++; break;
+    case VK_HOME: index = 0; break;
+    case VK_END: index = impl->count - 1; break;
+    case VK_SPACE:
+        if (impl->selection_mode == ListViewSelectionMode_None) return TRUE;
+        if (impl->selection_mode == ListViewSelectionMode_Single) select_items( impl, SELECT_ONLY, index );
+        else select_items( impl, SELECT_TOGGLE, index );
+        impl->anchor = index;
+        return TRUE;
+    case VK_RETURN:
+        if (impl->item_click_enabled) raise_item_click( impl, impl->data[index] );
+        return impl->item_click_enabled;
+    default:
+        return FALSE;
+    }
+    index = max( 0, min( index, (INT32)impl->count - 1 ) );
+    set_current( impl, index );
+    if (impl->selection_mode == ListViewSelectionMode_Single ||
+        (impl->selection_mode == ListViewSelectionMode_Extended && !ctrl))
+    {
+        if (shift && impl->selection_mode == ListViewSelectionMode_Extended) select_items( impl, SELECT_RANGE, index );
+        else
+        {
+            select_items( impl, SELECT_ONLY, index );
+            impl->anchor = index;
+        }
+    }
+    scroll_into_view( impl, index, FALSE );
+    window_invalidate();
+    return TRUE;
+}
