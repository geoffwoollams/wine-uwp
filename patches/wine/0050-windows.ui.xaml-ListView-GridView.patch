+enum select_op
+{
+    SELECT_ONLY,     /* just the item (or nothing for -1) */
+    SELECT_TOGGLE,   /* the item in or out of the selection */
+    SELECT_RANGE,    /* just the items from the anchor to the item */
+    SELECT_ALL,
+};
+
+static void select_items( struct items_control *impl, enum select_op op, INT32 index )
+{
+    INT32 i, from, to;
+    BOOL *want;
+
+    if (!(want = calloc( max( impl->count, 1 ), sizeof(*want) ))) return;
+    switch (op)
+    {
+    case SELECT_ONLY:
+        if (index >= 0 && index < impl->count) want[index] = TRUE;
+        break;
+    case SELECT_TOGGLE:
+        if (index < 0 || index >= impl->count) break;
+        if (impl->selection_mode != ListViewSelectionMode_Single)
+            for (i = 0; i < impl->count; i++) want[i] = selector_item_is_selected( impl->containers[i] );
+        want[index] = !selector_item_is_selected( impl->containers[index] );
+        break;
+    case SELECT_RANGE:
+        from = impl->anchor >= 0 && impl->anchor < impl->count ? impl->anchor : index;
+        to = index;
+        if (from > to) { i = from; from = to; to = i; }
+        for (i = max( from, 0 ); i <= to && i < impl->count; i++) want[i] = TRUE;
+        break;
+    case SELECT_ALL:
+        for (i = 0; i < impl->count; i++) want[i] = TRUE;
+        break;
+    }
+    apply_selection( impl, want );
+    free( want );
+}
