index 0000000..3811c24
--- /dev/null
+++ b/dlls/windows.ui.xaml/listview.c
@@ -0,0 +1,298 @@
+/* WinRT Windows.UI.Xaml.Controls ListViewItem and GridViewItem implementation
+ *
+ * Copyright 2026 wine-uwp contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "control.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* ListViewItem and GridViewItem are ContentControls (struct button, kinds BUTTON_LIST_ITEM and BUTTON_GRID_ITEM):
+ * the containers a ListView or GridView (items.c) puts its items in, or items an app adds itself. A click goes to
+ * the list, which selects the item or raises ItemClick. They draw Windows 10's default looks: a ListViewItem is at
+ * least 40 px high with 12 px padding, translucent grey under the pointer and while pressed, and the accent colour
+ * at 60% (80% under the pointer) when selected; a GridViewItem has a 4 px gap right and below, a grey frame under
+ * the pointer, and an accent frame with a check mark in the top right corner when selected. The item the keyboard
+ * is on gets a focus frame while its list has the keyboard focus. There are no swipe, drag or reorder visuals and
+ * no ItemContainerStyle or template. */
+
+void *item_default_iface( struct button *impl )
+{
+    return impl->kind == BUTTON_LIST_ITEM ? (void *)&impl->IListViewItem_iface : (void *)&impl->IGridViewItem_iface;
+}
+
+/* ---- drawing ---- */
+
+static Color theme_alpha( struct layout_context *ctx, BYTE alpha )
+{
+    Color c = { alpha, 0, 0, 0 };
+    if (ctx->dark) c.R = c.G = c.B = 255;
+    return c;
+}
+
+static Color accent_alpha( BYTE alpha )
+{
+    Color c = { alpha, 0x00, 0x78, 0xd7 };
+    return c;
+}
+
+void item_render_background( struct button *impl, struct layout_context *ctx )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+    Color c;
+
+    if (impl->background && brush_get_color( impl->background, &c )) element_fill_argb( ctx, b, c );
+    if (impl->kind == BUTTON_LIST_ITEM)
+    {
+        /* SystemControlHighlightListAccentLow/Medium/High, and ListLow/ListMedium */
+        if (impl->is_selected) element_fill_argb( ctx, b, accent_alpha( impl->pressed ? 0xe6 : impl->pointer_over ? 0xcc : 0x99 ) );
+        else if (impl->pressed) element_fill_argb( ctx, b, theme_alpha( ctx, 0x33 ) );
+        else if (impl->pointer_over) element_fill_argb( ctx, b, theme_alpha( ctx, 0x19 ) );
+    }
+    else if (impl->pressed) element_fill_argb( ctx, b, theme_alpha( ctx, 0x33 ) );
+}
+
+static void frame( struct layout_context *ctx, const struct layout_rect *rect, float width, Color c )
+{
+    struct layout_rect side;
+
+    side = *rect;
+    side.height = min( width, rect->height );
+    element_fill_argb( ctx, &side, c );
+    side.y = rect->y + rect->height - side.height;
+    element_fill_argb( ctx, &side, c );
+    side = *rect;
+    side.width = min( width, rect->width );
+    element_fill_argb( ctx, &side, c );
+    side.x = rect->x + rect->width - side.width;
+    element_fill_argb( ctx, &side, c );
+}
+
+static void draw_check( struct layout_context *ctx, float x, float y )
+{
+    static const struct shape_point points[] = { {4, 10}, {8, 14}, {16, 6} };
+    Color white = { 0xff, 0xff, 0xff, 0xff };
+    ISolidColorBrush *solid;
+    IInspectable *object;
+    IBrush *brush;
+
+    if (!ctx->rt || FAILED(IActivationFactory_ActivateInstance( solid_color_brush_factory, &object ))) return;
+    if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_ISolidColorBrush, (void **)&solid )))
+    {
+        ISolidColorBrush_put_Color( solid, white );
+        ISolidColorBrush_Release( solid );
+    }
+    if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IBrush, (void **)&brush )))
+    {
+        d2d_draw_lines( ctx, x, y, points, ARRAY_SIZE(points), FALSE, NULL, brush, 2.0 );
+        IBrush_Release( brush );
+    }
+    IInspectable_Release( object );
+}
+
+void item_render_overlay( struct button *impl, struct layout_context *ctx )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+
+    if (impl->kind == BUTTON_GRID_ITEM)
+    {
+        if (impl->is_selected)
+        {
+            struct layout_rect corner = { b->x + b->width - 20, b->y, 20, 20 };
+
+            frame( ctx, b, 2, accent_alpha( impl->pointer_over ? 0xcc : 0xff ) );
+            if (b->width >= 24 && b->height >= 24)
+            {
+                element_fill_argb( ctx, &corner, accent_alpha( 0xff ) );
+                draw_check( ctx, corner.x, corner.y );
+            }
+        }
+        else if (impl->pointer_over) frame( ctx, b, 2, theme_alpha( ctx, 0x66 ) );
+    }
+    if (impl->is_current && impl->selector && element_focus_state( impl->selector ) == FocusState_Keyboard)
+        frame( ctx, b, 2, theme_alpha( ctx, 0xff ) );
+}
+
+/* ---- the list's side ---- */
+
+struct xaml_element *selector_item_from_object( IInspectable *object )
+{
+    struct xaml_element *element = object ? element_from_object( object ) : NULL;
+    struct button *impl;
+
+    if (!element || !element->ops->query_interface) return NULL;
+    if (FAILED(element->ops->query_interface( element, &IID_ISelectorItem, (void **)&impl ))) return NULL;
+    ISelectorItem_Release( (ISelectorItem *)impl );
+    return element;
+}
+
+static struct button *item_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct button, element );
+}
+
+void selector_item_attach( struct xaml_element *item, struct xaml_element *selector )
+{
+    item_from_element( item )->selector = selector;
+}
+
+void selector_item_set_selected( struct xaml_element *item, BOOL selected )
+{
+    struct button *impl = item_from_element( item );
+    if (impl->is_selected == !!selected) return;
+    impl->is_selected = !!selected;
+    element_property_changed( impl->element.outer, L"IsSelected" );
+    window_invalidate();
+}
+
+BOOL selector_item_is_selected( struct xaml_element *item )
+{
+    return item_from_element( item )->is_selected;
+}
+
+void selector_item_set_current( struct xaml_element *item, BOOL current )
+{
+    struct button *impl = item_from_element( item );
+    if (impl->is_current == !!current) return;
+    impl->is_current = !!current;
+    window_invalidate();
+}
+
+void item_clicked( struct button *impl )
+{
+    TRACE( "%p, selector %p.\n", impl, impl->selector );
+    if (impl->selector) list_view_item_clicked( impl->selector, &impl->element );
+}
+
+/* ---- ISelectorItem ---- */
+
+DEFINE_IINSPECTABLE_( selector_item, ISelectorItem, struct button, impl_from_ISelectorItem, ISelectorItem_iface,
+                      impl->element.outer )
+
+static HRESULT WINAPI selector_item_get_IsSelected( ISelectorItem *iface, boolean *value )
+{
+    *value = impl_from_ISelectorItem( iface )->is_selected;
+    return S_OK;
+}
+
+static HRESULT WINAPI selector_item_put_IsSelected( ISelectorItem *iface, boolean value )
+{
+    struct button *impl = impl_from_ISelectorItem( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+    if (impl->is_selected == !!value) return S_OK;
+    /* the list updates its selection, and the item */
+    if (impl->selector) list_view_item_selected( impl->selector, &impl->element, value );
+    else selector_item_set_selected( &impl->element, value );
+    return S_OK;
+}
+
+static const struct ISelectorItemVtbl selector_item_vtbl =
+{
+    selector_item_QueryInterface,
+    selector_item_AddRef,
+    selector_item_Release,
+    /* IInspectable methods */
+    selector_item_GetIids,
+    selector_item_GetRuntimeClassName,
+    selector_item_GetTrustLevel,
+    /* ISelectorItem methods */
+    selector_item_get_IsSelected,
+    selector_item_put_IsSelected,
+};
+
+/* ---- IListViewItem and IGridViewItem ---- */
+
+DEFINE_IINSPECTABLE_( list_view_item, IListViewItem, struct button, impl_from_IListViewItem, IListViewItem_iface,
+                      impl->element.outer )
+
+static HRESULT WINAPI list_view_item_get_TemplateSettings( IListViewItem *iface, IListViewItemTemplateSettings **value )
+{
+    FIXME( "iface %p: no TemplateSettings.\n", iface );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IListViewItemVtbl list_view_item_vtbl =
+{
+    list_view_item_QueryInterface,
+    list_view_item_AddRef,
+    list_view_item_Release,
+    /* IInspectable methods */
+    list_view_item_GetIids,
+    list_view_item_GetRuntimeClassName,
+    list_view_item_GetTrustLevel,
+    /* IListViewItem methods */
+    list_view_item_get_TemplateSettings,
+};
+
+DEFINE_IINSPECTABLE_( grid_view_item, IGridViewItem, struct button, impl_from_IGridViewItem, IGridViewItem_iface,
+                      impl->element.outer )
+
+static HRESULT WINAPI grid_view_item_get_TemplateSettings( IGridViewItem *iface, IGridViewItemTemplateSettings **value )
+{
+    FIXME( "iface %p: no TemplateSettings.\n", iface );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IGridViewItemVtbl grid_view_item_vtbl =
+{
+    grid_view_item_QueryInterface,
+    grid_view_item_AddRef,
+    grid_view_item_Release,
+    /* IInspectable methods */
+    grid_view_item_GetIids,
+    grid_view_item_GetRuntimeClassName,
+    grid_view_item_GetTrustLevel,
+    /* IGridViewItem methods */
+    grid_view_item_get_TemplateSettings,
+};
+
+HRESULT item_query_interface( struct button *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_ISelectorItem )) *out = &impl->ISelectorItem_iface;
+    else if (impl->kind == BUTTON_LIST_ITEM && IsEqualGUID( iid, &IID_IListViewItem )) *out = &impl->IListViewItem_iface;
+    else if (impl->kind == BUTTON_GRID_ITEM && IsEqualGUID( iid, &IID_IGridViewItem )) *out = &impl->IGridViewItem_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+void item_init( struct button *impl )
+{
+    impl->ISelectorItem_iface.lpVtbl = &selector_item_vtbl;
+    impl->IListViewItem_iface.lpVtbl = &list_view_item_vtbl;
+    impl->IGridViewItem_iface.lpVtbl = &grid_view_item_vtbl;
+    impl->element.horizontal_alignment = HorizontalAlignment_Stretch;
+    impl->element.vertical_alignment = VerticalAlignment_Stretch;
+    memset( &impl->border_thickness, 0, sizeof(impl->border_thickness) );
+    memset( &impl->padding, 0, sizeof(impl->padding) );
+    impl->content_vertical = VerticalAlignment_Center;
+    impl->element.is_tab_stop = FALSE;
+    if (impl->kind == BUTTON_LIST_ITEM)
+    {
+        impl->padding.Left = impl->padding.Right = 12;
+        impl->content_horizontal = HorizontalAlignment_Left;
+    }
+    else
+    {
+        impl->element.margin.Right = impl->element.margin.Bottom = 4;
+        impl->content_horizontal = HorizontalAlignment_Center;
+    }
+}
