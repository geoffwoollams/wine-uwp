+static HRESULT WINAPI selector_get_SelectedItem( ISelector *iface, IInspectable **value )
+{
+    struct items_control *impl = impl_from_ISelector( iface );
+    INT32 index;
+
+    ensure_items( impl );
+    *value = NULL;
+    if ((index = first_selected( impl )) >= 0 && (*value = impl->data[index])) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI selector_put_SelectedItem( ISelector *iface, IInspectable *value )
+{
+    struct items_control *impl = impl_from_ISelector( iface );
+    INT32 index;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    ensure_items( impl );
+    if (!value) select_items( impl, SELECT_ONLY, -1 );
+    else if ((index = index_of_item( impl, value )) >= 0 && impl->selection_mode != ListViewSelectionMode_None)
+    {
+        select_items( impl, SELECT_ONLY, index );
+        impl->anchor = index;
+    }
+    return S_OK;
+}
