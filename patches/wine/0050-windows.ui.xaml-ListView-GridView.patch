+/* make the selection what want says, item by item; SelectionChanged if it changed */
+static void apply_selection( struct items_control *impl, const BOOL *want )
+{
+    IVector_IInspectable *selected, *added_vec, *removed_vec;
+    IInspectable *added = NULL, *removed = NULL;
+    BOOL changed = FALSE;
+    INT32 pos;
+    UINT32 i;
+
+    if (!(selected = vector_iface( impl->selected ))) return;
+    if (FAILED(vector_create( &items_iids, &no_callbacks, NULL, &added )) ||
+        FAILED(vector_create( &items_iids, &no_callbacks, NULL, &removed )))
+    {
+        if (added) IInspectable_Release( added );
+        IVector_IInspectable_Release( selected );
+        return;
+    }
+    added_vec = vector_iface( added );
+    removed_vec = vector_iface( removed );
+    impl->updating = TRUE;
+    for (i = 0; i < impl->count; i++)
+    {
+        if (!!selector_item_is_selected( impl->containers[i] ) == !!want[i]) continue;
+        changed = TRUE;
+        selector_item_set_selected( impl->containers[i], want[i] );
+        if (want[i])
+        {
+            IVector_IInspectable_Append( selected, impl->data[i] );
+            IVector_IInspectable_Append( added_vec, impl->data[i] );
+        }
+        else
+        {
+            if ((pos = selected_position( impl, impl->data[i] )) >= 0) IVector_IInspectable_RemoveAt( selected, pos );
+            IVector_IInspectable_Append( removed_vec, impl->data[i] );
+        }
+    }
+    impl->updating = FALSE;
+    IVector_IInspectable_Release( added_vec );
+    IVector_IInspectable_Release( removed_vec );
+    IVector_IInspectable_Release( selected );
+    if (changed) raise_selection_changed( impl, added, removed );
+    IInspectable_Release( added );
+    IInspectable_Release( removed );
+}
