+static void raise_selection_changed( struct items_control *impl, IInspectable *added, IInspectable *removed )
+{
+    struct list_event_args *args;
+    IUnknown **handlers;
+    UINT32 i, count;
+    HRESULT hr;
+
+    element_property_changed( impl->element.outer, L"SelectedIndex" );
+    element_property_changed( impl->element.outer, L"SelectedItem" );
+    element_property_changed( impl->element.outer, L"SelectedValue" );
+    if (!(handlers = copy_handlers( &impl->selection_changed, &count ))) return;
+    if ((args = list_args_create( impl->element.outer, FALSE )))
+    {
+        IInspectable_AddRef( (args->added = added) );
+        IInspectable_AddRef( (args->removed = removed) );
+        TRACE( "%p: SelectionChanged, %u added, %u removed.\n", impl, vector_size( added ), vector_size( removed ) );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            hr = ISelectionChangedEventHandler_Invoke( (ISelectionChangedEventHandler *)handlers[i], impl->element.outer,
+                                                       &args->ISelectionChangedEventArgs_iface );
+            if (FAILED(hr)) WARN( "SelectionChanged handler %p failed, hr %#lx.\n", handlers[i], hr );
+        }
+        IInspectable_Release( &args->IInspectable_inner );
+    }
+    free_handlers( handlers, count );
+}
+
+static void raise_item_click( struct items_control *impl, IInspectable *item )
+{
+    struct list_event_args *args;
+    IUnknown **handlers;
+    UINT32 i, count;
+    HRESULT hr;
+
+    if (!(handlers = copy_handlers( &impl->item_click, &count ))) return;
+    if ((args = list_args_create( impl->element.outer, TRUE )))
+    {
+        if ((args->clicked = item)) IInspectable_AddRef( item );
+        TRACE( "%p: ItemClick, item %p.\n", impl, item );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            hr = IItemClickEventHandler_Invoke( (IItemClickEventHandler *)handlers[i], impl->element.outer,
+                                                &args->IItemClickEventArgs_iface );
+            if (FAILED(hr)) WARN( "ItemClick handler %p failed, hr %#lx.\n", handlers[i], hr );
+        }
+        IInspectable_Release( &args->IInspectable_inner );
+    }
+    free_handlers( handlers, count );
+}
