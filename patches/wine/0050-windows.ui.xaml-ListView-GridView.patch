+static HRESULT WINAPI list_args_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    const WCHAR *name = args_from_inner( iface )->click ? RuntimeClass_Windows_UI_Xaml_Controls_ItemClickEventArgs
+                                                         : RuntimeClass_Windows_UI_Xaml_Controls_SelectionChangedEventArgs;
+    return WindowsCreateString( name, wcslen( name ), class_name );
