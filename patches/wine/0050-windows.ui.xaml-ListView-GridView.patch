+/* copies of the handlers, so that a handler may remove itself */
+static IUnknown **copy_handlers( struct event_list *list, UINT32 *count )
+{
+    IUnknown **handlers;
+    UINT32 i;
+
+    *count = list->count;
+    if (!*count || !(handlers = calloc( *count, sizeof(*handlers) ))) return NULL;
+    for (i = 0; i < *count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+    return handlers;
+}
+
+static void free_handlers( IUnknown **handlers, UINT32 count )
+{
+    UINT32 i;
+    for (i = 0; i < count; i++) if (handlers[i]) IUnknown_Release( handlers[i] );
+    free( handlers );
+}
