+struct list_event_args
+{
+    IInspectable IInspectable_inner;
+    ISelectionChangedEventArgs ISelectionChangedEventArgs_iface;
+    IItemClickEventArgs IItemClickEventArgs_iface;
+    IRoutedEventArgs IRoutedEventArgs_iface;
+    LONG ref;
+    BOOL click;
+    IInspectable *source, *added, *removed, *clicked;
+};
+
+static inline struct list_event_args *args_from_inner( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct list_event_args, IInspectable_inner );
+}
+
+static HRESULT WINAPI list_args_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct list_event_args *impl = args_from_inner( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = &impl->IInspectable_inner;
+    else if (!impl->click && IsEqualGUID( iid, &IID_ISelectionChangedEventArgs ))
+        *out = &impl->ISelectionChangedEventArgs_iface;
+    else if (impl->click && IsEqualGUID( iid, &IID_IItemClickEventArgs ))
+        *out = &impl->IItemClickEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IRoutedEventArgs ))
+        *out = &impl->IRoutedEventArgs_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI list_args_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &args_from_inner( iface )->ref );
+}
+
+static ULONG WINAPI list_args_Release( IInspectable *iface )
+{
+    struct list_event_args *impl = args_from_inner( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->source) IInspectable_Release( impl->source );
+        if (impl->added) IInspectable_Release( impl->added );
+        if (impl->removed) IInspectable_Release( impl->removed );
+        if (impl->clicked) IInspectable_Release( impl->clicked );
+        free( impl );
+    }
+    return ref;
+}
