index 0000000..aeff817
--- /dev/null
+++ b/dlls/twinapi.appcore/app_icon.c
@@ -0,0 +1,143 @@
+/* The app's own icon for the CoreWindow (taskbar, title bar, Alt-Tab)
+ *
+ * Copyright 2026 wine-uwp contributors
