index 0000000..a529bd6
--- /dev/null
+++ b/dlls/windows.applicationmodel/app_info.c
@@ -0,0 +1,375 @@
+/* WinRT Windows.ApplicationModel.AppInfo: the running app, from its package identity
+ *
