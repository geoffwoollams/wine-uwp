Subject: cryptowinrt: CryptographicBuffer.EncodeToBase64String's string doesn't end in a nul character

The string was given the length CryptBinaryToStringW reports for its buffer, which counts the terminating nul, so
it had one character too many and compared unequal to the same text (Xbox Accessories' firmware hash check). The
test now checks the length too.

diff --git a/dlls/cryptowinrt/main.c b/dlls/cryptowinrt/main.c
index 450983c..eaa062f 100644
--- a/dlls/cryptowinrt/main.c
+++ b/dlls/cryptowinrt/main.c
@@ -379,7 +379,8 @@ static HRESULT STDMETHODCALLTYPE cryptobuffer_statics_EncodeToBase64String(
     if (!CryptBinaryToStringW(data, length, CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, NULL, &ret_length))
         return E_FAIL;
 
-    if (FAILED(hr = WindowsPreallocateStringBuffer(ret_length, &str, &str_buffer)))
+    /* the size includes the terminating nul, which the string doesn't */
+    if (FAILED(hr = WindowsPreallocateStringBuffer(ret_length - 1, &str, &str_buffer)))
         return hr;
 
     if (!CryptBinaryToStringW(data, length, CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, str, &ret_length))
diff --git a/dlls/cryptowinrt/tests/crypto.c b/dlls/cryptowinrt/tests/crypto.c
index 5f92722..b641751 100644
--- a/dlls/cryptowinrt/tests/crypto.c
+++ b/dlls/cryptowinrt/tests/crypto.c
@@ -282,7 +282,7 @@ static void test_CryptobufferStatics(void)
     hr = ICryptographicBufferStatics_EncodeToBase64String( cryptobuffer_statics, buffer, &str );
     ok( hr == S_OK, "got hr %#lx.\n", hr );
     base64_str = WindowsGetStringRawBuffer( str, &len );
-    ok( !wcscmp( L"AAECAwQFBgcICQoLDA0ODw==", base64_str ), "got str %s, len %d.\n", wine_dbgstr_w( base64_str ), len );
+    ok( !wcscmp( L"AAECAwQFBgcICQoLDA0ODw==", base64_str ) && len == 24, "got str %s, len %d.\n", wine_dbgstr_w( base64_str ), len );
     WindowsDeleteString( str );
     IBuffer_Release( buffer );
 
