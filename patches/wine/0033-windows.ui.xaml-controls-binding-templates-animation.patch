+/* ---- RectangleGeometry, EllipseGeometry, LineGeometry ---- */
+
+static const struct IGeometryVtbl geometry_vtbl;
+
+static struct geometry *geometry_from_object( IInspectable *object )
+{
+    IGeometry *geometry;
+    struct geometry *impl = NULL;
+
+    if (!object || FAILED(IInspectable_QueryInterface( object, &IID_IGeometry, (void **)&geometry ))) return NULL;
+    if (geometry->lpVtbl == &geometry_vtbl) impl = CONTAINING_RECORD( geometry, struct geometry, IGeometry_iface );
+    IGeometry_Release( geometry );
+    return impl;
+}
+
+static void geometry_figures( struct geometry *geometry, struct shape *shape )
+{
+    struct figure *figure;
+    int i;
+
+    free_figures( shape );
+    if (!geometry || !(figure = new_figure( shape ))) return;
+    switch (geometry->kind)
+    {
+    case GEOMETRY_RECTANGLE:
+        add_point( figure, geometry->rect.X, geometry->rect.Y );
+        add_point( figure, geometry->rect.X + geometry->rect.Width, geometry->rect.Y );
+        add_point( figure, geometry->rect.X + geometry->rect.Width, geometry->rect.Y + geometry->rect.Height );
+        add_point( figure, geometry->rect.X, geometry->rect.Y + geometry->rect.Height );
+        figure->closed = TRUE;
+        break;
+    case GEOMETRY_ELLIPSE:
+        for (i = 0; i < 64; i++)
+        {
+            double a = i * 2 * 3.14159265358979323846 / 64;
+            add_point( figure, geometry->center.X + cos( a ) * geometry->radius_x, geometry->center.Y + sin( a ) * geometry->radius_y );
+        }
+        figure->closed = TRUE;
+        break;
+    case GEOMETRY_LINE:
+        add_point( figure, geometry->start.X, geometry->start.Y );
+        add_point( figure, geometry->end.X, geometry->end.Y );
+        break;
+    }
