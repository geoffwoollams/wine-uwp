+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A {Binding} on a property: its source is Source, the element named ElementName, or the inherited DataContext;
+ * its Path ("Name", "Item.Name", or empty for the source itself) is read through ICustomPropertyProvider (C#
+ * and [Bindable] classes), the app's IXamlMetadataProvider (C++/CX and C++/WinRT), or our own elements'
+ * properties. INotifyPropertyChanged on the object holding the last member, and our elements' own changes,
+ * update the target; TwoWay bindings write the target's changes back. Converter, ConverterParameter,
+ * FallbackValue and TargetNullValue are supported; RelativeSource, StringFormat-less formatting, indexers and
+ * UpdateSourceTrigger aren't. Bindings are evaluated on the target's next layout after anything they depend on
+ * changes (attaching, DataContext, being added to a tree). */
+
+struct data_binding
+{
+    IPropertyChangedEventHandler IPropertyChangedEventHandler_iface;
+    struct data_binding *next;
+    struct xaml_element *target;       /* not referenced: the binding goes when the target does */
+    WCHAR property[96];
+    IInspectable *binding;             /* the Binding object, referenced */
+    WCHAR path[256];
+    WCHAR element_name[96];
+    BindingMode mode;
+    IInspectable *leaf;                /* holds the last path member; referenced */
+    WCHAR leaf_member[96];
+    INotifyPropertyChanged *notify;    /* the leaf's, while subscribed */
+    EventRegistrationToken token;
+    struct xaml_element *source_element;   /* our element the value comes from; not referenced */
+    BOOL updating;
+};
+
+static struct data_binding *bindings;
+
+static inline struct data_binding *impl_from_IPropertyChangedEventHandler( IPropertyChangedEventHandler *iface )
+{
+    return CONTAINING_RECORD( iface, struct data_binding, IPropertyChangedEventHandler_iface );
+}
+
+static HRESULT WINAPI handler_QueryInterface( IPropertyChangedEventHandler *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IPropertyChangedEventHandler ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* the binding owns the handler: the source's references don't keep it */
+static ULONG WINAPI handler_AddRef( IPropertyChangedEventHandler *iface ) { return 2; }
+static ULONG WINAPI handler_Release( IPropertyChangedEventHandler *iface ) { return 1; }
+
+static void evaluate( struct data_binding *b );
+
+static HRESULT WINAPI handler_Invoke( IPropertyChangedEventHandler *iface, IInspectable *sender, IPropertyChangedEventArgs *args )
+{
+    struct data_binding *b = impl_from_IPropertyChangedEventHandler( iface );
+    HSTRING name = NULL;
+    const WCHAR *str;
+
+    if (args) IPropertyChangedEventArgs_get_PropertyName( args, &name );
+    str = WindowsGetStringRawBuffer( name, NULL );
+    TRACE( "%p: %s changed.\n", b, debugstr_w(str) );
+    if (!*str || !wcscmp( str, b->leaf_member )) evaluate( b );
+    WindowsDeleteString( name );
+    return S_OK;
+}
+
+static const IPropertyChangedEventHandlerVtbl handler_vtbl =
+{
+    handler_QueryInterface,
+    handler_AddRef,
+    handler_Release,
+    handler_Invoke,
+};
+
+static void unsubscribe( struct data_binding *b )
+{
+    if (b->notify)
+    {
+        INotifyPropertyChanged_remove_PropertyChanged( b->notify, b->token );
+        INotifyPropertyChanged_Release( b->notify );
+        b->notify = NULL;
+    }
+    if (b->leaf) IInspectable_Release( b->leaf );
+    b->leaf = NULL;
+    b->source_element = NULL;
+}
+
+/* the app's metadata for object's class: its IXamlMember for name */
+static IXamlMember *xaml_member( IInspectable *object, const WCHAR *name )
+{
+    IXamlMetadataProvider *provider;
+    IXamlMember *member = NULL;
+    IXamlType *type = NULL;
+    HSTRING class_name = NULL, str;
+
+    if (!(provider = app_metadata_provider())) return NULL;
+    if (SUCCEEDED(IInspectable_GetRuntimeClassName( object, &class_name )) && class_name &&
+        SUCCEEDED(IXamlMetadataProvider_GetXamlTypeByFullName( provider, class_name, &type )) && type)
+    {
+        WindowsCreateString( name, wcslen( name ), &str );
+        IXamlType_GetMember( type, str, &member );
+        WindowsDeleteString( str );
+        IXamlType_Release( type );
+    }
+    WindowsDeleteString( class_name );
+    IXamlMetadataProvider_Release( provider );
+    return member;
+}
+
+static ICustomProperty *custom_property( IInspectable *object, const WCHAR *name )
+{
+    ICustomPropertyProvider *provider;
+    ICustomProperty *prop = NULL;
+    HSTRING str;
+
+    if (FAILED(IInspectable_QueryInterface( object, &IID_ICustomPropertyProvider, (void **)&provider ))) return NULL;
+    WindowsCreateString( name, wcslen( name ), &str );
+    ICustomPropertyProvider_GetCustomProperty( provider, str, &prop );
+    WindowsDeleteString( str );
+    ICustomPropertyProvider_Release( provider );
+    return prop;
+}
+
+/* object.name; referenced, or NULL */
+static IInspectable *read_member( IInspectable *object, const WCHAR *name, BOOL *found )
+{
+    IInspectable *value = NULL;
+    ICustomProperty *prop;
+    IXamlMember *member;
+
+    *found = TRUE;
+    if (element_from_object( object ) || bag_type_of( object )) return markup_get_value( object, name );
+    if ((prop = custom_property( object, name )))
+    {
+        ICustomProperty_GetValue( prop, object, &value );
+        ICustomProperty_Release( prop );
+        return value;
+    }
+    if ((member = xaml_member( object, name )))
+    {
+        IXamlMember_GetValue( member, object, &value );
+        IXamlMember_Release( member );
+        return value;
+    }
+    *found = FALSE;
+    WARN( "can't read %s from %p.\n", debugstr_w(name), object );
+    return NULL;
+}
+
+static void write_member( IInspectable *object, const WCHAR *name, IInspectable *value )
+{
+    ICustomProperty *prop;
+    IXamlMember *member;
+    HRESULT hr = E_FAIL;
+
+    if (element_from_object( object )) { markup_set_value( object, name, value, FALSE ); return; }
+    if ((prop = custom_property( object, name )))
+    {
+        hr = ICustomProperty_SetValue( prop, object, value );
+        ICustomProperty_Release( prop );
+    }
+    else if ((member = xaml_member( object, name )))
+    {
+        hr = IXamlMember_SetValue( member, object, value );
+        IXamlMember_Release( member );
+    }
+    if (FAILED(hr)) WARN( "can't write %s back to %p, hr %#lx.\n", debugstr_w(name), object, hr );
+}
+
+static IInspectable *box_string( const WCHAR *str )
+{
+    static const WCHAR name[] = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics;
+    IInspectable *value = NULL;
+    HSTRING_HEADER header;
+    HSTRING class_name, hstr;
+
+    WindowsCreateStringReference( name, wcslen( name ), &header, &class_name );
+    if (FAILED(RoGetActivationFactory( class_name, &IID_IPropertyValueStatics, (void **)&statics ))) return NULL;
+    WindowsCreateString( str, wcslen( str ), &hstr );
+    IPropertyValueStatics_CreateString( statics, hstr, &value );
+    WindowsDeleteString( hstr );
+    IPropertyValueStatics_Release( statics );
+    return value;
+}
+
+/* text properties take any value as text, as the binding engine's conversion does */
+static IInspectable *value_for_target( const WCHAR *property, IInspectable *value )
+{
+    static const WCHAR *text_properties[] = { L"Text", L"Header", L"OnContent", L"OffContent" };
+    IPropertyValue *pv;
+    PropertyType type;
+    WCHAR buf[64];
+    double d;
+    INT32 i;
+    boolean b;
+    UINT32 n;
+
+    for (n = 0; n < ARRAY_SIZE(text_properties); n++) if (!wcscmp( property, text_properties[n] )) break;
+    if (n == ARRAY_SIZE(text_properties) || !value) return NULL;
+    if (FAILED(IInspectable_QueryInterface( value, &IID_IPropertyValue, (void **)&pv ))) return NULL;
+    buf[0] = 0;
+    IPropertyValue_get_Type( pv, &type );
+    switch (type)
+    {
+    case PropertyType_Double: case PropertyType_Single:
+        if (SUCCEEDED(IPropertyValue_GetDouble( pv, &d ))) swprintf( buf, ARRAY_SIZE(buf), L"%g", d );
+        break;
+    case PropertyType_Int32: case PropertyType_UInt32: case PropertyType_Int64: case PropertyType_UInt8: case PropertyType_Int16:
+        if (SUCCEEDED(IPropertyValue_GetInt32( pv, &i ))) swprintf( buf, ARRAY_SIZE(buf), L"%d", i );
+        break;
+    case PropertyType_Boolean:
+        if (SUCCEEDED(IPropertyValue_GetBoolean( pv, &b ))) lstrcpyW( buf, b ? L"True" : L"False" );
+        break;
+    default:
+        break;
+    }
+    IPropertyValue_Release( pv );
+    return buf[0] ? box_string( buf ) : NULL;
+}
+
+static IInspectable *convert( struct data_binding *b, IInspectable *value, BOOL back )
+{
+    IInspectable *converter = bag_get_object( b->binding, L"Converter" ), *param = bag_get_object( b->binding, L"ConverterParameter" );
+    IInspectable *result = NULL, *param_str = NULL;
+    IValueConverter *vc;
+    TypeName type = {0};
+    WCHAR buf[256];
+
+    if (!converter || FAILED(IInspectable_QueryInterface( converter, &IID_IValueConverter, (void **)&vc )))
+    {
+        if (value) IInspectable_AddRef( value );
+        return value;
+    }
+    if (!param && bag_get_string( b->binding, L"ConverterParameter", buf, ARRAY_SIZE(buf) )) param = param_str = box_string( buf );
+    WindowsCreateString( L"Object", 6, &type.Name );
+    type.Kind = TypeKind_Primitive;
+    if (back) IValueConverter_ConvertBack( vc, value, type, param, NULL, &result );
+    else IValueConverter_Convert( vc, value, type, param, NULL, &result );
+    WindowsDeleteString( type.Name );
+    if (param_str) IInspectable_Release( param_str );
+    IValueConverter_Release( vc );
+    return result;
+}
+
+static void set_target( struct data_binding *b, IInspectable *value )
+{
+    IInspectable *text = value_for_target( b->property, value );
+
+    b->updating = TRUE;
+    markup_set_value( b->target->outer, b->property, text ? text : value, FALSE );
+    b->updating = FALSE;
+    if (text) IInspectable_Release( text );
+}
+
+static void set_fallback( struct data_binding *b, const WCHAR *name )
+{
+    IInspectable *object = bag_get_object( b->binding, name );
+    WCHAR buf[256];
+
+    if (object) set_target( b, object );
+    else if (bag_get_string( b->binding, name, buf, ARRAY_SIZE(buf) ))
+    {
+        b->updating = TRUE;
+        markup_set_string( b->target->outer, b->property, buf, FALSE );
+        b->updating = FALSE;
+    }
+}
+
+static void evaluate( struct data_binding *b )
+{
+    IInspectable *source, *object, *next, *value = NULL, *converted;
+    WCHAR segment[96];
+    const WCHAR *p, *dot;
+    struct xaml_element *element;
+    BOOL found = TRUE;
+
+    unsubscribe( b );
+    if (b->element_name[0])
+    {
+        element = element_find_name( b->target, b->element_name );
+        source = element ? element->outer : NULL;
+        if (!element) WARN( "ElementName %s not found.\n", debugstr_w(b->element_name) );
+    }
+    else if (!(source = bag_get_object( b->binding, L"Source" ))) source = element_data_context( b->target );
+    if (!source)
+    {
+        set_fallback( b, L"FallbackValue" );
+        return;
+    }
+
+    /* the path up to its last member */
+    IInspectable_AddRef( (object = source) );
+    for (p = b->path; object && (dot = wcschr( p, '.' )); p = dot + 1)
+    {
+        lstrcpynW( segment, p, min( ARRAY_SIZE(segment), dot - p + 1 ) );
+        next = read_member( object, segment, &found );
+        IInspectable_Release( object );
+        object = next;
+    }
+    if (!object)
+    {
+        set_fallback( b, L"FallbackValue" );
+        return;
+    }
+    if (!*p) value = object;   /* {Binding} or {Binding Path=.}: the source itself */
+    else
+    {
+        lstrcpynW( b->leaf_member, p, ARRAY_SIZE(b->leaf_member) );
+        b->leaf = object;
+        value = read_member( object, p, &found );
+        if ((element = element_from_object( object ))) b->source_element = element;
+        else if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_INotifyPropertyChanged, (void **)&b->notify )) &&
+                 FAILED(INotifyPropertyChanged_add_PropertyChanged( b->notify, &b->IPropertyChangedEventHandler_iface, &b->token )))
+        {
+            INotifyPropertyChanged_Release( b->notify );
+            b->notify = NULL;
+        }
+    }
+    if (!found)
+    {
+        if (value) IInspectable_Release( value );
+        set_fallback( b, L"FallbackValue" );
+        return;
+    }
+    converted = convert( b, value, FALSE );
+    if (value) IInspectable_Release( value );
+    TRACE( "%p: %s.%s = %p.\n", b, debugstr_w(b->target->class_name), debugstr_w(b->property), converted );
+    if (!converted && bag_has_value( b->binding, L"TargetNullValue" )) set_fallback( b, L"TargetNullValue" );
+    else set_target( b, converted );
+    if (converted) IInspectable_Release( converted );
+    if (b->mode == BindingMode_OneTime) unsubscribe( b );
+}
+
+static void free_binding( struct data_binding *b )
+{
+    unsubscribe( b );
+    IInspectable_Release( b->binding );
+    free( b );
+}
+
+void binding_attach( IInspectable *target, const WCHAR *property, IInspectable *binding )
+{
+    struct xaml_element *element = element_from_object( target );
+    struct data_binding *b, **p;
+    WCHAR mode[32];
+
+    if (!element)
+    {
+        FIXME( "{Binding} on %p.%s, which isn't an element, is not supported.\n", target, debugstr_w(property) );
+        return;
+    }
+    for (p = &bindings; *p; p = &(*p)->next)
+    {
+        if ((*p)->target != element || wcscmp( (*p)->property, property )) continue;
+        b = *p;
+        *p = b->next;
+        free_binding( b );
+        break;
+    }
+    if (!(b = calloc( 1, sizeof(*b) ))) return;
+    b->IPropertyChangedEventHandler_iface.lpVtbl = &handler_vtbl;
+    b->target = element;
+    lstrcpynW( b->property, property, ARRAY_SIZE(b->property) );
+    IInspectable_AddRef( (b->binding = binding) );
+    bag_get_string( binding, L"Path", b->path, ARRAY_SIZE(b->path) );
+    if (!wcscmp( b->path, L"." )) b->path[0] = 0;
+    bag_get_string( binding, L"ElementName", b->element_name, ARRAY_SIZE(b->element_name) );
+    b->mode = BindingMode_OneWay;
+    if (bag_get_string( binding, L"Mode", mode, ARRAY_SIZE(mode) ))
+    {
+        if (!wcsicmp( mode, L"TwoWay" ) || !wcscmp( mode, L"3" )) b->mode = BindingMode_TwoWay;
+        else if (!wcsicmp( mode, L"OneTime" ) || !wcscmp( mode, L"2" )) b->mode = BindingMode_OneTime;
+    }
+    if (bag_has_value( binding, L"RelativeSource" )) FIXME( "RelativeSource bindings are not supported.\n" );
+    TRACE( "%s.%s bound to %s (ElementName %s, mode %d).\n", debugstr_w(element->class_name), debugstr_w(property),
+           debugstr_w(b->path), debugstr_w(b->element_name), b->mode );
+    b->next = bindings;
+    bindings = b;
+    element->bindings_dirty = TRUE;
+    window_invalidate();
+}
+
+void element_bindings_refresh( struct xaml_element *element )
+{
+    struct data_binding *b;
+
+    element->bindings_dirty = FALSE;
+    for (b = bindings; b; b = b->next) if (b->target == element) evaluate( b );
+}
+
+void binding_detach_element( struct xaml_element *element )
+{
+    struct data_binding **p = &bindings, *b;
+
+    while ((b = *p))
+    {
+        if (b->source_element == element) b->source_element = NULL;
+        if (b->target == element)
+        {
+            *p = b->next;
+            free_binding( b );
+            continue;
+        }
+        p = &b->next;
+    }
+}
+
+void element_property_changed( IInspectable *object, const WCHAR *property )
+{
+    struct xaml_element *element = element_from_object( object );
+    IInspectable *value, *converted;
+    struct data_binding *b;
+
+    if (!element) return;
+    for (b = bindings; b; b = b->next)
+    {
+        if (b->source_element == element && !wcscmp( b->leaf_member, property ) && b->target != element)
+        {
+            evaluate( b );
+            continue;
+        }
+        if (b->target != element || b->updating || b->mode != BindingMode_TwoWay || wcscmp( b->property, property ) || !b->leaf)
+            continue;
+        /* TwoWay: the target changed, write it back */
+        value = markup_get_value( object, property );
+        converted = convert( b, value, TRUE );
+        TRACE( "%s.%s -> %p.%s.\n", debugstr_w(element->class_name), debugstr_w(property), b->leaf, debugstr_w(b->leaf_member) );
+        b->updating = TRUE;
+        write_member( b->leaf, b->leaf_member, converted );
+        b->updating = FALSE;
+        if (value) IInspectable_Release( value );
+        if (converted) IInspectable_Release( converted );
+    }
+}
+
+IInspectable *element_data_context( struct xaml_element *element )
+{
+    for (; element; element = element->parent) if (element->data_context_set) return element->data_context;
+    return NULL;
+}
+
+/* the DataContext in effect under element may have changed: evaluate the subtree's bindings again */
+void element_data_context_changed( struct xaml_element *element )
+{
+    UINT32 i, count;
+
+    element->bindings_dirty = TRUE;
+    if (!element->ops->child_count) return;
+    count = element->ops->child_count( element );
+    for (i = 0; i < count; i++)
+    {
+        struct xaml_element *child = element->ops->child_at( element, i );
+        if (child && (!child->data_context_set || child == element)) element_data_context_changed( child );
+    }
+    window_invalidate();
+}
+
+/* Windows.UI.Xaml.Data.PropertyChangedEventArgs: apps raise PropertyChanged with these */
+
+struct changed_args
+{
+    IPropertyChangedEventArgs IPropertyChangedEventArgs_iface;
+    LONG ref;
+    HSTRING name;
+};
+
+static inline struct changed_args *impl_from_IPropertyChangedEventArgs( IPropertyChangedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct changed_args, IPropertyChangedEventArgs_iface );
+}
+
+static HRESULT WINAPI changed_args_QueryInterface( IPropertyChangedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IPropertyChangedEventArgs ))
+    {
+        *out = iface;
+        IPropertyChangedEventArgs_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI changed_args_AddRef( IPropertyChangedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IPropertyChangedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI changed_args_Release( IPropertyChangedEventArgs *iface )
+{
+    struct changed_args *impl = impl_from_IPropertyChangedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->name );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI changed_args_GetIids( IPropertyChangedEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI changed_args_GetRuntimeClassName( IPropertyChangedEventArgs *iface, HSTRING *name )
+{
+    const WCHAR *str = RuntimeClass_Windows_UI_Xaml_Data_PropertyChangedEventArgs;
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI changed_args_GetTrustLevel( IPropertyChangedEventArgs *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI changed_args_get_PropertyName( IPropertyChangedEventArgs *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( impl_from_IPropertyChangedEventArgs( iface )->name, value );
+}
+
+static const struct IPropertyChangedEventArgsVtbl changed_args_vtbl =
+{
+    changed_args_QueryInterface,
+    changed_args_AddRef,
+    changed_args_Release,
+    changed_args_GetIids,
+    changed_args_GetRuntimeClassName,
+    changed_args_GetTrustLevel,
+    changed_args_get_PropertyName,
+};
+
+struct changed_args_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IPropertyChangedEventArgsFactory IPropertyChangedEventArgsFactory_iface;
+};
+
+static inline struct changed_args_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct changed_args_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct changed_args_statics *impl = impl_from_IActivationFactory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IPropertyChangedEventArgsFactory ))
+        *out = &impl->IPropertyChangedEventArgsFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE_( changed_args_factory, IPropertyChangedEventArgsFactory, struct changed_args_statics,
+                      impl_from_IPropertyChangedEventArgsFactory, IPropertyChangedEventArgsFactory_iface,
+                      &impl->IActivationFactory_iface )
+
+static HRESULT WINAPI changed_args_factory_CreateInstance( IPropertyChangedEventArgsFactory *iface, HSTRING name, IInspectable *outer,
+                                                           IInspectable **inner, IPropertyChangedEventArgs **value )
+{
+    struct changed_args *impl;
+
+    TRACE( "iface %p, name %s, outer %p.\n", iface, debugstr_hstring(name), outer );
+    if (outer) FIXME( "aggregation is not supported.\n" );
+    if (inner) *inner = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IPropertyChangedEventArgs_iface.lpVtbl = &changed_args_vtbl;
+    impl->ref = 1;
+    WindowsDuplicateString( name, &impl->name );
+    *value = &impl->IPropertyChangedEventArgs_iface;
+    return S_OK;
+}
+
+static const struct IPropertyChangedEventArgsFactoryVtbl changed_args_factory_vtbl =
+{
+    changed_args_factory_QueryInterface,
+    changed_args_factory_AddRef,
+    changed_args_factory_Release,
+    /* IInspectable methods */
+    changed_args_factory_GetIids,
+    changed_args_factory_GetRuntimeClassName,
+    changed_args_factory_GetTrustLevel,
+    /* IPropertyChangedEventArgsFactory methods */
+    changed_args_factory_CreateInstance,
+};
+
+static struct changed_args_statics changed_args_statics = { {&factory_vtbl}, {&changed_args_factory_vtbl} };
+IActivationFactory *property_changed_event_args_factory = &changed_args_statics.IActivationFactory_iface;
