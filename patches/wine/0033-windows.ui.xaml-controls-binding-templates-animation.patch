+HRESULT storyboard_query_interface( IInspectable *bag, void **extension, REFIID iid, void **out )
+{
+    struct storyboard *impl = *extension;
+
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IStoryboard ) && !IsEqualGUID( iid, &IID_ITimeline )) return E_NOINTERFACE;
+    if (!impl)
+    {
+        if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+        impl->IStoryboard_iface.lpVtbl = &storyboard_iface_vtbl;
+        impl->ITimeline_iface.lpVtbl = &timeline_vtbl;
+        impl->bag = bag;
+        impl->state = ClockState_Stopped;
+        impl->next = storyboards;
+        storyboards = impl;
+        *extension = impl;
+    }
+    *out = IsEqualGUID( iid, &IID_IStoryboard ) ? (void *)&impl->IStoryboard_iface : (void *)&impl->ITimeline_iface;
+    IInspectable_AddRef( bag );
+    return S_OK;
+}
+
+void storyboard_free( void *extension )
+{
+    struct storyboard *impl = extension, **p;
+
+    if (!impl) return;
+    stop_owner( impl->bag, FALSE );
+    for (p = &storyboards; *p; p = &(*p)->next) if (*p == impl) { *p = impl->next; break; }
+    event_list_clear( &impl->completed );
+    free( impl );
+}
