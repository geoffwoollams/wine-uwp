+};
+
+enum check_state
+{
+    CHECK_OFF,
+    CHECK_ON,
+    CHECK_INDETERMINATE,   /* IsChecked is null */
+};
+
+struct button
+{
+    struct xaml_element element;
+    IButton IButton_iface;
+    IButtonBase IButtonBase_iface;
+    IContentControl IContentControl_iface;
+    IControl IControl_iface;
+    IToggleButton IToggleButton_iface;
+    ICheckBox ICheckBox_iface;
+    IRadioButton IRadioButton_iface;
+    enum button_kind kind;
+
+    IInspectable *content;
+    IDataTemplate *content_template;
+    struct xaml_element *content_element;   /* content, when it is a UIElement */
+    HSTRING content_text;         /* when the content isn't a UIElement */
+    IBrush *background, *foreground, *border_brush;
+    Thickness border_thickness, padding;
+    double font_size;
+    FontWeight font_weight;
+    FontStyle font_style;
+    HorizontalAlignment content_horizontal;
+    VerticalAlignment content_vertical;
+    boolean enabled, pointer_over, pressed, captured;
+    ClickMode click_mode;
+    struct event_list click;
+    enum check_state check;
+    boolean three_state;
+    HSTRING group_name;
+    struct event_list checked, unchecked, indeterminate;
+
+    /* range.c: Slider, ProgressBar (RangeBase) and ToggleSwitch */
+    IRangeBase IRangeBase_iface;
+    ISlider ISlider_iface;
+    IProgressBar IProgressBar_iface;
+    IToggleSwitch IToggleSwitch_iface;
+    double minimum, maximum, value, small_change, large_change, step;
+    Orientation orientation;
+    boolean indeterminate_progress, show_error, show_paused;
+    struct event_list value_changed;
+    boolean is_on;
+    IInspectable *header, *on_content, *off_content;
+    struct event_list toggled;
+};
+
+static inline struct button *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct button, element );
+}
+
+/* a colour of the built-in look; paint is FALSE for transparent */
+struct look
+{
+    COLORREF color;
+    BOOL paint;
+};
+
+void set_look( struct look *look, COLORREF color );
+void brush_look( IBrush *brush, struct look *look );
+void resource_look( struct button *impl, struct look *look, const WCHAR *format, ... );
+const WCHAR *state_suffix( struct button *impl );
