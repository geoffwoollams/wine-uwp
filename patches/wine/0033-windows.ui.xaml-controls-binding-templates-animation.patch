+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* Each animation of a storyboard becomes a track: key frames of doubles, colours or objects over time, sampled
+ * by a ~60 Hz thread timer and set on the target property (as an animated value). From/To/By animations are two
+ * key frames; linear, easing and spline key frames are all interpolated linearly; discrete and object key
+ * frames hold. BeginTime, AutoReverse and RepeatBehavior (Forever, or a count) are honoured; easing functions
+ * and SpeedRatio are not. A track's owner is the visual state group that started it, or the Storyboard object. */
+
+enum frame_kind
+{
+    FRAME_DOUBLE,
+    FRAME_COLOR,
+    FRAME_OBJECT,
+};
+
+struct frame
+{
+    double time;             /* ms */
+    BOOL discrete;
+    double d;
+    Color c;
+    IInspectable *object;    /* referenced */
+    WCHAR *string;           /* an object frame given as a string ("Visible") */
+};
+
+struct track
+{
+    struct track *next;
+    IInspectable *owner;     /* not referenced */
+    IInspectable *target;    /* referenced */
+    WCHAR property[96];
+    BOOL brush_color;        /* a (Brush).(SolidColorBrush.Color) path: set new brushes */
+    enum frame_kind kind;
+    struct frame *frames;
+    UINT32 count;
+    double begin, duration;  /* ms */
+    BOOL auto_reverse;
+    double repeat;           /* number of iterations, INFINITY for Forever */
+    ULONGLONG start;
+    IInspectable *base;      /* the value before, restored by Storyboard.Stop; referenced */
+    BOOL has_base;
+};
+
+static struct track *tracks;
+static UINT_PTR timer;
+
+static void CALLBACK tick_proc( HWND hwnd, UINT msg, UINT_PTR id, DWORD time );
+
+/* "h:m:s.fff", "m:s", or seconds; FALSE for "Automatic" */
+static BOOL parse_time( const WCHAR *str, double *ms )
+{
+    double part[3] = {0};
+    const WCHAR *p = str;
+    WCHAR *end;
+    int n = 0;
+
+    if (!str || !*str || !wcsicmp( str, L"Automatic" ) || !wcsicmp( str, L"Forever" )) return FALSE;
+    while (n < 3)
+    {
+        part[n++] = wcstod( p, &end );
+        if (end == p) return FALSE;
+        if (*end != ':') break;
+        p = end + 1;
+    }
+    if (n == 3) *ms = ((part[0] * 60 + part[1]) * 60 + part[2]) * 1000;
+    else if (n == 2) *ms = (part[0] * 60 + part[1]) * 1000;
+    else *ms = part[0] * 1000;
+    return TRUE;
+}
+
+static BOOL bag_time( IInspectable *bag, const WCHAR *name, double *ms )
+{
+    WCHAR buf[64];
+    return bag_get_string( bag, name, buf, ARRAY_SIZE(buf) ) && parse_time( buf, ms );
+}
+
+static IInspectable *box_double( double d )
+{
+    static const WCHAR name[] = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics;
+    IInspectable *value = NULL;
+    HSTRING_HEADER header;
+    HSTRING class_name;
+
+    WindowsCreateStringReference( name, wcslen( name ), &header, &class_name );
+    if (FAILED(RoGetActivationFactory( class_name, &IID_IPropertyValueStatics, (void **)&statics ))) return NULL;
+    IPropertyValueStatics_CreateDouble( statics, d, &value );
+    IPropertyValueStatics_Release( statics );
+    return value;
+}
+
+static IInspectable *create_brush( Color color )
+{
+    ISolidColorBrushFactory *factory;
+    ISolidColorBrush *brush = NULL;
+
+    if (FAILED(IActivationFactory_QueryInterface( solid_color_brush_factory, &IID_ISolidColorBrushFactory, (void **)&factory )))
+        return NULL;
+    ISolidColorBrushFactory_CreateInstanceWithColor( factory, color, &brush );
+    ISolidColorBrushFactory_Release( factory );
+    return (IInspectable *)brush;
+}
+
+static BOOL unbox_double( IInspectable *value, double *d )
+{
+    IPropertyValue *pv;
+    BOOL ok = FALSE;
+
+    if (value && SUCCEEDED(IInspectable_QueryInterface( value, &IID_IPropertyValue, (void **)&pv )))
+    {
+        ok = SUCCEEDED(IPropertyValue_GetDouble( pv, d ));
+        IPropertyValue_Release( pv );
+    }
+    return ok;
+}
+
+static BOOL unbox_color( IInspectable *value, Color *c )
+{
+    IBrush *brush;
+    BOOL ok = FALSE;
+
+    if (value && SUCCEEDED(IInspectable_QueryInterface( value, &IID_IBrush, (void **)&brush )))
+    {
+        ok = brush_get_color( brush, c );
+        IBrush_Release( brush );
+    }
+    return ok;
+}
+
+static void free_track( struct track *track )
+{
+    UINT32 i;
+
+    for (i = 0; i < track->count; i++)
+    {
+        if (track->frames[i].object) IInspectable_Release( track->frames[i].object );
+        free( track->frames[i].string );
+    }
+    free( track->frames );
+    if (track->base) IInspectable_Release( track->base );
+    IInspectable_Release( track->target );
+    free( track );
+}
+
+static struct frame *add_frame( struct track *track, double time )
+{
+    struct frame *frames = realloc( track->frames, (track->count + 1) * sizeof(*frames) );
+    if (!frames) return NULL;
+    track->frames = frames;
+    memset( &frames[track->count], 0, sizeof(*frames) );
+    frames[track->count].time = time;
+    return &frames[track->count++];
+}
+
+/* a key frame's or From/To/By value */
+static BOOL frame_value( struct track *track, IInspectable *bag, const WCHAR *name, struct frame *frame )
+{
+    WCHAR buf[256];
+    IInspectable *object;
+
+    switch (track->kind)
+    {
+    case FRAME_DOUBLE: return bag_get_double( bag, name, &frame->d );
+    case FRAME_COLOR: return bag_get_color( bag, name, &frame->c );
+    default:
+        if ((object = bag_get_object( bag, name ))) IInspectable_AddRef( (frame->object = object) );
+        else if (bag_get_string( bag, name, buf, ARRAY_SIZE(buf) )) frame->string = wcsdup( buf );
+        else return FALSE;
+        return TRUE;
+    }
+}
+
+static void base_value( struct track *track, struct frame *frame )
+{
+    switch (track->kind)
+    {
+    case FRAME_DOUBLE: unbox_double( track->base, &frame->d ); break;
+    case FRAME_COLOR: unbox_color( track->base, &frame->c ); break;
+    default: if (track->base) IInspectable_AddRef( (frame->object = track->base) ); break;
+    }
+}
+
+static void schedule(void)
+{
+    if (tracks && !timer) timer = SetTimer( NULL, 0, 16, tick_proc );
+}
+
+/* start the animation anim on target.property, owned by owner; nothing for zero-length animations */
+void animation_start_track( IInspectable *owner, IInspectable *anim, IInspectable *target, const WCHAR *property, BOOL brush_color )
+{
+    const WCHAR *type = bag_type_of( anim );
+    struct track *track;
+    struct frame *frame;
+    double by, ms;
+    WCHAR buf[64];
+    UINT32 i, count;
+
+    if (!type || !target) return;
+    if (!(track = calloc( 1, sizeof(*track) ))) return;
+    track->owner = owner;
+    IInspectable_AddRef( (track->target = target) );
+    lstrcpynW( track->property, property, ARRAY_SIZE(track->property) );
+    track->brush_color = brush_color;
+    track->kind = wcsstr( type, L"Double" ) ? FRAME_DOUBLE : wcsstr( type, L"Color" ) ? FRAME_COLOR : FRAME_OBJECT;
+    track->base = markup_get_value( target, property );
+    track->repeat = 1;
+    bag_time( anim, L"BeginTime", &track->begin );
+    if (bag_get_string( anim, L"AutoReverse", buf, ARRAY_SIZE(buf) )) track->auto_reverse = !wcsicmp( buf, L"True" );
+    if (bag_get_string( anim, L"RepeatBehavior", buf, ARRAY_SIZE(buf) ))
+    {
+        if (!wcsicmp( buf, L"Forever" )) track->repeat = INFINITY;
+        else if (wcschr( buf, 'x' )) track->repeat = max( 0.0, wcstod( buf, NULL ) );
+    }
+
+    if (wcsstr( type, L"UsingKeyFrames" ))
+    {
+        count = bag_get_item_count( anim, L"KeyFrames" );
+        for (i = 0; i < count; i++)
+        {
+            IInspectable *kf = bag_get_item( anim, L"KeyFrames", i );
+            const WCHAR *kf_type = bag_type_of( kf );
+            if (!bag_time( kf, L"KeyTime", &ms )) ms = 0;
+            if (i == 0 && ms > 0 && track->kind != FRAME_OBJECT && kf_type && wcsncmp( kf_type, L"Discrete", 8 ))
+            {
+                /* a first key frame after 0 starts from the current value */
+                if ((frame = add_frame( track, 0 ))) base_value( track, frame );
+            }
+            if (!(frame = add_frame( track, ms ))) break;
+            frame->discrete = track->kind == FRAME_OBJECT || (kf_type && !wcsncmp( kf_type, L"Discrete", 8 ));
+            if (!frame_value( track, kf, L"Value", frame )) track->count--;
+        }
+        track->duration = track->count ? track->frames[track->count - 1].time : 0;
+        if (bag_time( anim, L"Duration", &ms )) track->duration = ms;
+    }
+    else
+    {
+        /* From/To/By; a Duration of Automatic is 1 s */
+        if (!bag_time( anim, L"Duration", &track->duration )) track->duration = 1000;
+        if ((frame = add_frame( track, 0 )) && !frame_value( track, anim, L"From", frame )) base_value( track, frame );
+        if ((frame = add_frame( track, track->duration )) && !frame_value( track, anim, L"To", frame ))
+        {
+            *frame = track->frames[0];
+            frame->time = track->duration;
+            if (track->kind == FRAME_DOUBLE && bag_get_double( anim, L"By", &by )) frame->d += by;
+            if (frame->object) IInspectable_AddRef( frame->object );
+            if (frame->string) frame->string = wcsdup( frame->string );
+        }
+    }
+    if (!track->count || (track->duration <= 0 && track->begin <= 0 && track->repeat == 1))
+    {
+        free_track( track );   /* nothing to time: the end value is set at once */
+        return;
+    }
+    TRACE( "%s on %p.%s: %u frames over %.0f ms.\n", debugstr_w(type), target, debugstr_w(property), track->count, track->duration );
+    track->start = GetTickCount64();
+    track->next = tracks;
+    tracks = track;
+    schedule();
+}
+
+static void apply( struct track *track, const struct frame *a, const struct frame *b, double f )
+{
+    IInspectable *value = NULL;
+    Color c;
+
+    switch (track->kind)
+    {
+    case FRAME_DOUBLE:
+        value = box_double( b ? a->d + (b->d - a->d) * f : a->d );
+        markup_set_value( track->target, track->property, value, TRUE );
+        break;
+    case FRAME_COLOR:
+        c = a->c;
+        if (b)
+        {
+            c.A = a->c.A + (b->c.A - a->c.A) * f;
+            c.R = a->c.R + (b->c.R - a->c.R) * f;
+            c.G = a->c.G + (b->c.G - a->c.G) * f;
+            c.B = a->c.B + (b->c.B - a->c.B) * f;
+        }
+        if (track->brush_color || !markup_set_color( track->target, track->property, c, TRUE ))
+        {
+            value = create_brush( c );
+            markup_set_value( track->target, track->property, value, TRUE );
+        }
+        break;
+    default:
+        if (a->string) markup_set_string( track->target, track->property, a->string, TRUE );
+        else markup_set_value( track->target, track->property, a->object, TRUE );
+        break;
+    }
+    if (value) IInspectable_Release( value );
+}
+
+/* sample a track at now; TRUE when it has finished (its last value set) */
+static BOOL sample( struct track *track, ULONGLONG now )
+{
+    double t = (double)(now - track->start) - track->begin, cycle = track->duration * (track->auto_reverse ? 2 : 1);
+    double iteration, local;
+    BOOL done = FALSE;
+    UINT32 i;
+
+    if (t < 0) return FALSE;
+    if (cycle <= 0) { local = track->duration; done = TRUE; }
+    else
+    {
+        iteration = floor( t / cycle );
+        if (iteration >= track->repeat) { done = TRUE; t = cycle * track->repeat; iteration = track->repeat - 1; }
+        local = t - iteration * cycle;
+        if (done) local = cycle;
+        if (local > track->duration) local = 2 * track->duration - local;   /* reversing */
+    }
+    for (i = 0; i + 1 < track->count && track->frames[i + 1].time <= local; i++);
+    if (i + 1 < track->count && !track->frames[i + 1].discrete && track->frames[i + 1].time > track->frames[i].time &&
+        local >= track->frames[i].time)
+        apply( track, &track->frames[i], &track->frames[i + 1],
+               (local - track->frames[i].time) / (track->frames[i + 1].time - track->frames[i].time) );
+    else apply( track, &track->frames[i], NULL, 0 );
+    return done;
+}
+
+static void owner_completed( IInspectable *owner );
+
+static void tick_all( IInspectable *only_owner )
+{
+    ULONGLONG now = GetTickCount64();
+    struct track **p = &tracks, *track;
+    IInspectable *finished[32];
+    UINT32 n = 0, i, j;
+
+    while ((track = *p))
+    {
+        if (only_owner && track->owner != only_owner) { p = &track->next; continue; }
+        if (sample( track, now ))
+        {
+            *p = track->next;
+            for (j = 0; j < n && finished[j] != track->owner; j++);
+            if (j == n && n < ARRAY_SIZE(finished)) finished[n++] = track->owner;
+            free_track( track );
+            continue;
+        }
+        p = &track->next;
+    }
+    /* an owner whose last track finished has completed */
+    for (i = 0; i < n; i++)
+    {
+        for (track = tracks; track && track->owner != finished[i]; track = track->next);
+        if (!track) owner_completed( finished[i] );
+    }
+    if (!tracks && timer)
+    {
+        KillTimer( NULL, timer );
+        timer = 0;
+    }
+    window_invalidate();
+}
+
+static void CALLBACK tick_proc( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    tick_all( NULL );
+}
+
+void animation_tick_owner( IInspectable *owner )
+{
+    struct track *track;
+    for (track = tracks; track && track->owner != owner; track = track->next);
+    if (track) tick_all( owner );
+}
+
+/* stop an owner's tracks where they are; with restore, put their targets' earlier values back */
+static void stop_owner( IInspectable *owner, BOOL restore )
+{
+    struct track **p = &tracks, *track;
+
+    while ((track = *p))
+    {
+        if (track->owner != owner) { p = &track->next; continue; }
+        *p = track->next;
+        if (restore) markup_set_value( track->target, track->property, track->base, TRUE );
+        free_track( track );
+    }
+}
+
+void animation_stop_owner( IInspectable *owner )
+{
+    stop_owner( owner, FALSE );
+}
+
+/* a ProgressBar's indeterminate look, redrawn at the animation rate while it is shown */
+void animation_request_frame(void)
+{
+    if (!timer) timer = SetTimer( NULL, 0, 16, tick_proc );
+}
+
+/* ---- Storyboard objects: IStoryboard and ITimeline on the markup's Storyboard ---- */
+
+struct storyboard
+{
+    IStoryboard IStoryboard_iface;
+    ITimeline ITimeline_iface;
+    IInspectable *bag;           /* the Storyboard; its reference count is ours */
+    struct event_list completed;
+    ClockState state;
+    struct storyboard *next;
+};
+
+static struct storyboard *storyboards;   /* for owner_completed */
+
+static void owner_completed( IInspectable *owner )
+{
+    struct storyboard *sb;
+    UINT32 i;
+
+    for (sb = storyboards; sb && sb->bag != owner; sb = sb->next);
+    if (!sb) return;
+    sb->state = ClockState_Filling;
+    TRACE( "storyboard %p completed.\n", sb );
+    for (i = 0; i < sb->completed.count; i++)
+    {
+        IEventHandler_IInspectable *handler = (IEventHandler_IInspectable *)sb->completed.handlers[i];
+        if (handler) IEventHandler_IInspectable_Invoke( handler, (IInspectable *)&sb->IStoryboard_iface, NULL );
+    }
+}
+
+DEFINE_IINSPECTABLE_( storyboard_iface, IStoryboard, struct storyboard, impl_from_IStoryboard, IStoryboard_iface, impl->bag )
+
+static HRESULT WINAPI storyboard_iface_get_Children( IStoryboard *iface, __FIVector_1_Windows__CUI__CXaml__CMedia__CAnimation__CTimeline **value )
+{
+    FIXME( "iface %p: Children from code are not supported.\n", iface );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI storyboard_iface_Seek( IStoryboard *iface, TimeSpan offset )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI storyboard_iface_Stop( IStoryboard *iface )
+{
+    struct storyboard *impl = impl_from_IStoryboard( iface );
+
+    TRACE( "iface %p.\n", iface );
+    stop_owner( impl->bag, TRUE );
+    impl->state = ClockState_Stopped;
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI storyboard_iface_Begin( IStoryboard *iface )
+{
+    struct storyboard *impl = impl_from_IStoryboard( iface );
+    struct xaml_element *scope = bag_namescope( impl->bag ), *element;
+    WCHAR name[96], path[256], property[96];
+    UINT32 i, count = bag_get_item_count( impl->bag, L"Children" );
+    BOOL brush_color;
+
+    TRACE( "iface %p, %u animations.\n", iface, count );
+    stop_owner( impl->bag, FALSE );
+    for (i = 0; i < count; i++)
+    {
+        IInspectable *anim = bag_get_item( impl->bag, L"Children", i );
+        if (!bag_get_string( anim, L"TargetName", name, ARRAY_SIZE(name) ) ||
+            !bag_get_string( anim, L"TargetProperty", path, ARRAY_SIZE(path) )) continue;
+        if (!scope || !(element = element_find_name( scope, name )))
+        {
+            WARN( "storyboard target %s not found.\n", debugstr_w(name) );
+            continue;
+        }
+        if (!markup_property_path( path, property, ARRAY_SIZE(property), &brush_color ))
+        {
+            FIXME( "animating %s.%s is not supported.\n", debugstr_w(name), debugstr_w(path) );
+            continue;
+        }
+        animation_start_track( impl->bag, anim, element->outer, property, brush_color );
+    }
+    impl->state = ClockState_Active;
+    animation_tick_owner( impl->bag );
+    if (impl->state == ClockState_Active)
+    {
+        struct track *track;
+        for (track = tracks; track && track->owner != impl->bag; track = track->next);
+        if (!track) owner_completed( impl->bag );   /* nothing timed: done at once */
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI storyboard_iface_Pause( IStoryboard *iface )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return S_OK;
+}
+
+static HRESULT WINAPI storyboard_iface_Resume( IStoryboard *iface )
+{
+    FIXME( "iface %p stub!\n", iface );
