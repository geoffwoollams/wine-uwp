+/* group opacity: draw the subtree over a copy of what is under it, then blend that copy back at the opacity */
+static void render_with_opacity( struct xaml_element *element, struct layout_context *ctx )
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, (BYTE)(element->opacity * 255 + 0.5), 0 };
+    HDC target = ctx->hdc, mem;
+    struct xaml_element *saved;
+    HBITMAP bitmap, old;
+    POINT origin;
+    RECT r;
+
+    /* the subtree may draw outside its bounds a little (text overhang): take its parent's area if it has one */
+    element_device_rect( &element->bounds, ctx, &r );
+    InflateRect( &r, 2, 2 );
+    if (r.right <= r.left || r.bottom <= r.top) return;
+    mem = CreateCompatibleDC( target );
+    bitmap = CreateCompatibleBitmap( target, r.right - r.left, r.bottom - r.top );
+    old = SelectObject( mem, bitmap );
+    BitBlt( mem, 0, 0, r.right - r.left, r.bottom - r.top, target, r.left, r.top, SRCCOPY );
+    SetViewportOrgEx( mem, -r.left, -r.top, &origin );
+    saved = ctx->opacity_element;
+    ctx->hdc = mem;
+    ctx->opacity_element = element;
+    element_render( element, ctx );
+    ctx->opacity_element = saved;
+    ctx->hdc = target;
+    SetViewportOrgEx( mem, 0, 0, NULL );
+    GdiAlphaBlend( target, r.left, r.top, r.right - r.left, r.bottom - r.top, mem, 0, 0, r.right - r.left, r.bottom - r.top, blend );
+    SelectObject( mem, old );
+    DeleteObject( bitmap );
+    DeleteDC( mem );
+}
