+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* These draw the Windows 10 default look themselves, with the colours from WinUI's resource keys where the app
+ * defines them (SliderTrackValueFill, ToggleSwitchFillOn, ProgressBarForeground, ...); app templates for them,
+ * which rely on named parts and the controls' own code behind them, aren't used.
+ *
+ * Slider: a 2 px track (value part in the accent colour) and an 8 x 24 thumb, horizontal or vertical; pressing
+ * and dragging set Value, snapped to StepFrequency. ProgressBar: a 4 px bar; IsIndeterminate shows a moving
+ * segment. ToggleSwitch: a 40 x 20 rounded track with its knob, OffContent/OnContent ("Off"/"On") beside it and
+ * an optional Header above; a click toggles IsOn and raises Toggled. */
+
+#define SWITCH_WIDTH 40.0f
+#define SWITCH_HEIGHT 20.0f
+#define THUMB_LENGTH 8.0f
+#define THUMB_BREADTH 24.0f
+
+static const struct IRangeBaseVtbl range_base_vtbl;
+static const struct ISliderVtbl slider_vtbl;
+static const struct IProgressBarVtbl progress_bar_vtbl;
+static const struct IToggleSwitchVtbl toggle_switch_vtbl;
+
+BOOL is_range_kind( struct button *impl )
+{
+    return impl->kind == BUTTON_TOGGLE_SWITCH || impl->kind == BUTTON_SLIDER || impl->kind == BUTTON_PROGRESS;
+}
+
+/* RangeBaseValueChangedEventArgs */
+
+struct value_args
+{
+    IRangeBaseValueChangedEventArgs IRangeBaseValueChangedEventArgs_iface;
+    LONG ref;
+    double old_value, new_value;
+};
+
+static inline struct value_args *impl_from_IRangeBaseValueChangedEventArgs( IRangeBaseValueChangedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct value_args, IRangeBaseValueChangedEventArgs_iface );
+}
+
+static HRESULT WINAPI value_args_QueryInterface( IRangeBaseValueChangedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IRangeBaseValueChangedEventArgs ))
+    {
+        *out = iface;
+        IRangeBaseValueChangedEventArgs_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI value_args_AddRef( IRangeBaseValueChangedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IRangeBaseValueChangedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI value_args_Release( IRangeBaseValueChangedEventArgs *iface )
+{
+    struct value_args *impl = impl_from_IRangeBaseValueChangedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI value_args_GetIids( IRangeBaseValueChangedEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI value_args_GetRuntimeClassName( IRangeBaseValueChangedEventArgs *iface, HSTRING *name )
+{
+    const WCHAR *str = RuntimeClass_Windows_UI_Xaml_Controls_Primitives_RangeBaseValueChangedEventArgs;
+    return WindowsCreateString( str, wcslen( str ), name );
+}
+
+static HRESULT WINAPI value_args_GetTrustLevel( IRangeBaseValueChangedEventArgs *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI value_args_get_OldValue( IRangeBaseValueChangedEventArgs *iface, DOUBLE *value )
+{
+    *value = impl_from_IRangeBaseValueChangedEventArgs( iface )->old_value;
+    return S_OK;
+}
+
+static HRESULT WINAPI value_args_get_NewValue( IRangeBaseValueChangedEventArgs *iface, DOUBLE *value )
+{
+    *value = impl_from_IRangeBaseValueChangedEventArgs( iface )->new_value;
+    return S_OK;
+}
+
+static const struct IRangeBaseValueChangedEventArgsVtbl value_args_vtbl =
+{
+    value_args_QueryInterface,
+    value_args_AddRef,
+    value_args_Release,
+    value_args_GetIids,
+    value_args_GetRuntimeClassName,
+    value_args_GetTrustLevel,
+    value_args_get_OldValue,
+    value_args_get_NewValue,
+};
+
+/* Value, coerced into [Minimum, Maximum]; ValueChanged and bindings hear of a change */
+static void set_value( struct button *impl, double value )
+{
+    struct value_args *args;
+    double old = impl->value;
+    UINT32 i, count;
+    IUnknown **handlers;
+
+    value = min( max( value, impl->minimum ), impl->maximum );
+    if (value == old) return;
+    impl->value = value;
+    window_invalidate();
+    element_property_changed( impl->element.outer, L"Value" );
+    if (!(count = impl->value_changed.count) || !(args = calloc( 1, sizeof(*args) ))) return;
+    args->IRangeBaseValueChangedEventArgs_iface.lpVtbl = &value_args_vtbl;
+    args->ref = 1;
+    args->old_value = old;
+    args->new_value = value;
+    if ((handlers = calloc( count, sizeof(*handlers) )))
+    {
+        for (i = 0; i < count; i++) if ((handlers[i] = impl->value_changed.handlers[i])) IUnknown_AddRef( handlers[i] );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            IRangeBaseValueChangedEventHandler_Invoke( (IRangeBaseValueChangedEventHandler *)handlers[i], impl->element.outer,
+                                                       &args->IRangeBaseValueChangedEventArgs_iface );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+    IRangeBaseValueChangedEventArgs_Release( &args->IRangeBaseValueChangedEventArgs_iface );
+}
+
+void range_init( struct button *impl )
+{
+    impl->IRangeBase_iface.lpVtbl = &range_base_vtbl;
+    impl->ISlider_iface.lpVtbl = &slider_vtbl;
+    impl->IProgressBar_iface.lpVtbl = &progress_bar_vtbl;
+    impl->IToggleSwitch_iface.lpVtbl = &toggle_switch_vtbl;
+    impl->maximum = impl->kind == BUTTON_SLIDER || impl->kind == BUTTON_PROGRESS ? 100 : 0;
+    impl->small_change = impl->step = 1;
+    impl->large_change = 10;
+    impl->orientation = Orientation_Horizontal;
+    memset( &impl->padding, 0, sizeof(impl->padding) );
+    memset( &impl->border_thickness, 0, sizeof(impl->border_thickness) );
+    impl->element.vertical_alignment = impl->kind == BUTTON_PROGRESS ? VerticalAlignment_Center : VerticalAlignment_Stretch;
+    impl->element.horizontal_alignment = impl->kind == BUTTON_TOGGLE_SWITCH ? HorizontalAlignment_Left : HorizontalAlignment_Stretch;
+}
+
+void *range_default_iface( struct button *impl )
+{
+    switch (impl->kind)
+    {
+    case BUTTON_SLIDER: return &impl->ISlider_iface;
+    case BUTTON_PROGRESS: return &impl->IProgressBar_iface;
+    default: return &impl->IToggleSwitch_iface;
+    }
+}
+
+HRESULT range_query_interface( struct button *impl, REFIID iid, void **out )
+{
+    if ((impl->kind == BUTTON_SLIDER || impl->kind == BUTTON_PROGRESS) && IsEqualGUID( iid, &IID_IRangeBase ))
+        *out = &impl->IRangeBase_iface;
+    else if (impl->kind == BUTTON_SLIDER && IsEqualGUID( iid, &IID_ISlider )) *out = &impl->ISlider_iface;
+    else if (impl->kind == BUTTON_PROGRESS && IsEqualGUID( iid, &IID_IProgressBar )) *out = &impl->IProgressBar_iface;
+    else if (impl->kind == BUTTON_TOGGLE_SWITCH && IsEqualGUID( iid, &IID_IToggleSwitch )) *out = &impl->IToggleSwitch_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+void range_destroy( struct button *impl )
+{
+    if (!is_range_kind( impl )) return;
+    if (impl->header) IInspectable_Release( impl->header );
+    if (impl->on_content) IInspectable_Release( impl->on_content );
+    if (impl->off_content) IInspectable_Release( impl->off_content );
+    event_list_clear( &impl->value_changed );
+    event_list_clear( &impl->toggled );
+}
+
+static void text_format( struct button *impl, struct text_format *format )
+{
+    format->font_size = impl->font_size;
+    format->weight = impl->font_weight.Weight;
+    format->italic = FALSE;
+    format->wrap = FALSE;
+    format->alignment = TextAlignment_Left;
+}
+
+static HSTRING content_text( IInspectable *content, const WCHAR *fallback )
+{
+    HSTRING text = NULL;
+    if (content) text = object_to_text( content );
+    else WindowsCreateString( fallback, wcslen( fallback ), &text );
+    return text;
+}
+
+static float header_height( struct button *impl, struct layout_context *ctx, float *width )
+{
+    struct text_format format;
+    float w = 0, h = 0;
+    HSTRING text;
+
+    if (width) *width = 0;
+    if (!impl->header) return 0;
+    text = content_text( impl->header, L"" );
+    text_format( impl, &format );
+    text_measure( ctx, &format, text, INFINITY, &w, &h );
+    WindowsDeleteString( text );
+    if (width) *width = w;
+    return h + 4;
+}
+
+void range_measure( struct button *impl, struct layout_context *ctx, float avail_width, float avail_height,
+                    float *width, float *height )
+{
+    struct text_format format;
+    float w = 0, h = 0, hw;
+    HSTRING text;
+
+    switch (impl->kind)
+    {
+    case BUTTON_SLIDER:
+        if (impl->orientation == Orientation_Vertical)
+        {
+            *width = 32;
+            *height = isinf( avail_height ) ? 100 : avail_height;
+        }
+        else
+        {
+            *width = isinf( avail_width ) ? 100 : avail_width;
+            *height = 32;
+        }
+        break;
+    case BUTTON_PROGRESS:
+        *width = isinf( avail_width ) ? 100 : avail_width;
+        *height = 4;
+        break;
+    default:
+        text = content_text( impl->is_on ? impl->on_content : impl->off_content, impl->is_on ? L"On" : L"Off" );
+        text_format( impl, &format );
+        text_measure( ctx, &format, text, INFINITY, &w, &h );
+        WindowsDeleteString( text );
+        *height = 32 + header_height( impl, ctx, &hw );
+        *width = max( 154.0f, max( hw, SWITCH_WIDTH + 12 + w ) );   /* the default style's MinWidth 154 */
+        break;
+    }
+}
+
+static COLORREF base( struct layout_context *ctx, BYTE alpha )
+{
+    BYTE v = ctx->dark ? alpha : 255 - alpha;   /* the theme's base colour (black or white) over the page */
+    return RGB( v, v, v );
+}
+
+static IBrush *look_brush( const struct look *look )
+{
+    Color c = { look->paint ? 0xff : 0, GetRValue( look->color ), GetGValue( look->color ), GetBValue( look->color ) };
+    ISolidColorBrushFactory *factory;
+    ISolidColorBrush *brush = NULL;
+
+    if (FAILED(IActivationFactory_QueryInterface( solid_color_brush_factory, &IID_ISolidColorBrushFactory, (void **)&factory )))
+        return NULL;
+    ISolidColorBrushFactory_CreateInstanceWithColor( factory, c, &brush );
+    ISolidColorBrushFactory_Release( factory );
+    return (IBrush *)brush;
+}
+
+static void draw_shape( struct layout_context *ctx, const struct layout_rect *rect, float radius, BOOL ellipse,
+                        const struct look *fill, const struct look *stroke, float stroke_width )
+{
+    IBrush *fill_brush = fill && fill->paint ? look_brush( fill ) : NULL, *stroke_brush = stroke && stroke->paint ? look_brush( stroke ) : NULL;
+    Thickness t = { stroke_width, stroke_width, stroke_width, stroke_width };
+    CornerRadius r = { radius, radius, radius, radius };
+
+    element_draw_shape( ctx, rect, &r, ellipse, fill_brush, stroke_brush, &t );
+    if (fill_brush) IBrush_Release( fill_brush );
+    if (stroke_brush) IBrush_Release( stroke_brush );
+}
+
+static void render_slider( struct button *impl, struct layout_context *ctx )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+    BOOL vertical = impl->orientation == Orientation_Vertical;
+    double range = impl->maximum - impl->minimum, f = range > 0 ? (impl->value - impl->minimum) / range : 0;
+    const WCHAR *state = state_suffix( impl );
+    struct look track = {0}, value = {0}, thumb = {0};
+    struct layout_rect r, v, t;
+    float length = (vertical ? b->height : b->width) - THUMB_LENGTH;
+
+    set_look( &track, base( ctx, 0x66 ) );
+    set_look( &value, impl->enabled ? RGB(0, 120, 215) : base( ctx, 0x66 ) );
+    set_look( &thumb, !impl->enabled ? base( ctx, 0x66 ) : impl->pressed ? base( ctx, 0x99 ) : impl->pointer_over ? base( ctx, 0xff ) : RGB(0, 120, 215) );
+    resource_look( impl, &track, L"SliderTrackFill%s", state );
+    resource_look( impl, &value, L"SliderTrackValueFill%s", state );
+    resource_look( impl, &thumb, L"SliderThumbBackground%s", state );
+    if (impl->background) brush_look( impl->background, &track );
+    if (impl->foreground) brush_look( impl->foreground, &value );
+
+    if (vertical)
+    {
+        r.x = b->x + (b->width - 2) / 2; r.y = b->y + THUMB_LENGTH / 2; r.width = 2; r.height = length;
+        v = r; v.height = length * f; v.y = r.y + length - v.height;
+        t.x = b->x + (b->width - THUMB_BREADTH) / 2; t.y = b->y + length * (1 - f); t.width = THUMB_BREADTH; t.height = THUMB_LENGTH;
+    }
+    else
+    {
+        r.x = b->x + THUMB_LENGTH / 2; r.y = b->y + (b->height - 2) / 2; r.width = length; r.height = 2;
+        v = r; v.width = length * f;
+        t.x = b->x + length * f; t.y = b->y + (b->height - THUMB_BREADTH) / 2; t.width = THUMB_LENGTH; t.height = THUMB_BREADTH;
+    }
+    if (track.paint) element_fill_color( ctx, &r, track.color );
+    if (value.paint) element_fill_color( ctx, &v, value.color );
+    draw_shape( ctx, &t, THUMB_LENGTH / 2, FALSE, &thumb, NULL, 0 );
+}
+
+static void render_progress( struct button *impl, struct layout_context *ctx )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+    double range = impl->maximum - impl->minimum, f = range > 0 ? (impl->value - impl->minimum) / range : 0;
+    struct look track = {0}, fill = {0};
+    struct layout_rect r = *b;
+
+    set_look( &track, base( ctx, 0x33 ) );
+    set_look( &fill, impl->show_error ? RGB(0xe8, 0x11, 0x23) : impl->show_paused ? base( ctx, 0x99 ) : RGB(0, 120, 215) );
+    resource_look( impl, &track, L"ProgressBarBackground" );
+    resource_look( impl, &fill, L"ProgressBarForeground" );
+    if (impl->background) brush_look( impl->background, &track );
+    if (impl->foreground && !impl->show_error && !impl->show_paused) brush_look( impl->foreground, &fill );
+    if (impl->indeterminate_progress)
+    {
+        /* a fifth of the width sliding across, every 2 s */
+        double phase = (GetTickCount64() % 2000) / 2000.0;
+        r.width = b->width / 5;
+        r.x = b->x - r.width + (b->width + r.width) * phase;
+        if (r.x < b->x) { r.width -= b->x - r.x; r.x = b->x; }
+        if (r.x + r.width > b->x + b->width) r.width = b->x + b->width - r.x;
+        if (fill.paint && r.width > 0) element_fill_color( ctx, &r, fill.color );
+        animation_request_frame();
+        return;
+    }
+    if (track.paint) element_fill_color( ctx, b, track.color );
+    r.width = b->width * f;
+    if (fill.paint) element_fill_color( ctx, &r, fill.color );
+}
+
+static void render_switch( struct button *impl, struct layout_context *ctx )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+    const WCHAR *state = state_suffix( impl ), *on = impl->is_on ? L"On" : L"Off";
+    struct look fill = {0}, stroke = {0}, knob = {0}, text = { ctx->foreground, TRUE }, header = { ctx->foreground, TRUE };
+    struct layout_rect track, dot, rect;
+    struct text_format format;
+    float top = header_height( impl, ctx, NULL ), w, h;
+    HSTRING str;
+
+    if (impl->is_on)
+    {
+        set_look( &fill, !impl->enabled ? base( ctx, 0x33 ) : impl->pressed ? base( ctx, 0x99 ) : RGB(0, 120, 215) );
+        set_look( &knob, impl->enabled ? RGB(255, 255, 255) : base( ctx, 0x66 ) );
+    }
+    else
+    {
+        if (impl->pressed && impl->enabled) set_look( &fill, base( ctx, 0x99 ) );
+        set_look( &stroke, !impl->enabled ? base( ctx, 0x66 ) : impl->pointer_over ? base( ctx, 0xff ) : base( ctx, 0xcc ) );
+        set_look( &knob, !impl->enabled ? base( ctx, 0x66 ) : impl->pointer_over ? base( ctx, 0xff ) : base( ctx, 0xcc ) );
+    }
+    if (!impl->enabled) set_look( &text, base( ctx, 0x66 ) );
+    if (impl->enabled && impl->foreground) brush_look( impl->foreground, &text );
+    resource_look( impl, &fill, L"ToggleSwitchFill%s%s", on, state );
+    resource_look( impl, &stroke, L"ToggleSwitchStroke%s%s", on, state );
+    resource_look( impl, &knob, L"ToggleSwitchKnobFill%s%s", on, state );
+    resource_look( impl, &text, L"ToggleSwitchContentForeground%s", state );
+    resource_look( impl, &header, L"ToggleSwitchHeaderForeground%s", state );
+    if (impl->background) brush_look( impl->background, &fill );
+
+    text_format( impl, &format );
+    if (impl->header)
+    {
+        rect = *b;
+        rect.height = top;
+        str = content_text( impl->header, L"" );
+        text_draw( ctx, &format, str, &rect, header.color );
+        WindowsDeleteString( str );
+    }
+    track.x = b->x;
+    track.y = b->y + top + (32 - SWITCH_HEIGHT) / 2;
+    track.width = SWITCH_WIDTH;
+    track.height = SWITCH_HEIGHT;
+    draw_shape( ctx, &track, SWITCH_HEIGHT / 2, FALSE, &fill, &stroke, 2 );
+    dot.width = dot.height = 10;
+    dot.x = impl->is_on ? track.x + SWITCH_WIDTH - 15 : track.x + 5;
+    dot.y = track.y + 5;
+    draw_shape( ctx, &dot, 0, TRUE, &knob, NULL, 0 );
+
+    str = content_text( impl->is_on ? impl->on_content : impl->off_content, on );
+    text_measure( ctx, &format, str, INFINITY, &w, &h );
+    rect.x = track.x + SWITCH_WIDTH + 12;
+    rect.y = b->y + top + (32 - h) / 2;
+    rect.width = max( 0.0f, b->width - SWITCH_WIDTH - 12 );
+    rect.height = h;
+    text_draw( ctx, &format, str, &rect, text.color );
+    WindowsDeleteString( str );
+}
+
+void range_render( struct button *impl, struct layout_context *ctx )
+{
+    switch (impl->kind)
+    {
+    case BUTTON_SLIDER: render_slider( impl, ctx ); break;
+    case BUTTON_PROGRESS: render_progress( impl, ctx ); break;
+    default: render_switch( impl, ctx ); break;
+    }
+}
+
+/* the slider value under the pointer, snapped to StepFrequency */
+static void slider_track( struct button *impl, float x, float y )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+    BOOL vertical = impl->orientation == Orientation_Vertical;
+    float length = (vertical ? b->height : b->width) - THUMB_LENGTH;
+    double f = length > 0 ? (vertical ? 1 - (y - b->y - THUMB_LENGTH / 2) / length : (x - b->x - THUMB_LENGTH / 2) / length) : 0;
+    double value = impl->minimum + min( 1.0, max( 0.0, f ) ) * (impl->maximum - impl->minimum);
+
+    if (impl->step > 0) value = impl->minimum + floor( (value - impl->minimum) / impl->step + 0.5 ) * impl->step;
+    set_value( impl, value );
+}
+
+static void toggle( struct button *impl )
+{
+    impl->is_on = !impl->is_on;
+    TRACE( "%p is now %s.\n", impl, impl->is_on ? "on" : "off" );
+    window_invalidate();
+    element_property_changed( impl->element.outer, L"IsOn" );
+    raise_event( impl, &impl->toggled, "Toggled" );
+}
+
+void range_pointer( struct button *impl, UINT msg, float x, float y )
+{
+    const struct layout_rect *b = &impl->element.bounds;
+    BOOL inside = x >= b->x && y >= b->y && x < b->x + b->width && y < b->y + b->height;
+
+    if (impl->kind == BUTTON_PROGRESS) return;
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+        impl->pointer_over = inside || impl->captured;
+        if (impl->captured && impl->kind == BUTTON_SLIDER) slider_track( impl, x, y );
+        break;
+    case WM_MOUSELEAVE:
+        impl->pointer_over = FALSE;
+        break;
+    case WM_LBUTTONDOWN:
+        if (!impl->enabled) return;
+        impl->captured = impl->pressed = TRUE;
+        if (impl->kind == BUTTON_SLIDER) slider_track( impl, x, y );
+        break;
+    case WM_LBUTTONUP:
+        if (!impl->captured) return;
+        impl->captured = impl->pressed = FALSE;
+        impl->pointer_over = inside;
+        if (impl->kind == BUTTON_TOGGLE_SWITCH && inside && impl->enabled) toggle( impl );
+        break;
+    case WM_CAPTURECHANGED:
+        impl->captured = impl->pressed = FALSE;
+        break;
+    }
+    window_invalidate();
+}
