+static HRESULT WINAPI geometry_get_Bounds( IGeometry *iface, Rect *value )
+{
+    struct geometry *impl = impl_from_IGeometry( iface );
+
+    switch (impl->kind)
+    {
+    case GEOMETRY_RECTANGLE: *value = impl->rect; break;
+    case GEOMETRY_ELLIPSE:
+        value->X = impl->center.X - impl->radius_x;
+        value->Y = impl->center.Y - impl->radius_y;
+        value->Width = 2 * impl->radius_x;
+        value->Height = 2 * impl->radius_y;
+        break;
+    case GEOMETRY_LINE:
+        value->X = min( impl->start.X, impl->end.X );
+        value->Y = min( impl->start.Y, impl->end.Y );
+        value->Width = fabs( impl->end.X - impl->start.X );
+        value->Height = fabs( impl->end.Y - impl->start.Y );
+        break;
+    }
+    return S_OK;
