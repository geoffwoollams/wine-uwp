+/* a property as an object (numbers and strings boxed), for binding.c and animation.c; referenced, or NULL */
+IInspectable *markup_get_value( IInspectable *target, const WCHAR *name )
+{
+    struct xvalue value;
+
+    if (!get_value( target, name, &value )) return NULL;
+    if (value.kind == XV_NULL) return NULL;
+    if (value.kind == XV_THICKNESS || value.kind == XV_ENUM)
+    {
+        xvalue_clear( &value );
+        return NULL;
+    }
+    if (value.kind != XV_OBJECT) box_value( &value );
+    return value.object;
+}
+
+BOOL markup_has_value( IInspectable *target, const WCHAR *name )
+{
+    struct xvalue value;
+    BOOL ret = get_value( target, name, &value );
+    xvalue_clear( &value );
+    return ret;
+}
+
+/* set a property from an object (unboxed and converted like markup values); NULL sets null */
+void markup_set_value( IInspectable *target, const WCHAR *name, IInspectable *object, BOOL animated )
+{
+    struct xvalue value = {0};
+    struct xprop prop = {0};
+
+    lstrcpynW( prop.name, name, ARRAY_SIZE(prop.name) );
+    if (object)
+    {
+        value.kind = XV_OBJECT;
+        IInspectable_AddRef( (value.object = object) );
+    }
+    else value.kind = XV_NULL;
+    set_property( NULL, target, &prop, &value, animated ? SET_STATE : SET_LOCAL );
+    xvalue_clear( &value );
+}
+
+void markup_set_string( IInspectable *target, const WCHAR *name, const WCHAR *str, BOOL animated )
+{
+    struct xvalue value = { XV_STRING };
+    struct xprop prop = {0};
+
+    lstrcpynW( prop.name, name, ARRAY_SIZE(prop.name) );
+    value.s = wcsdup( str );
+    set_property( NULL, target, &prop, &value, animated ? SET_STATE : SET_LOCAL );
+    xvalue_clear( &value );
+}
