+static HRESULT items_control_create( IInspectable *outer, IInspectable **inner, void **value )
+{
+    struct items_control *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &items_control_ops, RuntimeClass_Windows_UI_Xaml_Controls_ItemsControl, outer );
+    impl->IItemsControl_iface.lpVtbl = &items_control_vtbl;
+    impl->IObservableVector_iface.lpVtbl = &items_vector_vtbl;
+    impl->IVectorChangedEventHandler_iface.lpVtbl = &source_changed_vtbl;
+    if (FAILED(hr = vector_create( &items_iids, &items_callbacks, impl, &impl->items )))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->dirty = TRUE;
+    return element_compose( &impl->element, outer, inner, &impl->IItemsControl_iface, value );
