+/* an elliptical arc in path markup's endpoint form (SVG's conversion to centre form) */
+static void add_arc_segment( struct figure *figure, double x0, double y0, double rx, double ry, double angle,
+                             BOOL large, BOOL sweep, double x1, double y1 )
+{
+    double phi = angle * 3.14159265358979323846 / 180, c = cos( phi ), s = sin( phi );
+    double dx = (x0 - x1) / 2, dy = (y0 - y1) / 2, xp = c * dx + s * dy, yp = -s * dx + c * dy;
+    double lambda, num, coef, cxp, cyp, cx, cy, t1, dt;
+    int i, n;
+
+    rx = fabs( rx );
+    ry = fabs( ry );
+    if (!rx || !ry) { add_point( figure, x1, y1 ); return; }
+    if ((lambda = xp * xp / (rx * rx) + yp * yp / (ry * ry)) > 1) { rx *= sqrt( lambda ); ry *= sqrt( lambda ); }
+    num = rx * rx * ry * ry - rx * rx * yp * yp - ry * ry * xp * xp;
+    coef = sqrt( max( 0.0, num / (rx * rx * yp * yp + ry * ry * xp * xp) ) ) * (large == sweep ? -1 : 1);
+    cxp = coef * rx * yp / ry;
+    cyp = -coef * ry * xp / rx;
+    cx = c * cxp - s * cyp + (x0 + x1) / 2;
+    cy = s * cxp + c * cyp + (y0 + y1) / 2;
+    t1 = atan2( (yp - cyp) / ry, (xp - cxp) / rx );
+    dt = atan2( (-yp - cyp) / ry, (-xp - cxp) / rx ) - t1;
+    if (sweep && dt < 0) dt += 2 * 3.14159265358979323846;
+    else if (!sweep && dt > 0) dt -= 2 * 3.14159265358979323846;
+    n = max( 4, (int)(fabs( dt ) / (3.14159265358979323846 / 16)) );
+    for (i = 1; i <= n; i++)
+    {
+        double t = t1 + dt * i / n;
+        add_point( figure, cx + c * rx * cos( t ) - s * ry * sin( t ), cy + s * rx * cos( t ) + c * ry * sin( t ) );
+    }
