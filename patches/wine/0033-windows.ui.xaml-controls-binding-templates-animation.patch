+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* An ItemsControl shows its items (Items, or ItemsSource: IIterable<Object>, IBindableIterable or a vector) in
+ * its ItemsPanel (a StackPanel by default): UIElement items as they are, others through ItemTemplate with the
+ * item as the DataContext, or as text. An observable ItemsSource (IObservableVector<Object>) and changes to
+ * Items regenerate them. There is no control template (ItemsPresenter), no containers, grouping or
+ * DisplayMemberPath. */
+
+struct items_control
+{
+    struct xaml_element element;
+    IItemsControl IItemsControl_iface;
+    IObservableVector_IInspectable IObservableVector_iface;   /* Items */
+    IVectorChangedEventHandler_IInspectable IVectorChangedEventHandler_iface;
+    IInspectable *items;              /* our IVector<Object> */
+    IInspectable *items_source;
+    IObservableVector_IInspectable *observed;   /* items_source, while we listen to it */
+    EventRegistrationToken token;
+    IDataTemplate *item_template;
+    IItemsPanelTemplate *items_panel;
+    IInspectable *panel_object;
+    struct xaml_element *panel;
+    BOOL dirty;
+};
+
+static const struct element_ops items_control_ops;
+static const struct IItemsControlVtbl items_control_vtbl;
+
+static inline struct items_control *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct items_control, element );
+}
+
+static const struct vector_iids items_iids =
+{
+    &IID___FIVector_1_IInspectable,
+    &IID___FIVectorView_1_IInspectable,
+    &IID___FIIterable_1_IInspectable,
+    &IID___FIIterator_1_IInspectable,
+    &IID_IInspectable,
+};
+
+static void items_changed( struct items_control *impl )
+{
+    impl->dirty = TRUE;
+    window_invalidate();
+}
+
+static HRESULT items_inserted( void *owner, IInspectable *item )
+{
+    items_changed( owner );
+    return S_OK;
+}
+
+static void items_removed( void *owner, IInspectable *item )
+{
+    items_changed( owner );
+}
+
+static const struct vector_callbacks items_callbacks = { items_inserted, items_removed };
+
+static HRESULT items_control_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct items_control *impl = impl_from_element( element );
+
+    if (!IsEqualGUID( iid, &IID_IItemsControl )) return E_NOINTERFACE;
+    *out = &impl->IItemsControl_iface;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+/* the item's visual: itself, its ItemTemplate's content, or its text */
+static IUIElement *container_for( struct items_control *impl, IInspectable *item )
+{
+    struct xaml_element *element = item ? element_from_object( item ) : NULL;
+    IFrameworkElement *fe;
+    IUIElement *ui = NULL;
+    IInspectable *root;
+    ITextBlock *tb;
+    HSTRING text;
+
+    if (element && !impl->item_template && !element->parent)
+    {
+        IInspectable_QueryInterface( item, &IID_IUIElement, (void **)&ui );
+        return ui;
+    }
+    if (impl->item_template && (root = template_load_content( (IInspectable *)impl->item_template )))
+    {
+        if (SUCCEEDED(IInspectable_QueryInterface( root, &IID_IFrameworkElement, (void **)&fe )))
+        {
+            IFrameworkElement_put_DataContext( fe, item );
+            IFrameworkElement_Release( fe );
+        }
+        IInspectable_QueryInterface( root, &IID_IUIElement, (void **)&ui );
+        IInspectable_Release( root );
+        return ui;
+    }
+    if (FAILED(IActivationFactory_ActivateInstance( text_block_factory, &root ))) return NULL;
+    if (SUCCEEDED(IInspectable_QueryInterface( root, &IID_ITextBlock, (void **)&tb )))
+    {
+        if ((text = item ? object_to_text( item ) : NULL)) ITextBlock_put_Text( tb, text );
+        WindowsDeleteString( text );
+        ITextBlock_Release( tb );
+    }
+    IInspectable_QueryInterface( root, &IID_IUIElement, (void **)&ui );
+    IInspectable_Release( root );
+    return ui;
+}
+
+static void add_item( struct items_control *impl, IVector_UIElement *children, IInspectable *item )
+{
+    IUIElement *ui = container_for( impl, item );
+    if (!ui) return;
+    IVector_UIElement_Append( children, ui );
+    IUIElement_Release( ui );
+}
+
+static void generate( struct items_control *impl )
+{
+    IVector_UIElement *children;
+    IIterable_IInspectable *iterable;
+    IIterator_IInspectable *iterator;
+    IBindableIterable *bindable;
+    IBindableIterator *bit;
+    IInspectable *item;
+    IPanel *panel;
+    boolean has;
+    UINT32 i;
+
+    impl->dirty = FALSE;
+    if (!impl->panel)
+    {
+        if (impl->items_panel) impl->panel_object = template_load_content( (IInspectable *)impl->items_panel );
+        if (!impl->panel_object) IActivationFactory_ActivateInstance( stack_panel_factory, &impl->panel_object );
+        if (!impl->panel_object || !(impl->panel = element_from_object( impl->panel_object ))) return;
+        element_set_parent( impl->panel, &impl->element );
+    }
+    if (FAILED(IInspectable_QueryInterface( impl->panel_object, &IID_IPanel, (void **)&panel ))) return;
+    IPanel_get_Children( panel, &children );
+    IPanel_Release( panel );
+    IVector_UIElement_Clear( children );
+
+    if (!impl->items_source)
+        for (i = 0; i < vector_size( impl->items ); i++) add_item( impl, children, vector_get( impl->items, i ) );
+    else if (SUCCEEDED(IInspectable_QueryInterface( impl->items_source, &IID_IIterable_IInspectable, (void **)&iterable )))
+    {
+        if (SUCCEEDED(IIterable_IInspectable_First( iterable, &iterator )))
+        {
+            while (SUCCEEDED(IIterator_IInspectable_get_HasCurrent( iterator, &has )) && has)
+            {
+                item = NULL;
+                IIterator_IInspectable_get_Current( iterator, &item );
+                add_item( impl, children, item );
+                if (item) IInspectable_Release( item );
+                IIterator_IInspectable_MoveNext( iterator, &has );
+            }
+            IIterator_IInspectable_Release( iterator );
+        }
+        IIterable_IInspectable_Release( iterable );
+    }
+    else if (SUCCEEDED(IInspectable_QueryInterface( impl->items_source, &IID_IBindableIterable, (void **)&bindable )))
+    {
+        if (SUCCEEDED(IBindableIterable_First( bindable, &bit )))
+        {
+            while (SUCCEEDED(IBindableIterator_get_HasCurrent( bit, &has )) && has)
+            {
+                item = NULL;
+                IBindableIterator_get_Current( bit, &item );
+                add_item( impl, children, item );
+                if (item) IInspectable_Release( item );
+                IBindableIterator_MoveNext( bit, &has );
+            }
+            IBindableIterator_Release( bit );
+        }
+        IBindableIterable_Release( bindable );
+    }
+    else FIXME( "ItemsSource %p is not an IIterable<Object> or IBindableIterable.\n", impl->items_source );
+    IVector_UIElement_Release( children );
+}
+
+static void items_control_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                                   float avail_height, float *width, float *height )
+{
+    struct items_control *impl = impl_from_element( element );
+
+    if (impl->dirty) generate( impl );
+    *width = *height = 0;
+    if (!impl->panel) return;
+    element_measure( impl->panel, ctx, avail_width, avail_height );
+    *width = impl->panel->desired_width;
+    *height = impl->panel->desired_height;
+}
+
+static void items_control_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct items_control *impl = impl_from_element( element );
+    if (impl->panel) element_arrange( impl->panel, ctx, element->bounds.x, element->bounds.y, element->bounds.width, element->bounds.height );
+}
+
+static void items_control_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct items_control *impl = impl_from_element( element );
+    if (impl->panel) element_render( impl->panel, ctx );
+}
+
+static UINT32 items_control_child_count( struct xaml_element *element )
+{
+    return impl_from_element( element )->panel ? 1 : 0;
+}
+
+static struct xaml_element *items_control_child_at( struct xaml_element *element, UINT32 index )
+{
+    return impl_from_element( element )->panel;
+}
+
+static void stop_observing( struct items_control *impl )
+{
+    if (!impl->observed) return;
+    IObservableVector_IInspectable_remove_VectorChanged( impl->observed, impl->token );
+    IObservableVector_IInspectable_Release( impl->observed );
+    impl->observed = NULL;
+}
+
+static void items_control_destroy( struct xaml_element *element )
+{
+    struct items_control *impl = impl_from_element( element );
+
+    stop_observing( impl );
+    if (impl->panel) element_set_parent( impl->panel, NULL );
+    if (impl->panel_object) IInspectable_Release( impl->panel_object );
+    if (impl->items_source) IInspectable_Release( impl->items_source );
+    if (impl->item_template) IDataTemplate_Release( impl->item_template );
+    if (impl->items_panel) IItemsPanelTemplate_Release( impl->items_panel );
+    if (impl->items)
+    {
+        vector_detach( impl->items );
+        IInspectable_Release( impl->items );
+    }
+    free( impl );
+}
+
+static const struct element_ops items_control_ops =
+{
+    .query_interface = items_control_query_interface,
+    .measure = items_control_measure,
+    .arrange = items_control_arrange,
+    .render = items_control_render,
+    .child_count = items_control_child_count,
+    .child_at = items_control_child_at,
+    .destroy = items_control_destroy,
+};
+
+/* Items: IObservableVector<Object>, with the vector interfaces from our vector */
+
+DEFINE_IINSPECTABLE_( items_vector, IObservableVector_IInspectable, struct items_control, impl_from_IObservableVector_IInspectable,
+                      IObservableVector_iface, impl->element.outer )
+
+static HRESULT WINAPI items_vector_add_VectorChanged( IObservableVector_IInspectable *iface,
+                                                      IVectorChangedEventHandler_IInspectable *handler, EventRegistrationToken *token )
+{
+    FIXME( "iface %p, handler %p: Items change events are not raised.\n", iface, handler );
+    token->value = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI items_vector_remove_VectorChanged( IObservableVector_IInspectable *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static const struct IObservableVector_IInspectableVtbl items_vector_vtbl =
+{
+    items_vector_QueryInterface,
+    items_vector_AddRef,
+    items_vector_Release,
+    /* IInspectable methods */
+    items_vector_GetIids,
+    items_vector_GetRuntimeClassName,
+    items_vector_GetTrustLevel,
+    /* IObservableVector<IInspectable *> methods */
+    items_vector_add_VectorChanged,
+    items_vector_remove_VectorChanged,
+};
+
+/* the observable ItemsSource changed */
+
+static inline struct items_control *impl_from_IVectorChangedEventHandler_IInspectable( IVectorChangedEventHandler_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct items_control, IVectorChangedEventHandler_iface );
+}
+
+static HRESULT WINAPI source_changed_QueryInterface( IVectorChangedEventHandler_IInspectable *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IVectorChangedEventHandler_IInspectable ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
