+/* markup values: Rect="0,0,10,10", Center="5,5", RadiusX="3", StartPoint/EndPoint="x,y" */
+BOOL geometry_set_property( IInspectable *object, const WCHAR *name, const WCHAR *str, double number )
+{
+    struct geometry *impl = geometry_from_object( object );
+    float v[4] = {0};
+    WCHAR *end;
+    int n = 0;
+
+    if (!impl) return FALSE;
+    while (str && *str && n < 4)
+    {
+        while (*str == ' ' || *str == ',') str++;
+        if (!*str) break;
+        v[n] = wcstod( str, &end );
+        if (end == str) break;
+        str = end;
+        n++;
+    }
+    if (!str) { v[0] = number; n = 1; }
+    if (!wcscmp( name, L"Rect" ) && n == 4) { impl->rect.X = v[0]; impl->rect.Y = v[1]; impl->rect.Width = v[2]; impl->rect.Height = v[3]; }
+    else if (!wcscmp( name, L"Center" ) && n == 2) { impl->center.X = v[0]; impl->center.Y = v[1]; }
+    else if (!wcscmp( name, L"StartPoint" ) && n == 2) { impl->start.X = v[0]; impl->start.Y = v[1]; }
+    else if (!wcscmp( name, L"EndPoint" ) && n == 2) { impl->end.X = v[0]; impl->end.Y = v[1]; }
+    else if (!wcscmp( name, L"RadiusX" ) && n >= 1) impl->radius_x = v[0];
+    else if (!wcscmp( name, L"RadiusY" ) && n >= 1) impl->radius_y = v[0];
+    else return FALSE;
+    window_invalidate();
+    return TRUE;
+}
+
+static inline struct geometry *impl_from_IGeometry( IGeometry *iface )
+{
+    return CONTAINING_RECORD( iface, struct geometry, IGeometry_iface );
+}
+
+static HRESULT WINAPI geometry_QueryInterface( IGeometry *iface, REFIID iid, void **out )
+{
+    struct geometry *impl = impl_from_IGeometry( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IGeometry ))
+        *out = &impl->IGeometry_iface;
+    else if (impl->kind == GEOMETRY_RECTANGLE && IsEqualGUID( iid, &IID_IRectangleGeometry )) *out = &impl->IRectangleGeometry_iface;
+    else if (impl->kind == GEOMETRY_ELLIPSE && IsEqualGUID( iid, &IID_IEllipseGeometry )) *out = &impl->IEllipseGeometry_iface;
+    else if (impl->kind == GEOMETRY_LINE && IsEqualGUID( iid, &IID_ILineGeometry )) *out = &impl->ILineGeometry_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI geometry_AddRef( IGeometry *iface )
+{
+    return InterlockedIncrement( &impl_from_IGeometry( iface )->ref );
+}
+
+static ULONG WINAPI geometry_Release( IGeometry *iface )
+{
+    struct geometry *impl = impl_from_IGeometry( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
