+}
+
+static HRESULT WINAPI storyboard_iface_GetCurrentState( IStoryboard *iface, ClockState *value )
+{
+    *value = impl_from_IStoryboard( iface )->state;
+    return S_OK;
+}
+
+static HRESULT WINAPI storyboard_iface_GetCurrentTime( IStoryboard *iface, TimeSpan *value )
+{
+    memset( value, 0, sizeof(*value) );   /* (its Duration member is hidden by the Duration typedef macro) */
+    return S_OK;
+}
+
+static HRESULT WINAPI storyboard_iface_SeekAlignedToLastTick( IStoryboard *iface, TimeSpan offset )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI storyboard_iface_SkipToFill( IStoryboard *iface )
+{
+    struct storyboard *impl = impl_from_IStoryboard( iface );
+    struct track *track;
+
+    TRACE( "iface %p.\n", iface );
+    for (track = tracks; track; track = track->next) if (track->owner == impl->bag) track->start = 0;
+    animation_tick_owner( impl->bag );
+    return S_OK;
+}
