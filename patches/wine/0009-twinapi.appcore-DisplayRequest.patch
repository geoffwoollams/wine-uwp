diff --git a/dlls/twinapi.appcore/display_request.c b/dlls/twinapi.appcore/display_request.c
new file mode 100644
index 0000000..116b52f
--- /dev/null
+++ b/dlls/twinapi.appcore/display_request.c
@@ -0,0 +1,180 @@
+/* Windows.System.Display.DisplayRequest: keeps the display on while an app (a game, a video player) needs it.
+ *
+ * Active requests are counted process-wide; while any is held the process asks for ES_DISPLAY_REQUIRED |
+ * ES_SYSTEM_REQUIRED through SetThreadExecutionState, as Windows does on behalf of the app. */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+static const GUID IID_IDisplayRequest = { 0xe5732044, 0xf49f, 0x4b60, { 0x8d, 0xd4, 0x5e, 0x7e, 0x3a, 0x63, 0x2a, 0xc0 } };
+
+struct display_request_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( void *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( void *iface );
+    ULONG (WINAPI *Release)( void *iface );
+    HRESULT (WINAPI *GetIids)( void *iface, ULONG *count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( void *iface, HSTRING *name );
+    HRESULT (WINAPI *GetTrustLevel)( void *iface, TrustLevel *level );
+    HRESULT (WINAPI *RequestActive)( void *iface );
+    HRESULT (WINAPI *RequestRelease)( void *iface );
+};
+
+struct display_request
+{
+    const struct display_request_vtbl *lpVtbl;
+    LONG ref;
+    LONG active;   /* RequestActive calls on this object not yet released */
+};
+
+static CRITICAL_SECTION display_cs;
+static CRITICAL_SECTION_DEBUG display_cs_debug =
+{
+    0, 0, &display_cs,
+    { &display_cs_debug.ProcessLocksList, &display_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": display_cs") }
+};
+static CRITICAL_SECTION display_cs = { &display_cs_debug, -1, 0, 0, 0, 0 };
+static LONG process_active;   /* all active requests in the process */
+
+static void update_execution_state( LONG delta )
+{
+    EnterCriticalSection( &display_cs );
+    process_active += delta;
+    if (delta > 0 && process_active == delta)
+    {
+        TRACE( "keeping the display on.\n" );
+        SetThreadExecutionState( ES_CONTINUOUS | ES_DISPLAY_REQUIRED | ES_SYSTEM_REQUIRED );
+    }
+    else if (delta < 0 && !process_active)
+    {
+        TRACE( "display may turn off again.\n" );
+        SetThreadExecutionState( ES_CONTINUOUS );
+    }
+    LeaveCriticalSection( &display_cs );
+}
+
+static struct display_request *impl_from_iface( void *iface ) { return iface; }
+
+static HRESULT WINAPI request_QueryInterface( void *iface, REFIID iid, void **out )
+{
+    struct display_request *impl = impl_from_iface( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDisplayRequest ))
+    {
+        InterlockedIncrement( &impl->ref );
+        *out = impl;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI request_AddRef( void *iface )
+{
+    struct display_request *impl = impl_from_iface( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI request_Release( void *iface )
+{
+    struct display_request *impl = impl_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref)
+    {
+        /* Windows drops the requests of a destroyed DisplayRequest. */
+        if (impl->active) update_execution_state( -impl->active );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI request_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI request_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.System.Display.DisplayRequest";
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+static HRESULT WINAPI request_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI request_RequestActive( void *iface )
+{
+    struct display_request *impl = impl_from_iface( iface );
+
+    TRACE( "iface %p, active %ld.\n", iface, impl->active );
+    InterlockedIncrement( &impl->active );
+    update_execution_state( 1 );
+    return S_OK;
+}
+
+static HRESULT WINAPI request_RequestRelease( void *iface )
+{
+    struct display_request *impl = impl_from_iface( iface );
+    LONG active;
+
+    TRACE( "iface %p, active %ld.\n", iface, impl->active );
+    do
+    {
+        if (!(active = impl->active))
+        {
+            WARN( "no active request to release.\n" );
+            return E_FAIL;
+        }
+    } while (InterlockedCompareExchange( &impl->active, active - 1, active ) != active);
+    update_execution_state( -1 );
+    return S_OK;
+}
+
+static const struct display_request_vtbl request_vtbl =
+{
+    request_QueryInterface, request_AddRef, request_Release,
+    request_GetIids, request_GetRuntimeClassName, request_GetTrustLevel,
+    request_RequestActive, request_RequestRelease,
+};
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct display_request *impl;
+
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->lpVtbl = &request_vtbl;
+    impl->ref = 1;
+    *instance = (IInspectable *)impl;
+    return S_OK;
+}
+
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+static IActivationFactory factory = { &factory_vtbl };
+IActivationFactory *display_request_factory = &factory;
