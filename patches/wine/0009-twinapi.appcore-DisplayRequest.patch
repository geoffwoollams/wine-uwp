Subject: twinapi.appcore: Windows.System.Display.DisplayRequest via SetThreadExecutionState

diff --git a/dlls/twinapi.appcore/Makefile.in b/dlls/twinapi.appcore/Makefile.in
index e6a3e2b..20e95a7 100644
--- a/dlls/twinapi.appcore/Makefile.in
+++ b/dlls/twinapi.appcore/Makefile.in
@@ -20,6 +20,7 @@ SOURCES = \
 	strmap_gen.c \
 	thread_pool_timer.c \
 	display_information.c \
