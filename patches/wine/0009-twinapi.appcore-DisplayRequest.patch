@@ -90,6 +90,9 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
         IActivationFactory_QueryInterface( display_information_factory, &IID_IActivationFactory, (void **)factory );
     }
 
+    else if (!wcscmp( buffer, L"Windows.System.Display.DisplayRequest" ))
+        IActivationFactory_QueryInterface( display_request_factory, &IID_IActivationFactory, (void **)factory );
+
     else if (!wcscmp( buffer, L"Windows.ApplicationModel.ExtendedExecution.ExtendedExecutionSession" ))
         IActivationFactory_QueryInterface( extended_execution_factory, &IID_IActivationFactory, (void **)factory );
 
