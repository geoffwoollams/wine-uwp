+/* SplashScreen: there is no splash screen; Dismissed (on Windows: once the app's first frame shows) is raised
+ * after the Activated handlers return. Apps wait for it to start loading. */
+static const GUID IID_ISplashScreen_local =
+    { 0xca4d975c, 0xd4d6, 0x43f0, { 0x97, 0xc0, 0x08, 0x33, 0xc6, 0x39, 0x1c, 0x24 } };
+static HRESULT WINAPI splash_QueryInterface(void *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_ISplashScreen_local))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI splash_AddRef(void *iface) { return 2; }
+static ULONG WINAPI splash_Release(void *iface) { return 1; }
+static HRESULT WINAPI splash_GetRuntimeClassName(void *iface, HSTRING *n)
+{
+    static const WCHAR name[] = L"Windows.ApplicationModel.Activation.SplashScreen";
+    return WindowsCreateString(name, wcslen(name), n);
+}
+static HRESULT WINAPI splash_get_ImageLocation(void *iface, __x_ABI_CWindows_CFoundation_CRect *value)
+{
+    memset(value, 0, sizeof(*value));
+    return S_OK;
+}
+static IUnknown *splash_handlers[8];
+static HRESULT WINAPI splash_add_Dismissed(void *iface, IUnknown *handler, EventRegistrationToken *token)
+{
+    UINT32 i;
+    for (i = 0; i < ARRAY_SIZE(splash_handlers); i++)
+    {
+        if (splash_handlers[i]) continue;
+        splash_handlers[i] = handler;
+        IUnknown_AddRef(handler);
+        token->value = i + 1;
+        return S_OK;
+    }
+    return E_OUTOFMEMORY;
+}
+static HRESULT WINAPI splash_remove_Dismissed(void *iface, EventRegistrationToken token)
+{
+    if (token.value >= 1 && token.value <= ARRAY_SIZE(splash_handlers) && splash_handlers[token.value - 1])
+    {
+        IUnknown_Release(splash_handlers[token.value - 1]);
+        splash_handlers[token.value - 1] = NULL;
+    }
+    return S_OK;
+}
+static HRESULT WINAPI splash_GetIids(void *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI splash_GetTrustLevel(void *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static const void *const splash_vtbl[] = { splash_QueryInterface, splash_AddRef, splash_Release, splash_GetIids,
+    splash_GetRuntimeClassName, splash_GetTrustLevel, splash_get_ImageLocation, splash_add_Dismissed,
+    splash_remove_Dismissed };
+static struct { const void *const *lpVtbl; } splash_screen = { splash_vtbl };
+
+/* TypedEventHandler<SplashScreen, IInspectable>: Invoke is slot 3 */
+static void splash_raise_dismissed(void)
+{
+    typedef HRESULT (WINAPI *invoke_func)(IUnknown *, void *, IInspectable *);
+    UINT32 i;
+
+    for (i = 0; i < ARRAY_SIZE(splash_handlers); i++)
+    {
+        IUnknown *handler = splash_handlers[i];
+        if (!handler) continue;
+        splash_handlers[i] = NULL;
+        TRACE("raising SplashScreen.Dismissed, handler %p\n", handler);
+        ((invoke_func)((void **)handler->lpVtbl)[3])(handler, &splash_screen, NULL);
+        IUnknown_Release(handler);
+    }
+}
+
 static HRESULT WINAPI core_args_get_SplashScreen(IActivatedEventArgs *iface, __x_ABI_CWindows_CApplicationModel_CActivation_CISplashScreen **value)
 {
-    struct core_args *impl __attribute__((unused)) = impl_from_core_args(iface);
-    *value = NULL;
+    *value = (void *)&splash_screen;
     return S_OK;
 }
 
