diff --git a/dlls/twinapi.appcore/resource_loader.c b/dlls/twinapi.appcore/resource_loader.c
new file mode 100644
index 0000000..5030170
--- /dev/null
+++ b/dlls/twinapi.appcore/resource_loader.c
@@ -0,0 +1,167 @@
+/* Windows.ApplicationModel.Resources.ResourceLoader: strings from the package's resources.pri (hand-declared
+ * interfaces). A loader named "X" reads "X/<key>"; the default one reads "Resources/<key>". */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+HRESULT pri_lookup_string( const WCHAR *prefix, const WCHAR *name, HSTRING *value );
+
+static const GUID iid_resource_loader = {0x08524908,0x16ef,0x45ad,{0xa6,0x02,0x29,0x36,0x37,0xd7,0xe6,0x1a}};
+static const GUID iid_resource_loader2 = {0x10eb6ec6,0x8138,0x48c1,{0xbc,0x65,0xe1,0xf1,0x42,0x07,0x36,0x7c}};
+static const GUID iid_resource_loader_factory = {0xc33a3603,0x69dc,0x4285,{0xa0,0x77,0xd5,0xc0,0xe4,0x7c,0xcb,0xe8}};
+static const GUID iid_resource_loader_statics = {0xbf777ce1,0x19c8,0x49c2,{0x95,0x3c,0x47,0xe9,0x22,0x7b,0x33,0x4e}};
+static const GUID iid_resource_loader_statics2 = {0x0cc04141,0x6466,0x4989,{0x94,0x94,0x0b,0x82,0xdf,0xc5,0x3f,0x1f}};
+static const GUID iid_resource_loader_statics3 = {0x64609dfb,0x64ac,0x491b,{0x81,0x00,0x0e,0x55,0x8d,0x61,0xc1,0xd0}};
+
+struct loader
+{
+    const void *const *loader_vtbl;    /* IResourceLoader */
+    const void *const *loader2_vtbl;   /* IResourceLoader2 */
+    LONG ref;
+    WCHAR *name;
+};
+
+static struct loader *loader_from(void *iface) { return CONTAINING_RECORD(iface, struct loader, loader_vtbl); }
+static struct loader *loader_from2(void *iface) { return CONTAINING_RECORD(iface, struct loader, loader2_vtbl); }
+
+static HRESULT loader_qi(struct loader *l, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &iid_resource_loader))
+        *out = &l->loader_vtbl;
+    else if (IsEqualGUID(iid, &iid_resource_loader2))
+        *out = &l->loader2_vtbl;
+    else
+    {
+        TRACE("%s not implemented.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&l->ref);
+    return S_OK;
+}
+static ULONG loader_release(struct loader *l)
+{
+    ULONG ref = InterlockedDecrement(&l->ref);
+    if (!ref)
+    {
+        free(l->name);
+        free(l);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI rl_QI(void *i, REFIID iid, void **out) { return loader_qi(loader_from(i), iid, out); }
+static ULONG WINAPI rl_AddRef(void *i) { return InterlockedIncrement(&loader_from(i)->ref); }
+static ULONG WINAPI rl_Release(void *i) { return loader_release(loader_from(i)); }
+static HRESULT WINAPI rl_GetIids(void *i, ULONG *c, IID **ids) { return E_NOTIMPL; }
+static HRESULT WINAPI rl_GetRuntimeClassName(void *i, HSTRING *n)
+{
+    static const WCHAR name[] = L"Windows.ApplicationModel.Resources.ResourceLoader";
+    return WindowsCreateString(name, wcslen(name), n);
+}
+static HRESULT WINAPI rl_GetTrustLevel(void *i, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI rl_GetString(void *i, HSTRING resource, HSTRING *value)
+{
+    struct loader *l = loader_from(i);
+    HRESULT hr = pri_lookup_string(l->name, WindowsGetStringRawBuffer(resource, NULL), value);
+    TRACE("%s/%s -> %s.\n", debugstr_w(l->name), debugstr_hstring(resource), debugstr_hstring(*value));
+    return hr;
+}
+static const void *const loader_vtbl[] = { rl_QI, rl_AddRef, rl_Release, rl_GetIids, rl_GetRuntimeClassName,
+    rl_GetTrustLevel, rl_GetString };
+
+static HRESULT WINAPI rl2_QI(void *i, REFIID iid, void **out) { return loader_qi(loader_from2(i), iid, out); }
+static ULONG WINAPI rl2_AddRef(void *i) { return InterlockedIncrement(&loader_from2(i)->ref); }
+static ULONG WINAPI rl2_Release(void *i) { return loader_release(loader_from2(i)); }
+
+static HRESULT string_for_uri(IUriRuntimeClass *uri, HSTRING *value)
+{
+    HSTRING raw = NULL;
+    HRESULT hr;
+
+    *value = NULL;
+    if (!uri) return E_INVALIDARG;
+    IUriRuntimeClass_get_RawUri(uri, &raw);
+    hr = pri_lookup_string(NULL, WindowsGetStringRawBuffer(raw, NULL), value);
+    TRACE("%s -> %s.\n", debugstr_hstring(raw), debugstr_hstring(*value));
+    WindowsDeleteString(raw);
+    return hr;
+}
+static HRESULT WINAPI rl2_GetStringForUri(void *i, IUriRuntimeClass *uri, HSTRING *value) { return string_for_uri(uri, value); }
+static const void *const loader2_vtbl[] = { rl2_QI, rl2_AddRef, rl2_Release, rl_GetIids, rl_GetRuntimeClassName,
+    rl_GetTrustLevel, rl2_GetStringForUri };
+
+static HRESULT loader_create(HSTRING name, void **out)
+{
+    const WCHAR *str = name ? WindowsGetStringRawBuffer(name, NULL) : NULL;
+    struct loader *l;
+
+    if (!(l = calloc(1, sizeof(*l)))) return E_OUTOFMEMORY;
+    l->loader_vtbl = loader_vtbl;
+    l->loader2_vtbl = loader2_vtbl;
+    l->ref = 1;
+    l->name = wcsdup(str && *str ? str : L"Resources");
+    TRACE("loader %p for %s.\n", l, debugstr_w(l->name));
+    *out = &l->loader_vtbl;
+    return S_OK;
+}
+
+/* the factory, with IResourceLoaderFactory and IResourceLoaderStatics/2/3 on separate static objects */
+static HRESULT WINAPI rlf_QI(IActivationFactory *iface, REFIID iid, void **out);
+static ULONG WINAPI rlf_AddRef(IActivationFactory *iface) { return 2; }
+static ULONG WINAPI rlf_Release(IActivationFactory *iface) { return 1; }
+static HRESULT WINAPI rlf_GetIids(IActivationFactory *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI rlf_GetRuntimeClassName(IActivationFactory *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI rlf_GetTrustLevel(IActivationFactory *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI rlf_ActivateInstance(IActivationFactory *iface, IInspectable **out) { return loader_create(NULL, (void **)out); }
+static const IActivationFactoryVtbl rlf_vtbl = { rlf_QI, rlf_AddRef, rlf_Release, rlf_GetIids, rlf_GetRuntimeClassName,
+    rlf_GetTrustLevel, rlf_ActivateInstance };
+static IActivationFactory rlf_obj = { &rlf_vtbl };
+
+static HRESULT WINAPI st_QI(void *i, REFIID iid, void **out) { return rlf_QI(&rlf_obj, iid, out); }
+static ULONG WINAPI st_AddRef(void *i) { return 2; }
+static ULONG WINAPI st_Release(void *i) { return 1; }
+
+static HRESULT WINAPI fac_CreateResourceLoaderByName(void *i, HSTRING name, void **value) { return loader_create(name, value); }
+static const void *const factory_vtbl[] = { st_QI, st_AddRef, st_Release, rl_GetIids, rl_GetRuntimeClassName,
+    rl_GetTrustLevel, fac_CreateResourceLoaderByName };
+static struct { const void *const *lpVtbl; } factory_obj = { factory_vtbl };
+
+static HRESULT WINAPI st_GetStringForReference(void *i, IUriRuntimeClass *uri, HSTRING *value) { return string_for_uri(uri, value); }
+static const void *const statics_vtbl[] = { st_QI, st_AddRef, st_Release, rl_GetIids, rl_GetRuntimeClassName,
+    rl_GetTrustLevel, st_GetStringForReference };
+static struct { const void *const *lpVtbl; } statics_obj = { statics_vtbl };
+
+static HRESULT WINAPI st2_GetForCurrentView(void *i, void **value) { return loader_create(NULL, value); }
+static HRESULT WINAPI st2_GetForCurrentViewWithName(void *i, HSTRING name, void **value) { return loader_create(name, value); }
+static const void *const statics2_vtbl[] = { st_QI, st_AddRef, st_Release, rl_GetIids, rl_GetRuntimeClassName,
+    rl_GetTrustLevel, st2_GetForCurrentView, st2_GetForCurrentViewWithName, st2_GetForCurrentView,
+    st2_GetForCurrentViewWithName };
+static struct { const void *const *lpVtbl; } statics2_obj = { statics2_vtbl };
+
+static HRESULT WINAPI st3_GetForUIContext(void *i, void *context, void **value) { return loader_create(NULL, value); }
+static const void *const statics3_vtbl[] = { st_QI, st_AddRef, st_Release, rl_GetIids, rl_GetRuntimeClassName,
+    rl_GetTrustLevel, st3_GetForUIContext };
+static struct { const void *const *lpVtbl; } statics3_obj = { statics3_vtbl };
+
+static HRESULT WINAPI rlf_QI(IActivationFactory *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+        *out = &rlf_obj;
+    else if (IsEqualGUID(iid, &iid_resource_loader_factory)) *out = &factory_obj;
+    else if (IsEqualGUID(iid, &iid_resource_loader_statics)) *out = &statics_obj;
+    else if (IsEqualGUID(iid, &iid_resource_loader_statics2)) *out = &statics2_obj;
+    else if (IsEqualGUID(iid, &iid_resource_loader_statics3)) *out = &statics3_obj;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+IActivationFactory *resource_loader_factory = &rlf_obj;
