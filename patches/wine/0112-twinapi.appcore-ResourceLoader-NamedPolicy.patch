 };
 
 IActivationFactory *resource_manager_factory = &resource_manager.IActivationFactory_iface;
+
+/* ResourceLoader (resource_loader.c): a string of resources.pri, "" when there isn't one */
+HRESULT pri_lookup_string( const WCHAR *prefix, const WCHAR *name, HSTRING *value )
+{
+    IResourceCandidate *candidate;
+    HRESULT hr;
+
+    *value = NULL;
+    if (FAILED(candidate_create( pri_find_resource( pri_get(), prefix, name ), &candidate )))
+    {
+        WARN( "%s/%s not found.\n", debugstr_w(prefix), debugstr_w(name) );
+        return S_OK;
+    }
+    hr = IResourceCandidate_get_ValueAsString( candidate, value );
+    IResourceCandidate_Release( candidate );
+    if (FAILED(hr)) *value = NULL;
+    return S_OK;
+}
