diff --git a/dlls/twinapi.appcore/named_policy.c b/dlls/twinapi.appcore/named_policy.c
new file mode 100644
index 0000000..c848851
--- /dev/null
+++ b/dlls/twinapi.appcore/named_policy.c
@@ -0,0 +1,108 @@
+/* Windows.Management.Policies.NamedPolicy: no device management, so every policy is unmanaged and unset */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* NamedPolicyData (hand-declared INamedPolicyData) */
+struct policy_data { const void *const *lpVtbl; LONG ref; HSTRING area, name; };
+
+static const GUID iid_named_policy_data = {0x38dcb198,0x95ac,0x4077,{0xa6,0x43,0x80,0x78,0xca,0xe2,0x64,0x00}};
+static const GUID iid_named_policy_statics = {0x7f793be7,0x76c4,0x4058,{0x8c,0xad,0x67,0x66,0x2c,0xd0,0x5f,0x0d}};
+
+static HRESULT WINAPI pd_QI(struct policy_data *p, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &iid_named_policy_data))
+    {
+        InterlockedIncrement(&p->ref);
+        *out = p;
+        return S_OK;
+    }
+    TRACE("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI pd_AddRef(struct policy_data *p) { return InterlockedIncrement(&p->ref); }
+static ULONG WINAPI pd_Release(struct policy_data *p)
+{
+    ULONG ref = InterlockedDecrement(&p->ref);
+    if (!ref)
+    {
+        WindowsDeleteString(p->area);
+        WindowsDeleteString(p->name);
+        free(p);
+    }
+    return ref;
+}
+static HRESULT WINAPI pd_GetIids(void *p, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI pd_GetRuntimeClassName(void *p, HSTRING *n)
+{
+    static const WCHAR name[] = L"Windows.Management.Policies.NamedPolicyData";
+    return WindowsCreateString(name, wcslen(name), n);
+}
+static HRESULT WINAPI pd_GetTrustLevel(void *p, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI pd_get_Area(struct policy_data *p, HSTRING *v) { return WindowsDuplicateString(p->area, v); }
+static HRESULT WINAPI pd_get_Name(struct policy_data *p, HSTRING *v) { return WindowsDuplicateString(p->name, v); }
+static HRESULT WINAPI pd_get_Kind(void *p, INT32 *v) { *v = 0; /* Invalid: not set */ return S_OK; }
+static HRESULT WINAPI pd_get_IsManaged(void *p, boolean *v) { *v = FALSE; return S_OK; }
+static HRESULT WINAPI pd_get_IsUserPolicy(void *p, boolean *v) { *v = FALSE; return S_OK; }
+static HRESULT WINAPI pd_get_User(void *p, void **v) { *v = NULL; return S_OK; }
+static HRESULT WINAPI pd_GetBoolean(void *p, boolean *v) { *v = FALSE; return S_OK; }
+static HRESULT WINAPI pd_GetBinary(void *p, void **v) { *v = NULL; return S_OK; }
+static HRESULT WINAPI pd_GetInt32(void *p, INT32 *v) { *v = 0; return S_OK; }
+static HRESULT WINAPI pd_GetInt64(void *p, INT64 *v) { *v = 0; return S_OK; }
+static HRESULT WINAPI pd_GetString(void *p, HSTRING *v) { *v = NULL; return S_OK; }
+static HRESULT WINAPI pd_add_Changed(void *p, void *handler, EventRegistrationToken *token) { token->value = 1; return S_OK; }
+static HRESULT WINAPI pd_remove_Changed(void *p, EventRegistrationToken token) { return S_OK; }
+static const void *const policy_data_vtbl[] = { pd_QI, pd_AddRef, pd_Release, pd_GetIids, pd_GetRuntimeClassName,
+    pd_GetTrustLevel, pd_get_Area, pd_get_Name, pd_get_Kind, pd_get_IsManaged, pd_get_IsUserPolicy, pd_get_User,
+    pd_GetBoolean, pd_GetBinary, pd_GetInt32, pd_GetInt64, pd_GetString, pd_add_Changed, pd_remove_Changed };
+
+static HRESULT policy_create(HSTRING area, HSTRING name, void **out)
+{
+    struct policy_data *p;
+
+    TRACE("%s/%s: not managed.\n", debugstr_hstring(area), debugstr_hstring(name));
+    if (!(p = calloc(1, sizeof(*p)))) return E_OUTOFMEMORY;
+    p->lpVtbl = policy_data_vtbl;
+    p->ref = 1;
+    WindowsDuplicateString(area, &p->area);
+    WindowsDuplicateString(name, &p->name);
+    *out = p;
+    return S_OK;
+}
+
+/* INamedPolicyStatics */
+static HRESULT WINAPI ps_QI(void *i, REFIID iid, void **out);
+static const IActivationFactoryVtbl npf_vtbl;
+static IActivationFactory npf_obj = { &npf_vtbl };
+static ULONG WINAPI ps_AddRef(void *i) { return 2; }
+static ULONG WINAPI ps_Release(void *i) { return 1; }
+static HRESULT WINAPI ps_GetPolicyFromPath(void *i, HSTRING area, HSTRING name, void **value)
+{ return policy_create(area, name, value); }
+static HRESULT WINAPI ps_GetPolicyFromPathForUser(void *i, void *user, HSTRING area, HSTRING name, void **value)
+{ return policy_create(area, name, value); }
+static const void *const statics_vtbl[] = { ps_QI, ps_AddRef, ps_Release, pd_GetIids, pd_GetRuntimeClassName,
+    pd_GetTrustLevel, ps_GetPolicyFromPath, ps_GetPolicyFromPathForUser };
+static struct { const void *const *lpVtbl; } statics_obj = { statics_vtbl };
+
+static HRESULT WINAPI npf_QI(IActivationFactory *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+    { *out = iface; return S_OK; }
+    if (IsEqualGUID(iid, &iid_named_policy_statics)) { *out = &statics_obj; return S_OK; }
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static HRESULT WINAPI ps_QI(void *i, REFIID iid, void **out) { return npf_QI(&npf_obj, iid, out); }
+static ULONG WINAPI npf_AddRef(IActivationFactory *iface) { return 2; }
+static ULONG WINAPI npf_Release(IActivationFactory *iface) { return 1; }
+static HRESULT WINAPI npf_GetIids(IActivationFactory *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI npf_GetRuntimeClassName(IActivationFactory *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI npf_GetTrustLevel(IActivationFactory *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI npf_ActivateInstance(IActivationFactory *iface, IInspectable **i) { return E_NOTIMPL; }
+static const IActivationFactoryVtbl npf_vtbl = { npf_QI, npf_AddRef, npf_Release, npf_GetIids, npf_GetRuntimeClassName,
+    npf_GetTrustLevel, npf_ActivateInstance };
+IActivationFactory *named_policy_factory = &npf_obj;
