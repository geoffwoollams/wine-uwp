+/* ---- IVectorView<T> (with IIterable<T>) of a folder's StorageFolder, StorageFile or IStorageItem entries ---- */
+
+enum entry_kind { ENTRY_FOLDERS, ENTRY_FILES, ENTRY_ITEMS };
+
+struct entry_iids { const GUID *view, *iterable, *iterator, *operation, *element; };
+static const struct entry_iids entry_iids[] =
+{
+    { &IID___FIVectorView_1_Windows__CStorage__CStorageFolder, &IID_IIterable_StorageFolder, &IID_IIterator_StorageFolder,
+      &IID___FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CStorageFolder, &IID_IStorageFolder },
+    { &IID___FIVectorView_1_Windows__CStorage__CStorageFile, &IID_IIterable_StorageFile, &IID_IIterator_StorageFile,
+      &IID___FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CStorageFile, &IID_IStorageFile },
+    { &IID___FIVectorView_1_Windows__CStorage__CIStorageItem, &IID___FIIterable_1_Windows__CStorage__CIStorageItem,
+      &IID___FIIterator_1_Windows__CStorage__CIStorageItem,
+      &IID___FIAsyncOperation_1___FIVectorView_1_Windows__CStorage__CIStorageItem, &IID_IStorageItem },
+};
+
+struct entry_iface { const void *const *lpVtbl; };
+
+struct entry_list
+{
+    struct entry_iface view;
+    struct entry_iface iterable;
+    LONG ref;
+    const struct entry_iids *iids;
+    UINT32 count;
+    IUnknown *items[];   /* each an element interface pointer */
+};
+
+struct entry_iterator
+{
+    struct entry_iface iface;
+    LONG ref;
+    struct entry_list *list;
+    UINT32 index;
+};
+
+static const void *const entry_view_vtbl[];
+static const void *const entry_iterable_vtbl[];
+
+static struct entry_list *list_from_iface(struct entry_iface *iface)
+{
+    if (iface->lpVtbl == entry_view_vtbl) return CONTAINING_RECORD(iface, struct entry_list, view);
+    return CONTAINING_RECORD(iface, struct entry_list, iterable);
+}
+
+static HRESULT WINAPI entries_QueryInterface(struct entry_iface *iface, REFIID iid, void **out)
+{
+    struct entry_list *list = list_from_iface(iface);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, list->iids->view))
+        *out = &list->view;
+    else if (IsEqualGUID(iid, list->iids->iterable))
+        *out = &list->iterable;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&list->ref);
+    return S_OK;
+}
+static ULONG WINAPI entries_AddRef(struct entry_iface *iface) { return InterlockedIncrement(&list_from_iface(iface)->ref); }
+static ULONG WINAPI entries_Release(struct entry_iface *iface)
+{
+    struct entry_list *list = list_from_iface(iface);
+    ULONG ref = InterlockedDecrement(&list->ref);
+    UINT32 i;
+    if (!ref)
+    {
+        for (i = 0; i < list->count; i++) IUnknown_Release(list->items[i]);
+        free(list);
+    }
+    return ref;
+}
+static HRESULT WINAPI entries_GetIids(struct entry_iface *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI entries_GetRuntimeClassName(struct entry_iface *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI entries_GetTrustLevel(struct entry_iface *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI entries_GetAt(struct entry_iface *iface, UINT32 index, IUnknown **value)
+{
+    struct entry_list *list = list_from_iface(iface);
+    *value = NULL;
+    if (index >= list->count) return E_BOUNDS;
+    *value = list->items[index];
+    IUnknown_AddRef(*value);
+    return S_OK;
+}
+static HRESULT WINAPI entries_get_Size(struct entry_iface *iface, UINT32 *value)
+{
+    *value = list_from_iface(iface)->count;
+    return S_OK;
+}
+static HRESULT WINAPI entries_IndexOf(struct entry_iface *iface, IUnknown *value, UINT32 *index, boolean *found)
+{
+    struct entry_list *list = list_from_iface(iface);
+    for (*index = 0; *index < list->count; (*index)++)
+        if (list->items[*index] == value) return (*found = TRUE), S_OK;
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI entries_GetMany(struct entry_iface *iface, UINT32 start, UINT32 size, IUnknown **items, UINT32 *count)
+{
+    struct entry_list *list = list_from_iface(iface);
+    UINT32 i;
+    for (i = 0; start + i < list->count && i < size; i++)
+    {
+        items[i] = list->items[start + i];
+        IUnknown_AddRef(items[i]);
+    }
+    *count = i;
+    return S_OK;
+}
+
+static const void *const entry_view_vtbl[] =
+{
+    entries_QueryInterface, entries_AddRef, entries_Release, entries_GetIids, entries_GetRuntimeClassName,
+    entries_GetTrustLevel, entries_GetAt, entries_get_Size, entries_IndexOf, entries_GetMany,
+};
+
+static const void *const entry_iterator_vtbl[];
+
+static HRESULT WINAPI entries_First(struct entry_iface *iface, struct entry_iface **out)
+{
+    struct entry_list *list = list_from_iface(iface);
+    struct entry_iterator *iter;
+
+    if (!(iter = calloc(1, sizeof(*iter)))) return E_OUTOFMEMORY;
+    iter->iface.lpVtbl = entry_iterator_vtbl;
+    iter->ref = 1;
+    iter->list = list;
+    InterlockedIncrement(&list->ref);
+    *out = &iter->iface;
+    return S_OK;
+}
+
+static const void *const entry_iterable_vtbl[] =
+{
+    entries_QueryInterface, entries_AddRef, entries_Release, entries_GetIids, entries_GetRuntimeClassName,
+    entries_GetTrustLevel, entries_First,
+};
+
+static HRESULT WINAPI entry_iterator_QueryInterface(struct entry_iface *iface, REFIID iid, void **out)
+{
+    struct entry_iterator *iter = CONTAINING_RECORD(iface, struct entry_iterator, iface);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, iter->list->iids->iterator))
+    {
+        InterlockedIncrement(&iter->ref);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI entry_iterator_AddRef(struct entry_iface *iface)
+{ return InterlockedIncrement(&CONTAINING_RECORD(iface, struct entry_iterator, iface)->ref); }
+static ULONG WINAPI entry_iterator_Release(struct entry_iface *iface)
+{
+    struct entry_iterator *iter = CONTAINING_RECORD(iface, struct entry_iterator, iface);
+    ULONG ref = InterlockedDecrement(&iter->ref);
+    if (!ref)
+    {
+        entries_Release(&iter->list->view);
+        free(iter);
+    }
+    return ref;
+}
+static HRESULT WINAPI entry_iterator_get_Current(struct entry_iface *iface, IUnknown **value)
+{
+    struct entry_iterator *iter = CONTAINING_RECORD(iface, struct entry_iterator, iface);
+    return entries_GetAt(&iter->list->view, iter->index, value);
+}
+static HRESULT WINAPI entry_iterator_get_HasCurrent(struct entry_iface *iface, boolean *value)
+{
+    struct entry_iterator *iter = CONTAINING_RECORD(iface, struct entry_iterator, iface);
+    *value = iter->index < iter->list->count;
+    return S_OK;
+}
+static HRESULT WINAPI entry_iterator_MoveNext(struct entry_iface *iface, boolean *value)
+{
+    struct entry_iterator *iter = CONTAINING_RECORD(iface, struct entry_iterator, iface);
+    if (iter->index < iter->list->count) iter->index++;
+    return entry_iterator_get_HasCurrent(iface, value);
+}
+static HRESULT WINAPI entry_iterator_GetMany(struct entry_iface *iface, UINT32 size, IUnknown **items, UINT32 *count)
+{
+    struct entry_iterator *iter = CONTAINING_RECORD(iface, struct entry_iterator, iface);
+    HRESULT hr = entries_GetMany(&iter->list->view, iter->index, size, items, count);
+    iter->index += *count;
+    return hr;
+}
+
+static const void *const entry_iterator_vtbl[] =
+{
+    entry_iterator_QueryInterface, entry_iterator_AddRef, entry_iterator_Release, entries_GetIids,
+    entries_GetRuntimeClassName, entries_GetTrustLevel,
+    entry_iterator_get_Current, entry_iterator_get_HasCurrent, entry_iterator_MoveNext, entry_iterator_GetMany,
+};
+
+static int __cdecl compare_names(const void *a, const void *b)
+{
+    const WCHAR *x = *(const WCHAR *const *)a, *y = *(const WCHAR *const *)b;
+    if (x[0] != y[0]) return x[0] == '\\' ? -1 : 1;
+    return lstrcmpiW(x + 1, y + 1);
+}
+
+/* the folders and/or files directly in impl's folder, folders first, each by name */
+static HRESULT list_entries(struct storage_folder *impl, enum entry_kind kind, void **operation)
+{
+    const struct entry_iids *iids = &entry_iids[kind];
+    WCHAR path[MAX_PATH], **names = NULL, **tmp;
+    UINT32 count = 0, capacity = 0, i;
+    struct entry_list *list = NULL;
+    WIN32_FIND_DATAW data;
+    HRESULT hr = S_OK;
+    HANDLE find;
+    BOOL is_dir;
