+/* ===== IStorageItemProperties of a StorageFile or StorageFolder: a tear-off holding its object ===== */
+
+struct item_properties
+{
+    const void *const *lpVtbl;
+    LONG ref;
+    IUnknown *outer;
+    BOOL folder;
+    WCHAR path[MAX_PATH];
+};
+
+static HRESULT WINAPI item_properties_QueryInterface(struct item_properties *impl, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IStorageItemProperties))
+    {
+        InterlockedIncrement(&impl->ref);
+        *out = impl;
+        return S_OK;
+    }
+    return IUnknown_QueryInterface(impl->outer, iid, out);
+}
+static ULONG WINAPI item_properties_AddRef(struct item_properties *impl) { return InterlockedIncrement(&impl->ref); }
+static ULONG WINAPI item_properties_Release(struct item_properties *impl)
+{
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        IUnknown_Release(impl->outer);
+        free(impl);
+    }
+    return ref;
+}
+static HRESULT WINAPI item_properties_GetIids(struct item_properties *impl, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI item_properties_GetRuntimeClassName(struct item_properties *impl, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI item_properties_GetTrustLevel(struct item_properties *impl, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI item_properties_GetThumbnailAsyncOverloadDefaultSizeDefaultOptions(struct item_properties *impl, int mode, void **operation)
+{
+    FIXME("%s, mode %d stub!\n", debugstr_w(impl->path), mode);
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI item_properties_GetThumbnailAsyncOverloadDefaultOptions(struct item_properties *impl, int mode, UINT32 size, void **operation)
+{
+    FIXME("%s, mode %d, size %u stub!\n", debugstr_w(impl->path), mode, size);
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI item_properties_GetThumbnailAsync(struct item_properties *impl, int mode, UINT32 size, int options, void **operation)
+{
+    FIXME("%s, mode %d, size %u, options %d stub!\n", debugstr_w(impl->path), mode, size, options);
+    return E_NOTIMPL;
+}
+/* a file's name without its extension, or a folder's name */
+static HRESULT WINAPI item_properties_get_DisplayName(struct item_properties *impl, HSTRING *value)
+{
+    const WCHAR *name = wcsrchr(impl->path, '\\'), *ext;
+
+    TRACE("%s.\n", debugstr_w(impl->path));
+    name = name ? name + 1 : impl->path;
+    if (impl->folder || !(ext = wcsrchr(name, '.')) || ext == name) ext = name + wcslen(name);
+    return WindowsCreateString(name, ext - name, value);
+}
+/* "File folder", or "<EXTENSION> File" as Explorer shows a file without a registered type */
+static HRESULT WINAPI item_properties_get_DisplayType(struct item_properties *impl, HSTRING *value)
+{
+    const WCHAR *name = wcsrchr(impl->path, '\\'), *ext;
+    WCHAR type[MAX_PATH], *p;
+
+    TRACE("%s.\n", debugstr_w(impl->path));
+    name = name ? name + 1 : impl->path;
+    if (impl->folder) return WindowsCreateString(L"File folder", 11, value);
+    if (!(ext = wcsrchr(name, '.')) || !ext[1]) return WindowsCreateString(L"File", 4, value);
+    swprintf(type, ARRAY_SIZE(type), L"%s File", ext + 1);
+    for (p = type; *p != ' '; p++) *p = towupper(*p);
+    return WindowsCreateString(type, wcslen(type), value);
+}
+static HRESULT WINAPI item_properties_get_FolderRelativeId(struct item_properties *impl, HSTRING *value)
+{
+    const WCHAR *name = wcsrchr(impl->path, '\\');
+
+    FIXME("%s: returning the name.\n", debugstr_w(impl->path));
+    name = name ? name + 1 : impl->path;
+    return WindowsCreateString(name, wcslen(name), value);
+}
+static HRESULT WINAPI item_properties_get_Properties(struct item_properties *impl, IUnknown **value)
+{
+    FIXME("%s stub!\n", debugstr_w(impl->path));
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const void *const item_properties_vtbl[] =
+{
+    item_properties_QueryInterface, item_properties_AddRef, item_properties_Release,
+    item_properties_GetIids, item_properties_GetRuntimeClassName, item_properties_GetTrustLevel,
+    item_properties_GetThumbnailAsyncOverloadDefaultSizeDefaultOptions, item_properties_GetThumbnailAsyncOverloadDefaultOptions,
+    item_properties_GetThumbnailAsync, item_properties_get_DisplayName, item_properties_get_DisplayType,
+    item_properties_get_FolderRelativeId, item_properties_get_Properties,
+};
+
+/* outer is AddRef'd and held */
+HRESULT item_properties_create(IUnknown *outer, const WCHAR *path, BOOL folder, void **out)
+{
+    struct item_properties *impl;
+
+    *out = NULL;
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->lpVtbl = item_properties_vtbl;
+    impl->ref = 1;
+    impl->outer = outer;
+    IUnknown_AddRef(outer);
+    impl->folder = folder;
+    lstrcpynW(impl->path, path, MAX_PATH);
+    *out = impl;
+    return S_OK;
+}
