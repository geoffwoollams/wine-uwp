diff --git a/dlls/twinapi.appcore/manifest.c b/dlls/twinapi.appcore/manifest.c
new file mode 100644
index 0000000..1f8594c
--- /dev/null
+++ b/dlls/twinapi.appcore/manifest.c
@@ -0,0 +1,112 @@
+/*
+ * Strings from the current package's AppxManifest.xml
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "appmodel.h"
+
+
+static char *manifest;
+static INIT_ONCE manifest_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK load_manifest(INIT_ONCE *once, void *param, void **ctx)
+{
+    WCHAR path[MAX_PATH];
+    UINT32 len = MAX_PATH - 20;
+    LARGE_INTEGER size;
+    DWORD read = 0;
+    HANDLE file;
+
+    if (GetCurrentPackagePath(&len, path)) return TRUE;
+    wcscat(path, L"\\AppxManifest.xml");
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE) return TRUE;
+    if (GetFileSizeEx(file, &size) && size.QuadPart < 4 * 1024 * 1024 && (manifest = malloc(size.QuadPart + 1)))
+    {
+        if (!ReadFile(file, manifest, size.QuadPart, &read, NULL)) read = 0;
+        manifest[read] = 0;
+    }
+    CloseHandle(file);
+    return TRUE;
+}
+
+/* Copies an XML value (UTF-8, with the five predefined entities) to a wide string. */
+static BOOL copy_value(const char *start, const char *end, WCHAR *out, UINT32 out_len)
+{
+    char *text, *dst;
+    const char *src;
+    int n;
+
+    if (!(text = malloc(end - start + 1))) return FALSE;
+    for (src = start, dst = text; src < end; src++)
+    {
+        if (*src != '&') { *dst++ = *src; continue; }
+        if (!strncmp(src, "&amp;", 5)) { *dst++ = '&'; src += 4; }
+        else if (!strncmp(src, "&lt;", 4)) { *dst++ = '<'; src += 3; }
+        else if (!strncmp(src, "&gt;", 4)) { *dst++ = '>'; src += 3; }
+        else if (!strncmp(src, "&quot;", 6)) { *dst++ = '"'; src += 5; }
+        else if (!strncmp(src, "&apos;", 6)) { *dst++ = '\''; src += 5; }
+        else *dst++ = *src;
+    }
+    *dst = 0;
+    n = MultiByteToWideChar(CP_UTF8, 0, text, -1, out, out_len);
+    free(text);
+    /* TODO: resolve ms-resource: references through the package's resources.pri */
+    return n > 1 && wcsncmp(out, L"ms-resource:", 12);
+}
+
+/* Text of the first <element>...</element> inside <Properties> (DisplayName, PublisherDisplayName, Description). */
+BOOL manifest_property(const char *element, WCHAR *out, UINT32 out_len)
+{
+    char open[64], close[64];
+    const char *props, *p, *e;
+
+    InitOnceExecuteOnce(&manifest_once, load_manifest, NULL, NULL);
+    if (!manifest || !(props = strstr(manifest, "<Properties"))) return FALSE;
+    snprintf(open, sizeof(open), "<%s>", element);
+    snprintf(close, sizeof(close), "</%s>", element);
+    if (!(p = strstr(props, open)) || !(e = strstr(p, close))) return FALSE;
+    return copy_value(p + strlen(open), e, out, out_len);
+}
+
+/* An attribute of the first application's VisualElements (DisplayName is the name Windows shows for the app). */
+BOOL manifest_app_visual(const char *attribute, WCHAR *out, UINT32 out_len)
+{
+    char pattern[64];
+    const char *p, *tag_end, *e;
+
+    InitOnceExecuteOnce(&manifest_once, load_manifest, NULL, NULL);
+    if (!manifest || !(p = strstr(manifest, "VisualElements "))) return FALSE;
+    tag_end = strchr(p, '>');
+    snprintf(pattern, sizeof(pattern), " %s=\"", attribute);
+    if (!(p = strstr(p, pattern)) || (tag_end && p > tag_end)) return FALSE;
+    p += strlen(pattern);
+    if (!(e = strchr(p, '"'))) return FALSE;
+    return copy_value(p, e, out, out_len);
+}
+
+/* The app's display name for window titles and the Store listing, falling back to the package name. */
+void app_display_name(WCHAR *out, UINT32 out_len)
+{
+    UINT64 buffer[128];
+    UINT32 len = sizeof(buffer);
+    const PACKAGE_ID *id = (const PACKAGE_ID *)buffer;
+
+    if (manifest_app_visual("DisplayName", out, out_len) || manifest_property("DisplayName", out, out_len)) return;
+    if (!GetCurrentPackageId(&len, (BYTE *)buffer) && id->name) lstrcpynW(out, id->name, out_len);
+    else if (out_len) out[0] = 0;
+}
diff --git a/dlls/twinapi.appcore/message_dialog.c b/dlls/twinapi.appcore/message_dialog.c
new file mode 100644
index 0000000..a626ab9
--- /dev/null
+++ b/dlls/twinapi.appcore/message_dialog.c
@@ -0,0 +1,122 @@
+/* WinRT Windows.UI.Popups.MessageDialog (prototype: logs the text and probes the interfaces) */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+struct probe_obj
+{
+    const void *const *lpVtbl;
+    GUID iid;
+    HSTRING content, title;
+};
+
+extern const void *const dialog_vtbl[];
+extern const void *const md_factory_probe_vtbl[];
+
+#define DSLOT(n) static HRESULT WINAPI dialog_slot##n(struct probe_obj *iface, void *a, void *b) \
+    { FIXME("dialog iface %s slot %d called (a=%p b=%p) content %s title %s.\n", debugstr_guid(&iface->iid), n, a, b, \
+            debugstr_hstring(iface->content), debugstr_hstring(iface->title)); return E_NOTIMPL; }
+DSLOT(6) DSLOT(7) DSLOT(8) DSLOT(9) DSLOT(10) DSLOT(11) DSLOT(12) DSLOT(13) DSLOT(14) DSLOT(15)
+
+static HRESULT WINAPI dialog_QueryInterface(struct probe_obj *iface, REFIID iid, void **out)
+{
+    struct probe_obj *p;
+    TRACE("iface %p, iid %s.\n", iface, debugstr_guid(iid));
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME("probing dialog interface %s.\n", debugstr_guid(iid));
+    if (!(p = calloc(1, sizeof(*p)))) return E_OUTOFMEMORY;
+    *p = *iface;
+    p->iid = *iid;
+    *out = p;
+    return S_OK;
+}
+static ULONG WINAPI dialog_AddRef(struct probe_obj *iface) { return 2; }
+static ULONG WINAPI dialog_Release(struct probe_obj *iface) { return 1; }
+static HRESULT WINAPI dialog_GetIids(struct probe_obj *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI dialog_GetRuntimeClassName(struct probe_obj *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI dialog_GetTrustLevel(struct probe_obj *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+
+const void *const dialog_vtbl[] = { dialog_QueryInterface, dialog_AddRef, dialog_Release, dialog_GetIids,
+    dialog_GetRuntimeClassName, dialog_GetTrustLevel,
+    dialog_slot6, dialog_slot7, dialog_slot8, dialog_slot9, dialog_slot10, dialog_slot11, dialog_slot12,
+    dialog_slot13, dialog_slot14, dialog_slot15 };
+
+static HRESULT make_dialog(HSTRING content, HSTRING title, void **out)
+{
+    struct probe_obj *d;
+
+    if (!(d = calloc(1, sizeof(*d)))) return E_OUTOFMEMORY;
+    d->lpVtbl = dialog_vtbl;
+    WindowsDuplicateString(content, &d->content);
+    WindowsDuplicateString(title, &d->title);
+    *out = d;
+    return S_OK;
+}
+
+/* factory interface (IMessageDialogFactory): slot 6 Create(content), slot 7 CreateWithTitle(content, title) */
+static HRESULT WINAPI factory_slot6(void *iface, HSTRING content, void **out)
+{
+    FIXME("MessageDialog::Create content %s\n", debugstr_hstring(content));
+    return make_dialog(content, NULL, out);
+}
+static HRESULT WINAPI factory_slot7(void *iface, HSTRING content, HSTRING title, void **out)
+{
+    FIXME("MessageDialog::CreateWithTitle title %s content %s\n", debugstr_hstring(title), debugstr_hstring(content));
+    return make_dialog(content, title, out);
+}
+
+struct md_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    const void *const *factory_iface; /* second interface: lpVtbl first */
+};
+static struct md_factory md_factory_obj;
+static GUID last_factory_iid;
+
+static HRESULT WINAPI md_factory_QueryInterface(IActivationFactory *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME("assuming %s is IMessageDialogFactory.\n", debugstr_guid(iid));
+    last_factory_iid = *iid;
+    *out = &md_factory_obj.factory_iface;
+    return S_OK;
+}
+static ULONG WINAPI md_factory_AddRef(IActivationFactory *iface) { return 2; }
+static ULONG WINAPI md_factory_Release(IActivationFactory *iface) { return 1; }
+static HRESULT WINAPI md_factory_GetIids(IActivationFactory *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI md_factory_GetRuntimeClassName(IActivationFactory *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI md_factory_GetTrustLevel(IActivationFactory *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI md_factory_ActivateInstance(IActivationFactory *iface, IInspectable **i) { return E_NOTIMPL; }
+static const IActivationFactoryVtbl md_factory_vtbl =
+{
+    md_factory_QueryInterface, md_factory_AddRef, md_factory_Release,
+    md_factory_GetIids, md_factory_GetRuntimeClassName, md_factory_GetTrustLevel,
+    md_factory_ActivateInstance,
+};
+
+static HRESULT WINAPI fi_QueryInterface(void *iface, REFIID iid, void **out)
+{ return md_factory_QueryInterface(&md_factory_obj.IActivationFactory_iface, iid, out); }
+static ULONG WINAPI fi_AddRef(void *iface) { return 2; }
+static ULONG WINAPI fi_Release(void *iface) { return 1; }
+static HRESULT WINAPI fi_GetIids(void *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI fi_GetRuntimeClassName(void *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI fi_GetTrustLevel(void *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+const void *const md_factory_probe_vtbl[] = { fi_QueryInterface, fi_AddRef, fi_Release, fi_GetIids,
+    fi_GetRuntimeClassName, fi_GetTrustLevel, factory_slot6, factory_slot7 };
+
+IActivationFactory *message_dialog_factory = &md_factory_obj.IActivationFactory_iface;
+void message_dialog_init(void)
+{
+    md_factory_obj.IActivationFactory_iface.lpVtbl = &md_factory_vtbl;
+    md_factory_obj.factory_iface = md_factory_probe_vtbl;
+}
