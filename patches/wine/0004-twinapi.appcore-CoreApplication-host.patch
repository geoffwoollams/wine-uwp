+static struct core_view *get_core_view(void)
+{
+    struct core_view *view = core_app_instance.view;
+    struct core_window *window;
+    struct core_dispatcher *dispatcher;
+
+    if (view) return view;
+    if (!(view = calloc(1, sizeof(*view))) || !(window = calloc(1, sizeof(*window))) ||
+        !(dispatcher = calloc(1, sizeof(*dispatcher))))
+        return NULL;
+    dispatcher->ICoreDispatcher_iface.lpVtbl = &core_dispatcher_vtbl;
+    dispatcher->ICoreAcceleratorKeys_iface.lpVtbl = &core_accel_vtbl;
+    dispatcher->ref = 1;
+    dispatcher->thread_id = GetCurrentThreadId();
+    InitializeCriticalSectionEx(&dispatcher->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    window->ICoreWindow_iface.lpVtbl = &core_window_vtbl;
+    window->ICoreWindowInterop_iface.lpVtbl = &interop_vtbl;
+    window->ICoreWindow2_iface.lpVtbl = &core_window2_vtbl;
+    window->ICoreWindow3_iface.lpVtbl = &core_window3_vtbl;
+    window->ICoreWindow4_iface.lpVtbl = &core_window4_vtbl;
+    window->ref = 1;
+    window->dispatcher = dispatcher;
+    view->ICoreApplicationView_iface.lpVtbl = &core_view_vtbl;
+    view->ICoreApplicationView2_iface.lpVtbl = &core_view2_vtbl;
+    view->ref = 1;
+    view->window = window;
+    core_app_instance.view = view;
+    return view;
+}
