+static HRESULT get_current_view(IApplicationView **out)
+{
+    IApplicationView *view, *old;
+    struct application_view *impl;
+
+    if (!(view = current_view))
+    {
+        if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+        impl->IApplicationView_iface.lpVtbl = &view_vtbl;
+        impl->IApplicationView2_iface.lpVtbl = &view2_vtbl;
+        impl->IApplicationView3_iface.lpVtbl = &view3_vtbl;
+        impl->ref = 1;
+        view = &impl->IApplicationView_iface;
+        if ((old = InterlockedCompareExchangePointer((void **)&current_view, view, NULL)))
+        {
+            IApplicationView_Release(view);
+            view = old;
+        }
+    }
+    IApplicationView_AddRef(view);
+    *out = view;
+    return S_OK;
+}
