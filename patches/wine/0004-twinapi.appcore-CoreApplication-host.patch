+struct treq { const void *const *lpVtbl; void *provider; HSTRING scope, client_id; INT32 prompt; GUID main_iid; BOOL main_set; void *props; };
+static HRESULT WINAPI treq_QI(struct treq *r, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject))
+    { *out = r; return S_OK; }
+    if (!r->main_set) { r->main_set = TRUE; r->main_iid = *iid; FIXME("WebTokenRequest main interface %s\n", debugstr_guid(iid)); *out = r; return S_OK; }
+    if (IsEqualGUID(iid, &r->main_iid)) { *out = r; return S_OK; }
+    FIXME("WebTokenRequest extra interface %s -> probe\n", debugstr_guid(iid));
+    { struct pobj *p = calloc(1, sizeof(*p)); if (!p) return E_OUTOFMEMORY; p->lpVtbl = pobj_vtbl; p->iid = *iid; p->cls = L"WebTokenRequest-extra"; *out = p; return S_OK; }
+}
