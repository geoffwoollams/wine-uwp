+static void map_put(void *map, const WCHAR *key, const WCHAR *value)
+{
+    IMap_HSTRING_HSTRING *m = map;
+    HSTRING k, v;
+    boolean replaced;
+    WindowsCreateString(key, wcslen(key), &k);
+    WindowsCreateString(value, wcslen(value), &v);
+    IMap_HSTRING_HSTRING_Insert(m, k, v, &replaced);
+    WindowsDeleteString(k);
+    WindowsDeleteString(v);
+}
