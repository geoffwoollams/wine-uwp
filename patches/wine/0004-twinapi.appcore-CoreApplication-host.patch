+}
+static HRESULT WINAPI st_get_AutoRotationPreferences(IDisplayInformationStatics *iface, UINT32 *v) { *v = 0; return S_OK; }
+static HRESULT WINAPI st_put_AutoRotationPreferences(IDisplayInformationStatics *iface, UINT32 v) { return S_OK; }
