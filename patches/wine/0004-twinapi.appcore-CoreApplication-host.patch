index 0000000..3551a9e
--- /dev/null
+++ b/dlls/twinapi.appcore/strmap_gen.c
@@ -0,0 +1,300 @@
+/* simple IMap<HSTRING,HSTRING>. */
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+struct strmap
+{
+    IMap_HSTRING_HSTRING IMap_HSTRING_HSTRING_iface;
+    IIterable_IKeyValuePair_HSTRING_HSTRING IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+    LONG ref;
+    HSTRING *keys, *values;
+    UINT32 count, capacity;
+};
+
+static HRESULT strmap_qi(struct strmap *impl, REFIID iid, void **out)
+{
+    TRACE("%p, %s, %p.\n", impl, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IMap_HSTRING_HSTRING))
+    {
+        *out = &impl->IMap_HSTRING_HSTRING_iface;
+        InterlockedIncrement(&impl->ref);
+        return S_OK;
+    }
+    if (IsEqualGUID(iid, &IID_IIterable_IKeyValuePair_HSTRING_HSTRING))
+    {
+        *out = &impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+        InterlockedIncrement(&impl->ref);
+        return S_OK;
+    }
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG strmap_addref(struct strmap *impl) { return InterlockedIncrement(&impl->ref); }
+static ULONG strmap_release(struct strmap *impl)
+{
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    UINT32 i;
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) { WindowsDeleteString(impl->keys[i]); WindowsDeleteString(impl->values[i]); }
+        free(impl->keys); free(impl->values); free(impl);
+    }
+    return ref;
+}
+
+/* ---- IKeyValuePair<HSTRING,HSTRING> ---- */
+struct skv { IKeyValuePair_HSTRING_HSTRING iface; LONG ref; HSTRING key, value; };
+static inline struct skv *skv_from(IKeyValuePair_HSTRING_HSTRING *i) { return CONTAINING_RECORD(i, struct skv, iface); }
+static HRESULT WINAPI skv_QI(IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject) ||
+        IsEqualGUID(iid, &IID_IKeyValuePair_HSTRING_HSTRING))
+    { *out = iface; InterlockedIncrement(&skv_from(iface)->ref); return S_OK; }
+    FIXME("kv: %s not implemented\n", debugstr_guid(iid)); *out = NULL; return E_NOINTERFACE;
+}
+static ULONG WINAPI skv_AddRef(IKeyValuePair_HSTRING_HSTRING *iface) { return InterlockedIncrement(&skv_from(iface)->ref); }
+static ULONG WINAPI skv_Release(IKeyValuePair_HSTRING_HSTRING *iface)
+{
+    struct skv *k = skv_from(iface);
+    ULONG r = InterlockedDecrement(&k->ref);
+    if (!r) { WindowsDeleteString(k->key); WindowsDeleteString(k->value); free(k); }
+    return r;
+}
+static HRESULT WINAPI skv_GetIids(IKeyValuePair_HSTRING_HSTRING *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI skv_GetRuntimeClassName(IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI skv_GetTrustLevel(IKeyValuePair_HSTRING_HSTRING *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI skv_get_Key(IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *v) { return WindowsDuplicateString(skv_from(iface)->key, v); }
+static HRESULT WINAPI skv_get_Value(IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *v) { return WindowsDuplicateString(skv_from(iface)->value, v); }
+static const IKeyValuePair_HSTRING_HSTRINGVtbl skv_vtbl = { skv_QI, skv_AddRef, skv_Release, skv_GetIids, skv_GetRuntimeClassName,
+    skv_GetTrustLevel, skv_get_Key, skv_get_Value };
+
+/* ---- IIterator (snapshot) ---- */
+struct sit { IIterator_IKeyValuePair_HSTRING_HSTRING iface; LONG ref; IKeyValuePair_HSTRING_HSTRING **items; UINT32 count, pos; };
+static inline struct sit *sit_from(IIterator_IKeyValuePair_HSTRING_HSTRING *i) { return CONTAINING_RECORD(i, struct sit, iface); }
+static HRESULT WINAPI sit_QI(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject) ||
+        IsEqualGUID(iid, &IID_IIterator_IKeyValuePair_HSTRING_HSTRING))
+    { *out = iface; InterlockedIncrement(&sit_from(iface)->ref); return S_OK; }
+    FIXME("iter: %s not implemented\n", debugstr_guid(iid)); *out = NULL; return E_NOINTERFACE;
+}
+static ULONG WINAPI sit_AddRef(IIterator_IKeyValuePair_HSTRING_HSTRING *iface) { return InterlockedIncrement(&sit_from(iface)->ref); }
+static ULONG WINAPI sit_Release(IIterator_IKeyValuePair_HSTRING_HSTRING *iface)
+{
+    struct sit *it = sit_from(iface);
+    ULONG r = InterlockedDecrement(&it->ref);
+    UINT32 i;
+    if (!r) { for (i = 0; i < it->count; i++) IKeyValuePair_HSTRING_HSTRING_Release(it->items[i]); free(it->items); free(it); }
+    return r;
+}
+static HRESULT WINAPI sit_GetIids(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI sit_GetRuntimeClassName(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI sit_GetTrustLevel(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI sit_get_Current(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, IKeyValuePair_HSTRING_HSTRING **v)
+{
+    struct sit *it = sit_from(iface);
+    if (it->pos >= it->count) return E_BOUNDS;
+    *v = it->items[it->pos]; IKeyValuePair_HSTRING_HSTRING_AddRef(*v); return S_OK;
+}
+static HRESULT WINAPI sit_get_HasCurrent(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, boolean *v)
+{ struct sit *it = sit_from(iface); *v = it->pos < it->count; return S_OK; }
+static HRESULT WINAPI sit_MoveNext(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, boolean *v)
+{ struct sit *it = sit_from(iface); if (it->pos < it->count) it->pos++; *v = it->pos < it->count; return S_OK; }
+static HRESULT WINAPI sit_GetMany(IIterator_IKeyValuePair_HSTRING_HSTRING *iface, UINT32 size, IKeyValuePair_HSTRING_HSTRING **items, UINT32 *actual)
+{
+    struct sit *it = sit_from(iface);
+    UINT32 n = 0;
+    while (n < size && it->pos < it->count) { items[n] = it->items[it->pos++]; IKeyValuePair_HSTRING_HSTRING_AddRef(items[n]); n++; }
+    *actual = n;
+    return S_OK;
+}
+static const IIterator_IKeyValuePair_HSTRING_HSTRINGVtbl sit_vtbl = { sit_QI, sit_AddRef, sit_Release, sit_GetIids,
+    sit_GetRuntimeClassName, sit_GetTrustLevel, sit_get_Current, sit_get_HasCurrent, sit_MoveNext, sit_GetMany };
+
+static int strmap_find(struct strmap *impl, HSTRING key)
+{
+    UINT32 i;
+    INT32 cmp;
+    for (i = 0; i < impl->count; i++)
+        if (SUCCEEDED(WindowsCompareStringOrdinal(impl->keys[i], key, &cmp)) && !cmp) return i;
+    return -1;
+}
+
+/* ---- IMap_HSTRING_HSTRING on strmap ---- */
+static inline struct strmap *impl_from_strmap_i(IMap_HSTRING_HSTRING *iface)
+{ return CONTAINING_RECORD(iface, struct strmap, IMap_HSTRING_HSTRING_iface); }
+
+static HRESULT WINAPI strmap_i_QueryInterface(IMap_HSTRING_HSTRING *iface, REFIID iid, void **out)
+{ return strmap_qi(impl_from_strmap_i(iface), iid, out); }
+static ULONG WINAPI strmap_i_AddRef(IMap_HSTRING_HSTRING *iface)
+{ return strmap_addref(impl_from_strmap_i(iface)); }
+static ULONG WINAPI strmap_i_Release(IMap_HSTRING_HSTRING *iface)
+{ return strmap_release(impl_from_strmap_i(iface)); }
+static HRESULT WINAPI strmap_i_GetIids(IMap_HSTRING_HSTRING *iface, ULONG *count, IID **iids)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI strmap_i_GetRuntimeClassName(IMap_HSTRING_HSTRING *iface, HSTRING *name)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI strmap_i_GetTrustLevel(IMap_HSTRING_HSTRING *iface, TrustLevel *level)
+{ *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI strmap_i_Lookup(IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING *value)
+{
+    struct strmap *impl __attribute__((unused)) = impl_from_strmap_i(iface);
+    int idx = strmap_find(impl, key);
+    if (idx < 0) { *value = NULL; return E_BOUNDS; }
+    return WindowsDuplicateString(impl->values[idx], value);
+}
+
+static HRESULT WINAPI strmap_i_get_Size(IMap_HSTRING_HSTRING *iface, unsigned int *size)
+{
+    struct strmap *impl __attribute__((unused)) = impl_from_strmap_i(iface);
+    *size = impl->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI strmap_i_HasKey(IMap_HSTRING_HSTRING *iface, HSTRING key, boolean *found)
+{
+    struct strmap *impl __attribute__((unused)) = impl_from_strmap_i(iface);
+    *found = strmap_find(impl, key) >= 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI strmap_i_GetView(IMap_HSTRING_HSTRING *iface, __FIMapView_2_HSTRING_HSTRING **view)
+{
+    FIXME("iface %p stub!\n", iface);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI strmap_i_Insert(IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING value, boolean *replaced)
+{
+    struct strmap *impl __attribute__((unused)) = impl_from_strmap_i(iface);
+    int idx = strmap_find(impl, key);
+    TRACE("key %s value %s.\n", debugstr_hstring(key), debugstr_hstring(value));
+    if (idx >= 0)
+    {
+        WindowsDeleteString(impl->values[idx]);
+        WindowsDuplicateString(value, &impl->values[idx]);
+        *replaced = TRUE;
+        return S_OK;
+    }
+    if (impl->count == impl->capacity)
+    {
+        UINT32 cap = impl->capacity ? impl->capacity * 2 : 8;
+        HSTRING *k = realloc(impl->keys, cap * sizeof(*k)), *v;
+        if (!k) return E_OUTOFMEMORY;
+        impl->keys = k;
+        if (!(v = realloc(impl->values, cap * sizeof(*v)))) return E_OUTOFMEMORY;
+        impl->values = v;
+        impl->capacity = cap;
+    }
+    WindowsDuplicateString(key, &impl->keys[impl->count]);
+    WindowsDuplicateString(value, &impl->values[impl->count]);
+    impl->count++;
+    *replaced = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI strmap_i_Remove(IMap_HSTRING_HSTRING *iface, HSTRING key)
+{
+    struct strmap *impl __attribute__((unused)) = impl_from_strmap_i(iface);
+    int idx = strmap_find(impl, key);
+    if (idx < 0) return E_BOUNDS;
+    WindowsDeleteString(impl->keys[idx]); WindowsDeleteString(impl->values[idx]);
+    memmove(&impl->keys[idx], &impl->keys[idx + 1], (impl->count - idx - 1) * sizeof(*impl->keys));
+    memmove(&impl->values[idx], &impl->values[idx + 1], (impl->count - idx - 1) * sizeof(*impl->values));
+    impl->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI strmap_i_Clear(IMap_HSTRING_HSTRING *iface)
+{
+    struct strmap *impl __attribute__((unused)) = impl_from_strmap_i(iface);
+    UINT32 i;
+    for (i = 0; i < impl->count; i++) { WindowsDeleteString(impl->keys[i]); WindowsDeleteString(impl->values[i]); }
+    impl->count = 0;
+    return S_OK;
+}
+
+static const IMap_HSTRING_HSTRINGVtbl strmap_i_vtbl =
+{
+    strmap_i_QueryInterface,
+    strmap_i_AddRef,
+    strmap_i_Release,
+    strmap_i_GetIids,
+    strmap_i_GetRuntimeClassName,
+    strmap_i_GetTrustLevel,
+    strmap_i_Lookup,
+    strmap_i_get_Size,
+    strmap_i_HasKey,
+    strmap_i_GetView,
+    strmap_i_Insert,
+    strmap_i_Remove,
+    strmap_i_Clear,
+};
+
+/* ---- IIterable_IKeyValuePair_HSTRING_HSTRING on strmap ---- */
+static inline struct strmap *impl_from_strmap_it(IIterable_IKeyValuePair_HSTRING_HSTRING *iface)
+{ return CONTAINING_RECORD(iface, struct strmap, IIterable_IKeyValuePair_HSTRING_HSTRING_iface); }
+
+static HRESULT WINAPI strmap_it_QueryInterface(IIterable_IKeyValuePair_HSTRING_HSTRING *iface, REFIID iid, void **out)
+{ return strmap_qi(impl_from_strmap_it(iface), iid, out); }
+static ULONG WINAPI strmap_it_AddRef(IIterable_IKeyValuePair_HSTRING_HSTRING *iface)
+{ return strmap_addref(impl_from_strmap_it(iface)); }
+static ULONG WINAPI strmap_it_Release(IIterable_IKeyValuePair_HSTRING_HSTRING *iface)
+{ return strmap_release(impl_from_strmap_it(iface)); }
+static HRESULT WINAPI strmap_it_GetIids(IIterable_IKeyValuePair_HSTRING_HSTRING *iface, ULONG *count, IID **iids)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI strmap_it_GetRuntimeClassName(IIterable_IKeyValuePair_HSTRING_HSTRING *iface, HSTRING *name)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI strmap_it_GetTrustLevel(IIterable_IKeyValuePair_HSTRING_HSTRING *iface, TrustLevel *level)
+{ *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI strmap_it_First(IIterable_IKeyValuePair_HSTRING_HSTRING *iface, __FIIterator_1___FIKeyValuePair_2_HSTRING_HSTRING **value)
+{
+    struct strmap *impl __attribute__((unused)) = impl_from_strmap_it(iface);
+    struct sit *it = calloc(1, sizeof(*it));
+    UINT32 i;
+    if (!it) return E_OUTOFMEMORY;
+    it->iface.lpVtbl = &sit_vtbl;
+    it->ref = 1;
+    if (impl->count && !(it->items = calloc(impl->count, sizeof(*it->items)))) { free(it); return E_OUTOFMEMORY; }
+    for (i = 0; i < impl->count; i++)
+    {
+        struct skv *k = calloc(1, sizeof(*k));
+        if (!k) break;
+        k->iface.lpVtbl = &skv_vtbl;
+        k->ref = 1;
+        WindowsDuplicateString(impl->keys[i], &k->key);
+        WindowsDuplicateString(impl->values[i], &k->value);
+        it->items[it->count++] = &k->iface;
+    }
+    *value = &it->iface;
+    return S_OK;
+}
