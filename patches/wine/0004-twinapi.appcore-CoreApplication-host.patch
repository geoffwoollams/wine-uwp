+static const IIterable_IKeyValuePair_HSTRING_HSTRINGVtbl strmap_it_vtbl =
+{
+    strmap_it_QueryInterface,
+    strmap_it_AddRef,
+    strmap_it_Release,
+    strmap_it_GetIids,
+    strmap_it_GetRuntimeClassName,
+    strmap_it_GetTrustLevel,
+    strmap_it_First,
+};
