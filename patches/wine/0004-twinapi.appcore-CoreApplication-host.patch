+#define WM_CORE_SET_FULLSCREEN (WM_APP + 0x7c1)
+#define WM_CORE_RAISE_SIZE     (WM_APP + 0x7c2)
+static void apply_fullscreen(HWND hwnd, BOOL fullscreen);
+
+static LRESULT CALLBACK core_window_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct core_window *window = (struct core_window *)GetWindowLongPtrW(hwnd, GWLP_USERDATA);
+
+    switch (msg)
+    {
+    case WM_CORE_SET_FULLSCREEN:
+        apply_fullscreen(hwnd, wparam != 0);
+        return 0;
+    case WM_CORE_RAISE_SIZE:
+        if (window)
+        {
+            RECT client;
+            GetClientRect(hwnd, &client);
+            core_input_raise_size(&window->ICoreWindow_iface, client.right, client.bottom);
+        }
+        return 0;
+    case WM_CLOSE:
+        FIXME("WM_CLOSE: posting quit.\n");
+        PostQuitMessage(0);
+        return 0;
+    }
+    if (window && core_input_message(hwnd, msg, wparam, lparam, &window->ICoreWindow_iface))
+    {
+        if (msg == WM_SYSKEYDOWN || msg == WM_SYSKEYUP || msg == WM_ACTIVATE || msg == WM_SIZE || msg == WM_SHOWWINDOW)
+            return DefWindowProcW(hwnd, msg, wparam, lparam);
+        return 0;
+    }
+    return DefWindowProcW(hwnd, msg, wparam, lparam);
+}
+
+/* The CoreWindow is created borderless at monitor size and stays that size (TryEnterFullScreenMode is then a no-op):
+ * resizing an X11 window after it is mapped with a Vulkan swapchain can leave it without pointer input under
+ * XWayland. The app still learns its size from SizeChanged, raised when it activates the window.
+ * WINE_CORE_WINDOWED=1 gives a normal 1280x720 window instead. */
+static BOOL fullscreen_wanted = TRUE;
+static RECT windowed_rect;   /* outer window rect while windowed */
+static HWND created_hwnd;
+
+static void get_monitor_rect(HWND hwnd, RECT *rect)
+{
+    MONITORINFO info = { sizeof(info) };
+    HMONITOR monitor = hwnd ? MonitorFromWindow(hwnd, MONITOR_DEFAULTTOPRIMARY) : MonitorFromPoint((POINT){ 0, 0 }, MONITOR_DEFAULTTOPRIMARY);
+
+    if (monitor && GetMonitorInfoW(monitor, &info)) *rect = info.rcMonitor;
+    else SetRect(rect, 0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN));
+}
+
+/* View pixels per physical pixel divisor: 1.0 like a 100% scaled Windows display, overridable with WINE_CORE_SCALE. */
+float core_view_scale(void)
+{
+    static float scale;
+    WCHAR buf[32];
+
+    if (scale) return scale;
+    if (GetEnvironmentVariableW(L"WINE_CORE_SCALE", buf, ARRAY_SIZE(buf)) && wcstod(buf, NULL) >= 1.0) scale = wcstod(buf, NULL);
+    else scale = 1.0f;
+    FIXME("view scale %f.\n", scale);
+    return scale;
+}
+
+static void core_default_bounds(RECT *rect)
+{
+    SetRect(rect, 0, 0, 1280, 720);
+}
+
+static BOOL windowed_forced(void)
+{
+    return GetEnvironmentVariableW(L"WINE_CORE_WINDOWED", NULL, 0) != 0;
+}
+
+static void apply_fullscreen(HWND hwnd, BOOL fullscreen)
+{
+    UINT flags = SWP_FRAMECHANGED | SWP_SHOWWINDOW;
+    RECT rect;
+
+    /* do the change on the window's own thread, like the CoreWindow dispatcher does on Windows */
+    if (GetWindowThreadProcessId(hwnd, NULL) != GetCurrentThreadId())
+    {
+        PostMessageW(hwnd, WM_CORE_SET_FULLSCREEN, fullscreen, 0);
+        return;
+    }
+    /* Only the size changes: the style is chosen once at creation, because switching a window between captioned
+     * and borderless can leave the X11/Wayland window without pointer input. */
+    if (fullscreen)
+    {
+        GetWindowRect(hwnd, &windowed_rect);
+        get_monitor_rect(hwnd, &rect);
+        SetWindowPos(hwnd, HWND_TOP, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top, flags);
+        FIXME("window %p: borderless fullscreen %ldx%ld.\n", hwnd, rect.right - rect.left, rect.bottom - rect.top);
+    }
+    else
+    {
+        SetWindowPos(hwnd, HWND_NOTOPMOST, windowed_rect.left, windowed_rect.top, windowed_rect.right - windowed_rect.left,
+                     windowed_rect.bottom - windowed_rect.top, flags);
+        FIXME("window %p: launch size.\n", hwnd);
+    }
+}
+
+/* Called from ApplicationView.TryEnterFullScreenMode / ExitFullScreenMode. */
+void core_window_set_fullscreen(BOOL fullscreen)
+{
+    if (fullscreen && windowed_forced()) { FIXME("WINE_CORE_WINDOWED set, staying windowed.\n"); return; }
+    if (fullscreen == fullscreen_wanted)
+    {
+        /* already in that mode: the app still expects SizeChanged after its request, so re-send the current size */
+        if (created_hwnd) PostMessageW(created_hwnd, WM_CORE_RAISE_SIZE, 0, 0);
+        return;
+    }
+    fullscreen_wanted = fullscreen;
+    if (created_hwnd) apply_fullscreen(created_hwnd, fullscreen);
+}
+
+static HWND create_core_hwnd(void)
+{
+    static const WCHAR class_name[] = L"WineCoreWindow";
+    WNDCLASSW wc = { 0 };
+    WCHAR title[128] = L"";
+    RECT rect, monitor;
+    DWORD style;
+    HWND hwnd;
+
+    wc.lpfnWndProc = core_window_proc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.hCursor = LoadCursorW(NULL, (const WCHAR *)IDC_ARROW);
+    wc.hbrBackground = GetStockObject(BLACK_BRUSH);
+    wc.lpszClassName = class_name;
+    RegisterClassW(&wc);
+
+    /* launch size: 1280x720 client, centred on the primary monitor (used when windowed) */
+    get_monitor_rect(NULL, &monitor);
+    SetRect(&rect, 0, 0, 1280, 720);
+    OffsetRect(&rect, monitor.left + max(0, (monitor.right - monitor.left - 1280) / 2),
+               monitor.top + max(0, (monitor.bottom - monitor.top - 720) / 2));
+    style = windowed_forced() ? WS_OVERLAPPEDWINDOW : WS_POPUP;
+    AdjustWindowRect(&rect, style, FALSE);
+    windowed_rect = rect;
+    if (windowed_forced()) fullscreen_wanted = FALSE;
+    if (fullscreen_wanted) rect = monitor;
+    app_display_name(title, ARRAY_SIZE(title));
+    hwnd = CreateWindowExW(0, class_name, title, style, rect.left, rect.top,
+                           rect.right - rect.left, rect.bottom - rect.top, NULL, NULL, wc.hInstance, NULL);
+    created_hwnd = hwnd;
+    TRACE("created hwnd %p %s (%ldx%ld).\n", hwnd, debugstr_w(title), rect.right - rect.left, rect.bottom - rect.top);
+    return hwnd;
+}
