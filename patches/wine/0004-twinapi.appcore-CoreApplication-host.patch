+static HRESULT create_success_result(struct treq *request, void **out)
+{
+    const struct xbox_identity *id = get_xbox_identity();
+    struct tresult *res;
+    void *account, *response, *props = NULL, *vec;
+    WCHAR token[160];
+    HSTRING user, token_str;
+    HRESULT hr;
+
+    swprintf(token, ARRAY_SIZE(token), L"XBL3.0 x=%s;b2ZmbGluZS10b2tlbg", id->user_id);
+    WindowsCreateString(id->email, wcslen(id->email), &user);
+    WindowsCreateString(token, wcslen(token), &token_str);
+    hr = create_account(request ? request->provider : NULL, user, 1, &account);
+    if (SUCCEEDED(hr)) hr = create_response(token_str, account, NULL, &response);
+    WindowsDeleteString(user);
+    WindowsDeleteString(token_str);
+    if (FAILED(hr)) return hr;
+
+    if (SUCCEEDED(tresp_get_Properties((struct tresp *)response, &props)))
+    {
+        map_put(props, L"Environment", L"prod");
+        map_put(props, L"Gamertag", id->gamertag);
+        map_put(props, L"Restrictions", L"");
+        map_put(props, L"Privileges", L"");
+        map_put(props, L"XboxUserId", id->user_id);
+        map_put(props, L"UniqueModernGamertag", id->gamertag);
+        map_put(props, L"ModernGamertag", id->gamertag);
+        map_put(props, L"Sandbox", L"RETAIL");
+        map_put(props, L"AgeGroup", L"Adult");
+        map_put(props, L"ModernGamertagSuffix", L"");
+        map_put(props, L"Signature", L"");
+    }
+    if (FAILED(hr = single_vector_create(response, &vec))) return hr;
+    if (!(res = calloc(1, sizeof(*res)))) return E_OUTOFMEMORY;
+    res->lpVtbl = tres_vtbl;
+    res->responses = vec;
+    FIXME("WebTokenRequestResult: success for gamertag %s\n", debugstr_w(id->gamertag));
+    *out = res;
+    return S_OK;
+}
