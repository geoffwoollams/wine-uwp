+static struct core_action *create_core_action(void)
+{
+    struct core_action *a;
+    if (!(a = calloc(1, sizeof(*a)))) return NULL;
+    a->IAsyncAction_iface.lpVtbl = &action_vtbl;
+    a->IAsyncInfo_iface.lpVtbl = &ainfo_vtbl;
+    a->ref = 1;
+    a->status = Started;
+    InitializeCriticalSectionEx(&a->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    return a;
+}
+
+static void complete_core_action(struct core_action *a)
+{
+    IAsyncActionCompletedHandler *handler;
+
+    EnterCriticalSection(&a->cs);
+    a->status = Completed;
+    handler = a->handler;
+    if (handler) IAsyncActionCompletedHandler_AddRef(handler);
+    LeaveCriticalSection(&a->cs);
+    if (handler)
+    {
+        IAsyncActionCompletedHandler_Invoke(handler, &a->IAsyncAction_iface, Completed);
+        IAsyncActionCompletedHandler_Release(handler);
+    }
+}
