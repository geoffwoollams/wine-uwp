+
+void core_input_raise_activated(ICoreWindow *sender, CoreWindowActivationState state)
+{
+    UINT32 i;
+    TRACE("sender %p, state %d, %u handlers.\n", sender, state, handlers[EV_ACTIVATED].n);
+    for (i = 0; i < handlers[EV_ACTIVATED].n; i++)
+    {
+        struct act_args *a = calloc(1, sizeof(*a));
+        if (!a) return;
+        a->IWindowActivatedEventArgs_iface.lpVtbl = &aargs_vtbl;
+        a->ICoreWindowEventArgs_iface.lpVtbl = &aargs_cw_vtbl;
+        a->ref = 1;
+        a->state = state;
+        ITypedEventHandler_CoreWindow_WindowActivatedEventArgs_Invoke(
+                (ITypedEventHandler_CoreWindow_WindowActivatedEventArgs *)handlers[EV_ACTIVATED].h[i], sender, &a->IWindowActivatedEventArgs_iface);
+        IWindowActivatedEventArgs_Release(&a->IWindowActivatedEventArgs_iface);
+    }
+}
+
+void core_input_raise_visibility(ICoreWindow *sender, BOOL visible)
+{
+    UINT32 i;
+    TRACE("sender %p, visible %d, %u handlers.\n", sender, visible, handlers[EV_VISIBILITY].n);
+    for (i = 0; i < handlers[EV_VISIBILITY].n; i++)
+    {
+        struct vis_args *a = calloc(1, sizeof(*a));
+        if (!a) return;
+        a->IVisibilityChangedEventArgs_iface.lpVtbl = &vargs_vtbl;
+        a->ICoreWindowEventArgs_iface.lpVtbl = &vargs_cw_vtbl;
+        a->ref = 1;
+        a->visible = visible;
+        ITypedEventHandler_CoreWindow_VisibilityChangedEventArgs_Invoke(
+                (ITypedEventHandler_CoreWindow_VisibilityChangedEventArgs *)handlers[EV_VISIBILITY].h[i], sender, &a->IVisibilityChangedEventArgs_iface);
+        IVisibilityChangedEventArgs_Release(&a->IVisibilityChangedEventArgs_iface);
+    }
+}
+
+void core_input_raise_size(ICoreWindow *sender, float w, float h)
+{
+    UINT32 i;
+    w /= core_view_scale(); h /= core_view_scale();
+    TRACE("sender %p, size %fx%f, %u handlers.\n", sender, w, h, handlers[EV_SIZE].n);
+    for (i = 0; i < handlers[EV_SIZE].n; i++)
+    {
+        struct size_args *a = calloc(1, sizeof(*a));
+        if (!a) return;
+        a->IWindowSizeChangedEventArgs_iface.lpVtbl = &sargs_vtbl;
+        a->ICoreWindowEventArgs_iface.lpVtbl = &sargs_cw_vtbl;
+        a->ref = 1;
+        a->w = w; a->h = h;
+        ITypedEventHandler_CoreWindow_WindowSizeChangedEventArgs_Invoke(
+                (ITypedEventHandler_CoreWindow_WindowSizeChangedEventArgs *)handlers[EV_SIZE].h[i], sender, &a->IWindowSizeChangedEventArgs_iface);
+        IWindowSizeChangedEventArgs_Release(&a->IWindowSizeChangedEventArgs_iface);
+    }
+}
+
+
+static CorePhysicalKeyStatus key_status(LPARAM lparam)
+{
+    CorePhysicalKeyStatus s;
+
+    s.RepeatCount = lparam & 0xffff;
+    s.ScanCode = (lparam >> 16) & 0xff;
+    s.IsExtendedKey = (lparam >> 24) & 1;
+    s.IsMenuKeyDown = GetKeyState(VK_MENU) < 0;
+    s.WasKeyDown = (lparam >> 30) & 1;
+    s.IsKeyReleased = (lparam >> 31) & 1;
+    return s;
+}
+
+static __x_ABI_CWindows_CSystem_CVirtualKeyModifiers current_modifiers(void)
+{
+    __x_ABI_CWindows_CSystem_CVirtualKeyModifiers m = 0;
+    if (GetKeyState(VK_CONTROL) < 0) m |= 1;
+    if (GetKeyState(VK_MENU) < 0) m |= 2;
+    if (GetKeyState(VK_SHIFT) < 0) m |= 4;
+    if (GetKeyState(VK_LWIN) < 0 || GetKeyState(VK_RWIN) < 0) m |= 8;
+    return m;
+}
+
+static void raise_pointer(ICoreWindow *sender, int ev, struct pointer_data *d)
+{
+    UINT32 i;
+
+    if (ev == EV_PPRESSED || ev == EV_PRELEASED)
+        TRACE("pointer %s at %.0f,%.0f, %u handlers.\n", ev == EV_PPRESSED ? "pressed" : "released", d->x, d->y, handlers[ev].n);
+
+    for (i = 0; i < handlers[ev].n; i++)
+    {
+        struct pointer_args *args = calloc(1, sizeof(*args));
+        if (!args) return;
+        args->IPointerEventArgs_iface.lpVtbl = &pargs_vtbl;
+        args->ICoreWindowEventArgs_iface.lpVtbl = &pargs_cw_vtbl;
+        args->ref = 1;
+        args->d = *d;
+        ITypedEventHandler_CoreWindow_PointerEventArgs_Invoke(
+                (ITypedEventHandler_CoreWindow_PointerEventArgs *)handlers[ev].h[i], sender, &args->IPointerEventArgs_iface);
+        IPointerEventArgs_Release(&args->IPointerEventArgs_iface);
+    }
+}
+
+/* Called from the window procedure on the UI thread. Returns TRUE when the message was turned into an event. */
+BOOL core_input_message(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam, ICoreWindow *sender)
+{
+    UINT32 i;
+
+    switch (msg)
+    {
+    case WM_ACTIVATE:
+        core_input_raise_activated(sender, LOWORD(wparam) == WA_INACTIVE ? CoreWindowActivationState_Deactivated :
+                                   (LOWORD(wparam) == WA_CLICKACTIVE ? CoreWindowActivationState_PointerActivated : CoreWindowActivationState_CodeActivated));
+        return TRUE;
+    case WM_SIZE:
+        if (wparam != SIZE_MINIMIZED) core_input_raise_size(sender, (float)LOWORD(lparam), (float)HIWORD(lparam));
+        return TRUE;
+    case WM_SHOWWINDOW:
+        core_input_raise_visibility(sender, wparam != 0);
+        return TRUE;
+    case WM_KEYDOWN: case WM_SYSKEYDOWN: case WM_KEYUP: case WM_SYSKEYUP:
+    {
+        int ev = (msg == WM_KEYDOWN || msg == WM_SYSKEYDOWN) ? EV_KEYDOWN : EV_KEYUP;
+        for (i = 0; i < handlers[ev].n; i++)
+        {
+            struct key_args *args = calloc(1, sizeof(*args));
+            if (!args) return FALSE;
+            args->IKeyEventArgs_iface.lpVtbl = &kargs_vtbl;
+            args->ICoreWindowEventArgs_iface.lpVtbl = &kargs_cw_vtbl;
+            args->ref = 1;
+            args->vkey = wparam;
+            args->status = key_status(lparam);
+            TRACE("key event %d vkey %#Ix\n", ev, wparam);
+            ITypedEventHandler_CoreWindow_KeyEventArgs_Invoke(
+                    (ITypedEventHandler_CoreWindow_KeyEventArgs *)handlers[ev].h[i], sender, &args->IKeyEventArgs_iface);
+            IKeyEventArgs_Release(&args->IKeyEventArgs_iface);
+        }
+        return TRUE;
+    }
+    case WM_CHAR:
+        for (i = 0; i < handlers[EV_CHAR].n; i++)
+        {
+            struct char_args *args = calloc(1, sizeof(*args));
+            if (!args) return FALSE;
+            args->ICharacterReceivedEventArgs_iface.lpVtbl = &cargs_vtbl;
+            args->ICoreWindowEventArgs_iface.lpVtbl = &cargs_cw_vtbl;
+            args->ref = 1;
+            args->code = wparam;
+            args->status = key_status(lparam);
+            ITypedEventHandler_CoreWindow_CharacterReceivedEventArgs_Invoke(
+                    (ITypedEventHandler_CoreWindow_CharacterReceivedEventArgs *)handlers[EV_CHAR].h[i], sender,
+                    &args->ICharacterReceivedEventArgs_iface);
+            ICharacterReceivedEventArgs_Release(&args->ICharacterReceivedEventArgs_iface);
+        }
+        return TRUE;
+    case WM_MOUSEMOVE: case WM_LBUTTONDOWN: case WM_LBUTTONUP: case WM_RBUTTONDOWN: case WM_RBUTTONUP:
+    case WM_MBUTTONDOWN: case WM_MBUTTONUP: case WM_MOUSEWHEEL: case WM_MOUSEHWHEEL:
+    {
+        struct pointer_data d = { 0 };
+        POINT pt = { (short)LOWORD(lparam), (short)HIWORD(lparam) };
+        int ev;
+        WPARAM keys = LOWORD(wparam);
+
+        if (msg == WM_MOUSEWHEEL || msg == WM_MOUSEHWHEEL) ScreenToClient(hwnd, &pt);
+        d.x = pt.x / core_view_scale(); d.y = pt.y / core_view_scale();
+        d.left = keys & MK_LBUTTON; d.right = keys & MK_RBUTTON; d.middle = keys & MK_MBUTTON;
+        d.x1 = keys & MK_XBUTTON1; d.x2 = keys & MK_XBUTTON2;
+        d.timestamp = GetTickCount64() * 1000;
+        d.modifiers = current_modifiers();
+        switch (msg)
+        {
+        case WM_LBUTTONDOWN: ev = EV_PPRESSED; d.kind = PointerUpdateKind_LeftButtonPressed; SetCapture(hwnd); break;
+        case WM_LBUTTONUP: ev = EV_PRELEASED; d.kind = PointerUpdateKind_LeftButtonReleased; ReleaseCapture(); break;
+        case WM_RBUTTONDOWN: ev = EV_PPRESSED; d.kind = PointerUpdateKind_RightButtonPressed; break;
+        case WM_RBUTTONUP: ev = EV_PRELEASED; d.kind = PointerUpdateKind_RightButtonReleased; break;
+        case WM_MBUTTONDOWN: ev = EV_PPRESSED; d.kind = PointerUpdateKind_MiddleButtonPressed; break;
+        case WM_MBUTTONUP: ev = EV_PRELEASED; d.kind = PointerUpdateKind_MiddleButtonReleased; break;
+        case WM_MOUSEWHEEL: ev = EV_PWHEEL; d.wheel = (short)HIWORD(wparam); break;
+        case WM_MOUSEHWHEEL: ev = EV_PWHEEL; d.wheel = (short)HIWORD(wparam); d.horizontal_wheel = TRUE; break;
+        default: ev = EV_PMOVED; d.kind = PointerUpdateKind_Other; break;
+        }
+        raise_pointer(sender, ev, &d);
+        return TRUE;
+    }
+    }
+    return FALSE;
+}
