+static HRESULT WINAPI st_QueryInterface(IDisplayInformationStatics *iface, REFIID iid, void **out)
+{ return di_factory_QueryInterface(&di_factory_obj.IActivationFactory_iface, iid, out); }
+static ULONG WINAPI st_AddRef(IDisplayInformationStatics *iface) { return 2; }
+static ULONG WINAPI st_Release(IDisplayInformationStatics *iface) { return 1; }
+static HRESULT WINAPI st_GetIids(IDisplayInformationStatics *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI st_GetRuntimeClassName(IDisplayInformationStatics *iface, HSTRING *n) { return E_NOTIMPL; }
