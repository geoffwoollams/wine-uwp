index 0000000..db8367d
--- /dev/null
+++ b/dlls/twinapi.appcore/thread_pool_timer.c
@@ -0,0 +1,119 @@
+/* WinRT Windows.System.Threading.ThreadPoolTimer (prototype, hand-declared interfaces) */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+struct timer_obj
+{
+    const void *const *lpVtbl;
+    LONG ref;
+    IUnknown *handler;
+    INT64 period, delay;
+    HANDLE queue_timer;
+};
+
+struct handler_vtbl { HRESULT (WINAPI *QueryInterface)(void *, REFIID, void **); ULONG (WINAPI *AddRef)(void *);
+                      ULONG (WINAPI *Release)(void *); HRESULT (WINAPI *Invoke)(void *, void *); };
+
+static HRESULT WINAPI timer_QI(struct timer_obj *t, REFIID iid, void **out)
+{
+    TRACE("timer %p, iid %s.\n", t, debugstr_guid(iid));
+    *out = t;
+    InterlockedIncrement(&t->ref);
+    return S_OK;
+}
+static ULONG WINAPI timer_AddRef(struct timer_obj *t) { return InterlockedIncrement(&t->ref); }
+static ULONG WINAPI timer_Release(struct timer_obj *t)
+{
+    ULONG ref = InterlockedDecrement(&t->ref);
+    if (!ref)
+    {
+        if (t->queue_timer) DeleteTimerQueueTimer(NULL, t->queue_timer, INVALID_HANDLE_VALUE);
+        if (t->handler) IUnknown_Release(t->handler);
+        free(t);
+    }
+    return ref;
+}
+static HRESULT WINAPI timer_GetIids(struct timer_obj *t, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI timer_GetRuntimeClassName(struct timer_obj *t, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI timer_GetTrustLevel(struct timer_obj *t, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI timer_get_Period(struct timer_obj *t, INT64 *v) { *v = t->period; return S_OK; }
+static HRESULT WINAPI timer_get_Delay(struct timer_obj *t, INT64 *v) { *v = t->delay; return S_OK; }
+static HRESULT WINAPI timer_Cancel(struct timer_obj *t)
+{
+    TRACE("timer %p cancel.\n", t);
+    if (t->queue_timer) { DeleteTimerQueueTimer(NULL, t->queue_timer, NULL); t->queue_timer = NULL; }
+    return S_OK;
+}
+static const void *const timer_vtbl[] = { timer_QI, timer_AddRef, timer_Release, timer_GetIids, timer_GetRuntimeClassName,
+    timer_GetTrustLevel, timer_get_Period, timer_get_Delay, timer_Cancel };
+
+static VOID CALLBACK timer_cb(void *ctx, BOOLEAN fired)
+{
+    struct timer_obj *t = ctx;
+    InterlockedIncrement(&t->ref);
+    ((struct handler_vtbl *)*(void **)t->handler)->Invoke(t->handler, t);
+    timer_Release(t);
+}
+
+static HRESULT create_timer(void *handler, INT64 period, INT64 delay, BOOL periodic, void **out)
+{
+    struct timer_obj *t;
+    DWORD due, per;
+
+    if (!(t = calloc(1, sizeof(*t)))) return E_OUTOFMEMORY;
+    t->lpVtbl = timer_vtbl;
+    t->ref = 1;
+    t->period = period;
+    t->delay = delay;
+    t->handler = handler;
+    if (handler) IUnknown_AddRef((IUnknown *)handler);
+    due = (DWORD)((periodic ? period : delay) / 10000);
+    per = periodic ? due : 0;
+    TRACE("timer %p due %lu ms period %lu ms.\n", t, due, per);
+    if (!CreateTimerQueueTimer(&t->queue_timer, NULL, timer_cb, t, due, per, WT_EXECUTEDEFAULT))
+    {
+        timer_Release(t);
+        return HRESULT_FROM_WIN32(GetLastError());
+    }
+    /* the queue keeps a reference through ctx; released when the object is released */
+    *out = t;
+    return S_OK;
+}
+
+/* statics: slot 6 CreatePeriodicTimer(handler, period, out), 7 CreateTimer(handler, delay, out),
+ * 8 CreatePeriodicTimerWithCompletion(handler, period, destroyed, out), 9 CreateTimerWithCompletion(handler, delay, destroyed, out) */
+static HRESULT WINAPI st_slot6(void *i, void *h, INT64 period, void **out) { return create_timer(h, period, 0, TRUE, out); }
+static HRESULT WINAPI st_slot7(void *i, void *h, INT64 delay, void **out) { return create_timer(h, 0, delay, FALSE, out); }
+static HRESULT WINAPI st_slot8(void *i, void *h, INT64 period, void *d, void **out) { return create_timer(h, period, 0, TRUE, out); }
+static HRESULT WINAPI st_slot9(void *i, void *h, INT64 delay, void *d, void **out) { return create_timer(h, 0, delay, FALSE, out); }
+static HRESULT WINAPI st_QI(void *i, REFIID iid, void **out) { *out = i; return S_OK; }
+static ULONG WINAPI st_AddRef(void *i) { return 2; }
+static ULONG WINAPI st_Release(void *i) { return 1; }
+static HRESULT WINAPI st_GetIids(void *i, ULONG *c, IID **ids) { return E_NOTIMPL; }
+static HRESULT WINAPI st_GetRuntimeClassName(void *i, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI st_GetTrustLevel(void *i, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static const void *const statics_vtbl[] = { st_QI, st_AddRef, st_Release, st_GetIids, st_GetRuntimeClassName,
+    st_GetTrustLevel, st_slot6, st_slot7, st_slot8, st_slot9 };
+static struct { const void *const *lpVtbl; } statics_obj = { statics_vtbl };
+
+static HRESULT WINAPI f_QI(IActivationFactory *iface, REFIID iid, void **out)
+{
+    TRACE("iid %s.\n", debugstr_guid(iid));
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+    { *out = iface; return S_OK; }
+    FIXME("assuming %s is IThreadPoolTimerStatics.\n", debugstr_guid(iid));
+    *out = &statics_obj;
+    return S_OK;
+}
+static ULONG WINAPI f_AddRef(IActivationFactory *iface) { return 2; }
+static ULONG WINAPI f_Release(IActivationFactory *iface) { return 1; }
+static HRESULT WINAPI f_GetIids(IActivationFactory *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI f_GetRuntimeClassName(IActivationFactory *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI f_GetTrustLevel(IActivationFactory *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI f_ActivateInstance(IActivationFactory *iface, IInspectable **i) { return E_NOTIMPL; }
+static const IActivationFactoryVtbl f_vtbl = { f_QI, f_AddRef, f_Release, f_GetIids, f_GetRuntimeClassName,
+    f_GetTrustLevel, f_ActivateInstance };
+static IActivationFactory f_obj = { &f_vtbl };
+IActivationFactory *thread_pool_timer_factory = &f_obj;
diff --git a/dlls/twinapi.appcore/user_gen.c b/dlls/twinapi.appcore/user_gen.c
new file mode 100644
index 0000000..d30b5cf
--- /dev/null
+++ b/dlls/twinapi.appcore/user_gen.c
@@ -0,0 +1,142 @@
+/* Windows.System.User for a single offline local user. */
+#include "private.h"
+#include "roapi.h"
+#include "windows.system.h"
+#include "windows.foundation.h"
+#define IUser __x_ABI_CWindows_CSystem_CIUser
+#define IUserVtbl __x_ABI_CWindows_CSystem_CIUserVtbl
+#define IID_IUser IID___x_ABI_CWindows_CSystem_CIUser
+#define IUser_AddRef __x_ABI_CWindows_CSystem_CIUser_AddRef
+#define IUser_Release __x_ABI_CWindows_CSystem_CIUser_Release
+#define IPropertyValueStatics __x_ABI_CWindows_CFoundation_CIPropertyValueStatics
+#define IID_IPropertyValueStatics IID___x_ABI_CWindows_CFoundation_CIPropertyValueStatics
+#define IPropertyValueStatics_CreateString __x_ABI_CWindows_CFoundation_CIPropertyValueStatics_CreateString
+#define IPropertyValueStatics_Release __x_ABI_CWindows_CFoundation_CIPropertyValueStatics_Release
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+#include "xbox_identity.h"
+extern HRESULT completed_ptr_operation( void *ptr, void **out );
+extern HRESULT failed_operation( HRESULT hr, void **out );
+
+struct user { IUser IUser_iface; LONG ref; };
+static struct user user_instance;
+
+static HRESULT user_qi(struct user *impl, REFIID iid, void **out)
+{
+    TRACE("%p, %s, %p.\n", impl, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IUser))
+    {
+        *out = &impl->IUser_iface;
+        return S_OK;
+    }
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG user_addref(struct user *impl) { return 2; }
+static ULONG user_release(struct user *impl) { return 1; }
+
+static HRESULT make_string_value(const WCHAR *str, void **out)
+{
+    static const WCHAR classname[] = L"Windows.Foundation.PropertyValue";
+    IPropertyValueStatics *statics;
+    HSTRING cls, value;
+    HRESULT hr;
+
+    WindowsCreateString(classname, ARRAY_SIZE(classname) - 1, &cls);
+    hr = RoGetActivationFactory(cls, &IID_IPropertyValueStatics, (void **)&statics);
+    WindowsDeleteString(cls);
+    if (FAILED(hr)) return hr;
+    WindowsCreateString(str, wcslen(str), &value);
+    hr = IPropertyValueStatics_CreateString(statics, value, (IInspectable **)out);
+    WindowsDeleteString(value);
+    IPropertyValueStatics_Release(statics);
+    return hr;
+}
+
+/* ---- IUser on user ---- */
+static inline struct user *impl_from_user_i(IUser *iface)
+{ return CONTAINING_RECORD(iface, struct user, IUser_iface); }
+
+static HRESULT WINAPI user_i_QueryInterface(IUser *iface, REFIID iid, void **out)
+{ return user_qi(impl_from_user_i(iface), iid, out); }
+static ULONG WINAPI user_i_AddRef(IUser *iface)
+{ return user_addref(impl_from_user_i(iface)); }
+static ULONG WINAPI user_i_Release(IUser *iface)
+{ return user_release(impl_from_user_i(iface)); }
+static HRESULT WINAPI user_i_GetIids(IUser *iface, ULONG *count, IID **iids)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI user_i_GetRuntimeClassName(IUser *iface, HSTRING *name)
+{ FIXME("iface %p stub!\n", iface); return E_NOTIMPL; }
+static HRESULT WINAPI user_i_GetTrustLevel(IUser *iface, TrustLevel *level)
+{ *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI user_i_get_NonRoamableId(IUser *iface, HSTRING *value)
+{
+    struct user *impl __attribute__((unused)) = impl_from_user_i(iface);
+    const WCHAR *id = get_xbox_identity()->user_id;
+    return WindowsCreateString(id, wcslen(id), value);
+}
+
+static HRESULT WINAPI user_i_get_AuthenticationStatus(IUser *iface, __x_ABI_CWindows_CSystem_CUserAuthenticationStatus *value)
+{
+    struct user *impl __attribute__((unused)) = impl_from_user_i(iface);
+    *value = UserAuthenticationStatus_LocallyAuthenticated;
+    return S_OK;
+}
+
+static HRESULT WINAPI user_i_get_Type(IUser *iface, __x_ABI_CWindows_CSystem_CUserType *value)
+{
+    struct user *impl __attribute__((unused)) = impl_from_user_i(iface);
+    *value = UserType_LocalUser;
+    return S_OK;
+}
+
+static HRESULT WINAPI user_i_GetPropertyAsync(IUser *iface, HSTRING value, __FIAsyncOperation_1_IInspectable **operation)
+{
+    struct user *impl __attribute__((unused)) = impl_from_user_i(iface);
+    void *prop = NULL;
+    TRACE("property %s.\n", debugstr_hstring(value));
+    make_string_value(get_xbox_identity()->gamertag, &prop);
+    return completed_ptr_operation(prop, (void **)operation);
+}
+
+static HRESULT WINAPI user_i_GetPropertiesAsync(IUser *iface, __FIVectorView_1_HSTRING *values, __FIAsyncOperation_1_Windows__CFoundation__CCollections__CIPropertySet **operation)
+{
+    struct user *impl __attribute__((unused)) = impl_from_user_i(iface);
+    FIXME("iface %p stub!\n", iface);
+    return completed_ptr_operation(NULL, (void **)operation);
+}
+
+static HRESULT WINAPI user_i_GetPictureAsync(IUser *iface, __x_ABI_CWindows_CSystem_CUserPictureSize desired_size, __FIAsyncOperation_1_Windows__CStorage__CStreams__CIRandomAccessStreamReference **operation)
+{
+    struct user *impl __attribute__((unused)) = impl_from_user_i(iface);
+    return failed_operation(E_NOTIMPL, (void **)operation);
+}
+
+static const IUserVtbl user_i_vtbl =
+{
+    user_i_QueryInterface,
+    user_i_AddRef,
+    user_i_Release,
+    user_i_GetIids,
+    user_i_GetRuntimeClassName,
+    user_i_GetTrustLevel,
+    user_i_get_NonRoamableId,
+    user_i_get_AuthenticationStatus,
+    user_i_get_Type,
+    user_i_GetPropertyAsync,
+    user_i_GetPropertiesAsync,
+    user_i_GetPictureAsync,
+};
+
+
+IUser *offline_user(void)
+{
+    user_instance.IUser_iface.lpVtbl = &user_i_vtbl;
+    user_instance.ref = 1;
+    return &user_instance.IUser_iface;
+}
diff --git a/dlls/twinapi.appcore/user_statics.c b/dlls/twinapi.appcore/user_statics.c
new file mode 100644
index 0000000..f7b0f96
--- /dev/null
+++ b/dlls/twinapi.appcore/user_statics.c
@@ -0,0 +1,124 @@
+/* Windows.System.User statics (hand-declared IUserStatics) returning the single offline user. */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+#include "windows.system.h"
+#define IUser __x_ABI_CWindows_CSystem_CIUser
+extern IUser *offline_user(void);
+extern HRESULT completed_ptr_operation( void *ptr, void **out );
+
+/* ---- IVectorView<User*> (hand-declared; the pinterface IID is accepted blindly) ---- */
+struct uvec { const void *const *lpVtbl; void *item; };
+struct uvec_iter { const void *const *lpVtbl; BOOL done; void *item; };
+
+static HRESULT WINAPI vi_QI(void *i, REFIID iid, void **out) { TRACE("vi iid %s\n", debugstr_guid(iid)); *out = i; return S_OK; }
+static ULONG WINAPI vi_AddRef(void *i) { return 2; }
+static ULONG WINAPI vi_Release(void *i) { return 1; }
+static HRESULT WINAPI vi_GetIids(void *i, ULONG *c, IID **ids) { return E_NOTIMPL; }
+static HRESULT WINAPI vi_GetRuntimeClassName(void *i, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI vi_GetTrustLevel(void *i, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+/* IIterator<User*>: Current, HasCurrent, MoveNext, GetMany */
+static HRESULT WINAPI vi_get_Current(struct uvec_iter *it, void **v) { *v = it->item; return S_OK; }
+static HRESULT WINAPI vi_get_HasCurrent(struct uvec_iter *it, boolean *v) { *v = !it->done; return S_OK; }
+static HRESULT WINAPI vi_MoveNext(struct uvec_iter *it, boolean *v) { it->done = TRUE; *v = FALSE; return S_OK; }
+static HRESULT WINAPI vi_GetMany(struct uvec_iter *it, UINT32 size, void **items, UINT32 *actual)
+{
+    if (size && !it->done) { items[0] = it->item; it->done = TRUE; *actual = 1; } else *actual = 0;
+    return S_OK;
+}
+static const void *const iter_vtbl[] = { vi_QI, vi_AddRef, vi_Release, vi_GetIids, vi_GetRuntimeClassName, vi_GetTrustLevel,
+    vi_get_Current, vi_get_HasCurrent, vi_MoveNext, vi_GetMany };
+
+/* IVectorView<User*> methods (slot 6..9) and IIterable<User*>::First, which we expose on the same object at slot 10 */
+static HRESULT WINAPI vv_GetAt(struct uvec *v, UINT32 index, void **value)
+{ if (index || !v->item) return E_BOUNDS; *value = v->item; return S_OK; }
+static HRESULT WINAPI vv_get_Size(struct uvec *v, UINT32 *size) { *size = v->item ? 1 : 0; return S_OK; }
+static HRESULT WINAPI vv_IndexOf(struct uvec *v, void *element, UINT32 *index, boolean *found)
+{ *index = 0; *found = (element == v->item); return S_OK; }
+static HRESULT WINAPI vv_GetMany(struct uvec *v, UINT32 start, UINT32 size, void **items, UINT32 *actual)
+{
+    if (!start && size && v->item) { items[0] = v->item; *actual = 1; } else *actual = 0;
+    return S_OK;
+}
+static HRESULT WINAPI vv_First(struct uvec *v, void **iter)
+{
+    struct uvec_iter *it = calloc(1, sizeof(*it));
+    if (!it) return E_OUTOFMEMORY;
+    it->lpVtbl = iter_vtbl;
+    it->item = v->item;
+    it->done = !v->item;
+    *iter = it;
+    return S_OK;
+}
+/* One object serves both IVectorView (slots 6-9) and IIterable (slot 6 'First'): decide at QI time is not possible without
+ * the IIDs, so IIterable::First is also exposed as slot 6 of a second vtable returned for the 2nd distinct IID asked. */
+static HRESULT WINAPI vv_QI(void *i, REFIID iid, void **out);
+static const void *const vview_vtbl[] = { vv_QI, vi_AddRef, vi_Release, vi_GetIids, vi_GetRuntimeClassName, vi_GetTrustLevel,
+    vv_GetAt, vv_get_Size, vv_IndexOf, vv_GetMany };
+static const void *const viter_vtbl[] = { vv_QI, vi_AddRef, vi_Release, vi_GetIids, vi_GetRuntimeClassName, vi_GetTrustLevel,
+    vv_First };
+struct svec { struct uvec view; struct uvec iterable; int qi_count; };
+static HRESULT WINAPI vv_QI(void *i, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject))
+    { *out = i; return S_OK; }
+    {
+        struct uvec *u = i;
+        struct svec *sv = CONTAINING_RECORD(u->lpVtbl == viter_vtbl ? u : u, struct svec, view);
+        if (u->lpVtbl == viter_vtbl) sv = CONTAINING_RECORD(u, struct svec, iterable);
+        FIXME("single-item vector QI %s (#%d)\n", debugstr_guid(iid), sv->qi_count);
+        *out = sv->qi_count++ ? (void *)&sv->iterable : (void *)&sv->view;
+        return S_OK;
+    }
+}
+
+HRESULT single_vector_create( void *item, void **out )
+{
+    struct svec *sv = calloc(1, sizeof(*sv));
+    if (!sv) return E_OUTOFMEMORY;
+    sv->view.lpVtbl = vview_vtbl; sv->view.item = item;
+    sv->iterable.lpVtbl = viter_vtbl; sv->iterable.item = item;
+    *out = &sv->view;
+    return S_OK;
+}
+
+/* ---- IUserStatics: 6 CreateWatcher, 7 FindAllAsync, 8 FindAllAsyncByType, 9 FindAllAsyncByTypeAndStatus, 10 GetFromId ---- */
+static HRESULT user_list_op(void **op)
+{
+    void *v;
+    HRESULT hr = single_vector_create(offline_user(), &v);
+    if (FAILED(hr)) return hr;
+    return completed_ptr_operation(v, op);
+}
+static HRESULT WINAPI us_CreateWatcher(void *i, void **w) { FIXME("User::CreateWatcher stub\n"); *w = NULL; return E_NOTIMPL; }
+static HRESULT WINAPI us_FindAllAsync(void *i, void **op)
+{ TRACE("User::FindAllAsync\n"); return user_list_op(op); }
+static HRESULT WINAPI us_FindAllAsyncByType(void *i, INT32 type, void **op)
+{ TRACE("User::FindAllAsyncByType %d\n", type); return user_list_op(op); }
+static HRESULT WINAPI us_FindAllAsyncByTypeAndStatus(void *i, INT32 type, INT32 status, void **op)
+{ TRACE("User::FindAllAsyncByTypeAndStatus\n"); return user_list_op(op); }
+static HRESULT WINAPI us_GetFromId(void *i, HSTRING id, void **user) { TRACE("User::GetFromId\n"); *user = offline_user(); return S_OK; }
+static const void *const statics_vtbl[] = { vi_QI, vi_AddRef, vi_Release, vi_GetIids, vi_GetRuntimeClassName, vi_GetTrustLevel,
+    us_CreateWatcher, us_FindAllAsync, us_FindAllAsyncByType, us_FindAllAsyncByTypeAndStatus, us_GetFromId };
+static struct { const void *const *lpVtbl; } statics_obj = { statics_vtbl };
+
+static HRESULT WINAPI uf_QI(IActivationFactory *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+    { *out = iface; return S_OK; }
+    FIXME("assuming %s is IUserStatics.\n", debugstr_guid(iid));
+    *out = &statics_obj;
+    return S_OK;
+}
+static ULONG WINAPI uf_AddRef(IActivationFactory *iface) { return 2; }
+static ULONG WINAPI uf_Release(IActivationFactory *iface) { return 1; }
+static HRESULT WINAPI uf_GetIids(IActivationFactory *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI uf_GetRuntimeClassName(IActivationFactory *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI uf_GetTrustLevel(IActivationFactory *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI uf_ActivateInstance(IActivationFactory *iface, IInspectable **i) { return E_NOTIMPL; }
+static const IActivationFactoryVtbl uf_vtbl = { uf_QI, uf_AddRef, uf_Release, uf_GetIids, uf_GetRuntimeClassName,
+    uf_GetTrustLevel, uf_ActivateInstance };
+static IActivationFactory uf_obj = { &uf_vtbl };
+IActivationFactory *user_statics_factory = &uf_obj;
diff --git a/dlls/twinapi.appcore/xbox_identity.c b/dlls/twinapi.appcore/xbox_identity.c
new file mode 100644
index 0000000..cadd4c7
--- /dev/null
+++ b/dlls/twinapi.appcore/xbox_identity.c
@@ -0,0 +1,35 @@
+/* Offline Xbox identity for the signed-in local user: the gamertag is the OS account name and the user ID (XUID) is a
+ * stable number derived from it, so saves and settings keep working across runs without any Xbox Live sign-in. */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+#include "xbox_identity.h"
+
+static struct xbox_identity identity;
+static INIT_ONCE identity_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK init_identity(INIT_ONCE *once, void *param, void **ctx)
+{
+    WCHAR name[64];
+    DWORD size = ARRAY_SIZE(name);
+    UINT64 hash = 0xcbf29ce484222325ull;
+    const WCHAR *p;
+
+    lstrcpynW(identity.gamertag, L"Player", ARRAY_SIZE(identity.gamertag));
+    if (GetUserNameW(name, &size) && name[0] && lstrcmpiW(name, L"Administrator"))
+        lstrcpynW(identity.gamertag, name, ARRAY_SIZE(identity.gamertag));
+
+    /* FNV-1a of the gamertag, folded into a 16-digit decimal XUID-like number */
+    for (p = identity.gamertag; *p; p++) { hash ^= *p; hash *= 0x100000001b3ull; }
+    swprintf(identity.user_id, ARRAY_SIZE(identity.user_id), L"%I64u", 2000000000000000ull + hash % 1000000000000000ull);
+    swprintf(identity.email, ARRAY_SIZE(identity.email), L"%s@localhost.invalid", identity.gamertag);
+    TRACE("offline identity: gamertag %s, id %s\n", debugstr_w(identity.gamertag), debugstr_w(identity.user_id));
+    return TRUE;
+}
+
+const struct xbox_identity *get_xbox_identity(void)
+{
+    InitOnceExecuteOnce(&identity_once, init_identity, NULL, NULL);
+    return &identity;
+}
