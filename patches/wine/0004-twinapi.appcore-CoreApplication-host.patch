+static HRESULT WINAPI core_app_Run(ICoreApplication *iface, __x_ABI_CWindows_CApplicationModel_CCore_CIFrameworkViewSource *view_source)
+{
+    struct core_app *impl __attribute__((unused)) = impl_from_core_app(iface);
+    IFrameworkView *fview;
+    struct core_view *view;
+    HSTRING entry;
+    HRESULT hr;
+
+    FIXME("iface %p, view_source %p semi-stub!\n", iface, view_source);
+
+    if (!view_source) return E_INVALIDARG;
+    if (!(view = get_core_view())) return E_OUTOFMEMORY;
+    if (FAILED(hr = IFrameworkViewSource_CreateView(view_source, &fview))) return hr;
+
+    if (!view->window->hwnd)
+    {
+        view->window->hwnd = create_core_hwnd();
+        SetWindowLongPtrW(view->window->hwnd, GWLP_USERDATA, (LONG_PTR)view->window);
+    }
+    TRACE("Initialize\n");
+    if (SUCCEEDED(hr = IFrameworkView_Initialize(fview, &view->ICoreApplicationView_iface)))
+    {
+        TRACE("SetWindow\n");
+        if (SUCCEEDED(hr = IFrameworkView_SetWindow(fview, &view->window->ICoreWindow_iface)))
+        {
+            WindowsCreateString(L"", 0, &entry);
+            TRACE("Load\n");
+            hr = IFrameworkView_Load(fview, entry);
+            WindowsDeleteString(entry);
+        }
+        if (SUCCEEDED(hr))
+        {
+            struct core_args *args = calloc(1, sizeof(*args));
+            UINT32 i;
+
+            if (args)
+            {
+                args->IActivatedEventArgs_iface.lpVtbl = &core_args_vtbl;
+                args->launch_vtbl = launch_vtbl;
+                args->ref = 1;
+                for (i = 0; i < view->activated_count; i++)
+                {
+                    TRACE("Raising Activated handler %p\\n", view->activated[i]);
+                    ITypedEventHandler_CoreApplicationView_IActivatedEventArgs_Invoke(view->activated[i],
+                            &view->ICoreApplicationView_iface, &args->IActivatedEventArgs_iface);
+                }
+                IActivatedEventArgs_Release(&args->IActivatedEventArgs_iface);
+            }
+        }
+        if (SUCCEEDED(hr))
+        {
+            TRACE("Run\n");
+            hr = IFrameworkView_Run(fview);
+        }
+        IFrameworkView_Uninitialize(fview);
+    }
+    IFrameworkView_Release(fview);
+    TRACE("Run returning %#lx\n", hr);
+    return hr;
+}
