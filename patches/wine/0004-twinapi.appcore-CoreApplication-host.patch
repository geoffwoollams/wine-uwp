+++ b/dlls/twinapi.appcore/store.c
@@ -0,0 +1,285 @@
+/* Windows.Services.Store (prototype): an offline StoreContext. Wine has no Store client, so the running (base) app is
+ * reported as licensed, as Windows does for an installed app while offline; no add-on licences are reported.  Interfaces are hand-declared: every object is a plain
+ * vtable of slot functions and accepts any QueryInterface (with the 2-IID view/iterable trick for map views). */
+#include "private.h"
+#include "appmodel.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+extern HRESULT completed_ptr_operation( void *ptr, void **out );
+extern HRESULT completed_int_operation( INT32 result, void **out );
+extern HRESULT failed_operation( HRESULT hr, void **out );
+extern HRESULT single_vector_create( void *item, void **out );
+extern void *offline_user(void);
+
+struct obj { const void *const *lpVtbl; };
+
+/* ---------------- add-on products (none offline) ---------------- */
+#define MAX_PRODUCTS 128
+struct product
+{
+    const void *const *lpVtbl;
+    WCHAR product_id[64], store_id[24], kind[24], name[128];
+    HSTRING h_store_id;
+};
+static struct product products[MAX_PRODUCTS];
+static UINT32 product_count;
+static INIT_ONCE store_once = INIT_ONCE_STATIC_INIT;
+/* TODO: Store IDs are not in the package manifest; this is the Store ID of the only app tested so far (Halo Wars 2). */
+static WCHAR app_store_id[24] = L"9NBLGGH5WMKM";
+extern const void *const product_vtbl[];
+extern const void *const license_obj_vtbl[];
+extern const void *const pmap_view_vtbl[];
+extern const void *const pmap_iterable_vtbl[];
+
+static BOOL CALLBACK init_store(INIT_ONCE *once, void *param, void **ctx)
+{
+    product_count = 0;   /* no add-on catalogue or licences without a Store client */
+    return TRUE;
+}
+static void store_init(void) { InitOnceExecuteOnce(&store_once, init_store, NULL, NULL); }
+
+/* ---------------- common slot helpers ---------------- */
+static HRESULT WINAPI o_QI(void *o, REFIID iid, void **out) { TRACE("obj %p iid %s\n", o, debugstr_guid(iid)); *out = o; return S_OK; }
+static ULONG WINAPI o_AddRef(void *o) { return 2; }
+static ULONG WINAPI o_Release(void *o) { return 1; }
+static HRESULT WINAPI o_GetIids(void *o, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI o_GetRuntimeClassName(void *o, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI o_GetTrustLevel(void *o, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+#define BASE o_QI, o_AddRef, o_Release, o_GetIids, o_GetRuntimeClassName, o_GetTrustLevel
+#define STUB(name, n) static HRESULT WINAPI name##_stub##n(void *o, void *a, void *b, void *c) \
+    { FIXME(#name " slot %d not implemented (a=%p b=%p c=%p)\n", n, a, b, c); return E_NOTIMPL; }
+
+static HRESULT str_out(const WCHAR *s, HSTRING *out) { return WindowsCreateString(s, wcslen(s), out); }
+
+/* ---------------- empty / filled collections ---------------- */
+static HRESULT empty_vec(void **out) { return single_vector_create(NULL, out); }
+
+/* IMapView<HSTRING, V*> : slots 6 Lookup, 7 Size, 8 HasKey, 9 Split ; iterable slot 6 First */
+struct pmap { const void *const *lpVtbl; struct pmap *twin; UINT32 count; HSTRING *keys; void **vals; int qi; };
+struct pmap_pair { struct pmap view, iterable; };
+struct kv { const void *const *lpVtbl; HSTRING key; void *val; };
+struct kvit { const void *const *lpVtbl; struct pmap *map; UINT32 pos; };
+
+static HRESULT WINAPI kv_get_Key(struct kv *k, HSTRING *v) { return WindowsDuplicateString(k->key, v); }
+static HRESULT WINAPI kv_get_Value(struct kv *k, void **v) { *v = k->val; return S_OK; }
+static const void *const kv_vtbl[] = { BASE, kv_get_Key, kv_get_Value };
+
+static HRESULT WINAPI it_get_Current(struct kvit *it, void **v)
+{
+    struct kv *k;
+    if (it->pos >= it->map->count) return E_BOUNDS;
+    if (!(k = calloc(1, sizeof(*k)))) return E_OUTOFMEMORY;
+    k->lpVtbl = kv_vtbl; k->key = it->map->keys[it->pos]; k->val = it->map->vals[it->pos];
+    *v = k;
+    return S_OK;
+}
+static HRESULT WINAPI it_get_HasCurrent(struct kvit *it, boolean *v) { *v = it->pos < it->map->count; return S_OK; }
+static HRESULT WINAPI it_MoveNext(struct kvit *it, boolean *v) { if (it->pos < it->map->count) it->pos++; *v = it->pos < it->map->count; return S_OK; }
+static HRESULT WINAPI it_GetMany(struct kvit *it, UINT32 size, void **items, UINT32 *actual)
+{
+    UINT32 n = 0;
+    while (n < size && it->pos < it->map->count) { if (FAILED(it_get_Current(it, &items[n]))) break; it->pos++; n++; }
+    *actual = n;
+    return S_OK;
+}
+static const void *const it_vtbl[] = { BASE, it_get_Current, it_get_HasCurrent, it_MoveNext, it_GetMany };
+
+static HRESULT WINAPI pm_Lookup(struct pmap *m, HSTRING key, void **v)
+{
+    UINT32 i;
+    INT32 cmp;
+    for (i = 0; i < m->count; i++)
+        if (SUCCEEDED(WindowsCompareStringOrdinal(m->keys[i], key, &cmp)) && !cmp) { *v = m->vals[i]; return S_OK; }
+    *v = NULL;
+    return E_BOUNDS;
+}
+static HRESULT WINAPI pm_Size(struct pmap *m, UINT32 *s) { *s = m->count; return S_OK; }
+static HRESULT WINAPI pm_HasKey(struct pmap *m, HSTRING key, boolean *f) { void *v; *f = SUCCEEDED(pm_Lookup(m, key, &v)); return S_OK; }
+static HRESULT WINAPI pm_Split(struct pmap *m, void **a, void **b) { *a = *b = NULL; return E_NOTIMPL; }
+static HRESULT WINAPI pm_First(struct pmap *m, void **iter)
+{
+    struct kvit *it = calloc(1, sizeof(*it));
+    if (!it) return E_OUTOFMEMORY;
+    it->lpVtbl = it_vtbl; it->map = m;
+    *iter = it;
+    return S_OK;
+}
+static HRESULT WINAPI pm_QI(struct pmap *m, REFIID iid, void **out)
+{
+    struct pmap_pair *pair = CONTAINING_RECORD(m->twin ? m->twin : m, struct pmap_pair, view);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject)) { *out = m; return S_OK; }
+    /* The game's range-for asks for IIterable first, then IMapView for lookups. */
+    *out = pair->view.qi++ ? (void *)&pair->view : (void *)&pair->iterable;
+    FIXME("map view QI %s -> %s\n", debugstr_guid(iid), pair->view.qi > 1 ? "view" : "iterable");
+    return S_OK;
+}
+const void *const pmap_view_vtbl[] = { pm_QI, o_AddRef, o_Release, o_GetIids, o_GetRuntimeClassName, o_GetTrustLevel,
+    pm_Lookup, pm_Size, pm_HasKey, pm_Split };
+const void *const pmap_iterable_vtbl[] = { pm_QI, o_AddRef, o_Release, o_GetIids, o_GetRuntimeClassName, o_GetTrustLevel, pm_First };
+
+static HRESULT pmap_create(UINT32 count, HSTRING *keys, void **vals, void **out)
+{
+    struct pmap_pair *pair = calloc(1, sizeof(*pair));
+    if (!pair) return E_OUTOFMEMORY;
+    pair->view.lpVtbl = pmap_view_vtbl; pair->view.count = count; pair->view.keys = keys; pair->view.vals = vals;
+    pair->iterable = pair->view;
+    pair->iterable.lpVtbl = pmap_iterable_vtbl;
+    pair->iterable.twin = &pair->view;
+    *out = &pair->view;
+    return S_OK;
+}
+
+/* ---------------- StoreProduct / StoreLicense ---------------- */
+static struct product *prod(void *o) { return (struct product *)o; }
+static HRESULT WINAPI pr_StoreId(void *o, HSTRING *v) { return str_out(prod(o)->store_id, v); }
+static HRESULT WINAPI pr_Language(void *o, HSTRING *v) { return str_out(L"en-US", v); }
+static HRESULT WINAPI pr_Title(void *o, HSTRING *v) { return str_out(prod(o)->name, v); }
+static HRESULT WINAPI pr_Description(void *o, HSTRING *v) { return str_out(L"", v); }
+static HRESULT WINAPI pr_ProductKind(void *o, HSTRING *v) { return str_out(prod(o)->kind[0] ? prod(o)->kind : L"Durable", v); }
+static HRESULT WINAPI pr_HasDigitalDownload(void *o, boolean *v) { *v = TRUE; return S_OK; }
+static HRESULT WINAPI pr_EmptyVec(void *o, void **v) { return empty_vec(v); }
+static HRESULT WINAPI pr_IsInUserCollection(void *o, boolean *v) { *v = TRUE; return S_OK; }
+static HRESULT WINAPI pr_Price(void *o, void **v) { FIXME("StoreProduct::Price -> NULL\n"); *v = NULL; return S_OK; }
+static HRESULT WINAPI pr_Json(void *o, HSTRING *v) { return str_out(L"{}", v); }
+static HRESULT WINAPI pr_LinkUri(void *o, void **v) { *v = NULL; return S_OK; }
+static HRESULT WINAPI pr_IsAnySkuAvailable(void *o, void **op) { return completed_int_operation(1, op); }
+STUB(product, 21) STUB(product, 22) STUB(product, 23)
+const void *const product_vtbl[] = { BASE, pr_StoreId, pr_Language, pr_Title, pr_Description, pr_ProductKind,
+    pr_HasDigitalDownload, pr_EmptyVec, pr_EmptyVec, pr_EmptyVec, pr_EmptyVec, pr_IsInUserCollection, pr_Price, pr_Json,
+    pr_LinkUri, pr_IsAnySkuAvailable, product_stub21, product_stub22, product_stub23 };
+
+/* StoreLicense: 6 SkuStoreId, 7 IsActive, 8 ExpirationDate, 9 ExtendedJsonData, 10 InAppOfferToken */
+static HRESULT WINAPI lic_SkuStoreId(void *o, HSTRING *v) { return str_out(prod(o)->store_id, v); }
+static HRESULT WINAPI lic_IsActive(void *o, boolean *v) { *v = TRUE; return S_OK; }
+static HRESULT WINAPI lic_Expiration(void *o, INT64 *v) { *v = 0x7fffffffffffffffLL; return S_OK; }
+static HRESULT WINAPI lic_Json(void *o, HSTRING *v) { return str_out(L"{}", v); }
+static HRESULT WINAPI lic_Token(void *o, HSTRING *v) { return str_out(prod(o)->product_id, v); }
+const void *const license_obj_vtbl[] = { BASE, lic_SkuStoreId, lic_IsActive, lic_Expiration, lic_Json, lic_Token };
+
+/* ---------------- StoreAppLicense ---------------- */
+static struct obj app_license_obj;
+static HRESULT WINAPI al_SkuStoreId(void *o, HSTRING *v) { store_init(); return str_out(app_store_id, v); }
+static HRESULT WINAPI al_True(void *o, boolean *v) { *v = TRUE; return S_OK; }
+static HRESULT WINAPI al_False(void *o, boolean *v) { *v = FALSE; return S_OK; }
+static HRESULT WINAPI al_Expiration(void *o, INT64 *v) { *v = 0x7fffffffffffffffLL; return S_OK; }
+static HRESULT WINAPI al_Json(void *o, HSTRING *v) { return str_out(L"{}", v); }
+static HRESULT WINAPI al_AddOns(void *o, void **v)
+{
+    UINT32 i;
+    HSTRING *keys;
+    void **vals;
+    store_init();
+    FIXME("StoreAppLicense::AddOnLicenses -> %u licences\n", product_count);
+    keys = calloc(product_count + 1, sizeof(*keys)); vals = calloc(product_count + 1, sizeof(*vals));
+    if (!keys || !vals) return E_OUTOFMEMORY;
+    for (i = 0; i < product_count; i++)
+    {
+        WindowsDuplicateString(products[i].h_store_id, &keys[i]);
+        products[i].lpVtbl = license_obj_vtbl; /* licences share the product slot: a product used as a licence */
+        vals[i] = &products[i];
+    }
+    /* NOTE: the same struct is exposed as StoreLicense; restore the product vtable afterwards on lookup is not needed
+     * because licence and product objects are created separately below. */
+    return pmap_create(product_count, keys, vals, v);
+}
+static HRESULT WINAPI al_TimeRemaining(void *o, INT64 *v) { *v = 0; return S_OK; }
+static HRESULT WINAPI al_TrialId(void *o, HSTRING *v) { return str_out(L"", v); }
+const void *const app_license_vtbl[] = { BASE, al_SkuStoreId, al_True, al_False, al_Expiration, al_Json, al_AddOns,
+    al_TimeRemaining, al_False, al_TrialId };
+
+/* ---------------- StoreProductQueryResult: 6 Products, 7 HasMoreResults, 8 ExtendedError, 9 GetMoreResultsAsync ---------------- */
+static struct obj query_result_obj;
+static HRESULT WINAPI qr_Products(void *o, void **v)
+{
+    UINT32 i;
+    HSTRING *keys;
+    void **vals;
+    store_init();
+    FIXME("StoreProductQueryResult::Products -> %u products\n", product_count);
+    keys = calloc(product_count + 1, sizeof(*keys)); vals = calloc(product_count + 1, sizeof(*vals));
+    if (!keys || !vals) return E_OUTOFMEMORY;
+    for (i = 0; i < product_count; i++)
+    {
+        struct product *copy = calloc(1, sizeof(*copy));
+        if (!copy) return E_OUTOFMEMORY;
+        *copy = products[i];
+        copy->lpVtbl = product_vtbl;
+        WindowsDuplicateString(products[i].h_store_id, &keys[i]);
+        vals[i] = copy;
+    }
+    return pmap_create(product_count, keys, vals, v);
+}
+static HRESULT WINAPI qr_False(void *o, boolean *v) { *v = FALSE; return S_OK; }
+static HRESULT WINAPI qr_Error(void *o, HRESULT *v) { *v = S_OK; return S_OK; }
+static HRESULT WINAPI qr_More(void *o, void **op) { return failed_operation(E_NOTIMPL, op); }
+static const void *const qr_vtbl[] = { BASE, qr_Products, qr_False, qr_Error, qr_More };
+
+/* StoreProductResult: 6 Product, 7 ExtendedError (GetStoreProductForCurrentAppAsync) */
+static struct product app_product;
+static struct obj product_result_obj;
+static HRESULT WINAPI pres_Product(void *o, void **v)
+{
+    store_init();
+    app_product.lpVtbl = product_vtbl;
+    wcscpy(app_product.store_id, app_store_id);
+    app_display_name(app_product.name, ARRAY_SIZE(app_product.name));
+    wcscpy(app_product.kind, L"Game");
+    *v = &app_product;
+    return S_OK;
+}
+static const void *const pres_vtbl[] = { BASE, pres_Product, qr_Error };
+
+/* ---------------- StoreContext ---------------- */
+static struct obj store_context_obj;
+static HRESULT WINAPI sc_User(void *o, void **v) { *v = offline_user(); return S_OK; }
+static HRESULT WINAPI sc_AddChanged(void *o, void *h, EventRegistrationToken *t) { t->value = 1; return S_OK; }
+static HRESULT WINAPI sc_RemoveChanged(void *o, EventRegistrationToken t) { return S_OK; }
+static HRESULT WINAPI sc_EmptyStringAsync(void *o, void *a, void *b, void **op)
