+static HRESULT WINAPI action_QueryInterface(IAsyncAction *iface, REFIID iid, void **out)
+{
+    struct core_action *impl = impl_from_action(iface);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IAsyncAction))
+        *out = &impl->IAsyncAction_iface;
+    else if (IsEqualGUID(iid, &IID_IAsyncInfo))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&impl->ref);
+    return S_OK;
+}
+static ULONG WINAPI action_AddRef(IAsyncAction *iface) { return InterlockedIncrement(&impl_from_action(iface)->ref); }
+static ULONG WINAPI action_Release(IAsyncAction *iface)
+{
+    struct core_action *impl = impl_from_action(iface);
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        if (impl->handler) IAsyncActionCompletedHandler_Release(impl->handler);
+        DeleteCriticalSection(&impl->cs);
+        free(impl);
+    }
+    return ref;
+}
+static HRESULT WINAPI action_GetIids(IAsyncAction *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI action_GetRuntimeClassName(IAsyncAction *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI action_GetTrustLevel(IAsyncAction *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI action_put_Completed(IAsyncAction *iface, IAsyncActionCompletedHandler *handler)
+{
+    struct core_action *impl = impl_from_action(iface);
+    BOOL done;
+
+    TRACE("iface %p, handler %p.\n", iface, handler);
+    EnterCriticalSection(&impl->cs);
+    if (impl->handler) { LeaveCriticalSection(&impl->cs); return E_ILLEGAL_DELEGATE_ASSIGNMENT; }
+    if (handler) { impl->handler = handler; IAsyncActionCompletedHandler_AddRef(handler); }
+    done = impl->status != Started;
+    LeaveCriticalSection(&impl->cs);
+    if (handler && done) IAsyncActionCompletedHandler_Invoke(handler, iface, Completed);
+    return S_OK;
+}
+static HRESULT WINAPI action_get_Completed(IAsyncAction *iface, IAsyncActionCompletedHandler **handler)
+{
+    struct core_action *impl = impl_from_action(iface);
+    if ((*handler = impl->handler)) IAsyncActionCompletedHandler_AddRef(*handler);
+    return S_OK;
+}
