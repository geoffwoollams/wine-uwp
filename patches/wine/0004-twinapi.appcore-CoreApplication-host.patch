+{ return di_add_event("static DisplayContentsInvalidated", t); }
+static HRESULT WINAPI st_remove_DisplayContentsInvalidated(IDisplayInformationStatics *iface, EventRegistrationToken t) { return S_OK; }
+
+static const struct IDisplayInformationStaticsVtbl st_vtbl =
+{
+    st_QueryInterface, st_AddRef, st_Release, st_GetIids, st_GetRuntimeClassName, st_GetTrustLevel,
