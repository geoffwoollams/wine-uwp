+static HRESULT WINAPI prov_get_IconUri(struct provider *p, void **v) { *v = NULL; return S_OK; }
+static const void *const prov_vtbl[] = { prov_QI, prov_AddRef, prov_Release, prov_GetIids, prov_GetRuntimeClassName,
+    prov_GetTrustLevel, prov_get_Id, prov_get_DisplayName, prov_get_IconUri };
+
+static HRESULT create_provider(HSTRING id, HSTRING name, void **out)
+{
+    struct provider *p;
+    if (!(p = calloc(1, sizeof(*p)))) return E_OUTOFMEMORY;
+    p->lpVtbl = prov_vtbl;
+    WindowsDuplicateString(id, &p->id);
+    WindowsDuplicateString(name, &p->name);
+    FIXME("WebAccountProvider id %s name %s\n", debugstr_hstring(id), debugstr_hstring(name));
+    *out = p;
+    return S_OK;
+}
