diff --git a/dlls/twinapi.appcore/extended_execution.c b/dlls/twinapi.appcore/extended_execution.c
new file mode 100644
index 0000000..0541470
--- /dev/null
+++ b/dlls/twinapi.appcore/extended_execution.c
@@ -0,0 +1,341 @@
+/* WinRT Windows.ApplicationModel.ExtendedExecution.ExtendedExecutionSession (prototype, hand-declared interfaces) */
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* IExtendedExecutionSession {af908a2d-118b-48f1-9308-0c4fc41e200f} (observed from the game's QI) */
+static const GUID IID_IExtendedExecutionSession =
+    { 0xaf908a2d, 0x118b, 0x48f1, { 0x93, 0x08, 0x0c, 0x4f, 0xc4, 0x1e, 0x20, 0x0f } };
+
+typedef struct IExtendedExecutionSession IExtendedExecutionSession;
+struct IExtendedExecutionSessionVtbl
+{
+    HRESULT (WINAPI *QueryInterface)(IExtendedExecutionSession *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(IExtendedExecutionSession *);
+    ULONG (WINAPI *Release)(IExtendedExecutionSession *);
+    HRESULT (WINAPI *GetIids)(IExtendedExecutionSession *, ULONG *, IID **);
+    HRESULT (WINAPI *GetRuntimeClassName)(IExtendedExecutionSession *, HSTRING *);
+    HRESULT (WINAPI *GetTrustLevel)(IExtendedExecutionSession *, TrustLevel *);
+    HRESULT (WINAPI *get_Reason)(IExtendedExecutionSession *, INT32 *);
+    HRESULT (WINAPI *put_Reason)(IExtendedExecutionSession *, INT32);
+    HRESULT (WINAPI *get_Description)(IExtendedExecutionSession *, HSTRING *);
+    HRESULT (WINAPI *put_Description)(IExtendedExecutionSession *, HSTRING);
+    HRESULT (WINAPI *get_PercentProgress)(IExtendedExecutionSession *, UINT32 *);
+    HRESULT (WINAPI *put_PercentProgress)(IExtendedExecutionSession *, UINT32);
+    HRESULT (WINAPI *add_Revoked)(IExtendedExecutionSession *, void *, EventRegistrationToken *);
+    HRESULT (WINAPI *remove_Revoked)(IExtendedExecutionSession *, EventRegistrationToken);
+    HRESULT (WINAPI *RequestExtensionAsync)(IExtendedExecutionSession *, void **);
+};
+struct IExtendedExecutionSession { const struct IExtendedExecutionSessionVtbl *lpVtbl; };
+
+struct session
+{
+    IExtendedExecutionSession IExtendedExecutionSession_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    INT32 reason;
+    HSTRING description;
+};
+
+static LONG ee_token_counter;
+
+static inline struct session *impl_from_session(IExtendedExecutionSession *iface)
+{ return CONTAINING_RECORD(iface, struct session, IExtendedExecutionSession_iface); }
+static inline struct session *impl_from_closable(IClosable *iface)
+{ return CONTAINING_RECORD(iface, struct session, IClosable_iface); }
+
+static HRESULT session_qi(struct session *impl, REFIID iid, void **out)
+{
+    TRACE("%p, %s, %p.\n", impl, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IExtendedExecutionSession))
+        *out = &impl->IExtendedExecutionSession_iface;
+    else if (IsEqualGUID(iid, &IID_IClosable))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement(&impl->ref);
+    return S_OK;
+}
+static ULONG session_release(struct session *impl)
+{
+    ULONG ref = InterlockedDecrement(&impl->ref);
+    if (!ref)
+    {
+        WindowsDeleteString(impl->description);
+        free(impl);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI s_QueryInterface(IExtendedExecutionSession *iface, REFIID iid, void **out)
+{ return session_qi(impl_from_session(iface), iid, out); }
+static ULONG WINAPI s_AddRef(IExtendedExecutionSession *iface) { return InterlockedIncrement(&impl_from_session(iface)->ref); }
+static ULONG WINAPI s_Release(IExtendedExecutionSession *iface) { return session_release(impl_from_session(iface)); }
+static HRESULT WINAPI s_GetIids(IExtendedExecutionSession *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI s_GetRuntimeClassName(IExtendedExecutionSession *iface, HSTRING *n)
+{ return WindowsCreateString(L"Windows.ApplicationModel.ExtendedExecution.ExtendedExecutionSession", 66, n); }
+static HRESULT WINAPI s_GetTrustLevel(IExtendedExecutionSession *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI s_get_Reason(IExtendedExecutionSession *iface, INT32 *v)
+{ *v = impl_from_session(iface)->reason; return S_OK; }
+static HRESULT WINAPI s_put_Reason(IExtendedExecutionSession *iface, INT32 v)
+{ TRACE("reason %d.\n", v); impl_from_session(iface)->reason = v; return S_OK; }
+static HRESULT WINAPI s_get_Description(IExtendedExecutionSession *iface, HSTRING *v)
+{ return WindowsDuplicateString(impl_from_session(iface)->description, v); }
+static HRESULT WINAPI s_put_Description(IExtendedExecutionSession *iface, HSTRING v)
+{
+    struct session *impl = impl_from_session(iface);
+    HSTRING copy;
+    HRESULT hr;
+    TRACE("description %s.\n", debugstr_hstring(v));
+    if (FAILED(hr = WindowsDuplicateString(v, &copy))) return hr;
+    WindowsDeleteString(impl->description);
+    impl->description = copy;
+    return S_OK;
+}
+static HRESULT WINAPI s_get_PercentProgress(IExtendedExecutionSession *iface, UINT32 *v) { *v = 0; return S_OK; }
+static HRESULT WINAPI s_put_PercentProgress(IExtendedExecutionSession *iface, UINT32 v) { return S_OK; }
+static HRESULT WINAPI s_add_Revoked(IExtendedExecutionSession *iface, void *h, EventRegistrationToken *t)
+{ TRACE("Revoked (event ignored).\n"); t->value = InterlockedIncrement(&ee_token_counter); return S_OK; }
+static HRESULT WINAPI s_remove_Revoked(IExtendedExecutionSession *iface, EventRegistrationToken t) { return S_OK; }
+
+/* ---- completed IAsyncOperation<ExtendedExecutionResult> ---- */
+typedef struct async_op async_op;
+struct async_op_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)(async_op *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(async_op *);
+    ULONG (WINAPI *Release)(async_op *);
+    HRESULT (WINAPI *GetIids)(async_op *, ULONG *, IID **);
+    HRESULT (WINAPI *GetRuntimeClassName)(async_op *, HSTRING *);
+    HRESULT (WINAPI *GetTrustLevel)(async_op *, TrustLevel *);
+    HRESULT (WINAPI *put_Completed)(async_op *, void *handler);
+    HRESULT (WINAPI *get_Completed)(async_op *, void **handler);
+    HRESULT (WINAPI *GetResults)(async_op *, INT32 *);
+};
+struct async_op
+{
+    const struct async_op_vtbl *lpVtbl;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IUnknown *handler;
+    INT32 result;
+    BOOL is_ptr;
+    void *ptr_result;
+    HRESULT error;
+};
+/* IAsyncOperationCompletedHandler<T>::Invoke(this, IAsyncOperation<T>*, AsyncStatus) is slot 3 */
+struct completed_handler_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)(void *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(void *);
+    ULONG (WINAPI *Release)(void *);
+    HRESULT (WINAPI *Invoke)(void *, async_op *, INT32);
+};
+
+static inline struct async_op *impl_from_asyncinfo(IAsyncInfo *iface)
+{ return CONTAINING_RECORD(iface, struct async_op, IAsyncInfo_iface); }
+
+static HRESULT WINAPI op_QueryInterface(async_op *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s.\n", iface, debugstr_guid(iid));
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject))
+        *out = iface;
+    else if (IsEqualGUID(iid, &IID_IAsyncInfo))
+        *out = &iface->IAsyncInfo_iface;
+    else
+    {
+        /* IAsyncOperation<ExtendedExecutionResult> itself: its pinterface IID is not computed here. */
+        FIXME("%s, assuming it is IAsyncOperation<ExtendedExecutionResult>.\n", debugstr_guid(iid));
+        *out = iface;
+    }
+    InterlockedIncrement(&iface->ref);
+    return S_OK;
+}
+static ULONG WINAPI op_AddRef(async_op *iface) { return InterlockedIncrement(&iface->ref); }
+static ULONG WINAPI op_Release(async_op *iface)
+{
+    ULONG ref = InterlockedDecrement(&iface->ref);
+    if (!ref)
+    {
+        if (iface->handler) IUnknown_Release(iface->handler);
+        /* NOTE: intentionally leaked: callers have been seen releasing more often than they add-ref. */
+        iface->ref = 1000000;
+    }
+    return ref;
+}
+static HRESULT WINAPI op_GetIids(async_op *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI op_GetRuntimeClassName(async_op *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI op_GetTrustLevel(async_op *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI op_put_Completed(async_op *iface, void *handler)
+{
+    TRACE("iface %p, handler %p.\n", iface, handler);
+    if (iface->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return S_OK;
+    iface->handler = handler;
+    IUnknown_AddRef(iface->handler);
+    ((struct completed_handler_vtbl *)*(void **)handler)->Invoke(handler, iface, iface->error ? 3 /* Error */ : 1 /* Completed */);
+    return S_OK;
+}
+static HRESULT WINAPI op_get_Completed(async_op *iface, void **handler)
+{
+    if ((*handler = iface->handler)) IUnknown_AddRef(iface->handler);
+    return S_OK;
+}
+static HRESULT WINAPI op_GetResults(async_op *iface, INT32 *result)
+{
+    TRACE("iface %p, result %p -> %d.\n", iface, result, iface->result);
+    if (iface->error) return iface->error;
+    if (iface->is_ptr) *(void **)result = iface->ptr_result; else *result = iface->result;
+    return S_OK;
+}
+static const struct async_op_vtbl op_vtbl =
+{
+    op_QueryInterface, op_AddRef, op_Release, op_GetIids, op_GetRuntimeClassName, op_GetTrustLevel,
+    op_put_Completed, op_get_Completed, op_GetResults,
+};
+
+static HRESULT WINAPI info_QueryInterface(IAsyncInfo *iface, REFIID iid, void **out)
+{ return op_QueryInterface(CONTAINING_RECORD(iface, async_op, IAsyncInfo_iface), iid, out); }
+static ULONG WINAPI info_AddRef(IAsyncInfo *iface)
+{ return op_AddRef(CONTAINING_RECORD(iface, async_op, IAsyncInfo_iface)); }
+static ULONG WINAPI info_Release(IAsyncInfo *iface)
+{ return op_Release(CONTAINING_RECORD(iface, async_op, IAsyncInfo_iface)); }
+static HRESULT WINAPI info_GetIids(IAsyncInfo *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI info_GetRuntimeClassName(IAsyncInfo *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI info_GetTrustLevel(IAsyncInfo *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI info_get_Id(IAsyncInfo *iface, UINT32 *id) { *id = 1; return S_OK; }
+static HRESULT WINAPI info_get_Status(IAsyncInfo *iface, AsyncStatus *s) { *s = impl_from_asyncinfo(iface)->error ? Error : Completed; return S_OK; }
+static HRESULT WINAPI info_get_ErrorCode(IAsyncInfo *iface, HRESULT *e) { *e = impl_from_asyncinfo(iface)->error; return S_OK; }
+static HRESULT WINAPI info_Cancel(IAsyncInfo *iface) { return S_OK; }
+static HRESULT WINAPI info_Close(IAsyncInfo *iface) { return S_OK; }
+static const IAsyncInfoVtbl info_vtbl =
+{
+    info_QueryInterface, info_AddRef, info_Release, info_GetIids, info_GetRuntimeClassName, info_GetTrustLevel,
+    info_get_Id, info_get_Status, info_get_ErrorCode, info_Cancel, info_Close,
+};
+
+static HRESULT WINAPI s_RequestExtensionAsync(IExtendedExecutionSession *iface, void **operation)
+{
+    async_op *op;
+
+    FIXME("iface %p, operation %p semi-stub!\n", iface, operation);
+    if (!(op = calloc(1, sizeof(*op)))) return E_OUTOFMEMORY;
+    op->lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 1;
+    FIXME("created op %p, op_vtbl %p, info_vtbl %p\n", op, &op_vtbl, &info_vtbl);
+    *operation = op;
+    return S_OK;
+}
+
+static const struct IExtendedExecutionSessionVtbl session_vtbl =
+{
+    s_QueryInterface, s_AddRef, s_Release, s_GetIids, s_GetRuntimeClassName, s_GetTrustLevel,
+    s_get_Reason, s_put_Reason, s_get_Description, s_put_Description,
+    s_get_PercentProgress, s_put_PercentProgress,
+    s_add_Revoked, s_remove_Revoked, s_RequestExtensionAsync,
+};
+
+static HRESULT WINAPI c_QueryInterface(IClosable *iface, REFIID iid, void **out)
+{ return session_qi(impl_from_closable(iface), iid, out); }
+static ULONG WINAPI c_AddRef(IClosable *iface) { return InterlockedIncrement(&impl_from_closable(iface)->ref); }
+static ULONG WINAPI c_Release(IClosable *iface) { return session_release(impl_from_closable(iface)); }
+static HRESULT WINAPI c_GetIids(IClosable *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI c_GetRuntimeClassName(IClosable *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI c_GetTrustLevel(IClosable *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI c_Close(IClosable *iface) { TRACE("iface %p.\n", iface); return S_OK; }
+static const IClosableVtbl closable_vtbl =
+{
+    c_QueryInterface, c_AddRef, c_Release, c_GetIids, c_GetRuntimeClassName, c_GetTrustLevel, c_Close,
+};
+
+/* ---- factory ---- */
+static HRESULT WINAPI ee_factory_QueryInterface(IActivationFactory *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI ee_factory_AddRef(IActivationFactory *iface) { return 2; }
+static ULONG WINAPI ee_factory_Release(IActivationFactory *iface) { return 1; }
+static HRESULT WINAPI ee_factory_GetIids(IActivationFactory *iface, ULONG *c, IID **i) { return E_NOTIMPL; }
+static HRESULT WINAPI ee_factory_GetRuntimeClassName(IActivationFactory *iface, HSTRING *n) { return E_NOTIMPL; }
+static HRESULT WINAPI ee_factory_GetTrustLevel(IActivationFactory *iface, TrustLevel *l) { *l = BaseTrust; return S_OK; }
+static HRESULT WINAPI ee_factory_ActivateInstance(IActivationFactory *iface, IInspectable **instance)
+{
+    struct session *impl;
+
+    TRACE("iface %p, instance %p.\n", iface, instance);
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IExtendedExecutionSession_iface.lpVtbl = &session_vtbl;
+    impl->IClosable_iface.lpVtbl = &closable_vtbl;
+    impl->ref = 1;
+    *instance = (IInspectable *)&impl->IExtendedExecutionSession_iface;
+    return S_OK;
+}
+
+static const IActivationFactoryVtbl ee_factory_vtbl =
+{
+    ee_factory_QueryInterface, ee_factory_AddRef, ee_factory_Release,
+    ee_factory_GetIids, ee_factory_GetRuntimeClassName, ee_factory_GetTrustLevel,
+    ee_factory_ActivateInstance,
+};
+
+static IActivationFactory ee_factory_obj = { &ee_factory_vtbl };
+IActivationFactory *extended_execution_factory = &ee_factory_obj;
+
+/* Shared helper: an already-completed IAsyncOperation<enum/int32> holding a fixed result. */
+HRESULT completed_int_operation( INT32 result, void **out )
+{
+    async_op *op;
+
+    if (!(op = calloc(1, sizeof(*op)))) return E_OUTOFMEMORY;
+    op->lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 1;
+    op->result = result;
+    *out = op;
+    return S_OK;
+}
+
+/* Completed IAsyncOperation<T*> whose result is a COM-style pointer (not AddRef'd here; objects are static). */
+HRESULT completed_ptr_operation( void *ptr, void **out )
+{
+    async_op *op;
+
+    if (!(op = calloc(1, sizeof(*op)))) return E_OUTOFMEMORY;
+    op->lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 1;
+    op->is_ptr = TRUE;
+    op->ptr_result = ptr;
+    *out = op;
+    return S_OK;
+}
+
+/* An already-failed IAsyncOperation: the completion handler sees status Error and GetResults returns hr. */
+HRESULT failed_operation( HRESULT hr, void **out )
+{
+    async_op *op;
+
+    if (!(op = calloc(1, sizeof(*op)))) return E_OUTOFMEMORY;
+    op->lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &info_vtbl;
+    op->ref = 1;
+    op->is_ptr = TRUE;
+    op->error = hr;
+    *out = op;
+    return S_OK;
+}
diff --git a/dlls/twinapi.appcore/hardware_identification.c b/dlls/twinapi.appcore/hardware_identification.c
new file mode 100644
index 0000000..1279bbe
--- /dev/null
+++ b/dlls/twinapi.appcore/hardware_identification.c
@@ -0,0 +1,111 @@
+/* WinRT Windows.System.Profile.HardwareIdentification (prototype: fixed, fake hardware token) */
+#include "private.h"
+#define WIDL_using_Windows_Storage_Streams
+#include "roapi.h"
+#include "robuffer.h"
+#include "windows.storage.streams.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+struct hw_obj { const void *const *lpVtbl; const char *name; };
+
+static const GUID IID_IBufferByteAccess_local =
+    { 0x905a0fef, 0xbc53, 0x11df, { 0x8c, 0x49, 0x00, 0x1e, 0x4f, 0xc6, 0x86, 0xda } };
+
+static HRESULT make_buffer(UINT32 length, void **out, const BYTE *data)
+{
+    static const WCHAR classname[] = L"Windows.Storage.Streams.Buffer";
+    __x_ABI_CWindows_CStorage_CStreams_CIBufferFactory *factory;
+    HSTRING str;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( classname, ARRAY_SIZE(classname) - 1, &str ))) return hr;
+    hr = RoGetActivationFactory( str, &IID___x_ABI_CWindows_CStorage_CStreams_CIBufferFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) { FIXME( "Buffer factory unavailable, hr %#lx.\n", hr ); return hr; }
+    hr = __x_ABI_CWindows_CStorage_CStreams_CIBufferFactory_Create( factory, length, (__x_ABI_CWindows_CStorage_CStreams_CIBuffer **)out );
+    if (SUCCEEDED(hr))
+    {
+        __x_ABI_CWindows_CStorage_CStreams_CIBuffer *buffer = *(__x_ABI_CWindows_CStorage_CStreams_CIBuffer **)out;
+        IBufferByteAccess *access;
+
+        __x_ABI_CWindows_CStorage_CStreams_CIBuffer_put_Length( buffer, length );
+        if (data && SUCCEEDED(__x_ABI_CWindows_CStorage_CStreams_CIBuffer_QueryInterface( buffer, &IID_IBufferByteAccess_local, (void **)&access )))
+        {
+            BYTE *bytes;
+            if (SUCCEEDED(IBufferByteAccess_Buffer( access, &bytes ))) memcpy( bytes, data, length );
+            IBufferByteAccess_Release( access );
+        }
+    }
+    __x_ABI_CWindows_CStorage_CStreams_CIBufferFactory_Release( factory );
+    return hr;
+}
+
+/* Id buffer: one entry {type=1 (processor), length=4, 4 bytes}. */
+static const BYTE id_data[] = { 0x01, 0x00, 0x04, 0x00, 0xde, 0xad, 0xbe, 0xef };
+
+/* ---- IHardwareToken (probed): slot 6 Id, 7 Signature, 8 Certificate, all IBuffer getters ---- */
+static HRESULT WINAPI token_slot6(struct hw_obj *iface, void **value) { FIXME( "token get_Id\n" ); return make_buffer( sizeof(id_data), value, id_data ); }
+static HRESULT WINAPI token_slot7(struct hw_obj *iface, void **value) { FIXME( "token get_Signature\n" ); return make_buffer( 32, value, NULL ); }
+static HRESULT WINAPI token_slot8(struct hw_obj *iface, void **value) { FIXME( "token get_Certificate\n" ); return make_buffer( 8, value, NULL ); }
+
+static HRESULT WINAPI hw_QueryInterface(struct hw_obj *iface, REFIID iid, void **out)
+{
+    TRACE( "iface %p (%s), iid %s.\n", iface, iface->name, debugstr_guid( iid ) );
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    FIXME( "%s: assuming %s is the main interface.\n", iface->name, debugstr_guid( iid ) );
+    *out = iface;
+    return S_OK;
+}
+static ULONG WINAPI hw_AddRef(struct hw_obj *iface) { return 2; }
