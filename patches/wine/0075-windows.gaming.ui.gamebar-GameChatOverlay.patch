@@ -0,0 +1,213 @@
+/* WinRT Windows.Gaming.UI.GameChatOverlay
+ *
+ * There is no Game Bar to draw chat in, so messages are only logged; the desired position is
+ * kept.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(gamebar);
+
+struct chat_overlay
+{
+    IActivationFactory IActivationFactory_iface;
+    IGameChatOverlayStatics IGameChatOverlayStatics_iface;
+    IGameChatOverlay IGameChatOverlay_iface;
+    LONG ref;
+    GameChatOverlayPosition position;
+};
+
+static inline struct chat_overlay *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct chat_overlay, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct chat_overlay *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IGameChatOverlayStatics ))
+        *out = &impl->IGameChatOverlayStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance ) { return E_NOTIMPL; }
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IGameChatOverlayStatics, struct chat_overlay, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_GetDefault( IGameChatOverlayStatics *iface, IGameChatOverlay **value )
+{
+    struct chat_overlay *impl = impl_from_IGameChatOverlayStatics( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = &impl->IGameChatOverlay_iface;
+    IGameChatOverlay_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IGameChatOverlayStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* IGameChatOverlayStatics methods */
+    statics_GetDefault,
+};
+
+/* the overlay itself: one per process, kept in the same object */
+
+static inline struct chat_overlay *impl_from_IGameChatOverlay( IGameChatOverlay *iface )
+{
+    return CONTAINING_RECORD( iface, struct chat_overlay, IGameChatOverlay_iface );
+}
+
+static HRESULT WINAPI overlay_QueryInterface( IGameChatOverlay *iface, REFIID iid, void **out )
+{
+    struct chat_overlay *impl = impl_from_IGameChatOverlay( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IGameChatOverlay ))
+    {
+        *out = &impl->IGameChatOverlay_iface;
+        IInspectable_AddRef( (IInspectable *)*out );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI overlay_AddRef( IGameChatOverlay *iface )
+{
+    return InterlockedIncrement( &impl_from_IGameChatOverlay( iface )->ref );
+}
+
+static ULONG WINAPI overlay_Release( IGameChatOverlay *iface )
+{
+    return InterlockedDecrement( &impl_from_IGameChatOverlay( iface )->ref );
+}
+
+static HRESULT WINAPI overlay_GetIids( IGameChatOverlay *iface, ULONG *iid_count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI overlay_GetRuntimeClassName( IGameChatOverlay *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( L"Windows.Gaming.UI.GameChatOverlay", 33, class_name );
+}
+static HRESULT WINAPI overlay_GetTrustLevel( IGameChatOverlay *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI overlay_get_DesiredPosition( IGameChatOverlay *iface, GameChatOverlayPosition *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl_from_IGameChatOverlay( iface )->position;
+    return S_OK;
+}
+
+static HRESULT WINAPI overlay_put_DesiredPosition( IGameChatOverlay *iface, GameChatOverlayPosition value )
+{
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl_from_IGameChatOverlay( iface )->position = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI overlay_AddMessage( IGameChatOverlay *iface, HSTRING sender, HSTRING message, GameChatMessageOrigin origin )
+{
+    FIXME( "iface %p, sender %s, message %s, origin %d: not shown.\n", iface, debugstr_hstring(sender),
+           debugstr_hstring(message), origin );
+    return S_OK;
+}
+
+static const struct IGameChatOverlayVtbl overlay_vtbl =
+{
+    overlay_QueryInterface,
+    overlay_AddRef,
+    overlay_Release,
+    /* IInspectable methods */
+    overlay_GetIids,
+    overlay_GetRuntimeClassName,
+    overlay_GetTrustLevel,
+    /* IGameChatOverlay methods */
+    overlay_get_DesiredPosition,
+    overlay_put_DesiredPosition,
+    overlay_AddMessage,
+};
+
+static struct chat_overlay chat_overlay =
+{
+    {&factory_vtbl},
+    {&statics_vtbl},
+    {&overlay_vtbl},
+    1,
+    GameChatOverlayPosition_BottomCenter,
+};
+
+IActivationFactory *chat_overlay_factory = &chat_overlay.IActivationFactory_iface;
