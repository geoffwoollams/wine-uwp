diff --git a/dlls/twinapi.appcore/user_statics.c b/dlls/twinapi.appcore/user_statics.c
index 4ee4674..340c193 100644
--- a/dlls/twinapi.appcore/user_statics.c
+++ b/dlls/twinapi.appcore/user_statics.c
@@ -51,34 +51,43 @@ static HRESULT WINAPI vv_First(struct uvec *v, void **iter)
     *iter = it;
     return S_OK;
 }
-/* One object serves both IVectorView (slots 6-9) and IIterable (slot 6 'First'): decide at QI time is not possible without
- * the IIDs, so IIterable::First is also exposed as slot 6 of a second vtable returned for the 2nd distinct IID asked. */
+/* IVectorView<T> (slots 6-9) and IIterable<T> (slot 6 First) of one or no item, on two vtables of one object. Only the
+ * two pinterface IIDs given at creation are answered: IL2CPP probes objects for unrelated interfaces, and a vtable
+ * handed out for one of those is called with the wrong methods. */
 static HRESULT WINAPI vv_QI(void *i, REFIID iid, void **out);
 static const void *const vview_vtbl[] = { vv_QI, vi_AddRef, vi_Release, vi_GetIids, vi_GetRuntimeClassName, vi_GetTrustLevel,
     vv_GetAt, vv_get_Size, vv_IndexOf, vv_GetMany };
 static const void *const viter_vtbl[] = { vv_QI, vi_AddRef, vi_Release, vi_GetIids, vi_GetRuntimeClassName, vi_GetTrustLevel,
     vv_First };
-struct svec { struct uvec view; struct uvec iterable; int qi_count; };
+struct svec { struct uvec view; struct uvec iterable; const GUID *view_iid, *iterable_iid; };
 static HRESULT WINAPI vv_QI(void *i, REFIID iid, void **out)
 {
+    struct uvec *u = i;
+    struct svec *sv = u->lpVtbl == viter_vtbl ? CONTAINING_RECORD(u, struct svec, iterable)
+                                              : CONTAINING_RECORD(u, struct svec, view);
+
     if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) || IsEqualGUID(iid, &IID_IAgileObject))
-    { *out = i; return S_OK; }
+        *out = i;
+    else if (IsEqualGUID(iid, sv->view_iid)) *out = &sv->view;
+    else if (IsEqualGUID(iid, sv->iterable_iid)) *out = &sv->iterable;
+    else
     {
-        struct uvec *u = i;
-        struct svec *sv = CONTAINING_RECORD(u->lpVtbl == viter_vtbl ? u : u, struct svec, view);
-        if (u->lpVtbl == viter_vtbl) sv = CONTAINING_RECORD(u, struct svec, iterable);
-        FIXME("single-item vector QI %s (#%d)\n", debugstr_guid(iid), sv->qi_count);
-        *out = sv->qi_count++ ? (void *)&sv->iterable : (void *)&sv->view;
-        return S_OK;
+        TRACE("single-item vector: %s not supported.\n", debugstr_guid(iid));
+        *out = NULL;
+        return E_NOINTERFACE;
     }
+    return S_OK;
 }
 
-HRESULT single_vector_create( void *item, void **out )
+/* item may be NULL for an empty vector; view_iid and iterable_iid are IVectorView<T> and IIterable<T> */
+HRESULT single_vector_create( void *item, const GUID *view_iid, const GUID *iterable_iid, void **out )
 {
     struct svec *sv = calloc(1, sizeof(*sv));
     if (!sv) return E_OUTOFMEMORY;
     sv->view.lpVtbl = vview_vtbl; sv->view.item = item;
     sv->iterable.lpVtbl = viter_vtbl; sv->iterable.item = item;
+    sv->view_iid = view_iid;
+    sv->iterable_iid = iterable_iid;
     *out = &sv->view;
     return S_OK;
 }
@@ -87,7 +96,10 @@ HRESULT single_vector_create( void *item, void **out )
 static HRESULT user_list_op(void **op)
 {
     void *v;
-    HRESULT hr = single_vector_create(offline_user(), &v);
+    /* IVectorView<User> and IIterable<User> */
+    static const GUID view = {0x8cbd762a,0x1222,0x5ee5,{0xb7,0x45,0x48,0x9e,0x7a,0x42,0xc6,0xec}};
+    static const GUID iterable = {0xd1bacd1f,0x0376,0x5823,{0x8c,0x29,0x1d,0x45,0xb9,0xf4,0xc1,0x91}};
+    HRESULT hr = single_vector_create(offline_user(), &view, &iterable, &v);
     if (FAILED(hr)) return hr;
     return completed_ptr_operation(v, op);
 }
