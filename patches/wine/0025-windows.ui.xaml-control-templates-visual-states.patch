+ */
+
+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A ContentPresenter shows content in a control template: a UIElement, or anything else as text. Background, border
+ * and padding (IContentPresenter4 on Windows) are set from markup through presenter_set_*. */
+
+struct presenter
+{
+    struct xaml_element element;
+    IContentPresenter IContentPresenter_iface;
+    IInspectable *content;
+    struct xaml_element *child;
+    HSTRING text;
+    IBrush *background, *border_brush, *foreground;
+    Thickness border_thickness, padding;
+    double font_size;
+    HorizontalAlignment content_horizontal;
+    VerticalAlignment content_vertical;
+};
+
+static const struct element_ops presenter_ops;
+
+static inline struct presenter *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct presenter, element );
+}
+
+static struct presenter *presenter_from_object( IInspectable *object )
+{
+    struct xaml_element *element = element_from_object( object );
+    return element && element->ops == &presenter_ops ? impl_from_element( element ) : NULL;
+}
+
+static HRESULT presenter_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct presenter *impl = impl_from_element( element );
+
+    if (!IsEqualGUID( iid, &IID_IContentPresenter )) return E_NOINTERFACE;
+    *out = &impl->IContentPresenter_iface;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void inner_rect( struct presenter *impl, struct layout_rect *rect )
+{
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    const struct layout_rect *r = &impl->element.bounds;
+
+    rect->x = r->x + b->Left + p->Left;
+    rect->y = r->y + b->Top + p->Top;
+    rect->width = max( 0.0f, r->width - b->Left - b->Right - p->Left - p->Right );
+    rect->height = max( 0.0f, r->height - b->Top - b->Bottom - p->Top - p->Bottom );
+}
+
+static void text_format( struct presenter *impl, struct text_format *format )
+{
+    format->font_size = impl->font_size;
+    format->weight = FW_NORMAL;
+    format->italic = FALSE;
+    format->wrap = FALSE;
+    format->alignment = TextAlignment_Left;
+}
+
+static void presenter_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                               float avail_height, float *width, float *height )
+{
+    struct presenter *impl = impl_from_element( element );
+    const Thickness *b = &impl->border_thickness, *p = &impl->padding;
+    float extra_width = b->Left + b->Right + p->Left + p->Right, extra_height = b->Top + b->Bottom + p->Top + p->Bottom;
+    struct text_format format;
+
+    *width = *height = 0;
+    if (impl->child)
+    {
+        element_measure( impl->child, ctx, max( 0.0f, avail_width - extra_width ), max( 0.0f, avail_height - extra_height ) );
+        *width = impl->child->desired_width;
+        *height = impl->child->desired_height;
+    }
+    else if (impl->text)
+    {
+        text_format( impl, &format );
+        text_measure( ctx, &format, impl->text, INFINITY, width, height );
+    }
+    *width += extra_width;
+    *height += extra_height;
+}
+
+/* place content of size w x h in the inner rect by the content alignment */
+static void align( struct presenter *impl, const struct layout_rect *inner, float w, float h, struct layout_rect *out )
+{
+    out->width = impl->content_horizontal == HorizontalAlignment_Stretch ? inner->width : min( w, inner->width );
+    out->height = impl->content_vertical == VerticalAlignment_Stretch ? inner->height : min( h, inner->height );
+    switch (impl->content_horizontal)
+    {
+    case HorizontalAlignment_Left: out->x = inner->x; break;
+    case HorizontalAlignment_Right: out->x = inner->x + inner->width - out->width; break;
+    default: out->x = inner->x + (inner->width - out->width) / 2; break;
+    }
+    switch (impl->content_vertical)
+    {
+    case VerticalAlignment_Top: out->y = inner->y; break;
+    case VerticalAlignment_Bottom: out->y = inner->y + inner->height - out->height; break;
+    default: out->y = inner->y + (inner->height - out->height) / 2; break;
+    }
+}
+
+static void presenter_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct presenter *impl = impl_from_element( element );
+    struct layout_rect inner, rect;
+
+    if (!impl->child) return;
+    inner_rect( impl, &inner );
+    align( impl, &inner, impl->child->desired_width, impl->child->desired_height, &rect );
+    element_arrange( impl->child, ctx, rect.x, rect.y, rect.width, rect.height );
+}
+
+static void presenter_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct presenter *impl = impl_from_element( element );
+    COLORREF saved = ctx->foreground, color = ctx->foreground;
+    struct layout_rect inner, rect;
+    struct text_format format;
+    float w, h;
+    Color c;
+
+    element_fill( ctx, &element->bounds, impl->background );
+    element_frame( ctx, &element->bounds, &impl->border_thickness, impl->border_brush );
+    if (impl->foreground && brush_get_color( impl->foreground, &c )) color = RGB( c.R, c.G, c.B );
+    if (impl->child)
+    {
+        ctx->foreground = color;
+        element_render( impl->child, ctx );
+        ctx->foreground = saved;
+    }
+    else if (impl->text)
+    {
+        inner_rect( impl, &inner );
+        text_format( impl, &format );
+        text_measure( ctx, &format, impl->text, INFINITY, &w, &h );
+        align( impl, &inner, w, h, &rect );
+        text_draw( ctx, &format, impl->text, &rect, color );
+    }
+}
+
+static UINT32 presenter_child_count( struct xaml_element *element )
+{
+    return impl_from_element( element )->child ? 1 : 0;
+}
+
+static struct xaml_element *presenter_child_at( struct xaml_element *element, UINT32 index )
+{
+    return impl_from_element( element )->child;
+}
+
+static BOOL presenter_hit_self( struct xaml_element *element, float x, float y )
+{
+    return impl_from_element( element )->background != NULL || impl_from_element( element )->text != NULL;
+}
+
+static void presenter_set_content( struct presenter *impl, IInspectable *value )
+{
+    struct xaml_element *child = value ? element_from_object( value ) : NULL;
+
+    if (impl->child && impl->child->parent == &impl->element) element_set_parent( impl->child, NULL );
+    if (value) IInspectable_AddRef( value );
+    if (impl->content) IInspectable_Release( impl->content );
+    impl->content = value;
+    impl->child = NULL;
+    WindowsDeleteString( impl->text );
+    impl->text = NULL;
+    if (child)
+    {
+        /* a templated control's own UIElement content is shown by its template's presenter */
+        impl->child = child;
+        element_set_parent( child, &impl->element );
+    }
+    else if (value) impl->text = object_to_text( value );
+    window_invalidate();
+}
+
+static void presenter_destroy( struct xaml_element *element )
+{
+    struct presenter *impl = impl_from_element( element );
+
+    presenter_set_content( impl, NULL );
+    if (impl->background) IBrush_Release( impl->background );
+    if (impl->border_brush) IBrush_Release( impl->border_brush );
+    if (impl->foreground) IBrush_Release( impl->foreground );
+    free( impl );
+}
+
+static const struct element_ops presenter_ops =
+{
+    .query_interface = presenter_query_interface,
+    .measure = presenter_measure,
+    .arrange = presenter_arrange,
+    .render = presenter_render,
+    .child_count = presenter_child_count,
+    .child_at = presenter_child_at,
+    .hit_self = presenter_hit_self,
+    .destroy = presenter_destroy,
+};
+
+static void set_brush( IBrush **slot, IBrush *value )
+{
+    if (value) IBrush_AddRef( value );
+    if (*slot) IBrush_Release( *slot );
+    *slot = value;
+    window_invalidate();
+}
+
+BOOL presenter_set_brush( IInspectable *object, const WCHAR *property, IBrush *brush )
+{
+    struct presenter *impl = presenter_from_object( object );
+
+    if (!impl) return FALSE;
+    if (!wcscmp( property, L"Background" )) set_brush( &impl->background, brush );
+    else if (!wcscmp( property, L"BorderBrush" )) set_brush( &impl->border_brush, brush );
+    else if (!wcscmp( property, L"Foreground" )) set_brush( &impl->foreground, brush );
+    else return FALSE;
+    return TRUE;
+}
+
+BOOL presenter_get_brush( IInspectable *object, const WCHAR *property, IBrush **brush )
+{
+    struct presenter *impl = presenter_from_object( object );
+    IBrush *value;
+
+    if (!impl) return FALSE;
+    if (!wcscmp( property, L"Background" )) value = impl->background;
+    else if (!wcscmp( property, L"BorderBrush" )) value = impl->border_brush;
+    else if (!wcscmp( property, L"Foreground" )) value = impl->foreground;
+    else return FALSE;
+    if ((*brush = value)) IBrush_AddRef( value );
+    return TRUE;
+}
+
+BOOL presenter_set_thickness( IInspectable *object, const WCHAR *property, Thickness value )
+{
+    struct presenter *impl = presenter_from_object( object );
+
+    if (!impl) return FALSE;
+    if (!wcscmp( property, L"Padding" )) impl->padding = value;
+    else if (!wcscmp( property, L"BorderThickness" )) impl->border_thickness = value;
+    else return FALSE;
+    window_invalidate();
+    return TRUE;
+}
+
+BOOL presenter_set_alignment( IInspectable *object, const WCHAR *property, INT32 value )
+{
+    struct presenter *impl = presenter_from_object( object );
+
+    if (!impl) return FALSE;
+    if (!wcscmp( property, L"HorizontalContentAlignment" )) impl->content_horizontal = value;
+    else if (!wcscmp( property, L"VerticalContentAlignment" )) impl->content_vertical = value;
+    else return FALSE;
+    window_invalidate();
+    return TRUE;
+}
+
+/* IContentPresenter */
+
+DEFINE_IINSPECTABLE_( content_presenter, IContentPresenter, struct presenter, impl_from_IContentPresenter,
+                      IContentPresenter_iface, impl->element.outer )
+
+static HRESULT WINAPI content_presenter_get_Content( IContentPresenter *iface, IInspectable **value )
+{
+    if ((*value = impl_from_IContentPresenter( iface )->content)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI content_presenter_put_Content( IContentPresenter *iface, IInspectable *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    presenter_set_content( impl_from_IContentPresenter( iface ), value );
+    return S_OK;
+}
+
+static HRESULT WINAPI content_presenter_get_FontSize( IContentPresenter *iface, DOUBLE *value )
+{
+    *value = impl_from_IContentPresenter( iface )->font_size;
+    return S_OK;
+}
+
+static HRESULT WINAPI content_presenter_put_FontSize( IContentPresenter *iface, DOUBLE value )
+{
+    impl_from_IContentPresenter( iface )->font_size = value;
+    window_invalidate();
+    return S_OK;
+}
+
+static HRESULT WINAPI content_presenter_get_Foreground( IContentPresenter *iface, IBrush **value )
+{
+    if ((*value = impl_from_IContentPresenter( iface )->foreground)) IBrush_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI content_presenter_put_Foreground( IContentPresenter *iface, IBrush *value )
+{
+    set_brush( &impl_from_IContentPresenter( iface )->foreground, value );
+    return S_OK;
+}
