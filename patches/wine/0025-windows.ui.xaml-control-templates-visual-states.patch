+static struct bag *bag_from_object( IInspectable *object )
+{
+    return object && object->lpVtbl == &bag_vtbl ? CONTAINING_RECORD( object, struct bag, IInspectable_iface ) : NULL;
+}
+
+static HRESULT WINAPI bag_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+    {
+        *out = iface;
+        IInspectable_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI bag_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &bag_from_object( iface )->ref );
+}
+
+static ULONG WINAPI bag_Release( IInspectable *iface )
+{
+    struct bag *impl = bag_from_object( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->prop_count; i++) xvalue_clear( &impl->props[i].value );
+        for (i = 0; i < impl->item_count; i++) IInspectable_Release( impl->items[i] );
+        free( impl->props );
+        free( impl->items );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI bag_GetIids( IInspectable *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI bag_GetRuntimeClassName( IInspectable *iface, HSTRING *name )
+{
+    WCHAR full[96];
+    swprintf( full, ARRAY_SIZE(full), L"Windows.UI.Xaml.%s", bag_from_object( iface )->type );
+    return WindowsCreateString( full, wcslen( full ), name );
