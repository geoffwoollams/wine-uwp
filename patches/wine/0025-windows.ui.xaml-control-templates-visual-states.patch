+/* the control template, if the button has one: instantiated on first layout, like WinUI's ApplyTemplate */
+static struct xaml_element *button_template_root( struct button *impl )
+{
+    struct xaml_element *root;
+
+    if (!impl->element.template) return NULL;
+    if (!impl->element.template_instance)
+    {
+        if (!(impl->element.template_instance = template_instantiate( impl->element.template, impl->element.outer )))
+            return NULL;
+        if ((root = template_root( impl->element.template_instance ))) element_set_parent( root, &impl->element );
+        template_go_to_state( impl->element.template_instance, impl->enabled ? L"Normal" : L"Disabled" );
+    }
+    return template_root( impl->element.template_instance );
+}
+
+static void button_update_state( struct button *impl )
+{
+    const WCHAR *state;
+
+    if (!impl->element.template_instance) return;
+    if (!impl->enabled) state = L"Disabled";
+    else if (impl->pressed) state = L"Pressed";
+    else if (impl->pointer_over) state = L"PointerOver";
+    else state = L"Normal";
+    template_go_to_state( impl->element.template_instance, state );
+}
