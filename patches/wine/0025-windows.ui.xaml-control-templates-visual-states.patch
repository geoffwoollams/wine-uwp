+        else
+        {
+            if (name[0] == 'W') IFrameworkElement_get_Width( fe, &d ); else IFrameworkElement_get_Height( fe, &d );
+            out->kind = isnan( d ) ? XV_STRING : XV_FLOAT;
+            if (isnan( d )) out->s = wcsdup( L"Auto" ); else out->f = d;
+        }
+        IFrameworkElement_Release( fe );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"Text" ) && QI( target, ITextBlock, &tb ))
+    {
+        ITextBlock_get_Text( tb, &str );
+        out->kind = XV_STRING;
+        out->s = wcsdup( WindowsGetStringRawBuffer( str, NULL ) );
+        WindowsDeleteString( str );
+        ITextBlock_Release( tb );
+        return TRUE;
+    }
+    if (!wcscmp( name, L"IsEnabled" ) && QI( target, IControl, &control ))
+    {
+        boolean b;
+        IControl_get_IsEnabled( control, &b );
+        IControl_Release( control );
+        out->kind = XV_BOOL;
+        out->b = b;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* ---- template instances and VisualStateManager ---- */
+
+struct applied_value
+{
+    IInspectable *group;      /* the visual state group that changed it */
+    IInspectable *target;
+    struct xprop prop;
+    struct xvalue old;
+};
+
+struct template_instance
+{
+    IInspectable *root;
+    struct name_entry *names;
+    UINT32 name_count;
+    struct applied_value *applied;
+    UINT32 applied_count;
+};
+
+struct template_instance *template_instantiate( IInspectable *template, IInspectable *templated_parent )
+{
+    struct control_template *impl = template_from_object( template );
+    struct template_instance *instance;
+    struct writer *w;
+    struct xvalue value;
+
+    if (!impl || !impl->xbf) return NULL;
+    if (!(instance = calloc( 1, sizeof(*instance) ))) return NULL;
+    if (!(w = calloc( 1, sizeof(*w) )))
+    {
+        free( instance );
+        return NULL;
+    }
+    TRACE( "instantiating the %s template for %p.\n", debugstr_w(impl->target), templated_parent );
+    w->xbf = impl->xbf;
+    w->root_used = TRUE;
+    w->templated_parent = templated_parent;
+    w->names_owner = w;
+    run_stream( w, impl->stream, 0, RUN_OBJECT );
+    if (w->sp)
+    {
+        pop( w, &value );
+        if (value.kind == XV_OBJECT && element_from_object( value.object ))
+        {
+            instance->root = value.object;
+            value.object = NULL;
+        }
+        xvalue_clear( &value );
+    }
+    while (w->sp) { pop( w, &value ); xvalue_clear( &value ); }
+    instance->names = w->names;
+    instance->name_count = w->name_count;
+    free( w );
+    if (!instance->root)
+    {
+        WARN( "the template produced no element.\n" );
+        template_free( instance );
+        return NULL;
+    }
+    return instance;
+}
+
+struct xaml_element *template_root( struct template_instance *instance )
+{
+    return instance ? element_from_object( instance->root ) : NULL;
+}
+
+void template_free( struct template_instance *instance )
+{
+    UINT32 i;
+
+    if (!instance) return;
+    for (i = 0; i < instance->applied_count; i++)
+    {
+        IInspectable_Release( instance->applied[i].target );
+        xvalue_clear( &instance->applied[i].old );
+    }
+    for (i = 0; i < instance->name_count; i++) IInspectable_Release( instance->names[i].object );
+    if (instance->root) IInspectable_Release( instance->root );
+    free( instance->applied );
+    free( instance->names );
+    free( instance );
+}
+
+static IInspectable *find_name( struct template_instance *instance, const WCHAR *name )
+{
+    UINT32 i;
+    for (i = 0; i < instance->name_count; i++) if (!wcscmp( instance->names[i].name, name )) return instance->names[i].object;
+    return NULL;
+}
+
+static struct bag *bag_value( struct bag *bag, const WCHAR *name )
+{
+    struct xvalue *v = bag_get( bag, name );
+    return v && v->kind == XV_OBJECT ? bag_from_object( v->object ) : NULL;
+}
+
+static const WCHAR *bag_string( struct bag *bag, const WCHAR *name )
+{
+    struct xvalue *v = bag_get( bag, name );
+    return v && v->kind == XV_STRING ? v->s : NULL;
+}
+
+/* set target.property for a state, remembering the old value to restore when the group leaves the state */
+static void state_set( struct template_instance *instance, IInspectable *group, IInspectable *target,
+                       const WCHAR *property, struct xvalue *value )
+{
+    struct applied_value *applied;
+    struct xprop prop = {0};
+
+    lstrcpynW( prop.name, property, ARRAY_SIZE(prop.name) );
+    if ((applied = realloc( instance->applied, (instance->applied_count + 1) * sizeof(*applied) )))
+    {
+        instance->applied = applied;
+        applied += instance->applied_count;
+        if (get_value( target, property, &applied->old ))
+        {
+            applied->group = group;
+            applied->target = target;
+            IInspectable_AddRef( target );
+            applied->prop = prop;
+            instance->applied_count++;
+        }
+        else FIXME( "can't read %s back; leaving the state won't restore it.\n", debugstr_w(property) );
+    }
+    set_property( NULL, target, &prop, value, SET_STATE );
+}
+
+/* "Opacity", "(UIElement.Opacity)", "(Border.Background).(SolidColorBrush.Color)" -> the target's property, and
+ * whether the value is the color of a brush in it */
+static BOOL parse_property_path( const WCHAR *path, WCHAR *property, SIZE_T len, BOOL *brush_color )
+{
+    const WCHAR *p = path, *end, *dot;
+
+    *brush_color = FALSE;
+    if (wcschr( path, '[' )) return FALSE;
+    if (*p == '(')
+    {
+        if (!(end = wcschr( p, ')' ))) return FALSE;
+        dot = wcschr( p, '.' );
+        if (!dot || dot > end) return FALSE;
+        lstrcpynW( property, dot + 1, min( len, end - dot ) );
+        if (end[1] == '.')
+        {
+            if (wcscmp( end + 2, L"(SolidColorBrush.Color)" )) return FALSE;
+            *brush_color = TRUE;
+        }
+        return TRUE;
+    }
+    if (wcschr( p, '.' )) return FALSE;
+    lstrcpynW( property, p, len );
+    return TRUE;
+}
+
+static void apply_animation( struct template_instance *instance, IInspectable *group, struct bag *anim )
+{
+    const WCHAR *target_name = bag_string( anim, L"TargetName" ), *path = bag_string( anim, L"TargetProperty" );
+    struct xvalue *to = bag_get( anim, L"To" ), value;
+    struct bag *frames;
+    WCHAR property[96];
+    IInspectable *target;
+    BOOL brush_color;
+
+    if (!target_name || !path || !(target = find_name( instance, target_name ))) return;
+    if (!parse_property_path( path, property, ARRAY_SIZE(property), &brush_color ))
+    {
+        FIXME( "animating %s.%s is not supported.\n", debugstr_w(target_name), debugstr_w(path) );
+        return;
+    }
+    /* key frame animations: the last frame's value */
+    if (!to && (frames = bag_value( anim, L"KeyFrames" )) && frames->item_count)
+        to = bag_get( bag_from_object( frames->items[frames->item_count - 1] ), L"Value" );
+    if (!to)
+    {
+        FIXME( "%s animation of %s.%s without To/KeyFrames.\n", debugstr_w(anim->type), debugstr_w(target_name), debugstr_w(path) );
+        return;
+    }
+    TRACE( "%s: %s.%s.\n", debugstr_w(anim->type), debugstr_w(target_name), debugstr_w(property) );
+    xvalue_copy( &value, to );
+    if (brush_color)
+    {
+        IBrush *brush = to_brush( &value );   /* a new brush with the color, rather than changing a shared one */
+        xvalue_clear( &value );
+        if (!brush) return;
+        value.kind = XV_OBJECT;
+        value.object = (IInspectable *)brush;
+    }
+    state_set( instance, group, target, property, &value );
+    xvalue_clear( &value );
+}
+
+void template_go_to_state( struct template_instance *instance, const WCHAR *state_name )
+{
+    struct xaml_element *root = template_root( instance );
+    struct bag *groups, *group, *states, *state = NULL, *board, *children, *setters;
+    UINT32 i, j;
+
+    if (!root || !(groups = bag_from_object( root->visual_state_groups ))) return;
+    for (i = 0; i < groups->item_count && !state; i++)
+    {
+        if (!(group = bag_from_object( groups->items[i] )) || !(states = bag_value( group, L"States" ))) continue;
+        for (j = 0; j < states->item_count; j++)
+        {
+            struct bag *s = bag_from_object( states->items[j] );
+            if (s && !wcscmp( s->name, state_name )) { state = s; break; }
+        }
+    }
+    if (!state)
+    {
+        TRACE( "no state %s.\n", debugstr_w(state_name) );
+        return;
+    }
+    TRACE( "going to state %s of group %s.\n", debugstr_w(state_name), debugstr_w(group->name) );
+
+    /* leave the group's current state: restore what it changed, newest first */
+    for (i = instance->applied_count; i > 0; i--)
+    {
+        struct applied_value *a = &instance->applied[i - 1];
+        if (a->group != &group->IInspectable_iface) continue;
+        set_property( NULL, a->target, &a->prop, &a->old, SET_STATE );
+        IInspectable_Release( a->target );
+        xvalue_clear( &a->old );
+        memmove( a, a + 1, (instance->applied + instance->applied_count - a - 1) * sizeof(*a) );
+        instance->applied_count--;
+    }
+
+    /* storyboard animations jump to their final values */
+    if ((board = bag_value( state, L"Storyboard" )) && (children = bag_value( board, L"Children" )))
+        for (i = 0; i < children->item_count; i++)
+            if (bag_from_object( children->items[i] ))
+                apply_animation( instance, &group->IInspectable_iface, bag_from_object( children->items[i] ) );
+
+    /* <VisualState.Setters><Setter Target="Name.Property" Value="..."/> */
+    if ((setters = bag_value( state, L"Setters" )))
+    {
+        for (i = 0; i < setters->item_count; i++)
+        {
+            struct bag *setter = bag_from_object( setters->items[i] );
+            const WCHAR *target_path = bag_string( setter, L"Target" ), *dot;
+            struct xvalue *v = bag_get( setter, L"Value" ), value;
+            WCHAR name[64];
+            IInspectable *target;
+
+            if (!target_path || !v || !(dot = wcschr( target_path, '.' ))) continue;
+            lstrcpynW( name, target_path, min( ARRAY_SIZE(name), dot - target_path + 1 ) );
+            if (!(target = find_name( instance, name )))
+            {
+                WARN( "setter target %s not found.\n", debugstr_w(target_path) );
+                continue;
+            }
+            xvalue_copy( &value, v );
+            state_set( instance, &group->IInspectable_iface, target, dot + 1, &value );
+            xvalue_clear( &value );
+        }
+    }
+    window_invalidate();
+}
+
 /* Application.LoadComponent: ms-appx:///Folder/Page.xaml is compiled to Folder\Page.xbf in the package folder,
  * which for wine-uwp is the folder of the app's executable. */
 HRESULT load_component( IInspectable *component, HSTRING uri )
