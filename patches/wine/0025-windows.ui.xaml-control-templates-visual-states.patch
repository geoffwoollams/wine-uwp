+        {
+            if (!wcscmp( name, L"Padding" )) IControl_get_Padding( control, &out->thickness );
+            else IControl_get_BorderThickness( control, &out->thickness );
+            IControl_Release( control );
+            return TRUE;
+        }
+        if (QI( target, IBorder, &border ))
+        {
+            if (!wcscmp( name, L"Padding" )) IBorder_get_Padding( border, &out->thickness );
+            else IBorder_get_BorderThickness( border, &out->thickness );
+            IBorder_Release( border );
