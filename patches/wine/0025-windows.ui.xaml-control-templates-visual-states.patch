+    {
+        if (presenter_get_brush( target, name, &brush )) ok = TRUE;
+        else if (QI( target, IControl, &control ))
+        {
+            if (!wcscmp( name, L"Background" )) IControl_get_Background( control, &brush );
+            else if (!wcscmp( name, L"Foreground" )) IControl_get_Foreground( control, &brush );
+            else IControl_get_BorderBrush( control, &brush );
+            IControl_Release( control );
+            ok = TRUE;
+        }
+        else if (QI( target, IBorder, &border ))
+        {
+            if (!wcscmp( name, L"Background" )) { IBorder_get_Background( border, &brush ); ok = TRUE; }
+            else if (!wcscmp( name, L"BorderBrush" )) { IBorder_get_BorderBrush( border, &brush ); ok = TRUE; }
+            IBorder_Release( border );
+        }
+        else if (!wcscmp( name, L"Background" ) && QI( target, IPanel, &panel ))
+        {
+            IPanel_get_Background( panel, &brush );
+            IPanel_Release( panel );
+            ok = TRUE;
+        }
+        else if (!wcscmp( name, L"Foreground" ) && QI( target, ITextBlock, &tb ))
+        {
+            ITextBlock_get_Foreground( tb, &brush );
+            ITextBlock_Release( tb );
+            ok = TRUE;
+        }
+        if (ok) set_brush_value( out, brush );
