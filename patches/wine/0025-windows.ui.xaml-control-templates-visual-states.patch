+static const struct IInspectableVtbl bag_vtbl =
+{
+    bag_QueryInterface, bag_AddRef, bag_Release, bag_GetIids, bag_GetRuntimeClassName, bag_GetTrustLevel,
+};
+
+static IInspectable *bag_create( const WCHAR *type )
+{
+    struct bag *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IInspectable_iface.lpVtbl = &bag_vtbl;
+    impl->ref = 1;
+    lstrcpynW( impl->type, type, ARRAY_SIZE(impl->type) );
+    return &impl->IInspectable_iface;
+}
+
+static struct xvalue *bag_get( struct bag *bag, const WCHAR *name )
+{
+    UINT32 i;
+    if (!bag) return NULL;
+    for (i = 0; i < bag->prop_count; i++) if (!wcscmp( bag->props[i].name, name )) return &bag->props[i].value;
+    return NULL;
+}
+
+static void bag_set( struct bag *bag, const WCHAR *name, const struct xvalue *value )
+{
+    struct bag_property *props;
+    struct xvalue *slot = bag_get( bag, name );
+
+    if (!slot)
+    {
+        if (!(props = realloc( bag->props, (bag->prop_count + 1) * sizeof(*props) ))) return;
+        bag->props = props;
+        memset( &props[bag->prop_count], 0, sizeof(*props) );
+        lstrcpynW( props[bag->prop_count].name, name, ARRAY_SIZE(props->name) );
+        slot = &props[bag->prop_count++].value;
+    }
+    xvalue_clear( slot );
+    xvalue_copy( slot, value );
+}
+
+static void bag_add_item( struct bag *bag, IInspectable *item )
+{
+    IInspectable **items;
+
+    if (!(items = realloc( bag->items, (bag->item_count + 1) * sizeof(*items) ))) return;
+    bag->items = items;
+    items[bag->item_count++] = item;
+    IInspectable_AddRef( item );
+}
+
+/* a collection property of a bag (States, Children, Setters, KeyFrames...), created on demand */
+static IInspectable *bag_collection( struct bag *bag, const WCHAR *name )
+{
+    struct xvalue *slot = bag_get( bag, name ), v = { XV_OBJECT };
+
+    if (slot && slot->kind == XV_OBJECT && slot->object)
+    {
+        IInspectable_AddRef( slot->object );
+        return slot->object;
+    }
+    if (!(v.object = bag_create( L"Collection" ))) return NULL;
+    bag_set( bag, name, &v );
+    return v.object;   /* bag_set added its own reference */
+}
