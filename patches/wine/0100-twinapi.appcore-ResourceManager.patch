+static HRESULT candidate_create( const struct pri_name *name, IResourceCandidate **out )
+{
+    struct pri_file *file = pri_get();
+    struct candidate *impl;
+    const BYTE *data;
+    UINT32 size, type;
+
+    *out = NULL;
+    if (!file || !name || !map_find( file, name->item, &data, &size, &type ))
+        return HRESULT_FROM_WIN32( ERROR_MRM_NAMED_RESOURCE_NOT_FOUND );
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IResourceCandidate_iface.lpVtbl = &candidate_vtbl;
+    impl->IResourceCandidate2_iface.lpVtbl = &candidate2_vtbl;
+    impl->IResourceCandidate3_iface.lpVtbl = &candidate3_vtbl;
+    impl->ref = 1;
+    impl->type = type;
+    impl->size = size;
+    if (!(impl->data = malloc( size ? size : 1 )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    memcpy( impl->data, data, size );
+    TRACE( "%s: type %u, %u bytes.\n", debugstr_w(name->path), type, size );
+    *out = &impl->IResourceCandidate_iface;
+    return S_OK;
+}
