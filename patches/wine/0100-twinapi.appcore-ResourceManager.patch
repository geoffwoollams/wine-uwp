+static HRESULT WINAPI map_get_Uri( IResourceMap *iface, IUriRuntimeClass **value )
+{
+    struct resource_map *impl = impl_from_IResourceMap( iface );
+    static const WCHAR uri_class[] = L"Windows.Foundation.Uri";
+    struct pri_file *file = pri_get();
+    IUriRuntimeClassFactory *factory;
+    HSTRING_HEADER header;
+    WCHAR uri[1024];
+    HSTRING str;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    swprintf( uri, ARRAY_SIZE(uri), L"ms-resource://%s/%s", file ? file->package : L"", impl->prefix );
+    if (FAILED(hr = WindowsCreateStringReference( uri_class, wcslen( uri_class ), &header, &str ))) return hr;
+    if (FAILED(hr = RoGetActivationFactory( str, &IID_IUriRuntimeClassFactory, (void **)&factory ))) return hr;
+    if (SUCCEEDED(hr = WindowsCreateString( uri, wcslen( uri ), &str )))
+    {
+        hr = IUriRuntimeClassFactory_CreateUri( factory, str, value );
+        WindowsDeleteString( str );
+    }
+    IUriRuntimeClassFactory_Release( factory );
+    return hr;
+}
+
+static HRESULT WINAPI map_GetValue( IResourceMap *iface, HSTRING resource, IResourceCandidate **value )
+{
+    struct resource_map *impl = impl_from_IResourceMap( iface );
+    const struct pri_name *name;
+
+    TRACE( "iface %p, resource %s, value %p.\n", iface, debugstr_hstring(resource), value );
+
+    if (!value) return E_POINTER;
+    name = pri_find_resource( pri_get(), impl->prefix, WindowsGetStringRawBuffer( resource, NULL ) );
+    return candidate_create( name, value );
+}
+
+static HRESULT WINAPI map_GetValueForContext( IResourceMap *iface, HSTRING resource, IResourceContext *context,
+                                              IResourceCandidate **value )
+{
+    TRACE( "iface %p, resource %s, context %p, value %p.\n", iface, debugstr_hstring(resource), context, value );
+    return map_GetValue( iface, resource, value );
