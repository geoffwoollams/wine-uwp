+static HRESULT resource_map_create( const WCHAR *prefix, IResourceMap **out )
+{
+    struct resource_map *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IResourceMap_iface.lpVtbl = &map_vtbl;
+    impl->IMapView_HSTRING_NamedResource_iface.lpVtbl = &map_view_vtbl;
+    impl->IIterable_IKeyValuePair_HSTRING_NamedResource_iface.lpVtbl = &map_iterable_vtbl;
