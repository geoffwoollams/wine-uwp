+static HRESULT WINAPI map_GetSubtree( IResourceMap *iface, HSTRING reference, IResourceMap **value )
+{
+    struct resource_map *impl = impl_from_IResourceMap( iface );
+    WCHAR *path;
+    HRESULT hr;
+
+    TRACE( "iface %p, reference %s, value %p.\n", iface, debugstr_hstring(reference), value );
+
+    if (!value) return E_POINTER;
+    if (!(path = resource_path( impl->prefix, WindowsGetStringRawBuffer( reference, NULL ) ))) return E_OUTOFMEMORY;
+    if (!pri_count( pri_get(), path ))
+    {
+        WARN( "no resources under %s.\n", debugstr_w(path) );
+        free( path );
+        *value = NULL;
+        return HRESULT_FROM_WIN32( ERROR_MRM_MAP_NOT_FOUND );
+    }
+    hr = resource_map_create( path, value );
+    free( path );
+    return hr;
+}
