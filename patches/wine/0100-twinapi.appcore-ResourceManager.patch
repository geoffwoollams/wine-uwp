+static HRESULT WINAPI candidate_get_ValueAsString( IResourceCandidate *iface, HSTRING *value )
+{
+    struct candidate *impl = impl_from_IResourceCandidate( iface );
+    const WCHAR *wstr = (const WCHAR *)impl->data;
+    struct pri_file *file = pri_get();
+    WCHAR *buf = NULL, *path;
+    UINT32 len;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    switch (impl->type)
+    {
+    case VALUE_STRING:
+    case VALUE_PATH:
+        len = impl->size / sizeof(WCHAR);
+        break;
+    case VALUE_ASCII_STRING:
+    case VALUE_UTF8_STRING:
+    case VALUE_ASCII_PATH:
+    case VALUE_UTF8_PATH:
+        len = MultiByteToWideChar( CP_UTF8, 0, (const char *)impl->data, impl->size, NULL, 0 );
+        if (!(buf = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        MultiByteToWideChar( CP_UTF8, 0, (const char *)impl->data, impl->size, buf, len );
+        wstr = buf;
+        break;
+    default:
+        WARN( "embedded data has no string value.\n" );
+        return HRESULT_FROM_WIN32( ERROR_MRM_RESOURCE_TYPE_MISMATCH );
+    }
+    while (len && !wstr[len - 1]) len--;
+
+    if ((impl->type == VALUE_PATH || impl->type == VALUE_ASCII_PATH || impl->type == VALUE_UTF8_PATH) && file)
+    {
+        /* a file: its full path in the package */
+        UINT32 full = wcslen( file->root ) + len + 2;
+        if (!(path = malloc( full * sizeof(WCHAR) )))
+        {
+            free( buf );
+            return E_OUTOFMEMORY;
+        }
+        swprintf( path, full, L"%s\\%.*s", file->root, len, wstr );
+        hr = WindowsCreateString( path, wcslen( path ), value );
+        free( path );
+    }
+    else hr = WindowsCreateString( wstr, len, value );
+    free( buf );
+    return hr;
+}
