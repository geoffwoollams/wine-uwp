+/* IIterator<String> over the one language */
+struct languages_iterator
+{
+    const void *const *lpVtbl;
+    LONG ref;
+    struct languages *languages;
+    BOOL done;
+};
+
+static HRESULT WINAPI lang_iter_QueryInterface( struct languages_iterator *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_HSTRING_local ))
+    {
+        InterlockedIncrement( &impl->ref );
+        *out = impl;
+        return S_OK;
+    }
+    FIXME( "iterator %s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI lang_iter_AddRef( struct languages_iterator *impl ) { return InterlockedIncrement( &impl->ref ); }
+static ULONG WINAPI lang_iter_Release( struct languages_iterator *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        languages_Release( impl->languages );
+        free( impl );
+    }
+    return ref;
+}
+static HRESULT WINAPI lang_iter_GetIids( struct languages_iterator *impl, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI lang_iter_GetRuntimeClassName( struct languages_iterator *impl, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI lang_iter_GetTrustLevel( struct languages_iterator *impl, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI lang_iter_get_Current( struct languages_iterator *impl, HSTRING *value )
+{
+    *value = NULL;
+    if (impl->done) return E_BOUNDS;
+    return WindowsDuplicateString( impl->languages->language, value );
+}
+static HRESULT WINAPI lang_iter_get_HasCurrent( struct languages_iterator *impl, boolean *value )
+{
+    *value = !impl->done;
+    return S_OK;
+}
+static HRESULT WINAPI lang_iter_MoveNext( struct languages_iterator *impl, boolean *value )
+{
+    impl->done = TRUE;
+    *value = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI lang_iter_GetMany( struct languages_iterator *impl, UINT32 size, HSTRING *items, UINT32 *count )
+{
+    *count = 0;
+    if (impl->done || !size) return S_OK;
+    *count = 1;
+    return WindowsDuplicateString( impl->languages->language, items );
+}
+static const void *const lang_iter_vtbl[] =
+{
+    lang_iter_QueryInterface, lang_iter_AddRef, lang_iter_Release,
+    lang_iter_GetIids, lang_iter_GetRuntimeClassName, lang_iter_GetTrustLevel,
+    lang_iter_get_Current, lang_iter_get_HasCurrent, lang_iter_MoveNext, lang_iter_GetMany,
+};
+
+static inline struct languages *languages_from_iterable( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct languages, iterable_vtbl );
+}
+static HRESULT WINAPI lang_iterable_QueryInterface( void *iface, REFIID iid, void **out )
+{ return languages_QueryInterface( languages_from_iterable( iface ), iid, out ); }
+static ULONG WINAPI lang_iterable_AddRef( void *iface ) { return languages_AddRef( languages_from_iterable( iface ) ); }
+static ULONG WINAPI lang_iterable_Release( void *iface ) { return languages_Release( languages_from_iterable( iface ) ); }
+static HRESULT WINAPI lang_iterable_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI lang_iterable_GetRuntimeClassName( void *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI lang_iterable_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI lang_iterable_First( void *iface, void **value )
+{
+    struct languages *languages = languages_from_iterable( iface );
+    struct languages_iterator *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->lpVtbl = lang_iter_vtbl;
+    impl->ref = 1;
+    impl->languages = languages;
+    languages_AddRef( languages );
+    *value = impl;
+    return S_OK;
+}
+static const void *const lang_iterable_vtbl[] =
+{
+    lang_iterable_QueryInterface, lang_iterable_AddRef, lang_iterable_Release,
+    lang_iterable_GetIids, lang_iterable_GetRuntimeClassName, lang_iterable_GetTrustLevel,
+    lang_iterable_First,
+};
