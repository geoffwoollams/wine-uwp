diff --git a/dlls/twinapi.appcore/resource_manager.c b/dlls/twinapi.appcore/resource_manager.c
new file mode 100644
index 0000000..f3b4651
--- /dev/null
+++ b/dlls/twinapi.appcore/resource_manager.c
@@ -0,0 +1,1402 @@
+/* WinRT Windows.ApplicationModel.Resources.Core.ResourceManager
+ *
+ * The package's resources.pri, read directly: the resource maps are its named resources ("Resources/AppName",
+ * "MyLibrary.Resources.Strings/Message", "Files/Assets/Logo.png"), and a resource's value is its first candidate.
+ * Qualifiers (language, scale, contrast) are not matched yet: for a resource with candidates in several languages,
+ * the first is used. .NET Native looks up every resx string this way, through ResourceManager.Current.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "appmodel.h"
+#include "roapi.h"
+#include "initguid.h"
+#define WIDL_using_Windows_ApplicationModel_Resources_Core
+#include "windows.applicationmodel.resources.core.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* ---- resources.pri ---- */
+
+#define SECTION_HEADER 32
+#define SECTION_FOOTER 8
+
+/* ResourceValueType, the type of a candidate's value */
+enum value_type { VALUE_STRING, VALUE_PATH, VALUE_EMBEDDED, VALUE_ASCII_STRING, VALUE_UTF8_STRING, VALUE_ASCII_PATH,
+                  VALUE_UTF8_PATH };
+
+struct pri_section
+{
+    const BYTE *data;   /* the content, after the section header */
+    UINT32 size;
+};
+
+struct pri_name
+{
+    WCHAR *path;        /* "Resources/AppName" */
+    UINT32 item;        /* its resource map item */
+};
+
+struct pri_file
+{
+    BYTE *data;
+    SIZE_T size;
+    struct pri_section *sections;
+    char (*ids)[16];
+    UINT16 count;
+    int map;            /* the resource map section */
+    struct pri_name *names;
+    UINT32 name_count;
+    WCHAR package[256]; /* the package's simple name, from the schema */
+    WCHAR root[MAX_PATH];
+};
+
+static struct pri_file *pri;
+static INIT_ONCE pri_once = INIT_ONCE_STATIC_INIT;
+
+static UINT16 get16( const BYTE *p ) { return p[0] | (p[1] << 8); }
+static UINT32 get32( const BYTE *p ) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((UINT32)p[3] << 24); }
+
+static BYTE *read_file( const WCHAR *path, SIZE_T *size )
+{
+    LARGE_INTEGER li;
+    HANDLE handle;
+    BYTE *data = NULL;
+    DWORD read;
+
+    handle = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (handle == INVALID_HANDLE_VALUE) return NULL;
+    if (GetFileSizeEx( handle, &li ) && li.QuadPart < 256 * 1024 * 1024 && (data = malloc( li.QuadPart )) &&
+        (!ReadFile( handle, data, li.QuadPart, &read, NULL ) || read != li.QuadPart))
+    {
+        free( data );
+        data = NULL;
+    }
+    CloseHandle( handle );
+    *size = data ? li.QuadPart : 0;
+    return data;
+}
+
+static int find_section( struct pri_file *file, const char *prefix )
+{
+    UINT16 i;
+    for (i = 0; i < file->count; i++)
+        if (!memcmp( file->ids[i], prefix, strlen( prefix ) ) && file->sections[i].data) return i;
+    return -1;
+}
+
+/* an entry of the hierarchical schema: a scope or an item */
+struct schema_entry
+{
+    UINT16 parent, full_path_length, index;
+    BYTE flags;
+    UINT32 name_offset;
+};
+
+static BOOL entry_name( const struct pri_section *s, const struct schema_entry *e, UINT32 unicode, UINT32 ascii,
+                        WCHAR *buf, UINT32 len )
+{
+    UINT32 i;
+
+    if (!e->full_path_length)
+    {
+        buf[0] = 0;
+        return TRUE;
+    }
+    if (e->flags & 0x20)
+    {
+        for (i = 0; i + 1 < len && ascii + e->name_offset + i < s->size && s->data[ascii + e->name_offset + i]; i++)
+            buf[i] = s->data[ascii + e->name_offset + i];
+    }
+    else
+    {
+        for (i = 0; i + 1 < len && unicode + (e->name_offset + i) * 2 + 1 < s->size &&
+             get16( s->data + unicode + (e->name_offset + i) * 2 ); i++)
+            buf[i] = get16( s->data + unicode + (e->name_offset + i) * 2 );
+    }
+    buf[i] = 0;
+    return i + 1 < len;
+}
+
+/* every item of the hierarchical schema, with its full name, into file->names; and the package's name */
+static BOOL schema_read( struct pri_file *file, const struct pri_section *s, BOOL extended )
+{
+    UINT32 pos, scopes, items, count, unicode_length, ascii_length = 0, entries, unicode, ascii, i, depth;
+    UINT16 unique_length, name_length;
+    struct schema_entry *table;
+    BOOL extended_names = FALSE;
+    WCHAR path[1024], part[MAX_PATH];
+    UINT32 chain[64];
+
+    if (s->size < 8 || get16( s->data ) != 1) return FALSE;
+    unique_length = get16( s->data + 2 );
+    name_length = get16( s->data + 4 );
+    pos = 8;
+    if (extended)
+    {
+        if (pos + 16 > s->size) return FALSE;
+        extended_names = !memcmp( s->data + pos, "[def_hnamesx]", 13 );
+        pos += 16;
+    }
+    if (pos + 20 + (unique_length + name_length) * 2 > s->size) return FALSE;
+    scopes = get32( s->data + pos + 12 );
+    items = get32( s->data + pos + 16 );
+    /* the unique name ("ms-appx://Package.Name/") then the simple one ("Package.Name"), each with its 0 */
+    for (i = 0; i < name_length && i + 1 < ARRAY_SIZE(file->package); i++)
+        if (!(file->package[i] = get16( s->data + pos + 20 + (unique_length + i) * 2 ))) break;
+    file->package[i] = 0;
+    pos += 20 + (unique_length + name_length) * 2 + 2;
+    if (pos + 20 + (extended_names ? 4 : 0) > s->size) return FALSE;
+    unicode_length = get32( s->data + pos + 16 );
+    if (extended_names) ascii_length = get32( s->data + pos + 24 );
+    pos += 24 + (extended_names ? 4 : 0);
+    count = scopes + items;
+    entries = pos;
+    unicode = entries + count * 12 + scopes * 8 + items * 2;
+    ascii = unicode + unicode_length * 2;
+    if ((UINT64)ascii + ascii_length > s->size || !count) return FALSE;
+    if (!(table = calloc( count, sizeof(*table) ))) return FALSE;
+    if (!(file->names = calloc( items, sizeof(*file->names) )))
+    {
+        free( table );
+        return FALSE;
+    }
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *p = s->data + entries + i * 12;
+        table[i].parent = get16( p );
+        table[i].full_path_length = get16( p + 2 );
+        table[i].flags = p[7];
+        table[i].name_offset = get16( p + 8 ) | ((p[7] & 0xf) << 16);
+        table[i].index = get16( p + 10 );
+    }
+    for (i = 0; i < count && file->name_count < items; i++)
+    {
+        UINT32 j, k = i;
+        BOOL ok = TRUE;
+
+        if (table[i].flags & 0x10) continue;   /* a scope */
+        /* up to the root, which is left out of names */
+        for (depth = 0; k && depth < ARRAY_SIZE(chain); depth++)
+        {
+            chain[depth] = k;
+            if (table[k].parent >= count || table[k].parent == k) break;
+            k = table[k].parent;
+        }
+        path[0] = 0;
+        for (j = depth; j > 0 && ok; j--)
+        {
+            if (!entry_name( s, &table[chain[j - 1]], unicode, ascii, part, ARRAY_SIZE(part) ) ||
+                wcslen( path ) + wcslen( part ) + 2 >= ARRAY_SIZE(path)) ok = FALSE;
+            else
+            {
+                if (path[0]) lstrcatW( path, L"/" );
+                lstrcatW( path, part );
+            }
+        }
+        if (!ok || !(file->names[file->name_count].path = wcsdup( path ))) continue;
+        file->names[file->name_count++].item = table[i].index;
+    }
+    free( table );
+    return TRUE;
+}
+
+static BOOL data_item( const struct pri_section *s, UINT32 index, const BYTE **data, UINT32 *size )
+{
+    UINT16 strings, blobs;
+    UINT32 start, offset;
+
+    if (s->size < 12) return FALSE;
+    strings = get16( s->data + 4 );
+    blobs = get16( s->data + 6 );
+    start = 12 + strings * 4 + blobs * 8;
+    if (index < strings)
+    {
+        offset = get16( s->data + 12 + index * 4 );
+        *size = get16( s->data + 12 + index * 4 + 2 );
+    }
+    else if (index < (UINT32)strings + blobs)
+    {
+        offset = get32( s->data + 12 + strings * 4 + (index - strings) * 8 );
+        *size = get32( s->data + 12 + strings * 4 + (index - strings) * 8 + 4 );
+    }
+    else return FALSE;
+    if ((UINT64)start + offset + *size > s->size) return FALSE;
+    *data = s->data + start + offset;
+    return TRUE;
+}
+
+/* the first candidate of an item of the resource map, and its value type */
+static BOOL map_find( struct pri_file *file, UINT32 item, const BYTE **data, UINT32 *size, UINT32 *type )
+{
+    const struct pri_section *s = &file->sections[file->map];
+    UINT16 env_length, schema_ref_length, types, map_count, group_count;
+    UINT32 info_count, candidates, data_length, large_length, pos, i, j, types_pos;
+    UINT32 first_item, group, group_size, first_info, info, string_data;
+    UINT32 maps, groups, infos, large_maps = 0, large_groups = 0, large_infos = 0, total_maps, total_groups;
+    const BYTE *large = NULL, *c;
+
+    if (s->size < 32) return FALSE;
+    env_length = get16( s->data );
+    schema_ref_length = get16( s->data + 6 );
+    types = get16( s->data + 10 );
+    map_count = get16( s->data + 12 );
+    group_count = get16( s->data + 14 );
+    info_count = get32( s->data + 16 );
+    candidates = get32( s->data + 20 );
+    data_length = get32( s->data + 24 );
+    large_length = get32( s->data + 28 );
+    types_pos = 32 + env_length + schema_ref_length;
+    pos = types_pos + types * 8;
+    maps = pos;
+    groups = maps + map_count * 4;
+    infos = groups + group_count * 4;
+    pos = infos + info_count * 4;
+    if (large_length)
+    {
+        large = s->data + pos;
+        if (pos + 12 > s->size) return FALSE;
+        large_maps = get32( large );
+        large_groups = get32( large + 4 );
+        large_infos = get32( large + 8 );
+    }
+    pos += large_length;
+    string_data = pos + candidates * 8;
+    if ((UINT64)string_data + data_length > s->size) return FALSE;
+    total_maps = map_count + large_maps;
+    total_groups = group_count + large_groups;
+    for (i = 0; i < total_maps; i++)
+    {
+        if (i < map_count)
+        {
+            first_item = get16( s->data + maps + i * 4 );
+            group = get16( s->data + maps + i * 4 + 2 );
+        }
+        else
+        {
+            first_item = get32( large + 12 + (i - map_count) * 8 );
+            group = get32( large + 12 + (i - map_count) * 8 + 4 );
+        }
+        if (group < group_count)
+        {
+            group_size = get16( s->data + groups + group * 4 );
+            first_info = get16( s->data + groups + group * 4 + 2 );
+        }
+        else if (group < total_groups)
+        {
+            const BYTE *g = large + 12 + large_maps * 8 + (group - group_count) * 8;
+            group_size = get32( g );
+            first_info = get32( g + 4 );
+        }
+        else
+        {
+            group_size = 1;
+            first_info = group - total_groups;
+        }
+        if (item < first_item || item >= first_item + group_size) continue;
+        j = first_info + (item - first_item);
+        if (j < info_count) info = get16( s->data + infos + j * 4 + 2 );
+        else if (j - info_count < large_infos) info = get32( large + 12 + large_maps * 8 + large_groups * 8 + (j - info_count) * 8 + 4 );
+        else return FALSE;
+        if (info >= candidates) return FALSE;
+        c = s->data + pos + info * 8;
+        *type = c[1] < types ? get32( s->data + types_pos + c[1] * 8 + 4 ) : VALUE_EMBEDDED;
+        if (c[0] == 1)
+        {
+            UINT16 source = get16( c + 2 ), location = get16( c + 4 ), section = get16( c + 6 );
+            if (source) FIXME( "item %u is in another file (%u).\n", item, source );
+            if (source || section >= file->count || !file->sections[section].data) return FALSE;
+            return data_item( &file->sections[section], location, data, size );
+        }
+        if (c[0] == 0)
+        {
+            UINT32 offset = get32( c + 4 );
+            *size = get16( c + 2 );
+            if ((UINT64)offset + *size > data_length) return FALSE;
+            *data = s->data + string_data + offset;
+            return TRUE;
+        }
+        return FALSE;
+    }
+    return FALSE;
+}
+
+static BOOL CALLBACK pri_load( INIT_ONCE *once, void *param, void **context )
+{
+    UINT32 toc, start, i, offset, length, len;
+    struct pri_file *file;
+    const BYTE *entry;
+    WCHAR path[MAX_PATH + 16], *p;
+    int schema;
+
+    if (!(file = calloc( 1, sizeof(*file) ))) return TRUE;
+    len = ARRAY_SIZE(file->root);
+    if (GetCurrentPackagePath( &len, file->root ))
+    {
+        GetModuleFileNameW( NULL, file->root, ARRAY_SIZE(file->root) );
+        if ((p = wcsrchr( file->root, '\\' ))) *p = 0;
+    }
+    swprintf( path, ARRAY_SIZE(path), L"%s\\resources.pri", file->root );
+    if (!(file->data = read_file( path, &file->size ))) goto fail;
+    if (file->size < 32 || memcmp( file->data, "mrm_pri", 7 )) goto fail;
+    toc = get32( file->data + 16 );
+    start = get32( file->data + 20 );
+    file->count = get16( file->data + 24 );
+    if ((UINT64)toc + file->count * 32 > file->size) goto fail;
+    if (!(file->sections = calloc( file->count, sizeof(*file->sections) )) ||
+        !(file->ids = calloc( file->count, sizeof(*file->ids) ))) goto fail;
+    for (i = 0; i < file->count; i++)
+    {
+        entry = file->data + toc + i * 32;
+        memcpy( file->ids[i], entry, 16 );
+        offset = start + get32( entry + 24 );
+        length = get32( entry + 28 );
+        if (length < SECTION_HEADER + SECTION_FOOTER || (UINT64)offset + length > file->size) continue;
+        file->sections[i].data = file->data + offset + SECTION_HEADER;
+        file->sections[i].size = length - SECTION_HEADER - SECTION_FOOTER;
+    }
+    if ((schema = find_section( file, "[mrm_hschemaex]" )) < 0 && (schema = find_section( file, "[mrm_hschema]" )) < 0)
+        goto fail;
+    if ((file->map = find_section( file, "[mrm_res_map2_]" )) < 0 && (file->map = find_section( file, "[mrm_res_map__]" )) < 0)
+        goto fail;
+    if (!schema_read( file, &file->sections[schema], !memcmp( file->ids[schema], "[mrm_hschemaex]", 15 ) )) goto fail;
+    TRACE( "%s: package %s, %u resources.\n", debugstr_w(path), debugstr_w(file->package), file->name_count );
+    pri = file;
+    return TRUE;
+
+fail:
+    WARN( "no usable %s.\n", debugstr_w(path) );
+    free( file->data );
+    free( file->sections );
+    free( file->ids );
+    free( file->names );
+    free( file );
+    return TRUE;
+}
+
+static struct pri_file *pri_get(void)
+{
+    InitOnceExecuteOnce( &pri_once, pri_load, NULL, NULL );
+    return pri;
+}
+
+/* the full name of a resource asked for in a map: "Strings/Hello", "/Resources/Hello" (from the root),
+ * "ms-resource:///Resources/Hello" or "ms-resource://Package.Name/Resources/Hello" */
+static WCHAR *resource_path( const WCHAR *prefix, const WCHAR *name )
+{
+    BOOL absolute = FALSE;
+    WCHAR *path;
+    SIZE_T len;
+
+    if (!name) name = L"";
+    if (!wcsnicmp( name, L"ms-resource:", 12 ))
+    {
+        name += 12;
+        absolute = TRUE;
+        if (name[0] == '/' && name[1] == '/')
+        {
+            name += 2;
+            while (*name && *name != '/') name++;   /* the package name */
+        }
+    }
+    if (*name == '/') absolute = TRUE;
+    while (*name == '/') name++;
+    if (absolute || !prefix || !prefix[0]) return wcsdup( name );
+    len = wcslen( prefix ) + wcslen( name ) + 2;
+    if (!(path = malloc( len * sizeof(WCHAR) ))) return NULL;
+    swprintf( path, len, L"%s/%s", prefix, name );
+    return path;
+}
+
+static const struct pri_name *pri_find( struct pri_file *file, const WCHAR *path )
+{
+    UINT32 i;
+
+    if (!file) return NULL;
+    for (i = 0; i < file->name_count; i++)
+        if (!wcsicmp( file->names[i].path, path )) return &file->names[i];
+    return NULL;
+}
+
+/* resw names a control's property "Hello.Text"; resources.pri has it as "Hello/Text" */
+static const struct pri_name *pri_find_resource( struct pri_file *file, const WCHAR *prefix, const WCHAR *name )
+{
+    const struct pri_name *found;
+    WCHAR *path, *p;
+
+    if (!(path = resource_path( prefix, name ))) return NULL;
+    if (!(found = pri_find( file, path )) && (p = wcsrchr( path, '.' )) && p > wcsrchr( path, '/' ))
+    {
+        *p = '/';
+        found = pri_find( file, path );
+    }
+    TRACE( "%s: %s.\n", debugstr_w(path), found ? "found" : "not found" );
+    free( path );
+    return found;
+}
+
+/* how many resources are below the prefix (all of them for "") */
+static UINT32 pri_count( struct pri_file *file, const WCHAR *prefix )
+{
+    UINT32 i, n = 0, len = wcslen( prefix );
+
+    if (!file) return 0;
+    if (!len) return file->name_count;
+    for (i = 0; i < file->name_count; i++)
+        if (!wcsnicmp( file->names[i].path, prefix, len ) && file->names[i].path[len] == '/') n++;
+    return n;
+}
