+static HRESULT WINAPI candidate3_get_Kind( IResourceCandidate3 *iface, ResourceCandidateKind *value )
+{
+    struct candidate *impl = impl_from_IResourceCandidate3( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    switch (impl->type)
+    {
+    case VALUE_PATH: case VALUE_ASCII_PATH: case VALUE_UTF8_PATH: *value = ResourceCandidateKind_File; break;
+    case VALUE_EMBEDDED: *value = ResourceCandidateKind_EmbeddedData; break;
