  * (Application.LoadComponent); otherwise *out receives the root object. */
+/* ---- XAML text: XamlReader.Load and the built-in generic.xaml ----
+ *
+ * A small XML reader builds a tree of the markup, which is then run through the same object writer as compiled XBF:
+ * elements create objects, attributes and property elements set properties, children go to the content property.
+ * Control templates keep their part of the tree and build it for each control. */
+
+#define NS_PRESENTATION L"http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+#define NS_XAML L"http://schemas.microsoft.com/winfx/2006/xaml"
+
+struct xml_attr
+{
+    WCHAR *ns;      /* NULL for unprefixed attributes */
+    WCHAR *name;    /* local name, "Grid.Row" for attached properties */
+    WCHAR *value;
+};
+
+struct xml_node
+{
+    WCHAR *ns, *name;
+    struct xml_attr *attrs;
+    UINT32 attr_count;
+    struct xml_node **children;
+    UINT32 child_count;
+    WCHAR *text;    /* character content, trimmed; NULL if only white space */
+};
+
+struct xml_doc
+{
+    LONG ref;
+    struct xml_node *root;
+};
+
+struct xml_parser
+{
+    const WCHAR *p, *end;
+    struct { WCHAR *prefix, *uri; } *ns;
+    UINT32 ns_count, ns_size;
+    BOOL failed;
+};
+
+static void xml_node_free( struct xml_node *node )
+{
+    UINT32 i;
+
+    if (!node) return;
+    for (i = 0; i < node->attr_count; i++)
+    {
+        free( node->attrs[i].ns );
+        free( node->attrs[i].name );
+        free( node->attrs[i].value );
+    }
+    for (i = 0; i < node->child_count; i++) xml_node_free( node->children[i] );
+    free( node->attrs );
+    free( node->children );
+    free( node->ns );
+    free( node->name );
+    free( node->text );
+    free( node );
+}
+
+static void xml_doc_addref( struct xml_doc *doc )
+{
+    InterlockedIncrement( &doc->ref );
+}
+
+static void xml_doc_release( struct xml_doc *doc )
+{
+    if (InterlockedDecrement( &doc->ref )) return;
+    xml_node_free( doc->root );
+    free( doc );
+}
+
+static WCHAR *wcsndup_( const WCHAR *str, SIZE_T len )
+{
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) );
+    if (!ret) return NULL;
+    memcpy( ret, str, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+static BOOL xml_space( WCHAR c )
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+static void xml_skip_space( struct xml_parser *x )
+{
+    while (x->p < x->end && xml_space( *x->p )) x->p++;
+}
+
+static BOOL xml_starts( struct xml_parser *x, const WCHAR *str )
+{
+    SIZE_T len = wcslen( str );
+    return x->end - x->p >= len && !memcmp( x->p, str, len * sizeof(WCHAR) );
+}
+
+static BOOL xml_skip_past( struct xml_parser *x, const WCHAR *str )
+{
+    SIZE_T len = wcslen( str );
+    for (; x->end - x->p >= len; x->p++)
+        if (!memcmp( x->p, str, len * sizeof(WCHAR) )) { x->p += len; return TRUE; }
+    x->failed = TRUE;
+    return FALSE;
+}
+
+/* character data with the predefined and numeric entities decoded */
+static WCHAR *xml_decode( const WCHAR *str, SIZE_T len )
+{
+    static const struct { const WCHAR *name; WCHAR c; } entities[] =
+        { {L"lt;", '<'}, {L"gt;", '>'}, {L"amp;", '&'}, {L"quot;", '"'}, {L"apos;", '\''} };
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) ), *d = ret;
+    const WCHAR *end = str + len;
+    UINT32 i, c;
+
+    if (!ret) return NULL;
+    while (str < end)
+    {
+        if (*str != '&') { *d++ = *str++; continue; }
+        str++;
+        if (*str == '#')
+        {
+            WCHAR *stop;
+            c = str[1] == 'x' ? wcstoul( str + 2, &stop, 16 ) : wcstoul( str + 1, &stop, 10 );
+            if (stop < end && *stop == ';') str = stop + 1;
+            if (c >= 0x10000) { c -= 0x10000; *d++ = 0xd800 | (c >> 10); *d++ = 0xdc00 | (c & 0x3ff); }
+            else *d++ = c;
+            continue;
+        }
+        for (i = 0; i < ARRAY_SIZE(entities); i++)
+        {
+            SIZE_T n = wcslen( entities[i].name );
+            if (end - str >= n && !memcmp( str, entities[i].name, n * sizeof(WCHAR) )) { *d++ = entities[i].c; str += n; break; }
+        }
+        if (i == ARRAY_SIZE(entities)) *d++ = '&';
+    }
+    *d = 0;
+    return ret;
+}
+
+static WCHAR *xml_name( struct xml_parser *x )
+{
+    const WCHAR *start = x->p;
+    while (x->p < x->end && !xml_space( *x->p ) && *x->p != '=' && *x->p != '>' && *x->p != '/' && *x->p != '<') x->p++;
+    if (x->p == start) { x->failed = TRUE; return NULL; }
+    return wcsndup_( start, x->p - start );
+}
+
+static const WCHAR *xml_lookup_ns( struct xml_parser *x, const WCHAR *prefix, SIZE_T len )
+{
+    UINT32 i;
+    for (i = x->ns_count; i > 0; i--)
+        if (wcslen( x->ns[i - 1].prefix ) == len && !memcmp( x->ns[i - 1].prefix, prefix, len * sizeof(WCHAR) ))
+            return x->ns[i - 1].uri;
+    return NULL;
+}
+
+/* split "prefix:name" and resolve the prefix; *local points into qname */
+static WCHAR *xml_resolve( struct xml_parser *x, const WCHAR *qname, const WCHAR **local, BOOL attribute )
+{
+    const WCHAR *colon = wcschr( qname, ':' ), *uri;
+
+    if (!colon)
+    {
+        *local = qname;
+        if (attribute) return NULL;
+        uri = xml_lookup_ns( x, L"", 0 );
+    }
+    else
+    {
+        *local = colon + 1;
+        uri = xml_lookup_ns( x, qname, colon - qname );
+        if (!uri) WARN( "undeclared prefix in %s.\n", debugstr_w(qname) );
+    }
+    return uri ? wcsdup( uri ) : NULL;
+}
+
+static BOOL xml_add_child( struct xml_node *node, struct xml_node *child )
+{
+    struct xml_node **children = realloc( node->children, (node->child_count + 1) * sizeof(*children) );
+    if (!children) return FALSE;
+    node->children = children;
+    children[node->child_count++] = child;
+    return TRUE;
+}
+
+static void xml_add_text( struct xml_node *node, const WCHAR *str, SIZE_T len, BOOL raw )
+{
+    WCHAR *text = raw ? wcsndup_( str, len ) : xml_decode( str, len ), *joined;
+    SIZE_T old = node->text ? wcslen( node->text ) : 0;
+
+    if (!text) return;
+    if (!(joined = realloc( node->text, (old + wcslen( text ) + 1) * sizeof(WCHAR) ))) { free( text ); return; }
+    lstrcpyW( joined + old, text );
+    node->text = joined;
+    free( text );
+}
+
+static void xml_trim_text( struct xml_node *node )
+{
+    WCHAR *start, *end;
+
+    if (!node->text) return;
+    for (start = node->text; xml_space( *start ); start++);
+    for (end = start + wcslen( start ); end > start && xml_space( end[-1] ); end--);
+    if (end == start)
+    {
+        free( node->text );
+        node->text = NULL;
+        return;
+    }
+    memmove( node->text, start, (end - start) * sizeof(WCHAR) );
+    node->text[end - start] = 0;
+}
+
+static struct xml_node *xml_element( struct xml_parser *x )
+{
+    struct raw_attr { WCHAR *name, *value; } *raw = NULL;
+    UINT32 raw_count = 0, ns_saved = x->ns_count, i;
+    struct xml_node *node;
+    const WCHAR *local, *start;
+    WCHAR *qname, quote;
+
+    x->p++;  /* '<' */
+    if (!(qname = xml_name( x ))) return NULL;
+    if (!(node = calloc( 1, sizeof(*node) ))) { free( qname ); x->failed = TRUE; return NULL; }
+
+    /* attributes; xmlns declarations first, so that the others can be resolved */
+    for (;;)
+    {
+        struct raw_attr *tmp;
+        WCHAR *name;
+
+        xml_skip_space( x );
+        if (x->p >= x->end) { x->failed = TRUE; break; }
+        if (*x->p == '/' || *x->p == '>') break;
+        if (!(name = xml_name( x ))) break;
+        xml_skip_space( x );
+        if (x->p >= x->end || *x->p != '=') { free( name ); x->failed = TRUE; break; }
+        x->p++;
+        xml_skip_space( x );
+        if (x->p >= x->end || (*x->p != '"' && *x->p != '\'')) { free( name ); x->failed = TRUE; break; }
+        quote = *x->p++;
+        for (start = x->p; x->p < x->end && *x->p != quote; x->p++);
+        if (x->p >= x->end) { free( name ); x->failed = TRUE; break; }
+        if (!(tmp = realloc( raw, (raw_count + 1) * sizeof(*raw) ))) { free( name ); x->failed = TRUE; break; }
+        raw = tmp;
+        raw[raw_count].name = name;
+        raw[raw_count++].value = xml_decode( start, x->p - start );
+        x->p++;
+    }
+    for (i = 0; i < raw_count && !x->failed; i++)
+    {
+        const WCHAR *prefix;
+        if (!wcscmp( raw[i].name, L"xmlns" )) prefix = L"";
+        else if (!wcsncmp( raw[i].name, L"xmlns:", 6 )) prefix = raw[i].name + 6;
+        else continue;
+        if (x->ns_count == x->ns_size)
+        {
+            UINT32 size = max( 16, x->ns_size * 2 );
+            void *tmp = realloc( x->ns, size * sizeof(*x->ns) );
+            if (!tmp) { x->failed = TRUE; break; }
+            x->ns = tmp;
+            x->ns_size = size;
+        }
+        x->ns[x->ns_count].prefix = wcsdup( prefix );
+        x->ns[x->ns_count++].uri = wcsdup( raw[i].value );
+    }
+    node->ns = xml_resolve( x, qname, &local, FALSE );
+    node->name = wcsdup( local );
+    if ((node->attrs = calloc( max( 1, raw_count ), sizeof(*node->attrs) )))
+    {
+        for (i = 0; i < raw_count; i++)
+        {
+            if (!wcscmp( raw[i].name, L"xmlns" ) || !wcsncmp( raw[i].name, L"xmlns:", 6 )) continue;
+            node->attrs[node->attr_count].ns = xml_resolve( x, raw[i].name, &local, TRUE );
+            node->attrs[node->attr_count].name = wcsdup( local );
+            node->attrs[node->attr_count].value = raw[i].value;
+            raw[i].value = NULL;
+            node->attr_count++;
+        }
+    }
+    for (i = 0; i < raw_count; i++)
+    {
+        free( raw[i].name );
+        free( raw[i].value );
+    }
+    free( raw );
+
+    if (!x->failed && *x->p == '/')
+    {
+        x->p++;
+        if (x->p < x->end && *x->p == '>') x->p++; else x->failed = TRUE;
+    }
+    else if (!x->failed)
+    {
+        x->p++;  /* '>' */
+        for (;;)
+        {
+            for (start = x->p; x->p < x->end && *x->p != '<'; x->p++);
+            if (x->p > start) xml_add_text( node, start, x->p - start, FALSE );
+            if (x->p >= x->end) { x->failed = TRUE; break; }
+            if (xml_starts( x, L"<!--" )) { if (!xml_skip_past( x, L"-->" )) break; }
+            else if (xml_starts( x, L"<![CDATA[" ))
+            {
+                x->p += 9;
+                start = x->p;
+                if (!xml_skip_past( x, L"]]>" )) break;
+                xml_add_text( node, start, x->p - 3 - start, TRUE );
+            }
+            else if (xml_starts( x, L"<?" )) { if (!xml_skip_past( x, L"?>" )) break; }
+            else if (xml_starts( x, L"</" ))
+            {
+                WCHAR *end_name;
+                x->p += 2;
+                if ((end_name = xml_name( x )))
+                {
+                    if (wcscmp( end_name, qname )) { WARN( "</%s> closes <%s>.\n", debugstr_w(end_name), debugstr_w(qname) ); x->failed = TRUE; }
+                    free( end_name );
+                }
+                xml_skip_space( x );
+                if (x->p < x->end && *x->p == '>') x->p++; else x->failed = TRUE;
+                break;
+            }
+            else
+            {
+                struct xml_node *child = xml_element( x );
+                if (!child || !xml_add_child( node, child )) { xml_node_free( child ); x->failed = TRUE; }
+                if (x->failed) break;
+            }
+        }
+        xml_trim_text( node );
+    }
+    while (x->ns_count > ns_saved)
+    {
+        x->ns_count--;
+        free( x->ns[x->ns_count].prefix );
+        free( x->ns[x->ns_count].uri );
+    }
+    free( qname );
+    return node;
+}
+
+static HRESULT xml_parse( const WCHAR *text, SIZE_T len, struct xml_doc **out )
+{
+    struct xml_parser x = { text, text + len };
+    struct xml_doc *doc;
+
+    if (x.p < x.end && *x.p == 0xfeff) x.p++;
+    for (;;)
+    {
+        xml_skip_space( &x );
+        if (xml_starts( &x, L"<?" )) { if (!xml_skip_past( &x, L"?>" )) break; }
+        else if (xml_starts( &x, L"<!--" )) { if (!xml_skip_past( &x, L"-->" )) break; }
+        else break;
+    }
+    if (x.failed || x.p >= x.end || *x.p != '<') return E_INVALIDARG;
+    if (!(doc = calloc( 1, sizeof(*doc) ))) return E_OUTOFMEMORY;
+    doc->ref = 1;
+    doc->root = xml_element( &x );
+    free( x.ns );
+    if (x.failed || !doc->root)
+    {
+        WARN( "malformed XAML near offset %Iu.\n", (SIZE_T)(x.p - text) );
+        xml_doc_release( doc );
+        return E_INVALIDARG;
+    }
+    *out = doc;
+    return S_OK;
+}
