+/* a fill with alpha: theme brushes such as SystemControlBackgroundBaseLowBrush are translucent black or white */
+static void fill_argb( struct layout_context *ctx, const struct layout_rect *rect, Color c )
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, c.A, 0 };
+    BITMAPINFO info = {{ sizeof(info.bmiHeader), 1, 1, 1, 32 }};
+    HBITMAP bitmap, old;
+    DWORD *bits;
+    HDC mem;
+    RECT r;
+
+    if (c.A == 0xff)
+    {
+        element_fill_color( ctx, rect, RGB( c.R, c.G, c.B ) );
+        return;
+    }
+    element_device_rect( rect, ctx, &r );
+    if (r.right <= r.left || r.bottom <= r.top) return;
+    mem = CreateCompatibleDC( ctx->hdc );
+    bitmap = CreateDIBSection( mem, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0 );
+    *bits = c.R << 16 | c.G << 8 | c.B;
+    old = SelectObject( mem, bitmap );
+    GdiAlphaBlend( ctx->hdc, r.left, r.top, r.right - r.left, r.bottom - r.top, mem, 0, 0, 1, 1, blend );
+    SelectObject( mem, old );
+    DeleteObject( bitmap );
+    DeleteDC( mem );
+}
+
 void element_fill( struct layout_context *ctx, const struct layout_rect *rect, IBrush *brush )
 {
     Color c;
 
     if (!brush || !brush_get_color( brush, &c ) || !c.A) return;
-    element_fill_color( ctx, rect, RGB( c.R, c.G, c.B ) );
+    fill_argb( ctx, rect, c );
+}
+
+/* a translucent text colour, blended over what is under the middle of rect (GDI text has no alpha) */
+COLORREF element_text_color( struct layout_context *ctx, const struct layout_rect *rect, Color c )
+{
+    COLORREF under;
+    RECT r;
+
+    if (c.A == 0xff) return RGB( c.R, c.G, c.B );
+    element_device_rect( rect, ctx, &r );
+    under = GetPixel( ctx->hdc, (r.left + r.right) / 2, (r.top + r.bottom) / 2 );
+    if (under == CLR_INVALID) under = ctx->dark ? RGB(0, 0, 0) : RGB(255, 255, 255);
+    return RGB( (c.R * c.A + GetRValue( under ) * (255 - c.A)) / 255,
+                (c.G * c.A + GetGValue( under ) * (255 - c.A)) / 255,
+                (c.B * c.A + GetBValue( under ) * (255 - c.A)) / 255 );
 }
 
 void element_frame_color( struct layout_context *ctx, const struct layout_rect *rect, const Thickness *t, COLORREF color )
@@ -1498,10 +1541,29 @@ void element_frame_color( struct layout_context *ctx, const struct layout_rect *
 
 void element_frame( struct layout_context *ctx, const struct layout_rect *rect, const Thickness *t, IBrush *brush )
 {
+    struct layout_rect side;
     Color c;
 
     if (!brush || !brush_get_color( brush, &c ) || !c.A) return;
-    element_frame_color( ctx, rect, t, RGB( c.R, c.G, c.B ) );
+    if (c.A == 0xff)
+    {
+        element_frame_color( ctx, rect, t, RGB( c.R, c.G, c.B ) );
+        return;
+    }
+    side = *rect;
+    side.height = min( (float)t->Top, rect->height );
+    fill_argb( ctx, &side, c );
+    side.y = rect->y + rect->height - min( (float)t->Bottom, rect->height );
+    side.height = min( (float)t->Bottom, rect->height );
+    fill_argb( ctx, &side, c );
+    side = *rect;
+    side.y += t->Top;
+    side.height = max( 0.0f, rect->height - t->Top - t->Bottom );
+    side.width = min( (float)t->Left, rect->width );
+    fill_argb( ctx, &side, c );
+    side.x = rect->x + rect->width - min( (float)t->Right, rect->width );
+    side.width = min( (float)t->Right, rect->width );
+    fill_argb( ctx, &side, c );
 }
 
