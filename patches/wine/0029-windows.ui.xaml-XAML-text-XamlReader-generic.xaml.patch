+/* "Grid.Row" -> Grid, Row; "Background" -> the element's type, Background */
+static void text_prop( struct xprop *prop, const WCHAR *owner, const WCHAR *name )
+{
+    const WCHAR *dot = wcschr( name, '.' );
+
+    memset( prop, 0, sizeof(*prop) );
+    if (dot)
+    {
+        lstrcpynW( prop->owner, name, min( ARRAY_SIZE(prop->owner), dot - name + 1 ) );
+        name = dot + 1;
+    }
+    else if (owner) lstrcpynW( prop->owner, owner, ARRAY_SIZE(prop->owner) );
+    lstrcpynW( prop->name, name, ARRAY_SIZE(prop->name) );
+}
