+/* the default style (DefaultStyleKey) for an element, applied below its own and implicit styles */
+void element_apply_default_style( struct xaml_element *element )
+{
+    IInspectable *style;
+    WCHAR key[100];
+
+    if (element->default_style_done) return;
+    element->default_style_done = TRUE;
+    implicit_key( element->class_name, key, ARRAY_SIZE(key) );
+    if (!(style = generic_resource_lookup( key ))) return;
+    TRACE( "default style for %s.\n", debugstr_w(element->class_name) );
+    style_apply_mode( style, element->outer, SET_DEFAULT );
+    IInspectable_Release( style );
+}
