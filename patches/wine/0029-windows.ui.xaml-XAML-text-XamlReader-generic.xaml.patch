+enum extension
+{
+    EXT_NONE,
+    EXT_STATIC_RESOURCE,
+    EXT_THEME_RESOURCE,
+    EXT_TEMPLATE_BINDING,
+    EXT_NULL,
+    EXT_OTHER,
+};
