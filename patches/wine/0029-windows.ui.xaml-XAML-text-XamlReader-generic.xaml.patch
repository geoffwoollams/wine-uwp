+static const WCHAR *xml_attr_value( struct xml_node *node, const WCHAR *ns, const WCHAR *name )
+{
+    UINT32 i;
+    for (i = 0; i < node->attr_count; i++)
+    {
+        struct xml_attr *a = &node->attrs[i];
+        if (wcscmp( a->name, name )) continue;
+        if (ns ? (a->ns && !wcscmp( a->ns, ns )) : !a->ns) return a->value;
+    }
+    return NULL;
+}
+
+static BOOL is_ns( const WCHAR *ns, const WCHAR *uri )
+{
+    return ns && !wcscmp( ns, uri );
+}
