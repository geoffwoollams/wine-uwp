+/* "{StaticResource Key}" and friends; arg gets the key or property */
+static enum extension text_extension( const WCHAR *value, WCHAR *arg, SIZE_T len )
+{
+    static const struct { const WCHAR *name; enum extension ext; const WCHAR *named; } names[] =
+    {
+        { L"StaticResource", EXT_STATIC_RESOURCE, L"ResourceKey=" },
+        { L"ThemeResource", EXT_THEME_RESOURCE, L"ResourceKey=" },
+        { L"TemplateBinding", EXT_TEMPLATE_BINDING, L"Property=" },
+        { L"x:Null", EXT_NULL, NULL },
+    };
+    const WCHAR *p, *end;
+    SIZE_T n;
+    UINT32 i;
+
+    arg[0] = 0;
+    if (value[0] != '{' || value[1] == '}') return EXT_NONE;
+    for (p = value + 1; xml_space( *p ); p++);
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        n = wcslen( names[i].name );
+        if (wcsncmp( p, names[i].name, n ) || (!xml_space( p[n] ) && p[n] != '}')) continue;
+        for (p += n; xml_space( *p ); p++);
+        if (names[i].named && !wcsncmp( p, names[i].named, wcslen( names[i].named ) )) p += wcslen( names[i].named );
+        for (end = p; *end && *end != '}' && !xml_space( *end ) && *end != ','; end++);
+        lstrcpynW( arg, p, min( len, end - p + 1 ) );
+        return names[i].ext;
+    }
+    for (end = p; *end && *end != '}' && !xml_space( *end ); end++);
+    lstrcpynW( arg, p, min( len, end - p + 1 ) );
+    return EXT_OTHER;
+}
+
+/* an attribute value as a writer value; FALSE if there's nothing to set */
+static BOOL text_value( struct writer *w, const WCHAR *str, struct xvalue *out )
+{
+    WCHAR arg[128];
+    IInspectable *object;
+
+    memset( out, 0, sizeof(*out) );
+    switch (text_extension( str, arg, ARRAY_SIZE(arg) ))
+    {
+    case EXT_NONE:
+        out->kind = XV_STRING;
+        out->s = wcsdup( str[0] == '{' && str[1] == '}' ? str + 2 : str );
+        return TRUE;
+    case EXT_STATIC_RESOURCE:
+    case EXT_THEME_RESOURCE:
+        if (!(object = lookup_resource( w, arg, str[1] == 'T', FALSE ))) return FALSE;
+        out->kind = XV_OBJECT;
+        out->object = object;
+        unbox_value( out );
+        return TRUE;
+    case EXT_NULL:
+        out->kind = XV_NULL;
+        return TRUE;
+    case EXT_TEMPLATE_BINDING:
+        return FALSE;   /* the caller binds */
+    default:
+        FIXME( "markup extension %s is not supported.\n", debugstr_w(str) );
+        return FALSE;
+    }
+}
+
+static void text_element( struct writer *w, struct xml_node *node, struct xvalue *out );
+
+static BOOL is_property_element( struct xml_node *node )
+{
+    return node->name && wcschr( node->name, '.' ) != NULL;
+}
+
+static const WCHAR *event_names[] =
+{
+    L"Click", L"Checked", L"Unchecked", L"Indeterminate", L"Loaded", L"Unloaded", L"Tapped", L"PointerPressed",
+    L"PointerReleased", L"PointerEntered", L"PointerExited", L"SelectionChanged", L"TextChanged", L"ValueChanged",
+};
+
+/* resources in a dictionary: each with its x:Key, or a Style's implicit key */
+static void text_add_resource( struct writer *w, IInspectable *dict, struct xml_node *node )
+{
+    const WCHAR *key = xml_attr_value( node, NS_XAML, L"Key" );
+    struct xvalue value;
+    WCHAR implicit[100];
+
+    if (!key) key = xml_attr_value( node, NS_XAML, L"Name" );
+    text_element( w, node, &value );
+    if (value.kind == XV_OBJECT && value.object && style_from_object( value.object ) && !key)
+    {
+        implicit_key( style_from_object( value.object )->target, implicit, ARRAY_SIZE(implicit) );
+        key = implicit;
+    }
+    if (value.kind != XV_OBJECT) box_value( &value );
+    if (key && value.object) resource_dictionary_insert( dict, key, value.object );
+    else if (!key) FIXME( "resource %s without x:Key.\n", debugstr_w(node->name) );
+    xvalue_clear( &value );
+}
+
+/* <Setter Property="..." Value="..."/> in a Style */
+static void text_style_setter( struct writer *w, struct style *style, struct xml_node *node )
+{
+    const WCHAR *property = xml_attr_value( node, NULL, L"Property" ), *str = xml_attr_value( node, NULL, L"Value" );
+    struct style_setter *setter;
+    struct xvalue value = {0};
+    struct xprop prop;
+    WCHAR arg[128];
+    enum extension ext;
+    UINT32 i;
+
+    if (wcscmp( node->name, L"Setter" ) || !property)
+    {
+        FIXME( "%s in a Style is not supported.\n", debugstr_w(node->name) );
+        return;
+    }
+    text_prop( &prop, style->target, property );
+    if (w->defer_resources && str && ((ext = text_extension( str, arg, ARRAY_SIZE(arg) )) == EXT_STATIC_RESOURCE || ext == EXT_THEME_RESOURCE))
+    {
+        /* looked up when the style is applied, where the app's resources can override it */
+        value.kind = XV_NULL;
+        style_add_setter( style, &prop, &value );
+        for (i = 0; i < style->count; i++)
+        {
+            setter = &style->setters[i];
+            if (!wcscmp( setter->prop.name, prop.name )) setter->resource = wcsdup( arg );
+        }
+        return;
+    }
+    if (str && !text_value( w, str, &value )) return;
+    for (i = 0; !str && i < node->child_count; i++)
+    {
+        struct xml_node *child = node->children[i];
+        if (wcscmp( child->name, L"Setter.Value" )) continue;
+        if (child->child_count) text_element( w, child->children[0], &value );
+        else if (child->text) { value.kind = XV_STRING; value.s = wcsdup( child->text ); }
+    }
+    if (!value.kind || (value.kind == XV_OBJECT && !value.object))
+    {
+        xvalue_clear( &value );
+        return;
+    }
+    style_add_setter( style, &prop, &value );
+}
+
+/* the collection a content or property element adds to, or NULL for a single value */
+static BOOL is_collection_property( IInspectable *target, const WCHAR *name )
+{
+    static const WCHAR *names[] =
+    {
+        L"Children", L"RowDefinitions", L"ColumnDefinitions", L"VisualStateGroups", L"MergedDictionaries", L"States",
+        L"KeyFrames", L"Setters", L"Items",
+    };
+    UINT32 i;
+
+    for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcscmp( name, names[i] )) return TRUE;
+    return FALSE;
+}
+
+static void text_set_children( struct writer *w, IInspectable *target, const struct xprop *prop,
+                               struct xml_node **children, UINT32 count, const WCHAR *text )
+{
+    IInspectable *collection;
+    struct xvalue value;
+    UINT32 i;
+
+    if (prop_is( prop, L"Resources" ) && !(count == 1 && !wcscmp( children[0]->name, L"ResourceDictionary" )))
+    {
+        if (!(collection = get_property( target, prop ))) return;
+        IInspectable_AddRef( collection );
+        push_object( w, collection );
+        for (i = 0; i < count; i++) text_add_resource( w, collection, children[i] );
+        pop( w, &value );
+        xvalue_clear( &value );
+        IInspectable_Release( collection );
+        return;
+    }
+    if (prop_is( prop, L"ThemeDictionaries" ))
+    {
+        if (!(collection = get_property( target, prop ))) return;
+        for (i = 0; i < count; i++) text_add_resource( w, collection, children[i] );
+        IInspectable_Release( collection );
+        return;
+    }
+    if (is_collection_property( target, prop->name ))
+    {
+        if (!(collection = get_property( target, prop ))) return;
+        for (i = 0; i < count; i++)
+        {
+            text_element( w, children[i], &value );
+            add_to_collection( collection, &value );
+            xvalue_clear( &value );
+        }
+        IInspectable_Release( collection );
+        return;
+    }
+    memset( &value, 0, sizeof(value) );
+    if (count) text_element( w, children[0], &value );
+    else if (text) { value.kind = XV_STRING; value.s = wcsdup( text ); }
+    if (count > 1) FIXME( "%s takes one value, ignoring %u more.\n", debugstr_w(prop->name), count - 1 );
+    if (value.kind) set_property( w, target, prop, &value, SET_LOCAL );
+    xvalue_clear( &value );
+}
+
+/* the content property children without a property element go to */
+static BOOL content_property( IInspectable *object, const WCHAR *type, struct xprop *prop )
+{
+    struct bag *bag = bag_from_object( object );
+    IInspectable *iface;
+    const WCHAR *name = NULL;
+
+    if (bag)
+    {
+        if (!wcscmp( bag->type, L"VisualStateGroup" )) name = L"States";
+        else if (!wcscmp( bag->type, L"VisualState" )) name = L"Storyboard";
+        else if (!wcscmp( bag->type, L"Storyboard" )) name = L"Children";
+        else if (wcsstr( bag->type, L"UsingKeyFrames" )) name = L"KeyFrames";
+        else if (!wcscmp( bag->type, L"Collection" )) name = L"Items";
+    }
+    else if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IPanel, (void **)&iface ))) name = L"Children";
+    else if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IBorder, (void **)&iface ))) name = L"Child";
+    else if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_ITextBlock, (void **)&iface ))) name = L"Text";
+    else if (SUCCEEDED(IInspectable_QueryInterface( object, &IID_IContentControl, (void **)&iface )) ||
+             SUCCEEDED(IInspectable_QueryInterface( object, &IID_IUserControl, (void **)&iface )) ||
+             SUCCEEDED(IInspectable_QueryInterface( object, &IID_IContentPresenter, (void **)&iface ))) name = L"Content";
+    if (!bag && name) IInspectable_Release( iface );
+    if (!name) return FALSE;
+    text_prop( prop, type, name );
+    return TRUE;
+}
+
+/* a value-type element: <x:Double>, <x:String>, <Thickness>, <Color>, ... */
+static BOOL text_value_element( struct xml_node *node, struct xvalue *out )
+{
+    const WCHAR *text = node->text ? node->text : L"";
+    struct xvalue str = { XV_STRING };
+
+    memset( out, 0, sizeof(*out) );
+    str.s = (WCHAR *)text;
+    if (is_ns( node->ns, NS_XAML ))
+    {
+        if (!wcscmp( node->name, L"Null" )) out->kind = XV_NULL;
+        else if (!wcscmp( node->name, L"String" )) { out->kind = XV_STRING; out->s = wcsdup( text ); }
+        else if (!wcscmp( node->name, L"Double" )) { out->kind = XV_FLOAT; out->f = wcstod( text, NULL ); }
+        else if (!wcscmp( node->name, L"Int32" )) { out->kind = XV_SIGNED; out->i = wcstol( text, NULL, 10 ); }
+        else if (!wcscmp( node->name, L"Boolean" )) { out->kind = XV_BOOL; out->b = !wcsicmp( text, L"True" ); }
+        else FIXME( "x:%s is not supported.\n", debugstr_w(node->name) );
+        return TRUE;
+    }
+    if (!is_ns( node->ns, NS_PRESENTATION )) return FALSE;
+    if (!wcscmp( node->name, L"Thickness" ))
+    {
+        out->kind = XV_THICKNESS;
+        if (!to_thickness( &str, &out->thickness )) out->kind = XV_NONE;
+        return TRUE;
+    }
+    if (!wcscmp( node->name, L"Color" ))
+    {
+        Color c;
+        out->kind = XV_COLOR;
+        if (to_color( &str, &c )) out->color = c.A << 24 | c.R << 16 | c.G << 8 | c.B;
+        else out->kind = XV_NONE;
+        return TRUE;
+    }
+    if (!wcscmp( node->name, L"CornerRadius" ) || !wcscmp( node->name, L"GridLength" ) || !wcscmp( node->name, L"FontWeight" ))
+    {
+        out->kind = XV_STRING;
+        out->s = wcsdup( text );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void text_element( struct writer *w, struct xml_node *node, struct xvalue *out )
+{
+    struct xml_node **content = NULL;
+    IInspectable *object = NULL;
+    struct style *style;
+    struct xvalue value;
+    struct xprop prop;
+    UINT32 i, j, content_count = 0;
+    WCHAR full[256], arg[128];
+
+    memset( out, 0, sizeof(*out) );
+    if (text_value_element( node, out )) return;
+
+    if (w->root && !w->root_used)
+    {
+        w->root_used = TRUE;
+        IInspectable_AddRef( (object = w->root) );
+    }
+    else if (is_ns( node->ns, NS_PRESENTATION ))
+    {
+        if (!wcscmp( node->name, L"ControlTemplate" ))
+        {
+            struct control_template *template;
+            const WCHAR *target = xml_attr_value( node, NULL, L"TargetType" );
+
+            if (!(object = control_template_create())) return;
+            template = template_from_object( object );
+            if (target) lstrcpynW( template->target, wcschr( target, ':' ) ? wcschr( target, ':' ) + 1 : target, 96 );
+            if (w->doc)
+            {
+                xml_doc_addref( (template->doc = w->doc) );
+                template->node = node;
+                template->has_content = TRUE;
+            }
+            out->kind = XV_OBJECT;
+            out->object = object;
+            return;
+        }
+        if (!wcscmp( node->name, L"Style" )) object = style_create();
+        else object = create_builtin( node->name );
+    }
+    else if (node->ns && !wcsncmp( node->ns, L"using:", 6 ))
+    {
+        swprintf( full, ARRAY_SIZE(full), L"%s.%s", node->ns + 6, node->name );
+        object = app_create_instance( full );
+    }
+    else FIXME( "element %s in namespace %s is not supported.\n", debugstr_w(node->name), debugstr_w(node->ns) );
+    if (!object) return;
+
+    IInspectable_AddRef( object );
+    push_object( w, object );
+    style = style_from_object( object );
+
+    /* attributes */
+    for (i = 0; i < node->attr_count; i++)
+    {
+        struct xml_attr *a = &node->attrs[i];
+
+        if (a->ns)
+        {
+            if (!is_ns( a->ns, NS_XAML )) continue;   /* mc:, d: and other design-time attributes */
+            if (!wcscmp( a->name, L"Name" ))
+            {
+                register_name( w, a->value, object );
+                value.kind = XV_STRING;
+                value.s = wcsdup( a->value );
+                text_prop( &prop, L"FrameworkElement", L"Name" );
+                set_property( w, object, &prop, &value, SET_LOCAL );
+                xvalue_clear( &value );
+            }
+            else if (wcscmp( a->name, L"Key" ) && wcscmp( a->name, L"Class" ))
+                FIXME( "x:%s is not supported.\n", debugstr_w(a->name) );
+            continue;
+        }
+        if (style && !wcscmp( a->name, L"TargetType" ))
+        {
+            style_set_target( style, wcschr( a->value, ':' ) ? wcschr( a->value, ':' ) + 1 : a->value );
+            continue;
+        }
+        for (j = 0; j < ARRAY_SIZE(event_names); j++) if (!wcscmp( a->name, event_names[j] )) break;
+        if (j < ARRAY_SIZE(event_names) && a->value[0] != '{')
+        {
+            FIXME( "event handler %s=%s in text markup is ignored.\n", debugstr_w(a->name), debugstr_w(a->value) );
+            continue;
+        }
+        text_prop( &prop, node->name, a->name );
+        if (text_extension( a->value, arg, ARRAY_SIZE(arg) ) == EXT_TEMPLATE_BINDING)
+        {
+            if (w->templated_parent) template_bind( w, object, &prop, arg );
+            continue;
+        }
+        if (!text_value( w, a->value, &value )) continue;
+        set_property( w, object, &prop, &value, SET_LOCAL );
+        xvalue_clear( &value );
+    }
+
+    /* property elements, and content */
+    for (i = 0; i < node->child_count; i++)
+    {
+        struct xml_node *child = node->children[i];
+        struct xml_node **tmp;
+
+        if (is_property_element( child ))
+        {
+            text_prop( &prop, NULL, child->name );
+            if (style && prop_is( &prop, L"Setters" ))
+            {
+                for (j = 0; j < child->child_count; j++) text_style_setter( w, style, child->children[j] );
+                continue;
+            }
+            if (!wcscmp( child->name, L"ControlTemplate.TargetType" )) continue;
+            text_set_children( w, object, &prop, child->children, child->child_count, child->text );
+            continue;
+        }
+        if (style)
+        {
+            text_style_setter( w, style, child );
+            continue;
+        }
+        if (!(tmp = realloc( content, (content_count + 1) * sizeof(*content) ))) continue;
+        content = tmp;
+        content[content_count++] = child;
+    }
+    if (content_count || (node->text && !style))
+    {
+        IResourceDictionary *dict;
+
+        if (QI( object, IResourceDictionary, &dict ))
+        {
+            IResourceDictionary_Release( dict );
+            for (i = 0; i < content_count; i++) text_add_resource( w, object, content[i] );
+        }
+        else if (content_property( object, node->name, &prop ))
+            text_set_children( w, object, &prop, content, content_count, node->text );
+        else FIXME( "%s has no content property we know.\n", debugstr_w(node->name) );
+    }
+    free( content );
+
+    finish_object( w, object );
+    pop( w, &value );
+    xvalue_clear( &value );
+    out->kind = XV_OBJECT;
+    out->object = object;
+}
+
+/* XAML text into objects; with root, the markup's root element is root (LoadComponent) */
+static HRESULT text_load( const WCHAR *text, SIZE_T len, IInspectable *root, BOOL generic, IInspectable **out )
+{
+    struct xml_doc *doc;
+    struct xvalue value;
+    struct writer *w;
+    HRESULT hr;
+    UINT32 i;
+
+    if (out) *out = NULL;
+    if (FAILED(hr = xml_parse( text, len, &doc ))) return hr;
+    if (!(w = calloc( 1, sizeof(*w) )))
+    {
+        xml_doc_release( doc );
+        return E_OUTOFMEMORY;
+    }
+    w->doc = doc;
+    w->root = root;
+    w->names_owner = w;
+    w->defer_resources = generic;
+    text_element( w, doc->root, &value );
+    if (value.kind != XV_OBJECT || !value.object) hr = E_FAIL;
+    else if (out)
+    {
+        *out = value.object;
+        value.object = NULL;
+    }
+    xvalue_clear( &value );
+    while (w->sp) { pop( w, &value ); xvalue_clear( &value ); }
+    for (i = 0; i < w->name_count; i++) IInspectable_Release( w->names[i].object );
+    free( w->names );
+    free( w );
+    xml_doc_release( doc );
+    return hr;
+}
+
+HRESULT xaml_text_load( const WCHAR *text, SIZE_T len, IInspectable *root, IInspectable **out )
+{
+    return text_load( text, len, root, FALSE, out );
+}
+
+/* the built-in theme resources and default styles: generic.xaml, a resource of this DLL */
+static IInspectable *generic_dictionary;
+static BOOL generic_loading;
+
+static IInspectable *generic_resources(void)
+{
+    HMODULE module;
+    HRSRC rsrc;
+    const char *data;
+    WCHAR *text;
+    DWORD size;
+    int len;
+
+    if (generic_dictionary || generic_loading) return generic_dictionary;
+    generic_loading = TRUE;
+    if (GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                            (const WCHAR *)generic_resources, &module ) &&
+        (rsrc = FindResourceW( module, L"GENERIC_XAML", (const WCHAR *)RT_RCDATA )) &&
+        (data = LockResource( LoadResource( module, rsrc ) )) && (size = SizeofResource( module, rsrc )))
+    {
+        len = MultiByteToWideChar( CP_UTF8, 0, data, size, NULL, 0 );
+        if ((text = malloc( len * sizeof(WCHAR) )))
+        {
+            MultiByteToWideChar( CP_UTF8, 0, data, size, text, len );
+            if (FAILED(text_load( text, len, NULL, TRUE, &generic_dictionary ))) ERR( "generic.xaml failed to load.\n" );
+            else TRACE( "loaded generic.xaml.\n" );
+            free( text );
+        }
+    }
+    else ERR( "generic.xaml resource not found.\n" );
+    generic_loading = FALSE;
+    return generic_dictionary;
+}
+
+IInspectable *generic_resource_lookup( const WCHAR *key )
+{
+    IInspectable *dict = generic_resources();
+    return dict ? resource_dictionary_lookup( dict, key ) : NULL;
+}
