+static HRESULT WINAPI file_io_factory_QueryInterface(IActivationFactory *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    if (IsEqualGUID(iid, &IID_IFileIOStatics))
+    {
+        *out = &file_io_statics;
+        return S_OK;
+    }
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI file_io_factory_AddRef(IActivationFactory *iface) { return 2; }
+static ULONG WINAPI file_io_factory_Release(IActivationFactory *iface) { return 1; }
+static HRESULT WINAPI file_io_factory_GetIids(IActivationFactory *iface, ULONG *count, IID **iids) { return E_NOTIMPL; }
+static HRESULT WINAPI file_io_factory_GetRuntimeClassName(IActivationFactory *iface, HSTRING *name) { return E_NOTIMPL; }
+static HRESULT WINAPI file_io_factory_GetTrustLevel(IActivationFactory *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+static HRESULT WINAPI file_io_factory_ActivateInstance(IActivationFactory *iface, IInspectable **instance) { return E_NOTIMPL; }
