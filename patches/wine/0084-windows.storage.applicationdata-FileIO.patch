+/* ===== Windows.Storage.FileIO: whole-file reads and writes, done synchronously ===== */
+
+static HRESULT read_file(IStorageFile *file, BYTE **data, DWORD *size)
+{
+    WCHAR path[MAX_PATH];
+    LARGE_INTEGER length;
+    HANDLE handle;
+    HRESULT hr = S_OK;
+
+    *data = NULL;
+    *size = 0;
+    if (FAILED(hr = item_path(file, path))) return hr;
+    handle = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (handle == INVALID_HANDLE_VALUE) return last_error();
+    if (!GetFileSizeEx(handle, &length)) hr = last_error();
+    else if (length.QuadPart > 0x7fffffff) hr = E_OUTOFMEMORY;
+    else if (!(*data = malloc(length.QuadPart + 2))) hr = E_OUTOFMEMORY;
+    else if (!ReadFile(handle, *data, length.LowPart, size, NULL)) hr = last_error();
+    CloseHandle(handle);
+    if (FAILED(hr))
+    {
+        free(*data);
+        *data = NULL;
+    }
+    return hr;
+}
+
+static HRESULT write_file(IStorageFile *file, const void *data, DWORD size, BOOL append)
+{
+    WCHAR path[MAX_PATH];
+    HANDLE handle;
+    DWORD written;
+    HRESULT hr = S_OK;
+
+    if (FAILED(hr = item_path(file, path))) return hr;
+    handle = CreateFileW(path, append ? FILE_APPEND_DATA : GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL,
+                         append ? OPEN_ALWAYS : CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (handle == INVALID_HANDLE_VALUE) return last_error();
+    if (size && !WriteFile(handle, data, size, &written, NULL)) hr = last_error();
+    CloseHandle(handle);
+    return hr;
+}
+
+/* text in a file: a byte order mark decides the encoding, otherwise the one given (UTF-8 by default) */
+static HRESULT decode_text(BYTE *data, DWORD size, int encoding, HSTRING *out)
+{
+    HSTRING_BUFFER buffer;
+    WCHAR *str;
+    DWORD i, count;
+    HRESULT hr;
+
+    if (size >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf) { data += 3; size -= 3; encoding = UnicodeEncoding_Utf8; }
+    else if (size >= 2 && data[0] == 0xff && data[1] == 0xfe) { data += 2; size -= 2; encoding = UnicodeEncoding_Utf16LE; }
+    else if (size >= 2 && data[0] == 0xfe && data[1] == 0xff) { data += 2; size -= 2; encoding = UnicodeEncoding_Utf16BE; }
+
+    if (!size) return WindowsCreateString(NULL, 0, out);
+    if (encoding == UnicodeEncoding_Utf8)
+    {
+        if (!(count = MultiByteToWideChar(CP_UTF8, 0, (char *)data, size, NULL, 0))) return HRESULT_FROM_WIN32(ERROR_NO_UNICODE_TRANSLATION);
+        if (FAILED(hr = WindowsPreallocateStringBuffer(count, &str, &buffer))) return hr;
+        MultiByteToWideChar(CP_UTF8, 0, (char *)data, size, str, count);
+    }
+    else
+    {
+        count = size / 2;
+        if (FAILED(hr = WindowsPreallocateStringBuffer(count, &str, &buffer))) return hr;
+        for (i = 0; i < count; i++)
+            str[i] = encoding == UnicodeEncoding_Utf16LE ? data[2 * i] | data[2 * i + 1] << 8 : data[2 * i] << 8 | data[2 * i + 1];
+    }
+    return WindowsPromoteStringBuffer(buffer, out);
+}
+
+/* the bytes for some text: UTF-8 without a byte order mark, UTF-16 with one unless appending */
+static HRESULT encode_text(const WCHAR *str, UINT32 length, int encoding, BOOL mark, BYTE **data, DWORD *size)
+{
+    DWORD i, count;
+
+    *data = NULL;
+    *size = 0;
+    if (encoding == UnicodeEncoding_Utf8)
+    {
+        count = length ? WideCharToMultiByte(CP_UTF8, 0, str, length, NULL, 0, NULL, NULL) : 0;
+        if (!(*data = malloc(count + 1))) return E_OUTOFMEMORY;
+        if (count) WideCharToMultiByte(CP_UTF8, 0, str, length, (char *)*data, count, NULL, NULL);
+        *size = count;
+        return S_OK;
+    }
+    if (!(*data = malloc(length * 2 + 2))) return E_OUTOFMEMORY;
+    if (mark)
+    {
+        (*data)[0] = encoding == UnicodeEncoding_Utf16LE ? 0xff : 0xfe;
+        (*data)[1] = encoding == UnicodeEncoding_Utf16LE ? 0xfe : 0xff;
+        *size = 2;
+    }
+    for (i = 0; i < length; i++, *size += 2)
+    {
+        BYTE low = str[i] & 0xff, high = str[i] >> 8;
+        (*data)[*size] = encoding == UnicodeEncoding_Utf16LE ? low : high;
+        (*data)[*size + 1] = encoding == UnicodeEncoding_Utf16LE ? high : low;
+    }
+    return S_OK;
+}
+
+static HRESULT read_text_op(IStorageFile *file, int encoding, IAsyncOperation_HSTRING **operation)
+{
+    struct done_op *op;
+    HSTRING text = NULL;
+    DWORD size;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!file || !operation) return E_POINTER;
+    if (SUCCEEDED(hr = read_file(file, &data, &size)))
+    {
+        hr = decode_text(data, size, encoding, &text);
+        free(data);
+    }
+    if (FAILED(done_create(DONE_OPERATION, &IID_IAsyncOperation_HSTRING, hr, NULL, NULL, 0, (void **)&op)))
+    {
+        WindowsDeleteString(text);
+        return E_OUTOFMEMORY;
+    }
+    op->string = text;
+    op->has_string = TRUE;
+    *operation = (IAsyncOperation_HSTRING *)op;
+    return S_OK;
+}
+
+static HRESULT write_text_op(IStorageFile *file, HSTRING contents, int encoding, BOOL append, IAsyncAction **operation)
+{
+    UINT32 length;
+    const WCHAR *str = WindowsGetStringRawBuffer(contents, &length);
+    DWORD size;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!file || !operation) return E_POINTER;
+    if (SUCCEEDED(hr = encode_text(str, length, encoding, !append, &data, &size)))
+    {
+        hr = write_file(file, data, size, append);
+        free(data);
+    }
+    return done_action(hr, operation);
+}
+
+static HRESULT write_lines_op(IStorageFile *file, IIterable_HSTRING *lines, int encoding, BOOL append, IAsyncAction **operation)
+{
+    IIterator_HSTRING *iterator;
+    WCHAR *text = NULL, *grown;
+    SIZE_T length = 0, capacity = 0;
+    boolean more = FALSE;
+    DWORD size;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!file || !lines || !operation) return E_POINTER;
+    if (FAILED(hr = IIterable_HSTRING_First(lines, &iterator))) return done_action(hr, operation);
+    IIterator_HSTRING_get_HasCurrent(iterator, &more);
+    while (more && SUCCEEDED(hr))
+    {
+        HSTRING line;
+        UINT32 line_length;
+        const WCHAR *str;
+
+        if (FAILED(hr = IIterator_HSTRING_get_Current(iterator, &line))) break;
+        str = WindowsGetStringRawBuffer(line, &line_length);
+        if (length + line_length + 2 > capacity)
+        {
+            capacity = max(capacity * 2, length + line_length + 64);
+            if (!(grown = realloc(text, capacity * sizeof(WCHAR)))) hr = E_OUTOFMEMORY;
+            else text = grown;
+        }
+        if (SUCCEEDED(hr))
+        {
+            memcpy(text + length, str, line_length * sizeof(WCHAR));
+            length += line_length;
+            text[length++] = '\r';
+            text[length++] = '\n';
+        }
+        WindowsDeleteString(line);
+        if (SUCCEEDED(hr)) hr = IIterator_HSTRING_MoveNext(iterator, &more);
+    }
+    IIterator_HSTRING_Release(iterator);
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = encode_text(text ? text : L"", length, encoding, !append, &data, &size)))
+    {
+        hr = write_file(file, data, size, append);
+        free(data);
+    }
+    free(text);
+    return done_action(hr, operation);
+}
+
+static HRESULT WINAPI file_io_ReadTextAsync(IFileIOStatics *iface, IStorageFile *file, IAsyncOperation_HSTRING **value)
+{
+    TRACE("iface %p, file %p, value %p.\n", iface, file, value);
+    return read_text_op(file, UnicodeEncoding_Utf8, value);
+}
