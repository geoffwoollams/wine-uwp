+static HRESULT create_buffer(const BYTE *data, DWORD size, IBuffer **out)
+{
+    static const WCHAR class_name[] = L"Windows.Storage.Streams.Buffer";
+    IBufferFactory *factory;
+    HSTRING str;
+    BYTE *bytes;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = WindowsCreateString(class_name, ARRAY_SIZE(class_name) - 1, &str))) return hr;
+    hr = RoGetActivationFactory(str, &IID_IBufferFactory, (void **)&factory);
+    WindowsDeleteString(str);
+    if (FAILED(hr)) return hr;
+    hr = IBufferFactory_Create(factory, size, out);
+    IBufferFactory_Release(factory);
+    if (FAILED(hr)) return hr;
+    if (size)
+    {
+        IBuffer_put_Length(*out, size);
+        if ((bytes = buffer_bytes(*out))) memcpy(bytes, data, size);
+        else
+        {
+            IBuffer_Release(*out);
+            *out = NULL;
+            return E_FAIL;
+        }
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI file_io_ReadBufferAsync(IFileIOStatics *iface, IStorageFile *file, IAsyncOperation_IBuffer **value)
+{
+    IBuffer *buffer = NULL;
+    DWORD size;
+    BYTE *data;
+    HRESULT hr;
+
+    TRACE("iface %p, file %p, value %p.\n", iface, file, value);
+    if (!file || !value) return E_POINTER;
+    if (SUCCEEDED(hr = read_file(file, &data, &size)))
+    {
+        hr = create_buffer(data, size, &buffer);
+        free(data);
+    }
+    return done_create(DONE_OPERATION, &IID_IAsyncOperation_IBuffer, hr, (IUnknown *)buffer, NULL, 0, (void **)value);
+}
+static HRESULT WINAPI file_io_WriteBufferAsync(IFileIOStatics *iface, IStorageFile *file, IBuffer *buffer, IAsyncAction **value)
+{
+    UINT32 length = 0;
+    BYTE *bytes = NULL;
+    HRESULT hr;
+
+    TRACE("iface %p, file %p, buffer %p, value %p.\n", iface, file, buffer, value);
+    if (!file || !buffer || !value) return E_POINTER;
+    IBuffer_get_Length(buffer, &length);
+    if (length && !(bytes = buffer_bytes(buffer))) hr = E_INVALIDARG;
+    else hr = write_file(file, bytes, length, FALSE);
+    return done_action(hr, value);
+}
+static HRESULT WINAPI file_io_WriteBytesAsync(IFileIOStatics *iface, IStorageFile *file, UINT32 size, BYTE *buffer, IAsyncAction **value)
+{
+    TRACE("iface %p, file %p, size %u, buffer %p, value %p.\n", iface, file, size, buffer, value);
+    if (!file || !value || (size && !buffer)) return E_POINTER;
+    return done_action(write_file(file, buffer, size, FALSE), value);
+}
