+#include "private.h"
+#include "provider.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(input);
+
+/* On Windows, Xbox controllers attached by USB are GIP (Gaming Input Protocol) devices, driven by xboxgip.sys, and
+ * apps' custom controller factories registered for a GIP interface get them as GipGameControllerProviders. Here
+ * the host's own driver (Linux's xpad) drives the controller and Wine sees it as a HID gamepad, so a controller
+ * that is a GIP device on Windows is wrapped in a GIP provider that answers for the interfaces every gamepad
+ * declares ([MS-GIPUSB]: IController, IGamepad, INavigationController).
+ *
+ * Nothing is ever sent to the controller through it. SendMessage and SendReceiveMessage log the message and
+ * fail with E_ACCESSDENIED; UpdateFirmwareAsync fails at once. Sending GIP messages (settings, and above all
+ * firmware) needs the controller's real protocol traffic, recorded on Windows, and its own review. */
+
+/* Microsoft's controllers that are GIP devices over USB (on Bluetooth they are HID devices instead) */
+static const UINT16 gip_usb_products[] =
+{
+    0x02d1,   /* Xbox One Controller */
+    0x02dd,   /* Xbox One Controller (firmware 2015) */
+    0x02e3,   /* Xbox One Elite Controller */
+    0x02ea,   /* Xbox One S Controller */
+    0x0b00,   /* Xbox Elite Series 2 Controller */
+    0x0b0a,   /* Xbox Adaptive Controller */
+    0x0b12,   /* Xbox Series X|S Controller */
+};
+
+/* the interfaces a standard GIP gamepad declares, most specific first ([MS-GIPUSB] GIP Metadata Exchange) */
+static const GUID gip_gamepad_interfaces[] =
+{
+    {0x082e402c, 0x07df, 0x45e1, {0xa5, 0xab, 0xa3, 0x12, 0x7a, 0xf1, 0x97, 0xb5}},   /* IGamepad */
+    {0xb8f31fe7, 0x7386, 0x40e9, {0xa9, 0xf8, 0x2f, 0x21, 0x26, 0x3a, 0xcf, 0xb7}},   /* INavigationController */
+    {0x9776ff56, 0x9bfd, 0x4581, {0xad, 0x45, 0xb6, 0x45, 0xbb, 0xa5, 0x26, 0xd6}},   /* IController */
+};
+
+BOOL gip_is_device( IGameControllerProvider *provider )
+{
+    UINT16 vendor = 0, product = 0;
+    UINT32 i;
+
+    if (FAILED(IGameControllerProvider_get_HardwareVendorId( provider, &vendor )) || vendor != 0x045e) return FALSE;
+    if (FAILED(IGameControllerProvider_get_HardwareProductId( provider, &product ))) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(gip_usb_products); i++) if (gip_usb_products[i] == product) return TRUE;
+    return FALSE;
+}
+
+BOOL gip_supports_interface( const GUID *interface_id )
+{
+    UINT32 i;
+    for (i = 0; i < ARRAY_SIZE(gip_gamepad_interfaces); i++)
+        if (IsEqualGUID( &gip_gamepad_interfaces[i], interface_id )) return TRUE;
+    return FALSE;
+}
+
+struct gip_provider
+{
+    IGipGameControllerProvider IGipGameControllerProvider_iface;
+    IGameControllerProvider IGameControllerProvider_iface;
+    LONG ref;
+    IGameControllerProvider *device;   /* the Wine provider for the same controller */
+};
+
+static inline struct gip_provider *impl_from_IGipGameControllerProvider( IGipGameControllerProvider *iface )
+{
+    return CONTAINING_RECORD( iface, struct gip_provider, IGipGameControllerProvider_iface );
+}
+
+static HRESULT WINAPI gip_QueryInterface( IGipGameControllerProvider *iface, REFIID iid, void **out )
+{
+    struct gip_provider *impl = impl_from_IGipGameControllerProvider( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IGipGameControllerProvider ))
+    {
+        IInspectable_AddRef( (*out = &impl->IGipGameControllerProvider_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IGameControllerProvider ))
+    {
+        IInspectable_AddRef( (*out = &impl->IGameControllerProvider_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI gip_AddRef( IGipGameControllerProvider *iface )
+{
+    return InterlockedIncrement( &impl_from_IGipGameControllerProvider( iface )->ref );
+}
+
+static ULONG WINAPI gip_Release( IGipGameControllerProvider *iface )
+{
+    struct gip_provider *impl = impl_from_IGipGameControllerProvider( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IGameControllerProvider_Release( impl->device );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI gip_GetIids( IGipGameControllerProvider *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI gip_GetRuntimeClassName( IGipGameControllerProvider *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_Gaming_Input_Custom_GipGameControllerProvider;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI gip_GetTrustLevel( IGipGameControllerProvider *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static void log_message( const char *what, GipMessageClass message_class, BYTE message_id, UINT32 size, const BYTE *data )
+{
+    char hex[3 * 64 + 4];
+    UINT32 i, len = 0;
+
+    for (i = 0; i < size && i < 64; i++) len += sprintf( hex + len, "%02x ", data[i] );
+    if (size > 64) strcpy( hex + len, "..." );
+    else hex[len] = 0;
+    FIXME( "%s blocked: class %d, message %#x, %u bytes: %s\n", what, message_class, message_id, size, hex );
+}
+
+static HRESULT WINAPI gip_SendMessage( IGipGameControllerProvider *iface, GipMessageClass message_class, BYTE message_id,
+                                       UINT32 size, BYTE *buffer )
+{
+    TRACE( "iface %p.\n", iface );
+    log_message( "SendMessage", message_class, message_id, size, buffer );
+    return E_ACCESSDENIED;
+}
+
+static HRESULT WINAPI gip_SendReceiveMessage( IGipGameControllerProvider *iface, GipMessageClass message_class,
+                                              BYTE message_id, UINT32 request_size, BYTE *request,
+                                              UINT32 response_size, BYTE *response )
+{
+    TRACE( "iface %p, response_size %u.\n", iface, response_size );
+    log_message( "SendReceiveMessage", message_class, message_id, request_size, request );
+    if (response && response_size) memset( response, 0, response_size );
+    return E_ACCESSDENIED;
+}
+
+static HRESULT WINAPI gip_UpdateFirmwareAsync( IGipGameControllerProvider *iface, __x_ABI_CWindows_CStorage_CStreams_CIInputStream *image,
+                                               IAsyncOperationWithProgress_GipFirmwareUpdateResult_GipFirmwareUpdateProgress **value )
+{
+    FIXME( "iface %p, image %p: firmware updates are disabled; nothing is sent to the controller.\n", iface, image );
+    if (value) *value = NULL;
+    return E_ACCESSDENIED;
+}
+
+static const struct IGipGameControllerProviderVtbl gip_vtbl =
+{
+    gip_QueryInterface,
+    gip_AddRef,
+    gip_Release,
+    /* IInspectable methods */
+    gip_GetIids,
+    gip_GetRuntimeClassName,
+    gip_GetTrustLevel,
+    /* IGipGameControllerProvider methods */
+    gip_SendMessage,
+    gip_SendReceiveMessage,
+    gip_UpdateFirmwareAsync,
+};
+
+/* IGameControllerProvider: the controller's ids and versions, from the Wine provider */
+
+DEFINE_IINSPECTABLE( gip_game, IGameControllerProvider, struct gip_provider, IGipGameControllerProvider_iface )
+
+static HRESULT WINAPI gip_game_get_FirmwareVersionInfo( IGameControllerProvider *iface, GameControllerVersionInfo *value )
+{
+    return IGameControllerProvider_get_FirmwareVersionInfo( impl_from_IGameControllerProvider( iface )->device, value );
+}
+
+static HRESULT WINAPI gip_game_get_HardwareProductId( IGameControllerProvider *iface, UINT16 *value )
+{
+    return IGameControllerProvider_get_HardwareProductId( impl_from_IGameControllerProvider( iface )->device, value );
+}
+
+static HRESULT WINAPI gip_game_get_HardwareVendorId( IGameControllerProvider *iface, UINT16 *value )
+{
+    return IGameControllerProvider_get_HardwareVendorId( impl_from_IGameControllerProvider( iface )->device, value );
+}
+
+static HRESULT WINAPI gip_game_get_HardwareVersionInfo( IGameControllerProvider *iface, GameControllerVersionInfo *value )
+{
+    return IGameControllerProvider_get_HardwareVersionInfo( impl_from_IGameControllerProvider( iface )->device, value );
+}
+
+static HRESULT WINAPI gip_game_get_IsConnected( IGameControllerProvider *iface, boolean *value )
+{
+    return IGameControllerProvider_get_IsConnected( impl_from_IGameControllerProvider( iface )->device, value );
+}
+
+static const struct IGameControllerProviderVtbl gip_game_vtbl =
+{
+    gip_game_QueryInterface,
+    gip_game_AddRef,
+    gip_game_Release,
+    /* IInspectable methods */
+    gip_game_GetIids,
+    gip_game_GetRuntimeClassName,
+    gip_game_GetTrustLevel,
+    /* IGameControllerProvider methods */
+    gip_game_get_FirmwareVersionInfo,
+    gip_game_get_HardwareProductId,
+    gip_game_get_HardwareVendorId,
+    gip_game_get_HardwareVersionInfo,
+    gip_game_get_IsConnected,
+};
+
+/* A GIP device's provider id on Windows is its 64-bit GIP device id in hex (from its Hello message), and apps
+ * parse it as a number. The host's driver doesn't pass the Hello message on, so the id here is a 64-bit FNV-1a
+ * hash of the controller's device id (its NonRoamableId): the same while it stays attached where it is. */
+HRESULT gip_provider_id( IGameControllerProvider *provider, HSTRING *value )
+{
+    IWineGameControllerProvider *wine_provider;
+    struct gip_provider *impl;
+    UINT64 hash = 0xcbf29ce484222325ull;
+    WCHAR buffer[17];
+    HSTRING id = NULL;
+    const WCHAR *str;
+    UINT32 len, i;
+
+    if (!provider || provider->lpVtbl != &gip_game_vtbl) return E_INVALIDARG;
+    impl = impl_from_IGameControllerProvider( provider );
+    if (FAILED(IGameControllerProvider_QueryInterface( impl->device, &IID_IWineGameControllerProvider,
+                                                       (void **)&wine_provider ))) return E_FAIL;
+    IWineGameControllerProvider_get_NonRoamableId( wine_provider, &id );
+    IWineGameControllerProvider_Release( wine_provider );
+    str = WindowsGetStringRawBuffer( id, &len );
+    for (i = 0; i < len; i++)
+    {
+        hash ^= towupper( str[i] );
+        hash *= 0x100000001b3ull;
+    }
+    WindowsDeleteString( id );
+    swprintf( buffer, ARRAY_SIZE(buffer), L"%016I64X", hash );
+    return WindowsCreateString( buffer, 16, value );
+}
+
+/* the Wine provider behind one of our GIP providers (referenced), or NULL for any other provider */
+IGameControllerProvider *gip_provider_device( IGameControllerProvider *provider )
+{
+    struct gip_provider *impl;
+
+    if (!provider || provider->lpVtbl != &gip_game_vtbl) return NULL;
+    impl = impl_from_IGameControllerProvider( provider );
+    IGameControllerProvider_AddRef( impl->device );
+    return impl->device;
+}
+
+HRESULT gip_provider_create( IGameControllerProvider *device, IGameControllerProvider **out )
+{
+    struct gip_provider *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IGipGameControllerProvider_iface.lpVtbl = &gip_vtbl;
+    impl->IGameControllerProvider_iface.lpVtbl = &gip_game_vtbl;
+    impl->ref = 1;
+    IGameControllerProvider_AddRef( (impl->device = device) );
+    *out = &impl->IGameControllerProvider_iface;
+    TRACE( "created GIP provider %p for %p.\n", impl, device );
+    return S_OK;
+}
