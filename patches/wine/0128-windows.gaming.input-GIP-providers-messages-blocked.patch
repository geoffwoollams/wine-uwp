@@ -26,10 +26,243 @@
 WINE_DEFAULT_DEBUG_CHANNEL(input);
 
 /* On Windows, LegacyGipGameControllerProvider is the Xbox accessory management interface of the GIP driver
- * (xboxgip.sys): battery, firmware state, button remapping, pilot/copilot pairing. Wine has no GIP driver; Xbox
- * controllers reach it through the host's driver as HID or SDL gamepads, so there is no GIP device to manage.
- * FromGameController and FromGameControllerProvider therefore return no provider (NULL, like Windows does for a
- * controller that isn't a GIP device), and nothing that would change a controller is ever sent. */
+ * (xboxgip.sys): battery, firmware state, button remapping, pilot/copilot pairing. Wine has no GIP driver: Xbox
+ * controllers reach it through the host's driver as HID gamepads. For a controller that is a GIP device on Windows
+ * (see gip.c), FromGameController and FromGameControllerProvider give a provider that answers what is known
+ * (its interfaces, that it is a real and uncorrupted device) and refuses everything that would change the
+ * controller (LED, remapping, reset, headset settings, pairing): nothing is ever sent to it. For other
+ * controllers they return no provider, as Windows does. */
+
+struct legacy_gip
+{
+    ILegacyGipGameControllerProvider ILegacyGipGameControllerProvider_iface;
+    LONG ref;
+    IGameControllerProvider *device;
+};
+
+static inline struct legacy_gip *impl_from_ILegacyGipGameControllerProvider( ILegacyGipGameControllerProvider *iface )
+{
+    return CONTAINING_RECORD( iface, struct legacy_gip, ILegacyGipGameControllerProvider_iface );
