+
+/* an app factory's controller for a GIP device, appended to the list (manager_cs held) */
+static struct controller *gip_controller_create( struct custom_registration *reg, IGameControllerProvider *device )
+{
+    IGameControllerProvider *gip;
+    struct controller *controller = NULL;
+
+    if (reg->kind != CUSTOM_GIP || !gip_supports_interface( &reg->interface_id )) return NULL;
+    if (FAILED(gip_provider_create( device, &gip ))) return NULL;
+    if (SUCCEEDED(controller_create_ex( reg->factory, gip, TRUE, &controller )))
+    {
+        controller->device = device;
+        list_add_tail( &controller_list, &controller->entry );
+        TRACE( "GIP controller %p for %s from factory %p.\n", controller, debugstr_guid( &reg->interface_id ), reg->factory );
+    }
+    IGameControllerProvider_Release( gip );
+    return controller;
+}
+
+/* the Wine provider behind a controller we made (referenced), or NULL */
+IGameControllerProvider *manager_get_device( IGameController *iface )
+{
+    IGameControllerProvider *device = NULL;
+    struct controller *controller;
+    IGameController *other;
+
+    EnterCriticalSection( &manager_cs );
+    LIST_FOR_EACH_ENTRY( controller, &controller_list, struct controller, entry )
+    {
+        /* the app may pass its own controller object (it aggregates ours) or ours */
+        if (&controller->IGameController_iface != iface)
+        {
+            if (FAILED(IGameController_QueryInterface( iface, &IID_IGameController, (void **)&other ))) continue;
+            IGameController_Release( other );
+            if (other != &controller->IGameController_iface) continue;
+        }
+        IGameControllerProvider_AddRef( (device = controller->device) );
+        break;
+    }
+    LeaveCriticalSection( &manager_cs );
+    return device;
+}
