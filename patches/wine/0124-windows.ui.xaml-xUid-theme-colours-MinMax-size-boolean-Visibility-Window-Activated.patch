+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "initguid.h"
+#define WIDL_using_Windows_ApplicationModel_Resources_Core
+#include "windows.applicationmodel.resources.core.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* An element with x:Uid="Name" takes the strings of the app's resources named Name.Property (in the Resources
+ * map of resources.pri: "Resources/Name/Property"). Our ResourceManager can't list a subtree, so each property
+ * that apps localize is looked up in turn; the language is the one ResourceManager chooses. */
+
+static IResourceMap *main_map;
+static BOOL main_map_failed;
+
+static IResourceMap *resource_map(void)
+{
+    static const WCHAR name[] = L"Windows.ApplicationModel.Resources.Core.ResourceManager";
+    IResourceManagerStatics *statics;
+    IResourceManager *manager;
+    HSTRING_HEADER header;
+    HSTRING class_name;
+
+    if (main_map || main_map_failed) return main_map;
+    main_map_failed = TRUE;
+    WindowsCreateStringReference( name, wcslen( name ), &header, &class_name );
+    if (FAILED(RoGetActivationFactory( class_name, &IID_IResourceManagerStatics, (void **)&statics ))) return NULL;
+    if (SUCCEEDED(IResourceManagerStatics_get_Current( statics, &manager )))
+    {
+        if (SUCCEEDED(IResourceManager_get_MainResourceMap( manager, &main_map ))) main_map_failed = FALSE;
+        IResourceManager_Release( manager );
+    }
+    IResourceManagerStatics_Release( statics );
+    return main_map;
+}
+
+/* the string for property of the element with x:Uid uid, or NULL */
+WCHAR *uid_string( const WCHAR *uid, const WCHAR *property )
+{
+    IResourceCandidate *candidate;
+    IResourceMap *map = resource_map();
+    HSTRING path, value = NULL;
+    WCHAR buffer[256], *ret = NULL;
+    HRESULT hr;
+
+    if (!map) return NULL;
+    swprintf( buffer, ARRAY_SIZE(buffer), L"Resources/%s/%s", uid, property );
+    if (FAILED(WindowsCreateString( buffer, wcslen( buffer ), &path ))) return NULL;
+    hr = IResourceMap_GetValue( map, path, &candidate );
+    WindowsDeleteString( path );
+    if (FAILED(hr)) return NULL;
+    if (SUCCEEDED(IResourceCandidate_get_ValueAsString( candidate, &value )))
+        ret = wcsdup( WindowsGetStringRawBuffer( value, NULL ) );
+    TRACE( "%s -> %s.\n", debugstr_w(buffer), debugstr_w(ret) );
+    WindowsDeleteString( value );
+    IResourceCandidate_Release( candidate );
+    return ret;
+}
