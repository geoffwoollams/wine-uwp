+    return S_OK;
+}
+
+static HRESULT WINAPI activated_core_args_put_Handled( ICoreWindowEventArgs *iface, boolean value )
+{
+    impl_from_ICoreWindowEventArgs( iface )->handled = value;
+    return S_OK;
+}
+
+static const struct ICoreWindowEventArgsVtbl activated_core_args_vtbl =
+{
+    activated_core_args_QueryInterface,
+    activated_core_args_AddRef,
+    activated_core_args_Release,
+    activated_core_args_GetIids,
+    activated_core_args_GetRuntimeClassName,
+    activated_core_args_GetTrustLevel,
+    activated_core_args_get_Handled,
+    activated_core_args_put_Handled,
