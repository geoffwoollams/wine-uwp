+/* Window.Activated: WindowActivatedEventArgs */
+
+#define WM_XAML_ACTIVATED (WM_APP + 0x5ea)   /* raise Activated after Activate() has returned */
+
+struct activated_args
+{
+    IWindowActivatedEventArgs IWindowActivatedEventArgs_iface;
+    ICoreWindowEventArgs ICoreWindowEventArgs_iface;
+    LONG ref;
+    CoreWindowActivationState state;
+    boolean handled;
+};
+
+static inline struct activated_args *impl_from_IWindowActivatedEventArgs( IWindowActivatedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct activated_args, IWindowActivatedEventArgs_iface );
+}
+
+static HRESULT WINAPI activated_args_QueryInterface( IWindowActivatedEventArgs *iface, REFIID iid, void **out )
+{
+    struct activated_args *impl = impl_from_IWindowActivatedEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IWindowActivatedEventArgs ))
+        *out = &impl->IWindowActivatedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_ICoreWindowEventArgs ))
+        *out = &impl->ICoreWindowEventArgs_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI activated_args_AddRef( IWindowActivatedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IWindowActivatedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI activated_args_Release( IWindowActivatedEventArgs *iface )
+{
+    struct activated_args *impl = impl_from_IWindowActivatedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI activated_args_GetIids( IWindowActivatedEventArgs *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI activated_args_GetRuntimeClassName( IWindowActivatedEventArgs *iface, HSTRING *value )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Core_WindowActivatedEventArgs;
+    return WindowsCreateString( name, wcslen( name ), value );
+}
+
+static HRESULT WINAPI activated_args_GetTrustLevel( IWindowActivatedEventArgs *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI activated_args_get_WindowActivationState( IWindowActivatedEventArgs *iface,
+                                                                CoreWindowActivationState *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IWindowActivatedEventArgs( iface )->state;
+    return S_OK;
+}
+
+static const struct IWindowActivatedEventArgsVtbl activated_args_vtbl =
+{
+    activated_args_QueryInterface,
+    activated_args_AddRef,
+    activated_args_Release,
+    activated_args_GetIids,
+    activated_args_GetRuntimeClassName,
+    activated_args_GetTrustLevel,
+    activated_args_get_WindowActivationState,
+};
+
+DEFINE_IINSPECTABLE( activated_core_args, ICoreWindowEventArgs, struct activated_args, IWindowActivatedEventArgs_iface )
+
+static HRESULT WINAPI activated_core_args_get_Handled( ICoreWindowEventArgs *iface, boolean *value )
+{
+    if (!value) return E_POINTER;
