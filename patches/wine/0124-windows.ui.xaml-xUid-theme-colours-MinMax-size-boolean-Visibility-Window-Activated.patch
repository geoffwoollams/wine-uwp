+    boolean b;
+    BOOL ok = FALSE;
+
+    if (value->kind == XV_BOOL)
+    {
+        *e = value->b ? Visibility_Visible : Visibility_Collapsed;
+        return TRUE;
+    }
+    if (value->kind == XV_OBJECT && value->object &&
+        SUCCEEDED(IInspectable_QueryInterface( value->object, &IID_IPropertyValue, (void **)&pv )))
+    {
+        if (SUCCEEDED(IPropertyValue_get_Type( pv, &type )) && type == PropertyType_Boolean &&
+            SUCCEEDED(IPropertyValue_GetBoolean( pv, &b )))
+        {
+            *e = b ? Visibility_Visible : Visibility_Collapsed;
+            ok = TRUE;
+        }
+        else if (SUCCEEDED(IPropertyValue_GetInt32( pv, e ))) ok = *e == Visibility_Visible || *e == Visibility_Collapsed;
+        IPropertyValue_Release( pv );
+        if (ok) return TRUE;
+    }
+    return to_enum( value, visibility_names, 2, e );
+}
