Subject: windows.networking.connectivity: report no internet connection (WINE_UWP_ONLINE=1 reports the host's)

diff --git a/dlls/windows.networking.connectivity/network_information.c b/dlls/windows.networking.connectivity/network_information.c
index 27f78a2..4b77c07 100644
--- a/dlls/windows.networking.connectivity/network_information.c
+++ b/dlls/windows.networking.connectivity/network_information.c
@@ -424,6 +424,12 @@ static HRESULT WINAPI network_information_statics_GetConnectionProfiles( INetwor
     return E_NOTIMPL;
 }
 
+static BOOL report_online(void)
+{
+    const char *env = getenv( "WINE_UWP_ONLINE" );
+    return env && *env && *env != '0';
+}
+
 static HRESULT WINAPI network_information_statics_GetInternetConnectionProfile( INetworkInformationStatics *iface, IConnectionProfile **value )
 {
     NetworkConnectivityLevel network_connectivity_level = 0xdeadbeef;
@@ -434,6 +440,14 @@ static HRESULT WINAPI network_information_statics_GetInternetConnectionProfile(
     TRACE( "iface %p, value %p\n", iface, value );
 
     *value = NULL;
+    /* Apps are offline: their web requests fail as unreachable, so report no internet
+     * connection too (no profile, as on Windows), or they wait on downloads that never
+     * finish. WINE_UWP_ONLINE=1 reports the host's connection instead. */
+    if (!report_online())
+    {
+        TRACE( "reporting no internet connection.\n" );
+        return S_OK;
+    }
     if (FAILED(hr = CoCreateInstance( &CLSID_NetworkListManager, NULL, CLSCTX_INPROC_SERVER, &IID_INetworkListManager, (void **)&network_list_manager ))) return hr;
     if (!(impl = calloc( 1, sizeof( *impl ) )))
     {
