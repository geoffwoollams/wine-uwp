 static const GUID IID_ILaunchActivatedEventArgs_local =
     { 0xfbc93e26, 0xa14a, 0x4b4f, { 0x82, 0xb0, 0x33, 0xbe, 0xd9, 0x20, 0xaf, 0x52 } };
 
+/* the other interfaces of LaunchActivatedEventArgs, each with one getter */
+static const GUID IID_IPrelaunchActivatedEventArgs_local =
+    { 0x0c44717b, 0x19f7, 0x48d6, { 0xb0, 0x46, 0xcf, 0x22, 0x82, 0x6e, 0xaa, 0x74 } };
+static const GUID IID_ILaunchActivatedEventArgs2_local =
+    { 0x0fd37ebc, 0x9dc9, 0x46b5, { 0x9a, 0xce, 0xbd, 0x95, 0xd4, 0x56, 0x53, 0x45 } };
+static const GUID IID_IApplicationViewActivatedEventArgs_local =
