+        impl->forward[i].source = impl;
+        impl->forward[i].event = i;
+    }
+    ICoreWindow_add_PointerCaptureLost( window, &impl->forward[EVENT_CAPTURE_LOST].ITypedEventHandler_iface, &impl->tokens[EVENT_CAPTURE_LOST] );
+    ICoreWindow_add_PointerEntered( window, &impl->forward[EVENT_ENTERED].ITypedEventHandler_iface, &impl->tokens[EVENT_ENTERED] );
+    ICoreWindow_add_PointerExited( window, &impl->forward[EVENT_EXITED].ITypedEventHandler_iface, &impl->tokens[EVENT_EXITED] );
+    ICoreWindow_add_PointerMoved( window, &impl->forward[EVENT_MOVED].ITypedEventHandler_iface, &impl->tokens[EVENT_MOVED] );
+    ICoreWindow_add_PointerPressed( window, &impl->forward[EVENT_PRESSED].ITypedEventHandler_iface, &impl->tokens[EVENT_PRESSED] );
+    ICoreWindow_add_PointerReleased( window, &impl->forward[EVENT_RELEASED].ITypedEventHandler_iface, &impl->tokens[EVENT_RELEASED] );
+    ICoreWindow_add_PointerWheelChanged( window, &impl->forward[EVENT_WHEEL].ITypedEventHandler_iface, &impl->tokens[EVENT_WHEEL] );
