+#include "private.h"
+#include "initguid.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A SwapChainPanel is a Grid (panel.c, PANEL_SWAPCHAIN) that shows a DirectX composition swap chain: games (Unity
+ * among them) draw into it and give it to the panel with ISwapChainPanelNative::SetSwapChain. Wine has no XAML
+ * compositor, so the patched DXVK dxgi presents composition swap chains straight to the core window, and while a
+ * panel holds a swap chain XAML stops drawing the window (window_swapchain_active): the game's frames fill it, and
+ * XAML content over the panel (a splash screen, say) isn't shown. That is right for the usual case of a panel
+ * filling the window.
+ *
+ * CreateCoreIndependentInputSource gives games pointer input off the UI thread: here a source that passes on the
+ * CoreWindow's pointer events (raised on the UI thread), with the CoreWindow's dispatcher. */
+
+DEFINE_GUID( IID_ISwapChainPanelNative, 0xf92f19d2, 0x3ade, 0x45a6, 0xa2, 0x0c, 0xf6, 0xf1, 0xea, 0x90, 0x55, 0x4b );
+DEFINE_GUID( IID_ISwapChainPanelNative2, 0xd5a2f60c, 0x37b2, 0x44a2, 0x93, 0x7b, 0x8d, 0x8e, 0xb9, 0x72, 0x68, 0x21 );
+
+/* ISwapChainPanelNative2, which derives from ISwapChainPanelNative (windows.ui.xaml.media.dxinterop.h) */
+typedef struct ISwapChainPanelNative2 ISwapChainPanelNative2;
+struct ISwapChainPanelNative2Vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( ISwapChainPanelNative2 *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( ISwapChainPanelNative2 *iface );
+    ULONG (WINAPI *Release)( ISwapChainPanelNative2 *iface );
+    HRESULT (WINAPI *SetSwapChain)( ISwapChainPanelNative2 *iface, IUnknown *swapchain );
+    HRESULT (WINAPI *SetSwapChainHandle)( ISwapChainPanelNative2 *iface, HANDLE handle );
+};
+struct ISwapChainPanelNative2 { const struct ISwapChainPanelNative2Vtbl *lpVtbl; };
+
+struct swapchain_panel
+{
+    ISwapChainPanel ISwapChainPanel_iface;
+    ISwapChainPanelNative2 ISwapChainPanelNative2_iface;
+    struct xaml_element *element;
+    IUnknown *swapchain;
+    struct event_list scale_changed;
+};
+
+static struct swapchain_panel *active_panel;   /* the panel whose swap chain is on the window */
+
+BOOL window_swapchain_active(void)
