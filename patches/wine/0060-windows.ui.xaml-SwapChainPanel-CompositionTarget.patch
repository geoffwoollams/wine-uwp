+/* ---- Loaded and SizeChanged: queued during layout, raised after it ---- */
+
+enum layout_event { LAYOUT_LOADED, LAYOUT_SIZE_CHANGED };
+
+struct pending_layout_event
+{
+    struct xaml_element *element;   /* referenced */
+    enum layout_event kind;
+};
+
+static struct pending_layout_event *pending_events;
+static UINT32 pending_count, pending_capacity;
+
+static void queue_layout_event( struct xaml_element *element, enum layout_event kind )
+{
+    UINT32 i;
+    void *grow;
+
+    for (i = 0; i < pending_count; i++)
+        if (pending_events[i].element == element && pending_events[i].kind == kind) return;
+    if (pending_count == pending_capacity)
+    {
+        UINT32 capacity = max( 16, pending_capacity * 2 );
+        if (!(grow = realloc( pending_events, capacity * sizeof(*pending_events) ))) return;
+        pending_events = grow;
+        pending_capacity = capacity;
+    }
+    IUIElement_AddRef( &element->IUIElement_iface );
+    pending_events[pending_count].element = element;
+    pending_events[pending_count++].kind = kind;
+}
+
+struct size_args
+{
+    ISizeChangedEventArgs ISizeChangedEventArgs_iface;
+    IRoutedEventArgs IRoutedEventArgs_iface;
+    LONG ref;
+    IInspectable *source;
+    Size previous, size;
+};
+
+static inline struct size_args *size_args_from_ISizeChangedEventArgs( ISizeChangedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct size_args, ISizeChangedEventArgs_iface );
+}
+
+static HRESULT WINAPI size_args_QueryInterface( ISizeChangedEventArgs *iface, REFIID iid, void **out )
+{
+    struct size_args *impl = size_args_from_ISizeChangedEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ISizeChangedEventArgs ))
+        *out = &impl->ISizeChangedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IRoutedEventArgs ))
+        *out = &impl->IRoutedEventArgs_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI size_args_AddRef( ISizeChangedEventArgs *iface )
+{
+    return InterlockedIncrement( &size_args_from_ISizeChangedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI size_args_Release( ISizeChangedEventArgs *iface )
+{
+    struct size_args *impl = size_args_from_ISizeChangedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->source) IInspectable_Release( impl->source );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI size_args_GetIids( ISizeChangedEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI size_args_GetRuntimeClassName( ISizeChangedEventArgs *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_UI_Xaml_SizeChangedEventArgs,
+                                wcslen( RuntimeClass_Windows_UI_Xaml_SizeChangedEventArgs ), name );
+}
+
