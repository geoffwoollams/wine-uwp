+static void raise_layout_event( struct xaml_element *element, enum layout_event kind )
+{
+    struct event_list *list = kind == LAYOUT_LOADED ? &element->loaded : &element->size_changed;
+    IRoutedEventArgs *routed = NULL;
+    struct size_args *args = NULL;
+    IUnknown **handlers;
+    UINT32 i, count = list->count;
+    HRESULT hr;
+
+    if (kind == LAYOUT_SIZE_CHANGED)
+    {
+        if (element->reported_width == element->bounds.width && element->reported_height == element->bounds.height) return;
+        if (!(args = calloc( 1, sizeof(*args) ))) return;
+        args->ISizeChangedEventArgs_iface.lpVtbl = &size_args_vtbl;
+        args->IRoutedEventArgs_iface.lpVtbl = &size_routed_vtbl;
+        args->ref = 1;
+        IInspectable_AddRef( (args->source = element->outer) );
+        args->previous.Width = max( 0.0f, element->reported_width );
+        args->previous.Height = max( 0.0f, element->reported_height );
+        args->size.Width = element->reported_width = element->bounds.width;
+        args->size.Height = element->reported_height = element->bounds.height;
+        TRACE( "%s %p: SizeChanged to %.1fx%.1f.\n", debugstr_w(element->class_name), element,
+               args->size.Width, args->size.Height );
+    }
+    else
+    {
+        if (FAILED(routed_event_args_create( element->outer, &routed ))) return;
+        TRACE( "%s %p: Loaded.\n", debugstr_w(element->class_name), element );
+    }
+    if (count && (handlers = calloc( count, sizeof(*handlers) )))
+    {
+        for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            if (kind == LAYOUT_LOADED)
+                hr = IRoutedEventHandler_Invoke( (IRoutedEventHandler *)handlers[i], element->outer, routed );
+            else
+                hr = ISizeChangedEventHandler_Invoke( (ISizeChangedEventHandler *)handlers[i], element->outer,
+                                                      &args->ISizeChangedEventArgs_iface );
+            if (FAILED(hr)) WARN( "handler %p failed, hr %#lx.\n", handlers[i], hr );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+    if (routed) IRoutedEventArgs_Release( routed );
+    if (args) ISizeChangedEventArgs_Release( &args->ISizeChangedEventArgs_iface );
+}
+
+void element_raise_layout_events(void)
+{
+    struct pending_layout_event *events;
+    UINT32 i, count;
+
+    /* handlers may change the tree, so a later layout may queue more */
+    while (pending_count)
+    {
+        events = pending_events;
+        count = pending_count;
+        pending_events = NULL;
+        pending_count = pending_capacity = 0;
+        for (i = 0; i < count; i++)
+        {
+            raise_layout_event( events[i].element, events[i].kind );
+            IUIElement_Release( &events[i].element->IUIElement_iface );
+        }
+        free( events );
+        break;   /* what they queue waits for the next layout */
+    }
