+}
+
+static HRESULT WINAPI panel_iface_remove_CompositionScaleChanged( ISwapChainPanel *iface, EventRegistrationToken token )
+{
+    return event_list_remove( &impl_from_ISwapChainPanel( iface )->scale_changed, token );
+}
