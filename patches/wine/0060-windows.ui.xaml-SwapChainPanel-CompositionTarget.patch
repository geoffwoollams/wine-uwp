+/* CompositionTarget.Rendering is raised once a frame on the UI thread, for apps and engines that do per-frame work
+ * (Unity hooks it); Rendered follows it. Without a compositor, a frame is a 60 Hz window timer that runs while
+ * there are handlers (window.c). SurfaceContentsLost never happens. */
+
+static struct event_list rendering, rendered, contents_lost;
+static ULONGLONG start_time;
+
+struct frame_args
+{
+    IRenderingEventArgs IRenderingEventArgs_iface;
+    IRenderedEventArgs IRenderedEventArgs_iface;
+    LONG ref;
+    TimeSpan time, duration;
+};
+
+static inline struct frame_args *impl_from_IRenderingEventArgs( IRenderingEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct frame_args, IRenderingEventArgs_iface );
+}
+
+static HRESULT WINAPI rendering_args_QueryInterface( IRenderingEventArgs *iface, REFIID iid, void **out )
+{
+    struct frame_args *impl = impl_from_IRenderingEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IRenderingEventArgs ))
+        *out = &impl->IRenderingEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IRenderedEventArgs ))
+        *out = &impl->IRenderedEventArgs_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI rendering_args_AddRef( IRenderingEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IRenderingEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI rendering_args_Release( IRenderingEventArgs *iface )
+{
+    struct frame_args *impl = impl_from_IRenderingEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI rendering_args_GetIids( IRenderingEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI rendering_args_GetRuntimeClassName( IRenderingEventArgs *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_UI_Xaml_Media_RenderingEventArgs,
+                                wcslen( RuntimeClass_Windows_UI_Xaml_Media_RenderingEventArgs ), name );
+}
+
+static HRESULT WINAPI rendering_args_GetTrustLevel( IRenderingEventArgs *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI rendering_args_get_RenderingTime( IRenderingEventArgs *iface, TimeSpan *value )
+{
+    *value = impl_from_IRenderingEventArgs( iface )->time;
+    return S_OK;
+}
+
+static const struct IRenderingEventArgsVtbl rendering_args_vtbl =
+{
+    rendering_args_QueryInterface,
+    rendering_args_AddRef,
+    rendering_args_Release,
+    /* IInspectable methods */
+    rendering_args_GetIids,
+    rendering_args_GetRuntimeClassName,
+    rendering_args_GetTrustLevel,
+    /* IRenderingEventArgs methods */
+    rendering_args_get_RenderingTime,
+};
+
+DEFINE_IINSPECTABLE( rendered_args, IRenderedEventArgs, struct frame_args, IRenderingEventArgs_iface )
+
+static HRESULT WINAPI rendered_args_get_FrameDuration( IRenderedEventArgs *iface, TimeSpan *value )
+{
+    *value = impl_from_IRenderedEventArgs( iface )->duration;
+    return S_OK;
+}
+
+static const struct IRenderedEventArgsVtbl rendered_args_vtbl =
+{
+    rendered_args_QueryInterface,
+    rendered_args_AddRef,
+    rendered_args_Release,
+    /* IInspectable methods */
+    rendered_args_GetIids,
+    rendered_args_GetRuntimeClassName,
+    rendered_args_GetTrustLevel,
+    /* IRenderedEventArgs methods */
+    rendered_args_get_FrameDuration,
+};
+
+static void raise_frame_event( struct event_list *list, IInspectable *args, const char *name )
+{
+    IUnknown **handlers;
+    UINT32 i, count = list->count;
+    HRESULT hr;
+
+    if (!count || !(handlers = calloc( count, sizeof(*handlers) ))) return;
+    for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+    for (i = 0; i < count; i++)
+    {
+        if (!handlers[i]) continue;
+        /* EventHandler<IInspectable> and EventHandler<RenderedEventArgs> have the same Invoke */
+        hr = IEventHandler_IInspectable_Invoke( (IEventHandler_IInspectable *)handlers[i], NULL, args );
+        if (FAILED(hr)) WARN( "%s handler %p failed, hr %#lx.\n", name, handlers[i], hr );
+        IUnknown_Release( handlers[i] );
+    }
+    free( handlers );
+}
+
+/* a frame: from window.c's frame timer */
+void composition_frame(void)
+{
+    static ULONGLONG last;
+    ULONGLONG now = GetTickCount64();
+    struct frame_args *args;
+    INT64 ticks;
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return;
+    args->IRenderingEventArgs_iface.lpVtbl = &rendering_args_vtbl;
+    args->IRenderedEventArgs_iface.lpVtbl = &rendered_args_vtbl;
+    args->ref = 1;
+    /* TimeSpan's one member, in 100 ns units (its name is also XAML's Duration type) */
+    ticks = (now - start_time) * 10000;
+    memcpy( &args->time, &ticks, sizeof(ticks) );
+    ticks = (last ? now - last : 16) * 10000;
+    memcpy( &args->duration, &ticks, sizeof(ticks) );
+    last = now;
+    raise_frame_event( &rendering, (IInspectable *)&args->IRenderingEventArgs_iface, "Rendering" );
+    raise_frame_event( &rendered, (IInspectable *)&args->IRenderedEventArgs_iface, "Rendered" );
+    IRenderingEventArgs_Release( &args->IRenderingEventArgs_iface );
+}
+
+static BOOL has_handlers( const struct event_list *list )
+{
+    UINT32 i;
+    for (i = 0; i < list->count; i++) if (list->handlers[i]) return TRUE;
+    return FALSE;
+}
+
+BOOL composition_wants_frames(void)
+{
+    return has_handlers( &rendering ) || has_handlers( &rendered );
+}
+
+static void frames_changed(void)
+{
+    if (!start_time) start_time = GetTickCount64();
+    window_frame_timer( composition_wants_frames() );
+}
+
+/* ---- the statics ---- */
+
+struct statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ICompositionTargetStatics ICompositionTargetStatics_iface;
+    ICompositionTargetStatics3 ICompositionTargetStatics3_iface;
+};
+
+static inline struct statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct statics *impl = impl_from_IActivationFactory( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionTargetStatics ))
+        *out = &impl->ICompositionTargetStatics_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionTargetStatics3 ))
+        *out = &impl->ICompositionTargetStatics3_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( ct_statics, ICompositionTargetStatics, struct statics, IActivationFactory_iface )
+
+static HRESULT WINAPI ct_statics_add_Rendering( ICompositionTargetStatics *iface, IEventHandler_IInspectable *handler,
+                                                EventRegistrationToken *token )
+{
+    HRESULT hr;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    if (SUCCEEDED(hr = event_list_add( &rendering, (IUnknown *)handler, token ))) frames_changed();
+    return hr;
+}
+
+static HRESULT WINAPI ct_statics_remove_Rendering( ICompositionTargetStatics *iface, EventRegistrationToken token )
+{
+    HRESULT hr = event_list_remove( &rendering, token );
+    frames_changed();
+    return hr;
+}
+
+static HRESULT WINAPI ct_statics_add_SurfaceContentsLost( ICompositionTargetStatics *iface, IEventHandler_IInspectable *handler,
+                                                          EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p: never raised.\n", iface, handler );
+    return event_list_add( &contents_lost, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI ct_statics_remove_SurfaceContentsLost( ICompositionTargetStatics *iface, EventRegistrationToken token )
+{
+    return event_list_remove( &contents_lost, token );
+}
+
+static const struct ICompositionTargetStaticsVtbl ct_statics_vtbl =
+{
+    ct_statics_QueryInterface,
+    ct_statics_AddRef,
+    ct_statics_Release,
+    /* IInspectable methods */
+    ct_statics_GetIids,
+    ct_statics_GetRuntimeClassName,
+    ct_statics_GetTrustLevel,
+    /* ICompositionTargetStatics methods */
+    ct_statics_add_Rendering,
+    ct_statics_remove_Rendering,
+    ct_statics_add_SurfaceContentsLost,
+    ct_statics_remove_SurfaceContentsLost,
+};
+
+DEFINE_IINSPECTABLE( ct_statics3, ICompositionTargetStatics3, struct statics, IActivationFactory_iface )
+
+static HRESULT WINAPI ct_statics3_add_Rendered( ICompositionTargetStatics3 *iface, IEventHandler_RenderedEventArgs *handler,
+                                                EventRegistrationToken *token )
+{
+    HRESULT hr;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    if (SUCCEEDED(hr = event_list_add( &rendered, (IUnknown *)handler, token ))) frames_changed();
+    return hr;
+}
+
+static HRESULT WINAPI ct_statics3_remove_Rendered( ICompositionTargetStatics3 *iface, EventRegistrationToken token )
+{
+    HRESULT hr = event_list_remove( &rendered, token );
+    frames_changed();
+    return hr;
+}
+
+static const struct ICompositionTargetStatics3Vtbl ct_statics3_vtbl =
+{
+    ct_statics3_QueryInterface,
+    ct_statics3_AddRef,
+    ct_statics3_Release,
+    /* IInspectable methods */
+    ct_statics3_GetIids,
+    ct_statics3_GetRuntimeClassName,
+    ct_statics3_GetTrustLevel,
+    /* ICompositionTargetStatics3 methods */
+    ct_statics3_add_Rendered,
+    ct_statics3_remove_Rendered,
+};
+
+static struct statics statics = { {&factory_vtbl}, {&ct_statics_vtbl}, {&ct_statics3_vtbl} };
+IActivationFactory *composition_target_factory = &statics.IActivationFactory_iface;
