     impl->IMediaPlayer2_iface.lpVtbl = &media_player2_vtbl;
+    impl->player3.lpVtbl = player3_vtbl;
+    impl->session.lpVtbl = session_vtbl;
+    impl->source_rect.width = impl->source_rect.height = 1.0f;
     impl->ref = 1;
     InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
     impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": media_player.cs");
