+    TRACE( "iface %p, name %s, disposition %d, container %p.\n", iface, debugstr_hstring( name ), disposition, container );
+
+    if (!container) return E_POINTER;
+    *container = NULL;
+    if (!buffer || !*buffer) return E_INVALIDARG;
+
+    EnterCriticalSection( &impl->cs );
+    for (child = impl->children; child; child = child->next)
+        if (!wcsicmp( child->name, buffer )) break;
+    if (child)
+    {
+        IApplicationDataContainer_AddRef( (*container = child->container) );
+        LeaveCriticalSection( &impl->cs );
