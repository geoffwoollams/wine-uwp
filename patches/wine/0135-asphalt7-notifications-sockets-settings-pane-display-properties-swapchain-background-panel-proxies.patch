+static HRESULT create_image_tile( BOOL wide, struct tile_content **out )
+{
+    struct tile_content *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->INotificationContent_iface.lpVtbl = &content_vtbl;
+    impl->ITileNotificationContent_iface.lpVtbl = &tile_notif_vtbl;
+    impl->IWideTileNotificationContent_iface.lpVtbl = &wide_notif_vtbl;
+    impl->ISquareTileNotificationContent_iface.lpVtbl = &square_notif_vtbl;
+    impl->ITileWideImage_iface.lpVtbl = &wide_image_vtbl;
+    impl->ITileSquareImage_iface.lpVtbl = &square_image_vtbl;
+    impl->wide = wide;
+    impl->ref = 1;
+    if (FAILED(hr = create_image( &impl->image )))
+    {
+        free( impl );
+        return hr;
+    }
+    *out = impl;
+    return S_OK;
+}
