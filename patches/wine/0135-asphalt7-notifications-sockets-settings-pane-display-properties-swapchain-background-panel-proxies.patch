--- /dev/null
+++ b/dlls/wpnapps/sensors.c
@@ -0,0 +1,98 @@
+/*
+ * Windows.Devices.Sensors.Accelerometer: a PC has none. GetDefault answers null, as it does on a Windows PC without
+ * one, and games that steer by tilt (Asphalt 7) then use the keyboard and gamepad.
+ */
+
+#define COBJMACROS
+#include <winstring.h>
+
+#include "private.h"
+#include <initguid.h>
+#define WIDL_using_Windows_Devices_Sensors
+#include "windows.devices.sensors.h"
+
+#include <wine/debug.h>
+
+WINE_DEFAULT_DEBUG_CHANNEL(wpnapps);
+
+struct acc_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IAccelerometerStatics IAccelerometerStatics_iface;
+};
+
+static inline struct acc_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct acc_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI acc_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct acc_factory *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "(%p, %s, %p)\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IAccelerometerStatics ))
+        *out = &impl->IAccelerometerStatics_iface;
+    else
+    {
+        *out = NULL;
+        FIXME( "%s not implemented, returning E_NOINTERFACE\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI acc_factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI acc_factory_Release( IActivationFactory *iface ) { return 1; }
+static HRESULT WINAPI acc_factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI acc_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI acc_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI acc_factory_ActivateInstance( IActivationFactory *iface, IInspectable **out )
+{
+    *out = NULL;
+    return E_NOTIMPL;
+}
+
+static const IActivationFactoryVtbl acc_factory_vtbl =
+{
+    acc_factory_QueryInterface,
+    acc_factory_AddRef,
+    acc_factory_Release,
+    acc_factory_GetIids,
+    acc_factory_GetRuntimeClassName,
+    acc_factory_GetTrustLevel,
+    acc_factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( acc_statics, IAccelerometerStatics, struct acc_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI acc_statics_GetDefault( IAccelerometerStatics *iface, IAccelerometer **value )
+{
+    TRACE( "(%p, %p): no accelerometer.\n", iface, value );
+    *value = NULL;
+    return S_OK;
+}
+
+static const IAccelerometerStaticsVtbl acc_statics_vtbl =
+{
+    acc_statics_QueryInterface,
+    acc_statics_AddRef,
+    acc_statics_Release,
+    acc_statics_GetIids,
+    acc_statics_GetRuntimeClassName,
+    acc_statics_GetTrustLevel,
+    acc_statics_GetDefault,
+};
+
+static struct acc_factory acc_factory_impl =
+{
+    { &acc_factory_vtbl },
+    { &acc_statics_vtbl },
+};
+
+IActivationFactory *accelerometer_factory = &acc_factory_impl.IActivationFactory_iface;
