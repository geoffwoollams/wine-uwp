+/* takes data (malloc'ed) */
+static HRESULT content_create( const WCHAR *class_name, BYTE *data, SIZE_T size, IInputStream *source, struct content **out )
+{
+    struct content *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = headers_create( HEADERS_CONTENT, &impl->headers )))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->IHttpContent_iface.lpVtbl = &content_vtbl;
+    impl->IClosable_iface.lpVtbl = &content_closable_vtbl;
+    impl->IStringable_iface.lpVtbl = &content_stringable_vtbl;
+    impl->ref = 1;
+    impl->class_name = class_name;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": content.cs");
+    if ((impl->source = source)) IInputStream_AddRef( source );
+    else
+    {
+        impl->buffered = TRUE;
+        impl->data = data;
+        impl->size = size;
+    }
+    *out = impl;
+    return S_OK;
+}
