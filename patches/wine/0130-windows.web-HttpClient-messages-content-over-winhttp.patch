+/* Requests go out through winhttp. The filter buffers each response's body before its operation completes, as
+ * Windows does for HttpCompletionOption.ResponseContentRead; the content then reads from memory. */
+
+#define HTTP_E_STATUS_BASE 0x80190000
+#define Closed 4   /* an AsyncStatus after IAsyncInfo::Close */
+
+static WCHAR *wcsdup_n( const WCHAR *str, SIZE_T len )
+{
+    WCHAR *ret = malloc( (len + 1) * sizeof(WCHAR) );
+    if (!ret) return NULL;
+    memcpy( ret, str, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+static WCHAR *hstring_dup( HSTRING str )
+{
+    UINT32 len;
+    const WCHAR *buf = WindowsGetStringRawBuffer( str, &len );
+    return wcsdup_n( buf, len );
+}
+
+static HRESULT activation_factory( const WCHAR *name, REFIID iid, void **out )
+{
+    HSTRING str;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &str ))) return hr;
+    hr = RoGetActivationFactory( str, iid, out );
+    WindowsDeleteString( str );
+    return hr;
+}
+
+static HRESULT create_uri( const WCHAR *text, IUriRuntimeClass **uri )
+{
+    IUriRuntimeClassFactory *factory;
+    HSTRING str;
+    HRESULT hr;
+
+    if (FAILED(hr = activation_factory( L"Windows.Foundation.Uri", &IID_IUriRuntimeClassFactory, (void **)&factory ))) return hr;
+    if (SUCCEEDED(hr = WindowsCreateString( text, wcslen( text ), &str )))
+    {
+        hr = IUriRuntimeClassFactory_CreateUri( factory, str, uri );
+        WindowsDeleteString( str );
+    }
+    IUriRuntimeClassFactory_Release( factory );
+    return hr;
+}
+
+static HRESULT create_buffer( const BYTE *data, UINT32 size, IBuffer **out )
+{
+    IBufferFactory *factory;
+    IBufferByteAccess *access;
+    BYTE *dst;
+    HRESULT hr;
+
+    if (FAILED(hr = activation_factory( L"Windows.Storage.Streams.Buffer", &IID_IBufferFactory, (void **)&factory ))) return hr;
+    hr = IBufferFactory_Create( factory, size, out );
+    IBufferFactory_Release( factory );
+    if (FAILED(hr)) return hr;
+    if (size && SUCCEEDED(hr = IBuffer_QueryInterface( *out, &IID_IBufferByteAccess, (void **)&access )))
+    {
+        if (SUCCEEDED(hr = IBufferByteAccess_Buffer( access, &dst ))) memcpy( dst, data, size );
+        IBufferByteAccess_Release( access );
+    }
+    if (SUCCEEDED(hr)) hr = IBuffer_put_Length( *out, size );
+    if (FAILED(hr)) IBuffer_Release( *out );
+    return hr;
+}
+
+static HRESULT buffer_data( IBuffer *buffer, BYTE **data, UINT32 *length )
+{
+    IBufferByteAccess *access;
+    HRESULT hr;
+
+    if (FAILED(hr = IBuffer_get_Length( buffer, length ))) return hr;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+    hr = IBufferByteAccess_Buffer( access, data );
+    IBufferByteAccess_Release( access );
+    return hr;
+}
