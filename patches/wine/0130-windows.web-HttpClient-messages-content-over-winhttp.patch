+struct read_context
+{
+    struct byte_stream *stream;
+    IBuffer *buffer;
+    UINT32 count;
+};
+
+static HRESULT read_work( void *data, union async_result *result )
+{
+    struct read_context *ctx = data;
+    struct byte_stream *stream = ctx->stream;
+    IBufferByteAccess *access;
+    UINT32 capacity, count;
+    BYTE *dst;
+    HRESULT hr;
+
+    if (FAILED(hr = IBuffer_get_Capacity( ctx->buffer, &capacity ))) return hr;
+    if (FAILED(hr = IBuffer_QueryInterface( ctx->buffer, &IID_IBufferByteAccess, (void **)&access ))) return hr;
+    hr = IBufferByteAccess_Buffer( access, &dst );
+    IBufferByteAccess_Release( access );
+    if (FAILED(hr)) return hr;
+
+    EnterCriticalSection( &stream->cs );
+    count = min( min( ctx->count, capacity ), stream->size - stream->position );
+    memcpy( dst, stream->data + stream->position, count );
+    stream->position += count;
+    LeaveCriticalSection( &stream->cs );
+
+    if (FAILED(hr = IBuffer_put_Length( ctx->buffer, count ))) return hr;
+    IBuffer_AddRef( ctx->buffer );
+    result->object = (IUnknown *)ctx->buffer;
+    return S_OK;
+}
+
+static void read_free( void *data )
+{
+    struct read_context *ctx = data;
+    IInputStream_Release( &ctx->stream->IInputStream_iface );
+    IBuffer_Release( ctx->buffer );
+    free( ctx );
+}
+
+static HRESULT WINAPI byte_stream_ReadAsync( IInputStream *iface, IBuffer *buffer, UINT32 count, InputStreamOptions options,
+                                             IAsyncOperationWithProgress_IBuffer_UINT32 **operation )
+{
+    struct byte_stream *impl = impl_from_IInputStream( iface );
+    struct read_context *ctx;
+
+    TRACE( "iface %p, buffer %p, count %u, options %d, operation %p.\n", iface, buffer, count, options, operation );
+    if (!buffer || !operation) return E_POINTER;
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return E_OUTOFMEMORY;
+    ctx->stream = impl;
+    IInputStream_AddRef( iface );
+    ctx->buffer = buffer;
+    IBuffer_AddRef( buffer );
+    ctx->count = count;
+    return async_start( &IID_IAsyncOperationWithProgress_IBuffer_UINT32, ASYNC_OBJECT, read_work, ctx, NULL, read_free,
+                        (void **)operation );
+}
