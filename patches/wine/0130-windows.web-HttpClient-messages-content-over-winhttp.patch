+    if (impl->uri) IUriRuntimeClass_get_AbsoluteUri( impl->uri, &uri );
+    len = WindowsGetStringLen( method ) + WindowsGetStringLen( uri ) + 2;
+    if (!(text = malloc( len * sizeof(WCHAR) ))) hr = E_OUTOFMEMORY;
+    else
+    {
+        swprintf( text, len, L"%s %s", WindowsGetStringRawBuffer( method, NULL ), WindowsGetStringRawBuffer( uri, NULL ) );
+        hr = WindowsCreateString( text, wcslen( text ), value );
+        free( text );
+    }
+    WindowsDeleteString( method );
+    WindowsDeleteString( uri );
+    return hr;
+}
