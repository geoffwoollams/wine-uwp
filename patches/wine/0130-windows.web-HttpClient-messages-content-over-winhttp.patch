+/* parses "type/subtype; charset=x; q=0.5" (other parameters are dropped) */
+static HRESULT media_type_parse( const WCHAR *text, UINT32 len, IHttpMediaTypeWithQualityHeaderValue **out )
+{
+    const WCHAR *end = text + len, *p, *semi;
+    struct media_type *impl;
+    HRESULT hr;
+
+    while (text < end && (*text == ' ' || *text == '\t')) text++;
+    for (semi = text; semi < end && *semi != ';'; semi++);
+    for (p = semi; p > text && (p[-1] == ' ' || p[-1] == '\t'); p--);
+    if (FAILED(hr = media_type_create( text, p - text, out ))) return hr;
+    impl = impl_from_IHttpMediaTypeWithQualityHeaderValue( *out );
+    while (semi < end)
+    {
+        const WCHAR *name = semi + 1, *eq, *value, *next;
+
+        for (next = name; next < end && *next != ';'; next++);
+        while (name < next && (*name == ' ' || *name == '\t')) name++;
+        for (eq = name; eq < next && *eq != '='; eq++);
+        if (eq < next)
+        {
+            const WCHAR *vend = next;
+            value = eq + 1;
+            while (value < vend && (*value == ' ' || *value == '"')) value++;
+            while (vend > value && (vend[-1] == ' ' || vend[-1] == '"')) vend--;
+            if (eq - name == 7 && !wcsnicmp( name, L"charset", 7 ))
+            {
+                WindowsDeleteString( impl->charset );
+                WindowsCreateString( value, vend - value, &impl->charset );
+            }
+            else if (eq - name == 1 && (*name == 'q' || *name == 'Q'))
+            {
+                WCHAR buf[16] = {0};
+                memcpy( buf, value, min( vend - value, 15 ) * sizeof(WCHAR) );
+                impl->quality = wcstod( buf, NULL );
+                impl->has_quality = impl->quality >= 0 && impl->quality <= 1;
+            }
+        }
+        semi = next;
+    }
+    return S_OK;
+}
