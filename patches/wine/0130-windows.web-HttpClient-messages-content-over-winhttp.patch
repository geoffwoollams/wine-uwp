+static HINTERNET session;
+static INIT_ONCE session_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL WINAPI init_session( INIT_ONCE *once, void *param, void **context )
+{
+    DWORD protocols = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2 | WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3;
+
+    if (!(session = WinHttpOpen( L"", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY, WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0 )))
+        ERR( "WinHttpOpen failed, error %lu.\n", GetLastError() );
+    else if (!WinHttpSetOption( session, WINHTTP_OPTION_SECURE_PROTOCOLS, &protocols, sizeof(protocols) ))
+    {
+        protocols = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2;
+        WinHttpSetOption( session, WINHTTP_OPTION_SECURE_PROTOCOLS, &protocols, sizeof(protocols) );
+    }
+    return TRUE;
+}
