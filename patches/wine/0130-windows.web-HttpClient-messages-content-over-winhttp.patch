+static HRESULT string_content_create( HSTRING text, UnicodeEncoding encoding, HSTRING media_type, IHttpContent **value )
+{
+    static const WCHAR *const charsets[] = { L"utf-8", L"utf-16le", L"utf-16be" };
+    struct content *content;
+    const WCHAR *str, *type;
+    WCHAR *header;
+    UINT32 len, i;
+    BYTE *data = NULL;
+    SIZE_T size;
+    HRESULT hr;
+
+    if (encoding > UnicodeEncoding_Utf16BE) return E_INVALIDARG;
+    str = WindowsGetStringRawBuffer( text, &len );
+    if (encoding == UnicodeEncoding_Utf8)
+    {
+        size = WideCharToMultiByte( CP_UTF8, 0, str, len, NULL, 0, NULL, NULL );
+        if (size && !(data = malloc( size ))) return E_OUTOFMEMORY;
+        WideCharToMultiByte( CP_UTF8, 0, str, len, (char *)data, size, NULL, NULL );
+    }
+    else
+    {
+        size = len * 2;
+        if (size && !(data = malloc( size ))) return E_OUTOFMEMORY;
+        for (i = 0; i < len; i++)
+        {
+            BYTE lo = str[i] & 0xff, hi = str[i] >> 8;
+            data[2 * i] = encoding == UnicodeEncoding_Utf16LE ? lo : hi;
+            data[2 * i + 1] = encoding == UnicodeEncoding_Utf16LE ? hi : lo;
+        }
+    }
+    if (FAILED(hr = content_create( L"Windows.Web.Http.HttpStringContent", data, size, NULL, &content )))
+    {
+        free( data );
+        return hr;
+    }
+    type = media_type && WindowsGetStringLen( media_type ) ? WindowsGetStringRawBuffer( media_type, NULL ) : L"text/plain";
+    len = wcslen( type ) + 32;
+    if (!(header = malloc( len * sizeof(WCHAR) ))) hr = E_OUTOFMEMORY;
+    else
+    {
+        swprintf( header, len, L"%s; charset=%s", type, charsets[encoding] );
+        hr = headers_set( content->headers, L"Content-Type", header, FALSE );
+        free( header );
+    }
+    if (FAILED(hr))
+    {
+        content_Release( &content->IHttpContent_iface );
+        return hr;
+    }
+    *value = &content->IHttpContent_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI string_content_factory_CreateFromString( IHttpStringContentFactory *iface, HSTRING text, IHttpContent **value )
+{
+    TRACE( "iface %p, text %s, value %p.\n", iface, debugstr_hstring(text), value );
+    return string_content_create( text, UnicodeEncoding_Utf8, NULL, value );
+}
