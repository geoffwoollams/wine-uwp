+
+static HRESULT add_request_header( void *ctx, const WCHAR *name, const WCHAR *value )
+{
+    HINTERNET handle = ctx;
+    SIZE_T len = wcslen( name ) + wcslen( value ) + 3;
+    WCHAR *line;
+    BOOL ret;
+
+    if (!wcsicmp( name, L"Content-Length" ) || !wcsicmp( name, L"Host" )) return S_OK;   /* winhttp's */
+    if (!(line = malloc( len * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    swprintf( line, len, L"%s: %s", name, value );
+    ret = WinHttpAddRequestHeaders( handle, line, -1, WINHTTP_ADDREQ_FLAG_ADD | WINHTTP_ADDREQ_FLAG_COALESCE_WITH_COMMA );
+    free( line );
+    return ret ? S_OK : HRESULT_FROM_WIN32( GetLastError() );
+}
+
+static BOOL is_content_header( const WCHAR *name )
+{
+    static const WCHAR *const names[] =
+    {
+        L"Content-Disposition", L"Content-Encoding", L"Content-Language", L"Content-Length", L"Content-Location",
+        L"Content-MD5", L"Content-Range", L"Content-Type", L"Expires", L"Last-Modified",
+    };
+    UINT32 i;
+    for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcsicmp( name, names[i] )) return TRUE;
+    return FALSE;
+}
+
+/* splits winhttp's raw response headers between the response's and its content's */
+static HRESULT parse_response_headers( const WCHAR *raw, struct headers *response, struct headers *content, BOOL decoded )
+{
+    const WCHAR *line = raw, *end, *colon;
+    HRESULT hr = S_OK;
+
+    /* the first line is the status line */
+    if ((end = wcsstr( line, L"\r\n" ))) line = end + 2;
+    for (; SUCCEEDED(hr) && *line; line = *end ? end + 2 : end)
+    {
+        WCHAR *name, *value;
+        const WCHAR *v;
+
+        if (!(end = wcsstr( line, L"\r\n" ))) end = line + wcslen( line );
+        if (end == line) continue;
+        for (colon = line; colon < end && *colon != ':'; colon++);
+        if (colon == end) continue;
+        for (v = colon + 1; v < end && (*v == ' ' || *v == '\t'); v++);
+        name = wcsdup_n( line, colon - line );
+        value = wcsdup_n( v, end - v );
+        if (!name || !value) hr = E_OUTOFMEMORY;
+        /* a body winhttp decompressed no longer has its encoding or length */
+        else if (decoded && (!wcsicmp( name, L"Content-Encoding" ) || !wcsicmp( name, L"Content-Length" ))) ;
+        else hr = headers_set( is_content_header( name ) ? content : response, name, value, TRUE );
+        free( name );
+        free( value );
+    }
+    return hr;
+}
+
+static HRESULT winhttp_error( void )
+{
+    DWORD error = GetLastError();
+    if (error == ERROR_WINHTTP_OPERATION_CANCELLED) return HRESULT_FROM_WIN32( ERROR_CANCELLED );
+    return HRESULT_FROM_WIN32( error );
+}
+
+static HRESULT query_string( HINTERNET handle, DWORD level, WCHAR **out )
+{
+    DWORD size = 0;
+
+    *out = NULL;
+    WinHttpQueryHeaders( handle, level, WINHTTP_HEADER_NAME_BY_INDEX, NULL, &size, WINHTTP_NO_HEADER_INDEX );
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER) return winhttp_error();
+    if (!(*out = malloc( size + sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    if (!WinHttpQueryHeaders( handle, level, WINHTTP_HEADER_NAME_BY_INDEX, *out, &size, WINHTTP_NO_HEADER_INDEX ))
+    {
+        free( *out );
+        *out = NULL;
+        return winhttp_error();
+    }
+    return S_OK;
+}
+
+static HRESULT request_body( IHttpRequestMessage *request, HINTERNET handle, BYTE **data, SIZE_T *size )
+{
+    IAsyncOperationWithProgress_IBuffer_UINT64 *op;
+    IHttpContentHeaderCollection *headers;
+    IHttpContent *content;
+    IBuffer *buffer;
+    UINT32 length;
+    BYTE *bytes;
+    HRESULT hr;
+
+    *data = NULL;
+    *size = 0;
+    if (FAILED(hr = IHttpRequestMessage_get_Content( request, &content )) || !content) return hr;
+    if (SUCCEEDED(hr = IHttpContent_get_Headers( content, &headers )))
+    {
+        hr = for_each_header( (IInspectable *)headers, add_request_header, handle );
+        IHttpContentHeaderCollection_Release( headers );
+    }
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = IHttpContent_ReadAsBufferAsync( content, &op )))
+    {
+        hr = async_wait( op, &IID_IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT64, &buffer );
+        IAsyncOperationWithProgress_IBuffer_UINT64_Release( op );
+        if (SUCCEEDED(hr))
+        {
+            if (SUCCEEDED(hr = buffer_data( buffer, &bytes, &length )) && length)
+            {
+                if (!(*data = malloc( length ))) hr = E_OUTOFMEMORY;
+                else
+                {
+                    memcpy( *data, bytes, length );
+                    *size = length;
+                }
+            }
+            IBuffer_Release( buffer );
+        }
+    }
+    IHttpContent_Release( content );
+    return hr;
+}
+
+static HRESULT send_work( void *data, union async_result *result )
+{
+    struct send_context *ctx = data;
+    WCHAR *host = NULL, *path = NULL, *method = NULL, *text, *final_url = NULL;
+    IHttpRequestHeaderCollection *request_headers;
+    URL_COMPONENTS url = { sizeof(url) };
+    struct response *response = NULL;
+    struct content *content;
+    HINTERNET connection = NULL, handle = NULL;
+    BYTE *body = NULL, *received = NULL, *grown;
+    SIZE_T body_size, received_size = 0, capacity = 0;
+    DWORD status, size, option;
+    IUriRuntimeClass *uri = NULL, *redirected;
+    IHttpMethod *http_method = NULL;
+    HSTRING str = NULL;
+    BOOL decoded = FALSE;
+    HRESULT hr;
+
+    InitOnceExecuteOnce( &session_once, init_session, NULL, NULL );
+    if (!session) return HRESULT_FROM_WIN32( ERROR_WINHTTP_INTERNAL_ERROR );
+
+    if (FAILED(hr = IHttpRequestMessage_get_RequestUri( ctx->request, &uri ))) goto done;
+    if (!uri) { hr = E_ILLEGAL_METHOD_CALL; goto done; }
+    if (FAILED(hr = IUriRuntimeClass_get_AbsoluteUri( uri, &str ))) goto done;
+    if (!(text = hstring_dup( str ))) { hr = E_OUTOFMEMORY; goto done; }
+    WindowsDeleteString( str );
+    str = NULL;
+    url.dwHostNameLength = url.dwUrlPathLength = url.dwExtraInfoLength = url.dwSchemeLength = ~0u;
+    if (!WinHttpCrackUrl( text, 0, 0, &url ))
+    {
+        hr = winhttp_error();
+        free( text );
+        goto done;
+    }
+    host = wcsdup_n( url.lpszHostName, url.dwHostNameLength );
+    /* the path and the query */
+    path = wcsdup_n( url.lpszUrlPath, url.dwUrlPathLength + url.dwExtraInfoLength );
+    TRACE( "%s\n", debugstr_w(text) );
+    free( text );
+    if (!host || !path) { hr = E_OUTOFMEMORY; goto done; }
+    if (url.nScheme != INTERNET_SCHEME_HTTP && url.nScheme != INTERNET_SCHEME_HTTPS) { hr = E_INVALIDARG; goto done; }
+
+    if (FAILED(hr = IHttpRequestMessage_get_Method( ctx->request, &http_method ))) goto done;
+    if (FAILED(hr = IHttpMethod_get_Method( http_method, &str ))) goto done;
+    if (!(method = hstring_dup( str ))) { hr = E_OUTOFMEMORY; goto done; }
+
+    if (!(connection = WinHttpConnect( session, host, url.nPort, 0 ))) { hr = winhttp_error(); goto done; }
+    if (!(handle = WinHttpOpenRequest( connection, method, path, NULL, WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES,
+                                       url.nScheme == INTERNET_SCHEME_HTTPS ? WINHTTP_FLAG_SECURE : 0 )))
+    {
+        hr = winhttp_error();
+        goto done;
+    }
+    EnterCriticalSection( &ctx->cs );
+    ctx->handle = handle;
+    if (ctx->cancelled) hr = HRESULT_FROM_WIN32( ERROR_CANCELLED );
+    LeaveCriticalSection( &ctx->cs );
+    if (FAILED(hr)) goto done;
+
+    if (!ctx->settings.auto_redirect)
+    {
+        option = WINHTTP_DISABLE_REDIRECTS;
+        WinHttpSetOption( handle, WINHTTP_OPTION_DISABLE_FEATURE, &option, sizeof(option) );
+    }
+    if (ctx->settings.decompression)
+    {
+        option = WINHTTP_DECOMPRESSION_FLAG_ALL;
+        decoded = WinHttpSetOption( handle, WINHTTP_OPTION_DECOMPRESSION, &option, sizeof(option) );
+    }
+    if (ctx->settings.no_cookies)
+    {
+        option = WINHTTP_DISABLE_COOKIES;
+        WinHttpSetOption( handle, WINHTTP_OPTION_DISABLE_FEATURE, &option, sizeof(option) );
+    }
+
+    if (SUCCEEDED(hr = IHttpRequestMessage_get_Headers( ctx->request, &request_headers )))
+    {
+        hr = for_each_header( (IInspectable *)request_headers, add_request_header, handle );
+        IHttpRequestHeaderCollection_Release( request_headers );
+    }
+    if (FAILED(hr)) goto done;
+    if (FAILED(hr = request_body( ctx->request, handle, &body, &body_size ))) goto done;
+    if (body_size > MAXDWORD) { hr = E_OUTOFMEMORY; goto done; }
+
+    if (!WinHttpSendRequest( handle, WINHTTP_NO_ADDITIONAL_HEADERS, 0, body, body_size, body_size, 0 ) ||
+        !WinHttpReceiveResponse( handle, NULL ))
+    {
+        hr = winhttp_error();
+        goto done;
+    }
+
+    size = sizeof(status);
+    if (!WinHttpQueryHeaders( handle, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER, WINHTTP_HEADER_NAME_BY_INDEX,
+                              &status, &size, WINHTTP_NO_HEADER_INDEX ))
+    {
+        hr = winhttp_error();
+        goto done;
+    }
+    if (FAILED(hr = response_create( status, &response ))) goto done;
+    response->source = HttpResponseMessageSource_Network;
+    if (SUCCEEDED(query_string( handle, WINHTTP_QUERY_STATUS_TEXT, &text )))
+    {
+        WindowsCreateString( text, wcslen( text ), &response->reason );
+        free( text );
+    }
+    if (SUCCEEDED(query_string( handle, WINHTTP_QUERY_VERSION, &text )))
+    {
+        if (!wcscmp( text, L"HTTP/1.0" )) response->version = HttpVersion_Http10;
+        else if (!wcsncmp( text, L"HTTP/2", 6 )) response->version = HttpVersion_Http20;
+        free( text );
+    }
+
+    /* the body, all of it */
+    for (;;)
+    {
+        DWORD available = 0, read = 0;
+
+        if (!WinHttpQueryDataAvailable( handle, &available )) { hr = winhttp_error(); goto done; }
+        if (!available) break;
+        if (received_size + available > capacity)
+        {
+            capacity = max( capacity * 2, received_size + available );
+            if (!(grown = realloc( received, capacity ))) { hr = E_OUTOFMEMORY; goto done; }
+            received = grown;
+        }
+        if (!WinHttpReadData( handle, received + received_size, available, &read )) { hr = winhttp_error(); goto done; }
+        if (!read) break;
+        received_size += read;
+    }
+
+    if (FAILED(hr = content_create( L"Windows.Web.Http.HttpStreamContent", received, received_size, NULL, &content ))) goto done;
+    received = NULL;
+    IHttpContent_Release( response->content );
+    response->content = &content->IHttpContent_iface;
+    if (SUCCEEDED(query_string( handle, WINHTTP_QUERY_RAW_HEADERS_CRLF, &text )))
+    {
+        hr = parse_response_headers( text, response->headers, content->headers, decoded );
+        free( text );
+        if (FAILED(hr)) goto done;
+    }
+
+    /* after redirects, the request is for where the response came from */
+    size = 0;
+    WinHttpQueryOption( handle, WINHTTP_OPTION_URL, NULL, &size );
+    if (size && (final_url = malloc( size + sizeof(WCHAR) )) && WinHttpQueryOption( handle, WINHTTP_OPTION_URL, final_url, &size ))
+    {
+        WindowsDeleteString( str );
+        str = NULL;
+        if (SUCCEEDED(IUriRuntimeClass_get_AbsoluteUri( uri, &str )) && wcscmp( final_url, WindowsGetStringRawBuffer( str, NULL ) ) &&
+            SUCCEEDED(create_uri( final_url, &redirected )))
+        {
+            IHttpRequestMessage_put_RequestUri( ctx->request, redirected );
+            IUriRuntimeClass_Release( redirected );
+        }
+    }
+    IHttpRequestMessage_AddRef( (response->request = ctx->request) );
+    TRACE( "status %lu, %Iu bytes.\n", status, received_size );
+    result->object = (IUnknown *)&response->IHttpResponseMessage_iface;
+    response = NULL;
+
+done:
+    if (handle)
+    {
+        EnterCriticalSection( &ctx->cs );
+        ctx->handle = NULL;
+        LeaveCriticalSection( &ctx->cs );
+        WinHttpCloseHandle( handle );
+    }
+    if (connection) WinHttpCloseHandle( connection );
+    if (response) response_Release( &response->IHttpResponseMessage_iface );
+    if (http_method) IHttpMethod_Release( http_method );
+    if (uri) IUriRuntimeClass_Release( uri );
+    WindowsDeleteString( str );
+    free( final_url );
+    free( received );
+    free( body );
+    free( method );
+    free( host );
+    free( path );
+    if (FAILED(hr) && ctx->cancelled) hr = HRESULT_FROM_WIN32( ERROR_CANCELLED );
+    if (FAILED(hr)) WARN( "request failed, hr %#lx.\n", hr );
+    return hr;
+}
+
+static void send_cancel( void *data )
+{
+    struct send_context *ctx = data;
+
+    EnterCriticalSection( &ctx->cs );
+    ctx->cancelled = TRUE;
+    /* closing the request makes winhttp's blocking calls fail */
+    if (ctx->handle) WinHttpCloseHandle( ctx->handle );
+    ctx->handle = NULL;
+    LeaveCriticalSection( &ctx->cs );
+}
+
+static void send_free( void *data )
+{
+    struct send_context *ctx = data;
+
+    IHttpRequestMessage_Release( ctx->request );
+    ctx->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &ctx->cs );
+    free( ctx );
+}
+
+HRESULT http_send_async( const struct http_settings *settings, IHttpRequestMessage *request,
+                         IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **value )
+{
+    struct send_context *ctx;
+
+    if (!request || !value) return E_POINTER;
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return E_OUTOFMEMORY;
+    ctx->settings = *settings;
+    ctx->request = request;
+    IHttpRequestMessage_AddRef( request );
+    InitializeCriticalSectionEx( &ctx->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    ctx->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": send_context.cs");
+    return async_start( &IID_IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress, ASYNC_OBJECT, send_work, ctx,
+                        send_cancel, send_free, (void **)value );
+}
+
+/* ---- HttpClient ---- */
+
+struct client
+{
+    IHttpClient IHttpClient_iface;
+    IClosable IClosable_iface;
+    IStringable IStringable_iface;
+    LONG ref;
+    IHttpFilter *filter;
+    struct headers *defaults;
+};
+
+static inline struct client *impl_from_IHttpClient( IHttpClient *iface )
+{
+    return CONTAINING_RECORD( iface, struct client, IHttpClient_iface );
+}
+
+static HRESULT WINAPI client_QueryInterface( IHttpClient *iface, REFIID iid, void **out )
+{
+    struct client *impl = impl_from_IHttpClient( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IHttpClient ))
+        *out = &impl->IHttpClient_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else if (IsEqualGUID( iid, &IID_IStringable ))
+        *out = &impl->IStringable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI client_AddRef( IHttpClient *iface )
+{
+    return InterlockedIncrement( &impl_from_IHttpClient( iface )->ref );
+}
+
+static ULONG WINAPI client_Release( IHttpClient *iface )
+{
+    struct client *impl = impl_from_IHttpClient( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IHttpFilter_Release( impl->filter );
+        headers_release( impl->defaults );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI client_GetIids( IHttpClient *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI client_GetRuntimeClassName( IHttpClient *iface, HSTRING *name )
+{
+    static const WCHAR class_name[] = L"Windows.Web.Http.HttpClient";
+    return WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, name );
+}
+
+static HRESULT WINAPI client_GetTrustLevel( IHttpClient *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+struct merge_context
+{
+    struct headers *target;
+};
+
+static HRESULT merge_default_header( void *data, const WCHAR *name, const WCHAR *value )
+{
+    struct headers *target = data;
+    WCHAR *existing = headers_get( target, name );
+
+    /* the request's own headers win */
+    if (existing)
+    {
+        free( existing );
+        return S_OK;
+    }
+    return headers_set( target, name, value, FALSE );
+}
+
+static HRESULT client_send( struct client *impl, IHttpRequestMessage *request,
+                            IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **value )
+{
+    IHttpRequestHeaderCollection *headers;
+    IMap_HSTRING_HSTRING *map;
+    struct headers *target;
+    HRESULT hr;
+
+    if (!request) return E_POINTER;
+    if (impl->defaults->count && SUCCEEDED(IHttpRequestMessage_get_Headers( request, &headers )))
+    {
+        /* the request's headers are ours when it's ours: add the defaults it doesn't set */
+        if (SUCCEEDED(IHttpRequestHeaderCollection_QueryInterface( headers, &IID_IMap_HSTRING_HSTRING, (void **)&map )))
+        {
+            if (map->lpVtbl == &headers_map_vtbl)
+            {
+                target = impl_from_IMap_HSTRING_HSTRING( map );
+                for_each_header( (IInspectable *)&impl->defaults->IHttpRequestHeaderCollection_iface, merge_default_header, target );
+            }
+            IMap_HSTRING_HSTRING_Release( map );
+        }
+        IHttpRequestHeaderCollection_Release( headers );
+    }
+    hr = IHttpFilter_SendRequestAsync( impl->filter, request, value );
+    return hr;
+}
+
+static HRESULT client_send_method( struct client *impl, const WCHAR *method, IUriRuntimeClass *uri, IHttpContent *content,
+                                   IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **value )
+{
+    IHttpRequestMessage *request;
+    IHttpMethod *http_method;
+    HRESULT hr;
+
+    if (!uri) return E_POINTER;
+    if (FAILED(hr = method_create( method, wcslen( method ), &http_method ))) return hr;
+    hr = request_create( http_method, uri, &request );
+    IHttpMethod_Release( http_method );
+    if (FAILED(hr)) return hr;
+    if (content) IHttpRequestMessage_put_Content( request, content );
+    hr = client_send( impl, request, value );
+    IHttpRequestMessage_Release( request );
+    return hr;
+}
+
+static HRESULT WINAPI client_DeleteAsync( IHttpClient *iface, IUriRuntimeClass *uri,
+                                          IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **value )
+{
+    TRACE( "iface %p, uri %p, value %p.\n", iface, uri, value );
+    return client_send_method( impl_from_IHttpClient( iface ), L"DELETE", uri, NULL, value );
+}
+
+static HRESULT WINAPI client_GetAsync( IHttpClient *iface, IUriRuntimeClass *uri,
+                                       IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **value )
+{
+    TRACE( "iface %p, uri %p, value %p.\n", iface, uri, value );
+    return client_send_method( impl_from_IHttpClient( iface ), L"GET", uri, NULL, value );
+}
+
+static HRESULT WINAPI client_GetWithOptionAsync( IHttpClient *iface, IUriRuntimeClass *uri, HttpCompletionOption option,
+                                                 IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **value )
+{
+    TRACE( "iface %p, uri %p, option %d, value %p.\n", iface, uri, option, value );
+    /* the response is always read in full: ResponseHeadersRead only completes later than it would */
+    return client_send_method( impl_from_IHttpClient( iface ), L"GET", uri, NULL, value );
+}
+
+enum get_kind { GET_BUFFER, GET_STREAM, GET_STRING };
+
+struct get_context
+{
+    struct client *client;
+    IUriRuntimeClass *uri;
+    enum get_kind kind;
+};
+
+static HRESULT get_work( void *data, union async_result *result )
+{
+    struct get_context *ctx = data;
+    IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *op;
+    IHttpResponseMessage *response;
+    struct content *content;
+    IHttpContent *http_content;
+    HttpStatusCode status;
+    HRESULT hr;
+
+    if (FAILED(hr = client_send_method( ctx->client, L"GET", ctx->uri, NULL, &op ))) return hr;
+    hr = async_wait( op, &IID_IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress, &response );
+    IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress_Release( op );
+    if (FAILED(hr)) return hr;
+
+    IHttpResponseMessage_get_StatusCode( response, &status );
+    if (status < 200 || status > 299) hr = HTTP_E_STATUS_BASE | (status & 0xffff);
+    else if (SUCCEEDED(hr = IHttpResponseMessage_get_Content( response, &http_content )))
+    {
+        if (http_content->lpVtbl != &content_vtbl) hr = E_UNEXPECTED;   /* the default filter's content */
+        else
+        {
+            content = impl_from_IHttpContent( http_content );
+            if (SUCCEEDED(hr = content_buffer( content )))
+            {
+                if (ctx->kind == GET_STRING) hr = decode_text( content->headers, content->data, content->size, &result->string );
+                else if (content->size > UINT_MAX) hr = E_OUTOFMEMORY;
+                else if (ctx->kind == GET_BUFFER) hr = create_buffer( content->data, content->size, (IBuffer **)&result->object );
+                else hr = byte_stream_create( content->data, content->size, (IInputStream **)&result->object );
+            }
+        }
+        IHttpContent_Release( http_content );
+    }
+    IHttpResponseMessage_Release( response );
+    return hr;
+}
+
+static void get_free( void *data )
+{
+    struct get_context *ctx = data;
+    IHttpClient_Release( &ctx->client->IHttpClient_iface );
+    IUriRuntimeClass_Release( ctx->uri );
+    free( ctx );
+}
+
+static HRESULT client_get( struct client *impl, IUriRuntimeClass *uri, enum get_kind kind, const IID *iid, void **value )
+{
+    struct get_context *ctx;
+
+    if (!uri) return E_POINTER;
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return E_OUTOFMEMORY;
+    ctx->client = impl;
+    IHttpClient_AddRef( &impl->IHttpClient_iface );
+    ctx->uri = uri;
+    IUriRuntimeClass_AddRef( uri );
+    ctx->kind = kind;
+    return async_start( iid, kind == GET_STRING ? ASYNC_HSTRING : ASYNC_OBJECT, get_work, ctx, NULL, get_free, value );
+}
+
+static HRESULT WINAPI client_GetBufferAsync( IHttpClient *iface, IUriRuntimeClass *uri, IAsyncOperationWithProgress_IBuffer_HttpProgress **value )
+{
+    TRACE( "iface %p, uri %p, value %p.\n", iface, uri, value );
+    return client_get( impl_from_IHttpClient( iface ), uri, GET_BUFFER, &IID_IAsyncOperationWithProgress_IBuffer_HttpProgress, (void **)value );
+}
