+static HRESULT WINAPI headers_map_Insert( IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING value, boolean *replaced )
+{
+    struct headers *impl = impl_from_IMap_HSTRING_HSTRING( iface );
+    WCHAR *name = hstring_dup( key ), *str = hstring_dup( value );
+    HRESULT hr;
+
+    if (!name || !str) hr = E_OUTOFMEMORY;
+    else if (!valid_header_name( name )) hr = E_INVALIDARG;
+    else
+    {
+        EnterCriticalSection( &impl->cs );
+        *replaced = !!headers_find( impl, name );
+        hr = headers_set( impl, name, str, FALSE );
+        LeaveCriticalSection( &impl->cs );
+    }
+    free( name );
+    free( str );
+    return hr;
+}
+
+static HRESULT WINAPI headers_map_Remove( IMap_HSTRING_HSTRING *iface, HSTRING key )
+{
+    struct headers *impl = impl_from_IMap_HSTRING_HSTRING( iface );
+    WCHAR *name = hstring_dup( key );
+    HRESULT hr = E_BOUNDS;
+
+    if (!name) return E_OUTOFMEMORY;
+    EnterCriticalSection( &impl->cs );
+    if (headers_find( impl, name )) hr = headers_set( impl, name, NULL, FALSE );
+    LeaveCriticalSection( &impl->cs );
+    free( name );
+    return hr;
+}
+
+static HRESULT WINAPI headers_map_Clear( IMap_HSTRING_HSTRING *iface )
+{
+    struct headers *impl = impl_from_IMap_HSTRING_HSTRING( iface );
+    UINT32 i;
+
+    EnterCriticalSection( &impl->cs );
+    for (i = 0; i < impl->count; i++)
+    {
+        free( impl->items[i].name );
+        free( impl->items[i].value );
+    }
+    impl->count = 0;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
