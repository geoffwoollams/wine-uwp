+static HRESULT WINAPI headers_iterable_First( IIterable_IKeyValuePair_HSTRING_HSTRING *iface,
+                                              IIterator_IKeyValuePair_HSTRING_HSTRING **value )
+{
+    struct headers *impl = impl_from_IIterable_IKeyValuePair_HSTRING_HSTRING( iface );
+    struct header_iterator *iter;
+    HRESULT hr = S_OK;
+    UINT32 i;
+
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->IIterator_IKeyValuePair_HSTRING_HSTRING_iface.lpVtbl = &iterator_vtbl;
+    iter->ref = 1;
+    EnterCriticalSection( &impl->cs );
+    if (impl->count && !(iter->items = calloc( impl->count, sizeof(*iter->items) ))) hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < impl->count; i++, iter->count++)
+    {
+        iter->items[i].name = wcsdup( impl->items[i].name );
+        iter->items[i].value = wcsdup( impl->items[i].value );
+        if (!iter->items[i].name || !iter->items[i].value) hr = E_OUTOFMEMORY;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (FAILED(hr))
+    {
+        iterator_Release( &iter->IIterator_IKeyValuePair_HSTRING_HSTRING_iface );
+        return hr;
+    }
+    *value = &iter->IIterator_IKeyValuePair_HSTRING_HSTRING_iface;
