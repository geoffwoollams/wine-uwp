+/* ---- a generic IAsyncOperationWithProgress<T, P>: every instance has the same vtable layout ---- */
+
+struct generic_delegate;
+struct generic_delegate_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( struct generic_delegate *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( struct generic_delegate * );
+    ULONG (WINAPI *Release)( struct generic_delegate * );
+    HRESULT (WINAPI *Invoke)( struct generic_delegate *, void *operation, AsyncStatus status );
+};
+struct generic_delegate { const struct generic_delegate_vtbl *lpVtbl; };
+
+struct generic_async;
+struct generic_async_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( struct generic_async *, REFIID, void ** );
+    ULONG (WINAPI *AddRef)( struct generic_async * );
+    ULONG (WINAPI *Release)( struct generic_async * );
+    HRESULT (WINAPI *GetIids)( struct generic_async *, ULONG *, IID ** );
+    HRESULT (WINAPI *GetRuntimeClassName)( struct generic_async *, HSTRING * );
+    HRESULT (WINAPI *GetTrustLevel)( struct generic_async *, TrustLevel * );
+    HRESULT (WINAPI *put_Progress)( struct generic_async *, struct generic_delegate * );
+    HRESULT (WINAPI *get_Progress)( struct generic_async *, struct generic_delegate ** );
+    HRESULT (WINAPI *put_Completed)( struct generic_async *, struct generic_delegate * );
+    HRESULT (WINAPI *get_Completed)( struct generic_async *, struct generic_delegate ** );
+    HRESULT (WINAPI *GetResults)( struct generic_async *, void *results );
+};
+struct generic_async { const struct generic_async_vtbl *lpVtbl; };
+
+enum async_kind { ASYNC_OBJECT, ASYNC_HSTRING, ASYNC_UINT64, ASYNC_UINT32 };
+union async_result { IUnknown *object; HSTRING string; UINT64 number; UINT32 number32; };
+typedef HRESULT (*async_work)( void *context, union async_result *result );
+
+struct async_op
+{
+    struct generic_async iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    const IID *iid;
+    enum async_kind kind;
+    CRITICAL_SECTION cs;
+    AsyncStatus status;
+    HRESULT error;
+    struct generic_delegate *completed, *progress;
+    union async_result result;
+    async_work work;
+    void (*cancel)( void *context );
+    void (*free)( void *context );
+    void *context;
+};
+
+static void async_result_clear( enum async_kind kind, union async_result *result )
+{
+    if (kind == ASYNC_OBJECT && result->object) IUnknown_Release( result->object );
+    if (kind == ASYNC_HSTRING) WindowsDeleteString( result->string );
+    memset( result, 0, sizeof(*result) );
+}
+
+static inline struct async_op *async_from_iface( struct generic_async *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_op, iface );
+}
+
+static HRESULT WINAPI async_QueryInterface( struct generic_async *iface, REFIID iid, void **out )
+{
+    struct async_op *op = async_from_iface( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, op->iid ))
+        *out = &op->iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &op->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &op->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI async_AddRef( struct generic_async *iface )
+{
+    return InterlockedIncrement( &async_from_iface( iface )->ref );
+}
+
+static ULONG WINAPI async_Release( struct generic_async *iface )
+{
+    struct async_op *op = async_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &op->ref );
+
+    if (!ref)
+    {
+        if (op->completed) op->completed->lpVtbl->Release( op->completed );
+        if (op->progress) op->progress->lpVtbl->Release( op->progress );
+        async_result_clear( op->kind, &op->result );
+        if (op->free) op->free( op->context );
+        op->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &op->cs );
+        free( op );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI async_GetIids( struct generic_async *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI async_GetRuntimeClassName( struct generic_async *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI async_GetTrustLevel( struct generic_async *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI async_put_Progress( struct generic_async *iface, struct generic_delegate *handler )
+{
+    struct async_op *op = async_from_iface( iface );
+
+    EnterCriticalSection( &op->cs );
+    if (handler) handler->lpVtbl->AddRef( handler );
+    if (op->progress) op->progress->lpVtbl->Release( op->progress );
+    op->progress = handler;
+    LeaveCriticalSection( &op->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_get_Progress( struct generic_async *iface, struct generic_delegate **handler )
+{
+    struct async_op *op = async_from_iface( iface );
+
+    EnterCriticalSection( &op->cs );
+    if ((*handler = op->progress)) op->progress->lpVtbl->AddRef( op->progress );
+    LeaveCriticalSection( &op->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_put_Completed( struct generic_async *iface, struct generic_delegate *handler )
+{
+    struct async_op *op = async_from_iface( iface );
+    AsyncStatus status;
+
+    if (!handler) return E_POINTER;
+    EnterCriticalSection( &op->cs );
+    if (op->completed || op->status == Closed)
+    {
+        LeaveCriticalSection( &op->cs );
+        return op->completed ? E_ILLEGAL_DELEGATE_ASSIGNMENT : E_ILLEGAL_METHOD_CALL;
+    }
+    handler->lpVtbl->AddRef( handler );
+    op->completed = handler;
+    status = op->status;
+    LeaveCriticalSection( &op->cs );
+    /* a finished operation calls a handler set afterwards at once */
+    if (status != Started) handler->lpVtbl->Invoke( handler, &op->iface, status );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_get_Completed( struct generic_async *iface, struct generic_delegate **handler )
+{
+    struct async_op *op = async_from_iface( iface );
+
+    EnterCriticalSection( &op->cs );
+    if ((*handler = op->completed)) op->completed->lpVtbl->AddRef( op->completed );
+    LeaveCriticalSection( &op->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_GetResults( struct generic_async *iface, void *results )
+{
+    struct async_op *op = async_from_iface( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == Error) hr = op->error;
+    else if (op->status == Canceled) hr = HRESULT_FROM_WIN32( ERROR_CANCELLED );
+    else if (op->status != Completed) hr = E_ILLEGAL_METHOD_CALL;
+    else switch (op->kind)
+    {
+    case ASYNC_OBJECT:
+        if ((*(IUnknown **)results = op->result.object)) IUnknown_AddRef( op->result.object );
+        break;
+    case ASYNC_HSTRING:
+        hr = WindowsDuplicateString( op->result.string, (HSTRING *)results );
+        break;
+    case ASYNC_UINT64:
+        *(UINT64 *)results = op->result.number;
+        break;
+    case ASYNC_UINT32:
+        *(UINT32 *)results = op->result.number32;
+        break;
+    }
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static const struct generic_async_vtbl async_vtbl =
+{
+    async_QueryInterface,
+    async_AddRef,
+    async_Release,
+    async_GetIids,
+    async_GetRuntimeClassName,
+    async_GetTrustLevel,
+    async_put_Progress,
+    async_get_Progress,
+    async_put_Completed,
+    async_get_Completed,
+    async_GetResults,
+};
+
+DEFINE_IINSPECTABLE_( async_info, IAsyncInfo, struct async_op, impl_from_async_info, IAsyncInfo_iface, &impl->iface )
+
+static HRESULT WINAPI async_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct async_op *op = impl_from_async_info( iface );
+
+    EnterCriticalSection( &op->cs );
+    *status = op->status;
+    LeaveCriticalSection( &op->cs );
+    return op->status == Closed ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+
+static HRESULT WINAPI async_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )
+{
+    struct async_op *op = impl_from_async_info( iface );
+
+    EnterCriticalSection( &op->cs );
+    *error = op->status == Error ? op->error : op->status == Canceled ? HRESULT_FROM_WIN32( ERROR_CANCELLED ) : S_OK;
+    LeaveCriticalSection( &op->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Cancel( IAsyncInfo *iface )
+{
+    struct async_op *op = impl_from_async_info( iface );
+
+    TRACE( "iface %p.\n", iface );
+    EnterCriticalSection( &op->cs );
+    if (op->status == Started && op->cancel) op->cancel( op->context );
+    LeaveCriticalSection( &op->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Close( IAsyncInfo *iface )
+{
+    struct async_op *op = impl_from_async_info( iface );
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status == Started) hr = E_ILLEGAL_STATE_CHANGE;
+    else op->status = Closed;
+    LeaveCriticalSection( &op->cs );
+    return hr;
+}
+
+static const struct IAsyncInfoVtbl async_info_vtbl =
+{
+    async_info_QueryInterface,
+    async_info_AddRef,
+    async_info_Release,
+    /* IInspectable methods */
+    async_info_GetIids,
+    async_info_GetRuntimeClassName,
+    async_info_GetTrustLevel,
+    /* IAsyncInfo methods */
+    async_info_get_Id,
+    async_info_get_Status,
+    async_info_get_ErrorCode,
+    async_info_Cancel,
+    async_info_Close,
+};
+
+static void CALLBACK async_run( TP_CALLBACK_INSTANCE *instance, void *data )
+{
+    struct async_op *op = data;
+    struct generic_delegate *handler;
+    union async_result result = {0};
+    AsyncStatus status;
+    HRESULT hr;
+
+    hr = op->work( op->context, &result );
+
+    EnterCriticalSection( &op->cs );
+    if (hr == HRESULT_FROM_WIN32( ERROR_CANCELLED )) op->status = Canceled;
+    else if (FAILED(hr)) op->status = Error;
+    else op->status = Completed;
+    op->error = hr;
+    op->result = result;
+    status = op->status;
+    if ((handler = op->completed)) handler->lpVtbl->AddRef( handler );
+    LeaveCriticalSection( &op->cs );
+
+    if (FAILED(hr)) TRACE( "operation %p failed, hr %#lx.\n", op, hr );
+    if (handler)
+    {
+        handler->lpVtbl->Invoke( handler, &op->iface, status );
+        handler->lpVtbl->Release( handler );
+    }
+    async_Release( &op->iface );
+}
+
+/* starts work( context ) on the thread pool; free( context ) runs when the operation is released */
+static HRESULT async_start( const IID *iid, enum async_kind kind, async_work work, void *context,
+                            void (*cancel)( void * ), void (*free_context)( void * ), void **out )
+{
+    struct async_op *op;
+
+    if (!(op = calloc( 1, sizeof(*op) )))
+    {
+        if (free_context) free_context( context );
+        return E_OUTOFMEMORY;
+    }
+    op->iface.lpVtbl = &async_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &async_info_vtbl;
+    op->ref = 2;   /* one for the caller, one for the work */
+    op->iid = iid;
+    op->kind = kind;
+    op->status = Started;
+    op->work = work;
+    op->cancel = cancel;
+    op->free = free_context;
+    op->context = context;
+    InitializeCriticalSectionEx( &op->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    op->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": async_op.cs");
+    if (!TrySubmitThreadpoolCallback( async_run, op, NULL ))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        op->ref = 1;
+        async_Release( &op->iface );
+        return hr;
+    }
+    *out = &op->iface;
+    return S_OK;
+}
+
+/* waiting for any IAsyncOperationWithProgress<T, P> from a worker thread */
+
+struct wait_handler
+{
+    struct generic_delegate iface;
+    LONG ref;
+    const IID *iid;
+    HANDLE event;
+};
+
+static HRESULT WINAPI wait_QueryInterface( struct generic_delegate *iface, REFIID iid, void **out )
+{
+    struct wait_handler *impl = CONTAINING_RECORD( iface, struct wait_handler, iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, impl->iid ))
+    {
+        *out = iface;
+        InterlockedIncrement( &impl->ref );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI wait_AddRef( struct generic_delegate *iface )
+{
+    return InterlockedIncrement( &CONTAINING_RECORD( iface, struct wait_handler, iface )->ref );
+}
+
+static ULONG WINAPI wait_Release( struct generic_delegate *iface )
+{
+    struct wait_handler *impl = CONTAINING_RECORD( iface, struct wait_handler, iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        CloseHandle( impl->event );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI wait_Invoke( struct generic_delegate *iface, void *operation, AsyncStatus status )
+{
+    SetEvent( CONTAINING_RECORD( iface, struct wait_handler, iface )->event );
+    return S_OK;
+}
+
+static const struct generic_delegate_vtbl wait_vtbl = { wait_QueryInterface, wait_AddRef, wait_Release, wait_Invoke };
+
+/* waits for operation (any IAsyncOperationWithProgress, whose completion handler has interface handler_iid) and
+ * returns its GetResults */
+static HRESULT async_wait( void *operation, const IID *handler_iid, void *results )
+{
+    struct generic_async *op = operation;
+    struct wait_handler *handler;
+    HRESULT hr;
+
+    if (!(handler = calloc( 1, sizeof(*handler) ))) return E_OUTOFMEMORY;
+    handler->iface.lpVtbl = &wait_vtbl;
+    handler->ref = 1;
+    handler->iid = handler_iid;
+    if (!(handler->event = CreateEventW( NULL, TRUE, FALSE, NULL )))
+    {
+        free( handler );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    if (SUCCEEDED(hr = op->lpVtbl->put_Completed( op, &handler->iface )))
+    {
+        WaitForSingleObject( handler->event, INFINITE );
+        hr = op->lpVtbl->GetResults( op, results );
+    }
+    wait_Release( &handler->iface );
+    return hr;
+}
