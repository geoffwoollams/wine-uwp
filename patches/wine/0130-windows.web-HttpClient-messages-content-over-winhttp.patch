+/* the header text of a media type */
+static WCHAR *media_type_text( struct media_type *impl )
+{
+    UINT32 len = WindowsGetStringLen( impl->media_type ) + WindowsGetStringLen( impl->charset ) + 48;
+    WCHAR *text = malloc( len * sizeof(WCHAR) ), *p;
+
+    if (!text) return NULL;
+    p = text + swprintf( text, len, L"%s", WindowsGetStringRawBuffer( impl->media_type, NULL ) );
+    if (WindowsGetStringLen( impl->charset ))
+        p += swprintf( p, len - (p - text), L"; charset=%s", WindowsGetStringRawBuffer( impl->charset, NULL ) );
+    if (impl->has_quality)
+    {
+        /* q has at most three decimals */
+        int q = (int)(impl->quality * 1000 + 0.5);
+        if (q == 1000) swprintf( p, len - (p - text), L"; q=1" );
+        else
+        {
+            p += swprintf( p, len - (p - text), L"; q=0.%03d", q );
+            while (p[-1] == '0') *--p = 0;
+            if (p[-1] == '.') *--p = 0;
+        }
+    }
+    return text;
+}
