+static BOOL valid_media_type( HSTRING value )
+{
+    UINT32 len, i, slash = 0;
+    const WCHAR *str = WindowsGetStringRawBuffer( value, &len );
+
+    for (i = 0; i < len; i++)
+    {
+        if (str[i] == '/') slash++;
+        else if (str[i] <= ' ' || str[i] >= 0x7f || wcschr( L"()<>@,;:\\\"[]?={}", str[i] )) return FALSE;
+    }
+    return slash == 1 && str[0] != '/' && str[len - 1] != '/';
+}
