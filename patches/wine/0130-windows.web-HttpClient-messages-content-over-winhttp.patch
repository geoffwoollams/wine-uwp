+#define RESPONSE_OBJECT_PROPERTY( Name, field, Type )                                                         \
+    static HRESULT WINAPI response_get_##Name( IHttpResponseMessage *iface, Type **value )                    \
+    {                                                                                                         \
+        struct response *impl = impl_from_IHttpResponseMessage( iface );                                      \
+        EnterCriticalSection( &impl->cs );                                                                    \
+        if ((*value = impl->field)) Type##_AddRef( *value );                                                  \
+        LeaveCriticalSection( &impl->cs );                                                                    \
+        return S_OK;                                                                                          \
+    }                                                                                                         \
+    static HRESULT WINAPI response_put_##Name( IHttpResponseMessage *iface, Type *value )                     \
+    {                                                                                                         \
+        struct response *impl = impl_from_IHttpResponseMessage( iface );                                      \
+        if (value) Type##_AddRef( value );                                                                    \
+        EnterCriticalSection( &impl->cs );                                                                    \
+        if (impl->field) Type##_Release( impl->field );                                                       \
+        impl->field = value;                                                                                  \
+        LeaveCriticalSection( &impl->cs );                                                                    \
+        return S_OK;                                                                                          \
+    }
+
+#define RESPONSE_VALUE_PROPERTY( Name, field, Type )                                                          \
+    static HRESULT WINAPI response_get_##Name( IHttpResponseMessage *iface, Type *value )                     \
+    {                                                                                                         \
+        *value = impl_from_IHttpResponseMessage( iface )->field;                                              \
+        return S_OK;                                                                                          \
+    }                                                                                                         \
+    static HRESULT WINAPI response_put_##Name( IHttpResponseMessage *iface, Type value )                      \
+    {                                                                                                         \
+        impl_from_IHttpResponseMessage( iface )->field = value;                                               \
+        return S_OK;                                                                                          \
+    }
