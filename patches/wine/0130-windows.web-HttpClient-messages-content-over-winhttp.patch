+static HRESULT header_values_add( struct header_values *impl, HSTRING input, boolean *ok )
+{
+    WCHAR *value = hstring_dup( input ), *start, *end;
+    HRESULT hr = S_OK;
+
+    if (!value) return E_OUTOFMEMORY;
+    for (start = value; *start == ' ' || *start == '\t'; start++);
+    for (end = start + wcslen( start ); end > start && (end[-1] == ' ' || end[-1] == '\t'); end--);
+    *end = 0;
+    if (!*start || wcspbrk( start, L"\r\n" ))
+    {
+        if (ok) *ok = FALSE;
+        else hr = E_INVALIDARG;
+    }
+    else
+    {
+        if (ok) *ok = TRUE;
+        hr = headers_set( impl->headers, impl->name, start, TRUE );
+    }
+    free( value );
+    return hr;
+}
