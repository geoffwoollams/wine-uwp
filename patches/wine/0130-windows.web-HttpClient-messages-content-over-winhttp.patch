+{
+    struct media_type *impl = impl_from_IHttpMediaTypeWithQualityHeaderValue( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    if (!valid_media_type( value )) return E_INVALIDARG;
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    WindowsDeleteString( impl->media_type );
+    impl->media_type = copy;
+    return S_OK;
+}
