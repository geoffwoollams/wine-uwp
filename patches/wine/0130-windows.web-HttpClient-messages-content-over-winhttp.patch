+/* calls callback( name, value ) for each header of any IIterable<IKeyValuePair<HSTRING, HSTRING>> */
+static HRESULT for_each_header( IInspectable *collection, HRESULT (*callback)( void *, const WCHAR *, const WCHAR * ), void *ctx )
+{
+    IIterable_IKeyValuePair_HSTRING_HSTRING *iterable;
+    IIterator_IKeyValuePair_HSTRING_HSTRING *iterator;
+    IKeyValuePair_HSTRING_HSTRING *pair;
+    HSTRING key, value;
+    boolean more;
+    HRESULT hr;
+
+    if (FAILED(hr = IInspectable_QueryInterface( collection, &IID_IIterable_IKeyValuePair_HSTRING_HSTRING, (void **)&iterable ))) return hr;
+    hr = IIterable_IKeyValuePair_HSTRING_HSTRING_First( iterable, &iterator );
+    IIterable_IKeyValuePair_HSTRING_HSTRING_Release( iterable );
+    if (FAILED(hr)) return hr;
+    while (SUCCEEDED(hr = IIterator_IKeyValuePair_HSTRING_HSTRING_get_HasCurrent( iterator, &more )) && more)
+    {
+        if (FAILED(hr = IIterator_IKeyValuePair_HSTRING_HSTRING_get_Current( iterator, &pair ))) break;
+        if (SUCCEEDED(hr = IKeyValuePair_HSTRING_HSTRING_get_Key( pair, &key )))
+        {
+            if (SUCCEEDED(hr = IKeyValuePair_HSTRING_HSTRING_get_Value( pair, &value )))
+            {
+                WCHAR *n = hstring_dup( key ), *v = hstring_dup( value );
+                hr = n && v ? callback( ctx, n, v ) : E_OUTOFMEMORY;
+                free( n );
+                free( v );
+                WindowsDeleteString( value );
+            }
+            WindowsDeleteString( key );
+        }
+        IKeyValuePair_HSTRING_HSTRING_Release( pair );
+        if (FAILED(hr)) break;
+        if (FAILED(hr = IIterator_IKeyValuePair_HSTRING_HSTRING_MoveNext( iterator, &more ))) break;
+    }
+    IIterator_IKeyValuePair_HSTRING_HSTRING_Release( iterator );
+    return hr;
+}
