+static HRESULT buffer_content_create( IBuffer *buffer, UINT32 offset, UINT32 count, BOOL whole, IHttpContent **value )
+{
+    struct content *content;
+    UINT32 length;
+    BYTE *bytes, *data = NULL;
+    HRESULT hr;
+
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = buffer_data( buffer, &bytes, &length ))) return hr;
+    if (whole) count = length;
+    else if (offset > length || count > length - offset) return E_BOUNDS;
+    if (count && !(data = malloc( count ))) return E_OUTOFMEMORY;
+    memcpy( data, bytes + offset, count );
+    if (FAILED(hr = content_create( L"Windows.Web.Http.HttpBufferContent", data, count, NULL, &content )))
+    {
+        free( data );
+        return hr;
+    }
+    *value = &content->IHttpContent_iface;
+    return S_OK;
