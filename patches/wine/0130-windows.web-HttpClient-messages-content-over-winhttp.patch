+struct write_context
+{
+    struct content *content;
+    IOutputStream *stream;
+};
+
+static HRESULT write_work( void *data, union async_result *result )
+{
+    struct write_context *ctx = data;
+    IAsyncOperationWithProgress_UINT32_UINT32 *op;
+    IBuffer *buffer;
+    UINT32 written;
+    HRESULT hr;
+
+    if (FAILED(hr = content_buffer( ctx->content ))) return hr;
+    if (ctx->content->size > UINT_MAX) return E_OUTOFMEMORY;
+    if (FAILED(hr = create_buffer( ctx->content->data, ctx->content->size, &buffer ))) return hr;
+    if (SUCCEEDED(hr = IOutputStream_WriteAsync( ctx->stream, buffer, &op )))
+    {
+        hr = async_wait( op, &IID_IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32, &written );
+        IAsyncOperationWithProgress_UINT32_UINT32_Release( op );
+        if (SUCCEEDED(hr)) result->number = written;
+    }
+    IBuffer_Release( buffer );
+    return hr;
+}
+
+static void write_free( void *data )
+{
+    struct write_context *ctx = data;
+    IHttpContent_Release( &ctx->content->IHttpContent_iface );
+    IOutputStream_Release( ctx->stream );
+    free( ctx );
+}
+
+static HRESULT WINAPI content_WriteToStreamAsync( IHttpContent *iface, IOutputStream *stream,
+                                                  IAsyncOperationWithProgress_UINT64_UINT64 **value )
+{
+    struct write_context *ctx;
+
+    TRACE( "iface %p, stream %p, value %p.\n", iface, stream, value );
+    if (!stream) return E_POINTER;
+    if (!(ctx = calloc( 1, sizeof(*ctx) ))) return E_OUTOFMEMORY;
+    ctx->content = impl_from_IHttpContent( iface );
+    IHttpContent_AddRef( iface );
+    ctx->stream = stream;
+    IOutputStream_AddRef( stream );
+    return async_start( &IID_IAsyncOperationWithProgress_UINT64_UINT64, ASYNC_UINT64, write_work, ctx, NULL, write_free,
+                        (void **)value );
+}
