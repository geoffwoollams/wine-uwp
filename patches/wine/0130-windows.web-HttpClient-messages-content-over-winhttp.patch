+/* reads a stream content's source into memory, from a worker thread */
+static HRESULT content_buffer( struct content *impl )
+{
+    IInputStream *source;
+    SIZE_T size;
+    BYTE *data;
+    HRESULT hr;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->buffered)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return S_OK;
+    }
+    source = impl->source;
+    impl->source = NULL;
+    LeaveCriticalSection( &impl->cs );
+    if (!source) return E_ILLEGAL_METHOD_CALL;   /* another thread is reading it */
+
+    hr = read_input_stream( source, &data, &size );
+    IInputStream_Release( source );
+    EnterCriticalSection( &impl->cs );
+    if (SUCCEEDED(hr))
+    {
+        impl->data = data;
+        impl->size = size;
+        impl->buffered = TRUE;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
