+static HRESULT WINAPI response_get_IsSuccessStatusCode( IHttpResponseMessage *iface, boolean *value )
+{
+    HttpStatusCode status = impl_from_IHttpResponseMessage( iface )->status;
+    *value = status >= 200 && status <= 299;
+    return S_OK;
+}
+
+static HRESULT WINAPI response_get_ReasonPhrase( IHttpResponseMessage *iface, HSTRING *value )
+{
+    struct response *impl = impl_from_IHttpResponseMessage( iface );
+    HRESULT hr;
+
+    EnterCriticalSection( &impl->cs );
+    hr = WindowsDuplicateString( impl->reason, value );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI response_put_ReasonPhrase( IHttpResponseMessage *iface, HSTRING value )
+{
+    struct response *impl = impl_from_IHttpResponseMessage( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    EnterCriticalSection( &impl->cs );
+    WindowsDeleteString( impl->reason );
+    impl->reason = copy;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI response_EnsureSuccessStatusCode( IHttpResponseMessage *iface, IHttpResponseMessage **value )
+{
+    HttpStatusCode status = impl_from_IHttpResponseMessage( iface )->status;
+
+    *value = NULL;
+    if (status < 200 || status > 299) return HTTP_E_STATUS_BASE | (status & 0xffff);
+    *value = iface;
+    IHttpResponseMessage_AddRef( iface );
+    return S_OK;
+}
