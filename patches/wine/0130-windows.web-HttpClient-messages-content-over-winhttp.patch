+/* ---- an IInputStream over bytes in memory ---- */
+
+struct byte_stream
+{
+    IInputStream IInputStream_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    BYTE *data;
+    UINT32 size, position;
+};
+
+static inline struct byte_stream *impl_from_IInputStream( IInputStream *iface )
+{
+    return CONTAINING_RECORD( iface, struct byte_stream, IInputStream_iface );
+}
+
+static HRESULT WINAPI byte_stream_QueryInterface( IInputStream *iface, REFIID iid, void **out )
+{
+    struct byte_stream *impl = impl_from_IInputStream( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IInputStream ))
+        *out = &impl->IInputStream_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI byte_stream_AddRef( IInputStream *iface )
+{
+    return InterlockedIncrement( &impl_from_IInputStream( iface )->ref );
+}
+
+static ULONG WINAPI byte_stream_Release( IInputStream *iface )
+{
+    struct byte_stream *impl = impl_from_IInputStream( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl->data );
+        free( impl );
+    }
+    return ref;
+}
