+/* ---- header collections: request, response and content headers ---- */
+
+enum header_kind { HEADERS_REQUEST, HEADERS_RESPONSE, HEADERS_CONTENT };
+
+struct header
+{
+    WCHAR *name;
+    WCHAR *value;
+};
+
+struct headers
+{
+    IHttpRequestHeaderCollection IHttpRequestHeaderCollection_iface;
+    IHttpResponseHeaderCollection IHttpResponseHeaderCollection_iface;
+    IHttpContentHeaderCollection IHttpContentHeaderCollection_iface;
+    IMap_HSTRING_HSTRING IMap_HSTRING_HSTRING_iface;
+    IIterable_IKeyValuePair_HSTRING_HSTRING IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+    LONG ref;
+    enum header_kind kind;
+    CRITICAL_SECTION cs;
+    struct header *items;
+    UINT32 count, capacity;
+};
+
+static IInspectable *headers_outer( struct headers *impl )
+{
+    switch (impl->kind)
+    {
+    case HEADERS_REQUEST: return (IInspectable *)&impl->IHttpRequestHeaderCollection_iface;
+    case HEADERS_RESPONSE: return (IInspectable *)&impl->IHttpResponseHeaderCollection_iface;
+    default: return (IInspectable *)&impl->IHttpContentHeaderCollection_iface;
+    }
+}
+
+static struct header *headers_find( struct headers *impl, const WCHAR *name )
+{
+    UINT32 i;
+    for (i = 0; i < impl->count; i++) if (!wcsicmp( impl->items[i].name, name )) return &impl->items[i];
+    return NULL;
+}
+
+/* sets (replace) or appends a value; a NULL value removes the header */
+static HRESULT headers_set( struct headers *impl, const WCHAR *name, const WCHAR *value, BOOL append )
+{
+    struct header *header;
+    HRESULT hr = S_OK;
+    WCHAR *joined;
+
+    EnterCriticalSection( &impl->cs );
+    if ((header = headers_find( impl, name )))
+    {
+        if (!value)
+        {
+            free( header->name );
+            free( header->value );
+            *header = impl->items[--impl->count];
+        }
+        else if (append && *header->value)
+        {
+            /* several values of a header are one comma-separated value; cookies use semicolons */
+            const WCHAR *sep = wcsicmp( name, L"Cookie" ) ? L", " : L"; ";
+            SIZE_T len = wcslen( header->value ) + wcslen( sep ) + wcslen( value ) + 1;
+            if (!(joined = malloc( len * sizeof(WCHAR) ))) hr = E_OUTOFMEMORY;
+            else
+            {
+                swprintf( joined, len, L"%s%s%s", header->value, sep, value );
+                free( header->value );
+                header->value = joined;
+            }
+        }
+        else if (!(joined = wcsdup( value ))) hr = E_OUTOFMEMORY;
+        else
+        {
+            free( header->value );
+            header->value = joined;
+        }
+    }
+    else if (value)
+    {
+        if (impl->count == impl->capacity)
+        {
+            UINT32 capacity = max( 8, impl->capacity * 2 );
+            struct header *items = realloc( impl->items, capacity * sizeof(*items) );
+            if (!items) hr = E_OUTOFMEMORY;
+            else
+            {
+                impl->items = items;
+                impl->capacity = capacity;
+            }
+        }
+        if (SUCCEEDED(hr))
+        {
+            header = &impl->items[impl->count];
+            header->name = wcsdup( name );
+            header->value = wcsdup( value );
+            if (!header->name || !header->value)
+            {
+                free( header->name );
+                free( header->value );
+                hr = E_OUTOFMEMORY;
+            }
+            else impl->count++;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static WCHAR *headers_get( struct headers *impl, const WCHAR *name )
+{
+    struct header *header;
+    WCHAR *ret = NULL;
+
+    EnterCriticalSection( &impl->cs );
+    if ((header = headers_find( impl, name ))) ret = wcsdup( header->value );
+    LeaveCriticalSection( &impl->cs );
+    return ret;
+}
+
+static BOOL valid_header_name( const WCHAR *name )
+{
+    if (!*name) return FALSE;
+    for (; *name; name++) if (*name <= ' ' || *name >= 0x7f || wcschr( L"()<>@,;:\\\"/[]?={}", *name )) return FALSE;
+    return TRUE;
+}
+
+static HRESULT headers_append_hstring( struct headers *impl, HSTRING name, HSTRING value, boolean *ok )
+{
+    WCHAR *n = hstring_dup( name ), *v = hstring_dup( value );
+    HRESULT hr;
+
+    if (!n || !v) hr = E_OUTOFMEMORY;
+    else if (!valid_header_name( n ))
+    {
+        if (ok) *ok = FALSE;
+        hr = ok ? S_OK : E_INVALIDARG;
+    }
+    else
+    {
+        if (ok) *ok = TRUE;
+        hr = headers_set( impl, n, v, TRUE );
+    }
+    free( n );
+    free( v );
+    return hr;
+}
+
+static HRESULT headers_create( enum header_kind kind, struct headers **out );
+static ULONG headers_release( struct headers *impl );
