+/* reads all of an input stream, from a worker thread */
+static HRESULT read_input_stream( IInputStream *stream, BYTE **data, SIZE_T *size )
+{
+    IAsyncOperationWithProgress_IBuffer_UINT32 *op;
+    SIZE_T capacity = 0;
+    IBuffer *buffer, *result;
+    UINT32 length;
+    BYTE *bytes, *grown;
+    HRESULT hr;
+
+    *data = NULL;
+    *size = 0;
+    {
+        IBufferFactory *factory;
+        if (FAILED(hr = activation_factory( L"Windows.Storage.Streams.Buffer", &IID_IBufferFactory, (void **)&factory ))) return hr;
+        hr = IBufferFactory_Create( factory, 65536, &buffer );
+        IBufferFactory_Release( factory );
+        if (FAILED(hr)) return hr;
+    }
+    for (;;)
+    {
+        if (FAILED(hr = IInputStream_ReadAsync( stream, buffer, 65536, InputStreamOptions_Partial, &op ))) break;
+        hr = async_wait( op, &IID_IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32, &result );
+        IAsyncOperationWithProgress_IBuffer_UINT32_Release( op );
+        if (FAILED(hr)) break;
+        hr = buffer_data( result, &bytes, &length );
+        if (SUCCEEDED(hr) && length)
+        {
+            if (*size + length > capacity)
+            {
+                capacity = max( capacity * 2, *size + length );
+                if (!(grown = realloc( *data, capacity ))) hr = E_OUTOFMEMORY;
+                else *data = grown;
+            }
+            if (SUCCEEDED(hr))
+            {
+                memcpy( *data + *size, bytes, length );
+                *size += length;
+            }
+        }
+        IBuffer_Release( result );
+        if (FAILED(hr) || !length) break;
+    }
+    IBuffer_Release( buffer );
+    if (FAILED(hr))
+    {
+        free( *data );
+        *data = NULL;
+        *size = 0;
+    }
+    return hr;
+}
