+static HRESULT read_string_work( void *data, union async_result *result )
+{
+    struct content *impl = data;
+    HRESULT hr;
+
+    if (FAILED(hr = content_buffer( impl ))) return hr;
+    return decode_text( impl->headers, impl->data, impl->size, &result->string );
+}
