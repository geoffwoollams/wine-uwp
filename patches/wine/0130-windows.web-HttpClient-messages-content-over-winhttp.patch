+DEFINE_IINSPECTABLE_( accept_vector, IVector_HttpMediaTypeWithQualityHeaderValue, struct header_values,
+                      impl_from_IVector_HttpMediaTypeWithQualityHeaderValue, IVector_iface, &impl->iface )
+
+/* finds entry index of the header, or counts them */
+static UINT32 accept_entries( struct header_values *impl, UINT32 index, WCHAR **entry )
+{
+    WCHAR *value = headers_get( impl->headers, impl->name ), *p, *start;
+    UINT32 count = 0;
+    BOOL quoted = FALSE;
+
+    if (entry) *entry = NULL;
+    if (!value) return 0;
+    for (p = start = value;; p++)
+    {
+        if (*p == '"') quoted = !quoted;
+        if (*p && (*p != ',' || quoted)) continue;
+        while (*start == ' ') start++;
+        if (p > start)
+        {
+            if (entry && count == index) *entry = wcsdup_n( start, p - start );
+            count++;
+        }
+        if (!*p) break;
+        start = p + 1;
+    }
+    free( value );
+    return count;
+}
+
+static HRESULT WINAPI accept_vector_GetAt( IVector_HttpMediaTypeWithQualityHeaderValue *iface, UINT32 index,
+                                           IHttpMediaTypeWithQualityHeaderValue **value )
+{
+    struct header_values *impl = impl_from_IVector_HttpMediaTypeWithQualityHeaderValue( iface );
+    WCHAR *entry;
+    HRESULT hr;
+
+    accept_entries( impl, index, &entry );
+    if (!entry) return E_BOUNDS;
+    hr = media_type_parse( entry, wcslen( entry ), value );
+    free( entry );
+    return hr;
+}
