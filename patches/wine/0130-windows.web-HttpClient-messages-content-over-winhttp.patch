+/* the text of a body: UTF-16 when it says so (charset or byte order mark), otherwise UTF-8 */
+static HRESULT decode_text( struct headers *headers, const BYTE *data, SIZE_T size, HSTRING *out )
+{
+    WCHAR *type = headers ? headers_get( headers, L"Content-Type" ) : NULL, *text;
+    BOOL utf16 = FALSE, big_endian = FALSE;
+    int len;
+    HRESULT hr;
+
+    if (type)
+    {
+        _wcslwr( type );
+        if (wcsstr( type, L"charset=utf-16be" ) || wcsstr( type, L"charset=\"utf-16be\"" )) utf16 = big_endian = TRUE;
+        else if (wcsstr( type, L"charset=utf-16" ) || wcsstr( type, L"charset=\"utf-16" )) utf16 = TRUE;
+        free( type );
+    }
+    if (size >= 2 && data[0] == 0xff && data[1] == 0xfe) { utf16 = TRUE; big_endian = FALSE; data += 2; size -= 2; }
+    else if (size >= 2 && data[0] == 0xfe && data[1] == 0xff) { utf16 = TRUE; big_endian = TRUE; data += 2; size -= 2; }
+    else if (size >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf) { utf16 = FALSE; data += 3; size -= 3; }
+
+    if (utf16)
+    {
+        SIZE_T i, count = size / 2;
+        if (!(text = malloc( (count + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+        for (i = 0; i < count; i++)
+            text[i] = big_endian ? (data[2 * i] << 8) | data[2 * i + 1] : data[2 * i] | (data[2 * i + 1] << 8);
+        hr = WindowsCreateString( text, count, out );
+        free( text );
+        return hr;
+    }
+    if (size > INT_MAX) return E_OUTOFMEMORY;
+    len = MultiByteToWideChar( CP_UTF8, 0, (const char *)data, size, NULL, 0 );
+    if (!(text = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    MultiByteToWideChar( CP_UTF8, 0, (const char *)data, size, text, len );
+    hr = WindowsCreateString( text, len, out );
+    free( text );
+    return hr;
+}
