+}
+static HRESULT WINAPI blob_map_iterator_get_HasCurrent( struct blob_map_iterator *it, boolean *value ) { *value = it->pos < it->map->count; return S_OK; }
+static HRESULT WINAPI blob_map_iterator_MoveNext( struct blob_map_iterator *it, boolean *value )
+{
+    if (it->pos < it->map->count) it->pos++;
+    *value = it->pos < it->map->count;
+    return S_OK;
