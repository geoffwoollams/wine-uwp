+/* Windows.Gaming.XboxLive.Storage: Xbox Live connected storage (GameSaveProvider), kept on the local disk.
+ *
+ * There is no Xbox Live save service, so containers live in the package's LocalState folder:
+ *   %LOCALAPPDATA%\Packages\<package family>\LocalState\XboxGameSaves\<service config id>\<container>\<blob>
+ * Container and blob names are stored with every character outside [A-Za-z0-9_-] written as %XX (UTF-16 code units
+ * as %uXXXX), so any name maps to one valid file name; files whose names start with '%' followed by a non-hex
+ * letter are this file's own metadata.  Updates are written to temporary files first and then moved into place.
+ * Nothing is synchronised anywhere: NeedsSync is always FALSE. */
+#include "private.h"
+#include "appmodel.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+extern HRESULT completed_object_operation( IUnknown *obj, void **out );
+extern HRESULT completed_int_operation( INT32 result, void **out );
+extern HRESULT completed_int64_operation( INT64 result, void **out );
+
+/* GameSaveErrorStatus */
+#define GS_OK                       0
+#define GS_INVALID_CONTAINER_NAME   ((INT32)0x80830001)
+#define GS_NO_ACCESS                ((INT32)0x80830002)
+#define GS_OUT_OF_LOCAL_STORAGE     ((INT32)0x80830003)
+#define GS_PROVIDED_BUFFER_TOO_SMALL ((INT32)0x80830007)
+#define GS_BLOB_NOT_FOUND           ((INT32)0x80830008)
