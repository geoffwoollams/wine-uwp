+static HRESULT WINAPI blob_map_iterator_get_Current( struct blob_map_iterator *it, void **value )
+{
+    struct blob_pair *pair;
+
+    *value = NULL;
+    if (it->pos >= it->map->count) return E_BOUNDS;
+    if (!(pair = obj_alloc( sizeof(*pair), blob_pair_vtbl, &IID_IKeyValuePair_HSTRING_IBuffer, NULL, blob_pair_destroy )))
+        return E_OUTOFMEMORY;
+    pair->map = it->map;
+    pair->index = it->pos;
+    InterlockedIncrement( &it->map->obj.ref );
+    *value = &pair->obj.vtbl;
