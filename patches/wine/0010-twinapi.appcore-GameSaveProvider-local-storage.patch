+/* ---------------- sorted lists for queries ---------------- */
+
+struct list_builder
+{
+    void **items;
+    UINT32 count, capacity;
+    const WCHAR *prefix;
+    UINT32 prefix_len;
+    BOOL failed;
+};
+
+static BOOL builder_matches( struct list_builder *builder, const WCHAR *name )
+{
+    return !builder->prefix_len || !wcsncmp( name, builder->prefix, builder->prefix_len );
+}
+static void builder_add( struct list_builder *builder, void *item )
+{
+    if (!item) { builder->failed = TRUE; return; }
+    if (builder->count == builder->capacity)
+    {
+        UINT32 capacity = builder->capacity ? builder->capacity * 2 : 8;
+        void **items = realloc( builder->items, capacity * sizeof(*items) );
+        if (!items) { builder->failed = TRUE; call_release( item ); return; }
+        builder->items = items;
+        builder->capacity = capacity;
+    }
+    builder->items[builder->count++] = item;
+}
+
+static int compare_item_names( const void *a, const void *b )
+{
+    /* container_info and blob_info both start with obj then name */
+    const struct blob_info *x = CONTAINING_RECORD( *(void *const *)a, struct blob_info, obj.vtbl );
+    const struct blob_info *y = CONTAINING_RECORD( *(void *const *)b, struct blob_info, obj.vtbl );
+    INT32 order = 0;
+    WindowsCompareStringOrdinal( x->name, y->name, &order );
+    return order;
+}
+
+/* Keeps items [start, start + max) (max 0: all) and builds the vector view. */
+static struct vector *builder_finish( struct list_builder *builder, UINT32 start, UINT32 max, const GUID *view_iid,
+                                      const GUID *iterable_iid, const GUID *iterator_iid )
+{
+    struct vector *vector;
+    UINT32 i, end;
+
+    qsort( builder->items, builder->count, sizeof(*builder->items), compare_item_names );
+    if (start > builder->count) start = builder->count;
+    end = max && max < builder->count - start ? start + max : builder->count;
+    for (i = 0; i < builder->count; i++)
+        if (i < start || i >= end) call_release( builder->items[i] );
+    if (start) memmove( builder->items, builder->items + start, (end - start) * sizeof(*builder->items) );
+    if (!(vector = vector_create( view_iid, iterable_iid, iterator_iid, FALSE, builder->items, end - start )))
+    {
+        for (i = 0; i < end - start; i++) call_release( builder->items[i] );
+        free( builder->items );
+    }
+    return vector;
+}
