+{
+    HRESULT hr = completed_ptr_operation( NULL, out );
+    if (SUCCEEDED(hr))
+    {
+        ((async_op *)*out)->is_int64 = TRUE;
+        ((async_op *)*out)->int64_result = result;
+    }
+    return hr;
+}
