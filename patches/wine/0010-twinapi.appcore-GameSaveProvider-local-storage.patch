+/* ---------------- IGameSaveProviderStatics ---------------- */
+
+static HRESULT WINAPI statics_GetForUserAsync( void *iface, IUnknown *user, HSTRING scid, void **operation )
+{
+    WCHAR local_state[MAX_PATH], file[GS_MAX_NAME * 7 + 1];
+    struct provider *provider;
+
+    TRACE( "user %p, service config id %s.\n", user, debugstr_hstring( scid ) );
+    if (!get_local_state( local_state, ARRAY_SIZE(local_state) ))
+    {
+        WARN( "no package identity: no LocalState folder for game saves.\n" );
+        return complete_with_result( &IID_IGameSaveProviderGetResult, L"Windows.Gaming.XboxLive.Storage.GameSaveProviderGetResult",
+                                     GS_NO_ACCESS, NULL, operation );
+    }
+    if (!(provider = obj_alloc( sizeof(*provider), provider_vtbl, &IID_IGameSaveProvider,
+                                L"Windows.Gaming.XboxLive.Storage.GameSaveProvider", provider_destroy )))
+        return E_OUTOFMEMORY;
+    if ((provider->user = user)) IUnknown_AddRef( user );
+    if (!hstring_to_file_name( scid, file, ARRAY_SIZE(file) )) wcscpy( file, L"default" );
+    if (swprintf( provider->root, MAX_PATH, L"%s\\XboxGameSaves\\%s", local_state, file ) < 0)
+    {
+        obj_release( &provider->obj );
+        return E_INVALIDARG;
+    }
+    FIXME( "Xbox Live connected storage is kept locally in %s.\n", debugstr_w( provider->root ) );
+    return complete_with_result( &IID_IGameSaveProviderGetResult, L"Windows.Gaming.XboxLive.Storage.GameSaveProviderGetResult",
+                                 GS_OK, &provider->obj.vtbl, operation );
+}
