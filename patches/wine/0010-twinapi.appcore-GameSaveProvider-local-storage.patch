+static HRESULT WINAPI provider_GetRemainingBytesInQuotaAsync( struct provider *provider, void **operation )
+{
+    ULONGLONG used = 0;
+    enum_containers( provider, add_size, &used );
+    TRACE( "provider %p: %s bytes used.\n", provider, wine_dbgstr_longlong( used ) );
+    return completed_int64_operation( used < GS_QUOTA ? GS_QUOTA - used : 0, operation );
+}
+static HRESULT WINAPI provider_get_ContainersChangedSinceLastSync( struct provider *provider, void **value )
+{
+    struct vector *vector;
+    if (!(vector = vector_create( &IID_IVectorView_HSTRING, &IID_IIterable_HSTRING, &IID_IIterator_HSTRING, TRUE, NULL, 0 )))
+        return E_OUTOFMEMORY;
+    *value = &vector->obj.vtbl;
+    return S_OK;
+}
+static const void *const provider_vtbl[] = { BASE, provider_get_User, provider_CreateContainer, provider_DeleteContainerAsync,
+    provider_CreateContainerInfoQuery, provider_CreateContainerInfoQueryWithName, provider_GetRemainingBytesInQuotaAsync,
+    provider_get_ContainersChangedSinceLastSync };
