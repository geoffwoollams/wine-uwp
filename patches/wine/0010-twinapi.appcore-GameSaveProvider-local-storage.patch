+/* ---------------- GameSaveContainerInfoQuery ---------------- */
+
+struct container_query
+{
+    struct gs_object obj;
+    struct provider *provider;
+    WCHAR prefix[GS_MAX_NAME + 1];
+};
+static void container_query_destroy( struct gs_object *obj )
+{
+    struct container_query *query = CONTAINING_RECORD( obj, struct container_query, obj );
