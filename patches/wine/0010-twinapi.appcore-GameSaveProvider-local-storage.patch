+struct provider
+{
+    struct gs_object obj;
+    IUnknown *user;
+    WCHAR root[MAX_PATH];   /* ...\LocalState\XboxGameSaves\<scid> */
+};
+
+static void provider_destroy( struct gs_object *obj )
+{
+    struct provider *provider = CONTAINING_RECORD( obj, struct provider, obj );
