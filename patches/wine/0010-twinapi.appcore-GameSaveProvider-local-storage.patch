+    struct blob_map *map;
+    if (!(map = obj_alloc( sizeof(*map), blob_map_vtbl, &IID_IMapView_HSTRING_IBuffer, NULL, blob_map_destroy ))) return NULL;
+    map->obj.vtbl2 = blob_map_iterable_vtbl;
+    map->obj.iid2 = &IID_IIterable_IKeyValuePair_HSTRING_IBuffer;
+    return map;
