+static void add_container_info( void *ctx, const WCHAR *name, const WCHAR *dir )
+{
+    struct list_builder *builder = ctx;
+    struct container_info *info;
+    FILETIME modified;
+
+    if (!builder_matches( builder, name )) return;
+    if (!(info = obj_alloc( sizeof(*info), container_info_vtbl, &IID_IGameSaveContainerInfo,
+                            L"Windows.Gaming.XboxLive.Storage.GameSaveContainerInfo", container_info_destroy )))
+    {
+        builder->failed = TRUE;
+        return;
+    }
+    WindowsCreateString( name, wcslen( name ), &info->name );
+    info->display_name = read_display_name( dir );
+    info->size = container_size( dir, &modified, NULL );
+    info->modified = ((INT64)modified.dwHighDateTime << 32) | modified.dwLowDateTime;
+    builder_add( builder, &info->obj.vtbl );
+}
+
+static HRESULT container_query_run( struct container_query *query, UINT32 start, UINT32 max, void **operation )
+{
+    struct list_builder builder = { .prefix = query->prefix, .prefix_len = wcslen( query->prefix ) };
+    struct vector *vector;
+
+    enum_containers( query->provider, add_container_info, &builder );
+    vector = builder_finish( &builder, start, max, &IID_IVectorView_GameSaveContainerInfo, &IID_IIterable_GameSaveContainerInfo,
+                             &IID_IIterator_GameSaveContainerInfo );
+    if (!vector) return E_OUTOFMEMORY;
+    TRACE( "prefix %s -> %u containers.\n", debugstr_w( query->prefix ), vector->count );
+    return complete_with_result( &IID_IGameSaveContainerInfoGetResult, L"Windows.Gaming.XboxLive.Storage.GameSaveContainerInfoGetResult",
+                                 builder.failed ? GS_NO_ACCESS : GS_OK, &vector->obj.vtbl, operation );
+}
+static HRESULT WINAPI container_query_GetContainerInfoAsync( struct container_query *query, void **operation )
+{
+    return container_query_run( query, 0, 0, operation );
+}
+static HRESULT WINAPI container_query_GetContainerInfoWithIndexAndMaxAsync( struct container_query *query, UINT32 start, UINT32 max, void **operation )
+{
+    return container_query_run( query, start, max, operation );
+}
+static void count_container( void *ctx, const WCHAR *name, const WCHAR *dir )
+{
+    struct list_builder *builder = ctx;
+    if (builder_matches( builder, name )) builder->count++;
+}
+static HRESULT WINAPI container_query_GetItemCountAsync( struct container_query *query, void **operation )
+{
+    struct list_builder builder = { .prefix = query->prefix, .prefix_len = wcslen( query->prefix ) };
+    enum_containers( query->provider, count_container, &builder );
+    return completed_int_operation( builder.count, operation );
+}
