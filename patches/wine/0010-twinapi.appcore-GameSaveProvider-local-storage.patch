+/* Completed IAsyncOperation<T*> keeping the caller's reference to obj; GetResults hands out new references. */
+HRESULT completed_object_operation( IUnknown *obj, void **out )
+{
+    HRESULT hr = completed_ptr_operation( obj, out );
+    if (SUCCEEDED(hr)) ((async_op *)*out)->owns_ptr = TRUE;
+    else if (obj) IUnknown_Release( obj );
+    return hr;
+}
+
+/* Completed IAsyncOperation<INT64> / IAsyncOperation<UINT64>. */
