+/* The display name is kept in "%display" (UTF-16, not a valid encoded name, so never a blob). */
+static const WCHAR display_name_file[] = L"%display";
+
+static HSTRING read_display_name( const WCHAR *dir )
+{
+    WCHAR path[MAX_PATH], buffer[GS_MAX_NAME + 1];
+    DWORD read = 0;
+    HSTRING str = NULL;
+    HANDLE file;
+
+    if (!join_path( path, dir, display_name_file )) return NULL;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    if (ReadFile( file, buffer, sizeof(buffer) - sizeof(WCHAR), &read, NULL ))
+        WindowsCreateString( buffer, read / sizeof(WCHAR), &str );
+    CloseHandle( file );
+    return str;
+}
