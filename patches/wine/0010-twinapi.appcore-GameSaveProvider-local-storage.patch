+/* A completed IAsyncOperation<result>; takes over the reference to value. */
+static HRESULT complete_with_result( const GUID *iid, const WCHAR *class_name, INT32 status, void *value, void **operation )
+{
+    struct result *result;
+
+    if (status) WARN( "%s status %#x.\n", debugstr_w( class_name ), status );
+    if (!(result = obj_alloc( sizeof(*result), result_vtbl, iid, class_name, result_destroy )))
+    {
+        call_release( value );
+        return E_OUTOFMEMORY;
+    }
+    result->status = status;
+    result->value = value;
+    return completed_object_operation( (IUnknown *)&result->obj.vtbl, operation );
+}
