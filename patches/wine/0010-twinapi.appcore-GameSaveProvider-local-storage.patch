+/* IMapView<String, IBuffer> + IIterable<IKeyValuePair<String, IBuffer>>, for GetAsync results. */
+struct blob_map
+{
+    struct gs_object obj;
+    UINT32 count;
+    HSTRING *names;
+    struct buffer **buffers;
+};
+struct blob_pair
+{
+    struct gs_object obj;
+    struct blob_map *map;
+    UINT32 index;
+};
+struct blob_map_iterator
+{
+    struct gs_object obj;
