+/* Calls callback for every container directory (name decoded). */
+static void enum_containers( struct provider *provider, void (*callback)( void *ctx, const WCHAR *name, const WCHAR *dir ), void *ctx )
+{
+    WCHAR pattern[MAX_PATH], name[GS_MAX_NAME + 1], dir[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    HANDLE find;
+
+    if (!join_path( pattern, provider->root, L"*" )) return;
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) || !decode_name( data.cFileName, name, ARRAY_SIZE(name) )) continue;
+        if (join_path( dir, provider->root, data.cFileName )) callback( ctx, name, dir );
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+}
+
+/* Total size of the blobs in a container, and the time of its newest blob. */
+static ULONGLONG container_size( const WCHAR *dir, FILETIME *modified, UINT32 *blobs )
+{
+    WCHAR pattern[MAX_PATH], name[GS_MAX_NAME + 1];
+    WIN32_FIND_DATAW data;
+    ULONGLONG size = 0;
+    HANDLE find;
+
+    if (modified) memset( modified, 0, sizeof(*modified) );
+    if (blobs) *blobs = 0;
+    if (!join_path( pattern, dir, L"*" )) return 0;
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return 0;
+    do
+    {
+        if (!is_blob_file( &data, name, ARRAY_SIZE(name) )) continue;
+        size += file_size( &data );
+        if (blobs) (*blobs)++;
+        if (modified && CompareFileTime( &data.ftLastWriteTime, modified ) > 0) *modified = data.ftLastWriteTime;
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+    return size;
+}
+
+static void add_size( void *ctx, const WCHAR *name, const WCHAR *dir ) { *(ULONGLONG *)ctx += container_size( dir, NULL, NULL ); }
