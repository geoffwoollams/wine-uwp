+static BOOL blob_map_add( struct blob_map *map, HSTRING name, struct buffer *buffer )
+{
+    HSTRING *names;
+    struct buffer **buffers;
+
+    if (!(names = realloc( map->names, (map->count + 1) * sizeof(*names) ))) return FALSE;
+    map->names = names;
+    if (!(buffers = realloc( map->buffers, (map->count + 1) * sizeof(*buffers) ))) return FALSE;
+    map->buffers = buffers;
+    if (FAILED(WindowsDuplicateString( name, &map->names[map->count] ))) return FALSE;
+    map->buffers[map->count++] = buffer;
+    return TRUE;
+}
