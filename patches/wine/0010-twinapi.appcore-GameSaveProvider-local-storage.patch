+/* ---------------- read-only collections we return ---------------- */
+
+/* IVectorView<T> + IIterable<T> over interface pointers or HSTRINGs. */
+struct vector
+{
+    struct gs_object obj;
+    BOOL strings;
+    UINT32 count;
+    void **items;
+    const GUID *iterator_iid;
+};
+struct iterator
+{
+    struct gs_object obj;
+    struct vector *vector;
+    UINT32 pos;
+};
+
+static void vector_destroy( struct gs_object *obj )
+{
+    struct vector *vector = CONTAINING_RECORD( obj, struct vector, obj );
+    UINT32 i;
+    for (i = 0; i < vector->count; i++)
+        if (vector->strings) WindowsDeleteString( vector->items[i] ); else call_release( vector->items[i] );
+    free( vector->items );
+    free( vector );
+}
+static HRESULT vector_item( struct vector *vector, UINT32 index, void **value )
+{
+    if (index >= vector->count) { *value = NULL; return E_BOUNDS; }
+    if (vector->strings) return WindowsDuplicateString( vector->items[index], (HSTRING *)value );
+    *value = vector->items[index];
+    base_AddRef( *value );
+    return S_OK;
+}
+static HRESULT WINAPI vector_GetAt( struct vector *vector, UINT32 index, void **value ) { return vector_item( vector, index, value ); }
+static HRESULT WINAPI vector_get_Size( struct vector *vector, UINT32 *value ) { *value = vector->count; return S_OK; }
+static HRESULT WINAPI vector_IndexOf( struct vector *vector, void *value, UINT32 *index, boolean *found )
+{
+    UINT32 i;
+    INT32 order;
+    for (i = 0; i < vector->count; i++)
+    {
+        if (vector->strings ? SUCCEEDED(WindowsCompareStringOrdinal( vector->items[i], value, &order )) && !order
+                            : vector->items[i] == value)
+        {
+            *index = i;
+            *found = TRUE;
+            return S_OK;
+        }
+    }
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+static HRESULT WINAPI vector_GetMany( struct vector *vector, UINT32 start, UINT32 size, void **items, UINT32 *count )
+{
+    UINT32 i;
+    for (i = 0; i < size && start + i < vector->count; i++) vector_item( vector, start + i, &items[i] );
+    *count = i;
+    return S_OK;
+}
+static const void *const vector_vtbl[] = { BASE, vector_GetAt, vector_get_Size, vector_IndexOf, vector_GetMany };
+
+static void iterator_destroy( struct gs_object *obj )
+{
+    struct iterator *iterator = CONTAINING_RECORD( obj, struct iterator, obj );
+    obj_release( &iterator->vector->obj );
+    free( iterator );
+}
+static HRESULT WINAPI iterator_get_Current( struct iterator *it, void **value ) { return vector_item( it->vector, it->pos, value ); }
+static HRESULT WINAPI iterator_get_HasCurrent( struct iterator *it, boolean *value ) { *value = it->pos < it->vector->count; return S_OK; }
+static HRESULT WINAPI iterator_MoveNext( struct iterator *it, boolean *value )
+{
+    if (it->pos < it->vector->count) it->pos++;
+    *value = it->pos < it->vector->count;
+    return S_OK;
+}
+static HRESULT WINAPI iterator_GetMany( struct iterator *it, UINT32 size, void **items, UINT32 *count )
+{
+    vector_GetMany( it->vector, it->pos, size, items, count );
+    it->pos += *count;
+    return S_OK;
+}
+static const void *const iterator_vtbl[] = { BASE, iterator_get_Current, iterator_get_HasCurrent, iterator_MoveNext, iterator_GetMany };
+
+static HRESULT WINAPI vector_First( void *iface, void **value )
+{
+    struct vector *vector = CONTAINING_RECORD( obj_from_iface2( iface ), struct vector, obj );
+    struct iterator *it;
+
+    if (!(it = obj_alloc( sizeof(*it), iterator_vtbl, vector->iterator_iid, NULL, iterator_destroy ))) return E_OUTOFMEMORY;
+    it->vector = vector;
+    InterlockedIncrement( &vector->obj.ref );
+    *value = &it->obj.vtbl;
+    return S_OK;
+}
+static const void *const vector_iterable_vtbl[] = { BASE2, vector_First };
+
+/* Takes over items (references / strings) and the array. */
+static struct vector *vector_create( const GUID *view_iid, const GUID *iterable_iid, const GUID *iterator_iid,
+                                     BOOL strings, void **items, UINT32 count )
+{
+    struct vector *vector;
+    if (!(vector = obj_alloc( sizeof(*vector), vector_vtbl, view_iid, NULL, vector_destroy ))) return NULL;
+    vector->obj.vtbl2 = vector_iterable_vtbl;
+    vector->obj.iid2 = iterable_iid;
+    vector->iterator_iid = iterator_iid;
+    vector->strings = strings;
+    vector->items = items;
+    vector->count = count;
+    return vector;
+}
