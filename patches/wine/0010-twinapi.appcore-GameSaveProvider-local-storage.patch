+static BOOL blob_map_find( struct blob_map *map, HSTRING key, UINT32 *index )
+{
+    INT32 order;
+    for (*index = 0; *index < map->count; (*index)++)
+        if (SUCCEEDED(WindowsCompareStringOrdinal( map->names[*index], key, &order )) && !order) return TRUE;
+    return FALSE;
+}
+static HRESULT WINAPI blob_map_Lookup( struct blob_map *map, HSTRING key, void **value )
+{
+    UINT32 index;
+    if (!blob_map_find( map, key, &index )) { *value = NULL; return E_BOUNDS; }
+    *value = &map->buffers[index]->obj.vtbl;
+    base_AddRef( *value );
+    return S_OK;
+}
