+static void blob_map_destroy( struct gs_object *obj )
+{
+    struct blob_map *map = CONTAINING_RECORD( obj, struct blob_map, obj );
+    UINT32 i;
+    for (i = 0; i < map->count; i++)
+    {
+        WindowsDeleteString( map->names[i] );
+        obj_release( &map->buffers[i]->obj );
+    }
+    free( map->names );
+    free( map->buffers );
