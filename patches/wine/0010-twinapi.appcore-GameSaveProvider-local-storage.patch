+/* Slot-call helpers for objects supplied by the app (collections, buffers). */
+typedef HRESULT (WINAPI *fn_out)( void *iface, void *out );
+typedef HRESULT (WINAPI *fn_qi)( void *iface, REFIID iid, void **out );
+typedef ULONG (WINAPI *fn_release)( void *iface );
+#define SLOT(obj, n) ((*(void ***)(obj))[n])
+static HRESULT call_qi( void *obj, REFIID iid, void **out ) { return ((fn_qi)SLOT( obj, 0 ))( obj, iid, out ); }
+static void call_release( void *obj ) { if (obj) ((fn_release)SLOT( obj, 2 ))( obj ); }
+static HRESULT call_out( void *obj, int slot, void *out ) { return ((fn_out)SLOT( obj, slot ))( obj, out ); }
+
+/* ---------------- common object base ---------------- */
+
+/* Every object here has up to two interfaces (main, and a second one such as IIterable) and one refcount. */
+struct gs_object
+{
+    const void *const *vtbl;
+    const void *const *vtbl2;
+    LONG ref;
+    const GUID *iid, *iid2, *iid3;   /* iid3 also answers with the main interface (e.g. IIterator) */
+    const WCHAR *class_name;
+    void (*destroy)( struct gs_object *obj );
+};
+
+static struct gs_object *obj_from_iface2( void *iface ) { return CONTAINING_RECORD( iface, struct gs_object, vtbl2 ); }
+
+static HRESULT obj_query_interface( struct gs_object *obj, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, obj->iid ) || (obj->iid3 && IsEqualGUID( iid, obj->iid3 )))
+        *out = &obj->vtbl;
+    else if (obj->iid2 && IsEqualGUID( iid, obj->iid2 ))
+        *out = &obj->vtbl2;
+    else
+    {
+        FIXME( "%s: %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( obj->class_name ), debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &obj->ref );
+    return S_OK;
+}
+static ULONG obj_release( struct gs_object *obj )
+{
+    ULONG ref = InterlockedDecrement( &obj->ref );
+    if (!ref) obj->destroy( obj );
+    return ref;
+}
+
+static HRESULT WINAPI base_QueryInterface( void *iface, REFIID iid, void **out ) { return obj_query_interface( iface, iid, out ); }
+static ULONG WINAPI base_AddRef( void *iface ) { return InterlockedIncrement( &((struct gs_object *)iface)->ref ); }
+static ULONG WINAPI base_Release( void *iface ) { return obj_release( iface ); }
+static HRESULT WINAPI base_GetIids( void *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI base_GetRuntimeClassName( void *iface, HSTRING *name )
+{
+    const WCHAR *class_name = ((struct gs_object *)iface)->class_name;
+    if (!class_name) return E_NOTIMPL;
+    return WindowsCreateString( class_name, wcslen( class_name ), name );
+}
+static HRESULT WINAPI base_GetTrustLevel( void *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+#define BASE base_QueryInterface, base_AddRef, base_Release, base_GetIids, base_GetRuntimeClassName, base_GetTrustLevel
+
+static HRESULT WINAPI base2_QueryInterface( void *iface, REFIID iid, void **out ) { return obj_query_interface( obj_from_iface2( iface ), iid, out ); }
+static ULONG WINAPI base2_AddRef( void *iface ) { return InterlockedIncrement( &obj_from_iface2( iface )->ref ); }
+static ULONG WINAPI base2_Release( void *iface ) { return obj_release( obj_from_iface2( iface ) ); }
+static HRESULT WINAPI base2_GetRuntimeClassName( void *iface, HSTRING *name ) { return base_GetRuntimeClassName( obj_from_iface2( iface ), name ); }
+#define BASE2 base2_QueryInterface, base2_AddRef, base2_Release, base_GetIids, base2_GetRuntimeClassName, base_GetTrustLevel
+
+static void *obj_alloc( size_t size, const void *const *vtbl, const GUID *iid, const WCHAR *class_name,
+                        void (*destroy)( struct gs_object * ) )
+{
+    struct gs_object *obj;
+    if (!(obj = calloc( 1, size ))) return NULL;
+    obj->vtbl = vtbl;
+    obj->ref = 1;
+    obj->iid = iid;
+    obj->class_name = class_name;
+    obj->destroy = destroy;
+    return obj;
+}
+
+/* ---------------- names and paths ---------------- */
+
+static BOOL plain_name_char( WCHAR c )
+{
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-';
+}
+
+/* Container / blob name -> file name; FALSE if the name is empty or too long. */
+static BOOL encode_name( const WCHAR *name, UINT32 len, WCHAR *out, UINT32 out_len )
+{
+    UINT32 i, pos = 0;
+
+    if (!len || len > GS_MAX_NAME) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        if (pos + 7 >= out_len) return FALSE;
+        if (plain_name_char( name[i] )) out[pos++] = name[i];
+        else if (name[i] < 0x100) pos += swprintf( out + pos, out_len - pos, L"%%%02X", name[i] );
+        else pos += swprintf( out + pos, out_len - pos, L"%%u%04X", name[i] );
+    }
+    out[pos] = 0;
+    return TRUE;
+}
+
+static int hex_value( WCHAR c )
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    return -1;
+}
+
+/* File name -> name; FALSE for files that are not containers or blobs (metadata, temporary files). */
+static BOOL decode_name( const WCHAR *file, WCHAR *out, UINT32 out_len )
+{
+    UINT32 pos = 0;
+    int digits, i, value;
+
+    while (*file)
+    {
+        if (pos + 1 >= out_len) return FALSE;
+        if (*file != '%') { out[pos++] = *file++; continue; }
+        file++;
+        digits = 2;
+        if (*file == 'u') { digits = 4; file++; }
+        for (i = value = 0; i < digits; i++)
+        {
+            int v = hex_value( file[i] );
+            if (v < 0) return FALSE;
+            value = value * 16 + v;
+        }
+        file += digits;
+        out[pos++] = value;
+    }
+    out[pos] = 0;
+    return pos > 0;
+}
+
+static BOOL hstring_to_file_name( HSTRING name, WCHAR *out, UINT32 out_len )
+{
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( name, &len );
+    return encode_name( str, len, out, out_len );
+}
+
+static BOOL get_local_state( WCHAR *path, UINT32 len )
+{
+    WCHAR base[MAX_PATH], family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1];
+    UINT32 family_len = ARRAY_SIZE(family);
+    DWORD n;
+
+    if (GetCurrentPackageFamilyName( &family_len, family )) return FALSE;
+    n = GetEnvironmentVariableW( L"LOCALAPPDATA", base, MAX_PATH );
+    if (!n || n >= MAX_PATH)
+    {
+        n = GetEnvironmentVariableW( L"USERPROFILE", base, MAX_PATH );
+        if (!n || n >= MAX_PATH - 16) return FALSE;
+        wcscat( base, L"\\AppData\\Local" );
+    }
+    return swprintf( path, len, L"%s\\Packages\\%s\\LocalState", base, family ) > 0;
+}
+
+static void create_directories( const WCHAR *path )
+{
+    WCHAR buffer[MAX_PATH], *p;
+
+    if (wcslen( path ) >= MAX_PATH) return;
+    wcscpy( buffer, path );
+    for (p = buffer + 3; *p; p++)
+    {
+        if (*p != '\\') continue;
+        *p = 0;
+        CreateDirectoryW( buffer, NULL );
+        *p = '\\';
+    }
+    CreateDirectoryW( buffer, NULL );
+}
+
+static BOOL join_path( WCHAR *out, const WCHAR *dir, const WCHAR *file )
+{
+    return wcslen( dir ) + wcslen( file ) + 2 <= MAX_PATH && swprintf( out, MAX_PATH, L"%s\\%s", dir, file ) > 0;
+}
+
+static ULONGLONG file_size( const WIN32_FIND_DATAW *data ) { return ((ULONGLONG)data->nFileSizeHigh << 32) | data->nFileSizeLow; }
+
+/* A data file of a container (not metadata, not a directory). */
+static BOOL is_blob_file( const WIN32_FIND_DATAW *data, WCHAR *name, UINT32 name_len )
+{
+    return !(data->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) && decode_name( data->cFileName, name, name_len );
+}
+
+/* ---------------- IBuffer ---------------- */
+
+struct buffer
+{
+    struct gs_object obj;   /* IBuffer, vtbl2: IBufferByteAccess */
+    UINT32 capacity, length;
+    BYTE *data;
+};
+
+static void buffer_destroy( struct gs_object *obj )
+{
+    struct buffer *buffer = CONTAINING_RECORD( obj, struct buffer, obj );
+    free( buffer->data );
+    free( buffer );
+}
+static HRESULT WINAPI buffer_get_Capacity( struct buffer *buffer, UINT32 *value ) { *value = buffer->capacity; return S_OK; }
+static HRESULT WINAPI buffer_get_Length( struct buffer *buffer, UINT32 *value ) { *value = buffer->length; return S_OK; }
+static HRESULT WINAPI buffer_put_Length( struct buffer *buffer, UINT32 value )
+{
+    if (value > buffer->capacity) return E_INVALIDARG;
+    buffer->length = value;
+    return S_OK;
+}
+static const void *const buffer_vtbl[] = { BASE, buffer_get_Capacity, buffer_get_Length, buffer_put_Length };
+
+/* IBufferByteAccess is an IUnknown interface: slot 3 Buffer */
+static HRESULT WINAPI byte_access_Buffer( void *iface, BYTE **value )
+{
+    *value = CONTAINING_RECORD( obj_from_iface2( iface ), struct buffer, obj )->data;
+    return S_OK;
+}
+static const void *const byte_access_vtbl[] = { base2_QueryInterface, base2_AddRef, base2_Release, byte_access_Buffer };
+
+static struct buffer *buffer_create( UINT32 size )
+{
+    struct buffer *buffer;
+
+    if (!(buffer = obj_alloc( sizeof(*buffer), buffer_vtbl, &IID_IBuffer_local, L"Windows.Storage.Streams.Buffer", buffer_destroy )))
+        return NULL;
+    buffer->obj.vtbl2 = byte_access_vtbl;
+    buffer->obj.iid2 = &IID_IBufferByteAccess_local;
+    if (!(buffer->data = malloc( size ? size : 1 ))) { free( buffer ); return NULL; }
+    buffer->capacity = buffer->length = size;
+    return buffer;
+}
+
+/* Data and length of an IBuffer supplied by the app. */
+static HRESULT buffer_bytes( void *buffer, BYTE **data, UINT32 *length, UINT32 *capacity )
+{
+    void *access;
+    HRESULT hr;
+
+    if (FAILED(hr = call_out( buffer, 7, length ))) return hr;              /* IBuffer::get_Length */
+    if (capacity && FAILED(hr = call_out( buffer, 6, capacity ))) return hr; /* IBuffer::get_Capacity */
+    if (FAILED(hr = call_qi( buffer, &IID_IBufferByteAccess_local, &access ))) return hr;
+    hr = call_out( access, 3, data );                                       /* IBufferByteAccess::Buffer */
+    call_release( access );
+    return hr;
+}
