+/* ---------------- GameSaveContainer ---------------- */
+
+struct container
+{
+    struct gs_object obj;
+    struct provider *provider;
+    HSTRING name;
+    BOOL valid;
+    WCHAR dir[MAX_PATH];
+};
+static void container_destroy( struct gs_object *obj )
+{
+    struct container *container = CONTAINING_RECORD( obj, struct container, obj );
+    obj_release( &container->provider->obj );
+    WindowsDeleteString( container->name );
+    free( container );
+}
+
+static HRESULT WINAPI container_get_Name( struct container *container, HSTRING *value ) { return WindowsDuplicateString( container->name, value ); }
+static HRESULT WINAPI container_get_Provider( struct container *container, void **value )
+{
+    *value = &container->provider->obj.vtbl;
+    base_AddRef( *value );
+    return S_OK;
+}
+
+static BOOL blob_path( struct container *container, HSTRING name, const WCHAR *prefix, WCHAR *path )
+{
+    WCHAR file[GS_MAX_NAME * 7 + 16];
+    if (!hstring_to_file_name( name, file + wcslen( prefix ), ARRAY_SIZE(file) - wcslen( prefix ) )) return FALSE;
+    memcpy( file, prefix, wcslen( prefix ) * sizeof(WCHAR) );
+    return join_path( path, container->dir, file );
+}
+
+static BOOL write_file( const WCHAR *path, const void *data, DWORD size )
+{
+    DWORD written = 0;
+    HANDLE file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    BOOL ret;
+
+    if (file == INVALID_HANDLE_VALUE) return FALSE;
+    ret = WriteFile( file, data, size, &written, NULL ) && written == size;
+    CloseHandle( file );
+    if (!ret) DeleteFileW( path );
+    return ret;
+}
+
+/* One pending write: a blob name and its data. */
+struct pending_write
+{
+    HSTRING name;
+    void *buffer;   /* the app's IBuffer, referenced */
+};
+
+/* Collects the (name, IBuffer) pairs of an IIterable<IKeyValuePair<String, T>>. */
+static HRESULT collect_pairs( void *collection, const GUID *iterable_iid, BOOL boxed, struct pending_write **out, UINT32 *count )
+{
+    void *iterable, *iterator, *pair, *value;
+    struct pending_write *writes = NULL, *grown;
+    boolean has = FALSE;
+    HRESULT hr;
+
+    *out = NULL;
+    *count = 0;
+    if (!collection) return S_OK;
+    if (FAILED(hr = call_qi( collection, iterable_iid, &iterable )))
+    {
+        WARN( "collection %p is not iterable, hr %#lx.\n", collection, hr );
+        return E_INVALIDARG;
+    }
+    hr = call_out( iterable, 6, &iterator );                                  /* IIterable::First */
+    call_release( iterable );
+    if (FAILED(hr)) return hr;
+    for (hr = call_out( iterator, 7, &has ); SUCCEEDED(hr) && has; hr = call_out( iterator, 8, &has ))
+    {
+        HSTRING name = NULL;
+        if (FAILED(hr = call_out( iterator, 6, &pair ))) break;               /* IIterator::get_Current */
+        hr = call_out( pair, 6, &name );                                      /* IKeyValuePair::get_Key */
+        if (SUCCEEDED(hr)) hr = call_out( pair, 7, &value );                  /* IKeyValuePair::get_Value */
+        call_release( pair );
+        if (SUCCEEDED(hr) && boxed && value)
+        {
+            void *buffer = NULL;
+            hr = call_qi( value, &IID_IBuffer_local, &buffer );
+            call_release( value );
+            value = buffer;
+            if (FAILED(hr)) WARN( "property set value for %s is not an IBuffer.\n", debugstr_hstring( name ) );
+        }
+        if (FAILED(hr) || !value || !(grown = realloc( writes, (*count + 1) * sizeof(*writes) )))
+        {
+            WindowsDeleteString( name );
+            if (SUCCEEDED(hr)) { call_release( value ); hr = value ? E_OUTOFMEMORY : E_INVALIDARG; }
+            break;
+        }
+        writes = grown;
+        writes[*count].name = name;
+        writes[(*count)++].buffer = value;
+    }
+    call_release( iterator );
+    *out = writes;
+    return hr;
+}
+
+static void free_pairs( struct pending_write *writes, UINT32 count )
+{
+    UINT32 i;
+    for (i = 0; i < count; i++)
+    {
+        WindowsDeleteString( writes[i].name );
+        call_release( writes[i].buffer );
+    }
+    free( writes );
+}
+
+/* Collects the strings of an IIterable<String> (NULL: none). */
+static HRESULT collect_strings( void *collection, HSTRING **out, UINT32 *count )
+{
+    void *iterable, *iterator;
+    HSTRING *names = NULL, *grown, name;
+    boolean has = FALSE;
+    HRESULT hr;
+
+    *out = NULL;
+    *count = 0;
+    if (!collection) return S_OK;
+    if (FAILED(hr = call_qi( collection, &IID_IIterable_HSTRING, &iterable ))) return E_INVALIDARG;
+    hr = call_out( iterable, 6, &iterator );
+    call_release( iterable );
+    if (FAILED(hr)) return hr;
+    for (hr = call_out( iterator, 7, &has ); SUCCEEDED(hr) && has; hr = call_out( iterator, 8, &has ))
+    {
+        if (FAILED(hr = call_out( iterator, 6, &name ))) break;
+        if (!(grown = realloc( names, (*count + 1) * sizeof(*names) ))) { WindowsDeleteString( name ); hr = E_OUTOFMEMORY; break; }
+        names = grown;
+        names[(*count)++] = name;
+    }
+    call_release( iterator );
+    *out = names;
+    return hr;
+}
+
+static void free_strings( HSTRING *names, UINT32 count )
+{
+    while (count--) WindowsDeleteString( names[count] );
+    free( names );
+}
+
+static INT32 submit_updates( struct container *container, struct pending_write *writes, UINT32 write_count,
+                             HSTRING *deletes, UINT32 delete_count, HSTRING display_name )
+{
+    WCHAR temp[MAX_PATH], path[MAX_PATH];
+    INT32 status = GS_OK;
+    UINT32 i, written;
+
+    if (!container->valid) return GS_INVALID_CONTAINER_NAME;
+    for (i = 0; i < write_count; i++)
+        if (!blob_path( container, writes[i].name, L"", path )) return GS_INVALID_CONTAINER_NAME;
+    create_directories( container->dir );
+
+    /* write everything to temporary files first, so a failure leaves the container as it was */
+    for (written = 0; written < write_count; written++)
+    {
+        BYTE *data;
+        UINT32 length;
+
+        if (FAILED(buffer_bytes( writes[written].buffer, &data, &length, NULL ))) { status = GS_NO_ACCESS; break; }
+        blob_path( container, writes[written].name, L"%tmp-", temp );
+        if (!write_file( temp, data, length )) { status = GS_OUT_OF_LOCAL_STORAGE; break; }
+    }
+    for (i = 0; i < written; i++)
+    {
+        blob_path( container, writes[i].name, L"%tmp-", temp );
+        if (status == GS_OK)
+        {
+            blob_path( container, writes[i].name, L"", path );
+            if (!MoveFileExW( temp, path, MOVEFILE_REPLACE_EXISTING )) status = GS_NO_ACCESS;
+        }
+        else DeleteFileW( temp );
+    }
+    if (status) return status;
+
+    for (i = 0; i < delete_count; i++)
+        if (blob_path( container, deletes[i], L"", path ) && !DeleteFileW( path ) && GetLastError() != ERROR_FILE_NOT_FOUND)
+            status = GS_NO_ACCESS;
+
+    if (display_name && WindowsGetStringLen( display_name ) && join_path( path, container->dir, display_name_file ))
+    {
+        UINT32 len;
+        const WCHAR *str = WindowsGetStringRawBuffer( display_name, &len );
+        write_file( path, str, min( len, GS_MAX_NAME ) * sizeof(WCHAR) );
+    }
+    TRACE( "container %s: %u written, %u deleted, status %#x.\n", debugstr_hstring( container->name ), write_count, delete_count, status );
+    return status;
+}
+
+static HRESULT WINAPI container_SubmitUpdatesAsync( struct container *container, void *blobs_to_write, void *blobs_to_delete,
+                                                    HSTRING display_name, void **operation )
+{
+    struct pending_write *writes;
+    HSTRING *deletes;
+    UINT32 write_count, delete_count;
+    HRESULT hr;
+    INT32 status;
+
+    TRACE( "container %s, write %p, delete %p, display name %s.\n", debugstr_hstring( container->name ), blobs_to_write,
+           blobs_to_delete, debugstr_hstring( display_name ) );
+    if (FAILED(hr = collect_pairs( blobs_to_write, &IID_IIterable_IKeyValuePair_HSTRING_IBuffer, FALSE, &writes, &write_count )))
+        return hr;
+    if (FAILED(hr = collect_strings( blobs_to_delete, &deletes, &delete_count )))
+    {
+        free_pairs( writes, write_count );
+        return hr;
+    }
+    status = submit_updates( container, writes, write_count, deletes, delete_count, display_name );
+    free_pairs( writes, write_count );
+    free_strings( deletes, delete_count );
+    return complete_operation( status, operation );
+}
+
+static HRESULT WINAPI container_SubmitPropertySetUpdatesAsync( struct container *container, void *blobs_to_write, void *blobs_to_delete,
+                                                               HSTRING display_name, void **operation )
+{
+    struct pending_write *writes;
+    HSTRING *deletes;
+    UINT32 write_count, delete_count;
+    HRESULT hr;
+    INT32 status;
+
+    TRACE( "container %s, write %p, delete %p.\n", debugstr_hstring( container->name ), blobs_to_write, blobs_to_delete );
+    if (FAILED(hr = collect_pairs( blobs_to_write, &IID_IIterable_IKeyValuePair_HSTRING_IInspectable, TRUE, &writes, &write_count )))
+        return hr;
+    if (FAILED(hr = collect_strings( blobs_to_delete, &deletes, &delete_count )))
+    {
+        free_pairs( writes, write_count );
+        return hr;
+    }
+    status = submit_updates( container, writes, write_count, deletes, delete_count, display_name );
+    free_pairs( writes, write_count );
+    free_strings( deletes, delete_count );
+    return complete_operation( status, operation );
+}
+
+static INT32 read_blob( struct container *container, HSTRING name, BYTE **data, DWORD *size )
+{
+    WCHAR path[MAX_PATH];
+    LARGE_INTEGER file_size;
+    HANDLE file;
+    DWORD read = 0;
+
+    *data = NULL;
+    *size = 0;
+    if (!container->valid) return GS_INVALID_CONTAINER_NAME;
+    if (!blob_path( container, name, L"", path )) return GS_BLOB_NOT_FOUND;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return GS_BLOB_NOT_FOUND;
+    if (!GetFileSizeEx( file, &file_size ) || file_size.QuadPart > GS_QUOTA ||
+        !(*data = malloc( file_size.QuadPart ? file_size.QuadPart : 1 )) ||
+        !ReadFile( file, *data, file_size.QuadPart, &read, NULL ) || read != file_size.QuadPart)
+    {
+        CloseHandle( file );
+        free( *data );
+        *data = NULL;
+        return GS_NO_ACCESS;
+    }
+    CloseHandle( file );
+    *size = read;
+    return GS_OK;
+}
+
+/* ReadAsync: reads blobs into the app's buffers. */
+static HRESULT WINAPI container_ReadAsync( struct container *container, void *blobs_to_read, void **operation )
+{
+    struct pending_write *reads;
+    INT32 status = GS_OK;
+    UINT32 i, count;
+    HRESULT hr;
+
+    TRACE( "container %s, blobs %p.\n", debugstr_hstring( container->name ), blobs_to_read );
+    if (!blobs_to_read) return E_INVALIDARG;
+    if (FAILED(hr = collect_pairs( blobs_to_read, &IID_IIterable_IKeyValuePair_HSTRING_IBuffer, FALSE, &reads, &count ))) return hr;
+    for (i = 0; i < count && status == GS_OK; i++)
+    {
+        BYTE *data, *target;
+        UINT32 length, capacity;
+        DWORD size;
+
+        status = read_blob( container, reads[i].name, &data, &size );
+        TRACE( "blob %s: status %#x, %lu bytes.\n", debugstr_hstring( reads[i].name ), status, size );
+        if (status) break;
+        if (FAILED(buffer_bytes( reads[i].buffer, &target, &length, &capacity ))) status = GS_NO_ACCESS;
+        else if (capacity < size) status = GS_PROVIDED_BUFFER_TOO_SMALL;
+        else
+        {
+            memcpy( target, data, size );
+            call_out( reads[i].buffer, 8, (void *)(UINT_PTR)size );          /* IBuffer::put_Length */
+        }
+        free( data );
+    }
+    free_pairs( reads, count );
+    return complete_operation( status, operation );
+}
+
+/* Names of all blobs in the container (for GetAsync without a list). */
+static HRESULT all_blob_names( struct container *container, HSTRING **out, UINT32 *count )
+{
+    WCHAR pattern[MAX_PATH], name[GS_MAX_NAME + 1];
+    WIN32_FIND_DATAW data;
+    HSTRING *names = NULL, *grown;
+    HANDLE find;
+
+    *out = NULL;
+    *count = 0;
+    if (!container->valid || !join_path( pattern, container->dir, L"*" )) return S_OK;
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return S_OK;
+    do
+    {
+        if (!is_blob_file( &data, name, ARRAY_SIZE(name) )) continue;
+        if (!(grown = realloc( names, (*count + 1) * sizeof(*names) ))) break;
+        names = grown;
+        if (SUCCEEDED(WindowsCreateString( name, wcslen( name ), &names[*count] ))) (*count)++;
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+    *out = names;
+    return S_OK;
+}
+
+/* GetAsync: returns the blobs' data in a new map. */
+static HRESULT WINAPI container_GetAsync( struct container *container, void *blobs_to_read, void **operation )
+{
+    struct blob_map *map;
+    HSTRING *names;
+    UINT32 i, count;
+    INT32 status = GS_OK;
+    HRESULT hr;
+
+    TRACE( "container %s, blobs %p.\n", debugstr_hstring( container->name ), blobs_to_read );
+    hr = blobs_to_read ? collect_strings( blobs_to_read, &names, &count ) : all_blob_names( container, &names, &count );
+    if (FAILED(hr)) return hr;
+    if (!(map = blob_map_create()))
+    {
+        free_strings( names, count );
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count && status == GS_OK; i++)
+    {
+        struct buffer *buffer;
+        BYTE *data;
+        DWORD size;
+
+        if ((status = read_blob( container, names[i], &data, &size ))) break;
+        if (!(buffer = buffer_create( size ))) status = GS_NO_ACCESS;
+        else
+        {
+            memcpy( buffer->data, data, size );
+            if (!blob_map_add( map, names[i], buffer )) { obj_release( &buffer->obj ); status = GS_NO_ACCESS; }
+        }
+        free( data );
+    }
+    free_strings( names, count );
+    if (status)
+    {
+        obj_release( &map->obj );
+        map = NULL;
+    }
+    return complete_with_result( &IID_IGameSaveBlobGetResult, L"Windows.Gaming.XboxLive.Storage.GameSaveBlobGetResult",
+                                 status, map ? &map->obj.vtbl : NULL, operation );
+}
+
+/* ---- GameSaveBlobInfoQuery ---- */
+struct blob_query
+{
+    struct gs_object obj;
+    struct container *container;
+    WCHAR prefix[GS_MAX_NAME + 1];
+};
+static void blob_query_destroy( struct gs_object *obj )
+{
+    struct blob_query *query = CONTAINING_RECORD( obj, struct blob_query, obj );
+    obj_release( &query->container->obj );
+    free( query );
+}
+
+static void blob_query_collect( struct blob_query *query, struct list_builder *builder, BOOL count_only )
+{
+    WCHAR pattern[MAX_PATH], name[GS_MAX_NAME + 1];
+    WIN32_FIND_DATAW data;
+    struct blob_info *info;
+    HANDLE find;
+
+    builder->prefix = query->prefix;
+    builder->prefix_len = wcslen( query->prefix );
+    if (!query->container->valid || !join_path( pattern, query->container->dir, L"*" )) return;
+    if ((find = FindFirstFileW( pattern, &data )) == INVALID_HANDLE_VALUE) return;
+    do
+    {
+        if (!is_blob_file( &data, name, ARRAY_SIZE(name) ) || !builder_matches( builder, name )) continue;
+        if (count_only) { builder->count++; continue; }
+        if ((info = obj_alloc( sizeof(*info), blob_info_vtbl, &IID_IGameSaveBlobInfo, L"Windows.Gaming.XboxLive.Storage.GameSaveBlobInfo",
+                               blob_info_destroy )))
+        {
+            WindowsCreateString( name, wcslen( name ), &info->name );
+            info->size = min( file_size( &data ), 0xffffffff );
+        }
+        builder_add( builder, info ? &info->obj.vtbl : NULL );
+    } while (FindNextFileW( find, &data ));
+    FindClose( find );
+}
+
+static HRESULT blob_query_run( struct blob_query *query, UINT32 start, UINT32 max, void **operation )
+{
+    struct list_builder builder = { 0 };
+    struct vector *vector;
+
+    blob_query_collect( query, &builder, FALSE );
+    if (!(vector = builder_finish( &builder, start, max, &IID_IVectorView_GameSaveBlobInfo, &IID_IIterable_GameSaveBlobInfo,
+                                   &IID_IIterator_GameSaveBlobInfo )))
+        return E_OUTOFMEMORY;
+    TRACE( "container %s prefix %s -> %u blobs.\n", debugstr_hstring( query->container->name ), debugstr_w( query->prefix ), vector->count );
+    return complete_with_result( &IID_IGameSaveBlobInfoGetResult, L"Windows.Gaming.XboxLive.Storage.GameSaveBlobInfoGetResult",
+                                 builder.failed ? GS_NO_ACCESS : GS_OK, &vector->obj.vtbl, operation );
+}
+static HRESULT WINAPI blob_query_GetBlobInfoAsync( struct blob_query *query, void **operation ) { return blob_query_run( query, 0, 0, operation ); }
+static HRESULT WINAPI blob_query_GetBlobInfoWithIndexAndMaxAsync( struct blob_query *query, UINT32 start, UINT32 max, void **operation )
+{
+    return blob_query_run( query, start, max, operation );
+}
+static HRESULT WINAPI blob_query_GetItemCountAsync( struct blob_query *query, void **operation )
+{
+    struct list_builder builder = { 0 };
+    blob_query_collect( query, &builder, TRUE );
+    return completed_int_operation( builder.count, operation );
+}
+static const void *const blob_query_vtbl[] = { BASE, blob_query_GetBlobInfoAsync, blob_query_GetBlobInfoWithIndexAndMaxAsync,
+    blob_query_GetItemCountAsync };
+
+static HRESULT WINAPI container_CreateBlobInfoQuery( struct container *container, HSTRING prefix, void **value )
+{
+    struct blob_query *query;
+    UINT32 len;
+    const WCHAR *str = WindowsGetStringRawBuffer( prefix, &len );
+
+    if (len > GS_MAX_NAME) return E_INVALIDARG;
+    if (!(query = obj_alloc( sizeof(*query), blob_query_vtbl, &IID_IGameSaveBlobInfoQuery,
+                             L"Windows.Gaming.XboxLive.Storage.GameSaveBlobInfoQuery", blob_query_destroy )))
+        return E_OUTOFMEMORY;
+    memcpy( query->prefix, str, len * sizeof(WCHAR) );
+    query->container = container;
+    InterlockedIncrement( &container->obj.ref );
+    *value = &query->obj.vtbl;
+    return S_OK;
+}
+
+static const void *const container_vtbl[] = { BASE, container_get_Name, container_get_Provider, container_SubmitUpdatesAsync,
+    container_ReadAsync, container_GetAsync, container_SubmitPropertySetUpdatesAsync, container_CreateBlobInfoQuery };
+
+/* ---------------- GameSaveProvider ---------------- */
+
+static HRESULT WINAPI provider_get_User( struct provider *provider, IUnknown **value )
+{
+    if ((*value = provider->user)) IUnknown_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI provider_CreateContainer( struct provider *provider, HSTRING name, void **value )
+{
+    WCHAR file[GS_MAX_NAME * 7 + 1];
+    struct container *container;
+
+    TRACE( "provider %p, name %s.\n", provider, debugstr_hstring( name ) );
+    if (!(container = obj_alloc( sizeof(*container), container_vtbl, &IID_IGameSaveContainer,
+                                 L"Windows.Gaming.XboxLive.Storage.GameSaveContainer", container_destroy )))
+        return E_OUTOFMEMORY;
+    container->provider = provider;
+    InterlockedIncrement( &provider->obj.ref );
+    WindowsDuplicateString( name, &container->name );
+    /* an invalid name gives a container whose operations fail with InvalidContainerName */
+    container->valid = hstring_to_file_name( name, file, ARRAY_SIZE(file) ) && join_path( container->dir, provider->root, file );
+    if (!container->valid) WARN( "invalid container name %s.\n", debugstr_hstring( name ) );
+    *value = &container->obj.vtbl;
+    return S_OK;
+}
+
+static HRESULT WINAPI provider_DeleteContainerAsync( struct provider *provider, HSTRING name, void **operation )
+{
+    WCHAR file[GS_MAX_NAME * 7 + 1], dir[MAX_PATH], pattern[MAX_PATH], path[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    INT32 status = GS_OK;
+    HANDLE find;
+
+    TRACE( "provider %p, name %s.\n", provider, debugstr_hstring( name ) );
+    if (!hstring_to_file_name( name, file, ARRAY_SIZE(file) ) || !join_path( dir, provider->root, file ) ||
+        !join_path( pattern, dir, L"*" ))
+        return complete_operation( GS_INVALID_CONTAINER_NAME, operation );
+    if ((find = FindFirstFileW( pattern, &data )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+            if (!join_path( path, dir, data.cFileName ) || !DeleteFileW( path )) status = GS_NO_ACCESS;
+        } while (FindNextFileW( find, &data ));
+        FindClose( find );
+    }
+    if (!RemoveDirectoryW( dir ) && GetLastError() != ERROR_FILE_NOT_FOUND && GetLastError() != ERROR_PATH_NOT_FOUND)
+        status = GS_NO_ACCESS;
+    return complete_operation( status, operation );
+}
