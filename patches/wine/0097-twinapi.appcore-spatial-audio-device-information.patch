+                      NULL, buffer, &size )) return S_OK;
+    if (swscanf( buffer, L"%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x", &data[0], &data[1], &data[2], &data[3], &data[4],
+                 &data[5], &data[6], &data[7], &data[8], &data[9], &data[10] ) != 11) return S_OK;
+    value->Data1 = data[0];
+    value->Data2 = data[1];
+    value->Data3 = data[2];
+    for (i = 0; i < 8; i++) value->Data4[i] = data[3 + i];
+    return S_OK;
 }
 
