@@ -622,6 +622,29 @@ static HRESULT WINAPI core_dispatcher_ProcessEvents(ICoreDispatcher *iface, __x_
     struct core_dispatcher *impl __attribute__((unused)) = impl_from_core_dispatcher(iface);
     MSG msg;
     TRACE_(coreloop)("iface %p, options %d.\n", iface, options);
+    if (GetCurrentThreadId() != impl->thread_id)
+    {
+        /* a SwapChainPanel's independent input source hands out this dispatcher, and games pump it on
+         * their own input thread: pump that thread's messages, but leave the work queued for the UI thread
+         * to the UI thread */
+        TRACE("iface %p: pumping thread %#lx, not the dispatcher's.\n", iface, GetCurrentThreadId());
+        if (options == CoreProcessEventsOption_ProcessUntilQuit)
+        {
+            while (GetMessageW(&msg, NULL, 0, 0) > 0)
+            {
+                TranslateMessage(&msg);
+                DispatchMessageW(&msg);
+            }
+            return S_OK;
+        }
+        while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE))
+        {
+            if (msg.message == WM_QUIT) { PostQuitMessage(msg.wParam); break; }
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+        return S_OK;
+    }
     if (options == CoreProcessEventsOption_ProcessUntilQuit)
     {
         /* used by FrameworkView.Run (XAML): block until WM_QUIT, running RunAsync work as it is queued */
