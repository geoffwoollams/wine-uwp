+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* WinRT classes implemented here that Wine's IDL files do not declare (the ones they do are in classes.idl),
+ * registered so that RoGetActivationFactory finds this DLL in a new prefix. */
+/* @makedep: twinapi.appcore.rgs */
+1 WINE_REGISTRY twinapi.appcore.rgs
diff --git a/dlls/twinapi.appcore/twinapi.appcore.rgs b/dlls/twinapi.appcore/twinapi.appcore.rgs
new file mode 100644
index 0000000..84a4773
--- /dev/null
+++ b/dlls/twinapi.appcore/twinapi.appcore.rgs
@@ -0,0 +1,119 @@
+HKLM
+{
+    NoRemove Software
+    {
+        NoRemove Microsoft
+        {
+            NoRemove WindowsRuntime
+            {
+                NoRemove ActivatableClassId
+                {
+                    ForceRemove Windows.ApplicationModel.ExtendedExecution.ExtendedExecutionSession
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.ApplicationModel.Store.CurrentApp
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Foundation.Diagnostics.AsyncCausalityTracer
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Foundation.Diagnostics.LoggingActivity
+                    {
