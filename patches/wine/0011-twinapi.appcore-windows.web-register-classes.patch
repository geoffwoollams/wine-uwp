+                    }
+                    ForceRemove Windows.Foundation.Diagnostics.LoggingChannelOptions
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Foundation.Diagnostics.LoggingFields
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Foundation.Diagnostics.LoggingOptions
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Foundation.Diagnostics.LoggingSession
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Gaming.XboxLive.Storage.GameSaveProvider
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Graphics.Display.DisplayInformation
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Networking.PushNotifications.PushNotificationChannelManager
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Networking.Sockets.MessageWebSocket
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Security.Authentication.Web.Core.WebAuthenticationCoreManager
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Security.Authentication.Web.Core.WebTokenRequest
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Security.Authentication.Web.Core.WebTokenResponse
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Security.Credentials.WebAccount
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Security.Credentials.WebAccountProvider
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.Services.Store.StoreContext
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.System.Display.DisplayRequest
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.System.Launcher
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.System.Profile.HardwareIdentification
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.System.Threading.ThreadPoolTimer
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.System.User
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.System.UserPicker
+                    {
+                        val 'DllPath' = s '%MODULE%'
+                    }
+                    ForceRemove Windows.UI.Popups.MessageDialog
