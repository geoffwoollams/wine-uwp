+/* a property the app registered (DependencyProperty.Register) by name: the one owned by owner_class (the app class
+ * composing the element) or, without one, the only one of that name; not referenced */
+IDependencyProperty *dp_find_registered( const WCHAR *owner_class, const WCHAR *name )
+{
+    struct dependency_property *impl, *found = NULL;
+    SIZE_T len = owner_class ? wcslen( owner_class ) : 0;
+    UINT32 count = 0;
+
+    EnterCriticalSection( &dp_cs );
+    for (impl = properties; impl; impl = impl->next)
+    {
+        if (impl->builtin || impl->attached || wcscmp( impl->name, name )) continue;
+        /* owners are assembly-qualified: "Namespace.Class, Assembly, Version=..." */
+        if (len && !wcsncmp( impl->owner, owner_class, len ) && (!impl->owner[len] || impl->owner[len] == ','))
+        {
+            found = impl;
+            count = 1;
+            break;
+        }
+        found = impl;
+        count++;
+    }
+    LeaveCriticalSection( &dp_cs );
+    if (count != 1) return NULL;
+    return &found->IDependencyProperty_iface;
+}
+
