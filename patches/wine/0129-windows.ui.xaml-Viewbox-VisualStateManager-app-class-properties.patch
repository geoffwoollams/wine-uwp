+/* markup: Child, Stretch and StretchDirection */
+BOOL viewbox_set_markup( IInspectable *target, const WCHAR *name, IInspectable *object, INT32 number )
+{
+    IViewbox *viewbox;
+    IUIElement *ui;
+    BOOL done = TRUE;
+
+    if (!target || FAILED(IInspectable_QueryInterface( target, &IID_IViewbox, (void **)&viewbox ))) return FALSE;
+    if (!wcscmp( name, L"Child" ) && object && SUCCEEDED(IInspectable_QueryInterface( object, &IID_IUIElement, (void **)&ui )))
+    {
+        IViewbox_put_Child( viewbox, ui );
+        IUIElement_Release( ui );
+    }
+    else if (!wcscmp( name, L"Stretch" ) && number >= 0) IViewbox_put_Stretch( viewbox, number );
+    else if (!wcscmp( name, L"StretchDirection" ) && number >= 0) IViewbox_put_StretchDirection( viewbox, number );
+    else done = FALSE;
+    IViewbox_Release( viewbox );
+    return done;
