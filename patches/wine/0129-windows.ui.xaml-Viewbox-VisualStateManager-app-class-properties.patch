+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A Viewbox measures its Child at the child's natural size, then scales it to fit by Stretch (Uniform by
+ * default) and StretchDirection (Both). The child is arranged at its natural size and scaled by a layout scale
+ * (element->layout_scale), which drawing and hit testing both apply, as WinUI's Viewbox does with its scale
+ * transform. */
+
+struct viewbox
+{
+    struct xaml_element element;
+    IViewbox IViewbox_iface;
+    IUIElement *child;
+    Stretch stretch;
+    StretchDirection direction;
+};
+
+static inline struct viewbox *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct viewbox, element );
+}
+
+static struct xaml_element *viewbox_child( struct viewbox *impl )
+{
+    return impl->child ? element_from_iinspectable( (IInspectable *)impl->child ) : NULL;
+}
+
+/* the scales that fit content of the given size into the available size */
+static void viewbox_scale( struct viewbox *impl, float content_width, float content_height, float avail_width,
+                           float avail_height, float *sx, float *sy )
+{
+    float x = content_width > 0 && isfinite( avail_width ) ? avail_width / content_width : INFINITY;
+    float y = content_height > 0 && isfinite( avail_height ) ? avail_height / content_height : INFINITY;
+
+    switch (impl->stretch)
+    {
+    case Stretch_None:
+        x = y = 1;
+        break;
+    case Stretch_Fill:
+        if (!isfinite( x )) x = isfinite( y ) ? y : 1;
+        if (!isfinite( y )) y = x;
+        break;
+    case Stretch_UniformToFill:
+        x = y = isfinite( x ) && isfinite( y ) ? max( x, y ) : isfinite( x ) ? x : isfinite( y ) ? y : 1;
+        break;
+    default:   /* Uniform */
+        x = y = min( x, y );
+        if (!isfinite( x )) x = y = 1;
+        break;
+    }
+    if (impl->direction == StretchDirection_UpOnly) { x = max( x, 1.0f ); y = max( y, 1.0f ); }
+    else if (impl->direction == StretchDirection_DownOnly) { x = min( x, 1.0f ); y = min( y, 1.0f ); }
+    *sx = x;
+    *sy = y;
+}
+
+static HRESULT viewbox_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct viewbox *impl = impl_from_element( element );
+
+    if (!IsEqualGUID( iid, &IID_IViewbox )) return E_NOINTERFACE;
+    *out = &impl->IViewbox_iface;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void viewbox_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                             float avail_height, float *width, float *height )
+{
+    struct viewbox *impl = impl_from_element( element );
+    struct xaml_element *child = viewbox_child( impl );
+    float sx, sy;
+
+    *width = *height = 0;
+    if (!child) return;
+    element_measure( child, ctx, INFINITY, INFINITY );
+    viewbox_scale( impl, child->desired_width, child->desired_height, avail_width, avail_height, &sx, &sy );
+    *width = child->desired_width * sx;
+    *height = child->desired_height * sy;
+}
+
+static void viewbox_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct viewbox *impl = impl_from_element( element );
+    struct xaml_element *child = viewbox_child( impl );
+    const struct layout_rect *b = &element->bounds;
+    float sx, sy, cw, ch;
+
+    if (!child) return;
+    cw = child->desired_width;
+    ch = child->desired_height;
+    viewbox_scale( impl, cw, ch, b->width, b->height, &sx, &sy );
+    /* the scaled content is centred; the child keeps its natural size and is scaled from its corner */
+    child->layout_scale_x = sx;
+    child->layout_scale_y = sy;
+    child->layout_origin_x = b->x + (b->width - cw * sx) / 2;
+    child->layout_origin_y = b->y + (b->height - ch * sy) / 2;
+    element_arrange( child, ctx, child->layout_origin_x, child->layout_origin_y, cw, ch );
+}
+
+static void viewbox_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct xaml_element *child = viewbox_child( impl_from_element( element ) );
+    if (child) element_render( child, ctx );
+}
+
+static UINT32 viewbox_child_count( struct xaml_element *element )
+{
+    return viewbox_child( impl_from_element( element ) ) ? 1 : 0;
+}
+
+static struct xaml_element *viewbox_child_at( struct xaml_element *element, UINT32 index )
+{
+    return index ? NULL : viewbox_child( impl_from_element( element ) );
+}
+
+static BOOL viewbox_hit_self( struct xaml_element *element, float x, float y )
+{
+    return FALSE;
+}
+
+static void viewbox_destroy( struct xaml_element *element )
+{
+    struct viewbox *impl = impl_from_element( element );
+    struct xaml_element *child = viewbox_child( impl );
+
+    if (child && child->parent == element) element_set_parent( child, NULL );
+    if (impl->child) IUIElement_Release( impl->child );
+    free( impl );
+}
+
+static const struct element_ops viewbox_ops =
+{
+    .query_interface = viewbox_query_interface,
+    .measure = viewbox_measure,
+    .arrange = viewbox_arrange,
+    .render = viewbox_render,
+    .child_count = viewbox_child_count,
+    .child_at = viewbox_child_at,
+    .hit_self = viewbox_hit_self,
+    .destroy = viewbox_destroy,
+};
+
+DEFINE_IINSPECTABLE_( viewbox_iface, IViewbox, struct viewbox, impl_from_IViewbox, IViewbox_iface, impl->element.outer )
+
+static HRESULT WINAPI viewbox_iface_get_Child( IViewbox *iface, IUIElement **value )
+{
+    if (!value) return E_POINTER;
+    if ((*value = impl_from_IViewbox( iface )->child)) IUIElement_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI viewbox_iface_put_Child( IViewbox *iface, IUIElement *value )
+{
+    struct viewbox *impl = impl_from_IViewbox( iface );
+    struct xaml_element *old = viewbox_child( impl ), *child = NULL;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (value && !(child = element_from_iinspectable( (IInspectable *)value ))) return E_INVALIDARG;
+    if (child && child->parent && child->parent != &impl->element) return E_INVALIDARG;
