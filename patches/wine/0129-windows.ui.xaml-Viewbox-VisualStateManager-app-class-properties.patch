+static BOOL has_state( struct template_instance *instance, const WCHAR *name )
+{
+    struct xaml_element *root = template_root( instance );
+    struct bag *groups, *group;
+    UINT32 i;
+
+    if (!root || !(groups = bag_from_object( root->visual_state_groups ))) return FALSE;
+    for (i = 0; i < groups->item_count; i++)
+        if ((group = bag_from_object( groups->items[i] )) && group_state( group, name )) return TRUE;
+    return FALSE;
+}
+
+static struct xaml_element *states_root( struct xaml_element *element, UINT32 depth )
+{
+    struct xaml_element *child, *found;
+    UINT32 i, count;
+
+    if (element->visual_state_groups) return element;
+    if (depth > 4 || !element->ops->child_count) return NULL;
+    count = element->ops->child_count( element );
+    for (i = 0; i < count; i++)
+        if ((child = element->ops->child_at( element, i )) && (found = states_root( child, depth + 1 ))) return found;
+    return NULL;
+}
+
+/* VisualStateManager.GoToState: the states of the control's template or, for a UserControl, of its content root */
+BOOL element_go_to_state( struct xaml_element *control, const WCHAR *state )
+{
+    struct template_instance *instance = control->template_instance;
+    struct xaml_element *root;
+
+    if (!instance)
+    {
+        if (!(root = states_root( control, 0 ))) return FALSE;
+        if (control->state_instance && template_root( control->state_instance ) != root)
+        {
+            template_free( control->state_instance );
+            control->state_instance = NULL;
+        }
+        if (!control->state_instance)
+        {
+            if (!(control->state_instance = calloc( 1, sizeof(*control->state_instance) ))) return FALSE;
+            control->state_instance->root = root->outer;
+            IInspectable_AddRef( root->outer );
+            control->state_instance->templated_parent = control->outer;
+        }
+        instance = control->state_instance;
+    }
+    if (!has_state( instance, state )) return FALSE;
+    template_go_to_states( instance, &state, 1 );
+    return TRUE;
+}
