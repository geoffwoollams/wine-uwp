+/* the system's app theme: Settings > Colours, HKCU\...\Themes\Personalize AppsUseLightTheme */
+static ApplicationTheme system_theme(void)
+{
+    DWORD value = 1, size = sizeof(value);
+
+    if (RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                      L"AppsUseLightTheme", RRF_RT_REG_DWORD, NULL, &value, &size ))
+        return ApplicationTheme_Light;
+    return value ? ApplicationTheme_Light : ApplicationTheme_Dark;
+}
+
+/* WM_SETTINGCHANGE "ImmersiveColorSet": TRUE if the app's theme changed */
+BOOL application_system_theme_changed(void)
+{
+    ApplicationTheme theme;
+
+    if (!current_app || current_app->theme_set) return FALSE;
+    if ((theme = system_theme()) == current_app->theme) return FALSE;
+    TRACE( "the system theme is now %s.\n", theme == ApplicationTheme_Dark ? "dark" : "light" );
+    current_app->theme = theme;
+    return TRUE;
+}
+
+/* the theme resource lookups use: an element's RequestedTheme while its resources are being resolved, or the app's */
+static int theme_override = -1;
+
+int theme_override_set( int dark )
+{
+    int old = theme_override;
+    theme_override = dark;
+    return old;
+}
+
+BOOL lookup_theme_dark(void)
+{
+    return theme_override >= 0 ? theme_override : application_theme() == ApplicationTheme_Dark;
+}
