+static HRESULT shape_create( enum shape_kind kind, IInspectable *outer, IInspectable **inner, void **value )
+{
+    static const WCHAR *names[] =
+    {
+        RuntimeClass_Windows_UI_Xaml_Shapes_Rectangle,
+        RuntimeClass_Windows_UI_Xaml_Shapes_Ellipse,
+        RuntimeClass_Windows_UI_Xaml_Shapes_Path,
+    };
+    struct shape *impl;
+    void *iface;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    element_init( &impl->element, &shape_ops, names[kind], outer );
+    impl->IShape_iface.lpVtbl = &shape_iface_vtbl;
+    impl->IRectangle_iface.lpVtbl = &rectangle_vtbl;
+    impl->IEllipse_iface.lpVtbl = &ellipse_vtbl;
+    impl->IPath_iface.lpVtbl = &path_vtbl;
+    impl->kind = kind;
+    impl->stroke_thickness = 1.0;
+    impl->stretch = kind == SHAPE_PATH ? Stretch_None : Stretch_Fill;
+    switch (kind)
+    {
+    case SHAPE_RECTANGLE: iface = &impl->IRectangle_iface; break;
+    case SHAPE_ELLIPSE: iface = &impl->IEllipse_iface; break;
+    default: iface = &impl->IPath_iface; break;
+    }
+    return element_compose( &impl->element, outer, inner, iface, value );
+}
