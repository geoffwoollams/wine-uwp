+/* ---- shapes: rounded rectangles (one radius per corner) and ellipses, as GDI regions ---- */
+
+static BOOL corner_radius_zero( const CornerRadius *r )
+{
+    return !r || (r->TopLeft <= 0 && r->TopRight <= 0 && r->BottomRight <= 0 && r->BottomLeft <= 0);
+}
+
+#define ARC_STEPS 8
+#define PI_ 3.14159265358979323846
+
+static void add_arc( POINT *pt, UINT32 *n, double cx, double cy, double rx, double ry, double start )
+{
+    UINT32 i;
+    for (i = 0; i <= ARC_STEPS; i++)
+    {
+        double a = start + i * (PI_ / 2) / ARC_STEPS;
+        pt[*n].x = lround( cx + cos( a ) * rx );
+        pt[*n].y = lround( cy + sin( a ) * ry );
+        (*n)++;
+    }
+}
+
+/* a region for the shape in device pixels; radii in view pixels, clamped to fit */
+static HRGN shape_region( struct layout_context *ctx, double left, double top, double right, double bottom,
+                          const CornerRadius *radius, BOOL ellipse )
+{
+    POINT pt[4 * (ARC_STEPS + 1)];
+    double w = right - left, h = bottom - top, tl, tr, br, bl, s = ctx->scale;
+    UINT32 n = 0;
+
+    if (w <= 0 || h <= 0) return CreateRectRgn( 0, 0, 0, 0 );
+    if (ellipse) return CreateEllipticRgn( lround( left ), lround( top ), lround( right ) + 1, lround( bottom ) + 1 );
+    if (corner_radius_zero( radius )) return CreateRectRgn( lround( left ), lround( top ), lround( right ), lround( bottom ) );
+    tl = min( max( 0.0, radius->TopLeft * s ), min( w, h ) / 2 );
+    tr = min( max( 0.0, radius->TopRight * s ), min( w, h ) / 2 );
+    br = min( max( 0.0, radius->BottomRight * s ), min( w, h ) / 2 );
+    bl = min( max( 0.0, radius->BottomLeft * s ), min( w, h ) / 2 );
+    add_arc( pt, &n, right - tr, top + tr, tr, tr, -PI_ / 2 );
+    add_arc( pt, &n, right - br, bottom - br, br, br, 0 );
+    add_arc( pt, &n, left + bl, bottom - bl, bl, bl, PI_ / 2 );
+    add_arc( pt, &n, left + tl, top + tl, tl, tl, PI_ );
+    return CreatePolygonRgn( pt, n, WINDING );
+}
+
+static void fill_region( struct layout_context *ctx, HRGN region, Color c )
+{
+    HRGN saved = CreateRectRgn( 0, 0, 0, 0 );
+    BOOL had_clip = GetClipRgn( ctx->hdc, saved ) == 1;
+    struct layout_rect all;
+    RECT box;
+
+    if (!c.A) goto done;
+    if (c.A == 0xff)
+    {
+        HBRUSH brush = CreateSolidBrush( RGB( c.R, c.G, c.B ) );
+        FillRgn( ctx->hdc, region, brush );
+        DeleteObject( brush );
+        goto done;
+    }
+    GetRgnBox( region, &box );
+    if (had_clip) CombineRgn( region, region, saved, RGN_AND );
+    SelectClipRgn( ctx->hdc, region );
+    all.x = box.left / ctx->scale;
+    all.y = box.top / ctx->scale;
+    all.width = (box.right - box.left) / ctx->scale + 1;
+    all.height = (box.bottom - box.top) / ctx->scale + 1;
+    fill_argb( ctx, &all, c );
+    SelectClipRgn( ctx->hdc, had_clip ? saved : NULL );
+done:
+    DeleteObject( saved );
+}
+
+/* fill and/or stroke a shape: the fill covers the whole shape, the stroke is drawn inside its edge */
+void element_draw_shape( struct layout_context *ctx, const struct layout_rect *rect, const CornerRadius *radius,
+                         BOOL ellipse, IBrush *fill, IBrush *stroke, const Thickness *thickness )
+{
+    double s = ctx->scale, l = rect->x * s, t = rect->y * s, r = (rect->x + rect->width) * s, b = (rect->y + rect->height) * s;
+    CornerRadius inner_radius;
+    HRGN outer, inner;
+    Color c;
+
+    if (!ellipse && corner_radius_zero( radius ))
+    {
+        /* the plain rectangle code, pixel for pixel */
+        element_fill( ctx, rect, fill );
+        if (thickness) element_frame( ctx, rect, thickness, stroke );
+        return;
+    }
+    outer = shape_region( ctx, l, t, r, b, radius, ellipse );
+    if (fill && brush_get_color( fill, &c )) fill_region( ctx, outer, c );
+    if (stroke && thickness && brush_get_color( stroke, &c ) && c.A)
+    {
+        if (radius)
+        {
+            inner_radius.TopLeft = max( 0.0, radius->TopLeft - max( thickness->Left, thickness->Top ) / 2 );
+            inner_radius.TopRight = max( 0.0, radius->TopRight - max( thickness->Right, thickness->Top ) / 2 );
+            inner_radius.BottomRight = max( 0.0, radius->BottomRight - max( thickness->Right, thickness->Bottom ) / 2 );
+            inner_radius.BottomLeft = max( 0.0, radius->BottomLeft - max( thickness->Left, thickness->Bottom ) / 2 );
+        }
+        inner = shape_region( ctx, l + thickness->Left * s, t + thickness->Top * s, r - thickness->Right * s,
+                              b - thickness->Bottom * s, radius ? &inner_radius : NULL, ellipse );
+        CombineRgn( outer, outer, inner, RGN_DIFF );
+        DeleteObject( inner );
+        fill_region( ctx, outer, c );
+    }
+    DeleteObject( outer );
+}
+
+/* a polyline or polygon in view pixels relative to (x, y), for Path */
+void element_draw_lines( struct layout_context *ctx, float x, float y, const struct shape_point *points, UINT32 count,
+                         BOOL closed, IBrush *fill, IBrush *stroke, double thickness )
+{
+    POINT *pt;
+    Color c;
+    UINT32 i;
+
+    if (count < 2 || !(pt = malloc( count * sizeof(*pt) ))) return;
+    for (i = 0; i < count; i++)
+    {
+        pt[i].x = lroundf( (x + points[i].x) * ctx->scale );
+        pt[i].y = lroundf( (y + points[i].y) * ctx->scale );
+    }
+    if (closed && fill && brush_get_color( fill, &c ) && c.A)
+    {
+        HRGN region = CreatePolygonRgn( pt, count, WINDING );
+        fill_region( ctx, region, c );
+        DeleteObject( region );
+    }
+    if (stroke && thickness > 0 && brush_get_color( stroke, &c ) && c.A)
+    {
+        LOGBRUSH lb = { BS_SOLID, RGB( c.R, c.G, c.B ) };
+        HPEN pen = ExtCreatePen( PS_GEOMETRIC | PS_SOLID | PS_ENDCAP_FLAT | PS_JOIN_MITER,
+                                 max( 1, lround( thickness * ctx->scale ) ), &lb, 0, NULL );
+        HGDIOBJ old = SelectObject( ctx->hdc, pen );
+        if (closed) Polygon( ctx->hdc, pt, count ); else Polyline( ctx->hdc, pt, count );
+        SelectObject( ctx->hdc, old );
+        DeleteObject( pen );
+    }
+    free( pt );
+}
+
