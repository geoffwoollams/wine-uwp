+/* Rectangle and Ellipse fill their layout slot (Stretch Fill) and draw their stroke inside it. A Path's Data is
+ * path markup ("M 4,10 L 8,14 Z"), set from markup as a string; its lines are drawn at their own coordinates
+ * (Stretch None). Curves are reduced to their end points; Geometry objects from code aren't supported. */
+
+enum shape_kind
+{
+    SHAPE_RECTANGLE,
+    SHAPE_ELLIPSE,
+    SHAPE_PATH,
+};
+
+struct figure
+{
+    struct shape_point *points;
+    UINT32 count;
+    BOOL closed;
+};
+
+struct shape
+{
+    struct xaml_element element;
+    IShape IShape_iface;
+    IRectangle IRectangle_iface;
+    IEllipse IEllipse_iface;
+    IPath IPath_iface;
+    enum shape_kind kind;
+    IBrush *fill, *stroke;
+    double stroke_thickness, radius_x, radius_y;
+    Stretch stretch;
+    struct figure *figures;
+    UINT32 figure_count;
+};
+
+static const struct element_ops shape_ops;
+
+static inline struct shape *impl_from_element( struct xaml_element *element )
+{
+    return CONTAINING_RECORD( element, struct shape, element );
+}
+
+static struct shape *shape_from_object( IInspectable *object )
+{
+    struct xaml_element *element = object ? element_from_object( object ) : NULL;
+    return element && element->ops == &shape_ops ? impl_from_element( element ) : NULL;
+}
+
+static HRESULT shape_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct shape *impl = impl_from_element( element );
+
+    if (IsEqualGUID( iid, &IID_IShape )) *out = &impl->IShape_iface;
+    else if (impl->kind == SHAPE_RECTANGLE && IsEqualGUID( iid, &IID_IRectangle )) *out = &impl->IRectangle_iface;
+    else if (impl->kind == SHAPE_ELLIPSE && IsEqualGUID( iid, &IID_IEllipse )) *out = &impl->IEllipse_iface;
+    else if (impl->kind == SHAPE_PATH && IsEqualGUID( iid, &IID_IPath )) *out = &impl->IPath_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static void shape_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width,
+                           float avail_height, float *width, float *height )
+{
+    struct shape *impl = impl_from_element( element );
+    UINT32 i, j;
+
+    *width = *height = 0;
+    if (impl->kind != SHAPE_PATH)
+    {
+        /* a stretching shape takes no room of its own, apart from its stroke */
+        *width = *height = impl->stroke ? impl->stroke_thickness : 0;
+        return;
+    }
+    for (i = 0; i < impl->figure_count; i++)
+        for (j = 0; j < impl->figures[i].count; j++)
+        {
+            *width = max( *width, impl->figures[i].points[j].x );
+            *height = max( *height, impl->figures[i].points[j].y );
+        }
+    if (impl->stroke)
+    {
+        *width += impl->stroke_thickness / 2;
+        *height += impl->stroke_thickness / 2;
+    }
+}
+
+static void shape_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct shape *impl = impl_from_element( element );
+    double t = impl->stroke ? impl->stroke_thickness : 0;
+    Thickness thickness = { t, t, t, t };
+    CornerRadius radius;
+    UINT32 i;
+
+    switch (impl->kind)
+    {
+    case SHAPE_RECTANGLE:
+        radius.TopLeft = radius.TopRight = radius.BottomRight = radius.BottomLeft = max( impl->radius_x, impl->radius_y );
+        element_draw_shape( ctx, &element->bounds, &radius, FALSE, impl->fill, impl->stroke, &thickness );
+        break;
+    case SHAPE_ELLIPSE:
+        element_draw_shape( ctx, &element->bounds, NULL, TRUE, impl->fill, impl->stroke, &thickness );
+        break;
+    case SHAPE_PATH:
+        for (i = 0; i < impl->figure_count; i++)
+            element_draw_lines( ctx, element->bounds.x, element->bounds.y, impl->figures[i].points, impl->figures[i].count,
+                                impl->figures[i].closed, impl->fill, impl->stroke, t );
+        break;
+    }
+}
+
+static void free_figures( struct shape *impl )
+{
+    UINT32 i;
+    for (i = 0; i < impl->figure_count; i++) free( impl->figures[i].points );
+    free( impl->figures );
+    impl->figures = NULL;
+    impl->figure_count = 0;
+}
+
+static void shape_destroy( struct xaml_element *element )
+{
+    struct shape *impl = impl_from_element( element );
+
+    if (impl->fill) IBrush_Release( impl->fill );
+    if (impl->stroke) IBrush_Release( impl->stroke );
+    free_figures( impl );
+    free( impl );
+}
+
+static const struct element_ops shape_ops =
+{
+    .query_interface = shape_query_interface,
+    .measure = shape_measure,
+    .render = shape_render,
+    .destroy = shape_destroy,
+};
