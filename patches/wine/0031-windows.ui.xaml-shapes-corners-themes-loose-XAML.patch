+/* path markup: M/L/H/V/Z, absolute and relative; C/S/Q/T/A go straight to their end point */
+static const WCHAR *path_number( const WCHAR *p, float *out, BOOL *ok )
+{
+    WCHAR *end;
+    while (*p == ' ' || *p == ',' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+    *out = wcstod( p, &end );
+    *ok = end != p;
+    return end;
+}
+
+static BOOL add_point( struct figure *figure, float x, float y )
+{
+    struct shape_point *points = realloc( figure->points, (figure->count + 1) * sizeof(*points) );
+    if (!points) return FALSE;
+    figure->points = points;
+    points[figure->count].x = x;
+    points[figure->count++].y = y;
+    return TRUE;
+}
+
+static void path_parse( struct shape *impl, const WCHAR *data )
+{
+    static const struct { WCHAR cmd; UINT32 args; } counts[] =
+        { {'M', 2}, {'L', 2}, {'H', 1}, {'V', 1}, {'C', 6}, {'S', 4}, {'Q', 4}, {'T', 2}, {'A', 7} };
+    const WCHAR *p = data;
+    struct figure *figure = NULL, *figures;
+    float x = 0, y = 0, start_x = 0, start_y = 0, v[7];
+    WCHAR cmd = 0, upper;
+    UINT32 i, n;
+    BOOL ok, relative;
+
+    free_figures( impl );
+    while (*p == ' ') p++;
+    if ((p[0] == 'F' || p[0] == 'f') && (p[1] == '0' || p[1] == '1')) p += 2;   /* fill rule */
+    for (;;)
+    {
+        while (*p == ' ' || *p == ',' || *p == '\t' || *p == '\r' || *p == '\n') p++;
+        if (!*p) break;
+        if (iswalpha( *p )) cmd = *p++;
+        else if (!cmd) break;
+        upper = towupper( cmd );
+        relative = cmd != upper;
+        if (upper == 'Z')
+        {
+            if (figure) figure->closed = TRUE;
+            x = start_x;
+            y = start_y;
+            cmd = 0;
+            continue;
+        }
+        for (i = 0; i < ARRAY_SIZE(counts) && counts[i].cmd != upper; i++);
+        if (i == ARRAY_SIZE(counts))
+        {
+            FIXME( "path command %c in %s.\n", cmd, debugstr_w(data) );
+            break;
+        }
+        for (n = 0, ok = TRUE; n < counts[i].args && ok; n++) p = path_number( p, &v[n], &ok );
+        if (!ok) break;
+        switch (upper)
+        {
+        case 'H': x = relative ? x + v[0] : v[0]; break;
+        case 'V': y = relative ? y + v[0] : v[0]; break;
+        default:
+            x = relative ? x + v[counts[i].args - 2] : v[counts[i].args - 2];
+            y = relative ? y + v[counts[i].args - 1] : v[counts[i].args - 1];
+            break;
+        }
+        if (upper == 'M' || !figure)
+        {
+            if (!(figures = realloc( impl->figures, (impl->figure_count + 1) * sizeof(*figures) ))) break;
+            impl->figures = figures;
+            figure = &figures[impl->figure_count++];
+            memset( figure, 0, sizeof(*figure) );
+            start_x = x;
+            start_y = y;
+            if (upper == 'M') cmd = relative ? 'l' : 'L';   /* more pairs after M are lines */
+        }
+        if (!add_point( figure, x, y )) break;
+    }
+    TRACE( "%s: %u figures.\n", debugstr_w(data), impl->figure_count );
+    window_invalidate();
+}
+
+BOOL path_set_data( IInspectable *object, const WCHAR *data )
+{
+    struct shape *impl = shape_from_object( object );
+
+    if (!impl || impl->kind != SHAPE_PATH) return FALSE;
+    path_parse( impl, data );
+    return TRUE;
+}
