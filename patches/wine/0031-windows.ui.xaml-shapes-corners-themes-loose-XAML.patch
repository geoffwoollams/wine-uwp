+static struct xaml_element *find_name( struct xaml_element *element, HSTRING name )
+{
+    struct xaml_element *found;
+    UINT32 i, count;
+    INT32 order;
+
+    if (element->name && SUCCEEDED(WindowsCompareStringOrdinal( element->name, name, &order )) && !order) return element;
+    if (!element->ops->child_count) return NULL;
+    count = element->ops->child_count( element );
+    for (i = 0; i < count; i++)
+    {
+        struct xaml_element *child = element->ops->child_at( element, i );
+        if (child && (found = find_name( child, name ))) return found;
+    }
+    return NULL;
+}
+
