+WINE_DEFAULT_DEBUG_CHANNEL(input);
+
+/* On Windows, LegacyGipGameControllerProvider is the Xbox accessory management interface of the GIP driver
+ * (xboxgip.sys): battery, firmware state, button remapping, pilot/copilot pairing. Wine has no GIP driver; Xbox
+ * controllers reach it through the host's driver as HID or SDL gamepads, so there is no GIP device to manage.
+ * FromGameController and FromGameControllerProvider therefore return no provider (NULL, like Windows does for a
+ * controller that isn't a GIP device), and nothing that would change a controller is ever sent. */
+
+struct preview_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ILegacyGipGameControllerProviderStatics ILegacyGipGameControllerProviderStatics_iface;
+    IGameControllerProviderInfoStatics IGameControllerProviderInfoStatics_iface;
+    const WCHAR *class_name;
+};
+
+static inline struct preview_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct preview_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct preview_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        return S_OK;
+    }
+    if (impl->ILegacyGipGameControllerProviderStatics_iface.lpVtbl &&
+        IsEqualGUID( iid, &IID_ILegacyGipGameControllerProviderStatics ))
+    {
+        *out = &impl->ILegacyGipGameControllerProviderStatics_iface;
+        return S_OK;
+    }
+    if (impl->IGameControllerProviderInfoStatics_iface.lpVtbl &&
+        IsEqualGUID( iid, &IID_IGameControllerProviderInfoStatics ))
+    {
+        *out = &impl->IGameControllerProviderInfoStatics_iface;
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IActivationFactory *iface ) { return 1; }
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    struct preview_statics *impl = impl_from_IActivationFactory( iface );
+    return WindowsCreateString( impl->class_name, wcslen( impl->class_name ), class_name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    WARN( "iface %p, instance %p: this class has no constructor.\n", iface, instance );
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
