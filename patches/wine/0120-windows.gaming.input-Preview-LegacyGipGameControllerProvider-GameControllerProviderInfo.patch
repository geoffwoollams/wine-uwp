+/* LegacyGipGameControllerProvider statics */
+
+DEFINE_IINSPECTABLE( legacy_gip_statics, ILegacyGipGameControllerProviderStatics, struct preview_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI legacy_gip_statics_FromGameController( ILegacyGipGameControllerProviderStatics *iface,
+                                                             IGameController *controller,
+                                                             ILegacyGipGameControllerProvider **value )
+{
+    TRACE( "iface %p, controller %p, value %p: no GIP devices.\n", iface, controller, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return controller ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI legacy_gip_statics_FromGameControllerProvider( ILegacyGipGameControllerProviderStatics *iface,
+                                                                     IGameControllerProvider *provider,
+                                                                     ILegacyGipGameControllerProvider **value )
+{
+    TRACE( "iface %p, provider %p, value %p: no GIP devices.\n", iface, provider, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return provider ? S_OK : E_INVALIDARG;
+}
+
+/* pilot/copilot pairing belongs to the GIP driver; with no GIP devices there is nothing to pair */
+static HRESULT WINAPI legacy_gip_statics_PairPilotToCopilot( ILegacyGipGameControllerProviderStatics *iface, __x_ABI_CWindows_CSystem_CIUser *user,
+                                                             HSTRING pilot_id, HSTRING copilot_id )
+{
+    FIXME( "iface %p, user %p, pilot %s, copilot %s: no GIP devices to pair.\n", iface, user,
+           debugstr_hstring( pilot_id ), debugstr_hstring( copilot_id ) );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI legacy_gip_statics_ClearPairing( ILegacyGipGameControllerProviderStatics *iface, __x_ABI_CWindows_CSystem_CIUser *user,
+                                                       HSTRING controller_id )
+{
+    TRACE( "iface %p, user %p, controller %s: nothing is paired.\n", iface, user, debugstr_hstring( controller_id ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI legacy_gip_statics_IsPilot( ILegacyGipGameControllerProviderStatics *iface, __x_ABI_CWindows_CSystem_CIUser *user,
+                                                  HSTRING controller_id, HSTRING *value )
+{
+    TRACE( "iface %p, user %p, controller %s, value %p: not paired.\n", iface, user, debugstr_hstring( controller_id ), value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI legacy_gip_statics_IsCopilot( ILegacyGipGameControllerProviderStatics *iface, __x_ABI_CWindows_CSystem_CIUser *user,
+                                                    HSTRING controller_id, HSTRING *value )
+{
+    TRACE( "iface %p, user %p, controller %s, value %p: not paired.\n", iface, user, debugstr_hstring( controller_id ), value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static const struct ILegacyGipGameControllerProviderStaticsVtbl legacy_gip_statics_vtbl =
+{
+    legacy_gip_statics_QueryInterface,
+    legacy_gip_statics_AddRef,
+    legacy_gip_statics_Release,
+    /* IInspectable methods */
+    legacy_gip_statics_GetIids,
+    legacy_gip_statics_GetRuntimeClassName,
+    legacy_gip_statics_GetTrustLevel,
+    /* ILegacyGipGameControllerProviderStatics methods */
+    legacy_gip_statics_FromGameController,
+    legacy_gip_statics_FromGameControllerProvider,
+    legacy_gip_statics_PairPilotToCopilot,
+    legacy_gip_statics_ClearPairing,
+    legacy_gip_statics_IsPilot,
+    legacy_gip_statics_IsCopilot,
+};
+
+/* GameControllerProviderInfo statics */
+
+DEFINE_IINSPECTABLE( provider_info_statics, IGameControllerProviderInfoStatics, struct preview_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI provider_info_statics_GetParentProviderId( IGameControllerProviderInfoStatics *iface,
+                                                                 IGameControllerProvider *provider, HSTRING *value )
+{
+    TRACE( "iface %p, provider %p, value %p.\n", iface, provider, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    /* Wine's providers are each a device of their own; none has a parent (such as a wireless adapter) */
+    return provider ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI provider_info_statics_GetProviderId( IGameControllerProviderInfoStatics *iface,
+                                                           IGameControllerProvider *provider, HSTRING *value )
+{
+    IWineGameControllerProvider *wine_provider;
+    HRESULT hr;
+
+    TRACE( "iface %p, provider %p, value %p.\n", iface, provider, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!provider) return E_INVALIDARG;
+    /* the device's own identifier, as RawGameController.NonRoamableId reports it */
+    if (FAILED(IGameControllerProvider_QueryInterface( provider, &IID_IWineGameControllerProvider, (void **)&wine_provider )))
+        return S_OK;
+    hr = IWineGameControllerProvider_get_NonRoamableId( wine_provider, value );
+    IWineGameControllerProvider_Release( wine_provider );
+    return hr;
+}
+
+static const struct IGameControllerProviderInfoStaticsVtbl provider_info_statics_vtbl =
+{
+    provider_info_statics_QueryInterface,
+    provider_info_statics_AddRef,
+    provider_info_statics_Release,
+    /* IInspectable methods */
+    provider_info_statics_GetIids,
+    provider_info_statics_GetRuntimeClassName,
+    provider_info_statics_GetTrustLevel,
+    /* IGameControllerProviderInfoStatics methods */
+    provider_info_statics_GetParentProviderId,
+    provider_info_statics_GetProviderId,
+};
+
+static struct preview_statics legacy_gip_statics =
+{
+    {&factory_vtbl},
+    {&legacy_gip_statics_vtbl},
+    {NULL},
+    L"Windows.Gaming.Input.Preview.LegacyGipGameControllerProvider",
+};
+
+static struct preview_statics provider_info_statics =
+{
+    {&factory_vtbl},
+    {NULL},
+    {&provider_info_statics_vtbl},
+    L"Windows.Gaming.Input.Preview.GameControllerProviderInfo",
+};
+
+IActivationFactory *legacy_gip_provider_factory = &legacy_gip_statics.IActivationFactory_iface;
+IActivationFactory *provider_info_factory = &provider_info_statics.IActivationFactory_iface;
