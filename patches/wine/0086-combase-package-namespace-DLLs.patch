Subject: combase: unregistered classes of a packaged app are looked for in the package's namespace-named DLLs

diff --git a/dlls/combase/roapi.c b/dlls/combase/roapi.c
index ad39ec8..f8f2249 100644
--- a/dlls/combase/roapi.c
+++ b/dlls/combase/roapi.c
@@ -72,6 +72,32 @@ static WCHAR *get_package_library_for_classid(const WCHAR *classid)
     return out;
 }
 
+/* As on Windows, a packaged app's class that nothing registers is looked for in the package, in a DLL
+ * named after its namespace: Microsoft.Xbox.Services.XboxLiveContext in Microsoft.Xbox.Services.dll,
+ * then in the shorter namespaces' DLLs (Microsoft.Xbox.dll, Microsoft.dll). */
+static WCHAR *get_package_namespace_library(const WCHAR *classid)
+{
+    WCHAR root[MAX_PATH], path[MAX_PATH], *name, *dot;
+    UINT32 root_len = ARRAY_SIZE(root);
+
+    if (GetCurrentPackagePath(&root_len, root)) return NULL;
+    if (wcslen(root) + wcslen(classid) + 6 > MAX_PATH) return NULL;
+    if (!(name = wcsdup(classid))) return NULL;
+    while ((dot = wcsrchr(name, '.')))
+    {
+        *dot = 0;
+        swprintf(path, ARRAY_SIZE(path), L"%s\\%s.dll", root, name);
+        if (GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES)
+        {
+            free(name);
+            TRACE("%s from the package's %s.\n", debugstr_w(classid), debugstr_w(path));
+            return wcsdup(path);
+        }
+    }
+    free(name);
+    return NULL;
+}
+
 static HRESULT get_library_for_classid(const WCHAR *classid, WCHAR **out)
 {
     ACTCTX_SECTION_KEYED_DATA data;
@@ -102,8 +128,9 @@ static HRESULT get_library_for_classid(const WCHAR *classid, WCHAR **out)
         return REGDB_E_READREGDB;
     if (RegOpenKeyExW(hkey_root, classid, 0, KEY_READ, &hkey_class))
     {
-        WARN("Class %s not found in registry\n", debugstr_w(classid));
         RegCloseKey(hkey_root);
+        if ((*out = get_package_namespace_library(classid))) return S_OK;
+        WARN("Class %s not found in registry\n", debugstr_w(classid));
         return REGDB_E_CLASSNOTREG;
     }
     RegCloseKey(hkey_root);
