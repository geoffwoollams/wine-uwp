+    TRACE("iface %p, value %p.\n", iface, value);
+    if (!value) return E_POINTER;
+    InitOnceExecuteOnce(&once, title_bar_init, NULL, NULL);
+    *value = &title_bar.IApplicationViewTitleBar_iface;
+    return S_OK;
+}
