+static HRESULT WINAPI title_bar_GetRuntimeClassName(IApplicationViewTitleBar *iface, HSTRING *name)
+{
+    static const WCHAR class_name[] = L"Windows.UI.ViewManagement.ApplicationViewTitleBar";
+    return WindowsCreateString(class_name, ARRAY_SIZE(class_name) - 1, name);
+}
+
+static HRESULT WINAPI title_bar_GetTrustLevel(IApplicationViewTitleBar *iface, TrustLevel *level)
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT title_bar_get(enum title_bar_color which, __FIReference_1_Color **value)
+{
+    if (!value) return E_POINTER;
+    EnterCriticalSection(&title_bar.cs);
+    if ((*value = title_bar.colors[which])) __FIReference_1_Color_AddRef(*value);
+    LeaveCriticalSection(&title_bar.cs);
+    return S_OK;
+}
+
+static HRESULT title_bar_put(enum title_bar_color which, __FIReference_1_Color *value)
+{
+    __FIReference_1_Color *old;
+
+    if (value) __FIReference_1_Color_AddRef(value);
+    EnterCriticalSection(&title_bar.cs);
+    old = title_bar.colors[which];
+    title_bar.colors[which] = value;
+    LeaveCriticalSection(&title_bar.cs);
+    if (old) __FIReference_1_Color_Release(old);
+    return S_OK;
+}
+
+#define TITLE_BAR_COLOR(name, which) \
+    static HRESULT WINAPI title_bar_put_##name(IApplicationViewTitleBar *iface, __FIReference_1_Color *value) \
+    { TRACE("iface %p, value %p.\n", iface, value); return title_bar_put(which, value); } \
+    static HRESULT WINAPI title_bar_get_##name(IApplicationViewTitleBar *iface, __FIReference_1_Color **value) \
+    { TRACE("iface %p, value %p.\n", iface, value); return title_bar_get(which, value); }
