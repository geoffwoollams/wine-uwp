+
+static BOOL WINAPI title_bar_init(INIT_ONCE *once, void *param, void **ctx)
+{
+    title_bar.IApplicationViewTitleBar_iface.lpVtbl = &title_bar_vtbl;
+    InitializeCriticalSection(&title_bar.cs);
+    return TRUE;
+}
