+/* ---- Style (created by markup) ---- */
+
+static HRESULT set_property( struct writer *w, IInspectable *target, const struct xprop *prop, struct xvalue *value,
+                             BOOL from_style );
+
+static void xvalue_copy( struct xvalue *dst, const struct xvalue *src )
+{
+    *dst = *src;
+    if (src->kind == XV_STRING) dst->s = wcsdup( src->s );
+    if (src->kind == XV_OBJECT && src->object) IInspectable_AddRef( src->object );
+}
+
+struct style_setter
+{
+    struct xprop prop;
+    struct xvalue value;
+};
+
+struct style
+{
+    IStyle IStyle_iface;
+    LONG ref;
+    WCHAR target[96];          /* TargetType, short name */
+    IInspectable *based_on;
+    struct style_setter *setters;
+    UINT32 count;
+    boolean sealed;
+};
+
+static const struct IStyleVtbl style_vtbl;
+
+static struct style *style_from_object( IInspectable *object )
+{
+    IStyle *style;
+    struct style *impl = NULL;
+
+    if (!object || FAILED(IInspectable_QueryInterface( object, &IID_IStyle, (void **)&style ))) return NULL;
+    if (style->lpVtbl == &style_vtbl) impl = CONTAINING_RECORD( style, struct style, IStyle_iface );
+    IStyle_Release( style );
+    return impl;
+}
+
+static inline struct style *impl_from_IStyle( IStyle *iface )
+{
+    return CONTAINING_RECORD( iface, struct style, IStyle_iface );
+}
+
+static HRESULT WINAPI style_QueryInterface( IStyle *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IStyle ))
+    {
+        *out = iface;
+        IStyle_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI style_AddRef( IStyle *iface )
+{
+    return InterlockedIncrement( &impl_from_IStyle( iface )->ref );
+}
+
+static ULONG WINAPI style_Release( IStyle *iface )
+{
+    struct style *impl = impl_from_IStyle( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT32 i;
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) xvalue_clear( &impl->setters[i].value );
+        free( impl->setters );
+        if (impl->based_on) IInspectable_Release( impl->based_on );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI style_GetIids( IStyle *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI style_GetRuntimeClassName( IStyle *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( L"Windows.UI.Xaml.Style", 21, class_name );
+}
+
+static HRESULT WINAPI style_GetTrustLevel( IStyle *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI style_get_IsSealed( IStyle *iface, boolean *value )
+{
+    *value = impl_from_IStyle( iface )->sealed;
+    return S_OK;
+}
+
+static HRESULT WINAPI style_get_Setters( IStyle *iface, ISetterBaseCollection **value )
+{
+    FIXME( "iface %p: the setters are not exposed as objects.\n", iface );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI style_get_TargetType( IStyle *iface, TypeName *value )
+{
+    struct style *impl = impl_from_IStyle( iface );
+    value->Kind = TypeKind_Metadata;
+    return WindowsCreateString( impl->target, wcslen( impl->target ), &value->Name );
+}
+
+static void style_set_target( struct style *impl, const WCHAR *name )
+{
+    const WCHAR *dot = wcsrchr( name, '.' );
+    lstrcpynW( impl->target, dot ? dot + 1 : name, ARRAY_SIZE(impl->target) );
+}
+
+static HRESULT WINAPI style_put_TargetType( IStyle *iface, TypeName value )
+{
+    style_set_target( impl_from_IStyle( iface ), WindowsGetStringRawBuffer( value.Name, NULL ) );
+    return S_OK;
+}
+
+static HRESULT WINAPI style_get_BasedOn( IStyle *iface, IStyle **value )
+{
+    struct style *impl = impl_from_IStyle( iface );
+    *value = NULL;
+    if (impl->based_on) return IInspectable_QueryInterface( impl->based_on, &IID_IStyle, (void **)value );
+    return S_OK;
+}
+
+static HRESULT WINAPI style_put_BasedOn( IStyle *iface, IStyle *value )
+{
+    struct style *impl = impl_from_IStyle( iface );
+
+    if (value == iface) return E_INVALIDARG;
+    if (value) IStyle_AddRef( value );
+    if (impl->based_on) IInspectable_Release( impl->based_on );
+    impl->based_on = (IInspectable *)value;
+    return S_OK;
+}
+
+static HRESULT WINAPI style_Seal( IStyle *iface )
+{
+    impl_from_IStyle( iface )->sealed = TRUE;
+    return S_OK;
+}
+
+static const struct IStyleVtbl style_vtbl =
+{
+    style_QueryInterface,
+    style_AddRef,
+    style_Release,
+    /* IInspectable methods */
+    style_GetIids,
+    style_GetRuntimeClassName,
+    style_GetTrustLevel,
+    /* IStyle methods */
+    style_get_IsSealed,
+    style_get_Setters,
+    style_get_TargetType,
+    style_put_TargetType,
+    style_get_BasedOn,
+    style_put_BasedOn,
+    style_Seal,
+};
+
+static IInspectable *style_create(void)
+{
+    struct style *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return NULL;
+    impl->IStyle_iface.lpVtbl = &style_vtbl;
+    impl->ref = 1;
+    return (IInspectable *)&impl->IStyle_iface;
+}
+
+/* takes the value */
+static void style_add_setter( struct style *impl, const struct xprop *prop, struct xvalue *value )
+{
+    struct style_setter *setters;
+    UINT32 i;
+
+    for (i = 0; i < impl->count; i++)
+    {
+        if (wcscmp( impl->setters[i].prop.name, prop->name )) continue;
+        xvalue_clear( &impl->setters[i].value );   /* a later setter for the same property wins */
+        impl->setters[i].value = *value;
+        memset( value, 0, sizeof(*value) );
+        return;
+    }
+    if (!(setters = realloc( impl->setters, (impl->count + 1) * sizeof(*setters) ))) return;
+    impl->setters = setters;
+    setters[impl->count].prop = *prop;
+    setters[impl->count].value = *value;
+    memset( value, 0, sizeof(*value) );
+    impl->count++;
+}
+
+/* apply BasedOn's setters, then the style's own; properties set directly on the element keep their values */
+void style_apply( IInspectable *style, IInspectable *target )
+{
+    struct style *impl = style_from_object( style );
+    struct xvalue copy;
+    UINT32 i;
+
+    if (!impl) return;
+    TRACE( "style %p (%s, %u setters) on %p.\n", impl, debugstr_w(impl->target), impl->count, target );
+    if (impl->based_on) style_apply( impl->based_on, target );
+    for (i = 0; i < impl->count; i++)
+    {
+        xvalue_copy( &copy, &impl->setters[i].value );
+        set_property( NULL, target, &impl->setters[i].prop, &copy, TRUE );
+        xvalue_clear( &copy );
+    }
+}
+
+/* where a setter's {StaticResource}/{ThemeResource} value node puts Setter.Value */
+struct value_sink
+{
+    IInspectable IInspectable_iface;
+    LONG ref;
+    struct xvalue value;
+};
+
+static const struct IInspectableVtbl value_sink_vtbl;
+
+static HRESULT WINAPI sink_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ))
+    {
+        *out = iface;
+        IInspectable_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_AddRef( IInspectable *iface )
+{
