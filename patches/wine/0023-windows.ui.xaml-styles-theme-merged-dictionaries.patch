+BOOL element_is_local( struct xaml_element *element, const WCHAR *property )
+{
+    UINT32 i;
+    for (i = 0; i < element->local_count; i++) if (!wcscmp( element->local_properties[i], property )) return TRUE;
+    return FALSE;
+}
+
+/* a value set directly on the element: it takes precedence over style setters (no full dependency property
+ * value precedence yet, only this "local beats style" rule) */
+void element_mark_local( struct xaml_element *element, const WCHAR *property )
+{
+    WCHAR **props;
+
+    if (element_is_local( element, property )) return;
+    if (!(props = realloc( element->local_properties, (element->local_count + 1) * sizeof(*props) ))) return;
+    element->local_properties = props;
+    props[element->local_count++] = wcsdup( property );
+}
