+/* ---- markup ---- */
+
+/* the text properties markup sets (TextBox.Text, PlaceholderText, AcceptsReturn, ...); FALSE if not one */
+BOOL textbox_set_markup( IInspectable *target, const WCHAR *name, const WCHAR *str, INT32 number, BOOL is_bool )
+{
+    struct xaml_element *element = element_from_object( target );
+    struct text_edit *e;
+    HSTRING hstr;
+    boolean b = str ? !wcsicmp( str, L"True" ) : number != 0;
+
+    if (!element || element->ops->focusable == NULL) return FALSE;
+    if (!element->class_name || (wcscmp( element->class_name, RuntimeClass_Windows_UI_Xaml_Controls_TextBox ) &&
+                                 wcscmp( element->class_name, RuntimeClass_Windows_UI_Xaml_Controls_PasswordBox )))
+        return FALSE;
+    e = edit_of( impl_from_element( element ) );
+    if (str && (!wcscmp( name, L"Text" ) || !wcscmp( name, L"Password" ))) set_text( e, str, wcslen( str ) );
+    else if (str && !wcscmp( name, L"PlaceholderText" ))
+    {
+        WindowsCreateString( str, wcslen( str ), &hstr );
+        put_placeholder( e, hstr );
+        WindowsDeleteString( hstr );
+    }
+    else if (str && !wcscmp( name, L"Header" ))
+    {
+        /* a text header from markup: shown as text, Header itself stays unset */
+        WindowsDeleteString( e->header_text );
+        WindowsCreateString( str, wcslen( str ), &e->header_text );
+    }
+    else if (str && !wcscmp( name, L"PasswordChar" ) && *str) e->password_char = str[0];
+    else if (!wcscmp( name, L"AcceptsReturn" )) e->accepts_return = b;
+    else if (!wcscmp( name, L"IsReadOnly" )) e->read_only = b;
+    else if (!wcscmp( name, L"MaxLength" )) e->max_length = str ? wcstol( str, NULL, 10 ) : number;
+    else if (!wcscmp( name, L"TextWrapping" ))
+    {
+        static const WCHAR *const names[] = { L"NoWrap", L"Wrap", L"WrapWholeWords" };
+        if (str) { for (number = 0; number < 3 && wcsicmp( str, names[number] ); number++); }
+        if (number == 0 || number == 2) e->wrapping = number == 0 ? TextWrapping_NoWrap : TextWrapping_Wrap;
+        else e->wrapping = TextWrapping_Wrap;
+    }
+    else return FALSE;
+    window_invalidate();
+    return TRUE;
+}
+
+/* ---- the control ---- */
+
+HRESULT textbox_init( struct button *impl )
+{
+    struct text_edit *e;
+
+    if (!(e = calloc( 1, sizeof(*e) ))) return E_OUTOFMEMORY;
+    e->ITextBox_iface.lpVtbl = &tb_vtbl;
+    e->ITextBox2_iface.lpVtbl = &tb2_vtbl;
+    e->IPasswordBox_iface.lpVtbl = &pb_vtbl;
+    e->IPasswordBox2_iface.lpVtbl = &pb2_vtbl;
+    e->button = impl;
+    e->password_char = 0x25cf;   /* ● */
+    e->spell_check = e->prediction = e->reveal_button = TRUE;
+    e->wrapping = TextWrapping_NoWrap;
+    e->alignment = TextAlignment_Left;   /* TextAlignment's zero is Center */
+    impl->edit = e;
+    /* the default TextBox style: a 2 px border, stretched across its slot */
+    impl->border_thickness.Left = impl->border_thickness.Top = impl->border_thickness.Right = impl->border_thickness.Bottom = 2;
+    impl->padding.Left = impl->padding.Top = impl->padding.Right = impl->padding.Bottom = 0;
+    impl->element.horizontal_alignment = HorizontalAlignment_Stretch;
+    impl->element.vertical_alignment = VerticalAlignment_Top;
+    return S_OK;
+}
+
+void *textbox_default_iface( struct button *impl )
+{
+    return impl->kind == BUTTON_PASSWORD ? (void *)&impl->edit->IPasswordBox_iface : (void *)&impl->edit->ITextBox_iface;
+}
+
+HRESULT textbox_query_interface( struct button *impl, REFIID iid, void **out )
+{
+    struct text_edit *e = impl->edit;
+
+    if (impl->kind == BUTTON_TEXTBOX && IsEqualGUID( iid, &IID_ITextBox )) *out = &e->ITextBox_iface;
+    else if (impl->kind == BUTTON_TEXTBOX && IsEqualGUID( iid, &IID_ITextBox2 )) *out = &e->ITextBox2_iface;
+    else if (impl->kind == BUTTON_PASSWORD && IsEqualGUID( iid, &IID_IPasswordBox )) *out = &e->IPasswordBox_iface;
+    else if (impl->kind == BUTTON_PASSWORD && IsEqualGUID( iid, &IID_IPasswordBox2 )) *out = &e->IPasswordBox2_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+void textbox_destroy( struct button *impl )
+{
+    struct text_edit *e = impl->edit;
+
+    if (!e) return;
+    if (e->text)
+    {
+        SecureZeroMemory( e->text, e->capacity * sizeof(WCHAR) );   /* it may have held a password */
+        free( e->text );
+    }
+    if (e->input_scope) IInspectable_Release( e->input_scope );
+    if (e->header) IInspectable_Release( e->header );
+    if (e->header_template) IDataTemplate_Release( e->header_template );
+    if (e->highlight) ISolidColorBrush_Release( e->highlight );
+    WindowsDeleteString( e->header_text );
+    WindowsDeleteString( e->placeholder );
+    event_list_clear( &e->text_changed );
+    event_list_clear( &e->selection_changed );
+    event_list_clear( &e->password_changed );
+    event_list_clear( &e->paste );
+    event_list_clear( &e->context_menu );
+    free( e );
+    impl->edit = NULL;
+}
