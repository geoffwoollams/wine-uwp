--- a/dlls/windows.ui.xaml/render.c
+++ b/dlls/windows.ui.xaml/render.c
@@ -382,6 +382,63 @@ BOOL dwrite_measure( const struct text_format *format, HSTRING text, float avail
     return TRUE;
 }
 
+/* text editing: where the caret before character index is (x, y and line height, relative to the layout's origin) */
+BOOL dwrite_caret( const struct text_format *format, HSTRING text, float width, UINT32 index,
+                   float *x, float *y, float *height )
+{
+    IDWriteTextLayout *layout;
+    DWRITE_HIT_TEST_METRICS metrics;
+    HSTRING space = NULL;
+    FLOAT px, py;
+
+    /* Wine's HitTestTextPosition faults on a layout without characters: an empty text's caret is where a space's is */
+    if (!WindowsGetStringLen( text ))
+    {
+        WindowsCreateString( L" ", 1, &space );
+        text = space;
+        index = 0;
+    }
+    layout = text_layout( format, text, min( width, 1e6f ), 1e6f );
+    WindowsDeleteString( space );
+
+    if (!layout) return FALSE;
+    if (FAILED(IDWriteTextLayout_HitTestTextPosition( layout, index, FALSE, &px, &py, &metrics )))
+    {
+        IDWriteTextLayout_Release( layout );
+        return FALSE;
+    }
+    *x = px;
+    *y = py;
+    *height = metrics.height;
+    IDWriteTextLayout_Release( layout );
+    return TRUE;
+}
+
+/* and which character index a point is nearest to */
+BOOL dwrite_hit( const struct text_format *format, HSTRING text, float width, float x, float y, UINT32 *index )
+{
+    IDWriteTextLayout *layout;
+    DWRITE_HIT_TEST_METRICS metrics;
+    BOOL trailing, inside;
+
+    if (!WindowsGetStringLen( text ))
+    {
+        *index = 0;   /* as above: nothing to hit but the start */
+        return TRUE;
+    }
+    layout = text_layout( format, text, min( width, 1e6f ), 1e6f );
+
+    if (!layout) return FALSE;
+    if (FAILED(IDWriteTextLayout_HitTestPoint( layout, x, y, &trailing, &inside, &metrics )))
+    {
+        IDWriteTextLayout_Release( layout );
+        return FALSE;
+    }
+    *index = metrics.textPosition + (trailing ? metrics.length : 0);
+    IDWriteTextLayout_Release( layout );
+    return TRUE;
+}
+
 BOOL d2d_draw_text( struct layout_context *ctx, const struct text_format *format, HSTRING text,
                     const struct layout_rect *rect, Color color )
 {
