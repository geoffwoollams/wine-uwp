+
+#include <math.h>
+
+#include "private.h"
+#include "control.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* TextBox and PasswordBox are Control kinds of struct button (BUTTON_TEXTBOX, BUTTON_PASSWORD) with their text in a
+ * struct text_edit. They draw Windows 10's look: a 2 px border (accent coloured while focused), the Header above and
+ * the PlaceholderText while empty. Text is laid out with DirectWrite, which also places the caret and maps clicks
+ * to characters; a single-line box scrolls sideways to keep the caret in view.
+ *
+ * Editing: typed characters (WM_CHAR) replace the selection; Backspace, Delete, the arrow keys (Shift extends the
+ * selection, Ctrl moves by word), Home and End, Enter for a new line with AcceptsReturn, Ctrl+A, and Ctrl+C / X / V
+ * through the clipboard (not for a PasswordBox). A press places the caret and a drag selects; Shift+press extends.
+ * TextChanged and SelectionChanged (TextBox) or PasswordChanged (PasswordBox) follow every change, at once rather
+ * than queued as on Windows. Not supported: IME composition, undo, spell checking, the touch keyboard, the
+ * password reveal button and the context menu. */
+
+#define TEXT_PADDING_LEFT 10.0f
+#define TEXT_PADDING_TOP 3.0f
+#define TEXT_PADDING_RIGHT 6.0f
+#define TEXT_PADDING_BOTTOM 5.0f
+#define HEADER_GAP 8.0f
+
+struct text_edit
+{
+    ITextBox ITextBox_iface;
+    ITextBox2 ITextBox2_iface;
+    IPasswordBox IPasswordBox_iface;
+    IPasswordBox2 IPasswordBox2_iface;
+    struct button *button;
+
+    WCHAR *text;
+    UINT32 len, capacity;
+    UINT32 caret, anchor;        /* the selection runs between them */
+    INT32 max_length;
+    boolean read_only, accepts_return, spell_check, prediction, prevent_keyboard, color_font, reveal_button;
+    TextAlignment alignment;
+    TextWrapping wrapping;
+    IInspectable *input_scope;
+    IInspectable *header;
+    HSTRING header_text;
+    IDataTemplate *header_template;
+    HSTRING placeholder;
+    ISolidColorBrush *highlight;
+    WCHAR password_char;
+    struct event_list text_changed, selection_changed, password_changed, paste, context_menu;
+
+    float scroll_x;              /* single-line: how far the text is scrolled left */
+    BOOL dragging, pointer_over;
+};
+
+static inline struct text_edit *edit_of( struct button *impl ) { return impl->edit; }
+static BOOL is_password( struct text_edit *e ) { return e->button->kind == BUTTON_PASSWORD; }
+static UINT32 sel_start( struct text_edit *e ) { return min( e->caret, e->anchor ); }
+static UINT32 sel_end( struct text_edit *e ) { return max( e->caret, e->anchor ); }
+static BOOL multiline( struct text_edit *e ) { return e->accepts_return && !is_password( e ); }
+
+/* the text as shown: the password character for each character of a PasswordBox */
+static HSTRING display_text( struct text_edit *e )
+{
+    HSTRING str = NULL;
+    WCHAR *buf;
+    UINT32 i;
+
+    if (!is_password( e ))
+    {
+        WindowsCreateString( e->text, e->len, &str );
+        return str;
+    }
+    if (!(buf = malloc( (e->len + 1) * sizeof(WCHAR) ))) return NULL;
+    for (i = 0; i < e->len; i++) buf[i] = e->password_char;
+    WindowsCreateString( buf, e->len, &str );
+    free( buf );
+    return str;
+}
+
+static void edit_format( struct text_edit *e, struct text_format *format )
+{
+    struct button *impl = e->button;
+    format->font_size = impl->font_size;
+    format->weight = impl->font_weight.Weight;
+    format->italic = impl->font_style != FontStyle_Normal;
+    format->wrap = multiline( e ) && e->wrapping != TextWrapping_NoWrap;
+    format->alignment = e->alignment;
+}
+
+/* ---- events ---- */
+
+struct text_changed_args
+{
+    ITextChangedEventArgs ITextChangedEventArgs_iface;
+    IRoutedEventArgs IRoutedEventArgs_iface;
+    LONG ref;
+    IInspectable *source;
+};
+
+static inline struct text_changed_args *impl_from_ITextChangedEventArgs( ITextChangedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct text_changed_args, ITextChangedEventArgs_iface );
+}
+
+static HRESULT WINAPI tc_args_QueryInterface( ITextChangedEventArgs *iface, REFIID iid, void **out )
+{
+    struct text_changed_args *impl = impl_from_ITextChangedEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITextChangedEventArgs ))
+        *out = &impl->ITextChangedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IRoutedEventArgs )) *out = &impl->IRoutedEventArgs_iface;
+    else { *out = NULL; return E_NOINTERFACE; }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI tc_args_AddRef( ITextChangedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_ITextChangedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI tc_args_Release( ITextChangedEventArgs *iface )
+{
+    struct text_changed_args *impl = impl_from_ITextChangedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->source) IInspectable_Release( impl->source );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI tc_args_GetIids( ITextChangedEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI tc_args_GetRuntimeClassName( ITextChangedEventArgs *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI tc_args_GetTrustLevel( ITextChangedEventArgs *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static const struct ITextChangedEventArgsVtbl tc_args_vtbl =
+{
+    tc_args_QueryInterface, tc_args_AddRef, tc_args_Release, tc_args_GetIids, tc_args_GetRuntimeClassName, tc_args_GetTrustLevel,
+};
+
+DEFINE_IINSPECTABLE( tc_routed, IRoutedEventArgs, struct text_changed_args, ITextChangedEventArgs_iface )
+
+static HRESULT WINAPI tc_routed_get_OriginalSource( IRoutedEventArgs *iface, IInspectable **value )
+{
+    struct text_changed_args *impl = impl_from_IRoutedEventArgs( iface );
+    if ((*value = impl->source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IRoutedEventArgsVtbl tc_routed_vtbl =
+{
+    tc_routed_QueryInterface, tc_routed_AddRef, tc_routed_Release, tc_routed_GetIids, tc_routed_GetRuntimeClassName,
+    tc_routed_GetTrustLevel, tc_routed_get_OriginalSource,
+};
+
+static void raise_text_changed( struct text_edit *e )
+{
+    struct button *impl = e->button;
+    struct text_changed_args *args;
+    IUnknown **handlers;
+    UINT32 i, count;
+
+    window_invalidate();
+    if (is_password( e ))
+    {
+        element_property_changed( impl->element.outer, L"Password" );
+        raise_event( impl, &e->password_changed, "PasswordChanged" );
+        return;
+    }
+    element_property_changed( impl->element.outer, L"Text" );
+    if (!(count = e->text_changed.count) || !(args = calloc( 1, sizeof(*args) ))) return;
+    args->ITextChangedEventArgs_iface.lpVtbl = &tc_args_vtbl;
+    args->IRoutedEventArgs_iface.lpVtbl = &tc_routed_vtbl;
+    args->ref = 1;
+    if ((args->source = impl->element.outer)) IInspectable_AddRef( args->source );
+    if ((handlers = calloc( count, sizeof(*handlers) )))
+    {
+        for (i = 0; i < count; i++) if ((handlers[i] = e->text_changed.handlers[i])) IUnknown_AddRef( handlers[i] );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            ITextChangedEventHandler_Invoke( (ITextChangedEventHandler *)handlers[i], impl->element.outer,
+                                             &args->ITextChangedEventArgs_iface );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+    }
+    ITextChangedEventArgs_Release( &args->ITextChangedEventArgs_iface );
+}
+
+/* ---- editing ---- */
+
+static void set_selection( struct text_edit *e, UINT32 anchor, UINT32 caret )
+{
+    anchor = min( anchor, e->len );
+    caret = min( caret, e->len );
+    if (anchor == e->anchor && caret == e->caret) return;
+    e->anchor = anchor;
+    e->caret = caret;
+    window_invalidate();
+    if (!is_password( e )) raise_event( e->button, &e->selection_changed, "SelectionChanged" );
+}
+
+/* replace the selection with text (which may be empty); FALSE if nothing could change */
+static BOOL replace_selection( struct text_edit *e, const WCHAR *text, UINT32 len, BOOL from_user )
+{
+    UINT32 start = sel_start( e ), end = sel_end( e ), new_len;
+    WCHAR *buf;
+
+    if (from_user && e->read_only) return FALSE;
+    if (e->max_length > 0 && e->len - (end - start) + len > e->max_length)
+        len = e->max_length > e->len - (end - start) ? e->max_length - (e->len - (end - start)) : 0;
+    if (!len && start == end) return FALSE;
+    new_len = e->len - (end - start) + len;
+    if (new_len + 1 > e->capacity)
+    {
+        UINT32 capacity = max( 64, (new_len + 1) * 2 );
+        if (!(buf = realloc( e->text, capacity * sizeof(WCHAR) ))) return FALSE;
+        e->text = buf;
+        e->capacity = capacity;
+    }
+    memmove( e->text + start + len, e->text + end, (e->len - end) * sizeof(WCHAR) );
+    memcpy( e->text + start, text, len * sizeof(WCHAR) );
+    e->len = new_len;
+    e->text[e->len] = 0;
+    e->anchor = e->caret = start + len;
+    raise_text_changed( e );
+    if (!is_password( e )) raise_event( e->button, &e->selection_changed, "SelectionChanged" );
+    return TRUE;
+}
+
+static HRESULT set_text( struct text_edit *e, const WCHAR *text, UINT32 len )
+{
+    e->anchor = 0;
+    e->caret = e->len;
+    if (!replace_selection( e, text, len, FALSE ) && len) return E_OUTOFMEMORY;
+    /* Windows puts the caret at the start after the text is set from code */
+    e->anchor = e->caret = 0;
+    e->scroll_x = 0;
+    return S_OK;
+}
+
+static BOOL is_word_char( WCHAR c )
+{
+    return iswalnum( c ) || c == '_';
+}
+
+static UINT32 word_left( struct text_edit *e, UINT32 pos )
+{
+    while (pos && !is_word_char( e->text[pos - 1] )) pos--;
+    while (pos && is_word_char( e->text[pos - 1] )) pos--;
+    return pos;
+}
+
+static UINT32 word_right( struct text_edit *e, UINT32 pos )
+{
+    while (pos < e->len && is_word_char( e->text[pos] )) pos++;
+    while (pos < e->len && !is_word_char( e->text[pos] )) pos++;
+    return pos;
+}
+
+static UINT32 line_start( struct text_edit *e, UINT32 pos )
+{
+    while (pos && e->text[pos - 1] != '\n') pos--;
+    return pos;
+}
+
+static UINT32 line_end( struct text_edit *e, UINT32 pos )
+{
+    while (pos < e->len && e->text[pos] != '\n') pos++;
+    return pos;
+}
+
+static void copy_selection( struct text_edit *e )
+{
+    UINT32 start = sel_start( e ), len = sel_end( e ) - start;
+    HGLOBAL mem;
+    WCHAR *buf;
+
+    if (!len || is_password( e ) || !OpenClipboard( NULL )) return;
+    EmptyClipboard();
+    if ((mem = GlobalAlloc( GMEM_MOVEABLE, (len + 1) * sizeof(WCHAR) )))
+    {
+        buf = GlobalLock( mem );
+        memcpy( buf, e->text + start, len * sizeof(WCHAR) );
+        buf[len] = 0;
+        GlobalUnlock( mem );
+        if (!SetClipboardData( CF_UNICODETEXT, mem )) GlobalFree( mem );
+    }
+    CloseClipboard();
+}
+
+static void paste( struct text_edit *e )
+{
+    HANDLE mem;
+    const WCHAR *buf;
+    WCHAR *text;
+    UINT32 len, i, j;
+
+    if (e->read_only || !OpenClipboard( NULL )) return;
+    if ((mem = GetClipboardData( CF_UNICODETEXT )) && (buf = GlobalLock( mem )))
+    {
+        len = wcslen( buf );
+        if ((text = malloc( (len + 1) * sizeof(WCHAR) )))
+        {
+            /* a single-line box takes the first line only, and line breaks become \n */
+            for (i = j = 0; i < len; i++)
+            {
+                if (buf[i] == '\r') continue;
+                if (buf[i] == '\n' && !multiline( e )) break;
+                text[j++] = buf[i];
+            }
+            replace_selection( e, text, j, TRUE );
+            free( text );
+        }
+        GlobalUnlock( mem );
+    }
+    CloseClipboard();
+}
+
+BOOL textbox_key( struct button *impl, BOOL down, WPARAM vk )
+{
+    struct text_edit *e = edit_of( impl );
+    BOOL shift = GetKeyState( VK_SHIFT ) < 0, ctrl = GetKeyState( VK_CONTROL ) < 0;
+    UINT32 pos = e->caret;
+    static const WCHAR newline = '\n';
+
+    if (!down || !impl->enabled || element_focus_state( &impl->element ) == FocusState_Unfocused) return FALSE;
+    switch (vk)
+    {
+    case VK_LEFT:
+        if (!shift && e->caret != e->anchor) pos = sel_start( e );
+        else if (pos) pos = ctrl ? word_left( e, pos ) : pos - 1;
+        break;
+    case VK_RIGHT:
+        if (!shift && e->caret != e->anchor) pos = sel_end( e );
+        else if (pos < e->len) pos = ctrl ? word_right( e, pos ) : pos + 1;
+        break;
+    case VK_HOME:
+        pos = ctrl ? 0 : line_start( e, pos );
+        break;
+    case VK_END:
+        pos = ctrl ? e->len : line_end( e, pos );
+        break;
+    case VK_UP:
+    case VK_DOWN:
+    {
+        UINT32 column = pos - line_start( e, pos ), start;
+        if (!multiline( e )) return FALSE;
+        if (vk == VK_UP)
+        {
+            if (!(start = line_start( e, pos ))) { pos = 0; break; }
+            start = line_start( e, start - 1 );
+        }
+        else
+        {
+            if ((start = line_end( e, pos )) == e->len) { pos = e->len; break; }
+            start++;
+        }
+        pos = min( start + column, line_end( e, start ) );
+        break;
+    }
+    case VK_BACK:
+        if (e->caret == e->anchor && e->caret) e->anchor = ctrl ? word_left( e, e->caret ) : e->caret - 1;
+        replace_selection( e, NULL, 0, TRUE );
+        return TRUE;
+    case VK_DELETE:
+        if (e->caret == e->anchor && e->caret < e->len) e->anchor = ctrl ? word_right( e, e->caret ) : e->caret + 1;
+        replace_selection( e, NULL, 0, TRUE );
+        return TRUE;
+    case VK_RETURN:
+        if (!multiline( e )) return FALSE;
+        replace_selection( e, &newline, 1, TRUE );
+        return TRUE;
+    case 'A':
+        if (!ctrl) return FALSE;
+        set_selection( e, 0, e->len );
+        return TRUE;
+    case 'C':
+    case VK_INSERT:
+        if (!ctrl) return FALSE;
+        copy_selection( e );
+        return TRUE;
+    case 'X':
+        if (!ctrl) return FALSE;
+        if (is_password( e )) return TRUE;
+        copy_selection( e );
+        replace_selection( e, NULL, 0, TRUE );
+        return TRUE;
+    case 'V':
+        if (!ctrl) return FALSE;
+        paste( e );
+        return TRUE;
+    default:
+        return FALSE;
+    }
+    set_selection( e, shift ? e->anchor : pos, pos );
+    return TRUE;
+}
+
+BOOL textbox_char( struct button *impl, WCHAR ch )
+{
+    struct text_edit *e = edit_of( impl );
+
+    if (!impl->enabled || element_focus_state( &impl->element ) == FocusState_Unfocused) return FALSE;
+    /* control characters (Backspace, Enter, Tab, Ctrl+letter) are handled as keys */
+    if (ch < 0x20 || ch == 0x7f) return FALSE;
+    replace_selection( e, &ch, 1, TRUE );
+    return TRUE;
+}
+
+/* ---- layout and drawing ---- */
+
+static float header_height( struct text_edit *e, struct layout_context *ctx )
+{
+    struct text_format format = { e->button->font_size, 400, FALSE, FALSE, TextAlignment_Left };
+    float w, h;
+
+    if (!WindowsGetStringLen( e->header_text )) return 0;
+    text_measure( ctx, &format, e->header_text, INFINITY, &w, &h );
+    return h + HEADER_GAP;
+}
+
+void textbox_measure( struct button *impl, struct layout_context *ctx, float avail_width, float avail_height,
+                      float *width, float *height )
+{
+    struct text_edit *e = edit_of( impl );
+    const Thickness *b = &impl->border_thickness;
+    float extra_w = b->Left + b->Right + TEXT_PADDING_LEFT + TEXT_PADDING_RIGHT;
+    float extra_h = b->Top + b->Bottom + TEXT_PADDING_TOP + TEXT_PADDING_BOTTOM;
+    struct text_format format;
+    float tw = 0, th = 0, lw, lh;
+    HSTRING str, line;
+
+    edit_format( e, &format );
+    WindowsCreateString( L"Ag", 2, &line );
+    text_measure( ctx, &format, line, INFINITY, &lw, &lh );   /* one line's height */
+    WindowsDeleteString( line );
+    if ((str = display_text( e )))
+    {
+        text_measure( ctx, &format, str, format.wrap ? max( 0.0f, avail_width - extra_w ) : INFINITY, &tw, &th );
+        WindowsDeleteString( str );
+    }
+    /* the default style: MinWidth 64, MinHeight 32 */
+    *width = max( 64.0f, tw + extra_w );
+    *height = max( 32.0f, max( th, lh ) + extra_h ) + header_height( e, ctx );
+    if (!multiline( e )) *height = max( 32.0f, lh + extra_h ) + header_height( e, ctx );
+}
+
+/* the box (below the header) and the text area inside its border and padding */
+static void edit_rects( struct button *impl, struct layout_context *ctx, struct layout_rect *box, struct layout_rect *text )
+{
+    struct text_edit *e = edit_of( impl );
+    const Thickness *b = &impl->border_thickness;
+    float header = ctx ? header_height( e, ctx ) : 0;
+
+    *box = impl->element.bounds;
+    box->y += header;
+    box->height = max( 0.0f, box->height - header );
+    text->x = box->x + b->Left + TEXT_PADDING_LEFT;
+    text->y = box->y + b->Top + TEXT_PADDING_TOP;
+    text->width = max( 0.0f, box->width - b->Left - b->Right - TEXT_PADDING_LEFT - TEXT_PADDING_RIGHT );
+    text->height = max( 0.0f, box->height - b->Top - b->Bottom - TEXT_PADDING_TOP - TEXT_PADDING_BOTTOM );
+}
+
+static float layout_width( struct text_edit *e, const struct layout_rect *text )
+{
+    struct text_format format;
+    edit_format( e, &format );
+    return format.wrap ? text->width : 1e6f;
+}
+
+/* the caret's place in the text area's coordinates, before scrolling */
+static BOOL caret_pos( struct text_edit *e, const struct layout_rect *text, UINT32 index, float *x, float *y, float *h )
+{
+    struct text_format format;
+    HSTRING str = display_text( e );
+    BOOL ret;
+
+    edit_format( e, &format );
+    ret = dwrite_caret( &format, str, layout_width( e, text ), index, x, y, h );
+    WindowsDeleteString( str );
+    if (!ret)
+    {
+        /* without DirectWrite: an estimate for a single line */
+        *x = index * format.font_size * 0.5f;
+        *y = 0;
+        *h = format.font_size * 1.33f;
+    }
+    return TRUE;
+}
+
+static UINT32 hit_index( struct text_edit *e, const struct layout_rect *text, float x, float y )
+{
+    struct text_format format;
+    HSTRING str = display_text( e );
+    UINT32 index = 0;
+
+    edit_format( e, &format );
+    if (!dwrite_hit( &format, str, layout_width( e, text ), x - text->x + e->scroll_x, y - text->y, &index ))
+        index = max( 0.0f, x - text->x + e->scroll_x ) / (format.font_size * 0.5f);
+    WindowsDeleteString( str );
+    return min( index, e->len );
+}
+
+static void fill_argb( struct layout_context *ctx, const struct layout_rect *r, Color c )
+{
+    if (ctx->rt) d2d_fill_color( ctx, r, c );
+    else element_fill_color( ctx, r, RGB( c.R, c.G, c.B ) );
+}
+
+void textbox_render( struct button *impl, struct layout_context *ctx )
+{
+    struct text_edit *e = edit_of( impl );
+    BOOL focused = element_focus_state( &impl->element ) != FocusState_Unfocused;
+    struct layout_rect box, text, r;
+    struct text_format format;
+    struct look background, border, fg, placeholder;
+    COLORREF accent = RGB(0, 120, 215);
+    float cx, cy, ch, x1, y1, h1;
+    HSTRING str;
+    Color c;
+
+    edit_rects( impl, ctx, &box, &text );
+    if (WindowsGetStringLen( e->header_text ))
+    {
+        struct text_format hf = { impl->font_size, 400, FALSE, FALSE, TextAlignment_Left };
+        r = impl->element.bounds;
+        r.height = box.y - r.y;
+        text_draw( ctx, &hf, e->header_text, &r, ctx->foreground );
+    }
+
+    /* Windows 10's TextControl colours */
+    set_look( &background, ctx->dark ? (focused ? RGB(0, 0, 0) : RGB(31, 31, 31)) : RGB(255, 255, 255) );
+    set_look( &border, focused ? accent : e->pointer_over ? (ctx->dark ? RGB(204, 204, 204) : RGB(102, 102, 102))
+                                                          : (ctx->dark ? RGB(102, 102, 102) : RGB(153, 153, 153)) );
+    set_look( &fg, ctx->dark ? RGB(255, 255, 255) : RGB(0, 0, 0) );
+    set_look( &placeholder, ctx->dark ? RGB(153, 153, 153) : RGB(102, 102, 102) );
+    if (!impl->enabled) set_look( &fg, ctx->dark ? RGB(102, 102, 102) : RGB(153, 153, 153) );
+    if (impl->background && !focused) brush_look( impl->background, &background );
+    if (impl->border_brush && !focused) brush_look( impl->border_brush, &border );
+    if (impl->foreground) brush_look( impl->foreground, &fg );
+    if (background.paint) element_fill_color( ctx, &box, background.color );
+    if (border.paint) element_frame_color( ctx, &box, &impl->border_thickness, border.color );
+
+    edit_format( e, &format );
+    if (ctx->rt) d2d_push_clip( ctx, &text );
+
+    /* keep the caret in view of a single-line box */
+    caret_pos( e, &text, e->caret, &cx, &cy, &ch );
+    if (!format.wrap)
+    {
+        if (cx - e->scroll_x > text.width - 1) e->scroll_x = cx - text.width + 1;
+        if (cx < e->scroll_x) e->scroll_x = cx;
+        if (e->scroll_x < 0) e->scroll_x = 0;
+    }
+    else e->scroll_x = 0;
+
+    r = text;
+    r.x -= e->scroll_x;
+    if (!format.wrap) r.width = max( text.width, 1e5f );
+    if (!e->len && WindowsGetStringLen( e->placeholder ))
+        text_draw( ctx, &format, e->placeholder, &r, placeholder.color );
+    else if ((str = display_text( e )))
+    {
+        c.A = 0xff; c.R = GetRValue( fg.color ); c.G = GetGValue( fg.color ); c.B = GetBValue( fg.color );
+        text_draw_argb( ctx, &format, str, &r, c );
+        if (e->caret != e->anchor && focused)
+        {
+            /* the selection, line by line: the accent colour over the text, translucent so the text shows */
+            UINT32 start = sel_start( e ), end = sel_end( e ), a = start, b;
+            Color sel = { 0x80, 0, 120, 215 };
+            while (a < end)
+            {
+                b = min( line_end( e, a ), end );
+                caret_pos( e, &text, a, &x1, &y1, &h1 );
+                caret_pos( e, &text, b, &cx, &cy, &ch );
+                r.x = text.x - e->scroll_x + x1;
+                r.y = text.y + y1;
+                r.width = max( 2.0f, cx - x1 );
+                r.height = h1;
+                fill_argb( ctx, &r, sel );
+                a = b + 1;
+            }
+        }
+        WindowsDeleteString( str );
+    }
+    if (focused && impl->enabled && e->caret == e->anchor)
+    {
+        caret_pos( e, &text, e->caret, &cx, &cy, &ch );
+        r.x = text.x - e->scroll_x + cx;
+        r.y = text.y + cy;
+        r.width = 1;
+        r.height = ch;
+        element_fill_color( ctx, &r, fg.color );
+    }
+    if (ctx->rt) d2d_pop_clip( ctx );
+}
+
+void textbox_pointer( struct button *impl, UINT msg, float x, float y )
+{
+    struct text_edit *e = edit_of( impl );
+    struct layout_rect box, text;
+    UINT32 index;
+
+    edit_rects( impl, NULL, &box, &text );
+    switch (msg)
+    {
+    case WM_MOUSEMOVE:
+        if (!e->pointer_over) { e->pointer_over = TRUE; window_invalidate(); }
+        if (e->dragging) set_selection( e, e->anchor, hit_index( e, &text, x, y ) );
+        break;
+    case WM_MOUSELEAVE:
+        if (e->pointer_over) { e->pointer_over = FALSE; window_invalidate(); }
+        break;
+    case WM_LBUTTONDOWN:
+        if (!impl->enabled) break;
+        index = hit_index( e, &text, x, y );
+        set_selection( e, GetKeyState( VK_SHIFT ) < 0 ? e->anchor : index, index );
+        e->dragging = TRUE;
+        break;
+    case WM_LBUTTONUP:
+    case WM_CAPTURECHANGED:
+        e->dragging = FALSE;
+        break;
+    }
+}
+
+/* ---- ITextBox ---- */
+
+#define EDIT_UNKNOWN( pfx, iface_type, member ) \
+    static inline struct text_edit *impl_from_##iface_type( iface_type *iface ) \
+    { return CONTAINING_RECORD( iface, struct text_edit, member ); } \
+    static HRESULT WINAPI pfx##_QueryInterface( iface_type *iface, REFIID iid, void **out ) \
+    { return IInspectable_QueryInterface( impl_from_##iface_type( iface )->button->element.outer, iid, out ); } \
+    static ULONG WINAPI pfx##_AddRef( iface_type *iface ) \
+    { return IInspectable_AddRef( impl_from_##iface_type( iface )->button->element.outer ); } \
+    static ULONG WINAPI pfx##_Release( iface_type *iface ) \
+    { return IInspectable_Release( impl_from_##iface_type( iface )->button->element.outer ); } \
+    static HRESULT WINAPI pfx##_GetIids( iface_type *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; } \
+    static HRESULT WINAPI pfx##_GetRuntimeClassName( iface_type *iface, HSTRING *name ) \
+    { return WindowsCreateString( impl_from_##iface_type( iface )->button->element.class_name, \
+                                  wcslen( impl_from_##iface_type( iface )->button->element.class_name ), name ); } \
+    static HRESULT WINAPI pfx##_GetTrustLevel( iface_type *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+#define EDIT_PROP( pfx, iface_type, name, type, field ) \
+    static HRESULT WINAPI pfx##_get_##name( iface_type *iface, type *value ) \
+    { *value = impl_from_##iface_type( iface )->field; return S_OK; } \
+    static HRESULT WINAPI pfx##_put_##name( iface_type *iface, type value ) \
+    { impl_from_##iface_type( iface )->field = value; window_invalidate(); return S_OK; }
+
+EDIT_UNKNOWN( tb, ITextBox, ITextBox_iface )
+
+static HRESULT WINAPI tb_get_Text( ITextBox *iface, HSTRING *value )
+{
+    struct text_edit *e = impl_from_ITextBox( iface );
+    return WindowsCreateString( e->text, e->len, value );
+}
+
+static HRESULT WINAPI tb_put_Text( ITextBox *iface, HSTRING value )
+{
+    UINT32 len;
