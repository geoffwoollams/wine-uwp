+/* LeavingBackground: raised once the app has been launched, as its UI is about to show. Deferrals complete at once
+ * (nothing waits for them: the UI shows regardless). */
+
+struct background_args
+{
+    ILeavingBackgroundEventArgs ILeavingBackgroundEventArgs_iface;
+    IDeferral IDeferral_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+};
+
+static inline struct background_args *impl_from_ILeavingBackgroundEventArgs( ILeavingBackgroundEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct background_args, ILeavingBackgroundEventArgs_iface );
+}
+
+static HRESULT WINAPI background_args_QueryInterface( ILeavingBackgroundEventArgs *iface, REFIID iid, void **out )
+{
+    struct background_args *impl = impl_from_ILeavingBackgroundEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ILeavingBackgroundEventArgs ))
+        *out = &impl->ILeavingBackgroundEventArgs_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI background_args_AddRef( ILeavingBackgroundEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_ILeavingBackgroundEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI background_args_Release( ILeavingBackgroundEventArgs *iface )
+{
+    struct background_args *impl = impl_from_ILeavingBackgroundEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI background_args_GetIids( ILeavingBackgroundEventArgs *iface, ULONG *count, IID **iids )
