+static void raise_leaving_background( struct application *app )
+{
+    struct background_args *args;
+    IUnknown **handlers;
+    UINT32 i, count = app->leaving_background.count;
+    HRESULT hr;
+
+    TRACE( "%u handler slots.\n", count );
+    if (!count || !(args = calloc( 1, sizeof(*args) ))) return;
+    args->ILeavingBackgroundEventArgs_iface.lpVtbl = &background_args_vtbl;
+    args->IDeferral_iface.lpVtbl = &deferral_vtbl;
+    args->IClosable_iface.lpVtbl = &deferral_closable_vtbl;
+    args->ref = 1;
+    if ((handlers = calloc( count, sizeof(*handlers) )))
+    {
+        for (i = 0; i < count; i++) if ((handlers[i] = app->leaving_background.handlers[i])) IUnknown_AddRef( handlers[i] );
+        for (i = 0; i < count; i++)
+        {
+            if (!handlers[i]) continue;
+            hr = ILeavingBackgroundEventHandler_Invoke( (ILeavingBackgroundEventHandler *)handlers[i], app->outer,
+                                                        &args->ILeavingBackgroundEventArgs_iface );
+            if (FAILED(hr)) WARN( "LeavingBackground handler %p failed, hr %#lx.\n", handlers[i], hr );
+        }
+        for (i = 0; i < count; i++) if (handlers[i]) IUnknown_Release( handlers[i] );
+        free( handlers );
+    }
+    ILeavingBackgroundEventArgs_Release( &args->ILeavingBackgroundEventArgs_iface );
+}
