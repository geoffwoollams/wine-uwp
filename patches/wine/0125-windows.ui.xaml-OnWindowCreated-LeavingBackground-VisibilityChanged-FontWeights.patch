+/* WindowCreatedEventArgs, for OnWindowCreated */
+
+struct window_created_args
+{
+    IWindowCreatedEventArgs IWindowCreatedEventArgs_iface;
+    LONG ref;
+    IWindow *window;
+};
+
+static inline struct window_created_args *impl_from_IWindowCreatedEventArgs( IWindowCreatedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct window_created_args, IWindowCreatedEventArgs_iface );
+}
+
+static HRESULT WINAPI window_created_args_QueryInterface( IWindowCreatedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IWindowCreatedEventArgs ))
+    {
+        *out = iface;
+        IWindowCreatedEventArgs_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI window_created_args_AddRef( IWindowCreatedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IWindowCreatedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI window_created_args_Release( IWindowCreatedEventArgs *iface )
+{
+    struct window_created_args *impl = impl_from_IWindowCreatedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IWindow_Release( impl->window );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI window_created_args_GetIids( IWindowCreatedEventArgs *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI window_created_args_GetRuntimeClassName( IWindowCreatedEventArgs *iface, HSTRING *value )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Xaml_WindowCreatedEventArgs;
+    return WindowsCreateString( name, wcslen( name ), value );
+}
+
+static HRESULT WINAPI window_created_args_GetTrustLevel( IWindowCreatedEventArgs *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI window_created_args_get_Window( IWindowCreatedEventArgs *iface, IWindow **value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_IWindowCreatedEventArgs( iface )->window;
+    IWindow_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IWindowCreatedEventArgsVtbl window_created_args_vtbl =
+{
+    window_created_args_QueryInterface,
+    window_created_args_AddRef,
+    window_created_args_Release,
+    window_created_args_GetIids,
+    window_created_args_GetRuntimeClassName,
+    window_created_args_GetTrustLevel,
+    window_created_args_get_Window,
+};
+
+/* Application.OnWindowCreated: once the app's main window exists, before it is launched */
+static void raise_window_created(void)
+{
+    IApplicationOverrides *overrides = application_get_overrides();
+    struct window_created_args *args;
+    IWindow *window;
+    HRESULT hr;
+
+    if (!overrides) return;
+    if ((window = window_current()) && (args = calloc( 1, sizeof(*args) )))
+    {
+        args->IWindowCreatedEventArgs_iface.lpVtbl = &window_created_args_vtbl;
+        args->ref = 1;
+        args->window = window;
+        TRACE( "OnWindowCreated\n" );
+        hr = IApplicationOverrides_OnWindowCreated( overrides, &args->IWindowCreatedEventArgs_iface );
+        if (FAILED(hr)) WARN( "OnWindowCreated failed, hr %#lx.\n", hr );
+        IWindowCreatedEventArgs_Release( &args->IWindowCreatedEventArgs_iface );
+    }
+    else if (window) IWindow_Release( window );
+    IApplicationOverrides_Release( overrides );
+}
+
 static HRESULT WINAPI view_SetWindow( IFrameworkView *iface, ICoreWindow *window )
 {
     struct framework_view *impl = impl_from_IFrameworkView( iface );
+    HRESULT hr;
 
     TRACE( "iface %p, window %p.\n", iface, window );
 
     impl->core_window = window;
     ICoreWindow_AddRef( window );
-    return window_create_for_core_window( window );
+    if (FAILED(hr = window_create_for_core_window( window ))) return hr;
+    raise_window_created();
+    return S_OK;
 }
 
 static HRESULT WINAPI view_Load( IFrameworkView *iface, HSTRING entry_point )
