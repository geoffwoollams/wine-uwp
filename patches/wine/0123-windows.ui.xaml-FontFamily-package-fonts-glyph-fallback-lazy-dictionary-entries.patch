+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(xaml);
+
+/* A FontFamily is its Source: a family name, a comma-separated list of them to try in turn ("Segoe Fluent Icons,
+ * Segoe MDL2 Assets"), or a font file in the package with the family in it ("ms-appx:///Assets/Font.ttf#Name").
+ * Elements keep the FontFamily set on them and their text inherits it, as in WinUI; render.c picks the family a
+ * text is drawn in, loading the package's font files. */
+
+void element_set_font_family( struct xaml_element *element, const WCHAR *source )
+{
+    TRACE( "%s %p: %s.\n", debugstr_w(element->class_name), element, debugstr_w(source) );
+    free( element->font_family );
+    element->font_family = source && *source ? wcsdup( source ) : NULL;
+    window_invalidate();
+}
+
+/* an element's FontFamily property: what was set on it, or the default (WinUI never returns null) */
+HRESULT element_get_font_family( struct xaml_element *element, IFontFamily **value )
+{
+    if (!value) return E_POINTER;
+    return font_family_create( element->font_family ? element->font_family : L"XamlAutoFontFamily", value );
+}
+
+HRESULT element_put_font_family( struct xaml_element *element, IFontFamily *value )
+{
+    HSTRING source = NULL;
+
+    if (value && FAILED(IFontFamily_get_Source( value, &source ))) source = NULL;
+    element_set_font_family( element, WindowsGetStringRawBuffer( source, NULL ) );
+    WindowsDeleteString( source );
+    return S_OK;
+}
+
+struct font_family
+{
+    IInspectable IInspectable_inner;
+    IFontFamily IFontFamily_iface;
+    IInspectable *outer;
+    LONG ref;
+    HSTRING source;
+};
+
+static inline struct font_family *impl_from_IInspectable( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct font_family, IInspectable_inner );
+}
+
+static HRESULT WINAPI inner_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct font_family *impl = impl_from_IInspectable( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ))
+        *out = &impl->IInspectable_inner;
+    else if (IsEqualGUID( iid, &IID_IFontFamily ))
+        *out = &impl->IFontFamily_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI inner_AddRef( IInspectable *iface )
+{
+    return InterlockedIncrement( &impl_from_IInspectable( iface )->ref );
+}
+
+static ULONG WINAPI inner_Release( IInspectable *iface )
+{
+    struct font_family *impl = impl_from_IInspectable( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->source );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI inner_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI inner_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Xaml_Media_FontFamily;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI inner_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const struct IInspectableVtbl inner_vtbl =
+{
+    inner_QueryInterface,
+    inner_AddRef,
+    inner_Release,
+    /* IInspectable methods */
+    inner_GetIids,
+    inner_GetRuntimeClassName,
+    inner_GetTrustLevel,
+};
+
+DEFINE_IINSPECTABLE_( family, IFontFamily, struct font_family, impl_from_IFontFamily, IFontFamily_iface, impl->outer )
+
+static HRESULT WINAPI family_get_Source( IFontFamily *iface, HSTRING *value )
+{
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl_from_IFontFamily( iface )->source, value );
+}
+
+static const struct IFontFamilyVtbl family_vtbl =
+{
+    family_QueryInterface,
+    family_AddRef,
+    family_Release,
+    /* IInspectable methods */
+    family_GetIids,
+    family_GetRuntimeClassName,
+    family_GetTrustLevel,
+    /* IFontFamily methods */
+    family_get_Source,
+};
+
+static HRESULT family_create( HSTRING name, IInspectable *outer, IInspectable **inner, IFontFamily **value )
+{
+    struct font_family *impl;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (inner) *inner = NULL;
+    if (outer && !inner) return E_INVALIDARG;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_inner.lpVtbl = &inner_vtbl;
+    impl->IFontFamily_iface.lpVtbl = &family_vtbl;
+    impl->ref = 1;
+    impl->outer = outer ? outer : &impl->IInspectable_inner;
+    WindowsDuplicateString( name, &impl->source );
+    *value = &impl->IFontFamily_iface;
+    if (outer)
+    {
+        *inner = &impl->IInspectable_inner;
+        IInspectable_AddRef( outer );
+    }
+    return S_OK;
+}
+
+HRESULT font_family_create( const WCHAR *name, IFontFamily **value )
+{
+    HSTRING str;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &str ))) return hr;
+    hr = family_create( str, NULL, NULL, value );
+    WindowsDeleteString( str );
+    return hr;
+}
+
+struct family_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IFontFamilyFactory IFontFamilyFactory_iface;
+    IFontFamilyStatics2 IFontFamilyStatics2_iface;
+};
+
+static inline struct family_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct family_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct family_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IFontFamilyFactory ))
+        *out = &impl->IFontFamilyFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IFontFamilyStatics2 ))
+        *out = &impl->IFontFamilyStatics2_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* FontFamily needs a name */
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( family_factory, IFontFamilyFactory, struct family_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI family_factory_CreateInstanceWithName( IFontFamilyFactory *iface, HSTRING name, IInspectable *outer,
+                                                             IInspectable **inner, IFontFamily **value )
+{
+    TRACE( "iface %p, name %s, outer %p.\n", iface, debugstr_hstring(name), outer );
+    return family_create( name, outer, inner, value );
+}
+
+static const struct IFontFamilyFactoryVtbl family_factory_vtbl =
+{
+    family_factory_QueryInterface,
+    family_factory_AddRef,
+    family_factory_Release,
+    /* IInspectable methods */
+    family_factory_GetIids,
+    family_factory_GetRuntimeClassName,
+    family_factory_GetTrustLevel,
+    /* IFontFamilyFactory methods */
+    family_factory_CreateInstanceWithName,
+};
+
+DEFINE_IINSPECTABLE( family_statics2, IFontFamilyStatics2, struct family_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI family_statics2_get_XamlAutoFontFamily( IFontFamilyStatics2 *iface, IFontFamily **value )
+{
+    return font_family_create( L"XamlAutoFontFamily", value );
+}
+
+static const struct IFontFamilyStatics2Vtbl family_statics2_vtbl =
+{
+    family_statics2_QueryInterface,
+    family_statics2_AddRef,
+    family_statics2_Release,
+    /* IInspectable methods */
+    family_statics2_GetIids,
+    family_statics2_GetRuntimeClassName,
+    family_statics2_GetTrustLevel,
+    /* IFontFamilyStatics2 methods */
+    family_statics2_get_XamlAutoFontFamily,
+};
+
+static struct family_statics family_statics = { {&factory_vtbl}, {&family_factory_vtbl}, {&family_statics2_vtbl} };
+
+IActivationFactory *font_family_factory = &family_statics.IActivationFactory_iface;
