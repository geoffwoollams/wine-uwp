diff --git a/dlls/windows.ui.xaml/font_family.c b/dlls/windows.ui.xaml/font_family.c
new file mode 100644
index 0000000..73adaae
--- /dev/null
+++ b/dlls/windows.ui.xaml/font_family.c
@@ -0,0 +1,312 @@
+/* WinRT Windows.UI.Xaml.Media.FontFamily implementation, and font family names for text
+ *
+ * Copyright 2026 wine-uwp contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
