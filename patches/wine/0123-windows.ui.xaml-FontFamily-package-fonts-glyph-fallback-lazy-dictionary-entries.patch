+/* ---- font families: the system's, and fonts in the app's package that markup names ---- */
+
+/* A FontFamily source is a family, a font file in the package with the family in it
+ * ("ms-appx:///Resources/Fonts/Icons.ttf#Icons"), or a comma-separated list of these, which WinUI uses glyph by
+ * glyph. Here a text takes the first family of the list that has all its characters (so "Segoe UI, Icons" draws
+ * words in Segoe UI and icon glyphs in Icons), else the first family that is there, else Segoe UI. */
+
+#define MAX_APP_FONTS 16
+static IDWriteFontCollection *app_fonts;
+static IDWriteFontFile *app_font_files[MAX_APP_FONTS];
+static WCHAR *app_font_uris[MAX_APP_FONTS];
+static UINT32 app_font_count;
+
+static void app_fonts_rebuild(void)
+{
+    IDWriteFontCollection1 *collection = NULL;
+    IDWriteFontSetBuilder1 *builder1;
+    IDWriteFontSetBuilder *builder;
+    IDWriteFactory3 *factory3;
+    IDWriteFontSet *set;
+    UINT32 i;
+
+    if (FAILED(IDWriteFactory_QueryInterface( dwrite, &iid_dwrite_factory3, (void **)&factory3 ))) return;
+    if (SUCCEEDED(IDWriteFactory3_CreateFontSetBuilder( factory3, &builder )))
+    {
+        if (SUCCEEDED(IDWriteFontSetBuilder_QueryInterface( builder, &iid_font_set_builder1, (void **)&builder1 )))
+        {
+            for (i = 0; i < app_font_count; i++)
+                if (app_font_files[i] && FAILED(IDWriteFontSetBuilder1_AddFontFile( builder1, app_font_files[i] )))
+                    WARN( "could not use %s.\n", debugstr_w(app_font_uris[i]) );
+            if (SUCCEEDED(IDWriteFontSetBuilder1_CreateFontSet( builder1, &set )))
+            {
+                IDWriteFactory3_CreateFontCollectionFromFontSet( factory3, set, &collection );
+                IDWriteFontSet_Release( set );
+            }
+            IDWriteFontSetBuilder1_Release( builder1 );
+        }
+        IDWriteFontSetBuilder_Release( builder );
+    }
+    IDWriteFactory3_Release( factory3 );
+    if (!collection) return;
+    if (app_fonts) IDWriteFontCollection_Release( app_fonts );
+    app_fonts = (IDWriteFontCollection *)collection;
+}
+
+static void app_font_load( const WCHAR *uri )
+{
+    WCHAR path[MAX_PATH];
+    IDWriteFontFile *file = NULL;
+    UINT32 i;
+
+    for (i = 0; i < app_font_count; i++) if (!wcsicmp( app_font_uris[i], uri )) return;
+    if (app_font_count == MAX_APP_FONTS) return;
+    if (!resolve_app_uri( uri, path, ARRAY_SIZE(path) ) ||
+        FAILED(IDWriteFactory_CreateFontFileReference( dwrite, path, NULL, &file )))
+    {
+        WARN( "no font file %s.\n", debugstr_w(uri) );
+        file = NULL;
+    }
+    else TRACE( "%s is %s.\n", debugstr_w(uri), debugstr_w(path) );
+    app_font_uris[app_font_count] = wcsdup( uri );
+    app_font_files[app_font_count++] = file;   /* remembered even when missing, so it isn't looked for again */
+    if (file) app_fonts_rebuild();
+}
+
+static IDWriteFont *find_font( IDWriteFontCollection *collection, const WCHAR *family, UINT16 weight )
+{
+    IDWriteFontFamily *font_family;
+    IDWriteFont *font = NULL;
+    BOOL exists = FALSE;
+    UINT32 index;
+
+    if (!collection || FAILED(IDWriteFontCollection_FindFamilyName( collection, family, &index, &exists )) || !exists)
+        return NULL;
+    if (FAILED(IDWriteFontCollection_GetFontFamily( collection, index, &font_family ))) return NULL;
+    IDWriteFontFamily_GetFirstMatchingFont( font_family, weight ? weight : 400, DWRITE_FONT_STRETCH_NORMAL,
+                                            DWRITE_FONT_STYLE_NORMAL, &font );
+    IDWriteFontFamily_Release( font_family );
+    return font;
+}
+
+static BOOL font_covers( IDWriteFont *font, const WCHAR *text, UINT32 len )
+{
+    BOOL exists;
+    UINT32 i, ch;
+
+    for (i = 0; i < len; i++)
+    {
+        ch = text[i];
+        if (ch <= ' ' || ch == 0xa0 || ch == 0x200b || ch == 0xfeff) continue;
+        if (IS_HIGH_SURROGATE( ch ) && i + 1 < len && IS_LOW_SURROGATE( text[i + 1] ))
+        {
+            ch = 0x10000 + ((ch - 0xd800) << 10) + (text[i + 1] - 0xdc00);
+            i++;
+        }
+        if (FAILED(IDWriteFont_HasCharacter( font, ch, &exists )) || !exists) return FALSE;
+    }
+    return TRUE;
+}
+
+/* the next entry of a FontFamily list: its family name, and the collections to look in, in order (a font file's
+ * family in the package's fonts first, which it loads) */
+static const WCHAR *next_family( const WCHAR *p, WCHAR *name, SIZE_T size, IDWriteFontCollection *system,
+                                 IDWriteFontCollection **collections )
+{
+    const WCHAR *end;
+    WCHAR *n, *start, *hash;
+
+    *name = 0;
+    if (!(end = wcschr( p, ',' ))) end = p + wcslen( p );
+    lstrcpynW( name, p, min( (SIZE_T)(end - p + 1), size ) );
+    for (start = name; *start == ' ' || *start == '\t'; start++) ;
+    memmove( name, start, (wcslen( start ) + 1) * sizeof(WCHAR) );
+    for (n = name + wcslen( name ); n > name && (n[-1] == ' ' || n[-1] == '\t'); n--) n[-1] = 0;
+    if ((hash = wcschr( name, '#' )))
+    {
+        *hash = 0;
+        if (*name) app_font_load( name );
+        memmove( name, hash + 1, (wcslen( hash + 1 ) + 1) * sizeof(WCHAR) );
+        collections[0] = app_fonts;
+        collections[1] = system;
+    }
+    else
+    {
+        collections[0] = system;
+        collections[1] = app_fonts;
+    }
+    return *end ? end + 1 : end;
+}
+
+/* the system font fallback's last resort for icon glyphs (the Private Use Area) that the text's fonts lack */
+static const WCHAR icon_fallback[] = L"Segoe Fluent Icons, Segoe MDL2 Assets";
+
+/* WinUI's FontFamily lists fall back glyph by glyph: the characters the chosen family lacks go to the first family
+ * of the list that has them, then (for icon glyphs) to the icon fonts */
+static void apply_fallback( IDWriteTextLayout *layout, const WCHAR *source, const WCHAR *text, UINT32 len,
+                            UINT16 weight, const WCHAR *primary_name, IDWriteFontCollection *primary_collection )
+{
+    IDWriteFontCollection *system = NULL, *collections[2], *run_collection = NULL;
+    struct { WCHAR name[MAX_PATH]; IDWriteFontCollection *collection; IDWriteFont *font; } entries[6];
+    UINT32 count = 0, i, j, k, run_start = 0, run_entry = ~0u, pass;
+    IDWriteFont *primary;
+    const WCHAR *p;
+    BOOL exists, icons = FALSE;
+
+    if (!len) return;
+    for (i = 0; i < len; i++) if (text[i] >= 0xe000 && text[i] <= 0xf8ff) icons = TRUE;
+    if (!icons && (!source || !wcschr( source, ',' ))) return;
+    IDWriteFactory_GetSystemFontCollection( dwrite, &system, FALSE );
+    if (!(primary = find_font( primary_collection ? primary_collection : system, primary_name, weight )))
+    {
+        if (system) IDWriteFontCollection_Release( system );
+        return;
+    }
+    for (pass = 0; pass < 2; pass++)
+    for (p = pass ? (icons ? icon_fallback : L"") : (source ? source : L""); *p && count < ARRAY_SIZE(entries);)
+    {
+        p = next_family( p, entries[count].name, ARRAY_SIZE(entries[count].name), system, collections );
+        if (!entries[count].name[0]) continue;
+        for (k = 0; k < 2; k++)
+            if ((entries[count].font = find_font( collections[k], entries[count].name, weight )))
+            {
+                entries[count].collection = collections[k];
+                count++;
+                break;
+            }
+    }
+    for (i = 0; i <= len; i++)
+    {
+        UINT32 entry = ~0u;
+        if (i < len && text[i] > ' ' && !IS_HIGH_SURROGATE( text[i] ) && !IS_LOW_SURROGATE( text[i] ) &&
+            !(SUCCEEDED(IDWriteFont_HasCharacter( primary, text[i], &exists )) && exists))
+        {
+            for (j = 0; j < count; j++)
+                if (SUCCEEDED(IDWriteFont_HasCharacter( entries[j].font, text[i], &exists )) && exists) break;
+            if (j < count) entry = j;
+        }
+        if (entry == run_entry) continue;
+        if (run_entry != ~0u)
+        {
+            DWRITE_TEXT_RANGE range = { run_start, i - run_start };
+            run_collection = entries[run_entry].collection == system ? NULL : entries[run_entry].collection;
+            TRACE( "%s for %s.\n", debugstr_w(entries[run_entry].name), debugstr_wn(text + run_start, i - run_start) );
+            IDWriteTextLayout_SetFontCollection( layout, run_collection, range );
+            IDWriteTextLayout_SetFontFamilyName( layout, entries[run_entry].name, range );
+        }
+        run_entry = entry;
+        run_start = i;
+    }
+    for (j = 0; j < count; j++) IDWriteFont_Release( entries[j].font );
+    IDWriteFont_Release( primary );
+    if (system) IDWriteFontCollection_Release( system );
+}
+
+/* the family to draw text in and its collection (referenced; NULL for the system's) */
+static IDWriteFontCollection *pick_family( const WCHAR *source, const WCHAR *text, UINT32 len, UINT16 weight,
+                                           WCHAR *out, SIZE_T size )
+{
+    IDWriteFontCollection *system = NULL, *collections[2], *fallback = NULL;
+    BOOL have_fallback = FALSE;
+    WCHAR entry[MAX_PATH + 64], fallback_name[LF_FACESIZE * 2], *name;
+    const WCHAR *p;
+    IDWriteFont *font;
+    UINT32 i;
+
+    lstrcpynW( out, L"Segoe UI", size );
+    if (!source || !*source || !wcsicmp( source, L"XamlAutoFontFamily" ) || !dwrite) return NULL;
+    IDWriteFactory_GetSystemFontCollection( dwrite, &system, FALSE );
+    for (p = source; *p;)
+    {
+        p = next_family( p, entry, ARRAY_SIZE(entry), system, collections );
+        name = entry;
+        if (!*name) continue;
+        for (i = 0; i < 2; i++)
+        {
+            if (!(font = find_font( collections[i], name, weight ))) continue;
+            if (font_covers( font, text, len ))
+            {
+                IDWriteFontCollection *result = collections[i] == system ? NULL : collections[i];
+                TRACE( "%s for %s: %s.\n", debugstr_w(source), debugstr_wn(text, len), debugstr_w(name) );
+                IDWriteFont_Release( font );
+                lstrcpynW( out, name, size );
+                if (result) IDWriteFontCollection_AddRef( result );
+                if (system) IDWriteFontCollection_Release( system );
+                return result;
+            }
+            IDWriteFont_Release( font );
+            if (!have_fallback)
+            {
+                have_fallback = TRUE;
+                lstrcpynW( fallback_name, name, ARRAY_SIZE(fallback_name) );
+                fallback = collections[i];
+            }
+            break;
+        }
+    }
+    TRACE( "%s for %s: %s.\n", debugstr_w(source), debugstr_wn(text, len),
+           have_fallback ? debugstr_w(fallback_name) : "none there" );
+    if (have_fallback)
+    {
+        lstrcpynW( out, fallback_name, size );
+        if (fallback && fallback != system) IDWriteFontCollection_AddRef( fallback );
+        else fallback = NULL;
+    }
+    if (system) IDWriteFontCollection_Release( system );
+    return have_fallback ? fallback : NULL;
+}
