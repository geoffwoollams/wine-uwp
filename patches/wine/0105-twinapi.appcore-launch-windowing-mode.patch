Subject: twinapi.appcore: keep PreferredLaunchWindowingMode; a windowed launch gets a title bar

diff --git a/dlls/twinapi.appcore/application_view.c b/dlls/twinapi.appcore/application_view.c
index 6e3c37d..2af715b 100644
--- a/dlls/twinapi.appcore/application_view.c
+++ b/dlls/twinapi.appcore/application_view.c
@@ -18,6 +18,7 @@
  */
 
 #include "private.h"
+#include "appmodel.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
 
@@ -359,6 +360,52 @@ static const IApplicationView3Vtbl view3_vtbl =
 static IApplicationView *current_view;
 static boolean terminate_on_final_close = TRUE;
 static ApplicationViewWindowingMode preferred_windowing_mode;
+static BOOL preferred_windowing_mode_loaded;
+
+/* PreferredLaunchWindowingMode is kept for the next launch, as Windows keeps it: in
+ * HKCU\Software\Wine\WindowsRuntime\Packages\<package name>, value LaunchWindowingMode */
+static HKEY open_package_key(BOOL create)
+{
+    WCHAR family[PACKAGE_FAMILY_NAME_MAX_LENGTH + 1], key[PACKAGE_FAMILY_NAME_MAX_LENGTH + 64], *p;
+    UINT32 len = ARRAY_SIZE(family);
+    HKEY hkey;
+
+    if (GetCurrentPackageFamilyName(&len, family)) return NULL;
+    if ((p = wcschr(family, '_'))) *p = 0;
+    swprintf(key, ARRAY_SIZE(key), L"Software\\Wine\\WindowsRuntime\\Packages\\%s", family);
+    if (create ? RegCreateKeyExW(HKEY_CURRENT_USER, key, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &hkey, NULL)
+               : RegOpenKeyExW(HKEY_CURRENT_USER, key, 0, KEY_READ, &hkey)) return NULL;
+    return hkey;
+}
+
+static void load_preferred_windowing_mode(void)
+{
+    DWORD value, size = sizeof(value), type;
+    HKEY hkey;
+
+    if (preferred_windowing_mode_loaded) return;
+    preferred_windowing_mode_loaded = TRUE;
+    preferred_windowing_mode = ApplicationViewWindowingMode_Auto;
+    if (!(hkey = open_package_key(FALSE))) return;
+    if (!RegQueryValueExW(hkey, L"LaunchWindowingMode", NULL, &type, (BYTE *)&value, &size) && type == REG_DWORD)
+        preferred_windowing_mode = value;
+    RegCloseKey(hkey);
+}
+
+/* Whether the app last asked to launch in a window (Auto or a launch size), not full screen. Without a stored
+ * preference the window is borderless full screen, which suits games that never ask. */
+BOOL core_launch_windowed(void)
+{
+    DWORD value, size = sizeof(value), type;
+    BOOL windowed = FALSE;
+    HKEY hkey;
+
+    if (!(hkey = open_package_key(FALSE))) return FALSE;
+    if (!RegQueryValueExW(hkey, L"LaunchWindowingMode", NULL, &type, (BYTE *)&value, &size) && type == REG_DWORD)
+        windowed = value != ApplicationViewWindowingMode_FullScreen;
+    RegCloseKey(hkey);
+    return windowed;
+}
 static Size preferred_launch_size;
 
 static HRESULT get_current_view(IApplicationView **out)
@@ -549,14 +596,24 @@ DEFINE_IINSPECTABLE(statics3, IApplicationViewStatics3, struct factory, IActivat
 
 static HRESULT WINAPI statics3_get_PreferredLaunchWindowingMode(IApplicationViewStatics3 *iface, ApplicationViewWindowingMode *value)
 {
+    load_preferred_windowing_mode();
     *value = preferred_windowing_mode;
     return S_OK;
 }
 
 static HRESULT WINAPI statics3_put_PreferredLaunchWindowingMode(IApplicationViewStatics3 *iface, ApplicationViewWindowingMode value)
 {
-    FIXME("iface %p, value %d semi-stub!\n", iface, value);
+    HKEY hkey;
+    DWORD mode = value;
+
+    TRACE("iface %p, value %d.\n", iface, value);
     preferred_windowing_mode = value;
+    preferred_windowing_mode_loaded = TRUE;
+    if ((hkey = open_package_key(TRUE)))
+    {
+        RegSetValueExW(hkey, L"LaunchWindowingMode", 0, REG_DWORD, (const BYTE *)&mode, sizeof(mode));
+        RegCloseKey(hkey);
+    }
     return S_OK;
 }
 
