 static BOOL fullscreen_wanted = TRUE;
+static BOOL captioned;       /* created as a normal window with a title bar: it stays windowed */
+extern BOOL core_launch_windowed(void);
 static RECT windowed_rect;   /* outer window rect while windowed */
 static HWND created_hwnd;
 
@@ -2314,7 +2317,7 @@ static void apply_fullscreen(HWND hwnd, BOOL fullscreen)
