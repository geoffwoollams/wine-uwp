+static HRESULT WINAPI http_filter_SendRequestAsync( IHttpFilter *iface, IHttpRequestMessage *request,
+                                                    IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress **value )
+{
+    struct failed_op *op;
+
+    TRACE( "iface %p, request %p: offline.\n", iface, request );
+    if (!(op = calloc( 1, sizeof(*op) ))) return E_OUTOFMEMORY;
+    op->IAsyncOperationWithProgress_iface.lpVtbl = &op_vtbl;
+    op->IAsyncInfo_iface.lpVtbl = &op_info_vtbl;
+    op->ref = 1;
+    *value = &op->IAsyncOperationWithProgress_iface;
+    return S_OK;
+}
