+/* The WinRT HTTP stack is offline: an HttpBaseProtocolFilter keeps its settings, and every request it is given
+ * fails at once as if the host's name couldn't be resolved (WININET_E_NAME_NOT_RESOLVED), which is what Windows
+ * reports without a network. .NET's HttpClient turns that into an HttpRequestException, which apps and their ad and
+ * telemetry libraries expect and handle. */
+
+
+/* ---- SendRequestAsync's operation: already failed ---- */
+
+struct failed_op
+{
+    IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress IAsyncOperationWithProgress_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress *completed;
+    IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress *progress;
+};
+
+static inline struct failed_op *impl_from_IAsyncOperationWithProgress( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface )
+{
+    return CONTAINING_RECORD( iface, struct failed_op, IAsyncOperationWithProgress_iface );
+}
+
+static HRESULT WINAPI op_QueryInterface( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface, REFIID iid, void **out )
+{
+    struct failed_op *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress ))
+        *out = &impl->IAsyncOperationWithProgress_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI op_AddRef( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface )
+{
+    return InterlockedIncrement( &impl_from_IAsyncOperationWithProgress( iface )->ref );
+}
+
+static ULONG WINAPI op_Release( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface )
+{
+    struct failed_op *impl = impl_from_IAsyncOperationWithProgress( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->completed) IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress_Release( impl->completed );
+        if (impl->progress) IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress_Release( impl->progress );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI op_GetIids( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI op_GetRuntimeClassName( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI op_GetTrustLevel( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_put_Progress( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface,
+                                       IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress *handler )
+{
+    struct failed_op *impl = impl_from_IAsyncOperationWithProgress( iface );
+    if (handler) IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress_AddRef( handler );
+    if (impl->progress) IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress_Release( impl->progress );
+    impl->progress = handler;
+    return S_OK;
+}
+
+static HRESULT WINAPI op_get_Progress( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface,
+                                       IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress **handler )
+{
+    struct failed_op *impl = impl_from_IAsyncOperationWithProgress( iface );
+    if ((*handler = impl->progress)) IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_put_Completed( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface,
+                                        IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress *handler )
+{
+    struct failed_op *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    if (impl->completed) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if (!handler) return E_POINTER;
+    IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress_AddRef( (impl->completed = handler) );
+    /* it has finished: the handler runs at once */
+    IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress_Invoke( handler, iface, Error );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_get_Completed( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface,
+                                        IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress **handler )
+{
+    struct failed_op *impl = impl_from_IAsyncOperationWithProgress( iface );
+    if ((*handler = impl->completed)) IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI op_GetResults( IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *iface, IHttpResponseMessage **results )
+{
+    *results = NULL;
+    return WININET_E_NAME_NOT_RESOLVED;
+}
