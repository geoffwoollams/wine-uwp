+}
+
+static HRESULT WINAPI filter_QueryInterface( IHttpBaseProtocolFilter *iface, REFIID iid, void **out )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IHttpBaseProtocolFilter ))
+        *out = &impl->IHttpBaseProtocolFilter_iface;
+    else if (IsEqualGUID( iid, &IID_IHttpBaseProtocolFilter2 )) *out = &impl->IHttpBaseProtocolFilter2_iface;
+    else if (IsEqualGUID( iid, &IID_IHttpBaseProtocolFilter3 )) *out = &impl->IHttpBaseProtocolFilter3_iface;
+    else if (IsEqualGUID( iid, &IID_IHttpBaseProtocolFilter4 )) *out = &impl->IHttpBaseProtocolFilter4_iface;
+    else if (IsEqualGUID( iid, &IID_IHttpFilter )) *out = &impl->IHttpFilter_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable )) *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    InterlockedIncrement( &impl->ref );
+    return S_OK;
+}
+
+static ULONG WINAPI filter_AddRef( IHttpBaseProtocolFilter *iface )
+{
+    return InterlockedIncrement( &impl_from_IHttpBaseProtocolFilter( iface )->ref );
+}
+
+static ULONG WINAPI filter_Release( IHttpBaseProtocolFilter *iface )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->certificate) ICertificate_Release( impl->certificate );
+        if (impl->proxy_credential) IPasswordCredential_Release( impl->proxy_credential );
+        if (impl->server_credential) IPasswordCredential_Release( impl->server_credential );
+        free( impl );
+    }
+    return ref;
+}
