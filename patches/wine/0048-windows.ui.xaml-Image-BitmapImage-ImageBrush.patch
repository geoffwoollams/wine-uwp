+/* markup: Source="ms-appx:///Assets/Logo.png", or a relative path, which is relative to the package */
+IInspectable *bitmap_from_string( const WCHAR *str )
+{
+    IUriRuntimeClassFactory *factory;
+    IUriRuntimeClass *uri = NULL;
+    IBitmapImage *bitmap = NULL;
+    WCHAR buf[MAX_PATH + 16];
+    HSTRING hstr;
+
+    if (wcschr( str, ':' )) lstrcpynW( buf, str, ARRAY_SIZE(buf) );
+    else swprintf( buf, ARRAY_SIZE(buf), L"ms-appx:///%s", str[0] == '/' ? str + 1 : str );
+    WindowsCreateString( L"Windows.Foundation.Uri", 22, &hstr );
+    factory = NULL;
+    RoGetActivationFactory( hstr, &IID_IUriRuntimeClassFactory, (void **)&factory );
+    WindowsDeleteString( hstr );
+    if (!factory) return NULL;
+    WindowsCreateString( buf, wcslen( buf ), &hstr );
+    IUriRuntimeClassFactory_CreateUri( factory, hstr, &uri );
+    WindowsDeleteString( hstr );
+    IUriRuntimeClassFactory_Release( factory );
+    if (!uri) return NULL;
+    bitmap_create( uri, &bitmap );
+    IUriRuntimeClass_Release( uri );
+    return (IInspectable *)bitmap;
+}
