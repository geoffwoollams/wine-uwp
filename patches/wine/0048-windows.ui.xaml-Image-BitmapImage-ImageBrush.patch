+/* raise ImageOpened (a RoutedEventHandler) or ImageFailed (an ExceptionRoutedEventHandler) on a list */
+static void raise_image_event( struct event_list *list, IInspectable *sender, BOOL failed, HSTRING message )
+{
+    IUnknown **handlers;
+    UINT32 i, count = list->count;
+    IRoutedEventArgs *args = NULL;
+    struct exception_args *ex = NULL;
+
+    if (!count || !(handlers = calloc( count, sizeof(*handlers) ))) return;
+    if (failed)
+    {
+        if (!(ex = calloc( 1, sizeof(*ex) ))) { free( handlers ); return; }
+        ex->IExceptionRoutedEventArgs_iface.lpVtbl = &ex_args_vtbl;
+        ex->IRoutedEventArgs_iface.lpVtbl = &ex_routed_vtbl;
+        ex->ref = 1;
+        WindowsDuplicateString( message, &ex->message );
+        if ((ex->source = sender)) IInspectable_AddRef( sender );
+    }
+    else if (FAILED(routed_event_args_create( sender, &args ))) { free( handlers ); return; }
+    for (i = 0; i < count; i++) if ((handlers[i] = list->handlers[i])) IUnknown_AddRef( handlers[i] );
+    for (i = 0; i < count; i++)
+    {
+        if (!handlers[i]) continue;
+        if (failed) IExceptionRoutedEventHandler_Invoke( (IExceptionRoutedEventHandler *)handlers[i], sender,
+                                                         &ex->IExceptionRoutedEventArgs_iface );
+        else IRoutedEventHandler_Invoke( (IRoutedEventHandler *)handlers[i], sender, args );
+        IUnknown_Release( handlers[i] );
+    }
+    free( handlers );
+    if (ex) IExceptionRoutedEventArgs_Release( &ex->IExceptionRoutedEventArgs_iface );
+    if (args) IRoutedEventArgs_Release( args );
+}
+
+/* the Images and ImageBrushes showing a bitmap hear of its load through these */
+struct image_listener
+{
+    struct list entry;
+    struct bitmap_image *bitmap;
+    struct event_list *opened, *failed;
+    IInspectable *sender;   /* not referenced */
+};
+
+static struct list listeners = LIST_INIT( listeners );
+static struct bitmap_image **pending;
+static UINT32 pending_count;
+static UINT_PTR notify_timer;
+
+static void listen( struct bitmap_image *bitmap, IInspectable *sender, struct event_list *opened, struct event_list *failed )
+{
+    struct image_listener *l;
+
+    if (!bitmap || !(l = calloc( 1, sizeof(*l) ))) return;
+    l->bitmap = bitmap;
+    l->opened = opened;
+    l->failed = failed;
+    l->sender = sender;
+    list_add_tail( &listeners, &l->entry );
+}
+
+static void unlisten( IInspectable *sender )
+{
+    struct image_listener *l, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( l, next, &listeners, struct image_listener, entry )
+    {
+        if (l->sender != sender) continue;
+        list_remove( &l->entry );
+        free( l );
+    }
+}
+
+static void CALLBACK notify_proc( HWND hwnd, UINT msg, UINT_PTR id, DWORD time )
+{
+    struct bitmap_image **list = pending;
+    UINT32 i, count = pending_count;
+    struct image_listener *l, *next;
+
+    KillTimer( NULL, notify_timer );
+    notify_timer = 0;
+    pending = NULL;
+    pending_count = 0;
+    for (i = 0; i < count; i++)
+    {
+        struct bitmap_image *bitmap = list[i];
+        BOOL failed = bitmap->state == IMAGE_FAILED;
+
+        TRACE( "%p: %s.\n", bitmap, failed ? "ImageFailed" : "ImageOpened" );
+        if (bitmap->state != IMAGE_EMPTY)
+        {
+            raise_image_event( failed ? &bitmap->failed : &bitmap->opened, (IInspectable *)&bitmap->IBitmapImage_iface,
+                               failed, bitmap->error );
+            LIST_FOR_EACH_ENTRY_SAFE( l, next, &listeners, struct image_listener, entry )
+                if (l->bitmap == bitmap)
+                    raise_image_event( failed ? l->failed : l->opened, l->sender, failed, bitmap->error );
+        }
+        IBitmapImage_Release( &bitmap->IBitmapImage_iface );
+    }
+    free( list );
+    window_invalidate();
+}
+
+static void schedule_notify( struct bitmap_image *bitmap )
+{
+    struct bitmap_image **list;
+    UINT32 i;
+
+    for (i = 0; i < pending_count; i++) if (pending[i] == bitmap) return;
+    if (!(list = realloc( pending, (pending_count + 1) * sizeof(*list) ))) return;
+    pending = list;
+    IBitmapImage_AddRef( &bitmap->IBitmapImage_iface );
+    pending[pending_count++] = bitmap;
+    if (!notify_timer) notify_timer = SetTimer( NULL, 0, 0, notify_proc );
+}
