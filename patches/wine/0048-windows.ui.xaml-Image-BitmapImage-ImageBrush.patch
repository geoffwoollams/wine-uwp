+/* ---- ImageOpened / ImageFailed, from a UI-thread timer ---- */
+
+struct exception_args
+{
+    IExceptionRoutedEventArgs IExceptionRoutedEventArgs_iface;
+    IRoutedEventArgs IRoutedEventArgs_iface;
+    LONG ref;
+    HSTRING message;
+    IInspectable *source;
+};
+
+static inline struct exception_args *impl_from_IExceptionRoutedEventArgs( IExceptionRoutedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct exception_args, IExceptionRoutedEventArgs_iface );
+}
+
+static HRESULT WINAPI ex_args_QueryInterface( IExceptionRoutedEventArgs *iface, REFIID iid, void **out )
+{
+    struct exception_args *impl = impl_from_IExceptionRoutedEventArgs( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IExceptionRoutedEventArgs ))
+        *out = &impl->IExceptionRoutedEventArgs_iface;
+    else if (IsEqualGUID( iid, &IID_IRoutedEventArgs )) *out = &impl->IRoutedEventArgs_iface;
+    else { *out = NULL; return E_NOINTERFACE; }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI ex_args_AddRef( IExceptionRoutedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IExceptionRoutedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI ex_args_Release( IExceptionRoutedEventArgs *iface )
+{
+    struct exception_args *impl = impl_from_IExceptionRoutedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        WindowsDeleteString( impl->message );
+        if (impl->source) IInspectable_Release( impl->source );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI ex_args_GetIids( IExceptionRoutedEventArgs *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+static HRESULT WINAPI ex_args_GetRuntimeClassName( IExceptionRoutedEventArgs *iface, HSTRING *name ) { return E_NOTIMPL; }
+static HRESULT WINAPI ex_args_GetTrustLevel( IExceptionRoutedEventArgs *iface, TrustLevel *level ) { *level = BaseTrust; return S_OK; }
+
+static HRESULT WINAPI ex_args_get_ErrorMessage( IExceptionRoutedEventArgs *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( impl_from_IExceptionRoutedEventArgs( iface )->message, value );
+}
+
+static const struct IExceptionRoutedEventArgsVtbl ex_args_vtbl =
+{
+    ex_args_QueryInterface, ex_args_AddRef, ex_args_Release, ex_args_GetIids, ex_args_GetRuntimeClassName,
+    ex_args_GetTrustLevel, ex_args_get_ErrorMessage,
+};
+
+DEFINE_IINSPECTABLE( ex_routed, IRoutedEventArgs, struct exception_args, IExceptionRoutedEventArgs_iface )
+
+static HRESULT WINAPI ex_routed_get_OriginalSource( IRoutedEventArgs *iface, IInspectable **value )
+{
+    struct exception_args *impl = impl_from_IRoutedEventArgs( iface );
+    if ((*value = impl->source)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IRoutedEventArgsVtbl ex_routed_vtbl =
+{
+    ex_routed_QueryInterface, ex_routed_AddRef, ex_routed_Release, ex_routed_GetIids, ex_routed_GetRuntimeClassName,
+    ex_routed_GetTrustLevel, ex_routed_get_OriginalSource,
+};
