+/* ---- IBitmapImage ---- */
+
+static HRESULT WINAPI bitmap_QueryInterface( IBitmapImage *iface, REFIID iid, void **out )
+{
+    struct bitmap_image *impl = impl_from_IBitmapImage( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IBitmapImage ))
+        *out = &impl->IBitmapImage_iface;
+    else if (IsEqualGUID( iid, &IID_IBitmapImage2 )) *out = &impl->IBitmapImage2_iface;
+    else if (IsEqualGUID( iid, &IID_IBitmapImage3 )) *out = &impl->IBitmapImage3_iface;
+    else if (IsEqualGUID( iid, &IID_IBitmapSource )) *out = &impl->IBitmapSource_iface;
+    else if (IsEqualGUID( iid, &IID_IImageSource )) *out = &impl->IImageSource_iface;
+    else
+    {
+        report_missing_interface( L"BitmapImage", iid );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI bitmap_AddRef( IBitmapImage *iface )
+{
+    return InterlockedIncrement( &impl_from_IBitmapImage( iface )->ref );
+}
+
+static ULONG WINAPI bitmap_Release( IBitmapImage *iface )
+{
+    struct bitmap_image *impl = impl_from_IBitmapImage( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->uri) IUriRuntimeClass_Release( impl->uri );
+        event_list_clear( &impl->opened );
+        event_list_clear( &impl->failed );
+        event_list_clear( &impl->progress );
+        WindowsDeleteString( impl->error );
+        free( impl->pixels.bits );
+        free( impl );
+    }
+    return ref;
+}
