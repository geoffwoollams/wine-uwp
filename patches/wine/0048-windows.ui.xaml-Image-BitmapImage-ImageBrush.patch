+static ID2D1Bitmap *d2d_bitmap( struct layout_context *ctx, const struct image_pixels *pixels )
+{
+    D2D1_BITMAP_PROPERTIES props = { { DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED }, 96.0f, 96.0f };
+    D2D1_SIZE_U size = { pixels->width, pixels->height };
