+/* A BitmapImage decodes its UriSource (ms-appx:/// in the app's package, ms-appx with the package name, or a plain
+ * file path) with WIC into 32-bit premultiplied BGRA pixels, scaled to DecodePixelWidth /
+ * DecodePixelHeight when set. Decoding happens at once; ImageOpened or ImageFailed follow from a timer on the UI
+ * thread, after the caller has had the chance to add its handlers, as Windows raises them asynchronously. Web URIs
+ * fail (there is no network) and so do ms-appdata ones for now. An Image draws its source by Stretch (Uniform by
+ * default) centred in its slot, and its natural size is the bitmap's pixel size. An ImageBrush paints its
+ * ImageSource over what it fills, placed by Stretch, AlignmentX and AlignmentY. Animated images show their first
+ * frame. */
+
+struct bitmap_image
+{
+    IBitmapImage IBitmapImage_iface;
+    IBitmapImage2 IBitmapImage2_iface;
+    IBitmapImage3 IBitmapImage3_iface;
+    IBitmapSource IBitmapSource_iface;
+    IImageSource IImageSource_iface;
+    LONG ref;
+    IUriRuntimeClass *uri;
+    BitmapCreateOptions options;
+    INT32 decode_width, decode_height;
+    DecodePixelType decode_type;
+    boolean autoplay;
+    struct event_list opened, failed, progress;
+    struct image_pixels pixels;
+    enum { IMAGE_EMPTY, IMAGE_LOADED, IMAGE_FAILED } state;
+    HSTRING error;
+    UINT32 generation;               /* bumped on each load, for the Images that show it */
+    UINT_PTR timer;
+};
+
+static inline struct bitmap_image *impl_from_IBitmapImage( IBitmapImage *iface )
+{
+    return CONTAINING_RECORD( iface, struct bitmap_image, IBitmapImage_iface );
+}
+
+static struct bitmap_image *bitmap_from_source( IInspectable *source );
+
+/* ---- decoding ---- */
+
+static IWICImagingFactory *wic_factory(void)
+{
+    static IWICImagingFactory *factory;
+    if (!factory && FAILED(CoCreateInstance( &CLSID_WICImagingFactory_local, NULL, CLSCTX_INPROC_SERVER,
+                                             &IID_IWICImagingFactory_local, (void **)&factory )))
+        ERR( "WIC isn't available.\n" );
+    return factory;
+}
+
+static HRESULT decode( struct bitmap_image *bitmap, IWICBitmapDecoder *decoder )
+{
+    IWICImagingFactory *factory = wic_factory();
+    IWICBitmapFrameDecode *frame = NULL;
+    IWICFormatConverter *converter = NULL;
+    IWICBitmapScaler *scaler = NULL;
+    IWICBitmapSource *source;
+    UINT width, height, out_w, out_h;
+    HRESULT hr;
+    BYTE *bits;
+
+    if (FAILED(hr = IWICBitmapDecoder_GetFrame( decoder, 0, &frame ))) return hr;
+    if (FAILED(hr = IWICImagingFactory_CreateFormatConverter( factory, &converter ))) goto done;
+    if (FAILED(hr = IWICFormatConverter_Initialize( converter, (IWICBitmapSource *)frame, &GUID_WICPixelFormat32bppPBGRA_local,
+                                                    WICBitmapDitherTypeNone, NULL, 0.0, WICBitmapPaletteTypeCustom )))
+        goto done;
+    source = (IWICBitmapSource *)converter;
+    IWICBitmapSource_GetSize( source, &width, &height );
+    out_w = width;
+    out_h = height;
+    /* DecodePixelWidth / Height: one of them keeps the aspect ratio */
+    if (bitmap->decode_width > 0 && bitmap->decode_height > 0) { out_w = bitmap->decode_width; out_h = bitmap->decode_height; }
+    else if (bitmap->decode_width > 0) { out_w = bitmap->decode_width; out_h = max( 1, MulDiv( height, out_w, width ) ); }
+    else if (bitmap->decode_height > 0) { out_h = bitmap->decode_height; out_w = max( 1, MulDiv( width, out_h, height ) ); }
+    if (out_w != width || out_h != height)
+    {
+        if (FAILED(hr = IWICImagingFactory_CreateBitmapScaler( factory, &scaler ))) goto done;
+        if (FAILED(hr = IWICBitmapScaler_Initialize( scaler, source, out_w, out_h, WICBitmapInterpolationModeFant ))) goto done;
+        source = (IWICBitmapSource *)scaler;
+    }
+    if (!(bits = malloc( out_w * 4 * out_h ))) { hr = E_OUTOFMEMORY; goto done; }
+    if (FAILED(hr = IWICBitmapSource_CopyPixels( source, NULL, out_w * 4, out_w * 4 * out_h, bits )))
+    {
+        free( bits );
+        goto done;
+    }
+    free( bitmap->pixels.bits );
+    bitmap->pixels.bits = bits;
+    bitmap->pixels.width = out_w;
+    bitmap->pixels.height = out_h;
+    bitmap->pixels.stride = out_w * 4;
+    TRACE( "decoded %ux%u (from %ux%u).\n", out_w, out_h, width, height );
+
+done:
+    if (scaler) IWICBitmapScaler_Release( scaler );
+    if (converter) IWICFormatConverter_Release( converter );
+    if (frame) IWICBitmapFrameDecode_Release( frame );
+    return hr;
+}
