+/* ---- placing an image: Stretch and alignment ---- */
+
+void image_place( Stretch stretch, int align_x, int align_y, float iw, float ih, const struct layout_rect *box,
+                  struct layout_rect *dest )
+{
+    float sx = iw ? box->width / iw : 0, sy = ih ? box->height / ih : 0, s;
+
+    switch (stretch)
+    {
+    case Stretch_None: dest->width = iw; dest->height = ih; break;
+    case Stretch_Fill: dest->width = box->width; dest->height = box->height; break;
+    case Stretch_UniformToFill: s = max( sx, sy ); dest->width = iw * s; dest->height = ih * s; break;
+    default: s = min( sx, sy ); dest->width = iw * s; dest->height = ih * s; break;
+    }
+    /* 0 left / top, 1 centre, 2 right / bottom */
+    dest->x = box->x + (align_x == 0 ? 0 : align_x == 2 ? box->width - dest->width : (box->width - dest->width) / 2);
+    dest->y = box->y + (align_y == 0 ? 0 : align_y == 2 ? box->height - dest->height : (box->height - dest->height) / 2);
+}
