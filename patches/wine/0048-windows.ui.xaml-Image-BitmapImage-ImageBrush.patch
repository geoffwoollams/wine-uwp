+static HRESULT image_query_interface( struct xaml_element *element, REFIID iid, void **out )
+{
+    struct image *impl = impl_from_image_element( element );
+
+    if (IsEqualGUID( iid, &IID_IImage )) *out = &impl->IImage_iface;
+    else if (IsEqualGUID( iid, &IID_IImage2 )) *out = &impl->IImage2_iface;
+    else if (IsEqualGUID( iid, &IID_IImage3 )) *out = &impl->IImage3_iface;
+    else return E_NOINTERFACE;
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static BOOL image_size( struct image *impl, float *w, float *h )
+{
+    struct image_pixels pixels;
+
+    if (!image_source_pixels( (IInspectable *)impl->source, &pixels )) return FALSE;
+    *w = pixels.width;
+    *h = pixels.height;
+    return TRUE;
+}
+
+static void image_measure( struct xaml_element *element, struct layout_context *ctx, float avail_width, float avail_height,
+                           float *width, float *height )
+{
+    struct image *impl = impl_from_image_element( element );
+    struct layout_rect box = { 0, 0, avail_width, avail_height }, dest;
+    float iw, ih;
+
+    *width = *height = 0;
+    if (!image_size( impl, &iw, &ih )) return;
+    if (isinf( avail_width ) && isinf( avail_height )) { *width = iw; *height = ih; return; }
+    /* a Uniform image in a slot open along one axis takes its natural size along it, scaled to the other */
+    if (isinf( box.width )) box.width = impl->stretch == Stretch_None ? iw : box.height * iw / ih;
+    if (isinf( box.height )) box.height = impl->stretch == Stretch_None ? ih : box.width * ih / iw;
+    if (impl->stretch == Stretch_Fill || impl->stretch == Stretch_UniformToFill)
+    {
+        /* they fill what they are given, but don't ask for more than their natural size along an open axis */
+        *width = isinf( avail_width ) ? iw : box.width;
+        *height = isinf( avail_height ) ? ih : box.height;
+        return;
+    }
+    image_place( impl->stretch, 1, 1, iw, ih, &box, &dest );
+    *width = dest.width;
+    *height = dest.height;
+}
+
+static void image_arrange( struct xaml_element *element, struct layout_context *ctx )
+{
+}
+
+static void image_render( struct xaml_element *element, struct layout_context *ctx )
+{
+    struct image *impl = impl_from_image_element( element );
+    struct image_pixels pixels;
+    struct layout_rect dest;
+    BOOL clip;
+
+    if (!image_source_pixels( (IInspectable *)impl->source, &pixels )) return;
+    image_place( impl->stretch, 1, 1, pixels.width, pixels.height, &element->bounds, &dest );
+    /* UniformToFill and None can be bigger than the element: clipped to it */
+    clip = dest.width > element->bounds.width + 0.5f || dest.height > element->bounds.height + 0.5f;
+    if (clip && ctx->rt) d2d_push_clip( ctx, &element->bounds );
+    draw_image( ctx, &pixels, &dest, 1.0f );
+    if (clip && ctx->rt) d2d_pop_clip( ctx );
+}
+
+static BOOL image_hit_self( struct xaml_element *element, float x, float y )
+{
+    return TRUE;
+}
+
+static void image_destroy( struct xaml_element *element )
+{
+    struct image *impl = impl_from_image_element( element );
+
+    unlisten( impl->element.outer );
+    if (impl->source) IImageSource_Release( impl->source );
+    event_list_clear( &impl->opened );
+    event_list_clear( &impl->failed );
+    free( impl );
+}
