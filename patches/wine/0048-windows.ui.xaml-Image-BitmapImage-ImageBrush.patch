+/* ms-appx:///path (or ms-appx://package/path) to a file in the app's package; FALSE if it isn't one */
+BOOL resolve_app_uri( const WCHAR *uri, WCHAR *file, UINT32 size )
+{
+    UINT32 len = size;
+    const WCHAR *path = uri;
+    WCHAR *p;
+
+    if (!wcsnicmp( uri, L"ms-appx://", 10 ))
+    {
+        path = uri + 10;
+        if (*path != '/' && !(path = wcschr( path, '/' ))) return FALSE;
+        while (*path == '/') path++;
+    }
+    else if (wcschr( uri, ':' ) && !(iswalpha( uri[0] ) && uri[1] == ':'))
+        return FALSE;   /* another scheme */
+    else if (iswalpha( uri[0] ) && uri[1] == ':')
+    {
+        lstrcpynW( file, uri, size );   /* a plain path */
+        return TRUE;
+    }
+    /* the package root, or without a package the folder of the executable */
+    if (GetCurrentPackagePath( &len, file ))
+    {
+        GetModuleFileNameW( NULL, file, size );
+        if ((p = wcsrchr( file, '\\' ))) *p = 0;
+    }
+    if (wcslen( file ) + wcslen( path ) + 2 > size) return FALSE;
+    lstrcatW( file, L"\\" );
+    p = file + wcslen( file );
+    lstrcatW( file, path );
+    for (; *p; p++) if (*p == '/') *p = '\\';
+    return TRUE;
+}
+
+static void schedule_notify( struct bitmap_image *bitmap );
+
+static void load_failed( struct bitmap_image *bitmap, const WCHAR *message )
+{
+    bitmap->state = IMAGE_FAILED;
+    WindowsDeleteString( bitmap->error );
+    WindowsCreateString( message, wcslen( message ), &bitmap->error );
+    bitmap->generation++;
+    schedule_notify( bitmap );
+}
+
+static void load_uri( struct bitmap_image *bitmap )
+{
+    IWICImagingFactory *factory = wic_factory();
+    IWICBitmapDecoder *decoder;
+    HSTRING raw = NULL;
+    WCHAR file[MAX_PATH];
+    HRESULT hr;
+
+    free( bitmap->pixels.bits );
+    memset( &bitmap->pixels, 0, sizeof(bitmap->pixels) );
+    bitmap->state = IMAGE_EMPTY;
+    if (!bitmap->uri) { bitmap->generation++; window_invalidate(); return; }
+    IUriRuntimeClass_get_RawUri( bitmap->uri, &raw );
+    if (!resolve_app_uri( WindowsGetStringRawBuffer( raw, NULL ), file, ARRAY_SIZE(file) ))
+    {
+        FIXME( "image URI %s isn't supported.\n", debugstr_hstring(raw) );
+        WindowsDeleteString( raw );
+        load_failed( bitmap, L"E_NETWORK_ERROR" );
+        return;
+    }
+    TRACE( "%s from %s.\n", debugstr_hstring(raw), debugstr_w(file) );
+    WindowsDeleteString( raw );
+    if (!factory || FAILED(hr = IWICImagingFactory_CreateDecoderFromFilename( factory, file, NULL, GENERIC_READ,
+                                                                              WICDecodeMetadataCacheOnDemand, &decoder )))
+    {
+        WARN( "can't open %s.\n", debugstr_w(file) );
+        load_failed( bitmap, L"AG_E_NETWORK_ERROR" );
+        return;
+    }
+    hr = decode( bitmap, decoder );
+    IWICBitmapDecoder_Release( decoder );
+    if (FAILED(hr)) { load_failed( bitmap, L"E_UNKNOWN_ERROR" ); return; }
+    bitmap->state = IMAGE_LOADED;
+    bitmap->generation++;
+    element_property_changed( (IInspectable *)&bitmap->IBitmapImage_iface, L"PixelWidth" );
+    schedule_notify( bitmap );
+    window_invalidate();
+}
