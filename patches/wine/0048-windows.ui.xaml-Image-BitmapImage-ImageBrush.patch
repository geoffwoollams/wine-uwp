+/* an Image's pixels into dest (view pixels); with GDI, alpha-blended from a DIB */
+void draw_image( struct layout_context *ctx, const struct image_pixels *pixels, const struct layout_rect *dest,
+                 float opacity )
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, (BYTE)(255 * opacity), AC_SRC_ALPHA };
+    BITMAPINFO info = {{ sizeof(info.bmiHeader) }};
+    ID2D1Bitmap *bitmap;
+    HBITMAP dib, old;
+    void *bits;
+    RECT r;
+    HDC mem;
+
+    if (ctx->rt)
+    {
+        D2D1_RECT_F rect = rect_f( dest );
+        if (!(bitmap = d2d_bitmap( ctx, pixels ))) return;
+        ID2D1RenderTarget_DrawBitmap( RT(ctx), bitmap, &rect, opacity, D2D1_BITMAP_INTERPOLATION_MODE_LINEAR, NULL );
+        ID2D1Bitmap_Release( bitmap );
+        return;
+    }
+    info.bmiHeader.biWidth = pixels->width;
+    info.bmiHeader.biHeight = -(LONG)pixels->height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    if (!(mem = CreateCompatibleDC( ctx->hdc ))) return;
+    if ((dib = CreateDIBSection( mem, &info, DIB_RGB_COLORS, &bits, NULL, 0 )))
+    {
+        memcpy( bits, pixels->bits, pixels->stride * pixels->height );
+        old = SelectObject( mem, dib );
+        element_device_rect( dest, ctx, &r );
+        GdiAlphaBlend( ctx->hdc, r.left, r.top, r.right - r.left, r.bottom - r.top, mem, 0, 0, pixels->width,
+                       pixels->height, blend );
+        SelectObject( mem, old );
+        DeleteObject( dib );
+    }
+    DeleteDC( mem );
+}
