diff --git a/dlls/windows.networking.connectivity/proxy.c b/dlls/windows.networking.connectivity/proxy.c
new file mode 100644
index 0000000..eb6057a
--- /dev/null
+++ b/dlls/windows.networking.connectivity/proxy.c
@@ -0,0 +1,204 @@
+/* WinRT Windows.Networking.Connectivity.ProxyConfiguration: every address is reached directly
