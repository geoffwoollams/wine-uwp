Subject: dxgi: implement CreateSwapChainForCoreWindow via ICoreWindowInterop's HWND

diff --git a/src/dxgi/dxgi_factory.cpp b/src/dxgi/dxgi_factory.cpp
index d89409ee..6c289147 100644
--- a/src/dxgi/dxgi_factory.cpp
+++ b/src/dxgi/dxgi_factory.cpp
@@ -273,9 +273,45 @@ namespace dxvk {
           IDXGIOutput*          pRestrictToOutput,
           IDXGISwapChain1**     ppSwapChain) {
     InitReturnPtr(ppSwapChain);
-    
-    Logger::err("DxgiFactory::CreateSwapChainForCoreWindow: Not implemented");
-    return E_NOTIMPL;
+
+    if (pWindow == nullptr)
+      return DXGI_ERROR_INVALID_CALL;
+
+    // ICoreWindowInterop {45D64A29-A63E-4CB6-B498-5781D298CB4F}, which
+    // derives from IUnknown (corewindow.h). Wine's CoreWindow implementation
+    // exposes the backing HWND through it, so we can forward to the regular
+    // HWND swap chain path.
+    static const GUID IID_ICoreWindowInterop =
+      { 0x45d64a29, 0xa63e, 0x4cb6, { 0xb4, 0x98, 0x57, 0x81, 0xd2, 0x98, 0xcb, 0x4f } };
+
+    struct ICoreWindowInteropVtbl {
+      HRESULT (STDMETHODCALLTYPE *QueryInterface)(void*, REFIID, void**);
+      ULONG   (STDMETHODCALLTYPE *AddRef)(void*);
+      ULONG   (STDMETHODCALLTYPE *Release)(void*);
+      HRESULT (STDMETHODCALLTYPE *get_WindowHandle)(void*, HWND*);
+    };
+
+    struct ICoreWindowInteropObject { const ICoreWindowInteropVtbl* lpVtbl; };
+
+    ICoreWindowInteropObject* interop = nullptr;
+    HRESULT hr = pWindow->QueryInterface(IID_ICoreWindowInterop, reinterpret_cast<void**>(&interop));
+
+    if (FAILED(hr) || !interop) {
+      Logger::err("DxgiFactory::CreateSwapChainForCoreWindow: Window does not implement ICoreWindowInterop");
+      return DXGI_ERROR_INVALID_CALL;
+    }
+
+    HWND hWnd = nullptr;
+    hr = interop->lpVtbl->get_WindowHandle(interop, &hWnd);
+    interop->lpVtbl->Release(interop);
+
+    if (FAILED(hr) || !hWnd) {
+      Logger::err("DxgiFactory::CreateSwapChainForCoreWindow: Failed to get window handle");
+      return DXGI_ERROR_INVALID_CALL;
+    }
+
+    Logger::warn(str::format("DxgiFactory::CreateSwapChainForCoreWindow: Using HWND ", hWnd, " from core window"));
+    return CreateSwapChainForHwnd(pDevice, hWnd, pDesc, nullptr, pRestrictToOutput, ppSwapChain);
   }
   
   
